<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Nur lokale Paketvorbereitung; keine Azure-Verbindung und kein Upload. -->
  <PropertyGroup>
	<WebPublishMethod>FileSystem</WebPublishMethod>
	<PublishProvider>FileSystem</PublishProvider>
	<Configuration>Release</Configuration>
	<TargetFramework>net10.0</TargetFramework>
	<RuntimeIdentifier>linux-x64</RuntimeIdentifier>
	<SelfContained>false</SelfContained>
	<PublishSingleFile>false</PublishSingleFile>
	<PublishTrimmed>false</PublishTrimmed>
	<PublishDir>$(MSBuildProjectDirectory)/../../artifacts/enote-linux/</PublishDir>
	<PublishUrl>$(PublishDir)</PublishUrl>
	<DeleteExistingFiles>false</DeleteExistingFiles>
	<LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
  </PropertyGroup>
  <ItemGroup>
	<!-- Lokale Entwicklungskonfiguration nicht in das Produktionspaket übernehmen. -->
	<Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
