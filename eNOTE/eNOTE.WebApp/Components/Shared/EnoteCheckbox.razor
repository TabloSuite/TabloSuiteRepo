@* Moderne Toggle-Checkbox (Soft-UI) *@
<button type="button"
        class="enote-toggle @(Value ? "an" : "")"
        role="switch"
        aria-checked="@Value"
        disabled="@Disabled"
        @onclick="ToggleAsync">
    <span class="enote-toggle-knob"></span>
</button>
@if (!string.IsNullOrWhiteSpace(Label))
{
    <span class="enote-toggle-label" @onclick="ToggleAsync">@Label</span>
}
