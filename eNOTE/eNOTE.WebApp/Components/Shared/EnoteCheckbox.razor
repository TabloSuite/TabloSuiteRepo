@* Moderne Toggle-Checkbox (Soft-UI) – Toggle + Label horizontal *@
<div class="enote-toggle-row">
    <button type="button"
            class="enote-toggle @(Value ? "an" : "")"
            role="switch"
            aria-checked="@(Value ? "true" : "false")"
            disabled="@Disabled"
            @onclick="ToggleAsync">
        <span class="enote-toggle-knob"></span>
    </button>
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <span class="enote-toggle-label @(Pflicht ? "enote-pflicht" : null)" @onclick="ToggleAsync">@Label</span>
    }
</div>
