<button type="@Type"
        class="@KlassenListe"
        disabled="@(IsBusy || Disabled)"
        aria-busy="@(IsBusy ? "true" : null)"
        @attributes="AdditionalAttributes"
        @onclick="HandleClickAsync">
    @if (IsBusy)
    {
        <span class="enote-spinner" aria-hidden="true"></span>
        @if (BusyLabel is { Length: > 0 } label)
        {
            <span>@label</span>
        }
    }
    else if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @Text
    }
</button>
