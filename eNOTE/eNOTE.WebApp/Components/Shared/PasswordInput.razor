<div class="enote-pw-wrap">
    <input type="password"
           @bind:get="Value"
           @bind:set="SetzeAsync"
           @bind:event="oninput"
           name="@Name"
           required="@Required"
           autocomplete="@Autocomplete"
           class="@CssClass"
           @attributes="AdditionalAttributes" />
    <button type="button"
            class="enote-pw-eye"
            tabindex="-1"
            aria-label="Afficher"
            onclick="enoteTogglePassword(this)"><span class="enote-pw-zeigen"><Icon Name="eye" Groesse="18" /></span><span class="enote-pw-verbergen" hidden><Icon Name="eye-off" Groesse="18" /></span></button>
</div>
