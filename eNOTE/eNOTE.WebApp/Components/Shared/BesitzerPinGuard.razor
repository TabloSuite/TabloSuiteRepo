@inject ENote.WebApp.Services.BesitzerPinState PinState
@inject ENote.WebApp.Services.KassenService KassenService
@inject ENote.WebApp.Services.KatalogService KatalogService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject ENote.WebApp.Services.ToastService Toast
@implements IDisposable

@if (laedt)
{
    @* Noch am Prüfen – nichts zeigen, damit die PIN-Karte nicht aufblitzt. *@
}
else if (PinState.VerwaltungFreigeschaltet || !istGesperrt)
{
    @ChildContent
}
else
{
    <div class="enote-pin-sperre">
        <div class="enote-pin-sperre-card">
            <span class="enote-pin-dialog-ico"><Icon Name="lock" Groesse="26" /></span>
            <h2>Zone réservée au propriétaire</h2>
            <p class="enote-muted">Saisissez le code PIN du propriétaire pour accéder à cette page.</p>

            @if (!string.IsNullOrWhiteSpace(fehler))
            {
                <div class="alert alert-error">@fehler</div>
            }

            <PinEingabe @bind-Wert="pin" OnBestaetigt="PruefeAsync" Fehlerhaft="@(!string.IsNullOrWhiteSpace(fehler))" />

            <AsyncActionButton Text="Déverrouiller" OnClick="PruefeAsync" CssClass="enote-btn-primary enote-btn-lg enote-btn-block" />
        </div>
    </div>
}
