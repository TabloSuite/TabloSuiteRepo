@* Einheitliches SVG-Icon-Set (24er Raster, Strich 2, currentColor). Offline-fähig, ohne CDN. *@
<svg class="enote-icon @CssClass" width="@Groesse" height="@Groesse" viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width="@Strich" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="@(Titel is null ? "true" : null)" role="@(Titel is null ? null : "img")" focusable="false">
    @if (Titel is not null)
    {
        <title>@Titel</title>
    }
    @((MarkupString)(Pfade.TryGetValue(Name, out var p) ? p : Pfade["dot"]))
</svg>

