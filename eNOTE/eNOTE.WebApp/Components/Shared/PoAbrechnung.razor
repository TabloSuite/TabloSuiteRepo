@using ENote.Core.DataModels.Abo
@using ENote.WebApp.Services
@inject PoAbrechnungService Service
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider Auth

<section class="enote-card enote-settings-card">
    <h2>Encaissements et reversements des responsables</h2>
    <p>Lors de la création d'une demande, l'administrateur peut confirmer la compensation de la commission disponible : le responsable conserve ce montant et reverse uniquement le net. Les anciens paiements et demandes restent inchangés.</p>
    <div class="enote-filter-leiste">
        <div class="enote-form"><label>Encaissements à inclure jusqu'au (inclus)</label><EnoteDatePicker @bind-Value="stichtag" /></div>
        <button class="enote-btn enote-btn-ghost" @onclick="HeuteAsync">Jusqu'à aujourd'hui</button>
        <AsyncActionButton Text="Actualiser" OnClick="LadeAsync" CssClass="enote-btn-ghost" />
        @if (admin)
        {
            <div class="enote-form"><label>Échéance des demandes</label><EnoteDatePicker @bind-Value="frist" /></div>
            <button class="enote-btn enote-btn-primary" disabled="@(konten.Count == 0)" @onclick="Vorschau">Prévisualiser les demandes</button>
        }
    </div>
    @if (fehler is not null) { <p class="alert alert-error" role="alert">@fehler</p> }
    @if (erfolg is not null) { <p class="alert alert-success" role="status">@erfolg</p> }
    <p class="enote-muted">Arrêté appliqué à la sélection des nouveaux encaissements : @angewendet.ToString("dd/MM/yyyy"). Les soldes et l'historique restent à jour et incluent les opérations ultérieures.</p>
    @if (laedt) { <p role="status">Chargement des comptes…</p> }
    else if (fehler is null && konten.Count == 0)
    {
        <p class="enote-empty" role="status">Aucun compte responsable disponible pour cette sélection.</p>
    }
    <div class="enote-grid">
        @foreach (var k in konten)
        {
            <div class="enote-item" @key="k.Id">
                <button class="enote-btn enote-btn-ghost" @onclick="() => detail = k.Id">@k.Name · Voir la composition</button>
                <button class="enote-btn enote-btn-ghost" @onclick="() => detail = k.Id">Fonds restant à reverser : @Geld(k.Abzufuehren)</button>
                <span>Nouvelle demande possible à l'arrêté : @Geld(k.NeuAnzufordern)</span>
                <button class="enote-btn enote-btn-ghost" @onclick="() => detail = k.Id">Commissions acquises non reçues : @Geld(k.ProvisionOffen)</button>
                <span>Commissions déjà conservées par compensation : @Geld(k.Verrechnet)</span>
                <span>Solde indicatif après toutes les commissions : @Geld(k.Abzufuehren - k.ProvisionOffen - k.AltProvisionen.Where(a => a.Status == AuszahlungStatus.Offen).Sum(a => a.Betrag)) (sans compensation)</span>
                <span>Anciennes commissions non versées : @Geld(k.AltProvisionen.Where(a => a.Status == AuszahlungStatus.Offen).Sum(a => a.Betrag)) · suivi séparé ci-dessous</span>
            </div>
        }
    </div>
    @if (!admin)
    {
        <h3>Virements des propriétaires à vérifier</h3>
        @if (!laedt && fehler is null && meldungen.Count == 0) { <p class="enote-empty" role="status">Aucun virement signalé en attente.</p> }
        @foreach (var m in meldungen)
        {
            <div class="enote-item">
                <strong>@m.Laden · @Geld(m.Betrag)</strong><span>Référence déclarée : @m.Referenz</span>
                <button class="enote-btn enote-btn-primary" @onclick="() => OeffneEingang(m)">Confirmer l'encaissement réel</button>
            </div>
        }
    }
</section>

@if (Detail is { } d)
{
    <section class="enote-card enote-settings-card">
        <div class="enote-page-header"><h2>@d.Name · Détail du compte</h2><button class="enote-btn enote-btn-ghost" @onclick="() => detail = null">Fermer le détail</button></div>
        <h3>Composition des encaissements · @Geld(d.Eingaenge.Sum(e => e.Betrag))</h3>
        @if (d.Eingaenge.Count == 0) { <p class="enote-empty" role="status">Aucun encaissement pour ce compte.</p> }
        <div class="enote-grid">
            @foreach (var e in d.Eingaenge)
            {
                <div class="enote-item">
                    <strong>@e.Besitzer · @e.Laden · @Geld(e.Betrag)</strong>
                    <span>Contrat : @e.VonUtc.ToString("dd/MM/yyyy") – @e.BisUtc.ToString("dd/MM/yyyy") (fin exclusive)</span>
                    <span>Reçu le @e.EingangUtc.ToString("dd/MM/yyyy") · référence : @e.Referenz</span>
                    <span>Commission : @Geld(e.Betrag) × @e.ProzentProvision % + @Geld(e.FestProvision) = @Geld(e.Provision)</span>
                    <small>@(e.AnforderungId is null ? "Pas encore demandé" : "Demande " + Kurz(e.AnforderungId.Value)) · confirmé par @d.Name le @e.ErfasstUtc.ToString("dd/MM/yyyy HH:mm")</small>
                </div>
            }
        </div>
        <h3>Demandes de reversement</h3>
        @if (d.Anforderungen.Count == 0) { <p class="enote-empty" role="status">Aucune demande de reversement pour ce compte.</p> }
        @foreach (var a in d.Anforderungen)
        {
            var recu = d.Bewegungen.Where(b => b.AnforderungId == a.Id && b.Status == PoBewegungsStatus.Bestaetigt).Sum(b => b.Betrag);
            var attente = d.Bewegungen.Where(b => b.AnforderungId == a.Id && b.Status == PoBewegungsStatus.Gemeldet).Sum(b => b.Betrag);
            <div class="enote-item">
                <strong>Demande @Kurz(a.Id) · @Geld(a.Betrag)</strong>
                <span>Brut : @Geld(a.Betrag) − commission conservée : @Geld(a.VerrechneteProvision) = net à reverser : <strong>@Geld(a.NettoBetrag)</strong></span>
                <span>Lot @Kurz(a.SammellaufId) · arrêté @a.StichtagUtc.ToString("dd/MM/yyyy") · échéance @a.FaelligUtc.ToString("dd/MM/yyyy")</span>
                <span>Virement réellement reçu : @Geld(recu) · signalé à vérifier : @Geld(attente) · reste à recevoir : @Geld(a.NettoBetrag - recu)</span>
                @if (a.NettoBetrag == 0) { <span>Soldée par compensation ; aucun virement nécessaire.</span> }
                @if (a.Positionen.Count == 0) { <p class="enote-empty" role="status">Aucun encaissement associé à cette demande.</p> }
                <ul>@foreach (var e in a.Positionen) { <li>@e.Besitzer · @e.Laden · @e.EingangUtc.ToString("dd/MM/yyyy") · @Geld(e.Betrag) · @e.Referenz</li> }</ul>
                @if (!admin && a.NettoBetrag > recu + attente)
                { <button class="enote-btn enote-btn-primary" @onclick="() => OeffneBewegung(d.Id, a.Id, false, a.NettoBetrag - recu - attente)">Signaler le reversement net</button> }
            </div>
        }
        <h3>Commissions · @Geld(d.ProvisionOffen) non reçues</h3>
        <p>Le calcul détaillé est conservé dans chaque encaissement. Le forfait n'est appliqué qu'une fois par établissement et mois d'encaissement. Une commission signalée reste due jusqu'à confirmation de sa réception par le responsable.</p>
        @if (admin && d.ProvisionOffen > d.Bewegungen.Where(b => b.IstProvision && b.Status == PoBewegungsStatus.Gemeldet).Sum(b => b.Betrag))
        { <button class="enote-btn enote-btn-primary" @onclick="() => OeffneBewegung(d.Id, null, true, d.ProvisionOffen - d.Bewegungen.Where(b => b.IstProvision && b.Status == PoBewegungsStatus.Gemeldet).Sum(b => b.Betrag))">Signaler un versement de commission</button> }
        <h3>Virements et commissions</h3>
        @if (d.Bewegungen.Count == 0) { <p class="enote-empty" role="status">Aucun virement ni versement de commission pour ce compte.</p> }
        @foreach (var b in d.Bewegungen)
        {
            <div class="enote-item">
                <strong>@(b.IstProvision ? "Commission versée au responsable" : "Reversement à la plateforme") · @Geld(b.Betrag)</strong>
                <span>@b.ZahlungsdatumUtc.ToString("dd/MM/yyyy") · @b.Referenz · @Status(b.Status)</span>
                @if (b.Status == PoBewegungsStatus.Gemeldet && (admin != b.IstProvision))
                {
                    <div class="enote-item-actions">
                        <button class="enote-btn enote-btn-primary" @onclick="() => OeffneEntscheidung(b, true)">Confirmer la réception</button>
                        <button class="enote-btn enote-btn-ghost" @onclick="() => OeffneEntscheidung(b, false)">Non reçu</button>
                    </div>
                }
            </div>
        }
        <h3>Anciennes commissions · hors nouveau suivi</h3>
        @if (d.AltProvisionen.Count == 0) { <p class="enote-empty" role="status">Aucune ancienne commission pour ce compte.</p> }
        @foreach (var a in d.AltProvisionen)
        { <div class="enote-item"><strong>@a.Monat/@a.Jahr · @Geld(a.Betrag) · @(a.Status == AuszahlungStatus.Bestaetigt ? "Versement confirmé (ancien suivi)" : "Ouverte (ancien suivi)")</strong><p style="white-space:pre-wrap">@a.Aufschluesselung</p></div> }
        <h3>Historique partagé</h3>
        @if (d.Historie.Count == 0) { <p class="enote-empty" role="status">Aucune opération dans l'historique de ce compte.</p> }
        @foreach (var h in d.Historie)
        { <div class="enote-item"><strong>@h.ZeitpunktUtc.ToString("dd/MM/yyyy HH:mm") · @h.Aktion · @Geld(h.Betrag)</strong><span>Acteur : @h.Benutzer · opération @Kurz(h.VorgangId)</span><p>@h.Notiz</p></div> }
    </section>
}

<ModalDialog Open="vorschauOffen" Title="Prévisualisation des demandes" OnClose="() => vorschauOffen = false" ErrorMessage="@dialogFehler">
    <ChildContent>
        <p>Encaissements confirmés jusqu'au @angewendet.ToString("dd/MM/yyyy") inclus. Les positions déjà demandées sont exclues.</p>
        <EnoteCheckbox @bind-Value="verrechnen" Label="Autoriser le responsable à conserver sa commission disponible par compensation" />
        <p>Les commissions déjà versées, compensées ou signalées pour versement sont exclues. La compensation ne constitue pas un virement reçu.</p>
        @if (!konten.Any(k => k.NeuAnzufordern > 0)) { <p class="enote-empty" role="status">Aucun nouvel encaissement à inclure dans une demande pour cet arrêté.</p> }
        @foreach (var k in konten.Where(k => k.NeuAnzufordern > 0))
        {
            <div class="enote-item">
                <EnoteCheckbox Value="selection.Contains(k.Id)" ValueChanged="v => Auswahl(k.Id, v)" Label="@k.Name" />
                <strong>Brut : @Geld(k.NeuAnzufordern)</strong>
                <span>Commission conservée : @Geld(verrechnen ? k.VerrechnungVorschau : 0)</span>
                <strong>Net à reverser : @Geld(k.NeuAnzufordern - (verrechnen ? k.VerrechnungVorschau : 0))</strong>
                <span>Commissions acquises jusqu'à l'arrêté : @Geld(k.Eingaenge.Where(e => e.EingangUtc < k.BisExklusiv).Sum(e => e.Provision)) · commissions actuellement non reçues : @Geld(k.ProvisionOffen)</span>
                <ul>@foreach (var e in k.Eingaenge.Where(e => e.AnforderungId == null && e.EingangUtc < k.BisExklusiv)) { <li>@e.Besitzer · @e.Laden · @Geld(e.Betrag)</li> }</ul>
            </div>
        }
        <p>Total brut : @Geld(konten.Where(k => selection.Contains(k.Id)).Sum(k => k.NeuAnzufordern)) · commissions compensées : @Geld(verrechnen ? konten.Where(k => selection.Contains(k.Id)).Sum(k => k.VerrechnungVorschau) : 0)</p>
        <p><strong>Total net à recevoir : @Geld(konten.Where(k => selection.Contains(k.Id)).Sum(k => k.NeuAnzufordern - (verrechnen ? k.VerrechnungVorschau : 0)))</strong></p>
        <p>Échéance : @frist?.ToString("dd/MM/yyyy"). Chaque responsable reçoit sa propre demande avec une composition enregistrée.</p>
    </ChildContent>
    <Footer><AsyncActionButton Text="Créer les demandes sélectionnées" OnClick="FordereAsync" CssClass="enote-btn-primary" /></Footer>
</ModalDialog>

<ModalDialog Open="aktion is not null" Title="@DialogTitel" OnClose="() => aktion = null" ErrorMessage="@dialogFehler">
    <ChildContent>
        @if (aktion == "eingang") { <p>Confirmez uniquement les fonds réellement reçus du propriétaire : @Geld(betrag). Le contrat sera marqué payé, mais ces fonds resteront à reverser à la plateforme.</p> }
        @if (aktion == "bewegung") { <div class="enote-form"><label>Montant (F CFA)</label><input type="number" min="0.01" step="0.01" @bind="betrag" /></div> }
        @if (aktion is "eingang" or "bewegung")
        { <div class="enote-form"><label>Date réelle du paiement</label><EnoteDatePicker @bind-Value="datum" /><label>Référence / justificatif textuel</label><input @bind="referenz" maxlength="@(aktion == "bewegung" ? 200 : 1000)" /></div> }
        @if (aktion == "entscheidung") { <p>@(erhalten ? "Confirmer uniquement après réception réelle des fonds." : "Indiquez pourquoi les fonds n'ont pas été reçus. Le montant sera à nouveau disponible pour un signalement.")</p> }
        @if (aktion == "entscheidung") { <div class="enote-form"><label>Note / motif (obligatoire en cas de non-réception)</label><textarea @bind="notiz" maxlength="2000"></textarea></div> }
    </ChildContent>
    <Footer><AsyncActionButton Text="Confirmer" OnClick="AktionAsync" CssClass="enote-btn-primary" /></Footer>
</ModalDialog>

@code {
    private Guid user;
    private bool laedt = true;
    private bool admin, vorschauOffen;
    private bool verrechnen;
    private DateTime? stichtag = DateTime.UtcNow.Date, frist = DateTime.UtcNow.Date.AddDays(7), datum = DateTime.UtcNow.Date;
    private DateTime angewendet = DateTime.UtcNow.Date;
    private List<PoAbrechnungService.PoKonto> konten = [];
    private List<PoAbrechnungService.OffeneMeldung> meldungen = [];
    private HashSet<Guid> selection = [];
    private Guid? detail, anforderung;
    private Guid zielPo, vorgang, lauf;
    private bool provision, erhalten;
    private string? fehler, erfolg, dialogFehler, aktion;
    private string referenz = "", notiz = "";
    private decimal betrag;
    private PoAbrechnungService.PoKonto? Detail => konten.FirstOrDefault(k => k.Id == detail);
    private string DialogTitel => aktion == "eingang" ? "Confirmer l'encaissement" : aktion == "entscheidung" ? "Vérifier la réception" : provision ? "Versement de commission" : "Reversement à la plateforme";
    private static string Geld(decimal b) => b.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("fr-FR")) + " F CFA";
    private static string Kurz(Guid id) => id.ToString("N")[..10].ToUpperInvariant();
    private static string Status(PoBewegungsStatus s) => s == PoBewegungsStatus.Gemeldet ? "Signalé, à vérifier" : s == PoBewegungsStatus.Bestaetigt ? "Reçu" : "Non reçu";
    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        Guid.TryParse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out user);
        admin = auth.User.IsInRole("SuperAdmin");
        await LadeAsync();
    }
    private async Task LadeAsync()
    {
        laedt = true;
        fehler = null;
        try
        {
            if (stichtag is null) throw new ArgumentException("Choisissez un arrêté.");
            var daten = await Service.GetKontenAsync(user, stichtag.Value);
            var offen = await Service.GetMeldungenAsync(user);
            konten = daten; meldungen = offen; angewendet = stichtag.Value.Date;
        }
        catch (Exception ex) { fehler = ex is ArgumentException ? ex.Message : "Le chargement du suivi a échoué."; }
        finally { laedt = false; }
    }
    private async Task HeuteAsync() { stichtag = DateTime.UtcNow.Date; await LadeAsync(); }
    private void Auswahl(Guid id, bool wert) { if (wert) selection.Add(id); else selection.Remove(id); }
    private void Vorschau()
    {
        dialogFehler = null;
        if (stichtag?.Date != angewendet) { fehler = "Actualisez les données pour appliquer la date choisie."; return; }
        if (frist is null || frist.Value.Date < DateTime.UtcNow.Date) { fehler = "Choisissez une échéance valide."; return; }
        selection = konten.Where(k => k.NeuAnzufordern > 0).Select(k => k.Id).ToHashSet();
        lauf = Guid.NewGuid(); verrechnen = false; vorschauOffen = true;
    }
    private async Task FordereAsync()
    {
        try
        {
            var ids = konten.Where(k => selection.Contains(k.Id)).SelectMany(k => k.Eingaenge.Where(e => e.AnforderungId == null && e.EingangUtc < k.BisExklusiv)).Select(e => e.Id).ToArray();
            var verrechnungen = verrechnen ? konten.Where(k => selection.Contains(k.Id)).ToDictionary(k => k.Id, k => k.VerrechnungVorschau) : null;
            await Service.FordereAsync(user, lauf, angewendet, frist!.Value, ids, verrechnungen: verrechnungen);
            vorschauOffen = false; erfolg = "Demandes créées. Chaque responsable peut consulter sa demande et ses positions."; await LadeAsync();
        }
        catch (Exception ex) { dialogFehler = Nachricht(ex); }
    }
    private void Reset() { referenz = ""; notiz = ""; datum = DateTime.UtcNow.Date; dialogFehler = null; erfolg = null; }
    private void OeffneEingang(PoAbrechnungService.OffeneMeldung m) { Reset(); vorgang = m.Id; betrag = m.Betrag; referenz = m.Referenz ?? ""; aktion = "eingang"; }
    private void OeffneBewegung(Guid po, Guid? a, bool p, decimal b) { Reset(); zielPo = po; anforderung = a; provision = p; betrag = b; aktion = "bewegung"; }
    private void OeffneEntscheidung(PoGeldbewegung b, bool empfangen) { Reset(); vorgang = b.Id; erhalten = empfangen; aktion = "entscheidung"; }
    private static string Nachricht(Exception ex) => ex is ArgumentException or InvalidOperationException ? ex.Message : "L'opération a échoué. Actualisez et réessayez.";
    private async Task AktionAsync()
    {
        try
        {
            if (aktion == "eingang") await Service.BestaetigeEingangAsync(user, vorgang, datum ?? throw new ArgumentException("Choisissez la date."), referenz);
            else if (aktion == "bewegung") await Service.MeldeBewegungAsync(user, zielPo, anforderung, provision, betrag, datum ?? throw new ArgumentException("Choisissez la date."), referenz);
            else if (aktion == "entscheidung") await Service.EntscheideAsync(user, vorgang, erhalten, notiz);
            aktion = null; erfolg = "Opération enregistrée dans l'historique partagé."; await LadeAsync();
        }
        catch (Exception ex) { dialogFehler = Nachricht(ex); }
    }
}
