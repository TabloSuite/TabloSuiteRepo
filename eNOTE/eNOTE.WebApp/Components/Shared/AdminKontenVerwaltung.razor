@using ENote.WebApp.Services
@inject AdminKontenService Service
@inject AuthenticationStateProvider Auth
@inject ToastService toast

@* Administratoren: alle Admins sehen die Liste (Nutzer 19.11.2026: « Onglet Administrateurs fehlt »), anlegen, bearbeiten,
   sperren und löschen darf nur der Hauptadministrator (erster Admin) – der Dienst prüft das zusätzlich. *@

<section class="ak">
    <div class="ak-kopf">
        <div>
            <h2 class="enote-section-title">Administrateurs</h2>
            @if (IstHauptAdmin)
            {
                <p class="enote-muted">Vous êtes l'administrateur principal : vous seul pouvez ajouter, modifier, bloquer ou supprimer les autres administrateurs.</p>
            }
            else
            {
                <p class="enote-muted">Seul l'administrateur principal peut ajouter, modifier, bloquer ou supprimer des administrateurs.</p>
            }
        </div>
        @if (IstHauptAdmin)
        {
            <button class="enote-btn enote-btn-primary" @onclick="Neu"><Icon Name="plus" Groesse="16" /> Ajouter un administrateur</button>
        }
    </div>

    @if (fehler is not null)
    {
        <div class="alert alert-error">@fehler</div>
    }
    else if (laedt)
    {
        <p class="enote-muted" role="status">Chargement…</p>
    }
    else
    {
        <div class="enote-card ak-liste">
            @foreach (var k in konten)
            {
                <div class="ak-zeile @(k.Gesperrt ? "gesperrt" : "")">
                    <span class="ak-avatar">@Initialen(k)</span>
                    <div class="ak-name">
                        <strong>@k.Vorname @k.Nachname</strong>
                        <span>@k.Pseudonym · @k.Email</span>
                    </div>
                    @if (k.ErsterAdmin)
                    {
                        <span class="ak-tag haupt"><Icon Name="shield" Groesse="14" /> Administrateur principal</span>
                        <span></span>
                    }
                    else if (!IstHauptAdmin)
                    {
                        <span class="ak-tag @(k.Gesperrt ? "aus" : "an")">@(k.Gesperrt ? "Bloqué" : "Actif")</span>
                        <span></span>
                    }
                    else
                    {
                        <span class="ak-tag @(k.Gesperrt ? "aus" : "an")">@(k.Gesperrt ? "Bloqué" : "Actif")</span>
                        <div class="ak-aktionen">
                            <button class="enote-btn enote-btn-ghost enote-btn-sm" @onclick="() => Bearbeite(k)"><Icon Name="edit" Groesse="15" /> Modifier</button>
                            <AsyncActionButton Text="@(k.Gesperrt ? "Débloquer" : "Bloquer")" BusyText="…" CssClass="enote-btn-ghost enote-btn-sm" OnClick="() => SperreAsync(k)" />
                            <button class="enote-icon-btn" title="Supprimer" aria-label="Supprimer @k.Vorname @k.Nachname" @onclick="() => Loeschen(k)"><Icon Name="trash" Groesse="16" /></button>
                        </div>
                    }
                </div>
            }
        </div>
        <p class="enote-muted ak-hinweis"><Icon Name="info" Groesse="14" /> Un administrateur bloqué est déconnecté et ne peut plus se connecter jusqu'au déblocage.</p>
    }
</section>

<ModalDialog Open="offen" Title="@(ziel is null ? "Ajouter un administrateur" : "Modifier l'administrateur")" OnClose="() => offen = false" ErrorMessage="@dialogFehler">
    <ChildContent>
        <div class="enote-form">
            <div class="enote-form-grid">
                <label><span class="enote-pflicht">Prénom</span> <input @bind="vorname" @bind:event="oninput" maxlength="100" /></label>
                <label><span class="enote-pflicht">Nom</span> <input @bind="nachname" @bind:event="oninput" maxlength="100" /></label>
            </div>
            <label><span class="enote-pflicht">Adresse e-mail</span> <input type="email" @bind="email" @bind:event="oninput" maxlength="256" /></label>
            @if (ziel is null)
            {
                <label>Pseudonyme (pour la connexion ; sinon l'adresse e-mail) <input @bind="pseudonym" autocomplete="off" /></label>
                <label><span class="enote-pflicht">Mot de passe initial</span> <PasswordInput @bind-Value="passwort" /></label>
                <small class="enote-muted">Communiquez ce mot de passe à la personne avant de fermer cette fenêtre ; elle pourra le changer dans « Mon profil ».</small>
            }
            else
            {
                <EnoteCheckbox @bind-Value="gesperrt" Label="Compte bloqué" />
            }
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => offen = false">Annuler</button>
        <AsyncActionButton Text="Enregistrer" BusyText="Enregistrement…" OnClick="SpeichereAsync" CssClass="enote-btn-primary" Disabled="@(!Vollstaendig)" />
    </Footer>
</ModalDialog>

<ModalDialog Open="loeschenOffen" Title="Supprimer l'administrateur ?" OnClose="() => loeschenOffen = false" ErrorMessage="@dialogFehler" MaxWidthClass="enote-modal-sm">
    <ChildContent><p>Le compte de <strong>@vorname @nachname</strong> sera supprimé définitivement. Pour une interruption temporaire, préférez « Bloquer ».</p></ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => loeschenOffen = false">Annuler</button>
        <AsyncActionButton Text="Supprimer" BusyText="Suppression…" OnClick="LoescheAsync" CssClass="enote-btn-danger" />
    </Footer>
</ModalDialog>

@code {
    /// <summary>Nur der Hauptadministrator verwaltet; die anderen Admins sehen die Liste lesend.</summary>
    [Parameter] public bool IstHauptAdmin { get; set; }

    private bool Vollstaendig => !string.IsNullOrWhiteSpace(vorname) && !string.IsNullOrWhiteSpace(nachname) && !string.IsNullOrWhiteSpace(email)
        && (ziel is not null || !string.IsNullOrWhiteSpace(passwort));

    private List<AdminKontenService.AdminKonto> konten = [];
    private Guid user;
    private Guid? ziel;
    private bool laedt = true, offen, loeschenOffen, gesperrt;
    private string vorname = "", nachname = "", email = "", passwort = "", pseudonym = "";
    private string? fehler, dialogFehler;

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        Guid.TryParse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out user);
        await LadeAsync();
    }

    private async Task LadeAsync()
    {
        laedt = true; fehler = null;
        try { konten = await Service.GetAsync(user); }
        catch (Exception ex) { fehler = Nachricht(ex); }
        finally { laedt = false; }
    }

    private static string Initialen(AdminKontenService.AdminKonto k)
        => string.Concat(new[] { k.Vorname, k.Nachname }.Where(t => t.Length > 0).Select(t => char.ToUpperInvariant(t[0]))) is { Length: > 0 } i ? i : "AD";

    private void Neu()
    {
        ziel = null; vorname = nachname = email = pseudonym = ""; gesperrt = false; dialogFehler = null;
        passwort = "Aa1!" + Convert.ToHexString(System.Security.Cryptography.RandomNumberGenerator.GetBytes(6));
        offen = true;
    }

    private void Bearbeite(AdminKontenService.AdminKonto k)
    {
        ziel = k.Id; vorname = k.Vorname; nachname = k.Nachname; email = k.Email; gesperrt = k.Gesperrt; dialogFehler = null; offen = true;
    }

    private void Loeschen(AdminKontenService.AdminKonto k)
    {
        ziel = k.Id; vorname = k.Vorname; nachname = k.Nachname; dialogFehler = null; loeschenOffen = true;
    }

    private static string Nachricht(Exception ex)
        => ex is ArgumentException or InvalidOperationException or UnauthorizedAccessException ? ex.Message : "L'opération a échoué.";

    private async Task SpeichereAsync()
    {
        try
        {
            if (ziel is Guid id) await Service.SpeichereAsync(user, id, vorname, nachname, email, gesperrt);
            else await Service.LegeAnAsync(user, vorname, nachname, email, passwort, benutzername: string.IsNullOrWhiteSpace(pseudonym) ? null : pseudonym);
            toast.ZeigeErfolg(ziel is null ? "Administrateur ajouté." : "Modifications enregistrées.");
            offen = false; passwort = "";
            await LadeAsync();
        }
        catch (Exception ex) { dialogFehler = Nachricht(ex); }
    }

    private async Task SperreAsync(AdminKontenService.AdminKonto k)
    {
        try
        {
            await Service.SetzeGesperrtAsync(user, k.Id, !k.Gesperrt);
            toast.ZeigeInfo(k.Gesperrt ? $"{k.Vorname} {k.Nachname} est débloqué." : $"{k.Vorname} {k.Nachname} est bloqué et déconnecté.");
            await LadeAsync();
        }
        catch (Exception ex) { toast.ZeigeFehler(Nachricht(ex)); }
    }

    private async Task LoescheAsync()
    {
        try
        {
            if (ziel is Guid id) await Service.LoescheAsync(user, id);
            loeschenOffen = false; toast.ZeigeInfo("Administrateur supprimé.");
            await LadeAsync();
        }
        catch (Exception ex) { dialogFehler = Nachricht(ex); }
    }
}
