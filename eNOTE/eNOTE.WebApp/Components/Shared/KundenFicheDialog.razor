@using ENote.Core.Services.Kunden
@using ENote.WebApp.Services
@inject KundenBesuchService besuche
@inject ToastService toast

@* Kundenfiche für Équipe und Besitzer: Anwesenheit (arrivée, salle, départ) und Verlauf mit Notizen. *@

<ModalDialog Open="Open" Title="@(fiche?.Name ?? "Client")" OnClose="SchliesseAsync" ErrorMessage="@fehler" MaxWidthClass="enote-modal-lg">
    <ChildContent>
        @if (fiche is null)
        {
            <p class="enote-muted" role="status">Chargement…</p>
        }
        else
        {
            <div class="kf">
                <div class="kf-meta">
                    @if (!string.IsNullOrWhiteSpace(fiche.Telefon)) { <span><Icon Name="phone" Groesse="14" /> @fiche.Telefon</span> }
                    <span><Icon Name="clock" Groesse="14" /> @fiche.AnzahlBesuche passage@(fiche.AnzahlBesuche > 1 ? "s" : "") enregistré@(fiche.AnzahlBesuche > 1 ? "s" : "")</span>
                </div>

                @if (fiche.Offen is { } offen)
                {
                    <div class="kf-praesenz offen">
                        <span class="kf-praesenz-ico"><Icon Name="user-check" Groesse="20" /></span>
                        @if (bearbeiten)
                        {
                            <div class="kf-praesenz-form">
                                <AnkunftFelder @bind-Grund="grund" @bind-Raum="raum" MitNotiz="false" Vorschlaege="vorschlaege" />
                                <div class="kf-knoepfe">
                                    <button type="button" class="enote-btn enote-btn-ghost enote-btn-sm" @onclick="() => bearbeiten = false">Annuler</button>
                                    <AsyncActionButton Text="Enregistrer" BusyText="…" CssClass="enote-btn-primary enote-btn-sm" Disabled="@string.IsNullOrWhiteSpace(grund)" OnClick="AendereAsync" />
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="kf-praesenz-text">
                                <strong>Présent pour @offen.Grund</strong>
                                <span>@(offen.Raum is { } r ? $"{r} · " : "")@KundenBesuchRegeln.Seit(offen.AnkunftUtc, ENote.Core.Services.AppUhr.UtcNow) (arrivée à @offen.AnkunftUtc.ImLaden(Zone).ToString("HH':'mm"))</span>
                            </div>
                            <div class="kf-knoepfe">
                                <button type="button" class="enote-btn enote-btn-ghost enote-btn-sm" @onclick="StarteBearbeiten"><Icon Name="edit" Groesse="16" /> Motif / salle</button>
                                <AsyncActionButton Text="Départ" BusyText="…" CssClass="enote-btn-primary enote-btn-sm" OnClick="BeendeAsync" />
                            </div>
                            <AsyncActionButton BasisKlasse="kf-annulieren" Text="Arrivée enregistrée par erreur ? Annuler" BusyText="Annulation…" OnClick="AnnuliereAsync" />
                        }
                    </div>
                }
                else if (ankunftOffen)
                {
                    <div class="kf-praesenz">
                        <span class="kf-praesenz-ico"><Icon Name="user-check" Groesse="20" /></span>
                        <div class="kf-praesenz-form">
                            <AnkunftFelder @bind-Grund="grund" @bind-Raum="raum" @bind-Notiz="notiz" Vorschlaege="vorschlaege" />
                            <div class="kf-knoepfe">
                                <button type="button" class="enote-btn enote-btn-ghost enote-btn-sm" @onclick="() => ankunftOffen = false">Annuler</button>
                                <AsyncActionButton Text="Enregistrer l'arrivée" BusyText="…" CssClass="enote-btn-primary enote-btn-sm" Disabled="@string.IsNullOrWhiteSpace(grund)" OnClick="AnkunftAsync" />
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <AsyncActionButton BasisKlasse="kf-ankunft-knopf" BusyText="Enregistrement…" OnClick="StarteAnkunftAsync">
                        <Icon Name="user-check" Groesse="18" /> Enregistrer l'arrivée <small>Le client est là pour une prestation</small>
                    </AsyncActionButton>
                }

                <KundenVerlauf Fiche="fiche" BenutzerId="BenutzerId" Zone="Zone" OnGeaendert="LadeAsync" />
            </div>
        }
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="SchliesseAsync">Fermer</button>
    </Footer>
</ModalDialog>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public Guid KundeId { get; set; }
    [Parameter, EditorRequired] public Guid SalonId { get; set; }
    [Parameter, EditorRequired] public Guid BenutzerId { get; set; }
    /// <summary>Ortszeit des Ladens für Uhrzeiten.</summary>
    [Parameter] public TimeZoneInfo Zone { get; set; } = Zeitzonen.Standard;
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Anwesenheit oder Verlauf geändert (Übersicht/Kasse neu laden).</summary>
    [Parameter] public EventCallback OnGeaendert { get; set; }

    private KundenBesuchService.Fiche? fiche;
    private KundenBesuchService.Vorschlaege? vorschlaege;
    private Guid geladenFuer;
    private bool ankunftOffen, bearbeiten;
    private string grund = "", raum = "", notiz = "";
    private string? fehler;

    protected override async Task OnParametersSetAsync()
    {
        if (!Open) { geladenFuer = Guid.Empty; return; }
        if (KundeId == geladenFuer) return;
        geladenFuer = KundeId;
        fiche = null; fehler = null; ankunftOffen = bearbeiten = false;
        await LadeAsync();
    }

    private async Task LadeAsync()
    {
        try { fiche = await besuche.GetFicheAsync(BenutzerId, KundeId); }
        catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException) { fehler = ex.Message; }
    }

    private async Task LadeVorschlaegeAsync()
    {
        try { vorschlaege ??= await besuche.GetVorschlaegeAsync(BenutzerId, SalonId); }
        catch (UnauthorizedAccessException) { vorschlaege = null; }
    }

    private async Task StarteAnkunftAsync()
    {
        grund = raum = notiz = ""; fehler = null;
        await LadeVorschlaegeAsync();
        ankunftOffen = true;
    }

    private async Task StarteBearbeiten()
    {
        if (fiche?.Offen is not { } offen) return;
        grund = offen.Grund; raum = offen.Raum ?? ""; fehler = null;
        await LadeVorschlaegeAsync();
        bearbeiten = true;
    }

    private async Task AusfuehrenAsync(Func<Task> aktion, string erfolg)
    {
        fehler = null;
        try
        {
            await aktion();
            ankunftOffen = bearbeiten = false;
            toast.ZeigeErfolg(erfolg);
            await LadeAsync();
            await OnGeaendert.InvokeAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException) { fehler = ex.Message; }
    }

    private Task AnkunftAsync() => AusfuehrenAsync(() => besuche.AnkunftAsync(BenutzerId, SalonId, KundeId, grund, raum, notiz), "Arrivée enregistrée.");
    private Task AendereAsync() => AusfuehrenAsync(() => besuche.AendereBesuchAsync(BenutzerId, fiche!.Offen!.Id, grund, raum), "Passage mis à jour.");
    private Task BeendeAsync() => AusfuehrenAsync(() => besuche.BeendeAsync(BenutzerId, fiche!.Offen!.Id), "Départ enregistré.");
    private Task AnnuliereAsync() => AusfuehrenAsync(() => besuche.AnnuliereAsync(BenutzerId, fiche!.Offen!.Id), "Arrivée annulée.");

    private async Task SchliesseAsync()
    {
        geladenFuer = Guid.Empty;
        await OnClose.InvokeAsync();
    }
}
