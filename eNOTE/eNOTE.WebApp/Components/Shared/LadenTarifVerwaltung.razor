@using ENote.Core.DataModels.Abo
@using ENote.Core.Services

@* Reiner Button: meldet das Öffnen an die Eltern-Seite. Das Modal wird dort zentral am Seitenende gerendert,
   damit es nicht von einem scrollbaren Container (overflow) beschnitten wird. *@
<button class="enote-btn enote-btn-ghost" @onclick="OeffneAsync">Tarif personnalisé</button>

@code {
    [Parameter] public Guid SalonId { get; set; }
    [Parameter] public EventCallback<Guid> OnOeffnen { get; set; }

    private async Task OeffneAsync()
    {
        if (OnOeffnen.HasDelegate)
        {
            await OnOeffnen.InvokeAsync(SalonId);
        }
    }
}
