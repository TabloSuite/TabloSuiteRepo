@page "/auth/register"
@layout Layout.AuthLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Inscription</PageTitle>

<div class="auth-page">
    <div class="auth-hero">
        <a href="/" class="auth-hero-logo" title="Retour à l'accueil">eN</a>
        <h1>Lancez la caisse de votre établissement en quelques minutes.</h1>
        <p>Créez votre compte propriétaire et votre établissement. L'administrateur valide ensuite votre inscription.</p>
        <ul class="auth-hero-points">
            <li><span class="check">✓</span> Prestations &amp; articles avec stock</li>
            <li><span class="check">✓</span> Remises et codes PIN pour l'équipe</li>
            <li><span class="check">✓</span> Reçus personnalisés (logo, slogan)</li>
        </ul>
    </div>

    <div class="auth-panel">
        <a href="/" class="auth-zurueck"><span aria-hidden="true">←</span> Retour à l'accueil</a>
        <div class="auth-card">
            <h1>Inscrire mon établissement</h1>
            <p class="auth-subtitle">Créez votre compte propriétaire et votre établissement.</p>

            @* Reines HTML-Formular wie die Anmeldeseite (Testabend 18.11.2026): interaktiv vorgerendert verlor die Seite bei schwachem Netz
               alles Getippte, sobald Blazor sie nach dem Verbindungsaufbau neu zeichnete, und wer vorher tippte, schickte ein leeres Formular ab.
               Jetzt prüft und speichert der Server beim Absenden; der Knopf ist gesperrt, bis alle Felder mit * ausgefüllt sind (enote.js,
               data-pflicht-sperre), und zeigt sofort den Ladekreis (data-ladeanzeige). *@
            <EditForm Model="Model" OnValidSubmit="HandleSubmit" FormName="register-form" class="auth-form" method="post"
                      data-ladeanzeige="Inscription en cours…" data-pflicht-sperre>
                <DataAnnotationsValidator />

                <div class="enote-form-grid">
                    <label>
                        <span class="enote-pflicht">Prénom</span>
                        <InputText @bind-Value="Model!.Vorname" required autocomplete="given-name" maxlength="@ENote.WebApp.Services.KontoProfilService.MaxNamenLaenge" />
                    </label>
                    <label>
                        <span class="enote-pflicht">Nom</span>
                        <InputText @bind-Value="Model!.Nachname" required autocomplete="family-name" maxlength="@ENote.WebApp.Services.KontoProfilService.MaxNamenLaenge" />
                    </label>
                </div>

                <label>
                    <span class="enote-pflicht">Pseudonyme (identifiant de connexion)</span>
                    <InputText @bind-Value="Model!.Pseudonym" required autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="@ENote.WebApp.Services.AuthService.PseudonymMax" />
                    <small>Sans espace ni accent, ex. kofi.mensah</small>
                </label>

                <label>
                    <span class="enote-pflicht">Adresse e-mail de contact</span>
                    <InputText @bind-Value="Model!.Email" type="email" required autocomplete="email" maxlength="@ENote.WebApp.Services.AuthService.EmailMax" />
                </label>

                <label>
                    <span class="enote-pflicht">Téléphone</span>
                    <InputText @bind-Value="Model!.Telefon" type="tel" required autocomplete="tel" maxlength="30" placeholder="ex. +228 90 12 34 56" />
                    <small>Pour vous joindre facilement (appel ou WhatsApp).</small>
                </label>

                <label>
                    <span class="enote-pflicht">Mot de passe</span>
                    <PasswordInput @bind-Value="Model!.Passwort" Name="Model.Passwort" Required="true" Autocomplete="new-password" />
                    <small>Au moins 6 caractères, dont 1 chiffre et 1 lettre minuscule.</small>
                </label>

                <label>
                    <span class="enote-pflicht">Nom de l'établissement</span>
                    <InputText @bind-Value="Model!.SalonName" required autocomplete="organization" maxlength="@ENote.WebApp.Services.AuthService.LadenNameMax" />
                </label>

                <div class="enote-form-grid">
                    <label>
                        <span class="enote-pflicht">Pays</span>
                        <InputSelect @bind-Value="Model!.Land" class="auth-select" required>
                            @foreach (var l in laender)
                            {
                                <option value="@l">@l</option>
                            }
                        </InputSelect>
                    </label>
                    <label>
                        Ville / quartier (facultatif)
                        <InputText @bind-Value="Model!.SalonStandort" autocomplete="address-level2" />
                    </label>
                </div>
                <small class="enote-muted auth-land-hinweis">@ENote.WebApp.Services.LaenderAuswahl.Hinweis Modifiable ensuite dans « Paramètres ».</small>

                <label>
                    Slogan (facultatif)
                    <InputText @bind-Value="Model!.Slogan" placeholder="ex. In God we trust" />
                </label>

                <div class="cgu-accept">
                    <label class="checkbox">
                        <InputCheckbox @bind-Value="Model!.CguAcceptees" required />
                        <span class="enote-pflicht">J'ai lu et j'accepte les Conditions Générales d'Utilisation</span>
                    </label>
                    <details class="cgu-details">
                        <summary>Lire les Conditions Générales d'Utilisation</summary>
                        <div class="cgu-text"><ConditionsGenerales /></div>
                    </details>
                    <ValidationMessage For="() => Model!.CguAcceptees" />
                </div>

                @* Meldungen direkt über dem Knopf: dort schaut man nach dem Tippen hin (am Handy liegt der Formularkopf außerhalb des Bildschirms). *@
                <ValidationSummary />
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-error" role="alert">@errorMessage</div>
                }

                <button type="submit" class="btn-primary">
                    <span class="btn-text">S'inscrire</span>
                </button>
                <small class="enote-muted auth-pflicht-hinweis">Les champs marqués d'un <span class="enote-pflicht"></span> sont obligatoires.</small>
            </EditForm>

            <p class="auth-footer">Déjà un compte ? <a href="/auth/login">Se connecter</a></p>
        </div>
    </div>
</div>
