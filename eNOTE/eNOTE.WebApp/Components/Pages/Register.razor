@page "/auth/register"
@layout Layout.AuthLayout
@attribute [AllowAnonymous]

<PageTitle>Inscription</PageTitle>

<div class="auth-page">
    <div class="auth-hero">
        <a href="/" class="auth-hero-logo" title="Retour à l'accueil">eN</a>
        <h1>Lancez la caisse de votre établissement en quelques minutes.</h1>
        <p>Créez votre compte propriétaire et votre établissement. L'administrateur valide ensuite votre inscription.</p>
        <ul class="auth-hero-points">
            <li><span class="check">✓</span> Prestations &amp; articles avec stock</li>
            <li><span class="check">✓</span> Remises et codes PIN pour l'équipe</li>
            <li><span class="check">✓</span> Reçus personnalisés (logo, slogan)</li>
        </ul>
    </div>

    <div class="auth-panel">
        <a href="/" class="auth-zurueck"><span aria-hidden="true">←</span> Retour à l'accueil</a>
        <div class="auth-card">
            <h1>Inscrire mon établissement</h1>
            <p class="auth-subtitle">Créez votre compte propriétaire et votre établissement.</p>

            <EditForm Model="FormModel" OnValidSubmit="HandleSubmit" FormName="register-form" class="auth-form">
                <DataAnnotationsValidator />

                <div class="enote-form-grid">
                    <label>
                        Prénom
                        <InputText @bind-Value="FormModel.Vorname" />
                    </label>
                    <label>
                        Nom
                        <InputText @bind-Value="FormModel.Nachname" />
                    </label>
                </div>

                <label>
                    Pseudonyme (identifiant de connexion)
                    <InputText @bind-Value="FormModel.Pseudonym" autocomplete="username" />
                </label>

                <label>
                    Adresse e-mail de contact
                    <InputText @bind-Value="FormModel.Email" type="email" />
                </label>

                <label>
                    Téléphone
                    <InputText @bind-Value="FormModel.Telefon" type="tel" autocomplete="tel" maxlength="30" placeholder="ex. +228 90 12 34 56" />
                    <small>Pour vous joindre facilement (appel ou WhatsApp).</small>
                </label>

                <label>
                    Mot de passe
                    <PasswordInput @bind-Value="FormModel.Passwort" Required="true" Autocomplete="new-password" />
                    <small>Au moins 6 caractères, dont 1 chiffre et 1 lettre minuscule.</small>
                </label>

                <label>
                    Nom de l'établissement
                    <InputText @bind-Value="FormModel.SalonName" />
                </label>

                <div class="enote-form-grid">
                    <label>
                        Pays
                        <EnoteSelect TValue="string" Value="FormModel.Land" ValueChanged="(string? l) => FormModel.Land = l ?? FormModel.Land"
                                     Options="landOptionen" MitSuche="true" Placeholder="Choisir le pays…" />
                    </label>
                    <label>
                        Ville / quartier (facultatif)
                        <InputText @bind-Value="FormModel.SalonStandort" />
                    </label>
                </div>
                <small class="enote-muted auth-land-hinweis">@ENote.WebApp.Services.LaenderAuswahl.Hinweis Modifiable ensuite dans « Paramètres ».</small>

                <label>
                    Slogan (facultatif)
                    <InputText @bind-Value="FormModel.Slogan" placeholder="ex. In God we trust" />
                </label>

                <div class="cgu-accept">
                    <label class="checkbox">
                        <InputCheckbox @bind-Value="FormModel.CguAcceptees" />
                        <span>J'ai lu et j'accepte les <button type="button" class="cgu-link" @onclick="() => cguOffen = true" @onclick:preventDefault>Conditions Générales d'Utilisation</button></span>
                    </label>
                    <ValidationMessage For="() => FormModel.CguAcceptees" />
                </div>

                @* Meldungen direkt über dem Knopf: dort schaut man nach dem Tippen hin (am Handy liegt der Formularkopf
                   außerhalb des Bildschirms). Fehlende Pflichtfelder wurden vorher gar nicht angezeigt – der Knopf tat nichts. *@
                <ValidationSummary />
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-error" role="alert">@errorMessage</div>
                }

                <button type="submit" class="btn-primary" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="btn-spinner"></span>
                        <span>Inscription en cours…</span>
                    }
                    else
                    {
                        <span>S'inscrire</span>
                    }
                </button>
            </EditForm>

            <p class="auth-footer">Déjà un compte ? <a href="/auth/login">Se connecter</a></p>
        </div>
    </div>
</div>

<ModalDialog Open="cguOffen" Title="Conditions Générales d'Utilisation" OnClose="() => cguOffen = false" MaxWidthClass="enote-modal-wide">
    <ChildContent>
        <ConditionsGenerales />
    </ChildContent>
    <Footer>
        <button type="button" class="enote-btn enote-btn-primary" @onclick="() => { FormModel.CguAcceptees = true; cguOffen = false; }">J'accepte</button>
    </Footer>
</ModalDialog>
