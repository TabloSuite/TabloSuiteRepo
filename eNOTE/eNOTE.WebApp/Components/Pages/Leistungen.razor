@page "/services"
@attribute [Authorize(Roles = "Besitzer, Kassierer")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using ENote.Core.DataModels.Katalog
@using ENote.Core.Services.Katalog

<PageTitle>Prestations</PageTitle>

<BesitzerPinGuard Recht="leistungen">
<div class="enote-page">
    <div class="enote-page-header">
        <div>
            <h1>Prestations &amp; articles</h1>
            <p>@leistungen.Count(l => !l.IstStandardArtikel) éléments en vente · @kategorien.Count catégories</p>
        </div>
        @if (darfVerwalten)
        {
            <button class="enote-btn enote-btn-primary" @onclick="NeuAnlegen"><Icon Name="plus" Groesse="18" /> Nouvelle prestation</button>
        }
    </div>

    @if (isLoading)
    {
        <p class="enote-muted" role="status">Chargement…</p>
    }
    else
    {
        <div class="pr-layout">
            @* LINKS: Kategorien (zugleich Filter) *@
            <aside class="pr-kats enote-card">
                <div class="pr-kats-kopf">
                    <h2>Catégories</h2>
                </div>
                <button type="button" class="pr-kat @(string.IsNullOrEmpty(kategorieFilter) ? "aktiv" : "")" @onclick='() => kategorieFilter = string.Empty'>
                    <Icon Name="grid" Groesse="16" /><span class="pr-kat-name">Toutes</span><span class="enote-baum-anzahl">@leistungen.Count(l => !l.IstStandardArtikel)</span>
                </button>
                @if (darfVerwalten)
                {
                    @* Am Handy/Tablet hochkant fehlen Anlegen/Ändern/Löschen in der Leiste (18.11.2026) → eigenes Fenster *@
                    <button type="button" class="pr-kat pr-kat-verwalten" @onclick="() => kategorienVerwaltenOffen = true"><Icon Name="settings" Groesse="16" /><span class="pr-kat-name">Gérer les catégories</span></button>
                }
                @foreach (var knoten in kategorieBaum)
                {
                    var hatUnter = knoten.Unterkategorien.Count > 0;
                    var istAuf = aufgeklappteKategorieId == knoten.Kategorie.Id || knoten.Unterkategorien.Any(u => u.Id.ToString() == kategorieFilter);
                    <div class="pr-kat-gruppe">
                        <div class="pr-kat-zeile">
                            <button type="button" class="pr-kat @(kategorieFilter == knoten.Kategorie.Id.ToString() ? "aktiv" : "")" @onclick="() => FilterKategorie(knoten.Kategorie.Id)">
                                <span class="pr-kat-auf" @onclick="() => ToggleAufklappen(knoten.Kategorie.Id)" @onclick:stopPropagation="true">
                                    @if (hatUnter) { <Icon Name="@(istAuf ? "chevron-down" : "chevron-right")" Groesse="16" /> } else { <Icon Name="tag" Groesse="16" /> }
                                </span>
                                <span class="kx-kat-punkt" style="background: @KategorieFarbe(knoten.Kategorie.Id)" aria-hidden="true"></span>
                                <span class="pr-kat-name">@knoten.Kategorie.Name</span>
                                <span class="enote-baum-anzahl">@AnzahlInKategorie(knoten.Kategorie.Id)</span>
                            </button>
                            @if (darfVerwalten)
                            {
                                <div class="pr-kat-aktionen">
                                    <button type="button" title="Ajouter une sous-catégorie" aria-label="Ajouter une sous-catégorie" @onclick="() => OeffneUnterkategorieDialog(knoten.Kategorie.Id)"><Icon Name="plus" Groesse="16" /></button>
                                    <button type="button" title="Modifier (nom, couleur)" aria-label="Modifier la catégorie" @onclick="() => OeffneKategorieUmbenennen(knoten.Kategorie)"><Icon Name="edit" Groesse="16" /></button>
                                    <button type="button" class="gefahr" title="Supprimer" aria-label="Supprimer" @onclick="() => LoescheKategorieFragen(knoten.Kategorie)"><Icon Name="trash" Groesse="16" /></button>
                                </div>
                            }
                        </div>
                        @if (istAuf)
                        {
                            @foreach (var unter in knoten.Unterkategorien)
                            {
                                <div class="pr-kat-zeile pr-kat-unter">
                                    <button type="button" class="pr-kat @(kategorieFilter == unter.Id.ToString() ? "aktiv" : "")" @onclick="() => FilterKategorie(unter.Id)">
                                        <span class="kx-kat-punkt" style="background: @KategorieFarbe(unter.Id)" aria-hidden="true"></span>
                                        <span class="pr-kat-name">@unter.Name</span>
                                        <span class="enote-baum-anzahl">@AnzahlInKategorie(unter.Id)</span>
                                    </button>
                                    @if (darfVerwalten)
                                    {
                                        <div class="pr-kat-aktionen">
                                            <button type="button" title="Modifier (nom, couleur)" aria-label="Modifier la sous-catégorie" @onclick="() => OeffneKategorieUmbenennen(unter)"><Icon Name="edit" Groesse="16" /></button>
                                            <button type="button" class="gefahr" title="Supprimer" aria-label="Supprimer" @onclick="() => LoescheKategorieFragen(unter)"><Icon Name="trash" Groesse="16" /></button>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        @if (unterkategorieParentId == knoten.Kategorie.Id)
                        {
                            <div class="pr-kat-neu pr-kat-unter">
                                <input @bind="neueUnterkategorieName" @bind:event="oninput" maxlength="@ENote.WebApp.Services.KatalogService.KategorieNameMax" placeholder="Nom de la sous-catégorie…" class="enote-input-inline" />
                                <AsyncActionButton Text="OK" OnClick="FuegeUnterkategorieHinzuAsync" CssClass="enote-btn-primary enote-btn-sm" Disabled="@string.IsNullOrWhiteSpace(neueUnterkategorieName)" />
                                <button type="button" class="enote-icon-btn" aria-label="Annuler" @onclick="SchliesseUnterkategorieDialog"><Icon Name="x" Groesse="16" /></button>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(unterkategorieFehler))
                            {
                                <div class="alert alert-error">@unterkategorieFehler</div>
                            }
                        }
                    </div>
                }
                @if (darfVerwalten)
                {
                    <div class="pr-kat-neu">
                        <input @bind="neueKategorieName" @bind:event="oninput" maxlength="@ENote.WebApp.Services.KatalogService.KategorieNameMax" placeholder="Nouvelle catégorie…" class="enote-input-inline" />
                        <AsyncActionButton Text="Ajouter" OnClick="FuegeKategorieHinzuAsync" CssClass="enote-btn-sm" Disabled="@string.IsNullOrWhiteSpace(neueKategorieName)" />
                    </div>
                }
            </aside>

            <ModalDialog Open="kategorienVerwaltenOffen" Title="Catégories" OnClose="() => kategorienVerwaltenOffen = false" MaxWidthClass="enote-modal-sm">
                <ChildContent>
                    <div class="pr-verw">
                        @if (kategorieBaum.Count == 0)
                        {
                            <p class="enote-muted">Aucune catégorie. Créez-en une ci-dessous (ex. Coiffure, Soins, Produits).</p>
                        }
                        @foreach (var knoten in kategorieBaum)
                        {
                            <div class="pr-verw-zeile">
                                <span class="kx-kat-punkt" style="background: @KategorieFarbe(knoten.Kategorie.Id)" aria-hidden="true"></span>
                                <span class="pr-verw-name">@knoten.Kategorie.Name</span>
                                <span class="pr-verw-aktionen">
                                    <button type="button" aria-label="Ajouter une sous-catégorie" title="Ajouter une sous-catégorie" @onclick="() => OeffneUnterkategorieDialog(knoten.Kategorie.Id)"><Icon Name="plus" Groesse="16" /></button>
                                    <button type="button" aria-label="Modifier la catégorie" title="Modifier (nom, couleur)" @onclick="() => OeffneKategorieUmbenennen(knoten.Kategorie)"><Icon Name="edit" Groesse="16" /></button>
                                    <button type="button" class="gefahr" aria-label="Supprimer" title="Supprimer" @onclick="() => LoescheKategorieFragen(knoten.Kategorie)"><Icon Name="trash" Groesse="16" /></button>
                                </span>
                            </div>
                            @foreach (var unter in knoten.Unterkategorien)
                            {
                                <div class="pr-verw-zeile unter">
                                    <span class="kx-kat-punkt" style="background: @KategorieFarbe(unter.Id)" aria-hidden="true"></span>
                                    <span class="pr-verw-name">@unter.Name</span>
                                    <span class="pr-verw-aktionen">
                                        <button type="button" aria-label="Modifier la sous-catégorie" title="Modifier (nom, couleur)" @onclick="() => OeffneKategorieUmbenennen(unter)"><Icon Name="edit" Groesse="16" /></button>
                                        <button type="button" class="gefahr" aria-label="Supprimer" title="Supprimer" @onclick="() => LoescheKategorieFragen(unter)"><Icon Name="trash" Groesse="16" /></button>
                                    </span>
                                </div>
                            }
                            @if (unterkategorieParentId == knoten.Kategorie.Id)
                            {
                                <div class="pr-verw-neu unter">
                                    <input @bind="neueUnterkategorieName" @bind:event="oninput" maxlength="@ENote.WebApp.Services.KatalogService.KategorieNameMax" placeholder="Nom de la sous-catégorie…" class="enote-input" />
                                    <AsyncActionButton Text="OK" OnClick="FuegeUnterkategorieHinzuAsync" CssClass="enote-btn-primary enote-btn-sm" Disabled="@string.IsNullOrWhiteSpace(neueUnterkategorieName)" />
                                    <button type="button" class="enote-icon-btn" aria-label="Annuler" @onclick="SchliesseUnterkategorieDialog"><Icon Name="x" Groesse="16" /></button>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(unterkategorieFehler))
                                {
                                    <div class="alert alert-error">@unterkategorieFehler</div>
                                }
                            }
                        }
                        <div class="pr-verw-neu">
                            <input @bind="neueKategorieName" @bind:event="oninput" maxlength="@ENote.WebApp.Services.KatalogService.KategorieNameMax" placeholder="Nouvelle catégorie…" class="enote-input" />
                            <AsyncActionButton Text="Ajouter" OnClick="FuegeKategorieHinzuAsync" CssClass="enote-btn-primary enote-btn-sm" Disabled="@string.IsNullOrWhiteSpace(neueKategorieName)" />
                        </div>
                    </div>
                </ChildContent>
                <Footer>
                    <button class="enote-btn enote-btn-ghost" @onclick="() => kategorienVerwaltenOffen = false">Fermer</button>
                </Footer>
            </ModalDialog>

            @* RECHTS: Artikel *@
            <section class="pr-liste">
                @if (darfVerwalten && Lager.Artikel > 0)
                {
                    <button type="button" class="pr-lager" @onclick="() => inventurOffen = true" title="Voir l'inventaire détaillé">
                        <div class="pr-lager-kpi">
                            <small>Stock</small>
                            <strong>@Lager.Stueck.ToString("0.##") <span>unités · @Lager.Artikel articles</span></strong>
                        </div>
                        <div class="pr-lager-kpi">
                            <small>Valeur d'achat</small>
                            <strong>@Lager.Einkaufswert.ToString("N0") F</strong>
                        </div>
                        <div class="pr-lager-kpi">
                            <small>Valeur de vente</small>
                            <strong>@Lager.Verkaufswert.ToString("N0") F</strong>
                        </div>
                        <div class="pr-lager-kpi gewinn">
                            <small>Bénéfice si tout est vendu</small>
                            <strong>@Lager.Gewinn.ToString("N0") F @if (Lager.MargeProzent is decimal m) { <span>· @m %</span> }</strong>
                        </div>
                        @if (Lager.OhneEinkaufspreis > 0)
                        {
                            <span class="pr-lager-hinweis"><Icon Name="info" Groesse="14" /> @Lager.OhneEinkaufspreis article(s) sans prix d'achat : non compté(s) dans le bénéfice.</span>
                        }
                        <span class="pr-lager-mehr">Inventaire <Icon Name="chevron-right" Groesse="16" /></span>
                    </button>
                }
                <div class="kx-suche pr-suche">
                    <Icon Name="search" Groesse="20" CssClass="kx-suche-ico" />
                    <input class="kx-suche-feld" placeholder="Rechercher une prestation ou un code-barres…" @bind="leistungsSuche" @bind:event="oninput" />
                </div>

                @{ var gefiltert = GefilterteLeistungen().Where(l => !l.IstStandardArtikel).OrderBy(l => l.Name).ToList(); }
                @if (leistungen.Count(l => !l.IstStandardArtikel) == 0)
                {
                    <div class="enote-empty pr-leer">
                        <Icon Name="tag" Groesse="30" Strich="1.5" />
                        <p>Aucune prestation pour le moment.</p>
                        @if (darfVerwalten)
                        {
                            <button class="enote-btn enote-btn-primary" @onclick="NeuAnlegen"><Icon Name="plus" Groesse="18" /> Créer ma première prestation</button>
                        }
                    </div>
                }
                else if (gefiltert.Count == 0)
                {
                    <p class="enote-empty">Aucun résultat.</p>
                }
                else
                {
                    <div class="pr-raster enote-liste-scroll">
                        @foreach (var l in gefiltert)
                        {
                            @PrestationKarte(l)
                        }
                    </div>
                }
            </section>
        </div>
    }
</div>

@code {
    private RenderFragment<Leistung> PrestationKarte => l => __builder =>
    {
        <article class="pr-karte @(l.IstAktiv ? "" : "inaktiv")">
            <div class="pr-bild" style="--kat: @KategorieFarbe(l.KategorieId)">
                @if (bildUrls.TryGetValue(l.Id, out var bild))
                {
                    <img src="@bild" alt="" loading="lazy" />
                }
                else
                {
                    <span>@l.Name[..Math.Min(2, l.Name.Length)].ToUpperInvariant()</span>
                }
            </div>
            <div class="pr-info">
                <div class="pr-titel">
                    <strong>@l.Name</strong>
                    @if (favoritenIds.Contains(l.Id))
                    {
                        <Icon Name="star" Groesse="14" CssClass="pr-stern" Titel="Favori" />
                    }
                </div>
                <div class="pr-meta">
                    @if (darfVerwalten)
                    {
                        <button type="button" class="pr-kat-chip" @onclick="() => OeffneZuordnungModal(l)" title="Changer la catégorie">
                            <span class="kx-kat-punkt" style="background: @KategorieFarbe(l.KategorieId)"></span>@KategorieNameVon(l)<Icon Name="chevron-down" Groesse="12" />
                        </button>
                    }
                    else
                    {
                        <span class="pr-kat-chip"><span class="kx-kat-punkt" style="background: @KategorieFarbe(l.KategorieId)"></span>@KategorieNameVon(l)</span>
                    }
                    @if (l.HatStueckzahl)
                    {
                        <span class="enote-tag @(BestandWarnung(l) ? "enote-tag-warn" : "enote-tag-off")">@(BestandWarnung(l) ? "Stock bas · " : "Stock · ")@l.Stueckzahl.ToString("0.##")</span>
                    }
                    @if (!l.IstAktiv)
                    {
                        <span class="enote-tag enote-tag-off">Inactive</span>
                    }
                </div>
            </div>
            <div class="pr-preis">
                <strong>@l.Preis.ToString("N0") F</strong>
                @if (l.Typ == LeistungsTyp.Produit && l.Kaufpreis is decimal kauf && l.Preis > 0)
                {
                    <small class="enote-marge">+@((l.Preis - kauf).ToString("N0")) F</small>
                }
            </div>
            @if (darfVerwalten)
            {
                <div class="pr-aktionen">
                    <button class="enote-btn enote-btn-sm" @onclick="() => Bearbeiten(l)"><Icon Name="edit" Groesse="16" /> Modifier</button>
                    @if (l.HatStueckzahl && l.Stueckzahl > 0)
                    {
                        <button class="enote-btn enote-btn-sm enote-btn-icon" title="Déclarer une perte (cassé, périmé…)" aria-label="Déclarer une perte" @onclick="() => OeffneVerlust(l)"><Icon Name="alert" Groesse="16" /></button>
                    }
                    @if (!string.IsNullOrWhiteSpace(l.StrichCode))
                    {
                        <button class="enote-btn enote-btn-sm enote-btn-icon" title="Imprimer des étiquettes" aria-label="Imprimer des étiquettes" @onclick="() => OeffneEtikettDialog(l)"><Icon Name="printer" Groesse="16" /></button>
                    }
                    <button class="enote-btn enote-btn-sm enote-btn-icon enote-btn-abbrechen" title="Supprimer" aria-label="Supprimer" @onclick="() => LoeschenFragen(l)"><Icon Name="trash" Groesse="16" /></button>
                </div>
            }
        </article>;
    };
}

<ModalDialog Open="editorOffen" Title="@(bearbeitungsLeistung.Id == Guid.Empty ? "Nouvelle prestation" : "Modifier la prestation")" ErrorMessage="@editorFehler" OnClose="SchliesseEditor">
    <ChildContent>
        <div class="enote-form">
            <label><span class="enote-pflicht">Nom</span> <input @bind="bearbeitungsLeistung.Name" @bind:event="oninput" maxlength="@ENote.WebApp.Services.KatalogService.LeistungNameMax" /></label>
            <label>Description <input @bind="bearbeitungsLeistung.Beschreibung" /></label>

            @* Typ zuerst: Prestation (Dienstleistung) oder Produit (Artikel) *@
            <label>Type de prestation</label>
            <div class="enote-typ-auswahl">
                <button type="button" class="enote-typ-btn @(bearbeitungsLeistung.Typ == LeistungsTyp.Prestation ? "enote-typ-btn-aktiv" : "")"
                        @onclick="() => SetzeTyp(LeistungsTyp.Prestation)">
                    <span class="enote-typ-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="8.5" y1="8.5" x2="20" y2="20"/><line x1="8.5" y1="15.5" x2="20" y2="4"/></svg></span>
                    <span class="enote-typ-text">
                        <strong>Prestation</strong>
                        <small>Service (ex. Coiffure Enfant) – uniquement le prix de vente.</small>
                    </span>
                </button>
                <button type="button" class="enote-typ-btn @(bearbeitungsLeistung.Typ == LeistungsTyp.Produit ? "enote-typ-btn-aktiv" : "")"
                        @onclick="() => SetzeTyp(LeistungsTyp.Produit)">
                    <span class="enote-typ-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg></span>
                    <span class="enote-typ-text">
                        <strong>Produit</strong>
                        <small>Article (ex. Cola) – prix d'achat + prix de vente (marge), stock optionnel.</small>
                    </span>
                </button>
            </div>

            <label>Catégorie (facultatif)</label>
            <EnoteSelect TValue="string" @bind-Value="kategorieIdText" Options="kategorieOptionen" Placeholder="— Aucune —" MitSuche="true" />

            <label for="pr-barcode">Code-barres</label>
            <div class="pr-barcode">
                <div class="pr-barcode-feld">
                    <Icon Name="scan" Groesse="18" CssClass="pr-barcode-ico" />
                    <input id="pr-barcode" class="enote-input" inputmode="text" autocomplete="off" maxlength="@Core.Services.Katalog.BarcodeRegeln.MaxLaenge"
                           placeholder="Scannez ou saisissez le code du fabricant…"
                           @bind="bearbeitungsLeistung.StrichCode" @bind:after="PruefeBarcodeAsync" />
                </div>
                <button type="button" class="enote-btn" title="Créer un code interne" @onclick="GeneriereBarcodeAsync"><Icon Name="refresh" Groesse="16" /> Générer</button>
            </div>
            @if (barcodePruefung is { } bp)
            {
                <small class="pr-barcode-hinweis @(bp.Fehler ? "fehler" : bp.Warnung ? "warnung" : "ok")" role="@(bp.Fehler ? "alert" : "status")">
                    <Icon Name="@(bp.Fehler ? "alert" : bp.Warnung ? "info" : "check")" Groesse="14" /> @bp.Hinweis
                </small>
            }

            @* Preis-Felder je nach Typ *@
            @if (bearbeitungsLeistung.Typ == LeistungsTyp.Prestation)
            {
                <label>Prix de la prestation (F) <input type="number" min="0" step="50" @bind="PreisFeld" /></label>
            }
            else
            {
                <div class="enote-form-grid">
                    <label>Prix de vente (F) <input type="number" min="0" step="50" @bind="PreisFeld" /></label>
                    <label>Prix d'achat (F) <input type="number" min="0" step="50" @bind="bearbeitungsLeistung.Kaufpreis" /></label>
                </div>
                @if (bearbeitungsLeistung.Kaufpreis is not null && bearbeitungsLeistung.Preis > 0)
                {
                    <small class="enote-marge">Marge : <strong>@MargeText()</strong></small>
                }
            }

            <label>Image (facultatif)</label>
            <BildAuswahl @bind-VorschauUrl="bildVorschau"
                         OnBildBereit="HandleBildBereit"
                         OnEntfernt="HandleBildEntfernt" />
            @if (!string.IsNullOrWhiteSpace(bildFehler))
            {
                <div class="alert alert-error">@bildFehler</div>
            }

            @* Stock nur bei Produit sinnvoll. Schließt Sammel-Artikel aus. *@
            @if (bearbeitungsLeistung.Typ == LeistungsTyp.Produit)
            {
                <EnoteCheckbox Value="bearbeitungsLeistung.HatStueckzahl" ValueChanged="SetzeHatStueckzahl" Label="Article avec stock" Disabled="@(istSammelArtikel)" />
                @if (bearbeitungsLeistung.HatStueckzahl)
                {
                    <div class="enote-form-grid">
                        <label>Stock actuel (unités : pièces, mètres…) <input type="number" min="0" step="0.5" @bind="bearbeitungsLeistung.Stueckzahl" /></label>
                        <label>Alerte si stock ≤ <input type="number" min="0" step="0.5" @bind="bearbeitungsLeistung.MindestbestandWarnung" /></label>
                    </div>
                }

                <EnoteCheckbox Value="istSammelArtikel" ValueChanged="SetzeSammelArtikel" Label="Article lié à un stock de base (ex. « Tissu A (3 m) »)" Disabled="@(bearbeitungsLeistung.HatStueckzahl)" />
                @if (istSammelArtikel && !bearbeitungsLeistung.HatStueckzahl)
                {
                    <label><span class="enote-pflicht">Stock de base</span></label>
                    <EnoteSelect TValue="string" @bind-Value="basisLeistungIdText" Options="basisOptionen" Placeholder="— Choisir —" MitSuche="true" />
                    <label><span class="enote-pflicht">Quantité retirée par vente (ex. 3 pour 3 m)</span> <input type="number" min="0" step="0.5" @bind="basisAbzugMenge" @bind:event="oninput" /></label>
                }
            }

            <EnoteCheckbox @bind-Value="bearbeitungsLeistung.IstAktiv" Label="Active" />
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="SchliesseEditor">Annuler</button>
        <AsyncActionButton Text="Enregistrer" OnClick="SpeichernAsync" CssClass="enote-btn-primary" Disabled="@(!LeistungVollstaendig)" />
    </Footer>
</ModalDialog>

@* Verlust / Abschreibung *@
<ModalDialog Open="verlustArtikel is not null" Title="Déclarer une perte" ErrorMessage="@verlustFehler" OnClose="() => verlustArtikel = null" MaxWidthClass="enote-modal-sm">
    <ChildContent>
        @if (verlustArtikel is { } va)
        {
            <div class="enote-form">
                <p class="enote-muted">« @va.Name » · en stock : <strong>@va.Stueckzahl.ToString("0.##")</strong>. L'article sort du stock sans vente ; la perte est comptée au prix d'achat.</p>
                <label>Raison</label>
                <div class="enote-betrag-schnell">
                    @foreach (var g in Enum.GetValues<ENote.Core.DataModels.Katalog.AbschreibungsGrund>())
                    {
                        <button type="button" class="enote-chip @(verlustGrund == g ? "enote-chip-aktiv" : "")" @onclick="() => verlustGrund = g">@ENote.WebApp.Services.BestandsService.GrundText(g)</button>
                    }
                </div>
                <div class="kx-frei-menge">
                    <span>Quantité</span>
                    <div class="kx-pos-menge">
                        <button type="button" @onclick="() => verlustMenge = Math.Max(1, verlustMenge - 1)" aria-label="Diminuer"><Icon Name="minus" Groesse="16" /></button>
                        <span>@verlustMenge.ToString("0.##")</span>
                        <button type="button" @onclick="() => verlustMenge = Math.Min(va.Stueckzahl, verlustMenge + 1)" aria-label="Augmenter"><Icon Name="plus" Groesse="16" /></button>
                    </div>
                </div>
                <label><span class="@(VerlustNotizNoetig ? "enote-pflicht" : null)">@(VerlustNotizNoetig ? "Note" : "Note (facultatif)")</span> <input @bind="verlustNotiz" @bind:event="oninput" maxlength="500" placeholder="ex. flacon tombé, date dépassée…" /></label>
                <div class="kx-pay-rueck fehlt">
                    <span>Perte</span>
                    <strong>@(va.Kaufpreis is decimal k ? (k * verlustMenge).ToString("N0") + " F" : "prix d'achat inconnu")</strong>
                </div>
            </div>
        }
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => verlustArtikel = null">Annuler</button>
        <AsyncActionButton Text="Retirer du stock" OnClick="SchreibeAbAsync" CssClass="enote-btn-danger" Disabled="@(VerlustNotizNoetig && string.IsNullOrWhiteSpace(verlustNotiz))" />
    </Footer>
</ModalDialog>

@* Inventar: Wert je Artikel *@
<ModalDialog Open="inventurOffen" Title="Inventaire et valeur du stock" OnClose="() => inventurOffen = false" MaxWidthClass="enote-modal-lg">
    <ChildContent>
        <p class="enote-muted">Valeur d'achat = argent immobilisé en stock. Bénéfice = ce que rapporterait la vente de tout le stock au prix actuel.</p>
        <div class="enote-table-scroll"><table class="enote-table">
            <thead><tr><th>Article</th><th class="r">Stock</th><th class="r">Prix d'achat</th><th class="r">Valeur d'achat</th><th class="r">Valeur de vente</th><th class="r">Bénéfice</th></tr></thead>
            <tbody>
                @foreach (var p in Lager.Positionen)
                {
                    <tr>
                        <td>@p.Name</td>
                        <td class="r">@p.Bestand.ToString("0.##")</td>
                        <td class="r">@(p.Einkaufspreis is decimal e ? e.ToString("N0") + " F" : "—")</td>
                        <td class="r">@(p.Einkaufswert is decimal ew ? ew.ToString("N0") + " F" : "—")</td>
                        <td class="r">@p.Verkaufswert.ToString("N0") F</td>
                        <td class="r">@if (p.Gewinn is decimal g) { <strong class="enote-marge">@g.ToString("N0") F</strong> } else { <span class="enote-tag enote-tag-warn">prix d'achat manquant</span> }</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr><td>Total</td><td class="r">@Lager.Stueck.ToString("0.##")</td><td></td><td class="r">@Lager.Einkaufswert.ToString("N0") F</td><td class="r">@Lager.Verkaufswert.ToString("N0") F</td><td class="r">@Lager.Gewinn.ToString("N0") F</td></tr>
            </tfoot>
        </table></div>
    </ChildContent>
</ModalDialog>

<ModalDialog Open="loeschDialogOffen" Title="Supprimer la prestation" OnClose="SchliesseLoeschen">
    <ChildContent>
        <p>Voulez-vous vraiment supprimer « @zuLoeschendeLeistung?.Name » ?</p>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="SchliesseLoeschen">Annuler</button>
        <AsyncActionButton Text="Supprimer" OnClick="LoeschenAsync" CssClass="enote-btn-danger" />
    </Footer>
</ModalDialog>

@* Kategorie-Zuordnung: breites Modal mit Entwurfs-Auswahl + Bestätigen/Abbrechen *@
<ModalDialog Open="zuordnungModalOffen" Title="@(zuordnungLeistung is null ? "Catégorie" : "Catégorie · " + zuordnungLeistung.Name)" OnClose="SchliesseZuordnungModal" MaxWidthClass="enote-modal-lg">
    <ChildContent>
        <p class="enote-muted" style="margin-top:0;">Choisissez la catégorie de « @(zuordnungLeistung?.Name) », puis confirmez.</p>
        <div class="enote-zuordnung-liste">
            <button type="button" class="enote-zuordnung-option @(string.IsNullOrEmpty(zuordnungEntwurf) ? "aktiv" : "")"
                    @onclick='() => WaehleZuordnungEntwurf("")'>
                <span class="enote-zuordnung-name">Sans catégorie</span>
                @if (string.IsNullOrEmpty(zuordnungEntwurf))
                {
                    <span class="enote-zuordnung-check">✓</span>
                }
            </button>
            @foreach (var knoten in kategorieBaum)
            {
                <button type="button" class="enote-zuordnung-option @(zuordnungEntwurf == knoten.Kategorie.Id.ToString() ? "aktiv" : "")"
                        @onclick="() => WaehleZuordnungEntwurf(knoten.Kategorie.Id.ToString())">
                    <span class="enote-zuordnung-name"><strong>@knoten.Kategorie.Name</strong></span>
                    @if (zuordnungEntwurf == knoten.Kategorie.Id.ToString())
                    {
                        <span class="enote-zuordnung-check">✓</span>
                    }
                </button>
                @foreach (var unter in knoten.Unterkategorien)
                {
                    <button type="button" class="enote-zuordnung-option enote-zuordnung-unter @(zuordnungEntwurf == unter.Id.ToString() ? "aktiv" : "")"
                            @onclick="() => WaehleZuordnungEntwurf(unter.Id.ToString())">
                        <span class="enote-zuordnung-name">└ @unter.Name</span>
                        @if (zuordnungEntwurf == unter.Id.ToString())
                        {
                            <span class="enote-zuordnung-check">✓</span>
                        }
                    </button>
                }
            }
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="SchliesseZuordnungModal">Annuler</button>
        <AsyncActionButton Text="Confirmer" OnClick="BestaetigeZuordnungAsync" CssClass="enote-btn-primary" />
    </Footer>
</ModalDialog>

@* Kategorie umbenennen *@
<ModalDialog Open="kategorieUmbenennenOffen" Title="@(aktiveKategorie?.ParentId is null ? "Modifier la catégorie" : "Modifier la sous-catégorie")" ErrorMessage="@kategorieFehler" OnClose="() => kategorieUmbenennenOffen = false">
    <ChildContent>
        <div class="enote-form">
            <label><span class="enote-pflicht">Nom</span> <input @bind="kategorieNeuerName" @bind:event="oninput" maxlength="@ENote.WebApp.Services.KatalogService.KategorieNameMax" /></label>
            <fieldset class="kat-farben">
                <legend>Couleur</legend>
                <p class="kat-farben-hinweis">Visible sur les articles du catalogue et dans la caisse.@(aktiveKategorie?.ParentId is null ? " Les sous-catégories reprennent cette couleur." : "")</p>
                <div class="kat-farben-raster" role="radiogroup" aria-label="Couleur de la catégorie">
                    <button type="button" role="radio" aria-checked="@(kategorieNeueFarbe is null ? "true" : "false")"
                            class="kat-farbe kat-farbe-auto @(kategorieNeueFarbe is null ? "aktiv" : "")" style="--farbe: @AutoFarbeAktiveKategorie"
                            @onclick="() => kategorieNeueFarbe = null">
                        <span class="kat-farbe-punkt"></span>@(aktiveKategorie?.ParentId is null ? "Automatique" : "Comme la catégorie")
                    </button>
                    @foreach (var (hex, name) in KategorieFarben.Auswahl)
                    {
                        <button type="button" role="radio" aria-checked="@(kategorieNeueFarbe == hex ? "true" : "false")" aria-label="@name" title="@name"
                                class="kat-farbe @(kategorieNeueFarbe == hex ? "aktiv" : "")" style="--farbe: @hex"
                                @onclick="() => kategorieNeueFarbe = hex">
                            <span class="kat-farbe-punkt"></span>
                        </button>
                    }
                </div>
            </fieldset>
            <div class="kat-farbe-vorschau">
                <span class="kat-farbe-vorschau-titel">Aperçu</span>
                <span class="kx-kat" style="--kat: @(kategorieNeueFarbe ?? AutoFarbeAktiveKategorie)"><span class="kx-kat-punkt"></span>@(string.IsNullOrWhiteSpace(kategorieNeuerName) ? "Catégorie" : kategorieNeuerName)</span>
                <span class="kat-farbe-kachel" style="--kat: @(kategorieNeueFarbe ?? AutoFarbeAktiveKategorie)">Article</span>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => kategorieUmbenennenOffen = false">Annuler</button>
        <AsyncActionButton Text="Enregistrer" OnClick="KategorieUmbenennenAsync" CssClass="enote-btn-primary" Disabled="@string.IsNullOrWhiteSpace(kategorieNeuerName)" />
    </Footer>
</ModalDialog>

@* Kategorie löschen *@
<ModalDialog Open="kategorieLoeschenOffen" Title="Supprimer la catégorie" OnClose="() => kategorieLoeschenOffen = false">
    <ChildContent>
        <p>Supprimer « @zuLoeschendeKategorie?.Name » ? Les prestations liées perdront cette catégorie (elles restent conservées).</p>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => kategorieLoeschenOffen = false">Annuler</button>
        <AsyncActionButton Text="Supprimer" OnClick="KategorieLoeschenAsync" CssClass="enote-btn-danger" />
    </Footer>
</ModalDialog>

@* Barcode-Etiketten drucken *@
<ModalDialog Open="etikettDialogOffen" Title="@EtikettDialogTitel" OnClose="() => etikettDialogOffen = false">
    <ChildContent>
        <div class="enote-form">
            <p class="enote-muted" style="overflow-wrap: anywhere;">Code-barres : <strong>@etikettLeistung?.StrichCode</strong></p>
            <label>Nombre d'étiquettes (1–48) <input type="number" min="1" max="48" @bind="etikettAnzahl" /></label>
            <label>Format</label>
            <EnoteRadioGroup TValue="string" @bind-Value="etikettFormat" Options="etikettFormatOptionen" />
            <small class="enote-muted">
                @(etikettFormat == "einzel"
                    ? "Une étiquette par page de 62 × 29 mm, pour une imprimante d'étiquettes thermique."
                    : "Planches A4 autocollantes de 24 étiquettes 70 × 37 mm (3 × 8). Dans la fenêtre d'impression, choisissez « Taille réelle » (100 %), sinon les étiquettes se décalent.")
            </small>
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => etikettDialogOffen = false">Annuler</button>
        <AsyncActionButton Text="Imprimer" OnClick="DruckeEtiketten" CssClass="enote-btn-primary" />
    </Footer>
</ModalDialog>
