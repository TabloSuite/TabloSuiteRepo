@page "/parametres"
@attribute [Authorize(Roles = "Besitzer")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Paramètres de l'établissement</PageTitle>


<BesitzerPinGuard>
<div class="enote-page enote-page-narrow">
    <div class="enote-page-header">
        <div>
            <h1>Paramètres de l'établissement</h1>
            <p>Personnalisez votre reçu : logo et slogan.</p>
        </div>
        @if (darfWeiterenLaden)
        {
            <button class="enote-btn enote-btn-primary" @onclick="OeffneNeuerLadenDialog">+ Nouvel établissement</button>
        }
    </div>

    @if (isLoading)
    {
        <p>Chargement…</p>
    }
    else
    {
        <div class="enote-card enote-settings-card">
            <h2>Identité sur le reçu</h2>

            <div class="enote-form">
                <label>Slogan (ex. « In God we trust »)</label>
                <input @bind="slogan" placeholder="Votre devise…" maxlength="120" />

                <label>Téléphone</label>
                <input @bind="telefon" placeholder="ex. +228 90 00 00 00" />

                <label>Adresse</label>
                <input @bind="adresse" placeholder="ex. Rue de la Paix, Lomé" />

                <label>Lien du QR-code sur le reéu (facultatif)</label>
                <input @bind="bonQrLink" placeholder="ex. lien WhatsApp ou avis Google" />
                <small class="enote-muted">Vide : le QR-code ouvre la copie numérique du reéu.</small>

                <label>Logo (facultatif)</label>
                <BildAuswahl VorschauUrl="@logoVorschau"
                             OnBildBereit="HandleLogoBereit"
                             OnEntfernt="HandleLogoEntfernt" />
                @if (!string.IsNullOrWhiteSpace(logoFehler))
                {
                    <div class="alert alert-error">@logoFehler</div>
                }
                @if (!string.IsNullOrWhiteSpace(logoFehler))
                {
                    <div class="alert alert-error">@logoFehler</div>
                }

                <AsyncActionButton Text="Enregistrer" OnClick="SpeichernAsync" CssClass="enote-btn-primary" />
            </div>
        </div>

        <div class="enote-card enote-settings-card">
            <h2>Sécurité</h2>
            <p class="enote-muted">Ce code PIN déverrouille les pages de gestion (finances, équipe…) sur la tablette partagée, sans fermer la caisse.</p>

            @if (!string.IsNullOrWhiteSpace(pinFehler))
            {
                <div class="alert alert-error">@pinFehler</div>
            }
            @if (pinGespeichert)
            {
                <div class="alert alert-success">Code PIN enregistré.</div>
            }

            <div class="enote-form">
                <label>Code PIN propriétaire (4–6 chiffres)</label>
                <div class="enote-pin-feld">
                    <input type="@(pinSichtbar ? "text" : "password")" inputmode="numeric" maxlength="6" @bind="neueBesitzerPin" placeholder="••••" />
                    <button type="button" class="enote-pin-eye" title="@(pinSichtbar ? "Masquer" : "Afficher")" @onclick="() => pinSichtbar = !pinSichtbar">
                        @(pinSichtbar ? "🙈" : "👁")
                    </button>
                </div>
                <small class="enote-muted">@(hatBesitzerPin ? "Un code est déjà défini. Saisissez-en un nouveau pour le changer." : "Aucun code défini pour le moment.")</small>
                <AsyncActionButton Text="Enregistrer le code PIN" OnClick="SpeichereBesitzerPinAsync" CssClass="enote-btn-primary" />
            </div>
        </div>

        <div class="enote-card enote-settings-card">
            <h2>Aperçu du reçu</h2>
            <div class="enote-bon-preview">
                @if (!string.IsNullOrWhiteSpace(logoVorschau))
                {
                    <img src="@logoVorschau" alt="Logo" class="enote-bon-logo" />
                }
                <div class="enote-bon-name">@salonName</div>
                @if (!string.IsNullOrWhiteSpace(slogan))
                {
                    <div class="enote-bon-slogan">« @slogan »</div>
                }
                @if (!string.IsNullOrWhiteSpace(adresse))
                {
                    <div class="enote-bon-muted" style="text-align:center">@adresse</div>
                }
                @if (!string.IsNullOrWhiteSpace(telefon))
                {
                    <div class="enote-bon-muted" style="text-align:center">Tél : @telefon</div>
                }
                <div class="enote-bon-line"></div>
                <div class="enote-bon-muted">1× Coupe …… 3 000 F</div>
                <div class="enote-bon-total">TOTAL 3 000 F</div>
            </div>
        </div>
    }
</div>

@* --- Neuen Laden hinzufügen --- *@
<ModalDialog Open="neuerLadenDialogOffen" Title="Nouvel établissement" ErrorMessage="@neuerLadenFehler" OnClose="() => neuerLadenDialogOffen = false" MaxWidthClass="enote-modal-sm">
    <ChildContent>
        <div class="enote-form">
            <p class="enote-muted">Le nouvel établissement sera activé après validation par l'administrateur.</p>
            <label>Nom de l'établissement <input @bind="neuerLadenName" placeholder="ex. Salon B" /></label>
            <label>Ville / quartier (facultatif) <input @bind="neuerLadenStandort" placeholder="ex. Lomé" /></label>
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => neuerLadenDialogOffen = false">Annuler</button>
        <AsyncActionButton Text="Créer" OnClick="FuegeNeuenLadenHinzuAsync" CssClass="enote-btn-primary" Disabled="@(string.IsNullOrWhiteSpace(neuerLadenName))" />
    </Footer>
</ModalDialog>
</BesitzerPinGuard>
