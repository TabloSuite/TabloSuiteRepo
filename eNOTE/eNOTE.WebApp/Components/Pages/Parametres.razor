@page "/parametres"
@attribute [Authorize(Roles = "Besitzer")]
@rendermode InteractiveServer
@using ENote.WebApp.Services

<PageTitle>Paramètres de l'établissement</PageTitle>

<BesitzerPinGuard>
<div class="enote-page">
    <div class="enote-page-header">
        <div>
            <h1>Paramètres</h1>
            <p>Reçu, moyens de paiement et sécurité de « @salonName ».</p>
        </div>
        @if (darfWeiterenLaden)
        {
            <button class="enote-btn" @onclick="OeffneNeuerLadenDialog"><Icon Name="store" Groesse="18" /> Nouvel établissement</button>
        }
    </div>

    @if (isLoading)
    {
        <p class="enote-muted" role="status">Chargement…</p>
    }
    else
    {
        <div class="st-layout">
            <div class="st-spalte">
                <section class="enote-card st-karte">
                    <div class="st-karte-kopf">
                        <span class="st-ico"><Icon Name="receipt" /></span>
                        <div>
                            <h2>Identité sur le reçu</h2>
                            <p>Ces informations apparaissent en haut de chaque reçu.</p>
                        </div>
                    </div>

                    <div class="enote-form">
                        <label>Logo <small class="enote-muted">(facultatif)</small></label>
                        <BildAuswahl @bind-VorschauUrl="logoVorschau" OnBildBereit="HandleLogoBereit" OnEntfernt="HandleLogoEntfernt" />
                        @if (!string.IsNullOrWhiteSpace(logoFehler))
                        {
                            <div class="alert alert-error">@logoFehler</div>
                        }

                        <label>Slogan <input @bind="slogan" @bind:event="oninput" placeholder="ex. Votre beauté, notre passion" maxlength="120" /></label>
                        <div class="enote-form-grid">
                            <label>Téléphone <input @bind="telefon" @bind:event="oninput" inputmode="tel" placeholder="ex. +228 90 00 00 00" /></label>
                            <label>Adresse <input @bind="adresse" @bind:event="oninput" placeholder="ex. Rue de la Paix, Lomé" /></label>
                        </div>
                        <label>
                            Lien du QR-code sur le reçu <small class="enote-muted">(facultatif)</small>
                            <input @bind="bonQrLink" placeholder="ex. lien WhatsApp ou avis Google" />
                        </label>
                        <small class="enote-muted">Vide : le QR-code ouvre tablosuite.com.</small>

                        <AsyncActionButton Text="Enregistrer" BusyText="Enregistrement…" OnClick="SpeichernAsync" CssClass="enote-btn-primary" />
                    </div>
                </section>

                <section class="enote-card st-karte">
                    <div class="st-karte-kopf">
                        <span class="st-ico st-ico-momo"><Icon Name="momo" /></span>
                        <div>
                            <h2>Mobile Money</h2>
                            <p>Opérateurs acceptés à la caisse@(string.IsNullOrWhiteSpace(land) ? "" : $" ({land})").</p>
                        </div>
                    </div>

                    @if (momoAuswahl.Count == 0)
                    {
                        <p class="enote-empty">Aucun opérateur Mobile Money n'est encore configuré pour @(string.IsNullOrWhiteSpace(land) ? "votre pays" : land). Contactez l'administrateur.</p>
                    }
                    else
                    {
                        <div class="st-momo">
                            @foreach (var eintrag in momoAuswahl)
                            {
                                <label class="st-momo-zeile @(eintrag.Akzeptiert ? "an" : "")">
                                    <span class="enote-anbieter-logo" style="--marke: @eintrag.Anbieter.Farbe; --marke-text: @MobileMoneyService.TextFarbe(eintrag.Anbieter.Farbe)">@Kuerzel(eintrag.Anbieter.Name)</span>
                                    <span class="st-momo-name">
                                        <strong>@eintrag.Anbieter.Name</strong>
                                        <small>@(eintrag.Akzeptiert ? "Proposé à la caisse" : "Non proposé")</small>
                                    </span>
                                    <EnoteCheckbox Value="eintrag.Akzeptiert" ValueChanged="(bool an) => eintrag.Akzeptiert = an" Label="" />
                                </label>
                            }
                        </div>
                        <AsyncActionButton Text="Enregistrer les opérateurs" OnClick="SpeichereMomoAsync" CssClass="enote-btn-primary" />
                    }
                </section>

                <section class="enote-card st-karte" aria-labelledby="st-raeume-titel">
                    <div class="st-karte-kopf">
                        <span class="st-ico"><Icon Name="door" /></span>
                        <div>
                            <h2 id="st-raeume-titel">Salles et postes</h2>
                            <p>Proposés en un geste dans « Nouvelle arrivée » (Clients présents). Les motifs, eux, viennent de vos prestations.</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(raumFehler))
                    {
                        <div class="alert alert-error" role="alert">@raumFehler</div>
                    }

                    @if (raeume.Count == 0)
                    {
                        <p class="enote-muted st-raeume-leer">Aucune salle définie : eNOTE propose les salles déjà saisies ces 90 derniers jours.</p>
                    }
                    else
                    {
                        <ul class="st-raeume">
                            @for (var i = 0; i < raeume.Count; i++)
                            {
                                var r = raeume[i];
                                var erster = i == 0;
                                var letzter = i == raeume.Count - 1;
                                <li @key="r.Id">
                                    <Icon Name="door" Groesse="18" CssClass="st-raum-ico" />
                                    <input class="enote-input" value="@r.Name" maxlength="@ENote.Core.Services.Kunden.KundenBesuchRegeln.RaumMax"
                                           aria-label="@($"Nom de la salle {r.Name}")" @onchange="(ChangeEventArgs e) => RaumUmbenennenAsync(r, e.Value?.ToString())" />
                                    <button type="button" class="enote-icon-btn" title="Monter" aria-label="@($"Monter {r.Name}")" disabled="@erster" @onclick="() => RaumVerschiebenAsync(r, -1)"><Icon Name="arrow-up" Groesse="16" /></button>
                                    <button type="button" class="enote-icon-btn" title="Descendre" aria-label="@($"Descendre {r.Name}")" disabled="@letzter" @onclick="() => RaumVerschiebenAsync(r, 1)"><Icon Name="arrow-down" Groesse="16" /></button>
                                    <button type="button" class="enote-icon-btn st-raum-weg" title="Supprimer" aria-label="@($"Supprimer {r.Name}")" @onclick="() => RaumLoeschenAsync(r)"><Icon Name="trash" Groesse="16" /></button>
                                </li>
                            }
                        </ul>
                    }

                    <div class="st-raum-neu">
                        <input class="enote-input" @bind="neuerRaum" @bind:event="oninput" maxlength="@ENote.Core.Services.Kunden.KundenBesuchRegeln.RaumMax"
                               placeholder="ex. Salle 1, Bac, Cabine 2" aria-label="Nouvelle salle ou nouveau poste" @onkeydown="RaumTasteAsync" />
                        <AsyncActionButton Text="Ajouter" OnClick="RaumHinzufuegenAsync" CssClass="enote-btn-primary" Disabled="string.IsNullOrWhiteSpace(neuerRaum)" />
                    </div>
                </section>

                <section class="enote-card st-karte">
                    <div class="st-karte-kopf">
                        <span class="st-ico st-ico-lock"><Icon Name="lock" /></span>
                        <div>
                            <h2>Code PIN propriétaire</h2>
                            <p>Protège la gestion (finances, équipe…) sur la tablette partagée, sans fermer la caisse.</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(pinFehler))
                    {
                        <div class="alert alert-error">@pinFehler</div>
                    }

                    <div class="enote-form">
                        <label>@(hatBesitzerPin ? "Nouveau code PIN" : "Code PIN") <small class="enote-muted">(4 à 6 chiffres)</small></label>
                        <div class="enote-pin-zeile">
                            <input type="text" inputmode="numeric" maxlength="6" @bind="neueBesitzerPin"
                                   autocomplete="off" name="enote-pin" data-lpignore="true" data-form-type="other"
                                   class="@(pinSichtbar ? "" : "enote-pin-masked")" />
                            <button type="button" class="enote-pin-eye" title="@(pinSichtbar ? "Masquer" : "Afficher")" @onclick="() => pinSichtbar = !pinSichtbar">
                                <Icon Name="@(pinSichtbar ? "eye-off" : "eye")" Groesse="18" />
                            </button>
                        </div>
                        <small class="enote-muted">@(hatBesitzerPin ? "Un code est déjà défini. Saisissez-en un nouveau pour le changer." : "Aucun code défini : la gestion est accessible sans code.")</small>
                        <AsyncActionButton Text="Enregistrer le code PIN" OnClick="SpeichereBesitzerPinAsync" CssClass="enote-btn-primary" />
                    </div>
                </section>
            </div>

            <aside class="st-vorschau" aria-label="Aperçu du reçu">
                <span class="st-vorschau-titel">Aperçu du reçu</span>
                <div class="enote-bon-preview">
                    @if (!string.IsNullOrWhiteSpace(logoVorschau))
                    {
                        <img src="@logoVorschau" alt="Logo" class="enote-bon-logo" />
                    }
                    <div class="enote-bon-name">@salonName</div>
                    @if (!string.IsNullOrWhiteSpace(slogan))
                    {
                        <div class="enote-bon-slogan">« @slogan »</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(adresse))
                    {
                        <div class="enote-bon-muted enote-bon-mitte">@adresse</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(telefon))
                    {
                        <div class="enote-bon-muted enote-bon-mitte">Tél : @telefon</div>
                    }
                    <div class="enote-bon-line"></div>
                    <div class="enote-bon-zeile"><span>1× Brushing</span><span>3 000 F</span></div>
                    <div class="enote-bon-zeile"><span>2× Coupe homme</span><span>3 000 F</span></div>
                    <div class="enote-bon-line"></div>
                    <div class="enote-bon-zeile enote-bon-total"><span>TOTAL</span><span>6 000 F</span></div>
                    <div class="enote-bon-muted">Paiement : @(momoAuswahl.FirstOrDefault(m => m.Akzeptiert)?.Anbieter.Name ?? "Espèces")</div>
                    <div class="enote-bon-qr" aria-hidden="true"><Icon Name="grid" Groesse="44" Strich="1.2" /></div>
                    <div class="enote-bon-muted enote-bon-mitte">Merci de votre visite !</div>
                </div>
            </aside>
        </div>
    }
</div>

@* --- Neuen Laden hinzufügen --- *@
<ModalDialog Open="neuerLadenDialogOffen" Title="Nouvel établissement" ErrorMessage="@neuerLadenFehler" OnClose="() => neuerLadenDialogOffen = false" MaxWidthClass="enote-modal-md">
    <ChildContent>
        <div class="enote-form">
            <p class="enote-muted">Le nouvel établissement sera activé après validation par l'administrateur. Un nouveau compte (pseudonyme + mot de passe) est créé pour cet établissement ; l'adresse e-mail peut être la même que celle du premier établissement.</p>
            <div class="enote-form-grid">
                <label>Nom de l'établissement <input @bind="neuerLadenName" placeholder="ex. Salon B" /></label>
                <label>Ville / quartier <input @bind="neuerLadenStandort" placeholder="ex. Lomé" /></label>
                <label>Prénom <input @bind="neuerLadenVorname" placeholder="ex. Jean" /></label>
                <label>Nom <input @bind="neuerLadenNachname" placeholder="ex. Dupont" /></label>
            </div>
            <label>Pseudonyme (identifiant de connexion) <input @bind="neuerLadenPseudonym" placeholder="ex. jean.salonb" autocomplete="username" /></label>
            <label>Adresse e-mail de contact <input type="email" @bind="neuerLadenEmail" placeholder="ex. contact@exemple.com" autocomplete="email" /></label>
            <label>Mot de passe initial <PasswordInput @bind-Value="neuerLadenPasswort" Autocomplete="new-password" /></label>
            <small class="enote-muted">Au moins 6 caractères, dont 1 chiffre et 1 lettre minuscule.</small>
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => neuerLadenDialogOffen = false">Annuler</button>
        <AsyncActionButton Text="Créer" OnClick="FuegeNeuenLadenHinzuAsync" CssClass="enote-btn-primary"
            Disabled="@(string.IsNullOrWhiteSpace(neuerLadenName) || string.IsNullOrWhiteSpace(neuerLadenVorname) || string.IsNullOrWhiteSpace(neuerLadenNachname) || string.IsNullOrWhiteSpace(neuerLadenPseudonym) || string.IsNullOrWhiteSpace(neuerLadenEmail) || string.IsNullOrWhiteSpace(neuerLadenPasswort))" />
    </Footer>
</ModalDialog>
</BesitzerPinGuard>
