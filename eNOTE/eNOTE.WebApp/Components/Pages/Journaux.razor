@page "/admin/journaux"
@attribute [Authorize(Roles = "SuperAdmin")]
@rendermode InteractiveServer

<PageTitle>Journaux d'erreurs</PageTitle>

<div class="enote-page">
    <div class="enote-page-header">
        <div>
            <h1>Journaux d'erreurs</h1>
            <p>Exceptions centralisées de l'application.</p>
        </div>
        @if (logs.Any(l => l.IstBehandelt))
        {
            <AsyncActionButton Text="Supprimer les traités" OnClick="LoescheBehandelteAsync" CssClass="enote-btn-ghost enote-danger" />
        }
    </div>

    <div class="enote-filter-row">
        <div class="enote-filter-feld"><span class="enote-filter-label">Du</span><EnoteDatePicker @bind-Value="vonDatum" /></div>
        <div class="enote-filter-feld"><span class="enote-filter-label">Au</span><EnoteDatePicker @bind-Value="bisDatum" /></div>
        <label class="enote-check-row"><EnoteCheckbox @bind-Value="nurUnbehandelt" Label="Non traités seulement" /></label>
        <button class="enote-btn enote-btn-ghost" @onclick="LadeAsync">Filtrer</button>
    </div>

    <div class="enote-filter-leiste">
        <input class="enote-filter-suche" placeholder="Rechercher (message, chemin)…" @bind="logSuche" @bind:event="oninput" />
    </div>

    @if (isLoading)
    {
        <p>Chargement…</p>
    }
    else if (logs.Count == 0)
    {
        <p class="enote-empty">Aucune erreur journalisée. Tout va bien.</p>
    }
    else if (!GefilterteLogs().Any())
    {
        <p class="enote-empty" role="status">Aucune erreur ne correspond à votre recherche.</p>
    }
    else
    {
        <div class="enote-log-list">
            @foreach (var log in GefilterteLogs())
            {
                <div class="enote-log-item @(log.IstBehandelt ? "behandelt" : "")">
                    <div class="enote-log-head">
                        <span class="enote-log-zeit">@log.ZeitUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</span>
                        @if (log.IstBehandelt)
                        {
                            <span class="enote-tag">Traité</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(log.Pfad))
                        {
                            <span class="enote-tag enote-tag-off">@log.Pfad</span>
                        }
                    </div>
                    <div class="enote-log-msg">@log.Nachricht</div>
                    @if (zeigeDetails.GetValueOrDefault(log.Id))
                    {
                        <pre class="enote-log-trace">@log.Ausnahme</pre>
                    }
                    <div class="enote-item-actions">
                        <button class="enote-btn enote-btn-ghost" @onclick="() => ToggleDetails(log.Id)">@(zeigeDetails.GetValueOrDefault(log.Id) ? "Masquer" : "Détails")</button>
                        <AsyncActionButton CssClass="enote-btn-ghost" Text="@(log.IstBehandelt ? "Rouvrir" : "Marquer traité")" OnClick="() => ToggleBehandeltAsync(log)" />
                        <AsyncActionButton CssClass="enote-btn-ghost enote-danger" Text="Supprimer" BusyText="Suppression…" OnClick="() => LoescheAsync(log.Id)" />
                    </div>
                </div>
            }
        </div>
    }
</div>
