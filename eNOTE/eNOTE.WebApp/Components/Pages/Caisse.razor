@page "/caisse"
@attribute [Authorize(Roles = "Besitzer, Kassierer")]
@rendermode InteractiveServer
@using ENote.Core.DataModels.Kasse
@using ENote.Core.DataModels.Katalog
@using ENote.WebApp.Components.Shared

<PageTitle>Caisse</PageTitle>

@if (mitarbeiterKonto)
{
    <MitarbeiterKassenHinweis />
}
else if (anzeigeState.IstMinimiert && anzeigeState.AktiveSitzungId is not null)
{
    @* Minimiert: nur der schwebende Button (in MainLayout gerendert). *@
    <div class="kx-hinweis">
        <span class="kx-hinweis-ico"><Icon Name="caisse" Groesse="28" /></span>
        <h1>La caisse est ouverte en arrière-plan</h1>
        <p class="enote-muted">Vous pouvez la rouvrir à tout moment, les ventes en cours sont conservées.</p>
        <button class="enote-btn enote-btn-primary enote-btn-lg" @onclick="anzeigeState.Wiederherstellen">Rouvrir la caisse</button>
    </div>
}
else if (aktiveSitzung is null)
{
    @* --- Zustand 1: Kassenstart (Kassierer + PIN + Wechselgeld) --- *@
    <div class="kx-start">
        <div class="kx-start-kopf">
            <span class="kx-start-ico"><Icon Name="caisse" Groesse="26" /></span>
            <div>
                <h1>Ouvrir la caisse</h1>
                <p class="enote-muted">Choisissez votre nom, saisissez votre code PIN et comptez la monnaie de départ.</p>
            </div>
        </div>

        <KassenZugangsHinweis ImKassenKontext="true" GesperrtGeaendert="(bool g) => kasseGesperrt = g" />

        @if (!string.IsNullOrWhiteSpace(startFehler))
        {
            <div class="alert alert-error" role="alert">@startFehler</div>
        }

        @if (kassiererListe.Count == 0)
        {
            <p class="enote-empty">Aucun employé configuré. Le propriétaire doit d'abord créer des employés avec un code PIN (Équipe).</p>
        }
        else
        {
            <div class="kx-start-grid">
                <section class="kx-start-karte">
                    <h2><span class="kx-schritt">1</span> Employé</h2>
                    <div class="kx-kassierer">
                        @foreach (var k in kassiererListe)
                        {
                            <button type="button"
                                    class="kx-kassierer-btn @(ausgewaehlterKassiererId == k.UserId ? "gewaehlt" : "")"
                                    aria-pressed="@(ausgewaehlterKassiererId == k.UserId)"
                                    @onclick="() => WaehleKassierer(k.UserId)">
                                <span class="enote-avatar">@Initialen(k.Name)</span>
                                <span class="kx-kassierer-name">@k.Name</span>
                            </button>
                        }
                    </div>
                </section>

                <section class="kx-start-karte @(ausgewaehlterKassiererId == Guid.Empty ? "gedimmt" : "")">
                    <h2><span class="kx-schritt">2</span> Code PIN</h2>
                    <PinEingabe @bind-Wert="pin" OnBestaetigt="StarteSitzungAsync" Fehlerhaft="@(!string.IsNullOrWhiteSpace(startFehler))" />
                </section>

                <section class="kx-start-karte @(ausgewaehlterKassiererId == Guid.Empty ? "gedimmt" : "")">
                    <h2><span class="kx-schritt">3</span> Monnaie de départ</h2>
                    <BetragEingabe @bind-Wert="startbestand" Schnellbetraege="startVorschlaege" MitZiffernblock="false" Label="Comptez le fond de caisse" />
                    <AsyncActionButton Text="Ouvrir la caisse" BusyText="Ouverture…" OnClick="StarteSitzungAsync"
                                       CssClass="enote-btn-primary enote-btn-lg enote-btn-block"
                                       Disabled="@(kasseGesperrt || ausgewaehlterKassiererId == Guid.Empty || pin.Length < 4)" />
                </section>
            </div>
        }
    </div>
}
else
{
    @* --- Zustand 2: Aktive Kasse --- *@
    <div class="kx">
        <header class="kx-kopf">
            <div class="kx-kopf-info">
                <span class="enote-brand-icon">eN</span>
                <div class="kx-kopf-text">
                    <strong>@aktiverSalonName</strong>
                    <span class="kx-kopf-person">
                        <span class="kx-live-punkt"></span>
                        @if (anzeigeState.KassiererFehlt)
                        {
                            <button type="button" class="kx-kassierer-wechsel warn" @onclick="() => OeffneKassiererDialogAsync()">Qui encaisse ?</button>
                        }
                        else
                        {
                            <span>@anzeigeState.KassiererName</span>
                            <button type="button" class="kx-kassierer-wechsel" title="Une autre personne encaisse sur cet appareil" @onclick="() => OeffneKassiererDialogAsync()">Changer</button>
                        }
                        <span>· caisse ouverte à @aktiveSitzung.GestartetUtc.ImLaden(zone).ToString("HH:mm")</span>
                    </span>
                </div>
            </div>
            <div class="kx-kopf-kasse" title="Espèces attendues en caisse">
                <small>En caisse</small>
                <strong>@anzeigeState.ErwarteterBarBetrag.ToString("N0") F</strong>
            </div>
            <nav class="kx-kopf-aktionen" aria-label="Actions de caisse">
                <button class="kx-aktion kx-aktion-praesenz" @onclick="OeffneAnwesendeAsync" title="Clients présents"><Icon Name="user-check" /><span>Présents</span>@if (anwesende.Count > 0) { <span class="kx-badge" aria-label="@($"{anwesende.Count} présents")">@anwesende.Count</span> }</button>
                <button class="kx-aktion kx-aktion-wartend" @onclick="OeffneWartendeAsync" title="Tickets en attente (non encaissés)"><Icon Name="pause" /><span>En attente</span>@if (wartende.Count > 0) { <span class="kx-badge warte" aria-label="@($"{wartende.Count} en attente")">@wartende.Count</span> }</button>
                <button class="kx-aktion" @onclick="OeffneHistorieAsync" title="Ventes récentes"><Icon Name="history" /><span>Ventes</span></button>
                <button class="kx-aktion" @onclick="OeffneDisplayDialog" title="Écran client"><Icon Name="monitor" /><span>Écran client</span></button>
                <button class="kx-aktion" @onclick="OeffneRetrait" title="Retrait du propriétaire (espèces ou marchandise)"><Icon Name="wallet" /><span>Retrait</span></button>
                <button class="kx-aktion" @onclick="anzeigeState.Minimieren" title="Réduire la caisse"><Icon Name="minimize" /><span>Réduire</span></button>
                <button class="kx-aktion kx-aktion-haupt" @onclick="OeffneAbschluss" title="Clôturer la caisse"><Icon Name="lock" /><span>Clôturer</span></button>
            </nav>
        </header>

        <KassenZugangsHinweis SalonId="aktiveSitzung.SalonId" ImKassenKontext="true" GesperrtGeaendert="(bool g) => kasseGesperrt = g" />

        <div class="kx-body">
            @* --- Katalog --- *@
            <section class="kx-katalog" aria-label="Catalogue">
                <div class="kx-suche">
                    <Icon Name="search" Groesse="20" CssClass="kx-suche-ico" />
                    <input class="kx-suche-feld"
                           placeholder="Rechercher ou scanner un code-barres…"
                           aria-label="Rechercher ou scanner"
                           @bind="suchtext"
                           @bind:event="oninput"
                           @onkeydown="HandleSuchTaste" />
                    @if (!string.IsNullOrEmpty(suchtext))
                    {
                        <button class="kx-suche-leeren" @onclick='() => suchtext = string.Empty' aria-label="Effacer la recherche"><Icon Name="x" Groesse="18" /></button>
                    }
                    else
                    {
                        <Icon Name="scan" Groesse="20" CssClass="kx-suche-scan" />
                    }
                </div>

                @if (HauptKategorien.Count > 0 || favoritenIds.Count > 0)
                {
                    <div class="kx-kats" role="tablist" aria-label="Catégories">
                        <button type="button" role="tab" class="kx-kat @(IstAlles ? "aktiv" : "")" @onclick="ZeigeAlles">Tout</button>
                        @if (favoritenIds.Count > 0)
                        {
                            <button type="button" role="tab" class="kx-kat @(nurFavoriten ? "aktiv" : "")" @onclick="ZeigeFavoriten"><Icon Name="star" Groesse="15" /> Favoris</button>
                        }
                        @foreach (var kat in HauptKategorien)
                        {
                            <button type="button" role="tab" class="kx-kat @(aktiveKategorieId == kat.Id ? "aktiv" : "")" style="--kat: @KategorieFarbe(kat.Id)"
                                    @onclick="() => WaehleKategorie(kat.Id)">
                                <span class="kx-kat-punkt"></span>@kat.Name
                            </button>
                        }
                    </div>
                    @if (UnterKategorien.Count > 0)
                    {
                        <div class="kx-unterkats">
                            <button type="button" class="kx-unterkat @(aktiveUnterKategorieId is null ? "aktiv" : "")" @onclick="() => aktiveUnterKategorieId = null">Toutes</button>
                            @foreach (var u in UnterKategorien)
                            {
                                <button type="button" class="kx-unterkat @(aktiveUnterKategorieId == u.Id ? "aktiv" : "")" @onclick="() => aktiveUnterKategorieId = u.Id">@u.Name</button>
                            }
                        </div>
                    }
                }

                <div class="kx-kacheln">
                    @foreach (var l in SichtbareLeistungen)
                    {
                        var imTicket = MengeImTicket(l.Id);
                        var lagerKnapp = l.HatStueckzahl && l.MindestbestandWarnung is decimal min && l.Stueckzahl <= min;
                        <div class="kx-kachel @(l.IstStandardArtikel ? "frei" : "") @(imTicket > 0 ? "im-ticket" : "")" style="--kat: @KategorieFarbe(l.KategorieId)">
                            <button type="button" class="kx-kachel-haupt" @onclick="() => WaehleLeistung(l)" aria-label="Ajouter @l.Name">
                                @if (bildUrls.TryGetValue(l.Id, out var bild))
                                {
                                    <img class="kx-kachel-bild" src="@bild" alt="" loading="lazy" />
                                }
                                <span class="kx-kachel-name">@l.Name</span>
                                <span class="kx-kachel-fuss">
                                    @if (l.IstStandardArtikel)
                                    {
                                        <span class="kx-kachel-preis"><Icon Name="plus" Groesse="16" /> Montant libre</span>
                                    }
                                    else
                                    {
                                        <span class="kx-kachel-preis">@l.Preis.ToString("N0") F</span>
                                    }
                                    @if (lagerKnapp)
                                    {
                                        <span class="kx-kachel-lager" title="Stock bas">@Menge(l.Stueckzahl) en stock</span>
                                    }
                                </span>
                            </button>
                            @if (imTicket > 0)
                            {
                                <span class="kx-kachel-menge" aria-label="@imTicket dans le ticket">@imTicket</span>
                            }
                            @if (!l.IstStandardArtikel)
                            {
                                <button type="button" class="kx-fav @(favoritenIds.Contains(l.Id) ? "aktiv" : "")"
                                        title="@(favoritenIds.Contains(l.Id) ? "Retirer des favoris" : "Ajouter aux favoris")"
                                        aria-pressed="@favoritenIds.Contains(l.Id)"
                                        @onclick="() => ToggleFavoritAsync(l.Id)">
                                    <Icon Name="star" Groesse="16" />
                                </button>
                            }
                        </div>
                    }
                </div>
                @if (!SichtbareLeistungen.Any())
                {
                    <p class="enote-empty" role="status">
                        @(string.IsNullOrWhiteSpace(suchtext) ? "Aucune prestation dans cette catégorie." : $"Aucun résultat pour « {suchtext} ».")
                    </p>
                }
            </section>

            @* --- Ticket --- *@
            <aside class="kx-ticket @(ticketAufgeklappt ? "offen" : "")" aria-label="Ticket">
                <button type="button" class="kx-ticket-griff" @onclick="() => ticketAufgeklappt = !ticketAufgeklappt" aria-expanded="@(ticketAufgeklappt ? "true" : "false")">
                    <span><Icon Name="receipt" Groesse="18" /> Ticket · @AnzahlArtikel article(s)</span>
                    <strong>@gesamtSumme.ToString("N0") F</strong>
                    <Icon Name="chevron-down" Groesse="18" CssClass="kx-ticket-griff-pfeil" />
                </button>

                <div class="kx-ticket-kopf">
                    <h2>Ticket @if (ticket.Count > 0) { <span class="kx-ticket-anzahl">@AnzahlArtikel</span> }</h2>
                    @if (ticket.Count > 0)
                    {
                        <button type="button" class="kx-ticket-leeren" @onclick="OeffneAbbrechenBestaetigung"><Icon Name="trash" Groesse="16" /> Vider</button>
                    }
                </div>

                @if (aktiveSitzung is not null)
                {
                    <KundenAuswahl SalonId="aktiveSitzung.SalonId" BenutzerId="aktuellerBenutzerId" Kunde="ticketKunde" KundeChanged="TicketKundeGewechseltAsync"
                                   Hinweis="@TicketKundeHinweis" OnFiche="() => ficheKundeId = ticketKunde?.Id" />
                }

                <div class="kx-ticket-liste">
                    @if (ticket.Count == 0)
                    {
                        @if (letzterVerkauf is { } lv)
                        {
                            <div class="kx-fertig" role="status">
                                <span class="kx-fertig-ico"><Icon Name="check" Groesse="28" Strich="2.5" /></span>
                                <strong>Vente enregistrée</strong>
                                <span class="enote-muted">@lv.Total.ToString("N0") F · @lv.ZahlungText</span>
                                @if (lv.Rueckgeld is > 0)
                                {
                                    <div class="kx-fertig-rueck">
                                        <small>Monnaie à rendre</small>
                                        <strong>@lv.Rueckgeld.Value.ToString("N0") F</strong>
                                    </div>
                                }
                                <button type="button" class="enote-btn" @onclick="() => DruckeBonAsync(lv.VerkaufId)"><Icon Name="printer" Groesse="18" /> Imprimer le reçu</button>
                            </div>
                        }
                        else
                        {
                            <div class="kx-ticket-leer">
                                <Icon Name="tag" Groesse="30" Strich="1.5" />
                                <p>Touchez une prestation pour l'ajouter au ticket.</p>
                                @if (wartende.Count > 0)
                                {
                                    <button type="button" class="kx-wartend-hinweis" @onclick="OeffneWartendeAsync">
                                        <Icon Name="pause" Groesse="16" /> @(wartende.Count == 1 ? "1 ticket en attente" : $"{wartende.Count} tickets en attente") · Reprendre
                                    </button>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        @if (HatErfassteZeilen)
                        {
                            <div class="kx-erfasst-kopf">
                                <span><Icon Name="lock" Groesse="14" /> Déjà enregistré · à payer</span>
                                <button type="button" @onclick="OeffneKonto">Détail</button>
                            </div>
                            @foreach (var pos in ErfassteZeilen)
                            {
                                <div class="kx-pos kx-pos-erfasst">
                                    <div class="kx-pos-text">
                                        <span class="kx-pos-name">@pos.Anzeige</span>
                                        <span class="kx-pos-einzel">@ErfasstText(pos)</span>
                                    </div>
                                    <span class="kx-pos-schloss" title="Déjà enregistré : se retire avec « Détail »"><Icon Name="lock" Groesse="14" /></span>
                                    <strong class="kx-pos-summe">@ZeilenSumme(pos).ToString("N0") F</strong>
                                </div>
                            }
                            @if (HatNeueZeilen)
                            {
                                <div class="kx-erfasst-kopf neu"><span><Icon Name="plus" Groesse="14" /> Nouvelles prestations</span></div>
                            }
                        }
                        @foreach (var pos in NeueZeilen)
                        {
                            <div class="kx-pos">
                                <div class="kx-pos-text">
                                    <span class="kx-pos-name">@pos.Anzeige</span>
                                    <span class="kx-pos-einzel">@pos.EffektivPreis.ToString("N0") F</span>
                                </div>
                                <div class="kx-pos-menge">
                                    <button type="button" @onclick="() => AendereMenge(pos, -1)" aria-label="Diminuer"><Icon Name="@(pos.Menge == 1 ? "trash" : "minus")" Groesse="16" /></button>
                                    <span>@pos.Menge</span>
                                    <button type="button" @onclick="() => AendereMenge(pos, 1)" aria-label="Augmenter"><Icon Name="plus" Groesse="16" /></button>
                                </div>
                                <strong class="kx-pos-summe">@ZeilenSumme(pos).ToString("N0") F</strong>
                            </div>
                        }
                    }
                </div>

                @if (ticket.Count > 0)
                {
                    <div class="kx-ticket-fuss">
                        @if (ausgewaehlterRabatt is { } r)
                        {
                            <div class="kx-rabatt-aktiv">
                                <Icon Name="percent" Groesse="16" />
                                <span>@r.Name</span>
                                <strong>-@rabattSumme.ToString("N0") F</strong>
                                <button type="button" @onclick="EntferneRabatt" aria-label="Retirer la remise"><Icon Name="x" Groesse="16" /></button>
                            </div>
                        }
                        else if (rabatte.Count > 0)
                        {
                            <button type="button" class="kx-rabatt-btn" @onclick="() => rabattDialogOffen = true"><Icon Name="percent" Groesse="16" /> Ajouter une remise</button>
                        }

                        <div class="kx-summen">
                            @if (rabattSumme > 0)
                            {
                                <div><span>Sous-total</span><span>@zwischensumme.ToString("N0") F</span></div>
                            }
                            <div class="kx-total"><span>Total</span><strong>@gesamtSumme.ToString("N0") F</strong></div>
                        </div>

                        @if (KundeIstAnwesend && HatNeueZeilen)
                        {
                            <AsyncActionButton BasisKlasse="kx-erfassen" OnClick="ErfasseOhneKassierenAsync" BusyText="Enregistrement…"
                                               title="Le client reste : les prestations sont gardées et payées en une fois à son départ">
                                <Icon Name="check" Groesse="18" /><span>Enregistrer sans encaisser</span>
                            </AsyncActionButton>
                        }

                        <div class="kx-zahlen @(mobileAnbieter.Count > 0 ? "drei" : "")">
                            <button type="button" class="kx-zahl kx-zahl-bar" @onclick="() => OeffneZahlung(ZahlModus.Bar)">
                                <Icon Name="banknote" Groesse="24" /><span>Espèces</span>
                            </button>
                            @if (mobileAnbieter.Count > 0)
                            {
                                <button type="button" class="kx-zahl kx-zahl-momo" @onclick="() => OeffneZahlung(ZahlModus.MobileMoney)">
                                    <Icon Name="momo" Groesse="24" /><span>Mobile Money</span>
                                </button>
                            }
                            <button type="button" class="kx-zahl kx-zahl-karte" @onclick="() => OeffneZahlung(ZahlModus.Karte)">
                                <Icon Name="card" Groesse="24" /><span>Carte</span>
                            </button>
                        </div>
                        <div class="kx-fuss-links">
                            @if (!KundeIstAnwesend)
                            {
                                <button type="button" class="kx-mixte" @onclick="OeffneParken" title="Garder ce ticket pour plus tard (client parti un instant…)"><Icon Name="pause" Groesse="16" /> Mettre en attente</button>
                            }
                            <button type="button" class="kx-mixte" @onclick="() => OeffneZahlung(ZahlModus.Mixte)"><Icon Name="split" Groesse="16" /> Paiement mixte</button>
                        </div>
                    </div>
                }
            </aside>
        </div>
    </div>
}

@* --- Encaissement (alle Zahlarten) --- *@
<ModalDialog Open="zahlDialogOffen" Title="@ZahlTitel" ErrorMessage="@verkaufFehler" OnClose="SchliesseZahlung" MaxWidthClass="enote-modal-md">
    <ChildContent>
        <div class="kx-pay">
            <div class="kx-pay-total">
                <span>Total à payer</span>
                <strong>@gesamtSumme.ToString("N0") F</strong>
            </div>

            <div class="kx-pay-modi" role="tablist">
                <button type="button" role="tab" class="kx-pay-modus @(zahlModus == ZahlModus.Bar ? "aktiv" : "")" @onclick="() => WechsleModus(ZahlModus.Bar)"><Icon Name="banknote" Groesse="18" /> Espèces</button>
                @if (mobileAnbieter.Count > 0)
                {
                    <button type="button" role="tab" class="kx-pay-modus @(zahlModus == ZahlModus.MobileMoney ? "aktiv" : "")" @onclick="() => WechsleModus(ZahlModus.MobileMoney)"><Icon Name="momo" Groesse="18" /> Mobile Money</button>
                }
                <button type="button" role="tab" class="kx-pay-modus @(zahlModus == ZahlModus.Karte ? "aktiv" : "")" @onclick="() => WechsleModus(ZahlModus.Karte)"><Icon Name="card" Groesse="18" /> Carte</button>
                <button type="button" role="tab" class="kx-pay-modus @(zahlModus == ZahlModus.Mixte ? "aktiv" : "")" @onclick="() => WechsleModus(ZahlModus.Mixte)"><Icon Name="split" Groesse="18" /> Mixte</button>
            </div>

            @switch (zahlModus)
            {
                case ZahlModus.Bar:
                    <BetragEingabe @bind-Wert="gegeben" Label="Montant reçu" Schnellbetraege="BetragEingabe.VorschlaegeFuer(gesamtSumme)" Hervorheben="true" Kompakt="true" OnBestaetigt="BestaetigeZahlungAsync">
                        <NachSchnellbetraegen>
                            <div class="kx-pay-rueck @(gegeben < gesamtSumme ? "fehlt" : "")">
                                @if (gegeben < gesamtSumme)
                                {
                                    <span>Il manque</span><strong>@((gesamtSumme - gegeben).ToString("N0")) F</strong>
                                }
                                else
                                {
                                    <span>Monnaie à rendre</span><strong>@((gegeben - gesamtSumme).ToString("N0")) F</strong>
                                }
                            </div>
                        </NachSchnellbetraegen>
                    </BetragEingabe>
                    break;

                case ZahlModus.Karte:
                    <div class="kx-pay-info">
                        <Icon Name="card" Groesse="32" Strich="1.6" />
                        <p>Effectuez le paiement de <strong>@gesamtSumme.ToString("N0") F</strong> sur le terminal, puis confirmez.</p>
                    </div>
                    break;

                case ZahlModus.MobileMoney:
                    <AnbieterAuswahl Anbieter="mobileAnbieter" @bind-Ausgewaehlt="mobileAnbieterId" />
                    <label class="kx-pay-ref">
                        <span>Référence de la transaction <small class="enote-muted">(facultatif, voir SMS)</small></span>
                        <input class="enote-input" @bind="mobileReferenz" maxlength="80" placeholder="ex. MP241110.1234.A56789" />
                    </label>
                    <p class="kx-pay-hinweis"><Icon Name="info" Groesse="16" /> Confirmez seulement après réception du SMS de paiement.</p>
                    break;

                case ZahlModus.Mixte:
                    <BetragEingabe @bind-Wert="mixBar" Label="Part en espèces" MitZiffernblock="true" Kompakt="true" />
                    <div class="kx-pay-rest">
                        <span>Reste à payer par</span>
                        <div class="kx-pay-rest-wahl">
                            @if (mobileAnbieter.Count > 0)
                            {
                                <button type="button" class="enote-chip @(mixZweitArt == ZahlungsArt.MobileMoney ? "enote-chip-aktiv" : "")" @onclick="() => mixZweitArt = ZahlungsArt.MobileMoney">Mobile Money</button>
                            }
                            <button type="button" class="enote-chip @(mixZweitArt == ZahlungsArt.Karte ? "enote-chip-aktiv" : "")" @onclick="() => mixZweitArt = ZahlungsArt.Karte">Carte</button>
                        </div>
                        <strong>@(Math.Max(gesamtSumme - mixBar, 0).ToString("N0")) F</strong>
                    </div>
                    @if (mixZweitArt == ZahlungsArt.MobileMoney)
                    {
                        <AnbieterAuswahl Anbieter="mobileAnbieter" @bind-Ausgewaehlt="mobileAnbieterId" />
                    }
                    break;
            }
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="SchliesseZahlung">Annuler</button>
        <AsyncActionButton Text="@ZahlButtonText" BusyText="Enregistrement…" OnClick="BestaetigeZahlungAsync" CssClass="enote-btn-primary enote-btn-lg" Disabled="@(!ZahlungMoeglich)" />
    </Footer>
</ModalDialog>

@* --- Remise wählen --- *@
<ModalDialog Open="rabattDialogOffen" Title="Ajouter une remise" OnClose="() => rabattDialogOffen = false" MaxWidthClass="enote-modal-sm">
    <ChildContent>
        <div class="kx-rabatte">
            @foreach (var r in rabatte)
            {
                var anwendbar = r.LeistungId is null || ticket.Any(p => p.Leistung.Id == r.LeistungId);
                <button type="button" class="kx-rabatt-option @(rabattKandidat?.Id == r.Id ? "aktiv" : "")" disabled="@(!anwendbar)"
                        @onclick="() => { rabattKandidat = r; bedingungBestaetigt = false; }">
                    <span class="kx-rabatt-wert">@RabattText(r)</span>
                    <span class="kx-rabatt-text">
                        <strong>@r.Name</strong>
                        <small>@(r.Leistung is not null ? $"Sur « {r.Leistung.Name} »" : "Sur tout le ticket")@(anwendbar ? "" : " · non applicable")</small>
                    </span>
                </button>
            }
            @if (rabattKandidat?.Bedingung is string bed && !string.IsNullOrWhiteSpace(bed))
            {
                <label class="kx-bedingung"><EnoteCheckbox @bind-Value="bedingungBestaetigt" Label="@($"Condition remplie : {bed}")" /></label>
            }
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => rabattDialogOffen = false">Annuler</button>
        <button class="enote-btn enote-btn-primary" disabled="@(!RabattAnwendbar)" @onclick="WendeRabattAn">Appliquer</button>
    </Footer>
</ModalDialog>

@* --- Bestätigung: Ticket leeren --- *@
<ModalDialog Open="abbrechenBestaetigungOffen" Title="Vider le ticket ?" OnClose="() => abbrechenBestaetigungOffen = false" MaxWidthClass="enote-modal-sm">
    <ChildContent>
        <p>Toutes les prestations du ticket en cours seront retirées. Aucune vente n'est enregistrée.</p>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => abbrechenBestaetigungOffen = false">Garder</button>
        <button class="enote-btn enote-btn-danger" @onclick="BrecheTicketAb">Vider le ticket</button>
    </Footer>
</ModalDialog>

@* --- Verkaufshistorie (Bon nachdrucken) --- *@
<ModalDialog Open="historieOffen" Title="Ventes récentes" OnClose="() => historieOffen = false" MaxWidthClass="enote-modal-md">
    <ChildContent>
        @if (historieLaedt)
        {
            <p class="enote-muted" role="status">Chargement…</p>
        }
        else if (historieVerkaeufe.Count == 0)
        {
            <p class="enote-empty">Aucune vente pour le moment.</p>
        }
        else
        {
            <div class="kx-historie">
                @foreach (var v in historieVerkaeufe)
                {
                    <div class="kx-historie-zeile @(v.IstStorno ? "storno" : "")">
                        <div class="kx-historie-info">
                            <div class="kx-historie-top">
                                <strong>@(v.IstStorno ? "− " + (-v.GesamtSumme).ToString("N0") : v.GesamtSumme.ToString("N0")) F</strong>
                                @if (v.IstStorno)
                                {
                                    <span class="kx-storno-tag"><Icon Name="undo" Groesse="13" /> Remboursement</span>
                                }
                                else
                                {
                                    <ZahlungsTag Anteile="v.Zahlungen" />
                                    @if (v.VollErstattet)
                                    {
                                        <span class="kx-storno-tag">Remboursée</span>
                                    }
                                    else if (v.Erstattet > 0)
                                    {
                                        <span class="kx-storno-tag">− @v.Erstattet.ToString("N0") F remboursé</span>
                                    }
                                }
                            </div>
                            <small class="enote-muted">@v.ZeitUtc.ImLaden(zone).ToString("dd.MM · HH:mm") · @v.KassiererName@(v.IstStorno && !string.IsNullOrWhiteSpace(v.StornoGrund) ? " · " + v.StornoGrund : "")</small>
                            <small class="kx-historie-pos">@v.PositionenText</small>
                        </div>
                        <div class="kx-historie-aktionen">
                            @if (!v.IstStorno && !v.VollErstattet)
                            {
                                <button type="button" class="enote-btn enote-btn-sm enote-btn-ghost" title="Rembourser le client" @onclick="() => OeffneStornoAsync(v.VerkaufId)"><Icon Name="undo" Groesse="16" /> Rembourser</button>
                            }
                            <button type="button" class="enote-btn enote-btn-sm" @onclick="() => DruckeBonAsync(v.VerkaufId)"><Icon Name="printer" Groesse="16" /> Reçu</button>
                        </div>
                    </div>
                }
                @if (historieMehr)
                {
                    <AsyncActionButton CssClass="enote-btn-ghost enote-mehr" BusyText="Chargement…" OnClick="MehrHistorieAsync">Afficher plus</AsyncActionButton>
                }
            </div>
        }
    </ChildContent>
</ModalDialog>

@* --- Kassenabschluss --- *@
<ModalDialog Open="abschlussOffen" Title="Clôturer la caisse" ErrorMessage="@abschlussFehler" OnClose="() => abschlussOffen = false" MaxWidthClass="enote-modal-md">
    <ChildContent>
        @if (abschlussInfo is { } info)
        {
            <div class="kx-abschluss">
                <div class="kx-abschluss-kpis">
                    <div><small>Ventes</small><strong>@info.AnzahlVerkaeufe</strong></div>
                    <div><small>Chiffre d'affaires</small><strong>@info.Umsatz.ToString("N0") F</strong></div>
                </div>
                <div class="kx-abschluss-zeilen">
                    <div><span><Icon Name="banknote" Groesse="16" /> Fonds de départ</span><span>@info.Startbestand.ToString("N0") F</span></div>
                    <div><span><Icon Name="banknote" Groesse="16" /> Ventes en espèces</span><span>+ @info.BarVerkaeufe.ToString("N0") F</span></div>
                    @if (info.EinlagenBar > 0)
                    {
                        <div><span><Icon Name="arrow-down" Groesse="16" /> Apports en caisse</span><span>+ @info.EinlagenBar.ToString("N0") F</span></div>
                    }
                    @if (info.ErstattungenBar > 0)
                    {
                        <div><span><Icon Name="undo" Groesse="16" /> Remboursements en espèces</span><span>− @info.ErstattungenBar.ToString("N0") F</span></div>
                    }
                    @if (info.Erstattungen > info.ErstattungenBar)
                    {
                        <div class="kx-abschluss-notiz"><span><Icon Name="info" Groesse="16" /> Remboursés par carte / Mobile Money</span><span>@((info.Erstattungen - info.ErstattungenBar).ToString("N0")) F</span></div>
                    }
                    @if (info.EntnahmenBar > 0)
                    {
                        <div><span><Icon Name="wallet" Groesse="16" /> Retraits du propriétaire</span><span>− @info.EntnahmenBar.ToString("N0") F</span></div>
                    }
                    <div class="kx-abschluss-soll"><span>Espèces attendues</span><strong>@info.BarSoll.ToString("N0") F</strong></div>
                    @if (info.NachKassierer is { Count: > 1 } personen)
                    {
                        <div class="kx-abschluss-personen" aria-label="Par caissier">
                            <div class="kx-abschluss-personen-titel"><span><Icon Name="users" Groesse="16" /> Par caissier</span><span>Espèces</span></div>
                            @foreach (var p in personen)
                            {
                                <div class="kx-abschluss-neben"><span>@p.Name · @p.Verkaeufe vente(s)@(p.Erstattungen > 0 ? $" · {p.Erstattungen} remb." : "")</span><span>@p.Bar.ToString("N0") F</span></div>
                            }
                        </div>
                    }
                    @if (abschlussHinweis is not null)
                    {
                        <p class="kx-pay-hinweis kx-abschluss-aktuell" role="status"><Icon Name="info" Groesse="16" /> @abschlussHinweis</p>
                    }
                    @if (info.Karte > 0)
                    {
                        <div class="kx-abschluss-neben"><span><Icon Name="card" Groesse="16" /> Carte (terminal)</span><span>@info.Karte.ToString("N0") F</span></div>
                    }
                    @foreach (var (anbieter, betrag) in info.MobileMoneyNachAnbieter)
                    {
                        <div class="kx-abschluss-neben"><span><Icon Name="momo" Groesse="16" /> @anbieter</span><span>@betrag.ToString("N0") F</span></div>
                    }
                </div>
                @if (ticket.Count > 0)
                {
                    <div class="kx-abschluss-ticket" role="alert">
                        <span><Icon Name="alert" Groesse="16" /> Le ticket en cours (@AnzahlArtikel article(s), @gesamtSumme.ToString("N0") F) n'est pas encaissé.</span>
                        <AsyncActionButton CssClass="enote-btn-sm" Text="Mettre en attente" OnClick="ParkeVorAbschlussAsync" />
                    </div>
                }
                @if (wartende.Count > 0)
                {
                    <p class="kx-abschluss-notiz"><Icon Name="pause" Groesse="16" /> @(wartende.Count == 1 ? "1 ticket en attente reste disponible" : $"{wartende.Count} tickets en attente restent disponibles") pour la prochaine ouverture de caisse.</p>
                }
                <BetragEingabe @bind-Wert="endbestandGezaehlt" Label="Espèces comptées" Kompakt="true" Hervorheben="true" />
                <div class="kx-ecart @(Ecart < 0 ? "minus" : Ecart > 0 ? "plus" : "null")">
                    <span>Écart</span>
                    <strong>@(Ecart > 0 ? "+" : "")@Ecart.ToString("N0") F</strong>
                </div>
                <label class="kx-pay-ref">
                    <span>Note <small class="enote-muted">(facultatif)</small></span>
                    <textarea class="enote-input" rows="2" @bind="abschlussNotiz" placeholder="ex. billet de 1 000 F abîmé"></textarea>
                </label>
            </div>
        }
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => abschlussOffen = false">Annuler</button>
        <AsyncActionButton Text="Clôturer la caisse" OnClick="SchliesseSitzungAsync" CssClass="enote-btn-primary" />
    </Footer>
</ModalDialog>

@* --- Hinweis: offene Kasse wiederhergestellt --- *@
@* --- « Qui encaisse ? » (17.11.2026): Person an diesem Gerät per PIN; jeder Bon wird ihr zugeordnet --- *@
<ModalDialog Open="kassiererDialogOffen" Title="Qui encaisse ?" ErrorMessage="@kassiererFehler" OnClose="() => kassiererDialogOffen = false" MaxWidthClass="enote-modal-md">
    <ChildContent>
        @if (kassiererDialogMitInfo)
        {
            <div class="enote-wiederhergestellt">
                <p class="enote-wiederhergestellt-text">La caisse est déjà ouverte. Indiquez qui encaisse sur cet appareil : chaque vente sera enregistrée à son nom.</p>
                <div class="enote-wiederhergestellt-zeile"><span>Ouverte par</span><strong>@wiederhergestelltKassierer</strong></div>
                <div class="enote-wiederhergestellt-zeile"><span>Ouverte le</span><strong>@wiederhergestelltGestartet.ImLaden(zone).ToString("dd.MM.yyyy HH:mm")</strong></div>
                @if (wiederhergestelltSoll is decimal soll)
                {
                    <div class="enote-wiederhergestellt-zeile enote-wiederhergestellt-soll"><span>Espèces attendues</span><strong>@soll.ToString("N0") F</strong></div>
                }
            </div>
        }
        else
        {
            <p class="enote-muted">Chaque vente est enregistrée au nom de la personne qui encaisse sur cet appareil. Choisissez votre nom et saisissez votre code PIN.</p>
        }
        <div class="kx-kassierer kx-kassierer-dialog">
            @foreach (var k in kassiererDieserKasse)
            {
                <button type="button"
                        class="kx-kassierer-btn @(kassiererWahl == k.UserId ? "gewaehlt" : "")"
                        aria-pressed="@(kassiererWahl == k.UserId)"
                        @onclick="() => WaehleKassiererImDialog(k.UserId)">
                    <span class="enote-avatar">@Initialen(k.Name)</span>
                    <span class="kx-kassierer-name">@k.Name</span>
                </button>
            }
        </div>
        @if (kassiererWahl != Guid.Empty)
        {
            <PinEingabe @bind-Wert="kassiererPin" OnBestaetigt="MeldeKassiererAnAsync" Fehlerhaft="@(!string.IsNullOrWhiteSpace(kassiererFehler))" />
        }
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => kassiererDialogOffen = false">Plus tard</button>
        <AsyncActionButton Text="Valider" OnClick="MeldeKassiererAnAsync" CssClass="enote-btn-primary"
                           Disabled="@(kassiererWahl == Guid.Empty || kassiererPin.Length < 4)" />
    </Footer>
</ModalDialog>

@* --- Freier Betrag für Standard-Artikel „Divers“ --- *@
<ModalDialog Open="freierBetragOffen" Title="Montant libre" ErrorMessage="@freierBetragFehler" OnClose="() => freierBetragOffen = false" MaxWidthClass="enote-modal-sm">
    <ChildContent>
        <p class="enote-muted kx-frei-text">Pour une prestation qui n'existe pas encore dans le catalogue. Le propriétaire en sera informé.</p>
        <BetragEingabe @bind-Wert="freierBetrag" Label="Montant" Hervorheben="true" OnBestaetigt="FuegeStandardArtikelHinzu" />
        <div class="kx-frei-menge">
            <span>Quantité</span>
            <div class="kx-pos-menge">
                <button type="button" @onclick="() => freierBetragMenge = Math.Max(1, freierBetragMenge - 1)" aria-label="Diminuer"><Icon Name="minus" Groesse="16" /></button>
                <span>@freierBetragMenge</span>
                <button type="button" @onclick="() => freierBetragMenge = Math.Min(99, freierBetragMenge + 1)" aria-label="Augmenter"><Icon Name="plus" Groesse="16" /></button>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => freierBetragOffen = false">Annuler</button>
        <button class="enote-btn enote-btn-primary" @onclick="FuegeStandardArtikelHinzu">Ajouter au ticket</button>
    </Footer>
</ModalDialog>

@* --- Rückerstattung (Gegenbuchung) --- *@
<ModalDialog Open="stornoOffen" Title="Rembourser une vente" ErrorMessage="@stornoFehler" OnClose="() => stornoOffen = false" MaxWidthClass="enote-modal-md">
    <ChildContent>
        @if (stornoVorlage is { } sv)
        {
            <div class="kx-pay">
                <p class="enote-muted kx-frei-text">
                    Vente du @sv.ZeitUtc.ImLaden(zone).ToString("dd.MM.yyyy · HH:mm") · @sv.KassiererName · @sv.GesamtSumme.ToString("N0") F
                    @if (sv.BereitsErstattet > 0)
                    {
                        <text> · déjà remboursé : @sv.BereitsErstattet.ToString("N0") F</text>
                    }
                    <br />Le reçu d'origine reste inchangé : un reçu de remboursement est créé.
                </p>

                <div class="kx-storno-kopf">
                    <span class="enote-betrag-label">Articles à rembourser</span>
                    <button type="button" class="enote-chip" @onclick="StornoAlles">Tout rembourser</button>
                </div>
                <div class="kx-storno-liste">
                    @foreach (var p in sv.Positionen)
                    {
                        var menge = stornoMengen.GetValueOrDefault(p.PositionId);
                        <div class="kx-storno-zeile @(p.Offen <= 0 ? "erledigt" : menge > 0 ? "gewaehlt" : "")">
                            <div class="kx-storno-info">
                                <strong>@p.Name</strong>
                                <small class="enote-muted">@p.Menge × @p.EinzelPreis.ToString("N0") F@(p.ZeilenSumme != p.EinzelPreis * p.Menge ? $" (après remise : {p.ZeilenSumme:N0} F)" : "")@(p.ErstattetMenge > 0 ? $" · {p.ErstattetMenge} déjà remboursé(s)" : "")</small>
                            </div>
                            @if (p.Offen > 0)
                            {
                                <div class="kx-pos-menge">
                                    <button type="button" @onclick="() => SetzeStornoMenge(p, menge - 1)" disabled="@(menge <= 0)" aria-label="Diminuer"><Icon Name="minus" Groesse="16" /></button>
                                    <span>@menge<small class="enote-muted">/@p.Offen</small></span>
                                    <button type="button" @onclick="() => SetzeStornoMenge(p, menge + 1)" disabled="@(menge >= p.Offen)" aria-label="Augmenter"><Icon Name="plus" Groesse="16" /></button>
                                </div>
                            }
                            else
                            {
                                <span class="kx-storno-tag"><Icon Name="check" Groesse="13" /> Remboursé</span>
                            }
                        </div>
                    }
                </div>

                <span class="enote-betrag-label">Rendre l'argent en</span>
                <div class="kx-storno-wege">
                    @foreach (var w in sv.Wege)
                    {
                        <button type="button" class="kx-storno-weg @(stornoWeg == w.Schluessel ? "aktiv" : "")" disabled="@(w.Offen <= 0)" @onclick="() => stornoWeg = w.Schluessel">
                            <Icon Name="@(w.Art == ZahlungsArt.Bar ? "banknote" : w.Art == ZahlungsArt.Karte ? "card" : "momo")" Groesse="18" />
                            <span>@w.Name</span>
                            <small>max @w.Offen.ToString("N0") F</small>
                        </button>
                    }
                </div>
                @if (StornoGewaehlterWeg is { Art: ZahlungsArt.Bar })
                {
                    <p class="kx-pay-hinweis"><Icon Name="info" Groesse="16" /> Les espèces sortent de la caisse ouverte (déduites des espèces attendues).</p>
                }
                else if (StornoGewaehlterWeg is { Art: ZahlungsArt.MobileMoney } mw)
                {
                    <p class="kx-pay-hinweis"><Icon Name="info" Groesse="16" /> Renvoyez le montant au client par @mw.Name, puis enregistrez ici.</p>
                }

                @if (StornoMitLager)
                {
                    <label class="enote-check-row"><EnoteCheckbox @bind-Value="stornoInsLager" Label="Remettre les articles en stock (article intact)" /></label>
                }

                <label class="kx-pay-ref">
                    <span>Motif</span>
                    <input class="enote-input" @bind="stornoGrund" @bind:event="oninput" maxlength="300" placeholder="Pourquoi rembourser ?" />
                </label>
                <div class="enote-betrag-schnell">
                    @foreach (var g in ENote.WebApp.Services.StornoService.GrundVorschlaege)
                    {
                        <button type="button" class="enote-chip @(stornoGrund == g ? "enote-chip-aktiv" : "")" @onclick="() => stornoGrund = g">@g</button>
                    }
                </div>

                @if (sv.BrauchtPin)
                {
                    <div class="kx-retrait-pin">
                        <span class="enote-betrag-label">Code PIN du propriétaire</span>
                        <PinEingabe @bind-Wert="stornoPin" OnBestaetigt="BestaetigeStornoAsync" />
                    </div>
                }

                <div class="kx-pay-rueck kx-storno-summe">
                    <span>À rendre au client</span>
                    <strong>@StornoBetrag.ToString("N0") F</strong>
                </div>
                @if (StornoGrenze is { } grenze)
                {
                    <p class="kx-pay-hinweis kx-storno-grenze" role="alert"><Icon Name="info" Groesse="16" /> @grenze</p>
                }
            </div>
        }
        else
        {
            <p class="enote-muted" role="status">Chargement…</p>
        }
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => stornoOffen = false">Annuler</button>
        <AsyncActionButton Text="@($"Rembourser {StornoBetrag:N0} F")" OnClick="BestaetigeStornoAsync" CssClass="enote-btn-danger"
                           Disabled="@(StornoBetrag <= 0 || StornoGewaehlterWeg is null || StornoGrenze is not null || string.IsNullOrWhiteSpace(stornoGrund))" />
    </Footer>
</ModalDialog>

@* --- Entnahme durch den Besitzer (Bargeld oder Ware) --- *@
<ModalDialog Open="retraitOffen" Title="Retrait du propriétaire" ErrorMessage="@retraitFehler" OnClose="() => retraitOffen = false" MaxWidthClass="enote-modal-md">
    <ChildContent>
        <div class="kx-pay">
            <p class="enote-muted kx-frei-text">Le propriétaire prend de l'argent ou un article pour lui-même. Ce n'est pas une vente : c'est noté comme retrait dans les finances.</p>
            <div class="kx-pay-modi" role="tablist">
                <button type="button" role="tab" class="kx-pay-modus @(retraitWare ? "" : "aktiv")" @onclick="() => retraitWare = false"><Icon Name="banknote" Groesse="18" /> Espèces</button>
                <button type="button" role="tab" class="kx-pay-modus @(retraitWare ? "aktiv" : "")" @onclick="() => retraitWare = true"><Icon Name="package" Groesse="18" /> Marchandise</button>
            </div>

            @if (!retraitWare)
            {
                <BetragEingabe @bind-Wert="retraitBetrag" Label="Montant retiré de la caisse" Kompakt="true" MitZiffernblock="false" Schnellbetraege="retraitVorschlaege" />
                <div class="kx-pay-rueck">
                    <span>Espèces attendues après retrait</span>
                    <strong>@Math.Max(anzeigeState.ErwarteterBarBetrag - retraitBetrag, 0).ToString("N0") F</strong>
                </div>
            }
            else
            {
                <label class="kx-pay-ref"><span>Article</span></label>
                <EnoteSelect TValue="string" @bind-Value="retraitLeistungId" Options="RetraitArtikelOptionen" Placeholder="Choisir un article en stock…" MitSuche="true" />
                @if (RetraitArtikel is { } ra)
                {
                    <div class="kx-frei-menge">
                        <span>Quantité <small class="enote-muted">(stock : @ra.Stueckzahl.ToString("0.##"))</small></span>
                        <div class="kx-pos-menge">
                            <button type="button" @onclick="() => retraitMenge = Math.Max(1, retraitMenge - 1)" aria-label="Diminuer"><Icon Name="minus" Groesse="16" /></button>
                            <span>@retraitMenge.ToString("0.##")</span>
                            <button type="button" @onclick="() => retraitMenge = Math.Min(ra.Stueckzahl, retraitMenge + 1)" aria-label="Augmenter"><Icon Name="plus" Groesse="16" /></button>
                        </div>
                    </div>
                    <div class="kx-pay-rueck">
                        <span>Valeur (prix d'achat)</span>
                        <strong>@(ra.Kaufpreis is decimal k ? (k * retraitMenge).ToString("N0") + " F" : "inconnue")</strong>
                    </div>
                }
            }

            <label class="kx-pay-ref">
                <span>Note <small class="enote-muted">(facultatif)</small></span>
                <input class="enote-input" @bind="retraitNotiz" maxlength="500" placeholder="ex. transport, usage personnel…" />
            </label>

            @if (retraitBrauchtPin)
            {
                <div class="kx-retrait-pin">
                    <span class="enote-betrag-label">Code PIN du propriétaire</span>
                    <PinEingabe @bind-Wert="retraitPin" OnBestaetigt="BestaetigeRetraitAsync" />
                </div>
            }
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => retraitOffen = false">Annuler</button>
        <AsyncActionButton Text="Enregistrer le retrait" OnClick="BestaetigeRetraitAsync" CssClass="enote-btn-primary"
                           Disabled="@(retraitWare ? RetraitArtikel is null : retraitBetrag <= 0)" />
    </Footer>
</ModalDialog>

@* --- Kunden-Display verbinden (QR-Code + Link) --- *@
@if (aktiveSitzung is not null)
{
    <KundenFicheDialog Open="ficheKundeId is not null" KundeId="ficheKundeId ?? Guid.Empty" SalonId="aktiveSitzung.SalonId" BenutzerId="aktuellerBenutzerId" Zone="zone"
                       OnClose="() => ficheKundeId = null" OnGeaendert="LadeAnwesendeAsync" />
}

@* --- Prestations déjà enregistrées du client au ticket --- *@
@if (aktiveSitzung is not null && ticketKunde is not null)
{
    <AufenthaltKontoDialog Open="kontoDialogOffen" SalonId="aktiveSitzung.SalonId" KundeId="ticketKunde.Id" BenutzerId="aktuellerBenutzerId" Zone="zone"
                           OnClose="() => kontoDialogOffen = false" OnGeaendert="KontoGeaendertAsync" />
}

@* --- Ticket mettre en attente --- *@
<ModalDialog Open="parkDialogOffen" Title="Mettre le ticket en attente" ErrorMessage="@parkFehler" OnClose="() => parkDialogOffen = false" MaxWidthClass="enote-modal-sm">
    <ChildContent>
        <div class="kx-park">
            <div class="kx-park-info">
                <strong>@AnzahlArtikel article(s) · @gesamtSumme.ToString("N0") F</strong>
                @if (ticketKunde is { } pk)
                {
                    <span><Icon Name="user" Groesse="16" /> @pk.Name</span>
                }
            </div>
            <label class="kx-pay-ref">
                <span>Note <small class="enote-muted">(facultatif)</small></span>
                <input class="enote-input" @bind="parkNotiz" @bind:event="oninput" maxlength="@ENote.Core.Services.Kasse.TicketParkRegeln.NotizMax"
                       placeholder="@(ticketKunde is null ? "ex. dame en robe bleue, revient dans 10 min" : "ex. revient demain, cabine 2")" />
            </label>
            <p class="kx-pay-hinweis"><Icon Name="info" Groesse="16" /> Visible par toute l'équipe à la caisse, même après la clôture. Rien n'est encaissé ni retiré du stock.@(ticketKunde is null ? "" : " Si ce client a déjà un ticket en attente, les prestations s'y ajoutent.")</p>
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => parkDialogOffen = false">Annuler</button>
        <AsyncActionButton Text="Mettre en attente" OnClick="BestaetigeParkenAsync" CssClass="enote-btn-primary" />
    </Footer>
</ModalDialog>

@* --- Tickets en attente (alle Kassiererinnen des Ladens) --- *@
<ModalDialog Open="wartendeOffen" Title="Tickets en attente" ErrorMessage="@wartendFehler" OnClose="() => wartendeOffen = false" MaxWidthClass="enote-modal-md">
    <ChildContent>
        @if (wartende.Count == 0)
        {
            <p class="enote-muted">Aucun ticket en attente. Avec « Mettre en attente », gardez un ticket pour plus tard quand le client revient. Pour un client présent (soins sur plusieurs jours…), utilisez plutôt « Enregistrer sans encaisser ».</p>
        }
        else
        {
            @if (ticket.Count > 0)
            {
                <p class="kx-pay-hinweis"><Icon Name="info" Groesse="16" /> Le ticket en cours sera mis en attente avant la reprise.</p>
            }
            <ul class="kx-warte-liste">
                @foreach (var w in wartende)
                {
                    <li>
                        <span class="kx-warte-ico">
                            @if (w.KundeName is { } kn) { @Initialen(kn) } else { <Icon Name="receipt" Groesse="18" /> }
                        </span>
                        <span class="kx-warte-text">
                            <strong>@(w.KundeName ?? w.Notiz ?? $"Ticket de {w.ErstelltUtc.ImLaden(zone):HH:mm}")</strong>
                            <span class="kx-warte-zeilen">@w.Zeilen</span>
                            <small>@w.Artikel article(s) · @w.Summe.ToString("N0") F · @WarteSeit(w)@(w.KundeName is not null && w.Notiz is { } wn ? $" · « {wn} »" : "")</small>
                        </span>
                        @if (loeschKandidatId == w.Id)
                        {
                            <span class="kx-warte-loeschen">
                                <button type="button" class="enote-btn enote-btn-sm enote-btn-ghost" @onclick="() => loeschKandidatId = null">Garder</button>
                                <AsyncActionButton CssClass="enote-btn-danger enote-btn-sm" Text="Supprimer" OnClick="() => LoescheWartendesAsync(w.Id)" />
                            </span>
                        }
                        else
                        {
                            <button type="button" class="enote-icon-btn" title="Supprimer ce ticket en attente" aria-label="@($"Supprimer le ticket {w.KundeName ?? w.Notiz}")" @onclick="() => loeschKandidatId = w.Id"><Icon Name="trash" Groesse="16" /></button>
                            <AsyncActionButton CssClass="enote-btn-primary enote-btn-sm" Text="Reprendre" OnClick="() => ReprendreAsync(w.Id)" />
                        }
                    </li>
                }
            </ul>
        }
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => wartendeOffen = false">Fermer</button>
    </Footer>
</ModalDialog>

<ModalDialog Open="anwesendeOffen" Title="Clients présents" OnClose="() => anwesendeOffen = false" MaxWidthClass="enote-modal-md">
    <ChildContent>
        @if (anwesende.Count == 0)
        {
            <p class="enote-muted">Personne n'est enregistré comme présent. Les arrivées se notent dans « Clients présents » ou dans la fiche du client.</p>
        }
        else
        {
            <ul class="pz-kasse-liste">
                @foreach (var a in anwesende)
                {
                    <li>
                        <span class="ku-avatar">@string.Concat(a.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(t => char.ToUpperInvariant(t[0])))</span>
                        <span class="pz-kasse-text">
                            <strong>@a.Name</strong>
                            <small>@a.Grund@(a.Raum is { } r ? $" · {r}" : "") · @ENote.Core.Services.Kunden.KundenBesuchRegeln.Seit(a.AnkunftUtc, DateTime.UtcNow)</small>
                        </span>
                        <button type="button" class="enote-icon-btn" title="Fiche" aria-label="@($"Fiche de {a.Name}")" @onclick="() => { anwesendeOffen = false; ficheKundeId = a.KundeId; }"><Icon Name="note" Groesse="16" /></button>
                        <AsyncActionButton CssClass="enote-btn-primary enote-btn-sm" Text="@(wartende.Any(w => w.KundeId == a.KundeId) ? "Reprendre son ticket" : "Au ticket")" OnClick="() => AnwesendenAnsTicketAsync(a)" />
                    </li>
                }
            </ul>
        }
    </ChildContent>
    <Footer>
        <a class="enote-btn enote-btn-ghost" href="/presents">Ouvrir la liste complète</a>
        <button class="enote-btn enote-btn-ghost" @onclick="() => anwesendeOffen = false">Fermer</button>
    </Footer>
</ModalDialog>

<ModalDialog Open="displayDialogOffen" Title="Écran client" OnClose="() => displayDialogOffen = false" MaxWidthClass="enote-modal-sm">
    <ChildContent>
        <div class="enote-display-dialog">
            <p class="enote-muted">Scannez ce code avec une deuxième tablette tournée vers le client : il suit en direct le ticket de <strong>cet appareil</strong>. L'écran reste connecté à cet appareil, aussi les jours suivants.</p>
            @if (!string.IsNullOrWhiteSpace(displayQrDataUrl))
            {
                <img src="@displayQrDataUrl" alt="QR-code de l'écran client" class="enote-display-qr" />
            }
            <div class="enote-display-link">@displayLink</div>
        </div>
    </ChildContent>
</ModalDialog>
