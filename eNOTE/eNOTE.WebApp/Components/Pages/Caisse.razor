@page "/caisse"
@attribute [Authorize(Roles = "Besitzer, Kassierer")]
@rendermode InteractiveServer
@using ENote.Core.DataModels.Kasse
@using ENote.Core.DataModels.Katalog
@using ENote.WebApp.Components.Shared

<PageTitle>Caisse</PageTitle>

@if (anzeigeState.IstMinimiert && anzeigeState.AktiveSitzungId is not null)
{
    @* Minimiert: nur der schwebende Button (in MainLayout gerendert). *@
    <div class="enote-caisse-hinweis">
        <p>La caisse est ouverte en arrière-plan. Utilisez le bouton flottant pour la rouvrir.</p>
        <button class="enote-btn enote-btn-primary" @onclick="anzeigeState.Wiederherstellen">Rouvrir la caisse</button>
    </div>
}
else if (aktiveSitzung is null)
{
    @* --- Zustand 1: Kassenstart (Name + PIN + Wechselgeld) --- *@
    <div class="enote-caisse-start">
        <h1>Ouvrir la caisse</h1>
        <p class="enote-muted">Choisissez votre nom, saisissez votre code PIN et confirmez la monnaie de départ.</p>

        @if (!string.IsNullOrWhiteSpace(startFehler))
        {
            <div class="alert alert-error">@startFehler</div>
        }

        @if (kassiererListe.Count == 0)
        {
            <p class="enote-empty">Aucun caissier configuré. Le propriétaire doit d'abord créer des caissiers avec un code PIN.</p>
        }
        else
        {
            <div class="enote-form">
                <label>Caissier</label>
                <div class="enote-kassierer-grid">
                    @foreach (var k in kassiererListe)
                    {
                        <button type="button"
                                class="enote-kassierer-btn @(ausgewaehlterKassiererId == k.UserId ? "gewaehlt" : "")"
                                @onclick="() => ausgewaehlterKassiererId = k.UserId">
                            @k.Name
                        </button>
                    }
                </div>

                <label>Code PIN</label>
                <input type="password"
                       inputmode="numeric"
                       maxlength="6"
                       class="enote-pin-input"
                       @bind="pin"
                       placeholder="••••" />

                <label>Monnaie de départ (F) <span class="enote-muted">– comptez et confirmez</span></label>
                <input type="number" min="0" step="100" @bind="startbestand" />

                <AsyncActionButton Text="Ouvrir la caisse" OnClick="StarteSitzungAsync" CssClass="enote-btn-primary enote-btn-lg" Disabled="@(ausgewaehlterKassiererId == Guid.Empty)" />
            </div>
        }
    </div>
}
else
{
    @* --- Zustand 2: Aktive Kasse --- *@
    <div class="enote-caisse">
        <div class="enote-caisse-header">
            @if (aktiveSitzung is not null)
            {
                <div class="enote-caisse-sitzung-info">
                    <span class="enote-caisse-sitzung-titel">🟢 Caisse ouverte</span>
                    <span class="enote-muted">@anzeigeState.KassiererName · démarrée à @aktiveSitzung.GestartetUtc.ToLocalTime().ToString("HH:mm")</span>
                </div>
            }
            <div class="enote-caisse-header-actions">
                <button class="enote-btn enote-btn-ghost" @onclick="OeffneHistorieAsync">🧾 Ventes</button>
                <button class="enote-btn enote-btn-ghost" @onclick="anzeigeState.Minimieren">Réduire la caisse</button>
                <button class="enote-btn enote-btn-ghost" @onclick="OeffneDisplayDialog">📺 Affichage client</button>
                <button class="enote-btn enote-btn-ghost" @onclick="OeffneAbschluss">Clôturer</button>
            </div>
        </div>

        <div class="enote-caisse-body">
            <div class="enote-caisse-katalog">
                @* Barcode-Scan *@
                <div class="enote-scan-box">
                    <input class="enote-scan-input"
                           placeholder="🔍 Scanner le code-barres…"
                           @bind="scanCode"
                           @bind:event="oninput"
                           @onkeydown="HandleScanTaste" />
                </div>

                @* Kategorie-Filter *@
                @if (kategorien.Count > 1)
                {
                    <div class="enote-kat-filter">
                        <button type="button" class="enote-radio-pill @(aktiveKategorie is null ? "aktiv" : "")" @onclick="() => aktiveKategorie = null">Tout</button>
                        @foreach (var kat in kategorien)
                        {
                            <button type="button" class="enote-radio-pill @(aktiveKategorie == kat ? "aktiv" : "")" @onclick="() => aktiveKategorie = kat">@kat</button>
                        }
                    </div>
                }

                @* Schnellauswahl *@
                <div class="enote-tiles">
                    @foreach (var l in GefilterteLeistungen)
                    {
                        <div class="enote-tile-wrap">
                            <div class="enote-tile">
                                <div class="enote-tile-main" @onclick="() => WaehleLeistung(l)">
                                    <span class="enote-tile-name">@l.Name</span>
                                    <span class="enote-tile-price">@(l.IstStandardArtikel ? "Montant libre" : l.Preis.ToString("N0") + " F")</span>
                                    @if (l.HatStueckzahl && l.MindestbestandWarnung is decimal min && l.Stueckzahl <= min)
                                    {
                                        <span class="enote-tile-warn">Stock: @l.Stueckzahl</span>
                                    }
                                </div>
                                <div class="enote-tile-menge">
                                    <button type="button" @onclick="() => AendereTileMenge(l.Id, -1)" @onclick:stopPropagation="true">−</button>
                                    <span>@(tileMengen.GetValueOrDefault(l.Id, 1))</span>
                                    <button type="button" @onclick="() => AendereTileMenge(l.Id, 1)" @onclick:stopPropagation="true">+</button>
                                </div>
                            </div>
                            <button type="button"
                                    class="enote-fav-btn @(favoritenIds.Contains(l.Id) ? "aktiv" : "")"
                                    title="Favorit"
                                    @onclick="() => ToggleFavoritAsync(l.Id)"
                                    @onclick:stopPropagation="true">
                                @(favoritenIds.Contains(l.Id) ? "★" : "☆")
                            </button>
                        </div>
                    }
                </div>
            </div>

            @* Ticket *@
            <div class="enote-ticket">
                <div class="enote-ticket-kopf">
                    <h2>Ticket</h2>
                    @if (ticket.Count > 0)
                    {
                        <button type="button" class="enote-btn enote-btn-abbrechen enote-btn-sm" @onclick="OeffneAbbrechenBestaetigung">✕ Annuler</button>
                    }
                </div>
                @if (ticket.Count == 0)
                {
                    <p class="enote-muted">Touchez une prestation pour l'ajouter.</p>
                }
                else
                {
                    @* Nur die Positionsliste scrollt – Remise/Total/Buttons bleiben unten fix *@
                    <div class="enote-ticket-scroll">
                        @foreach (var pos in ticket)
                        {
                            <div class="enote-ticket-pos">
                                <div class="enote-ticket-pos-top">
                                    <strong class="enote-ticket-pos-name">@pos.Leistung.Name</strong>
                                    <button type="button" class="enote-danger enote-ticket-pos-del" title="Supprimer" @onclick="() => EntfernePos(pos)">✕</button>
                                </div>
                                <div class="enote-ticket-pos-bottom">
                                    <div class="enote-ticket-pos-actions">
                                        <button @onclick="() => AendereMenge(pos, -1)">−</button>
                                        <span>@pos.Menge</span>
                                        <button @onclick="() => AendereMenge(pos, 1)">+</button>
                                    </div>
                                    <span class="enote-ticket-pos-preis">@pos.EffektivPreis.ToString("N0") F × @pos.Menge</span>
                                    <div class="enote-ticket-pos-sum">@ZeilenSumme(pos).ToString("N0") F</div>
                                </div>
                                @if (pos.Rabatt is not null)
                                {
                                    <span class="enote-tag">@pos.Rabatt.Name</span>
                                }
                            </div>
                        }
                    </div>
                }

                @if (ticket.Count > 0)
                {
                    <div class="enote-ticket-rabatt">
                        <div class="enote-rabatt-kopf">
                            <label>Remise</label>
                            @if (!string.IsNullOrEmpty(ausgewaehlteRabattId))
                            {
                                <EnoteCheckbox @bind-Value="rabattAktiviert" Label="Activer" />
                            }
                        </div>
                        <EnoteSelect TValue="string" @bind-Value="ausgewaehlteRabattId" Options="rabattOptionen" Placeholder="Aucune" MitSuche="true" />
                        @if (!string.IsNullOrEmpty(ausgewaehlteRabattId) && !rabattAktiviert)
                        {
                            <small class="enote-muted">Activez la remise pour l'appliquer.</small>
                        }
                        @if (rabattAktiviert && ausgewaehlterRabatt?.Bedingung is string bedingung && !string.IsNullOrWhiteSpace(bedingung))
                        {
                            <label class="enote-check-row"><EnoteCheckbox @bind-Value="bedingungBestaetigt" Label="@bedingungLabel" /></label>
                        }
                    </div>

                    <div class="enote-ticket-total">
                        <div><span>Sous-total</span><span>@zwischensumme.ToString("N0") F</span></div>
                        <div><span>Remise</span><span>-@rabattSumme.ToString("N0") F</span></div>
                        <div class="enote-total"><span>Total</span><span>@gesamtSumme.ToString("N0") F</span></div>
                    </div>

                    @* Zahlung: zwei große Touch-Buttons, öffnen je ein Modal *@
                    <div class="enote-zahl-buttons">
                        <button type="button" class="enote-zahl-btn enote-zahl-bar" @onclick="OeffneBarModal">💵 Espèces</button>
                        <button type="button" class="enote-zahl-btn enote-zahl-karte" @onclick="OeffneKarteModal">💳 Carte</button>
                    </div>

                    @if (letzterVerkaufId is Guid bonId)
                    {
                        <button type="button" class="enote-btn enote-btn-ghost enote-btn-lg" @onclick="() => DruckeBonAsync(bonId)">🖨️ Imprimer le reçu</button>
                    }
                }
            </div>
        </div>
    </div>
}

@* --- Zahlung Espèces (Bar) --- *@
<ModalDialog Open="barModalOffen" Title="Paiement en espèces" ErrorMessage="@verkaufFehler" OnClose="() => barModalOffen = false" MaxWidthClass="enote-modal-sm">
    <ChildContent>
        <div class="enote-zahl-modal">
            <div class="enote-zahl-total">
                <span>Total à payer</span>
                <strong>@gesamtSumme.ToString("N0") F</strong>
            </div>
            <label>Montant reçu (F)</label>
            <input type="number" min="0" step="50" inputmode="numeric" class="enote-zahl-input" @bind="gegeben" @bind:event="oninput" />
            @if (barBetragZuWenig)
            {
                <small class="enote-danger">Montant insuffisant – il manque @((gesamtSumme - gegeben).ToString("N0")) F.</small>
            }
            <div class="enote-rueckgeld">
                <span>Monnaie à rendre</span>
                <strong>@rueckgeldModal.ToString("N0") F</strong>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => barModalOffen = false">Annuler</button>
        <AsyncActionButton Text="Confirmer" OnClick="BestaetigeBarAsync" CssClass="enote-btn-primary" Disabled="@barBetragZuWenig" />
    </Footer>
</ModalDialog>

@* --- Zahlung Carte --- *@
<ModalDialog Open="karteModalOffen" Title="Paiement par carte" ErrorMessage="@verkaufFehler" OnClose="() => karteModalOffen = false" MaxWidthClass="enote-modal-sm">
    <ChildContent>
        <div class="enote-zahl-modal">
            <div class="enote-zahl-total">
                <span>Total à payer</span>
                <strong>@gesamtSumme.ToString("N0") F</strong>
            </div>
            <p class="enote-muted">Effectuez le paiement par carte, puis confirmez.</p>
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => karteModalOffen = false">Annuler</button>
        <AsyncActionButton Text="Confirmer le paiement" OnClick="BestaetigeKarteAsync" CssClass="enote-btn-primary" />
    </Footer>
</ModalDialog>

@* --- Bestätigung: Verkauf abbrechen --- *@
<ModalDialog Open="abbrechenBestaetigungOffen" Title="Annuler la vente" OnClose="() => abbrechenBestaetigungOffen = false" MaxWidthClass="enote-modal-sm">
    <ChildContent>
        <p>Voulez-vous vraiment annuler la vente ? Toutes les prestations sélectionnées seront supprimées.</p>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => abbrechenBestaetigungOffen = false">Non, garder</button>
        <button class="enote-btn enote-btn-abbrechen" @onclick="BrecheTicketAb">Oui, annuler</button>
    </Footer>
</ModalDialog>

@* --- Verkaufshistorie (vorherige Verkäufe + Bon nachdrucken) --- *@
<ModalDialog Open="historieOffen" Title="Ventes récentes" OnClose="() => historieOffen = false" MaxWidthClass="enote-modal-md">
    <ChildContent>
        @if (historieLaedt)
        {
            <p>Chargement…</p>
        }
        else if (historieVerkaeufe.Count == 0)
        {
            <p class="enote-muted">Aucune vente pour le moment.</p>
        }
        else
        {
            <div class="enote-historie-liste">
                @foreach (var v in historieVerkaeufe)
                {
                    <div class="enote-historie-item">
                        <div class="enote-historie-info">
                            <div class="enote-historie-top">
                                <strong class="enote-historie-betrag">@v.GesamtSumme.ToString("N0") F</strong>
                                <span class="enote-tag enote-tag-zahlart">@(v.ZahlungsArt == ZahlungsArt.Bar ? "💵 Espèces" : "💳 Carte")</span>
                            </div>
                            <small class="enote-muted">@v.ZeitUtc.ToLocalTime().ToString("dd.MM.yyyy · HH:mm") – @v.KassiererName</small>
                            <small class="enote-historie-pos">@v.PositionenText</small>
                        </div>
                        <button type="button" class="enote-btn enote-btn-ghost enote-btn-sm enote-historie-reçu" @onclick="() => DruckeBonAsync(v.VerkaufId)">🖨️ Reçu</button>
                    </div>
                }
            </div>
        }
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-primary" @onclick="() => historieOffen = false">Fermer</button>
    </Footer>
</ModalDialog>

@* --- Kassenabschluss --- *@
<ModalDialog Open="abschlussOffen" Title="Clôturer la caisse" ErrorMessage="@abschlussFehler" OnClose="() => abschlussOffen = false">
    <ChildContent>
        <div class="enote-form">
            <p>Comptez l'argent en caisse et saisissez le montant.</p>
            @if (barSollInfo is var info && info is not null)
            {
                <div class="enote-abschluss-soll">
                    <div class="enote-abschluss-soll-zeilen">
                        <div><span>Fonds de départ</span><span>@info.Value.Startbestand.ToString("N0") F</span></div>
                        <div><span>Ventes en espèces</span><span>+ @info.Value.BarEinnahmen.ToString("N0") F</span></div>
                    </div>
                    <div class="enote-abschluss-soll-total">
                        <span>Montant attendu en espèces</span>
                        <strong>@info.Value.Soll.ToString("N0") F</strong>
                    </div>
                </div>
            }
            <label>Montant compté (F) <input type="number" min="0" step="100" @bind="endbestandGezaehlt" /></label>
            <label>Note (facultatif) <textarea rows="3" @bind="abschlussNotiz"></textarea></label>
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => abschlussOffen = false">Annuler</button>
        <AsyncActionButton Text="Clôturer" OnClick="SchliesseSitzungAsync" CssClass="enote-btn-primary" />
    </Footer>
</ModalDialog>

@* --- Hinweis: offene Kasse wiederhergestellt --- *@
<ModalDialog Open="wiederhergestelltModalOffen" Title="Caisse encore ouverte" OnClose="() => wiederhergestelltModalOffen = false" MaxWidthClass="enote-modal-sm">
    <ChildContent>
        <div class="enote-wiederhergestellt">
            <p class="enote-wiederhergestellt-text">Une caisse de la session précédente n'a pas été clôturée.</p>
            <div class="enote-wiederhergestellt-zeile"><span>Caissier</span><strong>@wiederhergestelltKassierer</strong></div>
            <div class="enote-wiederhergestellt-zeile"><span>Démarrée le</span><strong>@wiederhergestelltGestartet.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong></div>
            @if (wiederhergestelltSoll is decimal soll)
            {
                <div class="enote-wiederhergestellt-zeile enote-wiederhergestellt-soll"><span>Montant attendu en espèces</span><strong>@soll.ToString("N0") F</strong></div>
            }
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-primary" @onclick="() => wiederhergestelltModalOffen = false">OK</button>
    </Footer>
</ModalDialog>

@* --- Freier Betrag für Standard-Artikel „Divers“ --- *@
<ModalDialog Open="freierBetragOffen" Title="Montant – Divers" ErrorMessage="@freierBetragFehler" OnClose="() => freierBetragOffen = false">
    <ChildContent>
        <div class="enote-form">
            <p>Saisissez le montant de cette vente (prestation non créée).</p>
            <label>Montant (F) <input type="number" min="0" step="50" @bind="freierBetrag" /></label>
            <label>Quantité <input type="number" min="1" @bind="freierBetragMenge" /></label>
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => freierBetragOffen = false">Annuler</button>
        <AsyncActionButton Text="Ajouter" OnClick="FuegeStandardArtikelHinzu" CssClass="enote-btn-primary" />
    </Footer>
</ModalDialog>

@* --- Kunden-Display verbinden (QR-Code + Link) --- *@
<ModalDialog Open="displayDialogOffen" Title="Affichage client" OnClose="() => displayDialogOffen = false">
    <ChildContent>
        <div class="enote-display-dialog">
            <p class="enote-muted">Le client scanne ce code (ou ouvre ce lien) sur une tablette pour suivre sa commande en direct.</p>
            @if (!string.IsNullOrWhiteSpace(displayQrDataUrl))
            {
                <img src="@displayQrDataUrl" alt="QR-code" class="enote-display-qr" />
            }
            <div class="enote-display-link">@displayLink</div>
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => displayDialogOffen = false">Fermer</button>
    </Footer>
</ModalDialog>
