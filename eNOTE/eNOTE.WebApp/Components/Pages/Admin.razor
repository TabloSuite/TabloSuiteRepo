@page "/admin"
@attribute [Authorize(Roles = "SuperAdmin, ProduktOwner")]
@rendermode InteractiveServer
@using ENote.Core.DataModels.Abo
@using ENote.Core.Services

<PageTitle>Administration</PageTitle>


<BesitzerPinGuard>
<div class="enote-page">
    <div class="enote-page-header">
        <div>
            <h1>Administration</h1>
            <p>Validez les établissements, gérez les prix de la plateforme et consultez l'activité.</p>
        </div>
        <AuthorizeView Roles="SuperAdmin">
            <Authorized Context="addCtx">
                <button class="enote-btn enote-btn-primary" @onclick="OeffneBesitzerDialog">+ Ajouter un propriétaire</button>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (isLoading)
    {
        <p>Chargement…</p>
    }
    else
    {
        <div class="enote-tabs">
            <button class="enote-tab @(aktiverTab == "etablissements" ? "aktiv" : "")" @onclick='() => WechsleTab("etablissements")'>Établissements</button>
            <button class="enote-tab @(aktiverTab == "plateforme" ? "aktiv" : "")" @onclick='() => WechsleTab("plateforme")'>Propriétaires plateforme</button>
            <AuthorizeView Roles="SuperAdmin" Context="mmTabCtx">
                <Authorized>
                    <button class="enote-tab @(aktiverTab == "tarifs" ? "aktiv" : "")" @onclick='() => WechsleTab("tarifs")'>Tarifs</button>
                    <button class="enote-tab @(aktiverTab == "mobilemoney" ? "aktiv" : "")" @onclick='() => WechsleTab("mobilemoney")'>Mobile Money</button>
                    @if (istErsterAdmin)
                    {
                        <button class="enote-tab @(aktiverTab == "administrateurs" ? "aktiv" : "")" @onclick='() => WechsleTab("administrateurs")'>Administrateurs</button>
                    }
                </Authorized>
            </AuthorizeView>
        </div>

        @if (aktiverTab == "etablissements")
        {
            <div class="ad-kpis">
                <div class="ad-kpi"><span>Établissements</span><strong>@kennzahlen.Gesamt</strong></div>
                <div class="ad-kpi"><span>En attente</span><strong class="@(kennzahlen.Wartend > 0 ? "warn" : "")">@kennzahlen.Wartend</strong></div>
                <div class="ad-kpi"><span>En essai</span><strong>@kennzahlen.Probe</strong></div>
                <div class="ad-kpi"><span>Payants</span><strong>@kennzahlen.Zahlend</strong></div>
                <div class="ad-kpi"><span>Désactivés</span><strong>@kennzahlen.Deaktiviert</strong></div>
            </div>
            <div class="enote-filter-leiste">
                <input class="enote-filter-suche" placeholder="Rechercher (nom, ville, propriétaire, e-mail)…" @bind="salonSuche" @bind:event="oninput" @bind:after="SucheSalonsVerzoegertAsync" />
                <EnoteSelect TValue="string" @bind-Value="salonStatusFilter" @bind-Value:after="LadeSalonsAsync" Options="statusFilterOptionen" />
                <EnoteSelect TValue="string" @bind-Value="salonLandFilter" @bind-Value:after="LadeSalonsAsync" Options="landFilterOptionen" MitSuche="true" Placeholder="Pays (tous)" />
            </div>

            @if (ausstehende.Count > 0)
            {
                <h2 class="enote-section-title">En attente de validation (@ausstehende.Count)</h2>
                <div class="enote-grid-scroll">
                    @foreach (var s in ausstehende)
                    {
                        <div class="enote-item enote-item-pending">
                            <div class="enote-item-head">
                                <strong>@s.Name</strong>
                                <span class="enote-tag enote-tag-warn">En attente</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(s.Standort))
                            {
                                <p class="enote-item-desc">@s.Standort</p>
                            }
                            <p class="enote-item-desc">Inscrit le @s.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy")</p>
                            <div class="enote-item-actions">
                                <AsyncActionButton Text="Valider" OnClick="() => SetzeFreigabeAsync(s.SalonId, true)" CssClass="enote-btn-primary" />
                                @if (istSuperAdmin)
                                {
                                    <AsyncActionButton Text="Refuser" OnClick="() => SetzeAktivAsync(s.SalonId, false)" CssClass="enote-btn-ghost enote-danger" />
                                }
                                else
                                {
                                    <button class="enote-btn enote-btn-ghost" @onclick="() => OeffneAnfrageDialog(s.SalonId, s.Name, AnfrageRefus)">Demander le refus</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            var gefiltert = GefilterteSalons().ToList();
            <h2 class="enote-section-title">Tous les établissements <small class="enote-muted">(@kennzahlen.Gesamt)</small></h2>
            @if (gefiltert.Count == 0)
            {
                <p class="enote-empty" role="status">@(kennzahlen.Gesamt == 0 ? "Aucun établissement pour le moment." : "Aucun établissement ne correspond à votre recherche ou aux filtres sélectionnés.")</p>
            }
            else
            {
                <div class="ad-liste enote-liste-scroll">
                    <div class="ad-kopfzeile" aria-hidden="true">
                        <span>Établissement</span><span>Propriétaire</span><span>Pays · équipe</span><span class="r">Ventes totales</span><span></span>
                    </div>
                    @foreach (var s in gefiltert)
                    {
                        <div class="ad-zeile @(s.IstAktiv ? "" : "aus")">
                            <div class="ad-laden">
                                <span class="ad-avatar"><Icon Name="store" Groesse="18" /></span>
                                <div>
                                    <strong>@s.Name</strong>
                                    <div class="ad-tags">
                                        @if (!s.IstFreigegeben) { <span class="ad-tag warn">En attente</span> }
                                        @if (!s.IstAktiv) { <span class="ad-tag off">Désactivé</span> }
                                        else if (s.HatProbezeit) { <span class="ad-tag probe">Essai</span> }
                                        else { <span class="ad-tag paid">Payant</span> }
                                    </div>
                                </div>
                            </div>
                            <div class="ad-person">
                                <span>@(s.BesitzerName ?? "—")</span>
                                <small>@(s.BesitzerEmail)@(string.IsNullOrWhiteSpace(s.ProduktOwnerName) ? "" : " · PO " + s.ProduktOwnerName)</small>
                                @if (!string.IsNullOrWhiteSpace(s.BesitzerTelefon))
                                {
                                    <small><a href="tel:@(s.BesitzerTelefon.Replace(" ", ""))">@s.BesitzerTelefon</a></small>
                                }
                            </div>
                            <div class="ad-meta">
                                @if (istSuperAdmin)
                                {
                                    <button type="button" class="ad-land-knopf" title="Modifier le pays" aria-label="@($"Modifier le pays de {s.Name}")" @onclick="() => OeffneLandDialog(s.SalonId, s.Name, s.Land)">
                                        <Icon Name="globe" Groesse="13" /> @(string.IsNullOrWhiteSpace(s.Land) ? "Togo (défaut)" : s.Land)
                                    </button>
                                }
                                else
                                {
                                    <span>@(string.IsNullOrWhiteSpace(s.Land) ? "—" : s.Land)</span>
                                }
                                <small>@s.AnzahlMitglieder membre@(s.AnzahlMitglieder > 1 ? "s" : "")</small>
                            </div>
                            <strong class="ad-umsatz">@s.GesamtUmsatz.ToString("N0") F</strong>
                            <div class="ad-aktionen">
                                @if (!s.IstFreigegeben)
                                {
                                    <AsyncActionButton CssClass="enote-btn-primary enote-btn-sm" Text="Valider" BusyText="Validation…" OnClick="() => SetzeFreigabeAsync(s.SalonId, true)" />
                                }
                                <button class="enote-btn enote-btn-ghost enote-btn-sm" title="Période d'essai" @onclick="() => OeffneProbeDialogAsync(s.SalonId, s.Name)"><Icon Name="clock" Groesse="15" /> Essai</button>
                                @if (!istSuperAdmin)
                                {
                                    @* Responsable: kritische Aktionen nur als Anfrage an den Admin *@
                                    <button class="enote-btn enote-btn-ghost enote-btn-sm" title="Demande à l'administrateur" @onclick="() => OeffneAnfrageDialog(s.SalonId, s.Name)"><Icon Name="mail" Groesse="15" /> Demande</button>
                                }
                                else
                                {
                                    <LadenTarifVerwaltung SalonId="@s.SalonId" OnOeffnen="OeffneTarifDialogAsync" />
                                    if (s.IstAktiv)
                                    {
                                        <AsyncActionButton BasisKlasse="enote-icon-btn" CssClass="rm-loeschen" title="Désactiver l'établissement" aria-label="@($"Désactiver {s.Name}")" OnClick="() => SetzeAktivAsync(s.SalonId, false)"><Icon Name="lock" Groesse="17" /></AsyncActionButton>
                                    }
                                    else
                                    {
                                        <AsyncActionButton BasisKlasse="enote-icon-btn" title="Réactiver l'établissement" aria-label="@($"Réactiver {s.Name}")" OnClick="() => SetzeAktivAsync(s.SalonId, true)"><Icon Name="unlock" Groesse="17" /></AsyncActionButton>
                                    }
                                }
                            </div>
                        </div>
                    }
                    @if (salonsMehr)
                    {
                        <AsyncActionButton CssClass="enote-btn-ghost enote-mehr" BusyText="Chargement…" OnClick="MehrSalonsAsync">Afficher plus</AsyncActionButton>
                    }
                </div>
            }
        }
        else if (aktiverTab == "plateforme")
        {
            <AuthorizeView Roles="SuperAdmin">
                <Authorized>
                    @* --- ProduktOwner-Verwaltung --- *@
                    <h2 class="enote-section-title">Propriétaires plateforme</h2>
                    <div class="enote-card enote-settings-card">
                        <div class="enote-item-head">
                            <strong>Propriétaires plateforme (@produktOwners.Count)</strong>
                            <button class="enote-btn enote-btn-primary enote-btn-sm" @onclick="OeffnePoAnlegeDialog">+ Ajouter</button>
                        </div>
                        <input class="enote-filter-suche" placeholder="Rechercher (nom, e-mail)…" @bind="poSuche" @bind:event="oninput" />
                        @if (!GefilterteProduktOwners().Any())
                        {
                            <p class="enote-empty" role="status">@(produktOwners.Count == 0 ? "Aucun propriétaire plateforme pour le moment. Cliquez sur « Ajouter » pour créer un compte." : "Aucun propriétaire plateforme ne correspond à votre recherche.")</p>
                        }
                        <div class="enote-po-auswahl">
                            @foreach (var po in GefilterteProduktOwners())
                            {
                                var istAusgewaehlt = ausgewaehlterPoId == po.Id;
                                <button class="enote-po-btn @(istAusgewaehlt ? "enote-po-btn-aktiv" : "")"
                                        @onclick="() => WaehleProduktOwnerAsync(po.Id, po.FullName)">
                                    <span class="enote-po-btn-inhalt">
                                        <span class="enote-po-btn-name">@po.FullName</span>
                                        <span class="enote-po-btn-email">@po.Email</span>
                                    </span>
                                    @if (istAusgewaehlt)
                                    {                                        <span class="enote-po-btn-check">&#10003;</span>}
                                </button>
                            }
                        </div>

                        @if (ausgewaehlterPoId is not null)
                        {
                            @* Verwaltete Läden als separate Liste mit Details *@
                            @if (zuweisungen is not null && zuweisungen.Count > 0)
                            {
                                <div class="enote-po-salons-liste">
                                    <div class="enote-po-salons-header">
                                        <strong>@zuweisungen.Count établissement@(zuweisungen.Count != 1 ? "s" : "") géré@(zuweisungen.Count != 1 ? "s" : "") par @ausgewaehlterPoName</strong>
                                        <input class="enote-filter-suche enote-filter-suche-sm" placeholder="Rechercher…" @bind="verwalteteLaedenSuche" @bind:event="oninput" />
                                    </div>
                                    <div class="enote-po-salons-items">
                                        @foreach (var z in GefilterteVerwalteteLaeden())
                                        {
                                            var salon = poSalons.FirstOrDefault(s => s.SalonId == z.SalonId) ?? salons.FirstOrDefault(s => s.SalonId == z.SalonId);
                                            <div class="enote-po-salon-item">
                                                <div class="enote-po-salon-info">
                                                    <span class="enote-po-salon-name">@z.SalonName</span>
                                                    @if (salon is not null)
                                                    {
                                                        <span class="enote-po-salon-details">
                                                            @(salon.IstFreigegeben ? "Validé" : "En attente") · @(salon.IstAktiv ? "Actif" : "Inactif")
                                                        </span>
                                                    }
                                                </div>
                                                @if (salon is not null)
                                                {
                                                    <span class="enote-tag @(salon.IstFreigegeben ? "" : "enote-tag-warn")">@(salon.IstFreigegeben ? "Validé" : "Attente")</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            <div class="enote-zuweisung">
                                <h3>établissements de @ausgewaehlterPoName</h3>
                                <p class="enote-muted">Cochez les établissements qu'il gére. Par défaut il voit le chiffre d'affaires de l'établissement.</p>
                                <div class="enote-filter-row">
                                    <input class="enote-filter-suche" placeholder="Rechercher (nom, ville, propriétaire)…" @bind="verfuegbareLaedenSuche" @bind:event="oninput" @bind:after="SuchePoSalonsVerzoegertAsync" />
                                    <div class="enote-filter-chips">
                                        <button class="enote-chip @(verfuegbareLaedenFilter == "alle" ? "enote-chip-aktiv" : "")" @onclick='() => verfuegbareLaedenFilter = "alle"'>Tous (@kennzahlen.Gesamt)</button>
                                        <button class="enote-chip @(verfuegbareLaedenFilter == "gérés" ? "enote-chip-aktiv" : "")" @onclick='() => verfuegbareLaedenFilter = "gérés"'>Gérés (@zuweisungen.Count)</button>
                                        <button class="enote-chip @(verfuegbareLaedenFilter == "non gérés" ? "enote-chip-aktiv" : "")" @onclick='() => verfuegbareLaedenFilter = "non gérés"'>Non gérés (@(Math.Max(0, kennzahlen.Gesamt - zuweisungen.Count)))</button>
                                    </div>
                                </div>
                                @if (poSalons.Count == 0)
                                {
                                    <p class="enote-empty" role="status">@(string.IsNullOrWhiteSpace(verfuegbareLaedenSuche) ? "Aucun établissement disponible pour une affectation." : "Aucun établissement ne correspond à la recherche.")</p>
                                }
                                @foreach (var s in GefilterteVerfuegbareLaeden())
                                {
                                    var z = zuweisungen.FirstOrDefault(x => x.SalonId == s.SalonId);
                                    var zugewiesen = z is not null;
                                    <div class="enote-zuweisung-row">
                                        <EnoteCheckbox Value="@zugewiesen" ValueChanged="v => ToggleZuweisungAsync(s.SalonId, v)" Label="@s.Name" />
                                        @if (zugewiesen && z is not null)
                                        {
                                            <div class="enote-zuweisung-rechte">
                                                <EnoteCheckbox Value="@z.KannLadenUmsatzSehen" ValueChanged="_ => SetzeUmsatzRechtAsync(z)" Label="CA établissement" />
                                                <button class="enote-btn enote-btn-ghost enote-btn-sm" @onclick="() => OeffneProvisionDialog(z)">Commission</button>
                                            </div>
                                        }
                                    </div>
                                }
                                @if (poSalonsMehr)
                                {
                                    <AsyncActionButton CssClass="enote-btn-ghost enote-mehr" BusyText="Chargement…" OnClick="MehrPoSalonsAsync">Afficher plus</AsyncActionButton>
                                }
                            </div>
                        }
                    </div>

                    @* --- Provisionen: entstehen automatisch je bestätigter Zahlung --- *@
                    <h2 class="enote-section-title">Commissions des responsables</h2>
                    <PoProvisionenAdmin />
                </Authorized>
            </AuthorizeView>
        }
        else if (aktiverTab == "administrateurs" && istErsterAdmin)
        {
            <AdminKontenVerwaltung />
        }
        else if (aktiverTab == "tarifs")
        {
            <AuthorizeView Roles="SuperAdmin" Context="tarifCtx">
                <Authorized>
                    <TarifAnpassung BearbeiterId="aktuellerBenutzerId" OnGeaendert="LadeAsync" />
                </Authorized>
            </AuthorizeView>
        }
        else if (aktiverTab == "mobilemoney")
        {
            <AuthorizeView Roles="SuperAdmin" Context="mmCtx">
                <Authorized>
                    <MobileMoneyVerwaltung />
                </Authorized>
            </AuthorizeView>
        }
    }
</div>


@* Besitzer + Geschäft durch Admin anlegen *@
<ModalDialog Open="besitzerDialogOffen" Title="Ajouter un propriétaire" ErrorMessage="@besitzerFehler" OnClose="() => besitzerDialogOffen = false">
    <ChildContent>
        <div class="enote-form">
            <div class="enote-form-grid">
                <label>Prénom <input @bind="neuVorname" /></label>
                <label>Nom <input @bind="neuNachname" /></label>
            </div>
            <label>Pseudonyme (identifiant de connexion) <input @bind="neuPseudonym" autocomplete="username" /></label>
            <label>Adresse e-mail de contact <input type="email" @bind="neuEmail" /></label>
            <label>Téléphone du propriétaire <input type="tel" @bind="neuTelefon" autocomplete="off" maxlength="30" placeholder="ex. +228 90 12 34 56" /></label>
            <label>Mot de passe initial <input type="text" @bind="neuPasswort" /></label>
            <small class="enote-muted" style="margin-top:-.5rem;">Au moins 6 caractères, dont 1 chiffre et 1 lettre minuscule.</small>
            <label>Nom de l'établissement <input @bind="neuSalonName" /></label>
            <label>Ville / quartier (facultatif) <input @bind="neuStandort" /></label>
            <label>Pays</label>
            <EnoteSelect TValue="string" @bind-Value="neuLand" Options="landOptionen" MitSuche="true" Placeholder="Choisir le pays…" />
            <small class="enote-muted">L'établissement est validé et actif immédiatement. Communiquez au propriétaire son mot de passe initial.</small>
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => besitzerDialogOffen = false">Annuler</button>
        <AsyncActionButton Text="Créer" OnClick="LegeBesitzerAnAsync" CssClass="enote-btn-primary" />
    </Footer>
</ModalDialog>

@* ProduktOwner anlegen *@
<ModalDialog Open="poAnlegeDialogOffen" Title="Ajouter un propriétaire plateforme" ErrorMessage="@poFehler" OnClose="() => poAnlegeDialogOffen = false">
    <ChildContent>
        <div class="enote-form">
            <div class="enote-form-grid">
                <label>Prénom <input @bind="poVorname" /></label>
                <label>Nom <input @bind="poNachname" /></label>
            </div>
            <label>Pseudonyme (identifiant de connexion) <input @bind="poPseudonym" autocomplete="username" /></label>
            <label>Adresse e-mail <input type="email" @bind="poEmail" /></label>
            <label>Mot de passe initial <input type="text" @bind="poPasswort" /></label>
            <small class="enote-muted" style="margin-top:-.5rem;">Au moins 6 caractères, dont 1 chiffre et 1 lettre minuscule.</small>
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => poAnlegeDialogOffen = false">Annuler</button>
        <AsyncActionButton Text="Créer" OnClick="LegeProduktOwnerAnAsync" CssClass="enote-btn-primary" />
    </Footer>
</ModalDialog>

@* Provision für einen PO-Laden festlegen *@
<ModalDialog Open="provisionDialogOffen" Title="@ProvisionDialogTitel" ErrorMessage="@provisionFehler" OnClose="() => provisionDialogOffen = false">
    <ChildContent>
        <div class="enote-form">
            <label>Commission en pourcentage (%) <input type="number" min="0" max="100" step="0.5" @bind="provisionProzent" /></label>
            <label>ou montant fixe par abonnement (F) <input type="number" min="0" step="100" @bind="provisionFestbetrag" /></label>
            <small class="enote-muted">Laissez vide pour aucune commission. Si les deux sont définis, ils s'additionnent.</small>
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => provisionDialogOffen = false">Annuler</button>
        <AsyncActionButton Text="Enregistrer" OnClick="SpeichereProvisionAsync" CssClass="enote-btn-primary" />
    </Footer>
</ModalDialog>

@* Land eines Ladens ändern (nur Admin): Ortszeit und Mobile-Money-Anbieter folgen *@
<ModalDialog Open="landDialogOffen" Title="@($"Pays de « {landSalonName} »")" ErrorMessage="@landFehler" OnClose="() => landDialogOffen = false" MaxWidthClass="enote-modal-sm">
    <ChildContent>
        <div class="enote-form">
            <p class="enote-muted">@ENote.WebApp.Services.LaenderAuswahl.Hinweis</p>
            <EnoteSelect TValue="string" Value="landNeu" ValueChanged="(string? l) => landNeu = l ?? landNeu" Options="landAuswahlOptionen" MitSuche="true" Placeholder="Choisir le pays…" />
            @if (landNeu != (landBisher ?? ENote.WebApp.Services.LaenderAuswahl.Standard))
            {
                <p class="st-land-folgen" role="status"><Icon Name="info" Groesse="16" /> @ENote.WebApp.Services.LaenderAuswahl.Folgen(landNeu, DateTime.UtcNow, fuerBesitzer: false)</p>
            }
            else if (landBisher is null)
            {
                <small class="enote-muted">Pays non renseigné : Togo par défaut (heure de Lomé).</small>
            }
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => landDialogOffen = false">Annuler</button>
        <AsyncActionButton Text="Enregistrer" BusyText="Enregistrement…" OnClick="SpeichereLandAsync" CssClass="enote-btn-primary" Disabled="@(landNeu == landBisher)" />
    </Footer>
</ModalDialog>

@* Probezeit eines Ladens ändern (Admin/PO) *@
<ModalDialog Open="probeDialogOffen" Title="@ProbeDialogTitel" ErrorMessage="@probeFehler" OnClose="() => probeDialogOffen = false">
    <ChildContent>
        <div class="enote-form">
            @if (istSuperAdmin)
            {
                <p class="enote-muted">Fin de l'essai gratuit pour « @probeSalonName ». Laissez vide pour supprimer l'essai (facturation immédiate).</p>
            }
            else if (probeBisher is null)
            {
                <p class="enote-muted">« @probeSalonName » n'a pas d'essai gratuit. Seul l'administrateur peut en accorder un : envoyez-lui une demande.</p>
            }
            else if (!PoDarfVerlaengern)
            {
                <p class="enote-muted">L'essai de « @probeSalonName » dure déjà jusqu'au <strong>@probeBisher?.ToString("dd.MM.yyyy")</strong> : vous ne pouvez pas le prolonger davantage. Pour toute autre modification, envoyez une demande à l'administrateur.</p>
            }
            else
            {
                <p class="enote-muted">Vous pouvez prolonger l'essai de « @probeSalonName » jusqu'au <strong>@ENote.WebApp.Services.AdminService.PoProbeGrenze(DateTime.UtcNow).ToString("dd.MM.yyyy")</strong> au plus (@ENote.WebApp.Services.AdminService.PoProbeMaxTage jours). Pour raccourcir ou retirer l'essai, envoyez une demande à l'administrateur.</p>
            }
            @if (ZeigeProbeFormular)
            {
                <label>Date de fin d'essai</label>
                <EnoteDatePicker @bind-Value="probeBisDatum" />
                <p class="enote-muted enote-probe-anzeige">
                    @if (probeBisDatum is not null)
                    {
                        <text>Fin actuelle : <strong>@probeBisDatum.Value.ToString("MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"))</strong></text>
                    }
                    else
                    {
                        <text>Aucun essai actif – facturation immédiate.</text>
                    }
                </p>
                <div class="enote-item-actions">
                    @if (istSuperAdmin)
                    {
                        <button class="enote-btn enote-btn-ghost enote-btn-sm" @onclick="SetzeProbeStandard">Par défaut (3 mois, ce mois inclus)</button>
                        <button class="enote-btn enote-btn-ghost enote-btn-sm enote-danger" @onclick="EntferneProbe">Supprimer l'essai</button>
                    }
                    else
                    {
                        <button class="enote-btn enote-btn-ghost enote-btn-sm" @onclick="SetzeProbeMaximal">Prolonger au maximum (@ENote.WebApp.Services.AdminService.PoProbeMaxTage jours)</button>
                    }
                </div>
            }
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => probeDialogOffen = false">@(ZeigeProbeFormular ? "Annuler" : "Fermer")</button>
        @if (ZeigeProbeFormular)
        {
            <AsyncActionButton Text="Enregistrer" OnClick="SpeichereProbeAsync" CssClass="enote-btn-primary" />
        }
    </Footer>
</ModalDialog>

@* Anfrage eines Responsables an den Admin (Deaktivieren, Probezeit kürzen …) *@
<ModalDialog Open="anfrageDialogOffen" Title="@AnfrageDialogTitel" ErrorMessage="@anfrageFehler" OnClose="() => anfrageDialogOffen = false">
    <ChildContent>
        <div class="enote-form">
            <p class="enote-muted">Pour protéger les établissements, les actions importantes (désactiver, retirer l'essai, changer le tarif…) sont faites par l'administrateur. Il reçoit votre demande par e-mail.</p>
            <label>Objet de la demande</label>
            <EnoteSelect TValue="string" @bind-Value="anfrageAnliegen" Options="anfrageOptionen" Placeholder="Choisir…" />
            <label>Message (facultatif) <textarea rows="3" maxlength="500" @bind="anfrageGrund" placeholder="ex. Le propriétaire a fermé sa boutique."></textarea></label>
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => anfrageDialogOffen = false">Annuler</button>
        <AsyncActionButton Text="Envoyer la demande" BusyText="Envoi…" OnClick="SendeAnfrageAsync" CssClass="enote-btn-primary" />
    </Footer>
</ModalDialog>

@* Tarif-Dialog: zentral am Seitenende gerendert (nicht innerhalb der scrollbaren Salon-Liste),
   damit er als echtes Overlay erscheint und nicht beschnitten wird. *@
<ModalDialog Open="tarifDialogOffen" Title="@TarifDialogTitel" OnClose="() => tarifDialogOffen = false" ErrorMessage="@tarifFehler" MaxWidthClass="enote-modal-md">
    <ChildContent>
        @if (tarif is not null)
        {
            <p>Tarif général : <strong>@tarif.Global.ToString("N0") F CFA / mois</strong></p>
            <p>Tarif actuellement appliqué : <strong>@((tarif.Individuell ?? tarif.Global).ToString("N0")) F CFA / mois</strong> · @(tarif.Individuell is null ? "tarif général" : "tarif personnalisé")</p>
            <p class="enote-muted">Un tarif personnalisé remplace le tarif général pour cet établissement, sans jamais être inférieur à celui-ci. Les remises sont calculées automatiquement. Les périodes déjà facturées ne changent pas.</p>
            <div class="enote-form"><label>Montant mensuel (F CFA)</label><input type="number" min="@tarif.Global" step="100" @bind="tarifPreis" /></div>
            @if (tarifPreis is > 0)
            {
                @foreach (var i in VertragsRegeln.Intervalle) { <p>@VertragsRegeln.Bezeichnung(i) : @VertragsRegeln.Preis(tarifPreis.Value, i).ToString("N0") F · @VertragsRegeln.Rabatt(i) %</p> }
            }
            <p class="enote-muted">« Revenir au tarif général » appliquera @tarif.Global.ToString("N0") F CFA / mois aux prochaines périodes.</p>
        }
    </ChildContent>
    <Footer>
        <AsyncActionButton Text="Appliquer le tarif personnalisé" OnClick="() => SpeichereTarifAsync(false)" CssClass="enote-btn-primary" />
        <AsyncActionButton Text="Revenir au tarif général" OnClick="() => SpeichereTarifAsync(true)" CssClass="enote-btn-ghost" />
    </Footer>
</ModalDialog>
</BesitzerPinGuard>
