@page "/finances"
@attribute [Authorize(Roles = "Besitzer, Kassierer")]
@rendermode InteractiveServer
@using ENote.Core.DataModels.Kasse

<PageTitle>Finances</PageTitle>

<BesitzerPinGuard>
<div class="enote-page enote-finances">
    <div class="enote-page-header">
        <div>
            <h1>Finances – @salonName</h1>
            <p>Solde de caisse, chiffre d'affaires, dernières ventes et clôtures de caisse.</p>
        </div>
    </div>

    @if (!darfFinanzenSehen)
    {
        <p class="enote-empty">Vous n'avez pas le droit de consulter les finances de cet établissement.</p>
    }
    else if (isLoading)
    {
        <p>Chargement…</p>
    }
    else
    {
        <div class="enote-live-banner @(liveVerbunden ? "verbunden" : "")">
            <span class="enote-live-dot"></span>
            <div>
                <div class="enote-live-label">Aujourd'hui @(liveVerbunden ? "(en direct)" : "")</div>
                <div class="enote-live-wert">@liveTagesUmsatz.ToString("N0") F <span class="enote-muted">· @liveAnzahlHeute vente(s)</span></div>
            </div>
        </div>

        <div class="enote-filter-row">
            <div class="enote-filter-feld"><span class="enote-filter-label">Du</span><EnoteDatePicker @bind-Value="filterVon" /></div>
            <div class="enote-filter-feld"><span class="enote-filter-label">Au</span><EnoteDatePicker @bind-Value="filterBis" /></div>
            <button class="enote-btn enote-btn-ghost" @onclick="WendeFilterAsync">Filtrer</button>
            <button class="enote-btn enote-btn-primary" @onclick="ExportierePdf">Exporter en PDF</button>
        </div>

        @if (uebersicht is not null)
        {
            <section class="enote-solde">
                <div class="enote-solde-grid">
                    <div class="enote-solde-hero @(uebersicht.Saldo < 0 ? "negativ" : "positiv")">
                        <span class="enote-solde-hero-label">Solde de caisse</span>
                        <strong class="enote-solde-hero-wert">@FormatEcart(uebersicht.Saldo) F</strong>
                        <span class="enote-solde-hero-meta">Entrées − Dépenses · @ZeitraumLabel</span>
                    </div>
                    <div class="enote-solde-karte enote-solde-ein">
                        <div class="enote-solde-karte-kopf">
                            <span class="enote-solde-ico" aria-hidden="true">↑</span>
                            <span class="enote-solde-label">Entrées</span>
                        </div>
                        <strong class="enote-solde-wert">@uebersicht.EinnahmenGesamt.ToString("N0") F</strong>
                        <div class="enote-solde-zeilen">
                            <div><span>Espèces</span><span>@uebersicht.EinnahmenBar.ToString("N0") F</span></div>
                            <div><span>Carte</span><span>@uebersicht.EinnahmenKarte.ToString("N0") F</span></div>
                            <div><span>Ventes</span><span>@uebersicht.AnzahlVerkaeufe</span></div>
                        </div>
                    </div>
                    <div class="enote-solde-karte enote-solde-aus">
                        <div class="enote-solde-karte-kopf">
                            <span class="enote-solde-ico" aria-hidden="true">↓</span>
                            <span class="enote-solde-label">Dépenses</span>
                        </div>
                        <strong class="enote-solde-wert">@uebersicht.AusgabenGesamt.ToString("N0") F</strong>
                        @if (uebersicht.AusgabenNachKategorie.Count > 0)
                        {
                            <div class="enote-solde-kategorien">
                                @foreach (var k in uebersicht.AusgabenNachKategorie)
                                {
                                    <span class="enote-tag">@k.Name · @k.Betrag.ToString("N0") F</span>
                                }
                            </div>
                        }
                        <a class="enote-solde-link" href="/ausgaben">Voir les dépenses →</a>
                    </div>
                </div>
            </section>
        }

        <div class="enote-tabs">
            <button class="enote-tab @(aktiverTab == "umsatz" ? "aktiv" : "")" @onclick='() => WechsleTab("umsatz")'>Chiffre d'affaires</button>
            <button class="enote-tab @(aktiverTab == "ventes" ? "aktiv" : "")" @onclick='() => WechsleTab("ventes")'>Dernières ventes</button>
            <button class="enote-tab @(aktiverTab == "clotures" ? "aktiv" : "")" @onclick='() => WechsleTab("clotures")'>Clôtures de caisse</button>
        </div>

        @if (aktiverTab == "umsatz")
        {
        <CollapsibleCard Title="@ZeitraumTitel" Subtitle="@($"{tagesUmsaetze.Sum(t => t.Gesamt):N0} F au total")" IsExpanded="true">
            @if (tagesUmsaetze.Count == 0)
            {
                <p class="enote-muted">Aucune vente sur la période.</p>
            }
            else
            {
                <div class="enote-table-scroll"><table class="enote-table">
                    <thead><tr><th>Date</th><th>Ventes</th><th>Espèces</th><th>Carte</th><th>Total</th></tr></thead>
                    <tbody>
                        @foreach (var t in tagesUmsaetze)
                        {
                            <tr>
                                <td>@t.Datum.ToString("dd.MM.yyyy")</td>
                                <td>@t.AnzahlVerkaeufe</td>
                                <td>@t.Bar.ToString("N0") F</td>
                                <td>@t.Karte.ToString("N0") F</td>
                                <td><strong>@t.Gesamt.ToString("N0") F</strong></td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
        </CollapsibleCard>
        }
        else if (aktiverTab == "ventes")
        {
        <CollapsibleCard Title="Dernières ventes" Subtitle="Aperçu en direct" IsExpanded="true">
            @if (letzteVerkaeufe.Count == 0)
            {
                <p class="enote-muted">Aucune vente pour le moment.</p>
            }
            else
            {
                <div class="enote-filter-leiste">
                    <input class="enote-filter-suche" placeholder="Rechercher (article, caissier)…" @bind="verkaufsSuche" @bind:event="oninput" />
                    <EnoteSelect TValue="string" @bind-Value="zahlungsArtFilter" Options="zahlungsArtOptionen" />
                </div>
                @if (!GefilterteVerkaeufe().Any())
                {
                    <p class="enote-empty" role="status">Aucune vente ne correspond à votre recherche ou au mode de paiement sélectionné.</p>
                }
                <div class="enote-feed">
                    @foreach (var v in GefilterteVerkaeufe())
                    {
                        <div class="enote-feed-item">
                            <div class="enote-feed-head">
                                <strong>@v.GesamtSumme.ToString("N0") F</strong>
                                <span class="enote-tag">@(v.ZahlungsArt == ZahlungsArt.Bar ? "Espèces" : "Carte")</span>
                            </div>
                            <div class="enote-feed-meta">@v.PositionenText</div>
                            <div class="enote-feed-meta enote-muted">@v.ZeitUtc.ToLocalTime().ToString("dd.MM HH:mm") · @v.KassiererName</div>
                            <div class="enote-item-actions">
                                <a class="enote-btn enote-btn-ghost enote-btn-sm" href="/bon/@v.VerkaufId" target="_blank">📄 Reçu</a>
                            </div>
                        </div>
                    }
                </div>
            }
        </CollapsibleCard>
        }
        else if (aktiverTab == "clotures")
        {
        <CollapsibleCard Title="Clôtures de caisse" Subtitle="@($"{abschluesse.Count} clôture(s)")" IsExpanded="true">
            @if (abschluesse.Count == 0)
            {
                <p class="enote-muted">Aucune clôture pour le moment.</p>
            }
            else
            {
                <div class="enote-table-scroll"><table class="enote-table">
                    <thead><tr><th>Clôturée le</th><th>Caissier</th><th>Attendu</th><th>Compté</th><th>Écart</th></tr></thead>
                    <tbody>
                        @foreach (var a in abschluesse)
                        {
                            <tr>
                                <td>@a.AbgeschlossenUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@a.Kassierer.FullName</td>
                                <td>@a.BareinnahmenSoll?.ToString("N0") F</td>
                                <td>@a.EndbestandGezaehlt?.ToString("N0") F</td>
                                <td class="@(a.Differenz < 0 ? "enote-danger" : "")">@FormatEcart(a.Differenz) F</td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
        </CollapsibleCard>
        }
    }
</div>
</BesitzerPinGuard>

@code {
    private static string FormatEcart(decimal? differenz)
    {
        var wert = differenz ?? 0m;
        var formatiert = Math.Abs(wert).ToString("N0");
        return wert < 0 ? $"-{formatiert}" : wert > 0 ? $"+{formatiert}" : "0";
    }
}
