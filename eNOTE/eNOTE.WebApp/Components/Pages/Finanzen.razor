@page "/finances"
@attribute [Authorize(Roles = "Besitzer, Kassierer")]
@rendermode InteractiveServer
@using ENote.Core.DataModels.Kasse

<PageTitle>Finances</PageTitle>

<BesitzerPinGuard Recht="finanzen">
<div class="enote-page fi">
    <div class="enote-page-header">
        <div>
            <h1>Finances</h1>
            <p>@salonName · entrées, dépenses, ventes et clôtures de caisse.</p>
        </div>
        @if (darfFinanzenSehen && !isLoading)
        {
            <div class="fi-kopf-aktionen">
                <AuthorizeView Roles="Besitzer" Context="apportCtx">
                    <Authorized>
                        <button class="enote-btn" @onclick="OeffneApport"><Icon Name="plus" Groesse="18" /> Apport / aide</button>
                    </Authorized>
                </AuthorizeView>
                <button class="enote-btn" @onclick="ExportierePdf"><Icon Name="download" Groesse="18" /> Rapport PDF</button>
            </div>
        }
    </div>

    @if (!darfFinanzenSehen)
    {
        <p class="enote-empty">Vous n'avez pas le droit de consulter les finances de cet établissement.</p>
    }
    else if (isLoading)
    {
        <p class="enote-muted" role="status">Chargement…</p>
    }
    else
    {
        <div class="fi-leiste">
            <div class="enote-live-banner fi-live @(liveVerbunden ? "verbunden" : "")">
                <span class="enote-live-dot"></span>
                <div>
                    <div class="enote-live-label">Aujourd'hui @(liveVerbunden ? "· en direct" : "")</div>
                    <div class="enote-live-wert">@liveTagesUmsatz.ToString("N0") F <span class="enote-muted">· @liveAnzahlHeute vente@(liveAnzahlHeute == 1 ? "" : "s")</span></div>
                </div>
            </div>

            <div class="fi-zeitraum">
                <div class="fi-chips" role="group" aria-label="Période">
                    <button class="enote-chip @(aktiverZeitraum == "7" ? "enote-chip-aktiv" : "")" @onclick="() => WaehleZeitraumAsync(7)">7 jours</button>
                    <button class="enote-chip @(aktiverZeitraum == "14" ? "enote-chip-aktiv" : "")" @onclick="() => WaehleZeitraumAsync(14)">14 jours</button>
                    <button class="enote-chip @(aktiverZeitraum == "30" ? "enote-chip-aktiv" : "")" @onclick="() => WaehleZeitraumAsync(30)">30 jours</button>
                    <button class="enote-chip @(aktiverZeitraum == "mois" ? "enote-chip-aktiv" : "")" @onclick="WaehleMonatAsync">Ce mois</button>
                </div>
                <div class="fi-daten">
                    <div class="enote-filter-feld"><span class="enote-filter-label">Du</span><EnoteDatePicker @bind-Value="filterVon" /></div>
                    <div class="enote-filter-feld"><span class="enote-filter-label">Au</span><EnoteDatePicker @bind-Value="filterBis" /></div>
                    <button class="enote-btn" @onclick="WendeEigenenZeitraumAsync"><Icon Name="filter" Groesse="16" /> Appliquer</button>
                </div>
            </div>
        </div>

        @if (uebersicht is not null)
        {
            <section class="fi-kpis" aria-label="Solde de la période">
                <div class="fi-solde @(uebersicht.Saldo < 0 ? "negativ" : "positiv")">
                    <span class="fi-kpi-label">Solde · @ZeitraumLabel</span>
                    <strong>@FormatEcart(uebersicht.Saldo) F</strong>
                    <span class="fi-solde-formel">@(uebersicht.Einlagen > 0 || uebersicht.EntnahmenBar > 0 ? "Ventes + apports − dépenses − retraits" : "Entrées − Dépenses")</span>
                </div>

                <div class="fi-karte">
                    <div class="fi-karte-kopf">
                        <span class="fi-ico fi-ico-ein"><Icon Name="arrow-down" Groesse="16" Strich="2.5" /></span>
                        <span class="fi-kpi-label">Entrées</span>
                        <span class="enote-muted fi-anzahl">@uebersicht.AnzahlVerkaeufe vente@(uebersicht.AnzahlVerkaeufe == 1 ? "" : "s")</span>
                    </div>
                    <strong class="fi-wert">@uebersicht.EinnahmenGesamt.ToString("N0") F</strong>
                    <ZahlungsMix Bar="uebersicht.EinnahmenBar" Karte="uebersicht.EinnahmenKarte" MobileMoney="uebersicht.EinnahmenMobileMoney" />
                    @if (uebersicht.Einlagen > 0)
                    {
                        <div class="fi-zusatz"><Icon Name="plus" Groesse="14" /> Apports / aides : <strong>@uebersicht.Einlagen.ToString("N0") F</strong> <small>(hors ventes)</small></div>
                    }
                    @if (uebersicht.Erstattungen > 0)
                    {
                        <div class="fi-zusatz"><Icon Name="undo" Groesse="14" /> Remboursements : <strong>− @uebersicht.Erstattungen.ToString("N0") F</strong> <small>(déjà déduits des ventes)</small></div>
                    }
                    @if (uebersicht.MobileMoneyNachAnbieter.Count > 0)
                    {
                        <div class="fi-anbieter">
                            @foreach (var a in uebersicht.MobileMoneyNachAnbieter)
                            {
                                <span class="enote-tag enote-tag-momo">@a.Name · @a.Betrag.ToString("N0") F</span>
                            }
                        </div>
                    }
                </div>

                <div class="fi-karte">
                    <div class="fi-karte-kopf">
                        <span class="fi-ico fi-ico-aus"><Icon Name="arrow-up" Groesse="16" Strich="2.5" /></span>
                        <span class="fi-kpi-label">Dépenses</span>
                        <a class="fi-link" href="/ausgaben">Voir <Icon Name="arrow-right" Groesse="14" /></a>
                    </div>
                    <strong class="fi-wert">@uebersicht.AusgabenGesamt.ToString("N0") F</strong>
                    @if (uebersicht.EntnahmenBar > 0)
                    {
                        <div class="fi-zusatz"><Icon Name="wallet" Groesse="14" /> Retraits du propriétaire : <strong>@uebersicht.EntnahmenBar.ToString("N0") F</strong></div>
                    }
                    @if (uebersicht.WarenEntnahmenWert > 0 || uebersicht.AbschreibungenWert > 0)
                    {
                        <div class="fi-zusatz leise"><Icon Name="package" Groesse="14" /> Marchandise sortie sans vente : @((uebersicht.WarenEntnahmenWert + uebersicht.AbschreibungenWert).ToString("N0")) F <small>(prix d'achat, déjà compté à l'achat)</small></div>
                    }
                    @if (uebersicht.AusgabenNachKategorie.Count == 0)
                    {
                        <p class="enote-muted fi-leer">Aucune dépense sur la période.</p>
                    }
                    else
                    {
                        var maxAusgabe = uebersicht.AusgabenNachKategorie.Max(k => k.Betrag);
                        <ul class="fi-ausgaben">
                            @foreach (var k in uebersicht.AusgabenNachKategorie)
                            {
                                <li>
                                    <div class="db-top-zeile"><span class="db-top-name fi-ohne-rang">@k.Name</span><strong>@k.Betrag.ToString("N0") F</strong></div>
                                    <div class="db-top-balken fi-balken-aus"><span style="width: @Prozent(k.Betrag, maxAusgabe)%"></span></div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </section>
        }

        <div class="enote-tabs">
            <button class="enote-tab @(aktiverTab == "umsatz" ? "aktiv" : "")" @onclick='() => WechsleTab("umsatz")'>Par jour</button>
            <button class="enote-tab @(aktiverTab == "ventes" ? "aktiv" : "")" @onclick='() => WechsleTab("ventes")'>Dernières ventes</button>
            <button class="enote-tab @(aktiverTab == "clotures" ? "aktiv" : "")" @onclick='() => WechsleTab("clotures")'>Clôtures de caisse</button>
            <button class="enote-tab @(aktiverTab == "mouvements" ? "aktiv" : "")" @onclick='() => WechsleTab("mouvements")'>Mouvements</button>
        </div>

        @if (aktiverTab == "umsatz")
        {
            <section class="enote-card fi-tabelle">
                @if (tagesUmsaetze.Count == 0)
                {
                    <p class="enote-empty">Aucune vente sur la période.</p>
                }
                else
                {
                    <div class="enote-table-scroll"><table class="enote-table">
                        <thead><tr><th>Date</th><th class="r">Ventes</th><th class="r">Espèces</th><th class="r">Mobile Money</th><th class="r">Carte</th><th class="r">Total</th></tr></thead>
                        <tbody>
                            @foreach (var t in tagesUmsaetze)
                            {
                                <tr>
                                    <td>@t.Datum.ToString("ddd dd.MM", Fr)</td>
                                    <td class="r">@t.AnzahlVerkaeufe</td>
                                    <td class="r">@t.Bar.ToString("N0")</td>
                                    <td class="r">@t.MobileMoney.ToString("N0")</td>
                                    <td class="r">@t.Karte.ToString("N0")</td>
                                    <td class="r"><strong>@t.Gesamt.ToString("N0") F</strong></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td>Total</td>
                                <td class="r">@tagesUmsaetze.Sum(t => t.AnzahlVerkaeufe)</td>
                                <td class="r">@tagesUmsaetze.Sum(t => t.Bar).ToString("N0")</td>
                                <td class="r">@tagesUmsaetze.Sum(t => t.MobileMoney).ToString("N0")</td>
                                <td class="r">@tagesUmsaetze.Sum(t => t.Karte).ToString("N0")</td>
                                <td class="r">@tagesUmsaetze.Sum(t => t.Gesamt).ToString("N0") F</td>
                            </tr>
                        </tfoot>
                    </table></div>
                }
            </section>
        }
        else if (aktiverTab == "ventes")
        {
            <section class="fi-ventes">
                <div class="enote-filter-leiste">
                    <input class="enote-filter-suche" placeholder="Rechercher (article, employé)…" @bind="verkaufsSuche" @bind:event="oninput" @bind:after="SucheVerkaeufeVerzoegertAsync" />
                    <EnoteSelect TValue="string" @bind-Value="zahlungsArtFilter" @bind-Value:after="LadeVerkaeufeAsync" Options="zahlungsArtOptionen" />
                </div>
                @if (!GefilterteVerkaeufe().Any())
                {
                    <p class="enote-empty" role="status">Aucune vente ne correspond à votre recherche.</p>
                }
                <div class="enote-feed enote-liste-scroll">
                    @foreach (var v in GefilterteVerkaeufe())
                    {
                        <div class="enote-feed-item fi-verkauf @(v.IstStorno ? "storno" : "")">
                            <div class="fi-verkauf-info">
                                <div class="enote-feed-head">
                                    <strong>@(v.IstStorno ? "− " + (-v.GesamtSumme).ToString("N0") : v.GesamtSumme.ToString("N0")) F</strong>
                                    @if (v.IstStorno)
                                    {
                                        <span class="kx-storno-tag"><Icon Name="undo" Groesse="13" /> Remboursement</span>
                                    }
                                    else
                                    {
                                        <ZahlungsTag Anteile="v.Zahlungen" />
                                        @if (v.VollErstattet)
                                        {
                                            <span class="kx-storno-tag">Remboursée</span>
                                        }
                                        else if (v.Erstattet > 0)
                                        {
                                            <span class="kx-storno-tag">− @v.Erstattet.ToString("N0") F remboursé</span>
                                        }
                                    }
                                </div>
                                <div class="enote-feed-meta">@v.PositionenText</div>
                                <div class="enote-feed-meta enote-muted">@v.ZeitUtc.ImLaden(aktiverSalon.Zeitzone).ToString("dd.MM · HH:mm") · @v.KassiererName@(v.IstStorno && !string.IsNullOrWhiteSpace(v.StornoGrund) ? " · " + v.StornoGrund : "")</div>
                            </div>
                            <a class="enote-btn enote-btn-sm" href="/bon/@v.VerkaufId" target="_blank"><Icon Name="receipt" Groesse="16" /> Reçu</a>
                        </div>
                    }
                    @if (verkaeufeMehr)
                    {
                        <AsyncActionButton CssClass="enote-btn-ghost enote-mehr" BusyText="Chargement…" OnClick="MehrVerkaeufeAsync">Afficher plus</AsyncActionButton>
                    }
                </div>
            </section>
        }
        else if (aktiverTab == "mouvements")
        {
            <section class="enote-card fi-tabelle">
                @if (bewegungen is null || (bewegungen.Geld.Count == 0 && bewegungen.Lager.Count == 0))
                {
                    <p class="enote-empty">Aucun apport, retrait ou perte de stock sur la période.</p>
                }
                else
                {
                    <div class="fi-bewegungen enote-liste-scroll">
                        @foreach (var g in bewegungen.Geld)
                        {
                            var einlage = g.Art == ENote.Core.DataModels.Finanzen.GeldBewegungArt.Einlage;
                            <div class="fi-bewegung">
                                <span class="fi-ico @(einlage ? "fi-ico-ein" : "fi-ico-aus")"><Icon Name="@(einlage ? "arrow-down" : "wallet")" Groesse="15" Strich="2.3" /></span>
                                <div class="fi-bewegung-text">
                                    <strong>@(einlage ? $"Apport · {g.Herkunft}" : "Retrait d'espèces du propriétaire")</strong>
                                    <small class="enote-muted">@g.ZeitUtc.ImLaden(aktiverSalon.Zeitzone).ToString("dd.MM.yyyy HH:mm") · @(g.Ort == ENote.Core.DataModels.Finanzen.GeldOrt.Kasse ? "en caisse" : "hors caisse")@(string.IsNullOrWhiteSpace(g.Notiz) ? "" : $" · {g.Notiz}")</small>
                                </div>
                                <strong class="fi-bewegung-betrag @(einlage ? "plus" : "minus")">@(einlage ? "+" : "−")@g.Betrag.ToString("N0") F</strong>
                            </div>
                        }
                        @foreach (var l in bewegungen.Lager)
                        {
                            var entnahme = l.Art == ENote.Core.DataModels.Katalog.LagerAbgangArt.Eigenentnahme;
                            <div class="fi-bewegung">
                                <span class="fi-ico fi-ico-lager"><Icon Name="@(entnahme ? "package" : "alert")" Groesse="15" Strich="2.3" /></span>
                                <div class="fi-bewegung-text">
                                    <strong>@l.Menge.ToString("0.##") × @l.LeistungName · @(entnahme ? "retrait du propriétaire" : ENote.WebApp.Services.BestandsService.GrundText(l.Grund ?? ENote.Core.DataModels.Katalog.AbschreibungsGrund.Autre).ToLowerInvariant())</strong>
                                    <small class="enote-muted">@l.ZeitUtc.ImLaden(aktiverSalon.Zeitzone).ToString("dd.MM.yyyy HH:mm") · @l.ErfasstVonName@(string.IsNullOrWhiteSpace(l.Notiz) ? "" : $" · {l.Notiz}")</small>
                                </div>
                                <span class="fi-bewegung-betrag leise">@(l.Einkaufswert is decimal w ? w.ToString("N0") + " F (achat)" : "valeur inconnue")</span>
                            </div>
                        }
                    </div>
                }
            </section>
        }
        else if (aktiverTab == "clotures")
        {
            <section class="enote-card fi-tabelle">
                @if (abschluesse.Count == 0)
                {
                    <p class="enote-empty">Aucune clôture pour le moment.</p>
                }
                else
                {
                    <div class="enote-table-scroll"><table class="enote-table">
                        <thead><tr><th>Clôturée le</th><th>Employé</th><th class="r">Attendu</th><th class="r">Compté</th><th class="r">Écart</th></tr></thead>
                        <tbody>
                            @foreach (var a in abschluesse)
                            {
                                <tr>
                                    <td>@a.AbgeschlossenUtc?.ImLaden(aktiverSalon.Zeitzone).ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@a.Kassierer.FullName</td>
                                    <td class="r">@a.BareinnahmenSoll?.ToString("N0") F</td>
                                    <td class="r">@a.EndbestandGezaehlt?.ToString("N0") F</td>
                                    <td class="r"><span class="enote-tag @(a.Differenz < 0 ? "enote-tag-warn" : a.Differenz > 0 ? "" : "enote-tag-ok")">@FormatEcart(a.Differenz) F</span></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
            </section>
        }
    }
</div>
<ModalDialog Open="apportOffen" Title="Apport / aide financière" ErrorMessage="@apportFehler" OnClose="() => apportOffen = false" MaxWidthClass="enote-modal-md">
    <ChildContent>
        <div class="kx-pay">
            <p class="enote-muted kx-frei-text">Argent reçu pour l'établissement (aide, prêt, apport personnel). Il augmente le solde mais n'est jamais compté comme vente.</p>
            <BetragEingabe @bind-Wert="apportBetrag" Label="Montant" Kompakt="true" MitZiffernblock="false" />
            <label class="kx-pay-ref">
                <span>Provenance</span>
                <input class="enote-input" @bind="apportHerkunft" maxlength="120" placeholder="ex. aide familiale" />
            </label>
            <div class="enote-betrag-schnell">
                @foreach (var h in HerkunftVorschlaege)
                {
                    <button type="button" class="enote-chip @(apportHerkunft == h ? "enote-chip-aktiv" : "")" @onclick="() => apportHerkunft = h">@h</button>
                }
            </div>
            <span class="enote-betrag-label">Où arrive l'argent ?</span>
            <div class="kx-pay-modi" role="tablist">
                <button type="button" role="tab" class="kx-pay-modus @(apportOrt == ENote.Core.DataModels.Finanzen.GeldOrt.AusserhalbKasse ? "aktiv" : "")" @onclick="() => apportOrt = ENote.Core.DataModels.Finanzen.GeldOrt.AusserhalbKasse"><Icon Name="momo" Groesse="18" /> Hors caisse (banque, Mobile Money)</button>
                <button type="button" role="tab" class="kx-pay-modus @(apportOrt == ENote.Core.DataModels.Finanzen.GeldOrt.Kasse ? "aktiv" : "")" disabled="@(offeneKasseVon is null)"
                        title="@(offeneKasseVon is null ? "Ouvrez d'abord la caisse" : null)" @onclick="() => apportOrt = ENote.Core.DataModels.Finanzen.GeldOrt.Kasse"><Icon Name="caisse" Groesse="18" /> Dans la caisse</button>
            </div>
            @if (offeneKasseVon is null)
            {
                <p class="kx-pay-hinweis"><Icon Name="info" Groesse="16" /> « Dans la caisse » est possible seulement quand la caisse est ouverte (l'argent est alors compté à la clôture).</p>
            }
            @if (apportOrt == ENote.Core.DataModels.Finanzen.GeldOrt.Kasse)
            {
                <p class="kx-pay-hinweis"><Icon Name="info" Groesse="16" /> Ajouté aux espèces attendues de la caisse ouverte (@offeneKasseVon) – à compter à la clôture.</p>
            }
            else
            {
                <div class="enote-filter-feld"><span class="enote-filter-label">Date de réception</span><EnoteDatePicker @bind-Value="apportDatum" /></div>
            }
            <label class="kx-pay-ref">
                <span>Note <small class="enote-muted">(facultatif)</small></span>
                <input class="enote-input" @bind="apportNotiz" maxlength="500" placeholder="ex. remboursement prévu en mars" />
            </label>
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => apportOffen = false">Annuler</button>
        <AsyncActionButton Text="Enregistrer l'apport" OnClick="SpeichereApportAsync" CssClass="enote-btn-primary" Disabled="@(apportBetrag <= 0)" />
    </Footer>
</ModalDialog>
</BesitzerPinGuard>

@code {
    private static readonly System.Globalization.CultureInfo Fr = new("fr-FR");

    private static string FormatEcart(decimal? differenz)
    {
        var wert = differenz ?? 0m;
        var formatiert = Math.Abs(wert).ToString("N0");
        return wert < 0 ? $"-{formatiert}" : wert > 0 ? $"+{formatiert}" : "0";
    }

    private static string Prozent(decimal wert, decimal max)
        => (max <= 0 ? 0 : Math.Round(wert / max * 100, 1)).ToString(System.Globalization.CultureInfo.InvariantCulture);
}
