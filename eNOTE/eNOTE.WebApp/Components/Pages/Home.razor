@page "/"
@rendermode InteractiveServer
@using ENote.WebApp.Services

<AuthorizeView>
    <Authorized>
        <PageTitle>eNOTE</PageTitle>
        <div class="db">
            <header class="db-kopf">
                <div>
                    <p class="db-datum">@DateTime.UtcNow.ImLaden(aktiverSalon.Zeitzone).ToString("dddd d MMMM", Francais)</p>
                    <h1>Bonjour@(string.IsNullOrWhiteSpace(vorname) ? "" : $", {vorname}") <span aria-hidden="true">👋</span></h1>
                    @if (!string.IsNullOrWhiteSpace(ladenName))
                    {
                        <p class="enote-muted">@ladenName</p>
                    }
                </div>
                <AuthorizeView Roles="Besitzer" Context="kasseCtx">
                    <Authorized>
                        @if (!wartetAufFreigabe)
                        {
                            <a class="enote-btn enote-btn-primary enote-btn-lg db-kasse-btn" href="/caisse"><Icon Name="caisse" /> @(daten?.Kasse is null ? "Ouvrir la caisse" : "Aller à la caisse")</a>
                        }
                    </Authorized>
                </AuthorizeView>
            </header>

            @if (wartetAufFreigabe)
            {
                <div class="db-hinweis-karte">
                    <span class="db-hinweis-ico"><Icon Name="clock" Groesse="24" /></span>
                    <div>
                        <h2>Votre établissement est en cours de validation</h2>
                        <p>« @salonNameWartend » sera activé dès que l'administrateur l'aura validé. Vous pourrez alors utiliser la caisse et la gestion.</p>
                    </div>
                </div>
            }
            else
            {
                <AuthorizeView Roles="SuperAdmin, ProduktOwner" Context="adminCtx">
                    <Authorized>
                        <div class="db-schnell">
                            @* Nutzer 19.11.2026: Karte « Mes établissements » auf der Startseite des Responsables. *@
                            <AuthorizeView Roles="ProduktOwner" Context="poKarteCtx">
                                <Authorized>
                                    <a class="db-schnell-karte" href="/mes-etablissements"><span><Icon Name="store" /></span><strong>Mes établissements</strong><small>Vos établissements, validations, commissions</small></a>
                                </Authorized>
                            </AuthorizeView>
                            <a class="db-schnell-karte" href="/admin"><span><Icon Name="shield" /></span><strong>Administration</strong><small>Établissements, validations, comptes</small></a>
                            <a class="db-schnell-karte" href="/admin/facturation"><span><Icon Name="receipt" /></span><strong>Facturation</strong><small>Abonnements et paiements</small></a>
                            <FormationKarte />
                        </div>
                    </Authorized>
                </AuthorizeView>

                @if (ungeleseneHinweise.Count > 0)
                {
                    <section class="db-meldungen" aria-label="Notifications">
                        <div class="db-meldungen-kopf">
                            <strong><Icon Name="bell" Groesse="18" /> @ungeleseneHinweise.Count notification@(ungeleseneHinweise.Count > 1 ? "s" : "")</strong>
                            <AsyncActionButton CssClass="enote-btn-sm" Text="Tout marquer comme lu" OnClick="MarkiereAlleGelesenAsync" />
                        </div>
                        <div class="enote-liste-scroll db-meldungen-liste">
                        @foreach (var h in ungeleseneHinweise)
                        {
                            <div class="db-meldung">
                                <span class="db-meldung-text">@h.Text</span>
                                <small class="enote-muted">@h.CreatedAtUtc.ImLaden(aktiverSalon.Zeitzone).ToString("dd.MM · HH:mm") · @h.AusgeloestVonName</small>
                                <AsyncActionButton BasisKlasse="db-meldung-ok" title="Marquer comme lu" aria-label="Marquer comme lu" OnClick="() => MarkiereGelesenAsync(h.Id)"><Icon Name="check" Groesse="16" /></AsyncActionButton>
                            </div>
                        }
                        </div>
                    </section>
                }

                @if (darfZahlenSehen)
                {
                    <BesitzerPinGuard>
                        @if (daten is { } d)
                        {
                            <section class="db-kpis" aria-label="Chiffres du jour">
                                <div class="db-kpi db-kpi-haupt">
                                    <span class="db-kpi-label">Chiffre d'affaires aujourd'hui</span>
                                    <strong class="enote-kpi-wert">@d.UmsatzHeute.ToString("N0") F</strong>
                                    @if (d.VerkaeufeHeute > 0 && d.VeraenderungProzent is decimal p)
                                    {
                                        <span class="db-trend @(p >= 0 ? "hoch" : "runter")">
                                            <Icon Name="@(p >= 0 ? "arrow-up" : "arrow-down")" Groesse="14" Strich="2.5" />
                                            @Math.Abs(p)% <span>vs moyenne (@d.DurchschnittTag.ToString("N0") F)</span>
                                        </span>
                                    }
                                    else if (d.DurchschnittTag > 0)
                                    {
                                        <span class="db-trend"><span>Moyenne : @d.DurchschnittTag.ToString("N0") F / jour</span></span>
                                    }
                                </div>
                                <div class="db-kpi">
                                    <span class="db-kpi-label">Ventes</span>
                                    <strong class="enote-kpi-wert">@d.VerkaeufeHeute</strong>
                                    <span class="db-kpi-unter">aujourd'hui</span>
                                </div>
                                <div class="db-kpi">
                                    <span class="db-kpi-label">Panier moyen</span>
                                    <strong class="enote-kpi-wert">@d.PanierMoyen.ToString("N0") F</strong>
                                    <span class="db-kpi-unter">par vente</span>
                                </div>
                                <div class="db-kpi @(d.Kasse is null ? "" : "db-kpi-offen")">
                                    <span class="db-kpi-label">Caisse</span>
                                    @if (d.Kasse is { } k)
                                    {
                                        <strong class="enote-kpi-wert">@k.BarSoll.ToString("N0") F</strong>
                                        <span class="db-kpi-unter"><span class="kx-live-punkt"></span> Ouverte · @k.Kassierer</span>
                                    }
                                    else
                                    {
                                        <strong class="enote-kpi-wert db-kpi-leise">Fermée</strong>
                                        <span class="db-kpi-unter">Aucune session en cours</span>
                                    }
                                </div>
                            </section>

                            <div class="db-raster">
                                <section class="db-karte db-verlauf">
                                    <div class="db-karte-kopf">
                                        <div>
                                            <h2>Chiffre d'affaires</h2>
                                            <p>@DashboardService.VerlaufTage derniers jours · @d.Verlauf.Sum(t => t.Umsatz).ToString("N0") F</p>
                                        </div>
                                        <a class="enote-btn enote-btn-sm" href="/finances">Détails <Icon Name="arrow-right" Groesse="16" /></a>
                                    </div>
                                    <SaeulenDiagramm Werte="d.Verlauf" />
                                </section>

                                <section class="db-karte">
                                    <div class="db-karte-kopf">
                                        <div>
                                            <h2>Modes de paiement</h2>
                                            <p>@DashboardService.AuswertungTage derniers jours</p>
                                        </div>
                                    </div>
                                    <ZahlungsMix Bar="d.Bar" Karte="d.Karte" MobileMoney="d.MobileMoney" />
                                </section>

                                <section class="db-karte">
                                    <div class="db-karte-kopf">
                                        <div>
                                            <h2>Meilleures ventes</h2>
                                            <p>@DashboardService.AuswertungTage derniers jours</p>
                                        </div>
                                    </div>
                                    @if (d.Bestseller.Count == 0)
                                    {
                                        <p class="enote-empty">Pas encore de ventes.</p>
                                    }
                                    else
                                    {
                                        var max = d.Bestseller.Max(b => b.Umsatz);
                                        <ol class="db-top">
                                            @foreach (var b in d.Bestseller)
                                            {
                                                <li>
                                                    <div class="db-top-zeile">
                                                        <span class="db-top-name">@b.Name</span>
                                                        <strong>@b.Umsatz.ToString("N0") F</strong>
                                                    </div>
                                                    <div class="db-top-balken"><span style="width: @Prozent(b.Umsatz, max)%"></span></div>
                                                    <small class="enote-muted">@b.Menge vendu@(b.Menge > 1 ? "s" : "")</small>
                                                </li>
                                            }
                                        </ol>
                                    }
                                </section>

                                <section class="db-karte">
                                    <div class="db-karte-kopf">
                                        <div>
                                            <h2>Stock à surveiller</h2>
                                            <p>Articles sous le seuil d'alerte</p>
                                        </div>
                                        <a class="enote-btn enote-btn-sm" href="/services">Gérer</a>
                                    </div>
                                    @if (d.Lager.Count == 0)
                                    {
                                        <div class="db-alles-gut"><Icon Name="check" Groesse="18" /> Tous les stocks sont suffisants.</div>
                                    }
                                    else
                                    {
                                        <ul class="db-lager">
                                            @foreach (var l in d.Lager)
                                            {
                                                <li>
                                                    <span class="db-lager-ico"><Icon Name="alert" Groesse="16" /></span>
                                                    <span class="db-lager-name">@l.Name</span>
                                                    <span class="enote-tag enote-tag-warn">@l.Bestand.ToString("0.##") / min. @l.Mindestbestand.ToString("0.##")</span>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </section>
                            </div>
                        }
                        else if (datenLaedt)
                        {
                            <div class="db-kpis db-skelett" aria-hidden="true"><div></div><div></div><div></div><div></div></div>
                        }
                    </BesitzerPinGuard>
                }
                else
                {
                    @* 17.11.2026 « Connexion personnelle »: Mit eigenem Mitarbeiter-Konto keine Kasse – nur die gewährten Bereiche. *@
                    <AuthorizeView Roles="Kassierer" Context="kCtx">
                        <Authorized>
                            <div class="db-hinweis-karte">
                                <span class="db-hinweis-ico"><Icon Name="user" Groesse="24" /></span>
                                <div>
                                    <h2>Votre compte personnel</h2>
                                    <p>Vous gérez ici les zones que le propriétaire vous a accordées (menu à gauche). Pour encaisser, utilisez l'appareil de l'établissement, connecté par le propriétaire, avec votre nom et votre code PIN.</p>
                                </div>
                            </div>
                        </Authorized>
                    </AuthorizeView>
                }
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <Startseite />
    </NotAuthorized>
</AuthorizeView>
