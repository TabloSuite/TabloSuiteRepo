@page "/aide/videos"
@attribute [Authorize]
@using ENote.WebApp.Services
@inject AuthenticationStateProvider authStateProvider
@inject IWebHostEnvironment umgebung
@inject IJSRuntime JS

<PageTitle>Vidéos d'aide</PageTitle>

<div class="enote-page">
    <div class="enote-page-header">
        <div>
            <h1>Vidéos d'aide</h1>
            <p>Des vidéos pas à pas, une situation à la fois. Commencez par « Premiers pas », puis celles de votre rôle.</p>
        </div>
    </div>

    @if (gruppen.Count == 0)
    {
        <div class="enote-card vh-leer"><Icon Name="monitor" Groesse="28" /><p>Aucune vidéo pour votre rôle pour le moment.</p></div>
    }
    else
    {
        @foreach (var g in gruppen)
        {
            var istPourquoi = g.Fuer == VideoKatalog.Alle_;
            // Große Einzelkarte nur, wenn « Pour tous » genau ein Video hat; sonst normales Raster wie bei den Rollen
            var gross = istPourquoi && g.Videos.Count == 1;
            var bereich = Bereich(g.Fuer);
            @* Jeder Nutzerbereich ist ein eigenes, farbig markiertes Feld – man sieht sofort, wo ein Bereich endet. *@
            <section class="vh-gruppe vh-rolle-@bereich.Klasse @(gross ? "vh-gruppe-pourquoi" : "")" aria-labelledby="vh-@Slug(g.Fuer)">
                <div class="vh-gruppe-kopf">
                    <span class="vh-gruppe-symbol" aria-hidden="true"><Icon Name="@bereich.Icon" Groesse="22" /></span>
                    <div class="vh-gruppe-titel">
                        <h2 id="vh-@Slug(g.Fuer)">
                            @g.Titel
                            @if (g.Fuer == eigene)
                            {
                                <span class="vh-eigene">Votre rôle</span>
                            }
                        </h2>
                        <p>@g.Untertitel</p>
                    </div>
                    <span class="vh-gruppe-zahl">@(g.Videos.Count == 1 ? "1 vidéo" : $"{g.Videos.Count} vidéos") · @Gesamt(g.Videos)</span>
                </div>
                <div class="vh-raster">
                    @for (var i = 0; i < g.Videos.Count; i++)
                    {
                        var v = g.Videos[i];
                        var nr = i + 1;
                        var vorhanden = Vorhanden(v);
                        <article class="enote-card vh-karte @(vorhanden ? "" : "bald")">
                            <button type="button" class="vh-bild" disabled="@(!vorhanden)" aria-label="Regarder : @v.Titel" @onclick="() => OeffnenAsync(v)">
                                @if (PosterVorhanden(v))
                                {
                                    <img src="@PosterUrl(v)" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <span class="vh-bild-leer"><Icon Name="monitor" Groesse="34" /></span>
                                }
                                @if (vorhanden)
                                {
                                    <span class="vh-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg></span>
                                }
                                <span class="vh-dauer">@v.Dauer</span>
                            </button>
                            <div class="vh-text">
                                <span class="vh-fuer">@(gross ? "Pour tous" : $"{v.Fuer} · {nr}/{g.Videos.Count}")</span>
                                <h3>@v.Titel</h3>
                                <p>@v.Beschreibung</p>
                                @if (!vorhanden)
                                {
                                    <span class="vh-bald">Bientôt disponible</span>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    }
</div>

@if (offen is { } aktiv)
{
    @* Schließen nur über den Knopf – ein Fehlklick neben das Video beendet es nicht. *@
    <div class="lp-video-overlay">
        <div class="lp-video-box" @onclick:stopPropagation="true">
            <button type="button" class="enote-icon-btn lp-video-zu" aria-label="Fermer" @onclick="SchliessenAsync"><Icon Name="x" Groesse="20" /></button>
            <video src="@VideoUrl(aktiv)" poster="@(PosterVorhanden(aktiv) ? PosterUrl(aktiv) : null)" controls autoplay playsinline></video>
        </div>
    </div>
}

@code {
    private IReadOnlyList<VideoKatalog.Gruppe> gruppen = [];
    private VideoKatalog.LernVideo? offen;
    private string eigene = "";

    /// <summary>Farbe (CSS-Klasse) und Symbol je Nutzerbereich.</summary>
    private static (string Klasse, string Icon) Bereich(string fuer) => fuer switch
    {
        VideoKatalog.Alle_ => ("tous", "sparkles"),
        "Employé" => ("employe", "caisse"),
        "Propriétaire" => ("proprietaire", "store"),
        "Responsable" => ("responsable", "users"),
        _ => ("admin", "shield")
    };

    protected override async Task OnInitializedAsync()
    {
        var user = (await authStateProvider.GetAuthenticationStateAsync()).User;
        gruppen = VideoKatalog.FuerNutzer(user);
        eigene = VideoKatalog.EigeneGruppe(user);
    }

    /// <summary>
    /// Vor dem Öffnen die Position der Seite merken, nach dem Schließen wiederherstellen: am Handy dreht das Vollbild ins
    /// Querformat, die Seite ordnet sich um und stünde sonst ganz oben statt beim angesehenen Video.
    /// </summary>
    private async Task OeffnenAsync(VideoKatalog.LernVideo v)
    {
        try { await JS.InvokeVoidAsync("enoteVideoPosition.merken"); } catch (JSException) { }
        offen = v;
    }

    private async Task SchliessenAsync()
    {
        offen = null;
        StateHasChanged();
        try { await JS.InvokeVoidAsync("enoteVideoPosition.zurueck"); } catch (JSException) { }
    }

    private static string Slug(string text) => new string(text.ToLowerInvariant().Where(char.IsLetterOrDigit).ToArray());

    /// <summary>Gesamtdauer einer Reihe („4 min“).</summary>
    private static string Gesamt(IEnumerable<VideoKatalog.LernVideo> videos)
    {
        var sekunden = videos.Sum(v => v.Dauer.Split(':') is [var m, var s] && int.TryParse(m, out var mi) && int.TryParse(s, out var se) ? mi * 60 + se : 0);
        return $"{Math.Max(1, (int)Math.Round(sekunden / 60.0))} min";
    }

    private bool Vorhanden(VideoKatalog.LernVideo v)
        => File.Exists(Path.Combine(umgebung.ContentRootPath, "Medien", "videos", v.Datei));

    private string VideoUrl(VideoKatalog.LernVideo v)
        => VideoKatalog.MitVersion(v.Url, Path.Combine(umgebung.ContentRootPath, "Medien", "videos", v.Datei));

    // Pfad über den File-Provider: WebRootPath kann leer sein (z. B. Start aus einem Build-Ordner mit Static-Web-Assets-Manifest).
    private string PosterUrl(VideoKatalog.LernVideo v)
        => VideoKatalog.MitVersion(v.Poster, umgebung.WebRootFileProvider.GetFileInfo(v.Poster).PhysicalPath);

    private bool PosterVorhanden(VideoKatalog.LernVideo v)
        => umgebung.WebRootFileProvider.GetFileInfo(v.Poster).Exists;
}
