@page "/profil"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Mon profil</PageTitle>

<div class="enote-page">
    <div class="enote-page-header">
        <div>
            <h1>Mon profil</h1>
            <p>Vos informations personnelles, votre photo, votre adresse e-mail et votre mot de passe.</p>
        </div>
    </div>

    @if (isLoading)
    {
        <p class="enote-muted" role="status">Chargement…</p>
    }
    else
    {
        <div class="pf-grid">
            <section class="enote-card pf-identitaet">
                <div class="pf-foto">
                    @if (!string.IsNullOrWhiteSpace(profilBildUrl))
                    {
                        <img src="@profilBildUrl" alt="Photo de profil" />
                    }
                    else
                    {
                        <div class="pf-initialen">@Initialen</div>
                    }
                    <label class="pf-foto-btn" title="Changer la photo" aria-label="Changer la photo">
                        <InputFile OnChange="LadeProfilBildHochAsync" accept="image/*" class="enote-hidden-input" />
                        <Icon Name="camera" Groesse="18" />
                    </label>
                </div>

                <h2 class="pf-name">@fullName</h2>
                <div class="pf-meta">
                    @if (!string.IsNullOrWhiteSpace(pseudonym))
                    {
                        <span>Identifiant : <strong>@pseudonym</strong></span>
                    }
                    <span>@email</span>
                </div>
                <div class="pf-rollen">
                    @if (rollen.Count == 0)
                    {
                        <span class="enote-muted" role="status">Aucun rôle attribué à ce compte.</span>
                    }
                    @foreach (var rolle in rollen)
                    {
                        <span class="enote-tag">@RolleText(rolle)</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(bildFehler))
                {
                    <div class="alert alert-error" role="alert">@bildFehler</div>
                }
                @if (bildErfolg)
                {
                    <div class="alert alert-success" role="status">Photo mise à jour.</div>
                }
                <div class="pf-foto-aktionen">
                    <label class="enote-btn enote-btn-ghost enote-btn-sm">
                        <InputFile OnChange="LadeProfilBildHochAsync" accept="image/*" class="enote-hidden-input" />
                        <Icon Name="image" Groesse="16" /> @(string.IsNullOrWhiteSpace(profilBildUrl) ? "Ajouter une photo" : "Changer la photo")
                    </label>
                    @if (!string.IsNullOrWhiteSpace(profilBildUrl))
                    {
                        <AsyncActionButton CssClass="enote-btn-ghost enote-btn-sm" BusyText="Suppression…" OnClick="EntferneProfilBildAsync"><Icon Name="trash" Groesse="16" /> Retirer</AsyncActionButton>
                    }
                </div>
                <small class="enote-muted">JPG, PNG ou GIF · 8 Mo max.</small>

                @if (laeden.Count > 0)
                {
                    <div class="pf-laeden">
                        <h3>Établissement@(laeden.Count > 1 ? "s" : "")</h3>
                        @foreach (var l in laeden)
                        {
                            <div class="pf-laden"><Icon Name="store" Groesse="16" /> @l</div>
                        }
                    </div>
                }
            </section>

            <div class="pf-spalte">
            @if (profil is not null)
            {
                <section class="enote-card pf-karte" aria-labelledby="pf-daten-titel">
                    <h2 id="pf-daten-titel"><Icon Name="user" Groesse="20" /> Informations personnelles</h2>
                    <p class="enote-muted">Votre nom apparaît dans l'équipe, sur les reçus et dans les messages d'eNOTE.</p>
                    <div class="enote-form">
                        <div class="pf-zwei">
                            <label><span class="enote-pflicht">Prénom</span> <input @bind="vorname" @bind:event="oninput" autocomplete="given-name" maxlength="60" /></label>
                            <label><span class="enote-pflicht">Nom</span> <input @bind="nachname" @bind:event="oninput" autocomplete="family-name" maxlength="60" /></label>
                        </div>
                        <label>
                            <span>Téléphone <span class="enote-muted pf-optional">(facultatif)</span></span>
                            <input @bind="telefon" @bind:event="oninput" type="tel" inputmode="tel" autocomplete="tel" maxlength="30" placeholder="+228 90 00 00 00" />
                        </label>
                        @if (rollen.Contains(ENote.Core.DataModels.Identity.AppRollen.ProduktOwner))
                        {
                            <small class="enote-muted">Votre téléphone et votre e-mail sont visibles par les propriétaires que vous accompagnez (« Aide &amp; contact »). Indiquez le numéro avec l'indicatif (+228…) pour WhatsApp.</small>
                        }
                        @if (!string.IsNullOrWhiteSpace(datenFehler))
                        {
                            <div class="alert alert-error" role="alert">@datenFehler</div>
                        }
                        <div><AsyncActionButton Text="Enregistrer" OnClick="SpeichereDatenAsync" CssClass="enote-btn-primary" Disabled="@(!DatenGeaendert || !DatenVollstaendig)" /></div>
                    </div>
                </section>

                <section class="enote-card pf-karte" aria-labelledby="pf-zugang-titel">
                    <h2 id="pf-zugang-titel"><Icon Name="mail" Groesse="20" /> Adresse e-mail et identifiant</h2>
                    <p class="enote-muted">Le mot de passe actuel est demandé pour chaque modification.</p>
                    <div class="pf-zugang">
                        <div class="pf-zugang-zeile">
                            <div>
                                <span class="pf-zugang-label">Adresse e-mail</span>
                                <span class="pf-zugang-wert">@(string.IsNullOrWhiteSpace(email) ? "—" : email)</span>
                                <small class="enote-muted">Factures, informations et « Mot de passe oublié ».</small>
                            </div>
                            <button type="button" class="enote-btn enote-btn-ghost enote-btn-sm" @onclick="OeffneEmailDialog"><Icon Name="edit" Groesse="16" /> Modifier</button>
                        </div>
                        <div class="pf-zugang-zeile">
                            <div>
                                <span class="pf-zugang-label">Identifiant de connexion</span>
                                <span class="pf-zugang-wert">@pseudonym</span>
                                <small class="enote-muted">Utilisé pour vous connecter.</small>
                            </div>
                            <button type="button" class="enote-btn enote-btn-ghost enote-btn-sm" @onclick="OeffnePseudonymDialog"><Icon Name="edit" Groesse="16" /> Modifier</button>
                        </div>
                    </div>
                </section>
            }

            <section class="enote-card pf-karte">
                <h2><Icon Name="lock" Groesse="20" /> Mot de passe</h2>
                <p class="enote-muted">Après la modification, vous serez déconnecté et devrez vous reconnecter.</p>

                @if (!string.IsNullOrWhiteSpace(pwFehler))
                {
                    <div class="alert alert-error" role="alert">@pwFehler</div>
                }
                @if (pwGeaendert)
                {
                    <div class="alert alert-success" role="status">Mot de passe modifié. Reconnectez-vous.</div>
                }

                <EditForm Model="this" OnValidSubmit="AenderePasswortAsync" FormName="pw-form" class="enote-form">
                    <label>
                        <span class="enote-pflicht">Mot de passe actuel</span>
                        <PasswordInput @bind-Value="aktuellesPasswort" Required="true" Autocomplete="current-password" />
                    </label>
                    <label>
                        <span class="enote-pflicht">Nouveau mot de passe</span>
                        <PasswordInput @bind-Value="neuesPasswort" Required="true" Autocomplete="new-password" />
                        <small class="enote-muted">Au moins 6 caractères, dont 1 chiffre et 1 lettre minuscule.</small>
                    </label>
                    <div><AsyncActionButton Text="Changer le mot de passe" OnClick="AenderePasswortAsync" CssClass="enote-btn-primary" Disabled="@(!PasswortVollstaendig)" /></div>
                </EditForm>
            </section>
            </div>
        </div>
    }
</div>

<ModalDialog Open="emailDialogOffen" Title="Changer l'adresse e-mail" ErrorMessage="@emailFehler" OnClose="() => emailDialogOffen = false">
    <ChildContent>
        <div class="enote-form">
            <label><span class="enote-pflicht">Nouvelle adresse e-mail</span> <input @bind="neueEmail" @bind:event="oninput" type="email" autocomplete="email" maxlength="256" /></label>
            <label>
                <span class="enote-pflicht">Mot de passe actuel</span>
                <PasswordInput @bind-Value="emailPasswort" Required="true" Autocomplete="current-password" />
            </label>
            <p class="enote-muted pf-hinweis"><Icon Name="info" Groesse="16" /> Un message de sécurité est envoyé à l'ancienne adresse.</p>
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => emailDialogOffen = false">Annuler</button>
        <AsyncActionButton Text="Enregistrer" OnClick="AendereEmailAsync" CssClass="enote-btn-primary" Disabled="@(!EmailVollstaendig)" />
    </Footer>
</ModalDialog>

<ModalDialog Open="pseudonymDialogOffen" Title="Changer l'identifiant" ErrorMessage="@pseudonymFehler" OnClose="() => pseudonymDialogOffen = false">
    <ChildContent>
        <div class="enote-form">
            <label>
                <span class="enote-pflicht">Nouvel identifiant</span>
                <input @bind="neuesPseudonym" @bind:event="oninput" autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="64" />
                <small class="enote-muted">3 à 64 caractères : lettres, chiffres, point, tiret ou soulignement.</small>
            </label>
            <label>
                <span class="enote-pflicht">Mot de passe actuel</span>
                <PasswordInput @bind-Value="pseudonymPasswort" Required="true" Autocomplete="current-password" />
            </label>
            <p class="enote-muted pf-hinweis"><Icon Name="info" Groesse="16" /> Vous serez ensuite déconnecté et vous reconnecterez avec le nouvel identifiant.</p>
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => pseudonymDialogOffen = false">Annuler</button>
        <AsyncActionButton Text="Changer l'identifiant" OnClick="AenderePseudonymAsync" CssClass="enote-btn-primary" Disabled="@(!PseudonymVollstaendig)" />
    </Footer>
</ModalDialog>
