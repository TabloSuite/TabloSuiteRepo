@page "/profil"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Mon profil</PageTitle>

<div class="enote-page enote-page-narrow">
    <div class="enote-page-header">
        <div>
            <h1>Mon profil</h1>
            <p>Vos informations et votre mot de passe.</p>
        </div>
    </div>

    @if (isLoading)
    {
        <p>Chargement…</p>
    }
    else
    {
        <div class="enote-card enote-settings-card">
            <div class="enote-profil-kopf">
                @if (!string.IsNullOrWhiteSpace(profilBildUrl))
                {
                    <img src="@profilBildUrl" alt="Photo de profil" class="enote-profil-bild" />
                }
                else
                {
                    <div class="enote-profil-avatar">@Initialen</div>
                }
                <div>
                    <div class="enote-profil-name">@fullName</div>
                    <div class="enote-muted">@email</div>
                    <div class="enote-profil-rollen">
                        @if (rollen.Count == 0)
                        {
                            <span class="enote-muted" role="status">Aucun rôle attribué à ce compte.</span>
                        }
                        @foreach (var rolle in rollen)
                        {
                            <span class="enote-tag">@RolleText(rolle)</span>
                        }
                    </div>
                </div>
            </div>

            @* Profilbild-Upload *@
            <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #e0e0e0;">
                <h3 style="margin-top: 0;">Photo de profil</h3>
                @if (!string.IsNullOrWhiteSpace(bildFehler))
                {
                    <div class="alert alert-error">@bildFehler</div>
                }
                @if (bildErfolg)
                {
                    <div class="alert alert-success">Photo mise à jour avec succès.</div>
                }
                <div style="display: flex; gap: 0.5rem; align-items: center;">
                    <label class="enote-btn enote-btn-secondary" style="cursor: pointer; margin: 0;">
                        <InputFile OnChange="LadeProfilBildHochAsync" accept="image/*" style="display: none;" />
                        Choisir une photo
                    </label>
                    @if (!string.IsNullOrWhiteSpace(profilBildUrl))
                    {
                        <button type="button" class="enote-btn enote-btn-ghost" @onclick="EntferneProfilBildAsync">Supprimer</button>
                    }
                </div>
                <small class="enote-muted">Max. 8 Mo. JPG, PNG ou GIF.</small>
            </div>
        </div>

        <div class="enote-card enote-settings-card">
            <h2>Changer le mot de passe</h2>

            @if (!string.IsNullOrWhiteSpace(pwFehler))
            {
                <div class="alert alert-error">@pwFehler</div>
            }
            @if (pwGeaendert)
            {
                <div class="alert alert-success">Mot de passe modifié. Reconnectez-vous.</div>
            }

            <EditForm Model="this" OnValidSubmit="AenderePasswortAsync" FormName="pw-form" class="enote-form">
                <label>
                    Mot de passe actuel
                    <PasswordInput @bind-Value="aktuellesPasswort" Required="true" Autocomplete="current-password" />
                </label>
                <label>
                    Nouveau mot de passe
                    <PasswordInput @bind-Value="neuesPasswort" Required="true" Autocomplete="new-password" />
                    <small>Au moins 6 caractères, dont 1 chiffre et 1 lettre minuscule.</small>
                </label>
                <AsyncActionButton Text="Modifier" OnClick="AenderePasswortAsync" CssClass="enote-btn-primary" />
            </EditForm>
        </div>
    }
</div>
