@page "/admin/facturation"
@attribute [Authorize(Roles = "SuperAdmin, ProduktOwner")]
@rendermode InteractiveServer
@using ENote.Core.DataModels.Abo

<PageTitle>Facturation</PageTitle>

<div class="enote-page">
    <div class="enote-page-header">
        <div>
            <h1>Facturation eNOTE</h1>
            <p>Abonnements des établissements et paiements à confirmer.</p>
        </div>
    </div>

    @if (isLoading)
    {
        <p>Chargement…</p>
    }
    else
    {
        <div class="ad-kpis">
            <div class="ad-kpi"><span>À confirmer</span><strong class="@(gemeldete.Count > 0 ? "warn" : "")">@gemeldete.Count</strong></div>
            <div class="ad-kpi"><span>À payer</span><strong>@kennzahlen.ZuZahlen.ToString("N0") F</strong></div>
            <div class="ad-kpi"><span>Encaissé ce mois</span><strong>@kennzahlen.EingenommenDiesenMonat.ToString("N0") F</strong></div>
            <div class="ad-kpi"><span>Factures</span><strong>@kennzahlen.Rechnungen</strong></div>
        </div>
        @if (gemeldete.Count > 0)
        {
            <h2 class="enote-section-title">Paiements signalés (@gemeldete.Count)</h2>
            @if (darfBestaetigen)
            {
                <div class="enote-auswahl-leiste">
                    <label class="enote-auswahl">
                        <input type="checkbox" checked="@(auswahl.Count == gemeldete.Count)" @onchange="AlleWaehlen" />
                        <span>Tout sélectionner</span>
                    </label>
                    <span class="enote-muted">@auswahl.Count sélectionné(s) · @Auswahlsumme.ToString("N0") F</span>
                    <button class="enote-btn enote-btn-primary" disabled="@(auswahl.Count == 0)" @onclick="OeffneSammelDialog">Confirmer la sélection (@auswahl.Count)</button>
                </div>
            }
            <div class="enote-grid-scroll">
                @foreach (var a in gemeldete)
                {
                    <div class="enote-item enote-item-pending @(auswahl.Contains(a.Id) ? "enote-item-gewaehlt" : "")" @key="a.Id">
                        <div class="enote-item-head">
                            @if (darfBestaetigen)
                            {
                                <label class="enote-auswahl">
                                    <input type="checkbox" checked="@auswahl.Contains(a.Id)" @onchange="e => Waehle(a.Id, e)" aria-label="Sélectionner @a.Salon.Name" />
                                    <strong>@a.Salon.Name</strong>
                                </label>
                            }
                            else
                            {
                                <strong>@a.Salon.Name</strong>
                            }
                            <span class="enote-price">@a.PreisSnapshot.ToString("N0") F</span>
                        </div>
                        <p class="enote-item-desc">@IntervallText(a.Intervall) · signalé le @a.ZahlungGemeldetUtc?.ToLocalTime().ToString("dd'/'MM'/'yyyy")</p>
                        @if (!string.IsNullOrWhiteSpace(a.ZahlungsNotiz))
                        {
                            <p class="enote-item-desc">« @a.ZahlungsNotiz »</p>
                        }
                        @if (darfBestaetigen)
                        {
                            <div class="enote-item-actions">
                                <AsyncActionButton Text="Confirmer" OnClick="() => SetzeStatusAsync(a.Id, AboZahlungStatus.Bestaetigt)" CssClass="enote-btn-primary enote-btn-sm" />
                                <AsyncActionButton Text="Refuser" OnClick="() => SetzeStatusAsync(a.Id, AboZahlungStatus.Abgelehnt)" CssClass="enote-btn-abbrechen enote-btn-sm" />
                            </div>
                        }
                        else
                        {
                            <p class="enote-item-desc enote-muted">Confirmation par le super-administrateur.</p>
                        }
                    </div>
                }
            </div>
        }


        <h2 class="enote-section-title">Abonnements récents</h2>
        @if (kennzahlen.Rechnungen == 0)
        {
            <p class="enote-empty">Aucun abonnement pour le moment.</p>
        }
        else
        {
            <div class="enote-filter-leiste">
                <input class="enote-filter-suche" placeholder="Rechercher un établissement…" @bind="aboSuche" @bind:event="oninput" @bind:after="SucheVerzoegertAsync" />
                <EnoteSelect TValue="string" @bind-Value="aboStatusFilter" @bind-Value:after="LadeAbosAsync" Options="aboStatusOptionen" />
            </div>
            @if (!GefilterteAbos().Any())
            {
                <p class="enote-empty" role="status">Aucun abonnement ne correspond à votre recherche ou au statut sélectionné.</p>
            }
            <div class="enote-card enote-settings-card">
                <div class="enote-table-scroll"><table class="enote-table">
                    <thead><tr><th>Établissement</th><th>Formule</th><th>Montant</th><th>Période</th><th>Statut</th></tr></thead>
                    <tbody>
                        @foreach (var a in GefilterteAbos())
                        {
                            <tr>
                                <td>@a.Salon.Name</td>
                                <td>@IntervallText(a.Intervall)</td>
                                <td>@a.PreisSnapshot.ToString("N0") F</td>
                                <td>@a.ZeitraumVonUtc.ToLocalTime().ToString("dd'/'MM'/'yyyy") – @a.ZeitraumBisUtc.ToLocalTime().ToString("dd'/'MM'/'yyyy")</td>
                                <td><span class="enote-tag @StatusKlasse(a.ZahlungStatus)">@StatusText(a.ZahlungStatus)</span></td>
                            </tr>
                        }
                    </tbody>
                </table></div>
                @if (alleMehr)
                {
                    <AsyncActionButton CssClass="enote-btn-ghost enote-mehr" BusyText="Chargement…" OnClick="MehrAbosAsync">Afficher plus</AsyncActionButton>
                }
            </div>
        }
    }
</div>

<ModalDialog Open="sammelDialogOffen" Title="Confirmer plusieurs paiements" OnClose="() => sammelDialogOffen = false" ErrorMessage="@sammelFehler">
    <ChildContent>
        <p>Vous confirmez avoir réellement reçu <strong>@auswahl.Count paiement(s)</strong> pour un total de <strong>@Auswahlsumme.ToString("N0") F</strong> :</p>
        <ul class="enote-sammel-liste">
            @foreach (var a in gemeldete.Where(a => auswahl.Contains(a.Id)))
            {
                <li>@a.Salon.Name · @a.PreisSnapshot.ToString("N0") F@(string.IsNullOrWhiteSpace(a.ZahlungsNotiz) ? "" : " · « " + a.ZahlungsNotiz + " »")</li>
            }
        </ul>
        <p class="enote-muted">Chaque propriétaire reçoit sa confirmation par e-mail. Les commissions des responsables sont créées automatiquement.</p>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => sammelDialogOffen = false">Annuler</button>
        <AsyncActionButton Text="@($"Confirmer {auswahl.Count} paiement(s)")" OnClick="SammelBestaetigenAsync" CssClass="enote-btn-primary" />
    </Footer>
</ModalDialog>
