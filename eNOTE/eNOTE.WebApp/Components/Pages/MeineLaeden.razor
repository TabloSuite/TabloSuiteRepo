@page "/mes-etablissements"
@attribute [Authorize(Roles = "ProduktOwner")]
@rendermode InteractiveServer

<PageTitle>Mes établissements</PageTitle>


<BesitzerPinGuard>
<div class="enote-page">
    <div class="enote-page-header">
        <div>
            <h1>Mes établissements</h1>
            <p>Vue d'ensemble de vos établissements gérés.</p>
        </div>
        <button class="enote-btn enote-btn-primary" @onclick="OeffneAnlegeDialog">+ Nouvel établissement</button>
    </div>

    @if (isLoading)
    {
        <p>Chargement…</p>
    }
    else if (laeden.Count == 0)
    {
        <p class="enote-empty">Aucun établissement ne vous est encore assigné. Contactez l'administrateur.</p>
    }
    else
    {
        @if (laeden.Count > 5)
        {
            <div class="enote-filter-row" style="margin-bottom: .9rem;">
                <input class="enote-filter-suche" placeholder="Rechercher un établissement…" @bind="laedenSuche" @bind:event="oninput" />
            </div>
        }
        <div class="enote-grid-scroll">
            @foreach (var l in GefilterteLaeden())
            {
                <div class="enote-item">
                    <div class="enote-item-head">
                        <strong>@l.SalonName</strong>
                        @if (l.IstFreigegeben)
                        {
                            <span class="enote-tag">Validé</span>
                        }
                        else
                        {
                            <span class="enote-tag enote-tag-warn">En attente</span>
                        }
                    </div>
                    @if (!l.IstFreigegeben)
                    {
                        @* Nutzer 19.11.2026: der Responsable darf seine Läden selbst freigeben – der Knopf stand bisher nur unter « Administration ». *@
                        <div class="enote-po-freigabe">
                            <p class="enote-muted">Cet établissement attend sa validation. Validez-le pour que le propriétaire puisse encaisser.</p>
                            <AsyncActionButton Text="Valider l'établissement" BusyText="Validation…" CssClass="enote-btn-primary enote-btn-sm" OnClick="() => ValidiereAsync(l)" />
                        </div>
                    }

                    @if (l.KannLadenUmsatzSehen)
                    {
                        <div class="enote-po-umsatz">
                            <div><span>Aujourd'hui</span><strong>@l.UmsatzHeute.ToString("N0") F</strong></div>
                            <div><span>Ce mois</span><strong>@l.UmsatzMonat.ToString("N0") F</strong></div>
                        </div>
                    }
                    else
                    {
                        <p class="enote-muted">Chiffre d'affaires masqué par l'administrateur.</p>
                    }

                    @if (l.ProzentProvision is not null || l.FestbetragProvision is not null)
                    {
                        <div class="enote-po-provision">
                            <span>Commission :</span>
                            <strong>@ProvisionText(l)</strong>
                        </div>
                    }
                </div>
            }
        </div>
    }
    @if (!isLoading)
    {
        <PoProvisionenPo />
    }
</div>

<ModalDialog Open="anlegedialogOffen" Title="Nouvel établissement" ErrorMessage="@anlegeFehler" OnClose="() => anlegedialogOffen = false">
    <ChildContent>
        <div class="enote-form">
            <p class="enote-muted">L'établissement est activé dès qu'il est validé : vous pouvez le valider vous-même juste après, sur sa carte (« Valider l'établissement »). Un nouveau compte propriétaire (pseudonyme + mot de passe) est créé ; l'adresse e-mail peut être la même que pour un autre établissement.</p>
            <div class="enote-form-grid">
                <label><span class="enote-pflicht">Prénom du propriétaire</span> <input @bind="neuVorname" @bind:event="oninput" /></label>
                <label><span class="enote-pflicht">Nom du propriétaire</span> <input @bind="neuNachname" @bind:event="oninput" /></label>
            </div>
            <label><span class="enote-pflicht">Pseudonyme (identifiant de connexion)</span> <input @bind="neuPseudonym" @bind:event="oninput" autocomplete="username" /></label>
            <label><span class="enote-pflicht">Adresse e-mail de contact</span> <input type="email" @bind="neuEmail" @bind:event="oninput" /></label>
            <label><span class="enote-pflicht">Téléphone du propriétaire</span> <input type="tel" @bind="neuTelefon" @bind:event="oninput" autocomplete="off" maxlength="30" placeholder="ex. +228 90 12 34 56" /></label>
            <label><span class="enote-pflicht">Mot de passe initial</span> <input type="text" @bind="neuPasswort" @bind:event="oninput" /></label>
            <small class="enote-muted" style="margin-top:-.5rem;">Au moins 6 caractères, dont 1 chiffre et 1 lettre minuscule.</small>
            <label><span class="enote-pflicht">Nom de l'établissement</span> <input @bind="neuSalonName" @bind:event="oninput" /></label>
            <label>Ville / quartier (facultatif) <input @bind="neuStandort" /></label>
            @* 18.11.2026: Auswahlliste wie bei Registrierung und Admin – vorher freier Text ohne Prüfung (Ortszeit, Mobile Money). *@
            <label>Pays <EnoteSelect TValue="string" @bind-Value="neuLand" Options="landOptionen" MitSuche="true" Placeholder="Choisir le pays…" /></label>
            <small class="enote-muted" style="margin-top:-.5rem;">@ENote.WebApp.Services.LaenderAuswahl.Hinweis</small>
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => anlegedialogOffen = false">Annuler</button>
        <AsyncActionButton Text="Créer" OnClick="LegeSalonSelbstAnAsync" CssClass="enote-btn-primary" Disabled="@(!AnlageVollstaendig)" />
    </Footer>
</ModalDialog>
</BesitzerPinGuard>
