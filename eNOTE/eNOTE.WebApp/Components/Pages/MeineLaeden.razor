@page "/mes-etablissements"
@attribute [Authorize(Roles = "ProduktOwner")]
@rendermode InteractiveServer

<PageTitle>Mes établissements</PageTitle>


<BesitzerPinGuard>
<div class="enote-page">
    <div class="enote-page-header">
        <div>
            <h1>Mes établissements</h1>
            <p>Vue d'ensemble de vos établissements gérés.</p>
        </div>
        <button class="enote-btn enote-btn-primary" @onclick="OeffneAnlegeDialog">+ Nouvel établissement</button>
    </div>

    @if (isLoading)
    {
        <p>Chargement…</p>
    }
    else if (laeden.Count == 0)
    {
        <p class="enote-empty">Aucun établissement ne vous est encore assigné. Contactez l'administrateur.</p>
    }
    else
    {
        @if (laeden.Count > 5)
        {
            <div class="enote-filter-row" style="margin-bottom: .9rem;">
                <input class="enote-filter-suche" placeholder="Rechercher un établissement…" @bind="laedenSuche" @bind:event="oninput" />
            </div>
        }
        <div class="enote-grid-scroll">
            @foreach (var l in GefilterteLaeden())
            {
                <div class="enote-item">
                    <div class="enote-item-head">
                        <strong>@l.SalonName</strong>
                        @if (l.IstFreigegeben)
                        {
                            <span class="enote-tag">Validé</span>
                        }
                        else
                        {
                            <span class="enote-tag enote-tag-warn">En attente</span>
                        }
                    </div>

                    @if (l.KannLadenUmsatzSehen)
                    {
                        <div class="enote-po-umsatz">
                            <div><span>Aujourd'hui</span><strong>@l.UmsatzHeute.ToString("N0") F</strong></div>
                            <div><span>Ce mois</span><strong>@l.UmsatzMonat.ToString("N0") F</strong></div>
                        </div>
                    }
                    else
                    {
                        <p class="enote-muted">Chiffre d'affaires masqué par l'administrateur.</p>
                    }

                    @if (l.ProzentProvision is not null || l.FestbetragProvision is not null)
                    {
                        <div class="enote-po-provision">
                            <span>Commission :</span>
                            <strong>@ProvisionText(l)</strong>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<ModalDialog Open="anlegedialogOffen" Title="Nouvel établissement" ErrorMessage="@anlegeFehler" OnClose="() => anlegedialogOffen = false">
    <ChildContent>
        <div class="enote-form">
            <p class="enote-muted">L'établissement sera activé après validation par l'administrateur. Un nouveau compte propriétaire (pseudonyme + mot de passe) est créé ; l'adresse e-mail peut être la même que pour un autre établissement.</p>
            <div class="enote-form-grid">
                <label>Prénom du propriétaire <input @bind="neuVorname" /></label>
                <label>Nom du propriétaire <input @bind="neuNachname" /></label>
            </div>
            <label>Pseudonyme (identifiant de connexion) <input @bind="neuPseudonym" autocomplete="username" /></label>
            <label>Adresse e-mail de contact <input type="email" @bind="neuEmail" /></label>
            <label>Téléphone du propriétaire <input type="tel" @bind="neuTelefon" autocomplete="off" maxlength="30" placeholder="ex. +228 90 12 34 56" /></label>
            <label>Mot de passe initial <input type="text" @bind="neuPasswort" /></label>
            <small class="enote-muted" style="margin-top:-.5rem;">Au moins 6 caractères, dont 1 chiffre et 1 lettre minuscule.</small>
            <label>Nom de l'établissement <input @bind="neuSalonName" /></label>
            <label>Ville / quartier (facultatif) <input @bind="neuStandort" /></label>
            <label>Pays (facultatif) <input @bind="neuLand" /></label>
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => anlegedialogOffen = false">Annuler</button>
        <AsyncActionButton Text="Créer" OnClick="LegeSalonSelbstAnAsync" CssClass="enote-btn-primary" />
    </Footer>
</ModalDialog>
</BesitzerPinGuard>
