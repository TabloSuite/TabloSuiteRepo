@page "/abonnement"
@attribute [Authorize(Roles = "Besitzer")]
@rendermode InteractiveServer
@using ENote.Core.DataModels.Abo
@using ENote.Core.Services

<PageTitle>Abonnement</PageTitle>

<BesitzerPinGuard>
<div class="enote-page ab">
    <div class="enote-page-header">
        <div>
            <h1>Abonnement</h1>
            <p>@salonName · facturation automatique, paiement à signaler, confirmation par l'administrateur.</p>
        </div>
    </div>

    @if (isLoading)
    {
        <p class="enote-muted" role="status">Chargement…</p>
    }
    else if (ladeFehler is not null && vertrag is null)
    {
        <div class="alert alert-error" role="alert">@ladeFehler</div>
    }
    else if (vertrag is { } v)
    {
        @* --- Kündigung / Löschung --- *@
        @if (stand is { LoeschungLaeuft: true } sl)
        {
            <div class="ab-faellig gesperrt ab-ende" role="status">
                <span class="ab-faellig-ico"><Icon Name="trash" Groesse="20" /></span>
                <div>
                    <strong>Suppression du compte prévue le @Datum(sl.LoeschungAbUtc)</strong>
                    <span>L'établissement est fermé. À cette date, ses données seront supprimées définitivement. Vous pouvez encore annuler.</span>
                </div>
                <AsyncActionButton Text="Annuler la suppression" BusyText="…" CssClass="enote-btn-primary" OnClick="NimmLoeschungZurueckAsync" />
            </div>
        }
        else if (stand is { IstGekuendigt: true, KuendigungWirksam: true } sw)
        {
            <div class="ab-faellig gesperrt ab-ende" role="status">
                <span class="ab-faellig-ico"><Icon Name="lock" Groesse="20" /></span>
                <div>
                    <strong>Abonnement terminé depuis le @Datum(sw.GekuendigtZumUtc)</strong>
                    <span>La caisse est fermée. Vos données sont conservées : réactivez l'abonnement pour reprendre (facturation à partir d'aujourd'hui).</span>
                </div>
                <AsyncActionButton Text="Réactiver l'abonnement" BusyText="…" CssClass="enote-btn-primary" OnClick="NimmKuendigungZurueckAsync" />
            </div>
        }
        else if (stand is { IstGekuendigt: true } sk)
        {
            <div class="ab-faellig ab-ende" role="status">
                <span class="ab-faellig-ico"><Icon Name="calendar" Groesse="20" /></span>
                <div>
                    <strong>Abonnement résilié · fin le @Datum(sk.GekuendigtZumUtc?.AddTicks(-1)) au soir</strong>
                    <span>Jusque-là, tout fonctionne normalement. Aucune nouvelle facture ne sera émise.</span>
                </div>
                <AsyncActionButton Text="Annuler la résiliation" BusyText="…" CssClass="enote-btn-primary" OnClick="NimmKuendigungZurueckAsync" />
            </div>
        }

        @* --- Status: Probezeit / offene Zahlungen --- *@
        @if (v.ProbeLaeuft)
        {
            <div class="enote-abo-status enote-probe-banner">
                <div>
                    <strong>Essai gratuit jusqu'au @v.ProbeBisUtc?.ToString("dd.MM.yyyy")</strong>
                    <div class="enote-muted">Ensuite, la formule « @VertragsRegeln.Bezeichnung(v.KuenftigesIntervall) » démarre automatiquement. Vous pouvez la changer ci-dessous.</div>
                </div>
                <span class="enote-tag enote-tag-ok">Essai</span>
            </div>
        }
        @foreach (var p in OffenePerioden.OrderBy(p => p.Faellig))
        {
            var ueberfaellig = DateTime.UtcNow >= p.SperreAb;
            <div class="ab-faellig @(ueberfaellig ? "gesperrt" : "")" role="status">
                <span class="ab-faellig-ico"><Icon Name="@(ueberfaellig ? "lock" : "alert")" Groesse="20" /></span>
                <div>
                    <strong>@p.Betrag.ToString("N0") F à payer · @VertragsRegeln.Bezeichnung(p.Intervall)</strong>
                    <span>@(ueberfaellig
                        ? "Les ventes sont suspendues jusqu'à la confirmation du paiement."
                        : $"Échéance le {p.Faellig:dd.MM.yyyy} · sans paiement confirmé, les ventes seront suspendues le {p.SperreAb:dd.MM.yyyy}.")</span>
                </div>
                <button class="enote-btn enote-btn-primary" @onclick="() => OeffneMeldung(p)">J'ai payé</button>
            </div>
        }

        @* --- Formel --- *@
        <section class="ab-abschnitt">
            <div class="ab-abschnitt-kopf">
                <h2>Votre formule</h2>
                <p class="enote-muted">
                    @if (v.NaechstesIntervall is AboIntervall naechstes && naechstes != v.Intervall)
                    {
                        <span>Actuelle : <strong>@VertragsRegeln.Bezeichnung(v.Intervall)</strong> · passage à <strong>@VertragsRegeln.Bezeichnung(naechstes)</strong> le @v.WechselAbUtc?.ToString("dd.MM.yyyy").</span>
                    }
                    else if (OffenePerioden.Any())
                    {
                        <span>Facture en cours non payée : un changement de formule la convertit immédiatement (même échéance).</span>
                    }
                    else
                    {
                        <span>Un changement prend effet à la prochaine période ; la période en cours et ses paiements ne changent pas.</span>
                    }
                </p>
            </div>

            @if (formeln.Count == 0)
            {
                <p class="enote-empty">Le tarif n'est pas encore configuré. Contactez l'administrateur.</p>
            }
            else
            {
                @if (formeln[0].Individuell)
                {
                    <p class="ab-hinweis"><Icon Name="sparkles" Groesse="16" /> Tarif personnalisé pour votre établissement : @formeln[0].MonatsBasis.ToString("N0") F / mois.</p>
                }
                @if (kommenderPreis is { } kommend && kommend.Preis != formeln[0].MonatsBasis)
                {
                    <p class="ab-hinweis ab-hinweis-tarif">
                        <Icon Name="calendar" Groesse="16" />
                        <span>À partir du <strong>@ENote.WebApp.Services.PreisAnpassungService.DatumText(kommend.AbUtc)</strong> : <strong>@kommend.Preis.ToString("N0") F / mois</strong>
                        (au lieu de @formeln[0].MonatsBasis.ToString("N0") F). Les remises restent les mêmes ; les périodes déjà facturées ne changent pas.</span>
                    </p>
                }
                <div class="ab-formeln">
                    @foreach (var f in formeln)
                    {
                        var istKuenftig = f.Intervall == v.KuenftigesIntervall;
                        <article class="ab-formel @(istKuenftig ? "empfohlen" : "")">
                            @if (istKuenftig)
                            {
                                <span class="ab-badge">@(v.NaechstesIntervall is not null && v.NaechstesIntervall != v.Intervall ? "Prochaine formule" : "Votre formule")</span>
                            }
                            <header>
                                <strong>@VertragsRegeln.Bezeichnung(f.Intervall)</strong>
                                <span class="enote-muted">@f.Monate mois</span>
                            </header>
                            <div class="ab-preis">@f.Preis.ToString("N0") <small>F</small></div>
                            <div class="ab-details">
                                <span>soit @f.ProMonat.ToString("N0") F / mois</span>
                                @if (f.RabattProzent > 0)
                                {
                                    <span class="enote-tag enote-tag-ok">−@f.RabattProzent.ToString("0.#") % · économie @f.Ersparnis.ToString("N0") F</span>
                                }
                                else
                                {
                                    <span class="enote-tag enote-tag-off">Sans engagement</span>
                                }
                            </div>
                            @if (istKuenftig)
                            {
                                <button class="enote-btn enote-btn-block" disabled><Icon Name="check" Groesse="16" /> Sélectionnée</button>
                            }
                            else
                            {
                                <button class="enote-btn enote-btn-block" @onclick="() => OeffneWechselAsync(f.Intervall)">Choisir</button>
                            }
                        </article>
                    }
                </div>
            }
        </section>

        @* --- Rechnungen --- *@
        <section class="ab-abschnitt">
            <div class="ab-abschnitt-kopf">
                <h2>Factures</h2>
                @if (!string.IsNullOrWhiteSpace(v.Zahlungsempfaenger))
                {
                    <p class="enote-muted">Paiement à effectuer auprès de : <strong>@v.Zahlungsempfaenger</strong></p>
                }
            </div>
            @if (v.Perioden.Count == 0)
            {
                <p class="enote-empty">@(v.ProbeLaeuft ? "Aucune facture pendant l'essai gratuit." : "Aucune facture pour le moment.")</p>
            }
            else
            {
                <div class="ab-rechnungen">
                    @foreach (var p in v.Perioden)
                    {
                        <div class="ab-rechnung">
                            <div class="ab-rechnung-info">
                                <strong>@VertragsRegeln.Bezeichnung(p.Intervall)@(p.Bis.Subtract(p.Von).TotalDays < 27 ? " (prorata)" : "")</strong>
                                <span class="enote-muted">@p.Von.ToString("dd.MM.yyyy") – @p.Bis.AddDays(-1).ToString("dd.MM.yyyy")</span>
                            </div>
                            <span class="ab-rechnung-betrag">@p.Betrag.ToString("N0") F</span>
                            <span class="enote-tag @StatusKlasse(p.Status)">@StatusText(p.Status)</span>
                            @if (p.Status is AboZahlungStatus.Offen or AboZahlungStatus.Abgelehnt)
                            {
                                <button class="enote-btn enote-btn-sm" @onclick="() => OeffneMeldung(p)">J'ai payé</button>
                            }
                            else
                            {
                                <span></span>
                            }
                        </div>
                    }
                </div>
            }
        </section>

        @* --- Kündigen / Löschen --- *@
        @if (stand is { } s)
        {
            <section class="ab-abschnitt" aria-labelledby="ab-ende-titel">
                <div class="ab-abschnitt-kopf">
                    <h2 id="ab-ende-titel">Résiliation et suppression</h2>
                    <p class="enote-muted">Sans engagement : vous pouvez arrêter quand vous voulez.</p>
                </div>
                <div class="ab-ende-raster">
                    <article class="ab-ende-karte">
                        <h3><Icon Name="calendar" Groesse="18" /> Résilier l'abonnement</h3>
                        @if (s.IstGekuendigt)
                        {
                            <p>Résiliation enregistrée le @Datum(s.GekuendigtAmUtc). @(s.KuendigungWirksam ? "L'abonnement est terminé." : $"Fin le {Datum(s.GekuendigtZumUtc?.AddTicks(-1))} au soir.")</p>
                        }
                        else
                        {
                            <p>L'abonnement s'arrête à la fin de @(s.ProbeLaeuft ? "l'essai gratuit" : "la période en cours"), le <strong>@Datum(s.WuerdeWirkenZumUtc.AddTicks(-1))</strong> au soir. Jusque-là, tout fonctionne. Vos données sont conservées et vous pouvez réactiver à tout moment.</p>
                            @if (s.OffeneRechnungen > 0)
                            {
                                <p class="enote-muted">Les factures déjà émises (@s.OffenerBetrag.ToString("N0") F) restent à payer.</p>
                            }
                            <div><button class="enote-btn enote-btn-ghost" @onclick="OeffneKuendigung">Résilier l'abonnement</button></div>
                        }
                    </article>
                    <article class="ab-ende-karte gefahr">
                        <h3><Icon Name="trash" Groesse="18" /> Supprimer le compte</h3>
                        <p>L'établissement est fermé tout de suite. Après <strong>@KuendigungsRegeln.LoeschFristTage jours</strong>, les ventes, clients, prestations, dépenses et comptes de l'équipe sont supprimés définitivement. Nos factures d'abonnement sont conservées, sans données personnelles. Annulable pendant @KuendigungsRegeln.LoeschFristTage jours.</p>
                        @if (s.LoeschungLaeuft)
                        {
                            <p class="ab-ende-status">Suppression prévue le @Datum(s.LoeschungAbUtc).</p>
                        }
                        else if (s.OffeneRechnungen > 0)
                        {
                            <p class="ab-ende-status"><Icon Name="info" Groesse="16" /> Réglez d'abord @(s.OffeneRechnungen == 1 ? "la facture ouverte" : $"les {s.OffeneRechnungen} factures ouvertes") (@s.OffenerBetrag.ToString("N0") F) : la suppression n'est possible que sans facture impayée.</p>
                            <div><button class="enote-btn enote-btn-ghost" disabled>Supprimer le compte</button></div>
                        }
                        else
                        {
                            <div><button class="enote-btn enote-btn-danger-ghost" @onclick="OeffneLoeschung">Supprimer le compte…</button></div>
                        }
                    </article>
                </div>
            </section>
        }
    }
</div>

<ModalDialog Open="kuendigungOffen" Title="Résilier l'abonnement" ErrorMessage="@endeFehler" OnClose="() => kuendigungOffen = false" MaxWidthClass="enote-modal-sm">
    <ChildContent>
        @if (stand is { } ks)
        {
            <div class="enote-form">
                <p>L'abonnement prendra fin le <strong>@Datum(ks.WuerdeWirkenZumUtc.AddTicks(-1))</strong> au soir. Ensuite, la caisse sera fermée et aucune facture ne sera émise.</p>
                <div>
                    <span class="kv-label">Pourquoi partez-vous ? <span class="enote-muted kv-optional">(facultatif)</span></span>
                    <div class="kv-chips" role="group" aria-label="Motif">
                        @foreach (var g in Gruende)
                        {
                            <button type="button" class="kv-chip @(kuendigungGrund == g ? "aktiv" : "")" @onclick="() => kuendigungGrund = kuendigungGrund == g ? null : g">@g</button>
                        }
                    </div>
                </div>
                <label>Un mot pour nous aider à nous améliorer <span class="enote-muted kv-optional">(facultatif)</span>
                    <textarea rows="2" @bind="kuendigungText" maxlength="400"></textarea>
                </label>
            </div>
        }
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => kuendigungOffen = false">Garder l'abonnement</button>
        <AsyncActionButton Text="Confirmer la résiliation" BusyText="…" CssClass="enote-btn-primary" OnClick="KuendigeAsync" />
    </Footer>
</ModalDialog>

<ModalDialog Open="loeschungOffen" Title="Supprimer le compte" ErrorMessage="@endeFehler" OnClose="() => loeschungOffen = false" MaxWidthClass="enote-modal-sm">
    <ChildContent>
        <div class="enote-form">
            <ul class="ab-ende-liste">
                <li><Icon Name="lock" Groesse="16" /> <span>L'établissement <strong>@salonName</strong> est fermé immédiatement (caisse et équipe).</span></li>
                <li><Icon Name="calendar" Groesse="16" /> <span>Le <strong>@Datum(DateTime.UtcNow.AddDays(KuendigungsRegeln.LoeschFristTage))</strong>, toutes ses données sont supprimées définitivement.</span></li>
                <li><Icon Name="undo" Groesse="16" /> <span>D'ici là, vous pouvez annuler dans « Abonnement ».</span></li>
            </ul>
            <label>Mot de passe actuel
                <PasswordInput @bind-Value="loeschPasswort" Required="true" Autocomplete="current-password" />
            </label>
            <EnoteCheckbox @bind-Value="loeschVerstanden" Label="J'ai compris : après 30 jours, les données ne pourront plus être récupérées." />
        </div>
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => loeschungOffen = false">Annuler</button>
        <AsyncActionButton Text="Supprimer le compte" BusyText="…" CssClass="enote-btn-danger" Disabled="!loeschVerstanden" OnClick="BeantrageLoeschungAsync" />
    </Footer>
</ModalDialog>

@* Formelwechsel bestätigen *@
<ModalDialog Open="wechselZiel is not null" Title="Changer de formule" OnClose="() => wechselZiel = null" MaxWidthClass="enote-modal-sm">
    <ChildContent>
        @if (wechselZiel is AboIntervall ziel && wechselVorschau is { } vs)
        {
            var monate = VertragsRegeln.Monate(ziel);
            @if (vs.Art == ENote.WebApp.Services.VertragsService.WechselArt.SofortUmgewandelt)
            {
                <p>Votre facture en cours n'est pas encore payée : elle sera <strong>convertie immédiatement</strong> en formule <strong>@VertragsRegeln.Bezeichnung(ziel)</strong>.</p>
                <div class="kx-pay-total"><span>Nouveau montant</span><strong>@vs.NeuerBetrag?.ToString("N0") F</strong></div>
                <p class="enote-muted">Période : du @vs.AbUtc?.ToString("dd.MM.yyyy") au @vs.AbUtc?.AddMonths(monate).AddDays(-1).ToString("dd.MM.yyyy"). L'échéance ne change pas@(vs.SperreAb is DateTime s ? $" : sans paiement confirmé, les ventes seront suspendues le {s:dd.MM.yyyy}" : "").</p>
            }
            else
            {
                <p>Passer à la formule <strong>@VertragsRegeln.Bezeichnung(ziel)</strong> (@vs.NeuerBetrag?.ToString("N0") F pour @monate mois) ?</p>
                <p class="enote-muted">Elle démarre le @vs.AbUtc?.ToString("dd.MM.yyyy")@(vertrag?.ProbeLaeuft == true ? ", après l'essai gratuit" : ""). La période en cours et les factures déjà émises restent inchangées.</p>
            }
        }
        else if (wechselZiel is not null)
        {
            <p class="enote-muted" role="status">Calcul…</p>
        }
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => wechselZiel = null">Annuler</button>
        <AsyncActionButton Text="Confirmer" OnClick="WechsleFormelAsync" CssClass="enote-btn-primary" />
    </Footer>
</ModalDialog>

@* Zahlung melden *@
<ModalDialog Open="meldungFuer is not null" Title="Signaler un paiement" ErrorMessage="@zahlungFehler" OnClose="() => meldungFuer = null" MaxWidthClass="enote-modal-sm">
    <ChildContent>
        @if (meldungFuer is { } p)
        {
            <div class="enote-form">
                <div class="kx-pay-total"><span>@VertragsRegeln.Bezeichnung(p.Intervall)</span><strong>@p.Betrag.ToString("N0") F</strong></div>
                <p class="enote-muted">Confirmez uniquement après avoir réellement payé (virement, Mobile Money, espèces). L'administrateur vérifie la réception ; jusque-là, la facture reste « en vérification ».</p>
                <label>Référence <small class="enote-muted">(facultatif)</small> <input @bind="zahlungsNotiz" maxlength="500" placeholder="ex. Flooz MP241110.1234, virement du 10/11…" /></label>
            </div>
        }
    </ChildContent>
    <Footer>
        <button class="enote-btn enote-btn-ghost" @onclick="() => meldungFuer = null">Annuler</button>
        <AsyncActionButton Text="Oui, j'ai payé" OnClick="MeldeZahlungAsync" CssClass="enote-btn-primary" />
    </Footer>
</ModalDialog>
</BesitzerPinGuard>
