@inherits LayoutComponentBase
@implements IDisposable
@inject ENote.WebApp.Services.KassenAnzeigeState KassenState
@inject ENote.WebApp.Services.BesitzerPinState BesitzerPinState
@inject NavigationManager Nav
@inject IJSRuntime JS
@using ENote.WebApp.Components.Shared

<div class="enote-layout @((KassenState.KassenModusAktiv && !KassenState.IstMinimiert) ? "enote-kassen-modus" : "")">
    <header class="enote-topbar">
        <a class="enote-brand" href="/">
            <span class="enote-brand-icon">eN</span>
            <span class="enote-brand-name">eNOTE</span>
        </a>
        <div class="enote-topbar-actions">
            @if (!KassenState.KassenModusAktiv || KassenState.IstMinimiert)
            {
                <AuthorizeView Roles="Besitzer, Kassierer">
                    <Authorized Context="switcherCtx">
                        <SalonSwitcher />
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView>
                    <Authorized>
                        <div class="enote-usermenu">
                            <button class="enote-avatar-btn" @onclick="() => userMenuOffen = !userMenuOffen" aria-label="Compte">
                                <span class="enote-avatar">@Initialen(context.User.Identity?.Name)</span>
                            </button>
                            @if (userMenuOffen)
                            {
                                <div class="enote-usermenu-popup">
                                    <div class="enote-usermenu-name">@context.User.Identity?.Name</div>
                                    <a class="enote-usermenu-link" href="/profil" @onclick="() => userMenuOffen = false">👤 Mon profil</a>
                                    <form method="post" action="/auth/logout">
                                        <AntiforgeryToken />
                                        <button type="submit" class="enote-usermenu-link enote-usermenu-danger">⎋ Déconnexion</button>
                                    </form>
                                </div>
                            }
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a class="enote-btn enote-btn-ghost" href="/auth/login">Connexion</a>
                        <a class="enote-btn enote-btn-primary" href="/auth/register">Inscription</a>
                    </NotAuthorized>
                </AuthorizeView>
            }
        </div>
    </header>

    <div class="enote-body">
        @if (!KassenState.KassenModusAktiv || KassenState.IstMinimiert)
        {
            <NavMenu />
        }
        <main class="enote-main">
            @Body
        </main>
    </div>

    @* Schwebende Mini-Kassenanzeige, wenn die Kasse minimiert ist *@
    @if (KassenState.IstMinimiert && KassenState.AktiveSitzungId is not null)
    {
        <button class="enote-mini-caisse" @onclick="OeffneKasse">
            <span>Caisse · @KassenState.KassiererName</span>
            <span class="betrag">@KassenState.ErwarteterBarBetrag.ToString("N0") F</span>
        </button>
    }

    @* Sperr-Button, wenn die Verwaltung freigeschaltet ist (Besitzer kann wieder sperren) *@
    @if (BesitzerPinState.VerwaltungFreigeschaltet && KassenState.AktiveSitzungId is not null)
    {
        <button class="enote-sperr-btn" @onclick="() => BesitzerPinState.Sperren()" title="Verrouiller la zone propriétaire">
            🔒 Verrouiller
        </button>
    }

    <Toast />
</div>

@code {
    private bool userMenuOffen;
    private DotNetObjectReference<MainLayout>? selfRef;

    protected override void OnInitialized()
    {
        KassenState.OnChange += StateHasChanged;
        BesitzerPinState.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            selfRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("enoteRegisterUserMenu", selfRef);
            }
            catch (InvalidOperationException)
            {
                // JS noch nicht verfügbar (Prerendering) – wird beim nächsten Render erneut versucht.
            }
        }
    }

    [Microsoft.JSInterop.JSInvokable]
    public void SchliesseUserMenu()
    {
        if (userMenuOffen)
        {
            userMenuOffen = false;
            StateHasChanged();
        }
    }

    private static string Initialen(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var teile = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return teile.Length == 1
            ? teile[0][..Math.Min(2, teile[0].Length)].ToUpperInvariant()
            : string.Concat(teile[0][0], teile[^1][0]).ToUpperInvariant();
    }

    private void OeffneKasse()
    {
        KassenState.Wiederherstellen();
        Nav.NavigateTo("/caisse");
    }

    public void Dispose()
    {
        KassenState.OnChange -= StateHasChanged;
        BesitzerPinState.OnChange -= StateHasChanged;
        selfRef?.Dispose();
    }
}
