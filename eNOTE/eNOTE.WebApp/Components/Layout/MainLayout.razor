@inherits LayoutComponentBase
@implements IDisposable
@inject ENote.WebApp.Services.KassenAnzeigeState KassenState
@inject ENote.WebApp.Services.BesitzerPinState BesitzerPinState
@inject NavigationManager Nav
@inject IJSRuntime JS
@using ENote.WebApp.Components.Shared

<LadeIndikator />
<AuthorizeView>
    <Authorized>
        <div class="enote-shell @(KassenVollbild ? "enote-kassen-modus" : "")">
            @if (!KassenVollbild)
            {
                <NavMenu />
            }
            <div class="enote-content">
                @if (!KassenVollbild)
                {
                    <header class="enote-topbar">
                        <a class="enote-topbar-brand" href="/" aria-label="eNOTE – Accueil">
                            <span class="enote-brand-icon">eN</span>
                            <span class="enote-brand-name">eNOTE</span>
                        </a>
                        <div class="enote-topbar-spacer"></div>
                        <div class="enote-topbar-actions">
                            <AuthorizeView Roles="Besitzer, Kassierer" Context="switcherCtx">
                                <Authorized>
                                    <SalonSwitcher />
                                </Authorized>
                            </AuthorizeView>
                            <div class="enote-usermenu">
                                <button class="enote-avatar-btn" @onclick="ToggleUserMenuAsync" aria-label="Mon compte" aria-expanded="@userMenuOffen">
                                    <span class="enote-avatar">@Initialen(context.User.Identity?.Name)</span>
                                    <Icon Name="chevron-down" Groesse="16" CssClass="enote-avatar-chevron" />
                                </button>
                                @if (userMenuOffen)
                                {
                                    <div class="enote-usermenu-popup">
                                        <div class="enote-usermenu-name">
                                            <span class="enote-avatar enote-avatar-sm">@Initialen(context.User.Identity?.Name)</span>
                                            <span>@context.User.Identity?.Name</span>
                                        </div>
                                        <a class="enote-usermenu-link" href="/profil" @onclick="() => userMenuOffen = false"><Icon Name="user" Groesse="18" /> Mon profil</a>
                                        <div class="enote-theme-wahl" role="radiogroup" aria-label="Apparence">
                                            <span class="enote-theme-titel">Apparence</span>
                                            <div class="enote-theme-optionen">
                                                <button type="button" role="radio" aria-checked="@(themeModus == "light")" class="@(themeModus == "light" ? "aktiv" : "")" @onclick='() => SetzeThemeAsync("light")'><Icon Name="sun" Groesse="16" /> Clair</button>
                                                <button type="button" role="radio" aria-checked="@(themeModus == "dark")" class="@(themeModus == "dark" ? "aktiv" : "")" @onclick='() => SetzeThemeAsync("dark")'><Icon Name="moon" Groesse="16" /> Sombre</button>
                                                <button type="button" role="radio" aria-checked="@(themeModus == "auto")" class="@(themeModus == "auto" ? "aktiv" : "")" @onclick='() => SetzeThemeAsync("auto")'><Icon Name="monitor" Groesse="16" /> Auto</button>
                                            </div>
                                        </div>
                                        <a class="enote-usermenu-link" href="https://tablosuite.com" target="_blank" rel="noopener noreferrer"><Icon Name="help" Groesse="18" /> Aide &amp; contact</a>
                                        <form method="post" action="/auth/logout">
                                            <AntiforgeryToken />
                                            <button type="submit" class="enote-usermenu-link enote-usermenu-danger"><Icon Name="logout" Groesse="18" /> Déconnexion</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                    </header>
                }
                <main class="enote-main">
                    @Body
                </main>
            </div>
        </div>

        @* Schwebende Mini-Kassenanzeige, wenn die Kasse minimiert ist *@
        @if (KassenState.IstMinimiert && KassenState.AktiveSitzungId is not null)
        {
            <button class="enote-mini-caisse" @onclick="OeffneKasse">
                <Icon Name="caisse" Groesse="20" />
                <span class="enote-mini-caisse-text">
                    <small>Caisse · @KassenState.KassiererName</small>
                    <strong>@KassenState.ErwarteterBarBetrag.ToString("N0") F</strong>
                </span>
            </button>
        }
    </Authorized>
    <NotAuthorized>
        <div class="enote-public">
            <header class="enote-public-topbar">
                <a class="enote-topbar-brand" href="/">
                    <span class="enote-brand-icon">eN</span>
                    <span class="enote-brand-name">eNOTE</span>
                </a>
                <nav class="lp-nav" aria-label="Sections">
                    <a href="/#fonctions">Fonctionnalités</a>
                    <a href="/#tarifs">Tarifs</a>
                    <a href="/#questions">Questions</a>
                </nav>
                <div class="enote-topbar-actions">
                    <a class="enote-btn enote-btn-ghost" href="/auth/login">Connexion</a>
                    <a class="enote-btn enote-btn-primary" href="/auth/register">Essai gratuit</a>
                </div>
            </header>
            <main class="enote-public-main">
                @Body
            </main>
            <AppFusszeile />
        </div>
    </NotAuthorized>
</AuthorizeView>

<Toast />

@code {
    private string themeModus = "auto";

    private async Task ToggleUserMenuAsync()
    {
        userMenuOffen = !userMenuOffen;
        if (userMenuOffen)
        {
            try { themeModus = await JS.InvokeAsync<string>("enoteLeseTheme"); }
            catch (JSException) { themeModus = "auto"; }
        }
    }

    private async Task SetzeThemeAsync(string modus)
    {
        themeModus = modus;
        try { await JS.InvokeVoidAsync("enoteSetzeTheme", modus); }
        catch (JSException) { }
    }

    private bool userMenuOffen;
    private DotNetObjectReference<MainLayout>? selfRef;

    /// <summary>Aktive, nicht minimierte Kasse belegt den ganzen Bildschirm (ohne Navigation/Topbar).</summary>
    private bool KassenVollbild => KassenState.KassenModusAktiv && !KassenState.IstMinimiert;

    protected override void OnInitialized()
    {
        KassenState.OnChange += StateHasChanged;
        BesitzerPinState.OnChange += StateHasChanged;
        Nav.LocationChanged += SchliesseMenuBeiNavigation;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            selfRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("enoteRegisterUserMenu", selfRef);
            }
            catch (InvalidOperationException)
            {
                // JS noch nicht verfügbar (Prerendering) – wird beim nächsten Render erneut versucht.
            }
        }
    }

    [Microsoft.JSInterop.JSInvokable]
    public void SchliesseUserMenu()
    {
        if (userMenuOffen)
        {
            userMenuOffen = false;
            StateHasChanged();
        }
    }

    private void SchliesseMenuBeiNavigation(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!userMenuOffen) return;
        userMenuOffen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private static string Initialen(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var teile = name.Split([' ', '.', '_', '-'], StringSplitOptions.RemoveEmptyEntries);
        return teile.Length == 1
            ? teile[0][..Math.Min(2, teile[0].Length)].ToUpperInvariant()
            : string.Concat(teile[0][0], teile[^1][0]).ToUpperInvariant();
    }

    private void OeffneKasse()
    {
        KassenState.Wiederherstellen();
        Nav.NavigateTo("/caisse");
    }

    public void Dispose()
    {
        KassenState.OnChange -= StateHasChanged;
        BesitzerPinState.OnChange -= StateHasChanged;
        Nav.LocationChanged -= SchliesseMenuBeiNavigation;
        selfRef?.Dispose();
    }
}
