    <script>
        // Einblenden beim Scrollen wie auf den Startseiten von eNOTE und SKOULOU (23.11.2026): .lp-reveal-Elemente bekommen
        // « sichtbar », sobald sie ins Bild kommen (CSS-Übergang, --lp-verz staffelt). Ersetzt « animation-timeline », das Safari
        // (iPhone) und Firefox nicht kennen. Hier im Kopf, damit es schon beim Aufbau der Seite läuft (bei langsamem Netz nichts
        // länger unsichtbar als nötig). Die Seite ist rein statisch: kein Blazor, das sie danach noch einmal ersetzt.
        // Ohne JavaScript, ohne IntersectionObserver oder bei « Bewegung reduzieren »: kein lp-js, alles sofort sichtbar.
        (function () {
            if (!('IntersectionObserver' in window) || (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches)) return;
            var html = document.documentElement;
            var io = new IntersectionObserver(function (eintraege) {
                eintraege.forEach(function (e) {
                    if (!e.isIntersecting) return;
                    io.unobserve(e.target);
                    e.target.classList.add('sichtbar');
                });
            }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
            function erfasse() {
                var liste = document.querySelectorAll('.lp-reveal');
                for (var i = 0; i < liste.length; i++) {
                    if (liste[i].lpErfasst) continue;
                    liste[i].lpErfasst = true;
                    io.observe(liste[i]);
                }
            }
            // Während des Ladens neue Elemente sofort erfassen; danach ändert sich die Seite nicht mehr.
            var mo = new MutationObserver(erfasse);
            mo.observe(html, { childList: true, subtree: true });
            document.addEventListener('DOMContentLoaded', function () { erfasse(); mo.disconnect(); });
            html.classList.add('lp-js');
        })();
    </script>
