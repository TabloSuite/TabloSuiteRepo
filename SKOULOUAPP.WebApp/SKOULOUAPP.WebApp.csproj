<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <Content Remove="web.config" />
    <!-- Werkzeuge für die Tailwind-Erzeugung gehören nicht ins Veröffentlichungspaket. -->
    <Content Remove="package.json;package-lock.json" />
    <None Include="package.json;tailwind.config.js;Styles\tailwind.css" />
  </ItemGroup>

  <!--
    Tailwind statisch erzeugen (wwwroot/css/tailwind.css, eingecheckt). Läuft nur, wenn `npm install`
    im Projektordner ausgeführt wurde, und nur bei geänderten Razor-/C#-Dateien. Ohne Node bleibt die
    eingecheckte Datei unverändert (z. B. Build-Server).
  -->
  <ItemGroup>
    <TailwindEingabe Include="Components\**\*.razor;Components\**\*.cs;Services\**\*.cs;wwwroot\js\**\*.js;tailwind.config.js;Styles\tailwind.css" />
  </ItemGroup>
  <Target Name="SkoulouTailwind" BeforeTargets="BeforeBuild"
          Condition="'$(DesignTimeBuild)' != 'true' And Exists('$(MSBuildProjectDirectory)\node_modules\.bin\tailwindcss.cmd')"
          Inputs="@(TailwindEingabe)" Outputs="wwwroot\css\tailwind.css">
    <Exec Command="npm run css --silent" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\SKOULOUAPP.Core\SKOULOUAPP.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SkoulouApp.WebApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include=".github\upgrades\scenarios\dotnet-version-upgrade\scenario-instructions.md" />
    <None Include="web.config" />
  </ItemGroup>

  <ItemGroup>
    <!-- Erlaubt dem Testprojekt den Zugriff auf interne Typen wie EmailTemplates. -->
    <InternalsVisibleTo Include="SKOULOUAPP.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <!-- .NET-10-Verhalten: NavigationManager.NavigateTo wirft in statischem SSR keine NavigationException mehr. -->
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>43aa6e7c-6ec6-4dc0-8010-6b3660d72e6a</UserSecretsId>
  </PropertyGroup>
</Project>
