{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=SKOULOUAPPDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Encrypt=True",
    "AzureDefaultConnection": "Server=localhost;Database=SKOULOUAPPDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Encrypt=True"
  },
  "Database": {
    "ConnectionStringName": "DefaultConnection",
    "ApplyMigrationsOnStartup": false
  },
  "MediaStorage": {
    "RootFolder": "wwwroot/media",
    "PublicBasePath": "media"
  },
  "AzureBlobStorage": {
    "Enabled": true,
    "BlobConnectionString": "DefaultEndpointsProtocol=https;AccountName=halloappmediastore;AccountKey={MyAzureBlobStorageAccountKey};EndpointSuffix=core.windows.net",
    "ContainerName": "lesson-media"
  },
  "App": {
    "BaseUrl": "https://meinehalloapp.com"
  },
  "Postmark": {
    "Enabled": true,
    "ServerToken": "{MyPostmarkServerToken}",
    "FromEmail": "kontakt.etse@meinehalloapp.com",
    "FromName": "SKOULOUAPP",
    "SupportEmail": "kontakt.etse@meinehalloapp.com",
    "MessageStream": "outbound"
  },
  "OpenAI": {
    "ApiKey": "sk-..."
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
