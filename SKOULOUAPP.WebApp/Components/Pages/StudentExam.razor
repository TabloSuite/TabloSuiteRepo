@page "/student/exams/{ExamId:guid}"
@attribute [Authorize(Policy = "RequireStudent")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits SkoulouApp.WebApp.Components.CancelableComponentBase
@using SkoulouApp.Core.Services.Text

<PageTitle>@(session?.Title ?? "Épreuve")</PageTitle>

@if (review is not null)
{
    <section class="grid gap-5">
        <div class="rounded-[2rem] bg-gradient-to-br from-slate-800 to-indigo-900 p-6 text-white shadow-xl">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-indigo-200">Correction de l'épreuve</p>
            <h1 class="mt-2 text-2xl font-black">@review.CourseCode · @review.Title</h1>
            <p class="mt-2 text-sm text-white/90">Score : <strong>@review.ScorePercent %</strong> · Seuil : @review.PassingScore %</p>
            <p class="mt-2 text-xs text-white/80">Lecture seule : tes réponses incorrectes ou absentes sont en rouge et les bonnes réponses en vert.</p>
        </div>

        @foreach (var question in review.Questions)
        {
            <article class="rounded-3xl border p-5 shadow-sm @(question.IsCorrect ? "border-emerald-300 bg-emerald-50/40" : "border-rose-300 bg-rose-50/40")">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-500">Question @question.Order</p>
                    <Badge Accent="@(question.IsCorrect ? "emerald" : "rose")">@(question.IsCorrect ? "Correct" : question.HasAnswer ? "Incorrect" : "Non répondu")</Badge>
                </div>
                <div class="ql-snow mt-3"><div class="ql-editor p-0 text-base font-semibold text-slate-900">@((MarkupString)HtmlSanitizer.SanitizeMitBildern(question.Prompt))</div></div>

                @if (question.Options.Count > 0)
                {
                    <div class="mt-4 grid gap-2">
                        @foreach (var option in question.Options)
                        {
                            var selected = question.SelectedOptionId == option.OptionId || question.SelectedOptionIds.Contains(option.OptionId);
                            var optionClass = option.IsCorrect
                                ? "border-emerald-300 bg-emerald-50 text-emerald-900"
                                : selected
                                    ? "border-rose-300 bg-rose-50 text-rose-900"
                                    : "border-slate-200 bg-white text-slate-600";
                            <div class="rounded-2xl border px-4 py-3 text-sm font-medium @optionClass">
                                <span class="mr-2">@(option.IsCorrect ? "✓" : selected ? "✕" : "○")</span>@HtmlSanitizer.ToPlainText(option.Text)
                            </div>
                        }
                    </div>
                }
                else if (question.QuestionType == "GapFill")
                {
                    <div class="mt-4 grid gap-3">
                        @for (var i = 0; i < question.CorrectGapAnswers.Count; i++)
                        {
                            var answer = i < question.GapAnswers.Count ? question.GapAnswers[i] : string.Empty;
                            var correct = question.CorrectGapAnswers[i];
                            var isGapCorrect = correct.Any(value => AnswerMatches(answer, value));
                            <div class="grid gap-2 sm:grid-cols-2">
                                <div class="rounded-xl border p-3 text-sm @(isGapCorrect ? "border-emerald-200 bg-emerald-50 text-emerald-900" : "border-rose-200 bg-rose-50 text-rose-900")"><strong>Ta réponse :</strong> @(string.IsNullOrWhiteSpace(answer) ? "Non répondu" : answer)</div>
                                <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-900"><strong>Bonne réponse :</strong> @string.Join(" / ", correct)</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="mt-4 grid gap-2">
                        <div class="rounded-xl border p-3 text-sm @(question.IsCorrect ? "border-emerald-200 bg-emerald-50 text-emerald-900" : "border-rose-200 bg-rose-50 text-rose-900")"><strong>Ta réponse :</strong> @(string.IsNullOrWhiteSpace(question.TextAnswer) ? "Non répondu" : question.TextAnswer)</div>
                        @if (question.AcceptedAnswers.Count > 0)
                        {
                            <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-900"><strong>Bonne réponse :</strong> @string.Join(" / ", question.AcceptedAnswers)</div>
                        }
                        @if (question.IsManuallyGraded)
                        {
                            <div class="rounded-xl border border-indigo-200 bg-indigo-50 p-3 text-sm text-indigo-900"><strong>Correction de l'enseignant :</strong> @(question.ManualPoints.HasValue ? $"{question.ManualPoints}/{question.Points} points" : "En attente")</div>
                        }
                    </div>
                }
            </article>
        }
        <a class="w-fit rounded-full bg-indigo-700 px-5 py-2 text-sm font-semibold text-white no-underline" href="/student/exams">Retour aux épreuves</a>
    </section>
}
else if (session is null && result is null)
{
    <div class="rounded-[2rem] bg-white p-8 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
        <p class="text-sm text-slate-600">@(notFound ? "Cette épreuve n'est pas disponible." : "Préparation de l'épreuve...")</p>
        <a class="mt-4 inline-block rounded-full bg-amber-600 px-5 py-2 text-sm font-semibold text-white no-underline" href="/student/exams">Retour aux épreuves</a>
    </div>
}
else if (result is not null)
{
    <section class="grid gap-6">
        <div class="rounded-[2rem] @(result.IsPassed ? "bg-gradient-to-br from-emerald-500 to-teal-600" : "bg-gradient-to-br from-rose-500 to-orange-600") p-8 text-white shadow-2xl">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-white/80">Résultat</p>
            <h1 class="mt-3 text-4xl font-black" style="color:@ScoreColorHelper.GetScoreColor(result.ScorePercent)">@result.ScorePercent %</h1>
            <p class="mt-2 text-lg font-semibold">@(result.IsPassed ? "Réussi 🎉" : "Échoué")</p>
            <p class="mt-3 text-sm text-white/90">@result.CorrectAnswers bonnes réponses sur @result.TotalQuestions · Seuil de réussite @result.PassingScore %</p>
            @if (result.TimedOut)
            {
                <p class="mt-2 rounded-full bg-white/20 px-3 py-1 text-xs font-semibold inline-block">Temps écoulé – évalué avec les réponses envoyées.</p>
            }
            @if (result.RequiresManualGrading)
            {
                <p class="mt-2 rounded-full bg-white/20 px-3 py-1 text-xs font-semibold inline-block">Certaines réponses seront corrigées par ton enseignant. Le résultat final peut encore changer.</p>
            }
        </div>
        <div class="flex flex-wrap gap-3">
            <a class="rounded-full bg-amber-600 px-5 py-2 text-sm font-semibold text-white no-underline transition hover:bg-amber-700" href="/student/exams">Retour à la liste</a>
            <a class="rounded-full border border-slate-200 px-5 py-2 text-sm font-semibold text-slate-700 no-underline transition hover:bg-slate-50" href="/student/lessons">Continuer à s'entraîner</a>
        </div>
    </section>
}
else if (session is not null)
{
    <section class="grid gap-6">
        @if (showLeaveConfirmation)
        {
            <div class="rounded-2xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-950">
                <p>Le chronomètre continue si tu quittes l'épreuve. Tu pourras reprendre avec le temps restant. Tes réponses sont enregistrées.</p>
                <div class="mt-3 flex gap-3">
                    <button type="button" class="rounded-full bg-amber-700 px-4 py-2 font-semibold text-white" @onclick="LeaveExamAsync">Quitter l'épreuve</button>
                    <button type="button" class="rounded-full bg-white px-4 py-2 font-semibold" @onclick="() => showLeaveConfirmation = false">Continuer l'épreuve</button>
                </div>
            </div>
        }
        <div class="sticky top-2 z-10 flex flex-wrap items-center justify-between gap-4 rounded-2xl bg-white/95 p-4 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 backdrop-blur">
            <div class="min-w-0">
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-600">@session.CourseCode · @session.Title</p>
                <p class="mt-1 text-sm text-slate-600">@answeredCount / @session.Questions.Count répondues</p>
            </div>
            <div class="flex items-center gap-3 max-sm:w-full max-sm:justify-between">
                <button type="button"
                        class="inline-flex items-center justify-center rounded-full bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-50"
                        disabled="@isSubmitting"
                        @onclick="() => SubmitAsync(false)">
                    @(isSubmitting ? "Envoi en cours..." : "Envoyer l'épreuve")
                </button>
                <div class="progress-ring shrink-0" style="--ring-percent:@TimerRingPercent; --ring-color:@TimerRingColor;">
                    <span class="progress-ring-label tabular-nums">@FormattedTime</span>
                </div>
            </div>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-2">
            @for (var qi = 0; qi < session.Questions.Count; qi++)
            {
                var dotIndex = qi;
                var dotQuestion = session.Questions[dotIndex];
                <button type="button"
                        title="@("Question " + (dotIndex + 1))"
                        class="@GetQuestionDotClass(dotIndex, dotQuestion)"
                        @onclick="() => GoToQuestion(dotIndex)"></button>
            }
        </div>

        @{
            var question = CurrentQuestion;
        }
        @if (question is not null)
        {
            <p class="text-center text-xs font-semibold uppercase tracking-[0.14em] text-amber-600">Question @(currentQuestionIndex + 1) / @session.Questions.Count</p>
            <article class="card-stack-enter rounded-[2rem] bg-white p-5 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 sm:p-6" @key="question.QuestionId">
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-600">Question @question.Order</p>
                <div class="mt-1 flex flex-wrap items-center gap-3">
                    <div class="ql-snow min-w-0 flex-1"><div class="ql-editor p-0 text-base font-semibold text-slate-900">@((MarkupString)HtmlSanitizer.SanitizeMitBildern(question.Prompt))</div></div>
                    @if (IsAudioType(question.QuestionType) && !string.IsNullOrWhiteSpace(question.AudioText))
                    {
                        <button type="button"
                                class="inline-flex items-center gap-2 rounded-full bg-cyan-600 px-4 py-2 text-sm font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-cyan-700"
                                data-skoulouapp-tts-text="@question.AudioText"
                                data-skoulouapp-tts-lang="@question.TtsLanguage"
                                >
                            🔊 Écouter
                        </button>
                    }
                </div>

                @if (IsMultipleChoiceType(question.QuestionType))
                {
                    <div class="mt-4 grid gap-2">
                        @foreach (var option in question.Options)
                        {
                            var isSelected = IsOptionSelected(question.QuestionId, option.OptionId);
                            <button type="button"
                                    class="@(isSelected ? "w-full rounded-2xl border border-amber-400 bg-amber-50 px-4 py-3 text-left text-sm font-medium text-amber-800" : "w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-left text-sm font-medium text-slate-700 transition hover:border-amber-200 hover:bg-slate-50")"
                                    @onclick="() => ToggleOption(question.QuestionId, option.OptionId)">
                                <span class="mr-2">@(isSelected ? "☑" : "☐")</span>@HtmlSanitizer.ToPlainText(option.Text)
                            </button>
                        }
                    </div>
                }
                else if (IsChoiceType(question.QuestionType))
                {
                    <div class="mt-4 grid gap-2">
                        @foreach (var option in question.Options)
                        {
                            var isSelected = answers.TryGetValue(question.QuestionId, out var sel) && sel == option.OptionId;
                            <button type="button"
                                    class="@(isSelected ? "w-full rounded-2xl border border-amber-400 bg-amber-50 px-4 py-3 text-left text-sm font-medium text-amber-800" : "w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-left text-sm font-medium text-slate-700 transition hover:border-amber-200 hover:bg-slate-50")"
                                    @onclick="() => Select(question.QuestionId, option.OptionId)">
                                @HtmlSanitizer.ToPlainText(option.Text)
                            </button>
                        }
                    </div>
                }
                else if (question.QuestionType == "GapFill")
                {
                    <div class="mt-4 grid gap-3">
                        @for (var i = 0; i < question.GapCount; i++)
                        {
                            var gapIndex = i;
                            <div class="flex items-center gap-3">
                                <span class="text-sm font-semibold text-slate-500">Blanc @(gapIndex + 1)</span>
                                <div class="flex-1">
                                    <RichTextEditor Value="@GetGapValue(question.QuestionId, gapIndex)"
                                                    ValueChanged="value => SetGapValue(question.QuestionId, question.GapCount, gapIndex, value)"
                                                    Placeholder="Ta réponse..."
                                                    ReadOnly="@(result is not null)"
                                                    EnableLargeEditor="true"
                                                    Paged="true"
                                                    MinEditorHeightRem="3" />
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="mt-4">
                        <RichTextEditor Value="@GetTextAnswer(question.QuestionId)"
                                        ValueChanged="value => SetTextAnswer(question.QuestionId, value)"
                                        Placeholder="Ta réponse..."
                                        Paged="true"
                                        ReadOnly="@(result is not null)" />
                    </div>
                }
            </article>

            <div class="flex items-center justify-between gap-3">
                <button type="button"
                        class="rounded-full border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-600 transition duration-200 hover:-translate-y-0.5 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40"
                        disabled="@IsFirstQuestion"
                        @onclick="GoToPreviousQuestion">
                    ← Précédent
                </button>
                <button type="button"
                        class="rounded-full border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-600 transition duration-200 hover:-translate-y-0.5 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40"
                        disabled="@IsLastQuestion"
                        @onclick="GoToNextQuestion">
                    Suivant →
                </button>
            </div>
        }

        <div class="border-t border-slate-200 pt-5">
            <button type="button" class="rounded-full border border-slate-200 px-5 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" @onclick="() => showLeaveConfirmation = true">Quitter l'épreuve</button>
        </div>
    </section>
}
