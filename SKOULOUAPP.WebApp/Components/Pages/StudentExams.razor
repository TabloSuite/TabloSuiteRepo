@page "/student/exams"
@attribute [Authorize(Policy = "RequireStudent")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits SkoulouApp.WebApp.Components.CancelableComponentBase
@using SkoulouApp.Core.Models.Student

<PageTitle>Mes épreuves · SKOULOU</PageTitle>

@if (exams is null)
{
    <SkeletonLoader />
}
else
{
    <div class="student-exams-page grid gap-5">
        <SeitenKopf Rubrik="Espace élève" Titel="Mes épreuves" IconName="exam"
                    Untertitel="Commencez une épreuve dès qu'elle est publiée. Le chronomètre continue même si vous quittez la page." />

        <p class="mb-0 flex items-start gap-2 rounded-2xl border border-blue-100 bg-blue-50 px-4 py-3 text-sm text-blue-900">
            <Icon Name="info" Groesse="18" /><span>Si une date limite commune est indiquée, vos réponses doivent aussi être envoyées avant cette date : commencer tard peut réduire votre temps disponible.</span>
        </p>

        @if (exams.Count == 0)
        {
            <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
                <h2 class="mb-0 text-base font-bold text-slate-900">Aucune épreuve disponible</h2>
                <p class="mb-0 mt-2 text-sm text-slate-600">Aucune épreuve n'est encore disponible pour votre classe.</p>
            </div>
        }
        else
        {
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
                <DataListPanel Items="exams"
                               PageSize="10"
                               SearchPlaceholder="Rechercher une épreuve..."
                               EmptyText="Aucune épreuve correspondante."
                               ResultLabelSingular="épreuve"
                               ResultLabelPlural="épreuves"
                               Filter="@((ExamListItem e, string term) => Contains(e.Title, term) || Contains(e.CourseCode, term) || Contains(e.Description, term))">
                    <div class="grid gap-3 lg:grid-cols-2 xl:grid-cols-3">
                        @foreach (var exam in context)
                        {
                    <article class="card-stack-enter flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-4 transition duration-200 hover:border-blue-200 hover:shadow-md">
                        <div class="flex flex-wrap items-start justify-between gap-2">
                            <div>
                                <p class="mb-0 text-xs font-semibold text-slate-500">@exam.CourseCode</p>
                                <h2 class="mb-0 mt-1 text-base font-bold text-slate-900">@exam.Title</h2>
                            </div>
                            <div class="flex flex-wrap items-center justify-end gap-2">
                                @if (exam.CanDownloadPdf)
                                {
                                    <a class="sk-btn sk-btn-sm sk-btn-secondary" href="/student/exams/@exam.ExamId/pdf-file" target="_blank" title="PDF sans solutions"><Icon Name="printer" Groesse="14" />PDF</a>
                                }
                                @if (exam.HasAttempt)
                                {
                                    <Badge Accent="@(exam.IsPassed ? "emerald" : "rose")">
                                        @(exam.IsPassed ? "Réussi" : "Échoué") · <span class="font-black" style="color:@ScoreColorHelper.GetScoreColor(exam.BestScorePercent)">@exam.BestScorePercent %</span>
                                    </Badge>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(exam.Description))
                        {
                            <p class="mb-0 line-clamp-2 text-sm text-slate-600">@exam.Description</p>
                        }

                        <div class="flex flex-wrap gap-x-3 gap-y-1 text-xs font-medium text-slate-600">
                            <span>@exam.QuestionCount questions</span><span aria-hidden="true">·</span>
                            <span>@exam.DurationInMinutes min</span><span aria-hidden="true">·</span>
                            <span>Seuil @exam.PassingScore %</span>
                        </div>
                        @if (!exam.IsSuperseded && exam.SubmissionDueAtUtc is DateTime dueAtUtc)
                        {
                            var fullDurationStartUtc = dueAtUtc.AddMinutes(-exam.DurationInMinutes);
                            <div class="rounded-xl border border-blue-100 bg-blue-50 px-3 py-2 text-xs leading-5 text-blue-900">
                                <p class="mb-0 font-bold">Date limite pour commencer et envoyer : @dueAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                                @if (exam.CanStart && !exam.HasActiveAttempt)
                                {
                                    <p class="mb-0 mt-1 @(DateTime.UtcNow > fullDurationStartUtc ? "font-semibold text-rose-700" : "text-blue-800")">
                                        @(DateTime.UtcNow > fullDurationStartUtc
                                            ? $"Commencez dès maintenant : il reste moins de {exam.DurationInMinutes} min avant la date limite."
                                            : $"Pour disposer des {exam.DurationInMinutes} min complètes, commencez au plus tard le {fullDurationStartUtc.ToLocalTime():dd/MM/yyyy à HH:mm}.")
                                    </p>
                                }
                            </div>
                        }

                        @if (exam.HasActiveAttempt)
                        {
                            <p class="mb-0 text-sm font-semibold @(exam.CanStart ? "text-amber-700" : "text-rose-700")">@GetRemainingTime(exam)</p>
                        }
                        @if (!exam.CanStart)
                        {
                            <p class="mb-0 text-xs text-slate-600">@(exam.IsSuperseded
                                ? "Cette session est terminée. Consultez vos résultats ou la nouvelle attribution."
                                : exam.HasAttempt
                                    ? "Vous avez déjà envoyé cette épreuve. Pour recommencer, attendez une nouvelle attribution de votre enseignant."
                                : exam.FirstDeadlineUtc <= DateTime.UtcNow
                                    ? "Votre temps de composition est écoulé. Attendez une nouvelle attribution de votre enseignant."
                                    : "La date limite pour commencer et envoyer cette épreuve est dépassée.")</p>
                        }

                        <button type="button"
                                class="sk-btn @(exam.HasAttempt ? "sk-btn-secondary" : "sk-btn-primary") mt-auto w-full self-start sm:w-auto"
                                disabled="@(!exam.CanStart && !exam.HasAttempt)"
                                @onclick="() => StartExam(exam.ExamId)">
                            @(exam.HasAttempt ? "Consulter la correction" : exam.CanStart ? exam.HasActiveAttempt ? "Reprendre l'épreuve" : "Commencer l'épreuve" : exam.IsSuperseded ? "Session précédente" : "Épreuve terminée")
                        </button>
                    </article>
                        }
                    </div>
                </DataListPanel>
            </div>
        }
    </div>
}
