@page "/student/exams"
@attribute [Authorize(Policy = "RequireStudent")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits SkoulouApp.WebApp.Components.CancelableComponentBase
@using SkoulouApp.Core.Models.Student

<PageTitle>Épreuves</PageTitle>

@if (exams is null)
{
    <SkeletonLoader />
}
else
{
    <section class="student-exams-page grid gap-4 sm:gap-6">
        <div class="rounded-[1.25rem] bg-gradient-to-br from-amber-500 via-orange-600 to-rose-600 px-4 py-3 text-white shadow-2xl shadow-orange-200/60 sm:px-6 sm:py-5 skoulou-hero">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-100 sm:text-sm">Espace épreuves</p>
            <h1 class="mt-2 text-2xl font-black sm:mt-3 sm:text-3xl">Mes épreuves</h1>
            <p class="mt-2 max-w-2xl text-xs leading-6 text-amber-50 sm:mt-3 sm:text-sm sm:leading-7">Tu peux commencer une épreuve dès qu'elle est publiée. Le chronomètre continue même si tu quittes la page. Si une date limite commune est indiquée, tu dois aussi envoyer tes réponses avant cette date : commencer tard peut réduire ton temps disponible.</p>
        </div>

        @if (exams.Count == 0)
        {
            <div class="rounded-[2rem] bg-white p-8 text-center shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
                    <h2 class="text-lg font-black text-slate-900">Aucune épreuve disponible</h2>
                    <p class="mt-2 text-sm text-slate-600">Aucune épreuve n'est encore disponible pour ta classe actuelle.</p>
            </div>
        }
        else
        {
            <div class="rounded-[2rem] bg-white p-4 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 sm:p-5">
                <DataListPanel Items="exams"
                               PageSize="10"
                               SearchPlaceholder="Rechercher une épreuve..."
                               EmptyText="Aucune épreuve correspondante."
                               ResultLabelSingular="épreuve"
                               ResultLabelPlural="épreuves"
                               Filter="@((ExamListItem e, string term) => Contains(e.Title, term) || Contains(e.CourseCode, term) || Contains(e.Description, term))">
                    <div class="grid gap-3 lg:grid-cols-2 xl:grid-cols-3">
                        @foreach (var exam in context)
                        {
                    <article class="card-stack-enter flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-md shadow-slate-200/70 transition duration-200 hover:-translate-y-0.5 hover:border-amber-200 hover:shadow-lg">
                        <div class="flex flex-wrap items-start justify-between gap-2">
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-amber-600">@exam.CourseCode</p>
                                <h2 class="mt-1 text-lg font-bold text-slate-900">@exam.Title</h2>
                            </div>
                            <div class="flex flex-wrap items-center justify-end gap-2">
                                @if (exam.CanDownloadPdf)
                                {
                                    <a class="inline-flex rounded-full bg-cyan-100 px-3 py-1.5 text-xs font-semibold text-cyan-800 no-underline hover:bg-cyan-200" href="/student/exams/@exam.ExamId/pdf-file" target="_blank">PDF sans solutions</a>
                                }
                                @if (exam.HasAttempt)
                                {
                                    <Badge Accent="@(exam.IsPassed ? "emerald" : "rose")">
                                        @(exam.IsPassed ? "Réussi" : "Échoué") · <span class="font-black" style="color:@ScoreColorHelper.GetScoreColor(exam.BestScorePercent)">@exam.BestScorePercent %</span>
                                    </Badge>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(exam.Description))
                        {
                            <p class="line-clamp-2 text-sm text-slate-600">@exam.Description</p>
                        }

                        <div class="flex flex-wrap gap-x-3 gap-y-1 text-xs font-medium text-slate-600">
                            <span>@exam.QuestionCount questions</span><span aria-hidden="true">·</span>
                            <span>@exam.DurationInMinutes min</span><span aria-hidden="true">·</span>
                            <span>Seuil @exam.PassingScore %</span>
                        </div>
                        @if (!exam.IsSuperseded && exam.SubmissionDueAtUtc is DateTime dueAtUtc)
                        {
                            var fullDurationStartUtc = dueAtUtc.AddMinutes(-exam.DurationInMinutes);
                            <div class="rounded-xl border border-indigo-100 bg-indigo-50 px-3 py-2 text-xs leading-5 text-indigo-900">
                                <p class="font-bold">Date limite pour commencer et envoyer : @dueAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                                @if (exam.CanStart && !exam.HasActiveAttempt)
                                {
                                    <p class="mt-1 @(DateTime.UtcNow > fullDurationStartUtc ? "font-semibold text-rose-700" : "text-indigo-800")">
                                        @(DateTime.UtcNow > fullDurationStartUtc
                                            ? $"Commence dès maintenant : il reste moins de {exam.DurationInMinutes} min avant la date limite."
                                            : $"Pour disposer des {exam.DurationInMinutes} min complètes, commence au plus tard le {fullDurationStartUtc.ToLocalTime():dd/MM/yyyy à HH:mm}.")
                                    </p>
                                }
                            </div>
                        }

                        @if (exam.HasActiveAttempt)
                        {
                            <p class="text-sm font-semibold @(exam.CanStart ? "text-amber-700" : "text-rose-700")">@GetRemainingTime(exam)</p>
                        }
                        @if (!exam.CanStart)
                        {
                            <p class="text-xs text-slate-600">@(exam.IsSuperseded
                                ? "Cette session est terminée. Consulte tes résultats ou la nouvelle attribution."
                                : exam.HasAttempt
                                    ? "Tu as déjà envoyé cette épreuve. Pour recommencer, attends une nouvelle attribution de ton enseignant."
                                : exam.FirstDeadlineUtc <= DateTime.UtcNow
                                    ? "Ton temps de composition est écoulé. Attends une nouvelle attribution de ton enseignant."
                                    : "La date limite pour commencer et envoyer cette épreuve est dépassée.")</p>
                        }

                        <button type="button"
                                class="inline-flex w-full items-center justify-center self-start rounded-full bg-amber-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-amber-700 disabled:cursor-not-allowed disabled:opacity-50 sm:w-auto"
                                disabled="@(!exam.CanStart && !exam.HasAttempt)"
                                @onclick="() => StartExam(exam.ExamId)">
                            @(exam.HasAttempt ? "Consulter la correction" : exam.CanStart ? exam.HasActiveAttempt ? "Reprendre l'épreuve" : "Commencer l'épreuve" : exam.IsSuperseded ? "Session précédente" : "Épreuve terminée")
                        </button>
                    </article>
                        }
                    </div>
                </DataListPanel>
            </div>
        }
    </section>
}
