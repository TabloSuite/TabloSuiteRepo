@page "/bulletins"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SchulLeiter,Koordinator,Schüler")]
@inherits CancelableComponentBase
@using SkoulouApp.WebApp.Services

<PageTitle>Bulletins scolaires</PageTitle>
<div class="mx-auto max-w-6xl space-y-5 p-4">
    <header class="rounded-2xl bg-slate-900 p-6 text-white"><a href="/" class="text-sky-300">← Accueil</a><h1 class="mt-3 text-2xl font-bold">Bulletins scolaires</h1></header>
    @if (message.Length > 0) { <p role="status" class="rounded-xl bg-slate-100 p-4">@message</p> }
    <ModernDropdown TValue="Guid" Value="schulID" ValueChanged="EcoleAsync" Options="Options(schulen)" Label="École" EinzigeOptionFest="true" Disabled="occupe" />
    @if (verwalter && unterricht is not null)
    {
        <details class="rounded-xl border bg-white p-5"><summary class="cursor-pointer text-lg font-semibold">Modèles par classe</summary>
            <div class="mt-4 grid gap-4 md:grid-cols-2">
                <ModernDropdown TValue="Guid" @bind-Value="vorlage.KlasseID" Options="Options(unterricht.Klassen)" Label="Classe" />
                <ModernDropdown TValue="int" @bind-Value="art" Options="Arten" Label="Type de bulletin" />
                <label>Nom du modèle<input class="w-full rounded-lg border p-2" maxlength="120" @bind="vorlage.Name" /></label>
                <label>Couleur<input type="color" class="w-full" @bind="vorlage.AkzentFarbe" /></label>
                <ModernDropdown TValue="Guid?" Value="vorlage.LogoAssetID" ValueChanged="LogoWaehlen" Options="BildOptionen" Label="Logo de l'école (facultatif)" Disabled="occupe" />
                <div class="rounded-xl border bg-slate-50 p-3">
                    <label class="block font-semibold">Importer le logo de l'école
                        <Microsoft.AspNetCore.Components.Forms.InputFile OnChange="LogoHochladenAsync" accept="image/png,image/jpeg" disabled="@occupe" class="mt-2 block w-full min-w-0 text-sm" />
                    </label>
                    <p class="mt-2 text-sm">PNG ou JPEG, 2 Mo maximum. Aucun cachet numérisé : la direction signe et appose le cachet sur le document imprimé.</p>
                    @if (logoVorschau is not null)
                    {
                        <img src="@logoVorschau" alt="Aperçu du logo de l'école" class="mt-3 h-20 max-w-full object-contain" />
                    }
                    @if (vorlage.LogoAssetID.HasValue)
                    {
                        <button type="button" class="mt-2 rounded border p-2" disabled="@occupe" @onclick="() => LogoWaehlen(null)">Retirer du modèle</button>
                    }
                </div>
                <label><input type="checkbox" @bind="vorlage.ZeigeKoeffizienten" /> Afficher les coefficients</label>
                <label><input type="checkbox" @bind="vorlage.ZeigeRang" /> Afficher le rang</label>
                <label><input type="checkbox" @bind="vorlage.ZeigeVorperioden" /> Afficher les périodes précédentes</label>
                <label><input type="checkbox" @bind="vorlage.ZeigeUnterschriften" /> Afficher les signatures</label>
                <label>Taille du texte (8 à 12 points)<input type="number" min="8" max="12" class="w-full rounded-lg border p-2" @bind="vorlage.SchriftGroesse" /></label>
                <label>Marges A4 (15 à 50 points)<input type="number" min="15" max="50" class="w-full rounded-lg border p-2" @bind="vorlage.SeitenRand" /></label>
                <label><input type="checkbox" @bind="vorlage.ZeigeLehrkraefte" /> Afficher la colonne des enseignants</label>
                <label><input type="checkbox" @bind="vorlage.ZeigeAnwesenheit" /> Afficher les présences et retards</label>
                <label>Texte de bas de page<input class="w-full rounded-lg border p-2" maxlength="300" @bind="vorlage.FussText" /></label>
            </div>
            <button type="button" class="mt-3 rounded-lg bg-blue-700 p-3 text-white" disabled="@occupe" @onclick="ModeleAsync">Enregistrer le modèle</button>
            <fieldset class="mt-4 min-w-0 space-y-3 rounded-xl border p-4" disabled="@occupe">
                <legend class="px-2 font-semibold">Appliquer ce modèle à plusieurs classes</legend>
                <p class="text-sm">Les réglages actuels sont copiés pour le type de bulletin choisi. Chaque classe pourra ensuite être adaptée séparément. Les bulletins déjà publiés ne changent pas.</p>
                <label class="block">Rechercher une classe<input class="mt-1 w-full rounded-lg border p-2" @bind="klassenSuche" @bind:event="oninput" /></label>
                <div class="flex flex-wrap gap-2">
                    <button type="button" class="rounded-lg border p-2" @onclick="() => VorlagenAuswahl(true)">Sélectionner les résultats</button>
                    <button type="button" class="rounded-lg border p-2" @onclick="() => VorlagenAuswahl(false)">Tout désélectionner</button>
                    <span class="self-center text-sm">@vorlagenKlassen.Count classe(s) sélectionnée(s)</span>
                </div>
                <div class="grid max-h-64 gap-2 overflow-y-auto sm:grid-cols-2">
                    @foreach (var klasse in GefilterteVorlagenKlassen)
                    {
                        <label class="flex min-w-0 items-start gap-2 rounded-lg border p-2">
                            <input type="checkbox" checked="@vorlagenKlassen.Contains(klasse.Id)" @onchange="e => VorlageKlasseWaehlen(klasse.Id, e.Value is true)" />
                            <span class="break-words">@klasse.Bezeichnung @(modeles.Any(m => m.KlasseID == klasse.Id && (int)m.Art == art) ? "· Modèle existant" : "")</span>
                        </label>
                    }
                </div>
                @if (VorhandeneVorlagen > 0)
                {
                    <p class="text-sm text-amber-800">@VorhandeneVorlagen modèle(s) existant(s) seront remplacés dans les classes sélectionnées.</p>
                    <label class="flex items-start gap-2"><input type="checkbox" @bind="vorlagenErsetzen" /><span>Je confirme le remplacement des modèles existants pour ce type de bulletin.</span></label>
                }
                <button type="button" class="rounded-lg bg-blue-700 p-3 text-white disabled:opacity-50" disabled="@(occupe || vorlagenKlassen.Count == 0 || (VorhandeneVorlagen > 0 && !vorlagenErsetzen))" @onclick="MehrfachModeleAsync">Appliquer aux classes sélectionnées</button>
            </fieldset>
            <h3 class="mt-4 font-semibold">Ordre des blocs</h3>
            @for (var index = 0; index < vorlage.BlockReihenfolge.Split(',').Length; index++)
            {
                var position = index;
                <div class="mt-2 flex flex-wrap items-center justify-between gap-2 rounded-lg border p-2">
                    <span>@BlockTitel(vorlage.BlockReihenfolge.Split(',')[position])</span>
                    <div><button type="button" class="rounded border p-2" disabled="@(occupe || position == 0)" @onclick="() => VerschiebeBlock(position, -1)" aria-label="Monter le bloc">↑</button>
                    <button type="button" class="rounded border p-2" disabled="@(occupe || position == 4)" @onclick="() => VerschiebeBlock(position, 1)" aria-label="Descendre le bloc">↓</button></div>
                </div>
            }
            <p class="mt-2 text-sm">Enregistrez le modèle, puis prévisualisez un élève pour vérifier le document A4 exact.</p>
            @foreach (var modele in modeles)
            {
                <button type="button" class="m-2 rounded-lg border p-2" disabled="@occupe" @onclick="() => ChargerModele(modele)">@modele.Name · Modifier / copier</button>
            }
        </details>
        <section class="rounded-xl border bg-white p-5">
            <h2 class="text-lg font-semibold">Préparer et publier un bulletin</h2>
            <div class="mt-4 grid gap-4 md:grid-cols-2">
                <ModernDropdown TValue="Guid" Value="jahrID" ValueChanged="JahrAsync" Options="JahresOptionen" Label="Année scolaire" Disabled="occupe" />
                <ModernDropdown TValue="Guid" Value="periodeID" ValueChanged="PeriodeWaehlen" Options="PeriodenOptionen" Label="Période" Disabled="occupe" />
                <ModernDropdown TValue="Guid" Value="schuelerID" ValueChanged="SchuelerWaehlen" Options="SchuelerOptionen" Label="Élève" Searchable="true" Disabled="occupe" />
                <label>Observation<textarea class="w-full rounded-lg border p-2" maxlength="1000" @bind="bemerkung"></textarea></label>
                <label>Motif de l'édition / du retrait<input class="w-full rounded-lg border p-2" maxlength="300" @bind="grund" /></label>
            </div>
            <button type="button" class="mt-3 rounded-lg border p-3" disabled="@occupe" @onclick="VorschauAsync">Prévisualiser</button>
            <p class="mt-2 text-sm text-slate-600">Enregistrez progressivement les notes dans « Notes et évaluations ». Vérifiez ensuite toute la classe ci-dessous avant la publication définitive. Une correction après publication nécessite une rectification.</p>
        </section>
        <section class="space-y-3 rounded-xl border bg-white p-5">
            <h2 class="text-lg font-semibold">Téléchargement groupé des bulletins</h2>
            <p class="text-sm text-slate-600">Utilisez l'école, l'année scolaire et la période sélectionnées ci-dessus, puis choisissez une classe. Seules les éditions actuellement publiées sont incluses, par ordre alphabétique des élèves. Les bulletins manquants ou retirés ne sont pas inclus ; aucune publication n'est effectuée.</p>
            <ModernDropdown TValue="Guid" Value="sammelKlasseID" ValueChanged="AbschlussKlasse" Options="Options(unterricht.Klassen)" Label="Classe à vérifier / exporter" Searchable="true" Disabled="occupe" />
            <button type="button" class="rounded-lg border p-3" disabled="@(!SammelDownloadMoeglich)" @onclick="KlassePruefenAsync">Vérifier toute la classe avant publication</button>
            @if (klassenPruefung is not null)
            {
                <p>@klassenPruefung.Bulletins.Count bulletin(s) complet(s). Ouvrez les aperçus et vérifiez les données avant de confirmer.</p>
                @foreach (var b in klassenPruefung.Bulletins)
                {
                    <button type="button" class="m-1 rounded border p-2" @onclick="() => ZeigeAbschlussVorschau(b)">@b.Schueler · @b.Durchschnitt?.ToString("0.00") / 20 · Aperçu</button>
                }
                <label class="flex items-start gap-2"><input type="checkbox" @bind="endgueltigBestaetigt" /><span>Je confirme avoir vérifié tous les bulletins. Après publication, aucune modification directe ni retrait n'est possible. Toute erreur exige un bulletin rectificatif.</span></label>
                <button type="button" class="rounded-lg bg-red-700 p-3 text-white disabled:opacity-50" disabled="@(occupe || !endgueltigBestaetigt)" @onclick="KlassePublizierenAsync">Publier définitivement les bulletins de la classe</button>
            }
            @if (SammelDownloadMoeglich)
            {
                <a class="inline-block rounded-lg bg-blue-700 p-3 text-white" href="@SammelDownloadUrl" target="_blank" rel="noopener">Télécharger les bulletins publiés (PDF)</a>
            }
            else
            {
                <button type="button" class="rounded-lg bg-slate-200 p-3 text-slate-500" disabled>Télécharger les bulletins publiés (PDF)</button>
                <p class="text-sm">Sélectionnez une période et une classe pour activer le téléchargement.</p>
            }
            <p class="text-sm text-slate-600">Un seul PDF par classe et période, jusqu'à 200 bulletins. Chaque bulletin commence sur une nouvelle page et conserve sa propre numérotation.</p>
        </section>
        <details class="space-y-3 rounded-xl border bg-white p-5"><summary class="cursor-pointer text-lg font-semibold">Rectification après publication</summary>
            <p>Choisissez la classe et la période ci-dessus. Indiquez le motif dans « Motif de l'édition / du retrait », puis ouvrez un brouillon. Les originaux restent inchangés jusqu'à la confirmation.</p>
            <button type="button" class="rounded border p-3" disabled="@(!SammelDownloadMoeglich)" @onclick="BerichtigungStartenAsync">Ouvrir une rectification motivée</button>
            <ModernDropdown TValue="Guid" Value="berichtigungID" ValueChanged="BerichtigungWaehlen" Options="Options(berichtigungen.Where(x => x.SchuljahrID == jahrID).Select(x => new AuswahlEintrag(x.Id, x.Grund)))" Label="Brouillons enregistrés" Disabled="occupe" />
            @if (berichtigungID != Guid.Empty)
            {
                <section class="space-y-3 rounded-lg border p-4">
                    <h3 class="font-semibold">Rectifier l'identité d'un élève</h3>
                    <p class="text-sm">Seuls les bulletins publiés de cet élève pour cette classe et cette année scolaire seront rectifiés si leurs informations diffèrent. Les notes et les rangs restent inchangés. Le profil de l'élève n'est pas modifié ; mettez-le aussi à jour dans la gestion des élèves si nécessaire.</p>
                    <ModernDropdown TValue="Guid" Value="stammdatenSchuelerID" ValueChanged="StammdatenWaehlenAsync" Options="BerichtigungsSchueler" Label="Élève dont l'identité est à rectifier" Searchable="true" Disabled="occupe" />
                    @if (stammdatenGeladen)
                    {
                        <div class="grid gap-3 md:grid-cols-2">
                            <label>Nom complet<input maxlength="200" class="w-full rounded border p-2" @bind="stammdatenName" /></label>
                            <label>Matricule<input maxlength="50" class="w-full rounded border p-2" @bind="stammdatenMatrikel" /></label>
                            <label>Lieu de naissance<input maxlength="150" class="w-full rounded border p-2" @bind="stammdatenGeburtsort" /></label>
                            <label>Date de naissance<input type="date" class="w-full rounded border p-2" @bind="stammdatenGeburtsdatum" /></label>
                        </div>
                        <button type="button" class="rounded border p-3" disabled="@occupe" @onclick="StammdatenSpeichernAsync">Enregistrer l'identité dans le brouillon</button>
                        <p class="text-sm">Enregistrez vos modifications dans le brouillon avant de calculer les bulletins concernés. Les originaux ne sont pas modifiés.</p>
                    }
                </section>
                <ModernDropdown TValue="Guid" @bind-Value="korrekturNoteID" Options="BerichtigungsNoten" Label="Note à rectifier" Searchable="true" Disabled="occupe" />
                <label class="block">Nouvelle note<input type="number" min="0" step="0.01" class="w-full rounded border p-2" @bind="korrekturPunkte" /></label>
                <label class="block">Nouvelle appréciation<input maxlength="300" class="w-full rounded border p-2" @bind="korrekturBemerkung" /></label>
                <button type="button" class="rounded border p-3" disabled="@(occupe || korrekturNoteID == Guid.Empty)" @onclick="KorrekturSpeichernAsync">Enregistrer dans le brouillon</button>
                <button type="button" class="rounded border p-3" disabled="@occupe" @onclick="WirkungPruefenAsync">Calculer tous les bulletins concernés</button>
                <button type="button" class="rounded border p-3" disabled="@occupe" @onclick="KorrekturAbbrechenAsync">Abandonner le brouillon</button>
                @if (berichtigungsPruefung is not null)
                {
                    <p class="font-semibold">@berichtigungsPruefung.Auswirkungen.Count bulletin(s) à remplacer, y compris les rangs et résultats des périodes suivantes concernés.</p>
                    @foreach (var w in berichtigungsPruefung.Auswirkungen)
                    {
                        <article class="rounded border p-3"><p>@w.Schueler · @w.Periode · Moyenne @w.Alt → @w.Neu · Rang @w.AlterRang → @w.NeuerRang</p><p class="break-words text-sm">Identité proposée : @w.Vorschau.Schueler · Matricule : @w.Vorschau.Matrikelnummer · Naissance : @w.Vorschau.Geburtsdatum · @w.Vorschau.Geburtsort</p><button type="button" class="rounded border p-2" @onclick="() => ZeigeAbschlussVorschau(w.Vorschau)">Aperçu</button></article>
                    }
                    <label class="flex items-start gap-2"><input type="checkbox" @bind="berichtigungBestaetigt" /><span>Je confirme tous les remplacements affichés. Les originaux restent archivés. J'informerai les familles et organiserai l'échange des exemplaires signés.</span></label>
                    <button type="button" class="rounded bg-red-700 p-3 text-white" disabled="@(occupe || !berichtigungBestaetigt)" @onclick="KorrekturFreigebenAsync">Publier définitivement les rectifications</button>
                }
            }
        </details>
        <details class="rounded-xl border bg-white p-5"><summary class="cursor-pointer text-lg font-semibold">Présences et retards</summary>
            <p class="my-3">Sélectionnez la période et l'élève ci-dessus. Une seule situation est enregistrée par jour et par période ; une nouvelle saisie remplace la précédente.</p>
            <div class="grid gap-4 md:grid-cols-2">
                <label>Date<input type="date" class="w-full rounded border p-2" @bind="praesenzDatum" /></label>
                <ModernDropdown TValue="int" @bind-Value="praesenzStatus" Options="PraesenzOptionen" Label="Situation" />
                <label><input type="checkbox" @bind="entschuldigt" /> Absence / retard justifié</label>
                <label>Minutes de retard<input type="number" min="0" max="1440" class="w-full rounded border p-2" @bind="praesenzMinuten" /></label>
            </div>
            <button type="button" class="mt-3 rounded-lg bg-blue-700 p-3 text-white" disabled="@(occupe || schuelerID == Guid.Empty || periodeID == Guid.Empty)" @onclick="PraesenzSpeichernAsync">Enregistrer</button>
            <button type="button" class="m-2 rounded-lg border p-3" disabled="@(occupe || periodeID == Guid.Empty)" @onclick="PraesenzLadenAsync">Actualiser les présences de la période</button>
            @foreach (var presence in praesenz.Where(x => x.PeriodeID == periodeID && x.JahresZuordnungID == schuelerID))
            {
                <p class="mt-2 border-b p-2">@presence.Datum.ToString("dd/MM/yyyy") · @PraesenzOptionen[(int)presence.Status].Label · @presence.VerspaetungsMinuten min</p>
            }
        </details>
        @if (vorschau is not null)
        {
            <iframe title="Aperçu A4 du bulletin" src="@vorschauPdf" style="width:100%;height:800px;border:0" referrerpolicy="no-referrer"></iframe>
            <section class="rounded-xl border bg-white p-6">
                <h2 class="text-center text-xl font-bold" style="color:@vorschau.Farbe">@vorschau.Schule</h2>
                <p class="text-center">@vorschau.Titel · @vorschau.Schuljahr</p>
                <p class="mt-4 font-semibold">@vorschau.Schueler · @vorschau.Klasse</p>
                @foreach (var fach in vorschau.Faecher)
                {
                    <p class="border-b py-2">@fach.Fach · @(fach.Note?.ToString("0.00") ?? "Notes incomplètes") / 20</p>
                }
                <p class="mt-3 font-semibold">Moyenne : @(vorschau.Durchschnitt?.ToString("0.00") ?? "Notes incomplètes") / 20</p>
                <p>@vorschau.Bemerkung</p>
            </section>
        }
    }
    <section class="space-y-3">
        <h2 class="text-xl font-semibold">Éditions enregistrées</h2>
        @foreach (var bulletin in liste)
        {
            <article class="flex flex-wrap justify-between gap-3 rounded-xl border bg-white p-4">
                <div><strong>@bulletin.Schueler · @bulletin.Titel</strong><p>Version @bulletin.Version · @(bulletin.ErsetztDurchID != null ? "Remplacé — original archivé" : bulletin.IstVeroeffentlicht ? "Publié" : "Retiré") @(bulletin.IstEndgueltig ? "· Définitif" : "")</p></div>
                <a class="rounded-lg border p-2" href="@($"/bulletins/{bulletin.Id}/pdf")" target="_blank" rel="noopener">PDF</a>
                @if (verwalter && bulletin.IstVeroeffentlicht && !bulletin.IstEndgueltig)
                {
                    <button type="button" class="rounded-lg border p-2 text-red-700" disabled="@occupe" @onclick="() => RetirerAsync(bulletin.Id)">Retirer la publication</button>
                }
                @if (verwalter)
                {
                    <button type="button" class="rounded border p-2" disabled="@occupe" @onclick="() => UebergabenLadenAsync(bulletin.Id)">Contacts et remise</button>
                    @if (uebergabeAusgabeID == bulletin.Id)
                    {
                        <div class="w-full space-y-2">
                            <label>Destinataire et mode de contact / remise<input class="w-full rounded border p-2" maxlength="300" @bind="uebergabeVermerk" /></label>
                            <button type="button" class="rounded border p-2" disabled="@occupe" @onclick="() => UebergabeAsync(bulletin.Id, false)">Consigner une notification effectuée</button>
                            <button type="button" class="rounded border p-2" disabled="@occupe" @onclick="() => UebergabeAsync(bulletin.Id, true)">Consigner la remise du document signé</button>
                            <p class="text-sm">Ces actions enregistrent un suivi ; aucun message n'est envoyé automatiquement.</p>
                            @foreach (var u in uebergaben) { <p>@u.ErstelltAmUtc.ToString("dd/MM/yyyy HH:mm") UTC · @(u.IstAbholung ? "Remise" : "Notification") · @u.Vermerk</p> }
                        </div>
                    }
                }
            </article>
        }
        @if (liste.Count == 0) { <p>Aucun bulletin publié disponible.</p> }
    </section>
</div>
