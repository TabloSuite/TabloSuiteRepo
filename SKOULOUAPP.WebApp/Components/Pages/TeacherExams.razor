@page "/teacher-exams"
@attribute [Authorize(Policy = "RequireTeacher")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits SkoulouApp.WebApp.Components.CancelableComponentBase
@using SkoulouApp.Core.DataModels.Exams
@using SkoulouApp.Core.Models.Admin
@using SkoulouApp.Core.Services.Text
@using SkoulouApp.WebApp.Components.Shared

@if (!Embedded)
{
    <PageTitle>Examens</PageTitle>
}

<div class="grid gap-5 @(Embedded ? string.Empty : "mx-auto max-w-6xl")">
    @if (!Embedded)
    {
        <SeitenKopf Rubrik="@(isSchoolDirectionUser ? "Direction" : "Espace enseignant")" Titel="Examens" IconName="exam"
                    Untertitel="@(IstDirektionsPdfModus
                        ? "Créez des examens destinés à la direction pour impression PDF."
                        : ErfasstFuerAnderenLehrer
                            ? $"Créez et gérez les examens de {FuerLehrerName} : exercices, publication, date limite et PDF."
                            : "Créez et gérez les examens de vos classes : exercices, publication, date limite et PDF.")" />
    }

    <Toast Message="@statusMessage" MessageChanged="v => statusMessage = v" Kind="Toast.ToastKind.Success" />
    <Toast Message="@formError" MessageChanged="v => formError = v" Kind="Toast.ToastKind.Error" />

    @if (isSchoolDirectionUser && !editorOpen)
    {
        <LehrerFuerDirektionAuswahl Lehrer="lehrerAuswahl" Value="fuerLehrerId" ValueChanged="SetFuerLehrerAsync">
            <a class="sk-btn sk-btn-primary sk-btn-sm" href="@FuerLehrerHref("/teacher/lesson-exercises")"><Icon Name="book-open" Groesse="14" />Leçons et exercices de @FuerLehrerName</a>
            <a class="sk-btn sk-btn-secondary sk-btn-sm" href="@FuerLehrerHref("/teacher/lessons")"><Icon Name="book" Groesse="14" />Supports de cours de @FuerLehrerName</a>
        </LehrerFuerDirektionAuswahl>
    }

    <Abschnitt Titel="@(ErfasstFuerAnderenLehrer ? $"Examens de {FuerLehrerName}" : "Mes examens")" Untertitel="Aperçu avec ou sans solutions, publication pour les élèves et nouvelle attribution après la session." IconName="exam">
        <Aktionen>
            <button type="button" class="sk-btn sk-btn-primary" @onclick="() => OpenEditor(null)"><Icon Name="plus" Groesse="16" />@(IstDirektionsPdfModus ? "Nouvel examen (PDF)" : "Nouvel examen")</button>
        </Aktionen>
        <ChildContent>
            <div class="mb-4 grid gap-3 sm:grid-cols-2">
                <ModernDropdown TValue="Guid?"
                                Label="École"
                                Value="selectedSchoolFilterId"
                                ValueChanged="SetSchoolFilterAsync"
                                Options="SchoolFilterOptions" EinzigeOptionFest="true" />
                <ModernDropdown TValue="Guid?"
                                Label="Classe"
                                Value="selectedKlasseFilterId"
                                ValueChanged="SetKlasseFilterAsync"
                                Options="KlasseFilterOptions" />
            </div>

            @if (VisibleExams.Count == 0)
            {
                <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 px-5 py-8 text-center text-sm text-slate-500">
                    @(exams.Count == 0 ? "Aucun examen pour le moment. Créez le premier avec « Nouvel examen »." : "Aucun examen ne correspond aux filtres sélectionnés.")
                </div>
            }
            else
            {
                <ul class="m-0 grid list-none gap-3 p-0">
                    @foreach (var exam in VisibleExams)
                    {
                        <li class="rounded-2xl border border-slate-200 bg-white p-4" @key="exam.ExamId">
                            <div class="flex flex-wrap items-start justify-between gap-3">
                                <div class="min-w-0 flex-1">
                                    <div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
                                        <span class="rounded-full bg-blue-50 px-2.5 py-1 text-blue-800">@exam.NiveauCode</span>
                                        @if (exam.IsSuperseded)
                                        {
                                            <Badge Accent="slate">Session précédente · résultats conservés</Badge>
                                        }
                                        else if (!exam.IsPublishedToStudents)
                                        {
                                            <Badge Accent="slate">Non attribué aux élèves</Badge>
                                        }
                                        else if (exam.SubmissionDueAtUtc is DateTime dueAtUtc)
                                        {
                                            var isOpen = dueAtUtc > DateTime.UtcNow;
                                            <Badge Accent="@(isOpen ? "emerald" : "rose")">@(isOpen ? "Épreuve ouverte" : "Date limite dépassée")</Badge>
                                            <span class="text-slate-500">jusqu'au @dueAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                        }
                                        else
                                        {
                                            <Badge Accent="blue">Épreuve ouverte · aucune date limite commune</Badge>
                                        }
                                        @if (exam.IstVonDirektionErfasst)
                                        {
                                            <DirektionErfasstMarke />
                                        }
                                    </div>
                                    <h3 class="mb-0 mt-2 text-base font-bold text-slate-900">@exam.Title</h3>
                                    <p class="mb-0 mt-0.5 text-sm text-slate-500">@GetAudienceLabel(exam) · @exam.ExerciseCount exercice(s) · @exam.QuestionCount question(s) · @exam.DurationInMinutes min · @exam.AttemptCount tentative(s)</p>
                                    @if (exam.IsPublishedToStudents && !exam.IsSuperseded)
                                    {
                                        <p class="mb-0 mt-2 text-xs leading-5 text-slate-500">Chaque élève peut commencer dès la publication. Sa composition dure au maximum @exam.DurationInMinutes min et se termine plus tôt si la date limite commune arrive avant.</p>
                                        @if (exam.AttemptCount > 0)
                                        {
                                            <p class="mb-0 mt-1 text-xs leading-5 text-slate-500">La durée des tentatives ne peut pas être prolongée. Après la session, créez une nouvelle attribution pour permettre une nouvelle tentative.</p>
                                        }
                                    }
                                </div>
                                <div class="flex flex-wrap items-center gap-2">
                                    @if (!exam.IsSuperseded && exam.AttemptCount == 0)
                                    {
                                        <button type="button" class="sk-btn sk-btn-sm sk-btn-primary" @onclick="() => OpenEditor(exam.ExamId)"><Icon Name="edit" Groesse="14" />Modifier</button>
                                    }
                                    <a class="sk-btn sk-btn-sm sk-btn-secondary" href="@GetExamPreviewHref(exam.ExamId, true)" title="Aperçu corrigé"><Icon Name="eye" Groesse="14" />Corrigé</a>
                                    <a class="sk-btn sk-btn-sm sk-btn-secondary" href="@GetExamPreviewHref(exam.ExamId, false)" title="Aperçu sans solutions"><Icon Name="eye-off" Groesse="14" />Sans solutions</a>
                                    @if (!exam.IsSuperseded && exam.IsPublishedToStudents)
                                    {
                                        <button type="button" class="sk-btn sk-btn-sm sk-btn-ghost" title="Modifier et réattribuer" disabled="@(exam.HasRunningAttempt || exam.SubmissionDueAtUtc > DateTime.UtcNow)" @onclick="() => OpenReassignmentAsync(exam.ExamId)"><Icon Name="refresh" Groesse="14" />Réattribuer</button>
                                    }
                                    @if (exam.AttemptCount == 0)
                                    {
                                        <button type="button" class="sk-btn sk-btn-sm sk-btn-danger" title="Supprimer l'examen" aria-label="Supprimer l'examen" @onclick="() => DeleteExam(exam.ExamId)"><Icon Name="trash" Groesse="14" /></button>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            }
        </ChildContent>
    </Abschnitt>
</div>

@if (editorOpen && form is not null)
{
    <div class="fixed inset-0 z-[2200] flex items-center justify-center overflow-hidden bg-slate-950/45 p-4 backdrop-blur-sm sm:p-5">
        <div class="skoulou-modal-surface my-auto flex h-full w-full max-w-6xl flex-col rounded-2xl bg-white shadow-2xl shadow-slate-900/20 ring-1 ring-slate-200">
            <div class="flex items-center justify-between gap-3 border-b border-slate-100 px-4 py-3 sm:px-5">
                <div>
                    @if (ErfasstFuerAnderenLehrer)
                    {
                        <p class="mb-0 text-xs font-semibold text-slate-500">Saisie pour @FuerLehrerName</p>
                    }
                    <h2 class="mb-0 flex flex-wrap items-center gap-2 text-lg font-bold text-slate-900">
                        @(isReassigning ? "Modifier et réattribuer l'épreuve" : form.ExamId is null ? "Nouvel examen" : "Modifier l'examen")
                        @if (ErfasstFuerAnderenLehrer || form.IstVonDirektionErfasst)
                        {
                            <DirektionErfasstMarke />
                        }
                    </h2>
                </div>
                <button type="button" class="grid h-9 w-9 place-items-center rounded-xl text-slate-500 transition hover:bg-slate-100 hover:text-slate-900" aria-label="Fermer" @onclick="CloseEditor"><Icon Name="x" Groesse="18" /></button>
            </div>
            @if (!string.IsNullOrWhiteSpace(formError))
            {
                <div class="mx-4 mt-3 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-800 sm:mx-5" role="alert">@formError</div>
            }

            <EditForm Model="form" OnValidSubmit="SaveExam" FormName="teacher-exam-form" class="flex min-h-0 flex-1 flex-col">
                <DataAnnotationsValidator />
                <div @ref="editorScrollContainer" class="skoulou-modal-scroll flex-1 px-4 py-4 sm:px-5">
                <ValidationSummary />
                <div class="mt-3 grid gap-4">
                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-slate-600">Titre</label>
                        <input class="skoulou-input text-sm" @bind="form.Title" />
                    </div>
                    <div>
                        <ModernDropdown TValue="Guid?" Label="École" Value="editorSchoolId" ValueChanged="SetEditorSchoolAsync" Options="EditorSchoolOptions" EinzigeOptionFest="true" />
                    </div>
                    <div class="sm:col-span-2">
                        <ModernDropdown TValue="Guid?" Label="Classe" Value="form.KlasseId" ValueChanged="SetKlasseAsync" Options="KlasseOptions" Disabled="@(!editorSchoolId.HasValue)" />
                    </div>
                    @if (IstDirektionsPdfModus)
                    {
                        <div class="sm:col-span-2 rounded-2xl border border-cyan-200 bg-cyan-50 px-4 py-3 text-sm text-cyan-900">
                            Cet examen est créé pour la direction et restera en mode impression PDF.
                        </div>
                    }
                    else
                    {
                        <div class="sm:col-span-2">
                            <label class="mb-2 block text-xs font-semibold text-slate-600">Destinataire de l'examen</label>
                            <div class="grid gap-3 sm:grid-cols-2">
                                <label class="flex cursor-pointer items-start gap-3 rounded-2xl border px-4 py-3 @(form.ShareWithSchoolDirection ? "border-indigo-500 bg-indigo-50" : "border-slate-200")">
                                    <input type="checkbox" class="mt-1 h-4 w-4 rounded border-slate-300" @bind="form.ShareWithSchoolDirection" />
                                    <span>
                                        <span class="block font-semibold text-slate-800">Direction</span>
                                        <span class="block text-sm text-slate-500">Visible dans les contenus pédagogiques de la direction.</span>
                                    </span>
                                </label>
                                <label class="flex cursor-pointer items-start gap-3 rounded-2xl border px-4 py-3 @(form.AssignToClassStudents ? "border-indigo-500 bg-indigo-50" : "border-slate-200")">
                                    <input type="checkbox" class="mt-1 h-4 w-4 rounded border-slate-300" @bind="form.AssignToClassStudents" />
                                    <span>
                                        <span class="block font-semibold text-slate-800">Élèves de la classe</span>
                                        <span class="block text-sm text-slate-500">Publié pour les élèves abonnés de la classe concernée (compte dans le score).</span>
                                    </span>
                                </label>
                            </div>
                            <p class="mt-2 text-xs text-slate-500">Si aucune case n'est cochée, l'examen reste privé mais reste toujours visible pour son auteur.</p>
                        </div>
                    }
                    <label class="flex items-center gap-2 text-sm font-semibold text-slate-700">
                        <input type="checkbox" class="h-4 w-4 rounded border-slate-300" @bind="form.IsPdfExportEnabled" />
                        Autoriser l'export PDF
                    </label>
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-slate-600">Durée (minutes)</label>
                        <input type="number" min="1" class="skoulou-input text-sm" @bind="form.DurationInMinutes" />
                    </div>
                    @if (form.AssignToClassStudents || isReassigning)
                    {
                        <div>
                            <label class="mb-1 block text-xs font-semibold text-slate-600">Date limite commune : début et remise @(isReassigning ? "(obligatoire)" : "(optionnelle)")</label>
                            <TailwindDateTimePicker @bind-Value="ReassignmentDueDateLocal" />
                            <p class="mt-1 text-xs leading-5 text-slate-600">Les élèves peuvent commencer dès la publication, mais doivent aussi envoyer leurs réponses avant cette date. Chaque élève dispose d'au plus la durée indiquée : s'il commence peu avant la date limite, son temps de composition sera plus court. Sans date limite commune, seule la durée individuelle s'applique. Une épreuve déjà envoyée ne peut être recommencée que par une nouvelle attribution.</p>
                        </div>
                    }
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-slate-600">Score de réussite (%)</label>
                        <input type="number" min="0" max="100" class="skoulou-input text-sm" @bind="form.PassingScore" />
                    </div>
                </div>
                <p class="rounded-xl bg-slate-50 px-3 py-2 text-xs leading-5 text-slate-700">Règle de score : une épreuve compte dans les scores uniquement si elle est assignée aux élèves de la classe. Une épreuve créée pour la direction (impression/PDF) ne compte pas dans les scores.</p>
                <div>
                    <label class="mb-1 block text-xs font-semibold text-slate-600">Description / consignes générales (optionnel)</label>
                    <RichTextEditor @bind-Value="form.Description" Placeholder="Ex. : Lisez attentivement chaque exercice." EnableLargeEditor="true" />
                </div>

                @for (var exerciseIndex = 0; exerciseIndex < form.Exercises.Count; exerciseIndex++)
                {
                    var exercise = form.Exercises[exerciseIndex];
                    var exerciseNumber = exerciseIndex + 1;
                    <div class="rounded-2xl border-2 border-violet-100 bg-violet-50/40 p-4">
                        <div class="flex items-center justify-between gap-3">
                            <div class="flex-1">
                                <label class="mb-1 block text-xs font-semibold text-violet-800">Exercice @exerciseNumber — titre (optionnel)</label>
                                <input class="skoulou-input text-sm" placeholder="Ex. : Compréhension écrite" @bind="exercise.Title" />
                            </div>
                            @if (form.Exercises.Count > 1)
                            {
                                <button type="button" class="sk-btn sk-btn-danger sk-btn-sm mt-5" @onclick="() => RemoveExercise(exercise)">Supprimer l'exercice</button>
                            }
                        </div>

                        <div class="mt-3">
                            <label class="mb-1 block text-xs font-semibold text-slate-600">Consigne (optionnel)</label>
                            <RichTextEditor @bind-Value="exercise.Consigne" Placeholder="Ex. : Choisissez les vraies réponses." EnableLargeEditor="true" MinEditorHeightRem="4" />
                        </div>

                        <div class="mt-4 grid gap-4">
                            @foreach (var question in exercise.Questions)
                            {
                                var radioName = $"exam-correct-{exercise.GetHashCode()}-{question.GetHashCode()}";
                                var isManualCorrectionType = question.QuestionType is ExamQuestionType.FreeText or ExamQuestionType.SentenceBuilding or ExamQuestionType.AudioText;
                                <div class="rounded-2xl border border-slate-200 bg-white p-4">
                                    <div class="flex items-center justify-between gap-3">
                                        <label class="mb-1 block text-xs font-semibold text-slate-600">Question</label>
                                        <button type="button" class="sk-btn sk-btn-danger sk-btn-sm" @onclick="() => RemoveQuestion(exercise, question)">Supprimer</button>
                                    </div>
                                    <RichTextEditor @bind-Value="question.Prompt" Placeholder="Énoncé de la question..." EnableLargeEditor="true" MinEditorHeightRem="7" EnableImages="true" RequestImageLibrary="OpenImageLibrary" ImageLibraryTargetRequested="SetImageLibraryTarget" />

                                    <div class="mt-3 flex flex-wrap items-center gap-3">
                                        <div>
                                            <label class="mb-1 block text-xs font-semibold text-slate-600">Type</label>
                                            <select class="skoulou-input text-sm" @bind="question.QuestionType">
                                                <option value="@ExamQuestionType.SingleChoice">Choix unique</option>
                                                <option value="@ExamQuestionType.MultipleChoice">Choix multiple</option>
                                                <option value="@ExamQuestionType.FreeText">Texte libre</option>
                                                <option value="@ExamQuestionType.GapFill">Texte à trous</option>
                                                <option value="@ExamQuestionType.SentenceBuilding">Construction de phrase</option>
                                                <option value="@ExamQuestionType.AudioText">Audio → réponse texte</option>
                                                <option value="@ExamQuestionType.AudioSingleChoice">Audio → choix unique</option>
                                                <option value="@ExamQuestionType.AudioMultipleChoice">Audio → choix multiple</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="mb-1 block text-xs font-semibold text-slate-600">Points</label>
                                            <input type="number" min="1" class="skoulou-input w-24 text-sm" @bind="question.Points" />
                                        </div>
                                    </div>

                                    @if (isManualCorrectionType)
                                    {
                                        <p class="mt-2 text-xs text-amber-700">Conseil : ce type de question passe en correction manuelle si « Solutions modèles » reste vide.</p>
                                    }

                                    @if (IsAudioType(question.QuestionType))
                                    {
                                        <div class="mt-3 grid gap-3 md:grid-cols-2">
                                            <div>
                                                <label class="mb-1 block text-xs font-semibold text-slate-600">Texte à lire à voix haute (audio) (optionnel)</label>
                                                <textarea rows="2" class="skoulou-input text-sm" placeholder="Texte prononcé par la synthèse vocale..." @bind="question.AudioText"></textarea>
                                            </div>
                                            <div>
                                                <ModernDropdown TValue="string" Label="Langue audio (optionnel)" Value="question.TtsLanguage" ValueChanged="lang => SetQuestionTtsLanguageAsync(question, lang)" Options="TtsLanguageOptions" />
                                            </div>
                                        </div>
                                    }

                                    @if (IsChoiceType(question.QuestionType))
                                    {
                                        <div class="mt-3 grid gap-2">
                                            <p class="text-xs text-slate-500">@(question.QuestionType == ExamQuestionType.MultipleChoice || question.QuestionType == ExamQuestionType.AudioMultipleChoice ? "Cochez toutes les bonnes réponses." : "Choisissez une seule bonne réponse.")</p>
                                            @foreach (var option in question.Options)
                                            {
                                                <div class="flex items-center gap-2">
                                                    @if (question.QuestionType == ExamQuestionType.MultipleChoice || question.QuestionType == ExamQuestionType.AudioMultipleChoice)
                                                    {
                                                        <input type="checkbox" @bind="option.IsCorrect" />
                                                    }
                                                    else
                                                    {
                                                        <input type="radio" name="@radioName" checked="@option.IsCorrect" @onchange="() => SelectSingleCorrectOption(question, option)" />
                                                    }
                                                    <input class="skoulou-input flex-1 text-sm" placeholder="Ex. : Réponse A" @bind="option.Text" />
                                                    <button type="button" class="sk-btn sk-btn-danger sk-btn-sm" @onclick="() => question.Options.Remove(option)">✕</button>
                                                </div>
                                            }
                                            <button type="button" class="sk-btn sk-btn-secondary sk-btn-sm w-fit" @onclick="() => question.Options.Add(new ExamQuestionOptionFormModel())">+ Ajouter une option</button>
                                        </div>
                                    }
                                    else if (question.QuestionType == ExamQuestionType.GapFill)
                                    {
                                        <div class="mt-3 grid gap-2">
                                            <p class="text-xs text-indigo-700">Conseil : dans l’énoncé de la question, utilisez les marqueurs <strong>[[1]]</strong>, <strong>[[2]]</strong>, <strong>[[3]]</strong>… puis définissez ci-dessous les réponses acceptées pour chaque trou (une variante par ligne). Exemple : « Je <strong>[[1]]</strong> à l'école et je <strong>[[2]]</strong> mes amis. » → Trou 1: vais, Trou 2: vois.</p>
                                            <p class="text-xs text-slate-500">Utilisez les marqueurs [[1]], [[2]] … dans l'énoncé. Définissez les réponses acceptées par trou (une variante par ligne).</p>
                                            @for (var gapIndex = 0; gapIndex < question.Gaps.Count; gapIndex++)
                                            {
                                                var gap = question.Gaps[gapIndex];
                                                var gapNumber = gapIndex + 1;
                                                <div class="flex items-start gap-2">
                                                    <span class="mt-2 text-xs font-semibold text-slate-500">[[@gapNumber]]</span>
                                                    <textarea rows="2" class="skoulou-input flex-1 text-sm" placeholder="Réponses acceptées (une par ligne)" @bind="gap.AcceptedAnswers"></textarea>
                                                    <button type="button" class="sk-btn sk-btn-danger sk-btn-sm" @onclick="() => question.Gaps.Remove(gap)">✕</button>
                                                </div>
                                            }
                                            <button type="button" class="sk-btn sk-btn-secondary sk-btn-sm w-fit" @onclick="() => question.Gaps.Add(new ExamGapFormModel())">+ Ajouter un trou</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mt-3">
                                            <label class="mb-1 block text-xs font-semibold text-slate-600">Solutions modèles (optionnel, une variante par ligne)</label>
                                            <textarea rows="3" class="skoulou-input text-sm" placeholder="Laissez vide pour une correction manuelle par l'enseignant." @bind="question.AcceptedAnswers"></textarea>
                                            <p class="mt-1 text-xs text-slate-500">Avec solution modèle : correction automatique tolérante. Sans : correction manuelle.</p>
                                        </div>
                                    }
                                </div>
                            }
                            <button type="button" class="sk-btn sk-btn-secondary w-fit" @onclick="() => AddQuestion(exercise)">+ Ajouter une question</button>
                        </div>
                    </div>
                }
                <button type="button" class="sk-btn sk-btn-primary w-fit" @onclick="AddExercise">+ Ajouter un exercice</button>
            </div>

                </div>

                <div class="flex flex-wrap justify-end gap-3 border-t border-slate-100 bg-white px-4 py-3 sm:px-5">
                    <button type="button" class="sk-btn sk-btn-secondary" disabled="@isSavingExam" @onclick="CloseEditor">Annuler</button>
                    <AsyncActionButton Type="submit" Class="skoulou-btn-accent rounded-full px-5 py-2.5 text-sm font-semibold" IsBusy="@isSavingExam" BusyLabel="Enregistrement...">Enregistrer</AsyncActionButton>
                </div>
            </EditForm>
        </div>
    </div>
    <AzureBlobImageLibrary Open="imageLibraryOpen" OpenChanged="@(open => imageLibraryOpen = open)" RequiredSchoolId="editorSchoolId" ImageSelected="InsertLibraryImageAsync" />
}
