@page "/teacher-exams"
@attribute [Authorize(Policy = "RequireTeacher")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits HalloApp.WebApp.Components.CancelableComponentBase
@using HalloApp.Core.DataModels.Exams
@using HalloApp.Core.Models.Admin
@using HalloApp.Core.Services.Text
@using HalloApp.WebApp.Components.Shared

@if (!Embedded)
{
    <PageTitle>Examens</PageTitle>
}

<section class="mx-auto max-w-5xl space-y-6 p-4 @(Embedded ? "rounded-3xl bg-white shadow-lg shadow-slate-200/70 ring-1 ring-slate-100" : string.Empty)">
    @if (!Embedded)
    {
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
                <h1 class="text-2xl font-black text-slate-900">Examens</h1>
                <p class="text-sm text-slate-500">@(isSchoolDirectionUser
                    ? "Créez des examens destinés à la direction pour impression PDF."
                    : "Créez et gérez uniquement les examens propres à votre école. Les examens standard font partie du matériel pédagogique.")</p>
            </div>
            <button type="button" class="rounded-full bg-violet-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-violet-700" @onclick="() => OpenEditor(null)">@(isSchoolDirectionUser ? "+ Nouvel examen (PDF)" : "+ Nouvel examen")</button>
        </div>
    }
    else
    {
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-amber-700">Examen</p>
                <h2 class="text-xl font-black text-slate-900">Créer et gérer les examens</h2>
            </div>
            <button type="button" class="rounded-full bg-violet-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-violet-700" @onclick="() => OpenEditor(null)">@(isSchoolDirectionUser ? "+ Nouvel examen (PDF)" : "+ Nouvel examen")</button>
        </div>
    }

    <Toast Message="@statusMessage" MessageChanged="v => statusMessage = v" Kind="Toast.ToastKind.Success" />
    <Toast Message="@formError" MessageChanged="v => formError = v" Kind="Toast.ToastKind.Error" />

    <div class="grid gap-3">
        @if (exams.Count == 0)
        {
            <div class="rounded-2xl bg-slate-50 p-6 text-center text-slate-600">
                <h2 class="text-lg font-black text-slate-900">Aucun examen créé</h2>
                <p class="mt-2 text-sm">Crée un premier examen pour tes classes attribuées.</p>
            </div>
        }
        @foreach (var exam in exams)
        {
            <div class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-white p-4">
                <div>
                    <h2 class="font-bold text-slate-900">@exam.Title</h2>
                    <p class="text-sm text-slate-500">@exam.NiveauCode · @GetAudienceLabel(exam) · @exam.ExerciseCount exercice(s) · @exam.QuestionCount question(s) · @exam.DurationInMinutes min · @exam.AttemptCount tentative(s)</p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <button type="button" class="rounded-full bg-cyan-50 px-4 py-2 text-sm font-semibold text-cyan-700 hover:bg-cyan-100" @onclick="() => OpenExamPdfPreviewAsync(exam.ExamId, true)">Aperçu corrigé</button>
                    <button type="button" class="rounded-full bg-amber-50 px-4 py-2 text-sm font-semibold text-amber-700 hover:bg-amber-100" @onclick="() => OpenExamPdfPreviewAsync(exam.ExamId, false)">Aperçu sans solutions</button>
                    <button type="button" class="rounded-full bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-200" @onclick="() => OpenEditor(exam.ExamId)">Modifier</button>
                    <button type="button" class="rounded-full bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-700 hover:bg-rose-100" @onclick="() => DeleteExam(exam.ExamId)">Supprimer</button>
                </div>
            </div>
        }

    </div>
</section>

@if (pdfPreviewExam is not null)
{
    <div class="fixed inset-0 z-[2300] flex items-center justify-center bg-slate-950/60 p-3 sm:p-6" role="dialog" aria-modal="true" aria-label="Aperçu avant export PDF">
        <div class="hallo-modal-surface flex h-[94dvh] w-full max-w-6xl flex-col overflow-hidden rounded-3xl bg-white shadow-2xl ring-1 ring-slate-200">
            <div class="relative flex items-center justify-end gap-3 border-b border-white/20 px-4 py-3 text-white sm:px-6" style="background: linear-gradient(135deg, var(--hallo-accent-1), var(--hallo-accent-2));">
                <h3 class="pointer-events-none absolute left-1/2 -translate-x-1/2 text-base font-black text-white">Aperçu du contenu à exporter (@(pdfPreviewIncludeSolutions ? "avec solutions" : "sans solutions"))</h3>
                <button type="button" class="rounded-full bg-rose-500/90 px-4 py-2 text-xs font-semibold text-white ring-1 ring-rose-200/70 hover:bg-rose-500" @onclick="CloseExamPdfPreview">Fermer l’aperçu</button>
            </div>

            <div class="hallo-modal-scroll min-h-0 flex-1 px-4 py-4 sm:px-6">
                <article class="rounded-xl border border-slate-200 bg-white p-6 text-slate-900">
                    <header class="border-b border-cyan-600 pb-4 text-center">
                        <p class="text-xs font-semibold uppercase tracking-[.18em] text-cyan-700">@pdfPreviewExam.NiveauCode · @pdfPreviewExam.DurationInMinutes min · @pdfPreviewExam.TotalPoints pts</p>
                        <h4 class="mt-2 text-2xl font-black">@pdfPreviewExam.Title</h4>
                        @if (!string.IsNullOrWhiteSpace(pdfPreviewExam.Description))
                        {
                            <div class="mt-2 text-sm text-slate-600">@((MarkupString)HtmlSanitizer.Sanitize(pdfPreviewExam.Description))</div>
                        }
                    </header>

                    @foreach (var block in pdfPreviewExam.Exercises)
                    {
                        var blockPoints = block.Questions.Sum(question => question.Points);
                        <section class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-4">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="rounded-full bg-indigo-100 px-3 py-1 text-xs font-semibold text-indigo-800">Exercice @block.Number</span>
                                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">@blockPoints pt@(blockPoints > 1 ? "s" : string.Empty)</span>
                            </div>
                            <h5 class="mt-2 text-lg font-bold text-slate-900">@(string.IsNullOrWhiteSpace(block.Title) ? $"Exercice {block.Number}" : block.Title)</h5>
                            @if (!string.IsNullOrWhiteSpace(block.Consigne))
                            {
                                <div class="mt-1 text-sm italic text-slate-600">@((MarkupString)HtmlSanitizer.Sanitize(block.Consigne))</div>
                            }

                            <div class="mt-3 grid gap-3">
                                @foreach (var question in block.Questions)
                                {
                                    <div class="rounded-xl border border-slate-200 bg-white p-3">
                                        <div class="flex items-start justify-between gap-3">
                                            <div class="text-sm font-semibold text-slate-900">@question.Number. @((MarkupString)HtmlSanitizer.Sanitize(question.Prompt))</div>
                                            <span class="rounded-full bg-cyan-50 px-2.5 py-1 text-xs font-semibold text-cyan-800">@question.Points pt@(question.Points > 1 ? "s" : string.Empty)</span>
                                        </div>

                                        @if (question.QuestionType is "Choice" or "SingleChoice" or "MultipleChoice" or "AudioChoice" or "AudioSingleChoice" or "AudioMultipleChoice" && question.Options.Count > 0)
                                        {
                                            var useRadioComponent = question.QuestionType is "Choice" or "SingleChoice" or "AudioChoice" or "AudioSingleChoice";
                                            <div class="mt-2 space-y-2">
                                                @foreach (var option in question.Options)
                                                {
                                                    var isCorrect = pdfPreviewIncludeSolutions && question.CorrectOptions.Contains(option);
                                                    <div class="flex items-center gap-2 text-sm @(isCorrect ? "font-bold text-emerald-700" : "font-medium text-slate-900")">
                                                        @if (useRadioComponent)
                                                        {
                                                            <span class="inline-flex h-4 w-4 items-center justify-center rounded-full border-2 border-slate-700" aria-hidden="true"></span>
                                                        }
                                                        else
                                                        {
                                                            <span class="inline-flex h-4 w-4 items-center justify-center rounded-[3px] border-2 border-slate-700" aria-hidden="true"></span>
                                                        }
                                                        <span>@HtmlSanitizer.ToPlainText(option) @(isCorrect ? "✓" : string.Empty)</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else if (question.QuestionType == "GapFill")
                                        {
                                            <div class="mt-2 flex flex-wrap gap-2">
                                                @for (var i = 0; i < Math.Max(question.GapCount, 1); i++)
                                                {
                                                    <input type="text" disabled class="hallo-input w-32 bg-slate-50 text-xs" />
                                                }
                                            </div>
                                            @if (pdfPreviewIncludeSolutions && question.GapSolutions.Count > 0)
                                            {
                                                <p class="mt-1 text-xs text-emerald-700">Solutions : @string.Join(" · ", question.GapSolutions)</p>
                                            }
                                        }
                                        else
                                        {
                                            @if (question.QuestionType is "SentenceBuilding" or "FreeText" or "AudioText")
                                            {
                                                <textarea disabled class="hallo-input mt-2 min-h-24 w-full bg-slate-50 text-sm" placeholder="Réponse de l'élève..."></textarea>
                                            }
                                            else
                                            {
                                                <div class="mt-2 space-y-2">
                                                    <div class="border-b border-slate-300"></div>
                                                    <div class="border-b border-slate-300"></div>
                                                    <div class="border-b border-slate-300"></div>
                                                </div>
                                            }
                                            @if (pdfPreviewIncludeSolutions && !string.IsNullOrWhiteSpace(question.AcceptedAnswers))
                                            {
                                                <p class="mt-1 text-xs text-emerald-700">Solution(s) : @question.AcceptedAnswers</p>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        </section>
                    }
                </article>
            </div>

            <div class="flex flex-wrap justify-end gap-3 border-t border-slate-100 bg-white px-4 py-3 sm:px-6">
                <button type="button" class="rounded-full bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-200" @onclick="CloseExamPdfPreview">Annuler</button>
                <a class="rounded-full bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-slate-800" href="@GetPdfFileUrl()" target="_blank" @onclick="CloseExamPdfPreview">Télécharger le PDF</a>
            </div>
        </div>
    </div>
}

@if (editorOpen && form is not null)
{
    <div class="fixed inset-0 z-[2200] flex items-center justify-center overflow-hidden bg-slate-900/50 p-4 sm:p-5">
        <div class="hallo-modal-surface my-auto flex h-full w-full max-w-6xl flex-col rounded-3xl bg-white shadow-xl">
            <div class="flex items-center justify-between gap-3 border-b border-slate-100 px-4 py-3 sm:px-5">
                <h2 class="text-lg font-bold text-slate-900">@(form.ExamId is null ? "Nouvel examen" : "Modifier l'examen")</h2>
                <button type="button" class="rounded-full bg-slate-100 p-1.5 text-xs font-semibold text-slate-700" @onclick="CloseEditor">✕</button>
            </div>

            <EditForm Model="form" OnValidSubmit="SaveExam" FormName="teacher-exam-form" class="flex min-h-0 flex-1 flex-col">
                <DataAnnotationsValidator />
                <div @ref="editorScrollContainer" class="hallo-modal-scroll flex-1 px-4 py-4 sm:px-5">
                <ValidationSummary />
                <div class="mt-3 grid gap-4">
                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-slate-600">Titre</label>
                        <input class="hallo-input text-sm" @bind="form.Title" />
                    </div>
                    <div>
                        <ModernDropdown TValue="string" Label="Niveau" Value="form.NiveauCode" ValueChanged="SetNiveauAsync" Options="NiveauOptions" />
                    </div>
                    @if (isSchoolDirectionUser)
                    {
                        <div class="sm:col-span-2 rounded-2xl border border-cyan-200 bg-cyan-50 px-4 py-3 text-sm text-cyan-900">
                            Cet examen est créé pour la direction et restera en mode impression PDF.
                        </div>
                    }
                    else
                    {
                        <div class="sm:col-span-2">
                            <label class="mb-2 block text-xs font-semibold text-slate-600">Destinataire de l'examen</label>
                            <div class="grid gap-3 sm:grid-cols-2">
                                <label class="flex cursor-pointer items-start gap-3 rounded-2xl border px-4 py-3 @(form.ShareWithSchoolDirection ? "border-indigo-500 bg-indigo-50" : "border-slate-200")">
                                    <input type="checkbox" class="mt-1 h-4 w-4 rounded border-slate-300" @bind="form.ShareWithSchoolDirection" />
                                    <span>
                                        <span class="block font-semibold text-slate-800">Direction</span>
                                        <span class="block text-sm text-slate-500">Visible dans les contenus pédagogiques de la direction.</span>
                                    </span>
                                </label>
                                <label class="flex cursor-pointer items-start gap-3 rounded-2xl border px-4 py-3 @(form.AssignToClassStudents ? "border-indigo-500 bg-indigo-50" : "border-slate-200")">
                                    <input type="checkbox" class="mt-1 h-4 w-4 rounded border-slate-300" @bind="form.AssignToClassStudents" />
                                    <span>
                                        <span class="block font-semibold text-slate-800">Élèves de la classe</span>
                                        <span class="block text-sm text-slate-500">Publié pour les élèves abonnés de la classe concernée (compte dans le score).</span>
                                    </span>
                                </label>
                            </div>
                            <p class="mt-2 text-xs text-slate-500">Si aucune case n'est cochée, l'examen reste privé mais reste toujours visible pour son auteur.</p>
                        </div>
                    }
                    <label class="flex items-center gap-2 text-sm font-semibold text-slate-700">
                        <input type="checkbox" class="h-4 w-4 rounded border-slate-300" @bind="form.IsPdfExportEnabled" />
                        Autoriser l'export PDF
                    </label>
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-slate-600">Durée (minutes)</label>
                        <input type="number" min="1" class="hallo-input text-sm" @bind="form.DurationInMinutes" />
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-slate-600">Score de réussite (%)</label>
                        <input type="number" min="0" max="100" class="hallo-input text-sm" @bind="form.PassingScore" />
                    </div>
                </div>
                <p class="rounded-xl bg-slate-50 px-3 py-2 text-xs leading-5 text-slate-700">Règle de score : une épreuve compte dans les scores uniquement si elle est assignée aux élèves de la classe. Une épreuve créée pour la direction (impression/PDF) ne compte pas dans les scores.</p>
                <div>
                    <label class="mb-1 block text-xs font-semibold text-slate-600">Description / consignes générales (optionnel)</label>
                    <RichTextEditor @bind-Value="form.Description" Placeholder="Ex. : Lisez attentivement chaque exercice." EnableLargeEditor="true" />
                </div>

                @for (var exerciseIndex = 0; exerciseIndex < form.Exercises.Count; exerciseIndex++)
                {
                    var exercise = form.Exercises[exerciseIndex];
                    var exerciseNumber = exerciseIndex + 1;
                    <div class="rounded-2xl border-2 border-violet-100 bg-violet-50/40 p-4">
                        <div class="flex items-center justify-between gap-3">
                            <div class="flex-1">
                                <label class="mb-1 block text-xs font-semibold text-violet-800">Exercice @exerciseNumber — titre (optionnel)</label>
                                <input class="hallo-input text-sm" placeholder="Ex. : Compréhension écrite" @bind="exercise.Title" />
                            </div>
                            @if (form.Exercises.Count > 1)
                            {
                                <button type="button" class="mt-5 rounded-full bg-rose-50 px-3 py-1 text-xs font-semibold text-rose-700 hover:bg-rose-100" @onclick="() => RemoveExercise(exercise)">Supprimer l'exercice</button>
                            }
                        </div>

                        <div class="mt-3">
                            <label class="mb-1 block text-xs font-semibold text-slate-600">Consigne (optionnel)</label>
                            <RichTextEditor @bind-Value="exercise.Consigne" Placeholder="Ex. : Choisissez les vraies réponses." EnableLargeEditor="true" MinEditorHeightRem="4" />
                        </div>

                        <div class="mt-4 grid gap-4">
                            @foreach (var question in exercise.Questions)
                            {
                                var radioName = $"exam-correct-{exercise.GetHashCode()}-{question.GetHashCode()}";
                                var isManualCorrectionType = question.QuestionType is ExamQuestionType.FreeText or ExamQuestionType.SentenceBuilding or ExamQuestionType.AudioText;
                                <div class="rounded-2xl border border-slate-200 bg-white p-4">
                                    <div class="flex items-center justify-between gap-3">
                                        <label class="mb-1 block text-xs font-semibold text-slate-600">Question</label>
                                        <button type="button" class="rounded-full bg-rose-50 px-3 py-1 text-xs font-semibold text-rose-700 hover:bg-rose-100" @onclick="() => RemoveQuestion(exercise, question)">Supprimer</button>
                                    </div>
                                    <RichTextEditor @bind-Value="question.Prompt" Placeholder="Énoncé de la question..." EnableLargeEditor="true" MinEditorHeightRem="7" />

                                    <div class="mt-3 flex flex-wrap items-center gap-3">
                                        <div>
                                            <label class="mb-1 block text-xs font-semibold text-slate-600">Type</label>
                                            <select class="hallo-input text-sm" @bind="question.QuestionType">
                                                <option value="@ExamQuestionType.SingleChoice">Choix unique</option>
                                                <option value="@ExamQuestionType.MultipleChoice">Choix multiple</option>
                                                <option value="@ExamQuestionType.FreeText">Texte libre</option>
                                                <option value="@ExamQuestionType.GapFill">Texte à trous</option>
                                                <option value="@ExamQuestionType.SentenceBuilding">Construction de phrase</option>
                                                <option value="@ExamQuestionType.AudioText">Audio → réponse texte</option>
                                                <option value="@ExamQuestionType.AudioSingleChoice">Audio → choix unique</option>
                                                <option value="@ExamQuestionType.AudioMultipleChoice">Audio → choix multiple</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="mb-1 block text-xs font-semibold text-slate-600">Points</label>
                                            <input type="number" min="1" class="hallo-input w-24 text-sm" @bind="question.Points" />
                                        </div>
                                    </div>

                                    @if (isManualCorrectionType)
                                    {
                                        <p class="mt-2 text-xs text-amber-700">Conseil : ce type de question passe en correction manuelle si « Solutions modèles » reste vide.</p>
                                    }

                                    @if (IsAudioType(question.QuestionType))
                                    {
                                        <div class="mt-3 grid gap-3 md:grid-cols-2">
                                            <div>
                                                <label class="mb-1 block text-xs font-semibold text-slate-600">Texte à lire à voix haute (audio) (optionnel)</label>
                                                <textarea rows="2" class="hallo-input text-sm" placeholder="Texte prononcé par la synthèse vocale..." @bind="question.AudioText"></textarea>
                                            </div>
                                            <div>
                                                <ModernDropdown TValue="string" Label="Langue audio (optionnel)" Value="question.TtsLanguage" ValueChanged="lang => SetQuestionTtsLanguageAsync(question, lang)" Options="TtsLanguageOptions" />
                                            </div>
                                        </div>
                                    }

                                    @if (IsChoiceType(question.QuestionType))
                                    {
                                        <div class="mt-3 grid gap-2">
                                            <p class="text-xs text-slate-500">@(question.QuestionType == ExamQuestionType.MultipleChoice || question.QuestionType == ExamQuestionType.AudioMultipleChoice ? "Coche toutes les bonnes réponses." : "Choisis une seule bonne réponse.")</p>
                                            @foreach (var option in question.Options)
                                            {
                                                <div class="flex items-center gap-2">
                                                    @if (question.QuestionType == ExamQuestionType.MultipleChoice || question.QuestionType == ExamQuestionType.AudioMultipleChoice)
                                                    {
                                                        <input type="checkbox" @bind="option.IsCorrect" />
                                                    }
                                                    else
                                                    {
                                                        <input type="radio" name="@radioName" checked="@option.IsCorrect" @onchange="() => SelectSingleCorrectOption(question, option)" />
                                                    }
                                                    <input class="hallo-input flex-1 text-sm" placeholder="Ex. : Réponse A" @bind="option.Text" />
                                                    <button type="button" class="rounded-full bg-rose-50 px-3 py-1 text-xs font-semibold text-rose-700 hover:bg-rose-100" @onclick="() => question.Options.Remove(option)">✕</button>
                                                </div>
                                            }
                                            <button type="button" class="w-fit rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-200" @onclick="() => question.Options.Add(new ExamQuestionOptionFormModel())">+ Ajouter une option</button>
                                        </div>
                                    }
                                    else if (question.QuestionType == ExamQuestionType.GapFill)
                                    {
                                        <div class="mt-3 grid gap-2">
                                            <p class="text-xs text-indigo-700">Conseil : dans l’énoncé de la question, utilise les marqueurs <strong>[[1]]</strong>, <strong>[[2]]</strong>, <strong>[[3]]</strong>… puis définis ci-dessous les réponses acceptées pour chaque trou (une variante par ligne). Exemple : « Je <strong>[[1]]</strong> à l'école et je <strong>[[2]]</strong> mes amis. » → Trou 1: vais, Trou 2: vois.</p>
                                            <p class="text-xs text-slate-500">Utilise les marqueurs [[1]], [[2]] … dans l'énoncé. Définis les réponses acceptées par trou (une variante par ligne).</p>
                                            @for (var gapIndex = 0; gapIndex < question.Gaps.Count; gapIndex++)
                                            {
                                                var gap = question.Gaps[gapIndex];
                                                var gapNumber = gapIndex + 1;
                                                <div class="flex items-start gap-2">
                                                    <span class="mt-2 text-xs font-semibold text-slate-500">[[@gapNumber]]</span>
                                                    <textarea rows="2" class="hallo-input flex-1 text-sm" placeholder="Réponses acceptées (une par ligne)" @bind="gap.AcceptedAnswers"></textarea>
                                                    <button type="button" class="rounded-full bg-rose-50 px-3 py-1 text-xs font-semibold text-rose-700 hover:bg-rose-100" @onclick="() => question.Gaps.Remove(gap)">✕</button>
                                                </div>
                                            }
                                            <button type="button" class="w-fit rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-200" @onclick="() => question.Gaps.Add(new ExamGapFormModel())">+ Ajouter un trou</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mt-3">
                                            <label class="mb-1 block text-xs font-semibold text-slate-600">Solutions modèles (optionnel, une variante par ligne)</label>
                                            <textarea rows="3" class="hallo-input text-sm" placeholder="Laisse vide pour une correction manuelle par l'enseignant." @bind="question.AcceptedAnswers"></textarea>
                                            <p class="mt-1 text-xs text-slate-500">Avec solution modèle : correction automatique tolérante. Sans : correction manuelle.</p>
                                        </div>
                                    }
                                </div>
                            }
                            <button type="button" class="w-fit rounded-full bg-violet-50 px-4 py-2 text-sm font-semibold text-violet-700 hover:bg-violet-100" @onclick="() => AddQuestion(exercise)">+ Ajouter une question</button>
                        </div>
                    </div>
                }
                <button type="button" class="w-fit rounded-full bg-violet-600 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-700" @onclick="AddExercise">+ Ajouter un exercice</button>
            </div>

                </div>

                <div class="flex flex-wrap justify-end gap-3 border-t border-slate-100 bg-white px-4 py-3 sm:px-5">
                    <button type="button" class="rounded-full bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-700" disabled="@isSavingExam" @onclick="CloseEditor">Annuler</button>
                    <AsyncActionButton Type="submit" Class="hallo-btn-accent rounded-full px-5 py-2.5 text-sm font-semibold" IsBusy="@isSavingExam" BusyLabel="Enregistrement...">Enregistrer</AsyncActionButton>
                </div>
            </EditForm>
        </div>
    </div>
}
