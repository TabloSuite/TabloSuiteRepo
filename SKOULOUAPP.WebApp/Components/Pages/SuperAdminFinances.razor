@page "/superadmin/finances"
@attribute [Authorize(Roles = "SuperAdmin")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Administrateur · Finances</PageTitle>

<section class="grid gap-6">
    <div class="skoulou-hero relative overflow-hidden rounded-[1.25rem] px-5 py-4 text-white shadow-2xl sm:px-6 sm:py-5">
        <div class="pointer-events-none absolute -top-20 -right-16 h-56 w-56 rounded-full bg-emerald-400/25 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-16 -left-10 h-48 w-48 rounded-full bg-cyan-400/20 blur-3xl"></div>
        <div class="relative">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-200">Espace administrateur</p>
            <h1 class="mt-3 text-3xl font-black">Centre financier</h1>
            <p class="mt-4 max-w-3xl text-sm leading-7 text-slate-300">
                Consultez les finances des écoles et accédez aux facturations SKOULOUAPPABO depuis le centre financier.
            </p>
        </div>
    </div>

    <div class="director-sticky-band school-page-tabs flex flex-wrap gap-2" aria-label="Rubriques financières">
        <button type="button" class="rounded-full px-4 py-2 text-sm font-semibold @(activeTab == "centre" ? "skoulou-btn-accent" : "bg-slate-100 text-slate-700 hover:bg-slate-200")" aria-current="@(activeTab == "centre" ? "page" : null)" @onclick='() => activeTab = "centre"'>Vue d'ensemble</button>
        <button type="button" class="rounded-full px-4 py-2 text-sm font-semibold @(activeTab == "ecoles" ? "skoulou-btn-accent" : "bg-slate-100 text-slate-700 hover:bg-slate-200")" aria-current="@(activeTab == "ecoles" ? "page" : null)" @onclick='() => activeTab = "ecoles"'>Finances des écoles</button>
    </div>

    @if (activeTab == "ecoles")
    {
        <Finanzen />
    }
    else
    {
    <div class="grid gap-4 lg:grid-cols-2">
        <article class="rounded-[2rem] border border-slate-100 bg-white p-6 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-cyan-700">Consultation</p>
            <h2 class="mt-2 text-xl font-black text-slate-900">Finances des écoles</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">
                Consultez les recettes, dépenses et rapports par école sans modifier les écritures, paiements ou cycles.
            </p>
            <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-slate-600">
                <li>Suivi par école</li>
                <li>Cycles de classes et paiements</li>
                <li>Rapports et filtrage</li>
            </ul>
            <button type="button" class="mt-5 inline-flex rounded-full bg-cyan-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-cyan-700" @onclick='() => activeTab = "ecoles"'>Voir les finances des écoles</button>
        </article>

        <article class="rounded-[2rem] border border-slate-100 bg-white p-6 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-violet-700">Facturation</p>
            <h2 class="mt-2 text-xl font-black text-slate-900">Gestion SKOULOUAPPABOs</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">
                Créer, suivre et confirmer les facturations SKOULOUAPPABO (manuel + automatique à la clôture de classe).
            </p>
            <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-slate-600">
                <li>Création manuelle de facturation</li>
                <li>Visibilité de la validation directeur</li>
                <li>Confirmation finale après réception du virement</li>
            </ul>
            <a class="mt-5 inline-flex rounded-full bg-violet-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-violet-700" href="/abrechnung">
                Ouvrir SKOULOUAPPABOs
            </a>
        </article>
    </div>

    <div class="rounded-2xl bg-slate-50 px-5 py-4 text-sm text-slate-700 ring-1 ring-slate-100">
        Workflow recommandé: <span class="font-semibold">(1)</span> Consulter les finances des écoles,
        <span class="font-semibold">(2)</span> générer/contrôler la facturation SKOULOUAPPABO,
        <span class="font-semibold">(3)</span> confirmer dès réception bancaire.
    </div>
    }
</section>

@code {
    private string activeTab = "centre";
}
