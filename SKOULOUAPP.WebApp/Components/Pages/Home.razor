@page "/"
@attribute [AllowAnonymous]
<PageTitle>SKOULOU · Gestion scolaire</PageTitle>

@* Startseite im Design „Soft Modern“ (wie eNOTE). Neutral für alle Bildungseinrichtungen, keine Sprachkurs-Bezüge. *@
<div class="mx-auto grid max-w-6xl gap-10 pb-6 sm:gap-14">

    <section id="top" class="grid items-center gap-8 pt-2 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:pt-6">
        <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-teal-200 bg-teal-50 px-3 py-1 text-xs font-bold uppercase tracking-[0.14em] text-teal-700">
                <Icon Name="school" Groesse="14" /> Plateforme de gestion scolaire
            </span>
            <AuthorizeView>
                <Authorized>
                    <h1 class="mb-0 mt-4 text-3xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-4xl">Bonjour, bienvenue dans votre espace.</h1>
                    <p class="mb-0 mt-4 max-w-xl text-base leading-7 text-slate-600">Retrouvez ci-dessous les accès de votre rôle. Le menu à gauche reste disponible à tout moment.</p>
                </Authorized>
                <NotAuthorized>
                    <h1 class="mb-0 mt-4 text-3xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-5xl">Votre établissement, <span class="text-blue-700">simplement organisé.</span></h1>
                    <p class="mb-0 mt-4 max-w-xl text-base leading-7 text-slate-600">Élèves, classes, enseignants, emplois du temps, notes, bulletins et frais de scolarité : SKOULOU réunit la gestion de votre école, de votre université ou de votre centre de formation dans un seul espace, sur ordinateur, tablette et téléphone.</p>
                    <div class="mt-6 flex flex-wrap gap-3">
                        <a href="auth/register" class="inline-flex min-h-[2.9rem] items-center gap-2 rounded-xl px-5 text-sm font-bold text-white no-underline shadow-md transition hover:brightness-110" style="background: var(--sk-gradient);"><Icon Name="user-plus" Groesse="18" />Inscrire mon établissement</a>
                        <a href="auth/login" class="inline-flex min-h-[2.9rem] items-center gap-2 rounded-xl border border-slate-200 bg-white px-5 text-sm font-bold text-slate-800 no-underline shadow-sm transition hover:border-slate-300">Se connecter</a>
                    </div>
                    @if (aktiveSchulenAnzahl is > 0 && aktiveSchuelerAnzahl is not null)
                    {
                        <p class="mb-0 mt-5 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-slate-500">
                            <span class="inline-flex items-center gap-1.5"><Icon Name="school" Groesse="16" /><strong class="text-slate-800">@aktiveSchulenAnzahl</strong> établissement(s) actif(s)</span>
                            <span class="inline-flex items-center gap-1.5"><Icon Name="graduation" Groesse="16" /><strong class="text-slate-800">@aktiveSchuelerAnzahl</strong> élève(s) inscrit(s)</span>
                        </p>
                    }
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="grid gap-3 sm:grid-cols-2">
                    <AuthorizeView Roles="SchulLeiter,Koordinator" Context="d">
                        <a href="direction" class="group flex items-start gap-3 rounded-2xl border border-slate-200 bg-white p-4 no-underline shadow-sm transition hover:border-blue-200 hover:shadow-md sm:col-span-2"><span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl text-white" style="background: var(--sk-gradient);"><Icon Name="grid" /></span><span><strong class="block text-slate-900">Tableau de bord</strong><span class="text-sm text-slate-500">Chiffres clés, tâches du jour et finances de votre établissement</span></span></a>
                        <a href="schulleiter" class="group flex items-start gap-3 rounded-2xl border border-slate-200 bg-white p-4 no-underline shadow-sm transition hover:border-blue-200 hover:shadow-md"><span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-blue-50 text-blue-700"><Icon Name="school" /></span><span><strong class="block text-slate-900">Direction</strong><span class="text-sm text-slate-500">Élèves, classes, enseignants</span></span></a>
                        <a href="bulletins" class="group flex items-start gap-3 rounded-2xl border border-slate-200 bg-white p-4 no-underline shadow-sm transition hover:border-blue-200 hover:shadow-md"><span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-teal-50 text-teal-700"><Icon Name="report" /></span><span><strong class="block text-slate-900">Bulletins</strong><span class="text-sm text-slate-500">Préparer et publier</span></span></a>
                        <a href="finanzen" class="group flex items-start gap-3 rounded-2xl border border-slate-200 bg-white p-4 no-underline shadow-sm transition hover:border-blue-200 hover:shadow-md"><span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-emerald-50 text-emerald-700"><Icon Name="wallet" /></span><span><strong class="block text-slate-900">Comptabilité</strong><span class="text-sm text-slate-500">Frais et paiements</span></span></a>
                    </AuthorizeView>
                    <AuthorizeView Roles="Lehrer,SchulLeiter,Koordinator" Context="l">
                        <a href="notes" class="group flex items-start gap-3 rounded-2xl border border-slate-200 bg-white p-4 no-underline shadow-sm transition hover:border-blue-200 hover:shadow-md"><span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-amber-50 text-amber-700"><Icon Name="clipboard-check" /></span><span><strong class="block text-slate-900">Notes</strong><span class="text-sm text-slate-500">Saisir les évaluations</span></span></a>
                        <a href="emplois-du-temps" class="group flex items-start gap-3 rounded-2xl border border-slate-200 bg-white p-4 no-underline shadow-sm transition hover:border-blue-200 hover:shadow-md"><span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-blue-50 text-blue-700"><Icon Name="timetable" /></span><span><strong class="block text-slate-900">Emplois du temps</strong><span class="text-sm text-slate-500">Cours de la semaine</span></span></a>
                    </AuthorizeView>
                    <AuthorizeView Roles="SuperAdmin,ProduktOwner" Context="a">
                        <a href="admin" class="group flex items-start gap-3 rounded-2xl border border-slate-200 bg-white p-4 no-underline shadow-sm transition hover:border-blue-200 hover:shadow-md"><span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-blue-50 text-blue-700"><Icon Name="shield" /></span><span><strong class="block text-slate-900">Administration</strong><span class="text-sm text-slate-500">Établissements et comptes</span></span></a>
                        <a href="abrechnung" class="group flex items-start gap-3 rounded-2xl border border-slate-200 bg-white p-4 no-underline shadow-sm transition hover:border-blue-200 hover:shadow-md"><span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-emerald-50 text-emerald-700"><Icon Name="receipt" /></span><span><strong class="block text-slate-900">Facturation</strong><span class="text-sm text-slate-500">Cycles et paiements</span></span></a>
                    </AuthorizeView>
                    <a href="handbuch" class="group flex items-start gap-3 rounded-2xl border border-slate-200 bg-white p-4 no-underline shadow-sm transition hover:border-blue-200 hover:shadow-md"><span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-slate-100 text-slate-700"><Icon Name="help" /></span><span><strong class="block text-slate-900">Guide utilisateur</strong><span class="text-sm text-slate-500">Aide pas à pas</span></span></a>
                </div>
            </Authorized>
            <NotAuthorized>
                @* Vorschau als Oberfläche (kein Foto): zeigt, wie die Direktion arbeitet. Beispielwerte. *@
                <div class="relative" aria-label="Aperçu de l'espace direction (exemple)">
                    <div class="absolute -inset-3 -z-10 rounded-[1.75rem] opacity-25 blur-2xl" style="background: var(--sk-gradient);"></div>
                    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xl">
                        <div class="flex items-center justify-between gap-3">
                            <div class="flex items-center gap-3">
                                <span class="grid h-10 w-10 place-items-center rounded-xl text-white" style="background: var(--sk-gradient);"><Icon Name="school" Groesse="18" /></span>
                                <div><p class="mb-0 text-sm font-bold text-slate-900">Collège Les Palmiers</p><p class="mb-0 text-xs text-slate-500">Année scolaire 2026-2027</p></div>
                            </div>
                            <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[0.7rem] font-semibold text-slate-500">Exemple</span>
                        </div>
                        <div class="mt-4 grid grid-cols-2 gap-3">
                            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3"><p class="mb-0 text-xs font-semibold text-slate-500">Élèves</p><p class="mb-0 mt-1 text-2xl font-extrabold text-slate-900">482</p></div>
                            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3"><p class="mb-0 text-xs font-semibold text-slate-500">Classes</p><p class="mb-0 mt-1 text-2xl font-extrabold text-slate-900">18</p></div>
                            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                                <p class="mb-0 text-xs font-semibold text-slate-500">Frais encaissés</p>
                                <p class="mb-0 mt-1 text-2xl font-extrabold text-emerald-700">74 %</p>
                                <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-slate-200"><div class="h-full w-[74%] rounded-full bg-emerald-500"></div></div>
                            </div>
                            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3"><p class="mb-0 text-xs font-semibold text-slate-500">Absences du jour</p><p class="mb-0 mt-1 text-2xl font-extrabold text-amber-700">6</p></div>
                        </div>
                        <div class="mt-4 rounded-xl border border-slate-200">
                            <div class="flex items-center justify-between border-b border-slate-200 px-3 py-2"><span class="text-xs font-bold uppercase tracking-wide text-slate-500">Bulletins · 1er trimestre</span><span class="rounded-full bg-teal-50 px-2 py-0.5 text-[0.7rem] font-bold text-teal-700">En préparation</span></div>
                            @foreach (var (klasse, stand) in new[] { ("6e A", 100), ("5e B", 82), ("4e A", 64) })
                            {
                                <div class="flex items-center gap-3 px-3 py-2 text-sm">
                                    <span class="w-12 font-semibold text-slate-700">@klasse</span>
                                    <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-slate-200"><div class="h-full rounded-full bg-blue-600" style="width: @(stand)%"></div></div>
                                    <span class="w-10 text-right text-xs font-semibold text-slate-500">@stand %</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </section>

    <section id="apropos" class="scroll-mt-20">
        <div class="max-w-2xl">
            <p class="mb-0 text-xs font-bold uppercase tracking-[0.16em] text-teal-700">Fonctionnalités</p>
            <h2 class="mb-0 mt-2 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Tout ce dont votre établissement a besoin</h2>
            <p class="mb-0 mt-3 text-slate-600">Une plateforme pour écoles, collèges, lycées, universités et centres de formation. Chaque établissement gère ses propres données, en toute séparation.</p>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var (icon, titel, text) in Funktionen)
            {
                <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                    <span class="grid h-11 w-11 place-items-center rounded-xl bg-blue-50 text-blue-700"><Icon Name="@icon" /></span>
                    <h3 class="mb-0 mt-4 text-base font-bold text-slate-900">@titel</h3>
                    <p class="mb-0 mt-1.5 text-sm leading-6 text-slate-600">@text</p>
                </article>
            }
        </div>
    </section>

    <section class="grid gap-4 lg:grid-cols-3">
        @foreach (var (icon, rolle, punkte) in Rollen)
        {
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <div class="flex items-center gap-3">
                    <span class="grid h-10 w-10 place-items-center rounded-xl bg-teal-50 text-teal-700"><Icon Name="@icon" Groesse="18" /></span>
                    <h3 class="mb-0 text-base font-bold text-slate-900">@rolle</h3>
                </div>
                <ul class="mb-0 mt-3 grid list-none gap-2 p-0 text-sm text-slate-600">
                    @foreach (var punkt in punkte)
                    {
                        <li class="flex items-start gap-2"><Icon Name="check" Groesse="16" CssClass="mt-0.5 text-emerald-600" /><span>@punkt</span></li>
                    }
                </ul>
            </article>
        }
    </section>

    <AuthorizeView>
        <NotAuthorized>
            <section id="inscription" class="scroll-mt-20 overflow-hidden rounded-2xl p-6 text-white shadow-lg sm:p-8" style="background: var(--sk-gradient);">
                <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
                    <div>
                        <p class="mb-0 text-xs font-bold uppercase tracking-[0.16em] text-white/70">Démarrer</p>
                        <h2 class="mb-0 mt-2 text-2xl font-extrabold sm:text-3xl">Votre établissement en ligne en trois étapes</h2>
                        <ol class="mb-0 mt-5 grid list-none gap-3 p-0 sm:grid-cols-3">
                            @foreach (var (nummer, schritt, erklaerung) in Schritte)
                            {
                                <li class="rounded-xl bg-white/10 p-4">
                                    <span class="grid h-8 w-8 place-items-center rounded-full bg-white text-sm font-extrabold text-blue-800">@nummer</span>
                                    <strong class="mt-3 block">@schritt</strong>
                                    <span class="mt-1 block text-sm text-white/80">@erklaerung</span>
                                </li>
                            }
                        </ol>
                    </div>
                    <div class="flex flex-wrap gap-3 lg:flex-col">
                        <a href="auth/register" class="inline-flex min-h-[2.9rem] items-center justify-center gap-2 rounded-xl bg-white px-5 text-sm font-bold text-blue-800 no-underline shadow-md">Inscrire mon établissement</a>
                        <a href="auth/register" class="inline-flex min-h-[2.9rem] items-center justify-center gap-2 rounded-xl border border-white/40 px-5 text-sm font-bold text-white no-underline">Je suis élève</a>
                    </div>
                </div>
            </section>
        </NotAuthorized>
    </AuthorizeView>

    <section class="grid gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:grid-cols-3 sm:p-6">
        <div class="flex items-start gap-3"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-slate-100 text-slate-700"><Icon Name="lock" Groesse="18" /></span><div><strong class="text-slate-900">Données séparées</strong><p class="mb-0 mt-1 text-sm text-slate-600">Chaque établissement ne voit que ses propres élèves, notes et paiements.</p></div></div>
        <div class="flex items-start gap-3"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-slate-100 text-slate-700"><Icon Name="phone" Groesse="18" /></span><div><strong class="text-slate-900">Partout</strong><p class="mb-0 mt-1 text-sm text-slate-600">Sur ordinateur, tablette et téléphone, sans installation.</p></div></div>
        <div class="flex items-start gap-3"><span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-slate-100 text-slate-700"><Icon Name="mail" Groesse="18" /></span><div><strong class="text-slate-900">Une question ?</strong><p class="mb-0 mt-1 text-sm text-slate-600"><a href="contact" class="font-semibold text-blue-700 no-underline hover:underline">Contactez-nous</a> — nous vous aidons à démarrer.</p></div></div>
    </section>
</div>
