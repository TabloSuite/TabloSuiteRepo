@page "/admin/broadcast"
@attribute [Authorize(Roles = "SuperAdmin")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SkoulouApp.Core.Services.Email
@inherits SkoulouApp.WebApp.Components.CancelableComponentBase

<PageTitle>Communication</PageTitle>

@if (ShowAnnouncements)
{
<section class="mx-auto mt-4 w-full max-w-6xl rounded-[1.25rem] bg-white px-5 py-4 shadow-lg ring-1 ring-slate-100 sm:px-6 sm:py-5">
    <h1 class="text-2xl font-black text-slate-900">Annonces affichées dans l'application</h1>
    <p class="mt-2 text-sm text-slate-600">Les annonces restent visibles jusqu'à leur expiration ou leur suppression par l'Administrateur.</p>
    @if (!string.IsNullOrWhiteSpace(announcementMessage))
    {
        <p class="mt-3 rounded-xl bg-cyan-50 p-3 text-sm text-cyan-900" role="status">@announcementMessage</p>
    }
    <div class="mt-5 grid gap-4">
        <label class="block"><span class="skoulou-label">Titre</span><input class="skoulou-input" @bind="announcement.Title" maxlength="200" /></label>
        <div><label class="skoulou-label">Message</label><RichTextEditor @bind-Value="announcement.Body" EnableImages="false" EnableLargeEditor="true" /></div>
        <label class="block"><span class="skoulou-label">Expiration (heure locale)</span><input type="datetime-local" class="skoulou-input" @bind="announcement.ExpiresAtLocal" @bind:format="yyyy-MM-ddTHH:mm" /></label>
        <AsyncActionButton Class="skoulou-btn-accent rounded-full px-5 py-2.5 text-sm font-semibold" IsBusy="@isSavingAnnouncement" BusyLabel="Publication..." OnClick="PublishAnnouncementAsync">Publier l'annonce</AsyncActionButton>
    </div>
    @foreach (var item in announcements)
    {
        <div class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200 p-4" @key="item.Id">
            <div><strong class="text-slate-900">@item.Titel</strong><p class="text-xs text-slate-600">Expire le @item.AblaufAmUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p></div>
            <AsyncActionButton Class="rounded-full bg-rose-100 px-4 py-2 text-sm font-semibold text-rose-800" IsBusy="@isSavingAnnouncement" BusyLabel="Suppression..." OnClick="@(_ => DeleteAnnouncementAsync(item.Id))">Supprimer</AsyncActionButton>
        </div>
    }
</section>
}

@if (ShowEmailComposer)
{
<section class="w-full rounded-[2rem] bg-white p-2 sm:p-4">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-cyan-700">Communication</p>
    <h2 class="mt-3 text-2xl font-black text-slate-900">Rédiger un e-mail</h2>
    <p class="mt-4 text-sm leading-7 text-slate-600">Adressez-vous à une seule personne ou à un groupe de directeurs, d'enseignants ou d'élèves.</p>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="mt-6 rounded-2xl @(succeeded ? "bg-emerald-50 text-emerald-800" : "bg-rose-50 text-rose-800") px-4 py-3 text-sm">@message</div>
    }

    <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync" FormName="broadcast-form" class="mt-8 grid gap-5 min-w-0">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="grid gap-5 sm:grid-cols-2">
            <ModernDropdown TValue="BroadcastAudience?" Label="Destinataires" Value="Model.Audience" ValueChanged="SetAudienceAsync" Options="AudienceOptions" />
            <ModernDropdown TValue="string" Label="École" Value="Model.SchoolId" ValueChanged="SetSchoolAsync" Options="SchoolOptions" />
        </div>

        <div>
            <label class="skoulou-label">Adresses e-mail @(Model.Audience == BroadcastAudience.ManualAddresses ? "destinataires" : "supplémentaires")</label>
            <InputTextArea @bind-Value="Model.ManualRecipients" rows="2" placeholder="nom@exemple.com, autre@exemple.com" class="skoulou-input" />
            <p class="mt-2 text-xs text-slate-500">Une adresse suffit. Pour plusieurs, séparez-les par une virgule, un point-virgule ou un retour à la ligne.</p>
        </div>

        <div>
            <label class="skoulou-label">Sujet</label>
            <InputText @bind-Value="Model.Subject" class="skoulou-input" />
        </div>

        <div>
            <label class="skoulou-label">Message</label>
            <RichTextEditor @bind-Value="Model.Body"
                            Placeholder="Écris ton message..."
                            EnableImages="false" />
        </div>

        <div class="flex items-center gap-3">
            <AsyncActionButton Type="submit" Class="rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white disabled:opacity-50" IsBusy="@isSubmitting" BusyLabel="Envoi...">Envoyer</AsyncActionButton>
        </div>
    </EditForm>
</section>
}
