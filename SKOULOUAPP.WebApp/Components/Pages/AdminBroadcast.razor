@page "/admin/broadcast"
@attribute [Authorize(Roles = "SuperAdmin")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using HalloApp.Core.Services.Email
@inherits HalloApp.WebApp.Components.CancelableComponentBase

<PageTitle>Envoi d'e-mails</PageTitle>

<section class="mx-auto mt-16 w-full max-w-3xl rounded-[2rem] bg-white p-6 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 sm:p-8">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-cyan-700">Communication</p>
    <h1 class="mt-3 text-3xl font-black text-slate-900">Envoi d'e-mails groupés</h1>
    <p class="mt-4 text-sm leading-7 text-slate-600">Envoie un message aux directeurs, enseignants ou élèves — pour toutes les écoles ou une école précise.</p>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="mt-6 rounded-2xl @(succeeded ? "bg-emerald-50 text-emerald-800" : "bg-rose-50 text-rose-800") px-4 py-3 text-sm">@message</div>
    }

    <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync" FormName="broadcast-form" class="mt-8 grid gap-5 min-w-0">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="grid gap-5 sm:grid-cols-2">
            <ModernDropdown TValue="BroadcastAudience?" Label="Destinataires" Value="Model.Audience" ValueChanged="SetAudienceAsync" Options="AudienceOptions" />
            <ModernDropdown TValue="string" Label="École" Value="Model.SchoolId" ValueChanged="SetSchoolAsync" Options="SchoolOptions" />
        </div>

        <div>
            <label class="hallo-label">Adresses e-mail supplémentaires</label>
            <InputTextArea @bind-Value="Model.ManualRecipients" rows="2" placeholder="nom@exemple.com, autre@exemple.com" class="hallo-input" />
            <p class="mt-2 text-xs text-slate-500">Sépare les adresses par une virgule, un point-virgule ou un retour à la ligne. Elles reçoivent le message même si elles ne sont pas enregistrées.</p>
        </div>

        <div>
            <label class="hallo-label">Sujet</label>
            <InputText @bind-Value="Model.Subject" class="hallo-input" />
        </div>

        <div>
            <label class="hallo-label">Message</label>
            <RichTextEditor @bind-Value="Model.Body"
                            Placeholder="Écris ton message..."
                            EnableImages="false" />
        </div>

        <div class="flex items-center gap-3">
            <AsyncActionButton Type="submit" Class="rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white disabled:opacity-50" IsBusy="@isSubmitting" BusyLabel="Envoi...">Envoyer</AsyncActionButton>
        </div>
    </EditForm>
</section>
