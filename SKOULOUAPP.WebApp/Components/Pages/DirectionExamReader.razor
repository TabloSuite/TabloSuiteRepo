@page "/teacher-exams/{ExamId:guid}/view"
@attribute [Authorize(Policy = "RequireSchulLeiter")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits HalloApp.WebApp.Components.CancelableComponentBase
@using HalloApp.Core.Models.Admin
@using HalloApp.Core.Services.Text

<PageTitle>@(exam?.Title ?? "Examen")</PageTitle>

@if (notFound)
{
    <div class="rounded-[2rem] bg-white p-8 text-left shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
        <p class="text-sm font-bold text-slate-900">Cet examen n'est pas disponible pour ton rôle.</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">La direction et la coordination voient uniquement les examens partagés par les enseignants de leurs écoles.</p>
        <button type="button" class="mt-4 rounded-full bg-slate-100 px-6 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-200" @onclick="GoBack">Retour aux supports</button>
    </div>
}
else if (exam is null)
{
    <SkeletonLoader CardCount="2" />
}
else
{
    <section class="grid gap-6">
        <div class="hallo-hero rounded-[2rem] p-4 text-white shadow-2xl sm:p-5">
            <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-white/15 px-3 py-1 text-xs font-bold text-white ring-1 ring-white/30">@exam.NiveauCode</span>
                <span class="rounded-full bg-violet-100 px-3 py-1 text-xs font-bold text-violet-800">Lecture seule</span>
            </div>
            <h1 class="mt-2 text-2xl font-black sm:text-[1.7rem]">@exam.Title</h1>
            @if (!string.IsNullOrWhiteSpace(exam.Description))
            {
                <div class="mt-2 max-w-3xl text-sm leading-6 text-indigo-50">@((MarkupString)HtmlSanitizer.SanitizeMitBildern(exam.Description))</div>
            }
        </div>

        <div class="flex flex-wrap justify-center gap-3">
            <button type="button" class="rounded-full bg-slate-100 px-6 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-200" @onclick="GoBack">Retour aux supports</button>
            <a class="rounded-full bg-cyan-100 px-6 py-2.5 text-sm font-semibold text-cyan-800 transition hover:bg-cyan-200" href="/teacher-exams/@ExamId/pdf-file?solutions=false" target="_blank">Exporter PDF</a>
        </div>

        <div class="rounded-[1.5rem] bg-white p-3 shadow-md shadow-slate-200/70 ring-1 ring-slate-100 sm:p-4 lg:rounded-[2rem] lg:p-6">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-emerald-700 sm:text-sm">Exercices</p>
            <h2 class="mt-1 text-lg font-bold text-slate-900 sm:text-xl">Consultation uniquement</h2>

            @if (exam.Exercises.Count == 0)
            {
                <p class="mt-4 text-sm text-slate-500">Aucune question n'est disponible pour cet examen.</p>
            }
            else
            {
                <div class="mt-4 grid gap-3">
                    @foreach (var block in exam.Exercises.OrderBy(x => x.Number))
                    {
                        <article class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="rounded-full bg-indigo-100 px-3 py-1 text-xs font-semibold text-indigo-800">Exercice @block.Number</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(block.Title))
                            {
                                <p class="mt-2 text-sm font-bold text-slate-900">@block.Title</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(block.Consigne))
                            {
                                <div class="mt-1 text-sm text-slate-600">@((MarkupString)HtmlSanitizer.SanitizeMitBildern(block.Consigne))</div>
                            }

                            <div class="mt-3 grid gap-3">
                                @foreach (var question in block.Questions.OrderBy(x => x.Number))
                                {
                                    <div class="rounded-xl border border-slate-200 bg-white p-3">
                                        <p class="text-sm font-semibold text-slate-900">@question.Number. @((MarkupString)HtmlSanitizer.SanitizeMitBildern(question.Prompt))</p>

                                        @if (question.QuestionType is "Choice" or "SingleChoice" or "AudioChoice" or "AudioSingleChoice")
                                        {
                                            <div class="mt-2 space-y-2">
                                                @foreach (var option in question.Options)
                                                {
                                                    <label class="flex items-center gap-2 text-sm font-medium text-slate-900">
                                                        <span class="inline-flex h-4 w-4 items-center justify-center rounded-full border-2 border-slate-700" aria-hidden="true"></span>
                                                        <span>@HtmlSanitizer.ToPlainText(option)</span>
                                                    </label>
                                                }
                                            </div>
                                        }
                                        else if (question.QuestionType is "MultipleChoice" or "AudioMultipleChoice")
                                        {
                                            <div class="mt-2 space-y-2">
                                                @foreach (var option in question.Options)
                                                {
                                                    <label class="flex items-center gap-2 text-sm font-medium text-slate-900">
                                                        <span class="inline-flex h-4 w-4 items-center justify-center rounded-[3px] border-2 border-slate-700" aria-hidden="true"></span>
                                                        <span>@HtmlSanitizer.ToPlainText(option)</span>
                                                    </label>
                                                }
                                            </div>
                                        }
                                        else if (question.QuestionType == "GapFill")
                                        {
                                            <div class="mt-2 flex flex-wrap gap-2">
                                                @for (var i = 0; i < Math.Max(question.GapCount, 1); i++)
                                                {
                                                    <input type="text" disabled class="hallo-input w-28 bg-slate-50 text-xs" />
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <textarea disabled class="hallo-input mt-2 min-h-24 w-full bg-slate-50 text-sm" placeholder="Réponse..."></textarea>
                                        }
                                    </div>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </div>

    </section>
}
