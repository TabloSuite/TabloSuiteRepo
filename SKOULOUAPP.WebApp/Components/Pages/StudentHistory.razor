@page "/student/history"
@attribute [Authorize(Policy = "RequireStudent")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits HalloApp.WebApp.Components.CancelableComponentBase
@using HalloApp.Core.Models.TeacherLessons

<PageTitle>Historique</PageTitle>

<section class="student-exams-page grid gap-6">
    <div class="rounded-[2rem] bg-gradient-to-br from-slate-700 via-slate-800 to-slate-900 p-6 text-white shadow-2xl shadow-slate-300/40 sm:p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-300">Suivi personnel</p>
        <h1 class="mt-3 text-3xl font-black">Mon historique</h1>
        <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-100">Retrouve ici les supports publiés des classes précédentes avec filtres par enseignant et matière.</p>
    </div>

    @if (historyLessons is null)
    {
        <SkeletonLoader ShowStatRow="false" />
    }
    else
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-4">
            <div class="grid gap-3 sm:grid-cols-2">
                <ModernDropdown TValue="Guid?" Label="Filtrer par enseignant" Value="selectedTeacherId" ValueChanged="SetTeacherFilterAsync" Options="TeacherOptions" Searchable="true" SearchPlaceholder="Rechercher un enseignant..." />
                <ModernDropdown TValue="Guid?" Label="Filtrer par matière" Value="selectedFachId" ValueChanged="SetFachFilterAsync" Options="FachOptions" Searchable="true" SearchPlaceholder="Rechercher une matière..." />
            </div>
        </div>

        if (FilteredHistoryLessons.Count == 0)
        {
            <div class="rounded-[2rem] bg-white p-8 text-left shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
                <p class="text-sm font-bold text-slate-900">Aucun support historique ne correspond aux filtres.</p>
            </div>
        }
        else
        {
            <div class="grid gap-4">
                @foreach (var item in FilteredHistoryLessons)
                {
                    <article class="rounded-3xl bg-white p-5 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 transition duration-200 hover:-translate-y-1 hover:shadow-xl">
                        <button type="button" class="w-full text-left" @onclick="() => OpenLesson(item.Id)">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-700">@item.CourseCode</span>
                                @if (!string.IsNullOrWhiteSpace(item.KlasseTitle))
                                {
                                    <span class="rounded-full bg-slate-50 px-3 py-1 text-xs text-slate-700">@item.KlasseTitle</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.FachName))
                                {
                                    <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">@item.FachName</span>
                                }
                                <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs text-indigo-700">@item.AuthorName</span>
                                <span class="text-xs text-slate-400">@item.PageCount page(s)</span>
                            </div>
                            <h2 class="mt-2 text-lg font-bold text-slate-900">@item.Title</h2>
                            <p class="mt-1 text-sm text-slate-500">@item.Summary</p>
                        </button>
                        <div class="mt-4 flex flex-wrap gap-2 border-t border-slate-100 pt-4">
                            <button type="button" class="inline-flex rounded-full bg-violet-100 px-4 py-2 text-xs font-semibold text-violet-800 transition hover:bg-violet-200" @onclick="() => OpenLesson(item.Id)">Lire la leçon</button>
                            @if (item.IsPdfExportEnabled)
                            {
                                <a class="inline-flex rounded-full bg-cyan-100 px-4 py-2 text-xs font-semibold text-cyan-800 transition hover:bg-cyan-200" href="/student/cours/@item.Id/pdf" target="_blank">Exporter PDF</a>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    }
</section>
