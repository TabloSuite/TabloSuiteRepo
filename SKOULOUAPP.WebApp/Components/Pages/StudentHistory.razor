@page "/student/history"
@attribute [Authorize(Policy = "RequireStudent")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits SkoulouApp.WebApp.Components.CancelableComponentBase
@using SkoulouApp.Core.Models.TeacherLessons

<PageTitle>Mon historique · SKOULOU</PageTitle>

<div class="student-exams-page grid gap-5">
    <SeitenKopf Rubrik="Espace élève" Titel="Mon historique" IconName="history"
                Untertitel="Vos classes et leurs résultats, ainsi que les supports de cours des classes précédentes. Les épreuves de votre classe actuelle restent dans « Examens »." />

    @if (historyLessons is null)
    {
        <SkeletonLoader ShowStatRow="false" />
    }
    else
    {
        @if (classHistory.Count > 0)
        {
            <section class="grid gap-3 sm:grid-cols-2" aria-label="Mes classes">
                @foreach (var cycle in classHistory)
                {
                    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm" @key="cycle.DurchlaufId">
                        <div class="flex flex-wrap items-start justify-between gap-2">
                            <div>
                                <h2 class="mb-0 text-base font-bold text-slate-900">@cycle.CourseCode · @cycle.CourseTitle</h2>
                                <p class="mb-0 mt-0.5 text-sm text-slate-500">Du @cycle.StartDatum.ToLocalTime().ToString("dd/MM/yyyy") au @(cycle.EndDatum?.ToLocalTime().ToString("dd/MM/yyyy") ?? "aujourd'hui")</p>
                            </div>
                            <Badge Accent="@(cycle.EndDatum.HasValue ? "slate" : "emerald")">@(cycle.EndDatum.HasValue ? "Cycle clôturé" : "Cycle en cours")</Badge>
                        </div>
                        <dl class="m-0 mt-4 grid grid-cols-3 gap-2 text-center">
                            <div class="rounded-xl bg-slate-50 px-2 py-2">
                                <dt class="text-xs font-semibold text-slate-500">Score</dt>
                                <dd class="m-0 text-base font-extrabold tabular-nums" style="color:@(cycle.ScorePercent is int sp ? ScoreColorHelper.GetScoreColor(sp) : "#8a95a8")">@(cycle.ScorePercent is int s ? $"{s} %" : "–")</dd>
                            </div>
                            <div class="rounded-xl bg-slate-50 px-2 py-2">
                                <dt class="text-xs font-semibold text-slate-500">Note finale</dt>
                                <dd class="m-0 text-base font-extrabold text-slate-900">@(cycle.AbschlussNoteText ?? "–")</dd>
                            </div>
                            <div class="rounded-xl px-2 py-2 @(cycle.IsBestanden == false ? "bg-rose-50" : cycle.IsBestanden == true ? "bg-emerald-50" : "bg-slate-50")">
                                <dt class="text-xs font-semibold text-slate-500">Décision</dt>
                                <dd class="m-0 text-sm font-bold @(cycle.IsBestanden == false ? "text-rose-800" : cycle.IsBestanden == true ? "text-emerald-800" : "text-slate-700")">@(cycle.IsBestanden == true ? "Réussi" : cycle.IsBestanden == false ? "Non réussi" : "En attente")</dd>
                            </div>
                        </dl>
                        @if (cycle.ScorePercent is not null || !string.IsNullOrWhiteSpace(cycle.MentionText))
                        {
                            <p class="mb-0 mt-3 text-sm text-slate-600">
                                @if (cycle.ScorePercent is not null)
                                {
                                    <span>Score sur @cycle.ScoreCount épreuve@(cycle.ScoreCount > 1 ? "s" : "")</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(cycle.MentionText))
                                {
                                    <span> · Mention : <strong>@cycle.MentionText</strong></span>
                                }
                            </p>
                        }
                    </article>
                }
            </section>
        }

        <Abschnitt Titel="Supports des classes précédentes" Untertitel="Relisez les leçons de vos anciennes classes et exportez-les en PDF." IconName="book">
            <div class="mb-4 grid gap-3 sm:grid-cols-2">
                <ModernDropdown TValue="Guid?" Label="Enseignant" Value="selectedTeacherId" ValueChanged="SetTeacherFilterAsync" Options="TeacherOptions" Searchable="true" SearchPlaceholder="Rechercher un enseignant..." />
                <ModernDropdown TValue="Guid?" Label="Matière" Value="selectedFachId" ValueChanged="SetFachFilterAsync" Options="FachOptions" Searchable="true" SearchPlaceholder="Rechercher une matière..." />
            </div>

            @if (FilteredHistoryLessons.Count == 0)
            {
                <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 px-5 py-8 text-center text-sm text-slate-500">
                    @(historyLessons.Count == 0 ? "Aucun support pour le moment : ils apparaissent ici après la fin d'une classe." : "Aucun support ne correspond aux filtres.")
                </div>
            }
            else
            {
                <ul class="m-0 grid list-none gap-3 p-0">
                    @foreach (var item in FilteredHistoryLessons)
                    {
                        <li class="rounded-2xl border border-slate-200 bg-white p-4">
                            <button type="button" class="w-full bg-transparent p-0 text-left" @onclick="() => OpenLesson(item.Id)">
                                <span class="flex flex-wrap items-center gap-2 text-xs font-semibold">
                                    <span class="rounded-full bg-blue-50 px-2.5 py-1 text-blue-800">@item.CourseCode</span>
                                    @if (!string.IsNullOrWhiteSpace(item.KlasseTitle))
                                    {
                                        <span class="rounded-full bg-slate-100 px-2.5 py-1 text-slate-700">@item.KlasseTitle</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.FachName))
                                    {
                                        <span class="rounded-full bg-slate-100 px-2.5 py-1 text-slate-700">@item.FachName</span>
                                    }
                                    <span class="font-normal text-slate-500">@item.AuthorName · @item.PageCount page(s)</span>
                                </span>
                                <span class="mt-2 block text-base font-bold text-slate-900">@item.Title</span>
                                @if (!string.IsNullOrWhiteSpace(item.Summary))
                                {
                                    <span class="mt-0.5 block text-sm text-slate-500">@item.Summary</span>
                                }
                            </button>
                            <div class="mt-3 flex flex-wrap gap-2">
                                <button type="button" class="sk-btn sk-btn-sm sk-btn-primary" @onclick="() => OpenLesson(item.Id)"><Icon Name="book-open" Groesse="14" />Lire la leçon</button>
                                @if (item.IsPdfExportEnabled)
                                {
                                    <a class="sk-btn sk-btn-sm sk-btn-secondary" href="/student/lessons/support/@item.Id/pdf-file" target="_blank"><Icon Name="printer" Groesse="14" />PDF</a>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
        </Abschnitt>
    }
</div>
