@page "/teacher/create"
@attribute [Authorize(Policy = "RequireTeacher")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SkoulouApp.WebApp.Components.Pages

<PageTitle>Leçons et examens · SKOULOU</PageTitle>

<div class="mx-auto grid max-w-6xl gap-5">
    <SeitenKopf Rubrik="Espace enseignant" Titel="Leçons et examens" IconName="pen"
                Untertitel="@(activeMode == TeacherCreateMode.Lesson
                    ? "Créez vos leçons avec leur contenu et leurs exercices, puis publiez-les pour vos classes."
                    : "Préparez vos examens : exercices, publication pour les élèves, date limite et exports PDF.")" />

    <Reiter Eintraege="ModusReiter" Aktiv="@(activeMode == TeacherCreateMode.Exam ? "exam" : "lesson")"
            AktivChanged="ModusWechseln"
            AriaLabel="Leçons ou examens" />

    <div class="min-h-[30rem] skoulou-tab-panel" @key="activeMode">
        @if (activeMode == TeacherCreateMode.Lesson)
        {
            <TeacherLessonExercises Embedded="true" />
        }
        else
        {
            <TeacherExams Embedded="true" />
        }
    </div>
</div>

@code {
    private static readonly IReadOnlyList<Reiter.Eintrag> ModusReiter =
    [
        new("lesson", "Leçons et exercices", "book-open"),
        new("exam", "Examens", "exam")
    ];

    private void ModusWechseln(string schluessel)
        => SetMode(schluessel == "exam" ? TeacherCreateMode.Exam : TeacherCreateMode.Lesson);
}
