@page "/teacher/create"
@attribute [Authorize(Policy = "RequireTeacher")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SkoulouApp.WebApp.Components.Pages

<PageTitle>Création leçon & examens</PageTitle>

<section class="teacher-create-shell grid gap-6">
    <div class="skoulou-hero rounded-[2rem] p-6 text-white shadow-2xl sm:p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-100">Espace enseignant</p>
        <h1 class="mt-3 text-3xl font-black">Création leçon & examens</h1>
        <p class="mt-3 max-w-3xl text-sm leading-7 text-indigo-50">
            Depuis cette page unique, choisis le type de contenu à créer: leçon (avec contenu et exercices) ou examen (avec liste d'exercices).
        </p>

        <div class="teacher-create-switch mt-5 grid gap-2 sm:inline-flex sm:grid-cols-2 sm:rounded-full sm:bg-white/10 sm:p-1 sm:ring-1 sm:ring-white/25">
            <button type="button"
                    class="teacher-create-switch-btn rounded-full px-4 py-2 text-sm font-semibold transition @(activeMode == TeacherCreateMode.Lesson ? "bg-white text-indigo-700" : "text-white hover:bg-white/15")"
                    @onclick="() => SetMode(TeacherCreateMode.Lesson)">
                Leçon + exercices
            </button>
            <button type="button"
                    class="teacher-create-switch-btn rounded-full px-4 py-2 text-sm font-semibold transition @(activeMode == TeacherCreateMode.Exam ? "bg-white text-indigo-700" : "text-white hover:bg-white/15")"
                    @onclick="() => SetMode(TeacherCreateMode.Exam)">
                Examens
            </button>
        </div>
    </div>

    <div class="teacher-create-context rounded-3xl bg-white p-4 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 sm:p-5">
        @if (activeMode == TeacherCreateMode.Lesson)
        {
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-cyan-700">Mode leçon</p>
            <p class="mt-1 text-sm text-slate-600">Crée la leçon, ajoute son contenu et, si nécessaire, ses exercices dans le même flux.</p>
        }
        else
        {
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-amber-700">Mode examen</p>
            <p class="mt-1 text-sm text-slate-600">Prépare un examen avec ses exercices, ses paramètres de publication et ses exports PDF.</p>
        }
    </div>

    <div class="min-h-[30rem]">
        @if (activeMode == TeacherCreateMode.Lesson)
        {
            <TeacherLessonExercises Embedded="true" />
        }
        else
        {
            <TeacherExams Embedded="true" />
        }
    </div>
</section>
