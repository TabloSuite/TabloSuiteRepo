@page "/teacher/lesson-exercises"
@attribute [Authorize(Policy = "RequireTeacher")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits SkoulouApp.WebApp.Components.CancelableComponentBase
@using SkoulouApp.Core.Models.Admin
@using SkoulouApp.Core.Services.Text
@using SkoulouApp.WebApp.Components.Shared

@if (!Embedded)
{
    <PageTitle>Exercices des leçons</PageTitle>
}

<section class="grid gap-6 @(Embedded ? "teacher-create-embedded" : string.Empty)">
    @if (!Embedded)
    {
        <div class="skoulou-hero rounded-[1.25rem] px-5 py-4 text-white shadow-2xl sm:px-6 sm:py-5">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-100">Espace enseignant</p>
            <h1 class="mt-3 text-3xl font-black">Exercices des leçons</h1>
            <p class="mt-3 max-w-3xl text-sm leading-7 text-indigo-50">Gère les exercices de tes leçons avec la même structure que les examens.</p>
        </div>
    }

    @if (isLoading)
    {
        <div class="rounded-[2rem] bg-white p-8 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
            <div class="flex items-center gap-3 text-slate-600">
                <ProgressRing Size="1.5rem" Label="Chargement des leçons" />
                <p class="text-sm">Chargement...</p>
            </div>
        </div>
    }
    else
    {
        <Toast Message="@statusMessage" MessageChanged="v => statusMessage = v" Kind="Toast.ToastKind.Success" />
        <Toast Message="@errorMessage" MessageChanged="v => errorMessage = v" Kind="Toast.ToastKind.Error" />
        <Toast Message="@videoUploadMessage" MessageChanged="v => videoUploadMessage = v" Kind="Toast.ToastKind.Success" />
        <Toast Message="@videoUploadError" MessageChanged="v => videoUploadError = v" Kind="Toast.ToastKind.Error" />

        @if (!editorOpen)
        {
            <div class="flex justify-end">
                <button type="button" class="skoulou-btn-accent inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold shadow-lg transition" @onclick="OpenCreateAsync">
                    + Nouvelle leçon + exercices
                </button>
            </div>

            <div class="rounded-3xl bg-white p-5 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
                <div class="mb-3 flex items-center justify-between gap-3">
                    <h2 class="text-lg font-black text-slate-900">Corrections manuelles en attente</h2>
                    <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-800">@VisiblePendingManualReviews.Count</span>
                </div>

                <div class="mb-4 grid gap-3 rounded-2xl border border-slate-200 bg-slate-50/80 p-3 sm:grid-cols-2">
                    <ModernDropdown TValue="Guid?"
                                    Label="École"
                                    Value="pendingReviewSchoolFilterId"
                                    ValueChanged="SetPendingReviewSchoolFilterAsync"
                                    Options="PendingReviewSchoolFilterOptions" EinzigeOptionFest="true" />
                    <ModernDropdown TValue="Guid?"
                                    Label="Classe"
                                    Value="pendingReviewKlasseFilterId"
                                    ValueChanged="SetPendingReviewKlasseFilterAsync"
                                    Options="PendingReviewKlasseFilterOptions" />
                </div>

                @if (VisiblePendingManualReviews.Count == 0)
                {
                    <p class="text-sm text-slate-500">@PendingManualReviewEmptyMessage</p>
                }
                else
                {
                    <div class="space-y-3">
                        @foreach (var review in VisiblePendingManualReviews)
                        {
                            <article class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">@review.SchoolName · @review.CourseCode · @review.LessonTitle · @review.ExerciseTitle</p>
                                <p class="mt-1 text-sm font-bold text-slate-900">@review.StudentName</p>
                                <div class="mt-2">
                                    <p class="mb-1 text-[0.7rem] font-semibold uppercase tracking-[0.08em] text-slate-500">Consigne de l'enseignant</p>
                                    <div class="rich-content rounded-xl bg-white p-3 text-sm text-slate-700 ring-1 ring-slate-200">
                                        <div class="ql-editor" style="padding:0;">
                                            @((MarkupString)HtmlSanitizer.SanitizeMitBildern(review.Question))
                                        </div>
                                    </div>
                                </div>
                                <p class="mt-1 text-xs text-slate-500">Max points: @review.ExercisePoints</p>
                                <div class="mt-2">
                                    <p class="mb-1 text-[0.7rem] font-semibold uppercase tracking-[0.08em] text-slate-500">Réponse de l'élève</p>
                                    <div class="rich-content rounded-xl bg-white p-3 text-sm text-slate-700 ring-1 ring-slate-200">
                                        <div class="ql-editor" style="padding:0;">
                                            @((MarkupString)HtmlSanitizer.SanitizeMitBildern(review.SubmittedTextAnswer ?? string.Empty))
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <label class="skoulou-label">Points attribués</label>
                                    <input type="number"
                                           class="skoulou-input"
                                           min="0"
                                           max="@review.ExercisePoints"
                                           value="@GetManualPoints(review.AttemptId, review.ExercisePoints)"
                                           @oninput="(ChangeEventArgs e) => OnManualPointsInput(review.AttemptId, review.ExercisePoints, e)" />
                                </div>
                                <div class="mt-3">
                                    <label class="skoulou-label">Feedback (optionnel)</label>
                                    <textarea class="skoulou-input min-h-16"
                                              @oninput="(ChangeEventArgs e) => OnManualFeedbackInput(review.AttemptId, e)">@GetManualFeedback(review.AttemptId)</textarea>
                                </div>
                                <div class="mt-3 flex flex-wrap gap-2">
                                    <button type="button" class="rounded-full bg-slate-900 px-4 py-2 text-xs font-semibold text-white transition hover:bg-slate-800 disabled:opacity-50" disabled="@isSavingManualReview" @onclick="() => GradeManualAsync(review.AttemptId)">Enregistrer la note</button>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>

            <div class="grid gap-3 rounded-3xl border border-slate-200 bg-white p-4 sm:grid-cols-2">
                <ModernDropdown TValue="Guid?"
                                Label="École"
                                Value="lessonListSchoolFilterId"
                                ValueChanged="SetLessonListSchoolFilterAsync"
                                Options="LessonListSchoolFilterOptions" EinzigeOptionFest="true" />
                <ModernDropdown TValue="Guid?"
                                Label="Classe"
                                Value="lessonListKlasseFilterId"
                                ValueChanged="SetLessonListKlasseFilterAsync"
                                Options="LessonListKlasseFilterOptions" />
            </div>

            @if (VisibleLessons.Count == 0)
            {
                <div class="rounded-3xl bg-white p-6 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 min-h-[9rem] flex items-center justify-center">
                    <p class="text-sm text-slate-600">@(lessons.Count == 0 ? "Aucune leçon attribuée à tes classes." : "Aucune leçon ne correspond aux filtres sélectionnés.")</p>
                </div>
            }
            else
            {
                <div class="grid gap-4">
                    @foreach (var lesson in VisibleLessons)
                    {
                        <article class="rounded-3xl bg-white p-5 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
                            <div class="flex flex-wrap items-start justify-between gap-4">
                                <div>
                                    <div class="flex items-center gap-2">
                                        <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-bold text-indigo-700">@lesson.CourseCode</span>
                                        @if (!string.IsNullOrWhiteSpace(lesson.FachName))
                                        {
                                            <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">@lesson.FachName</span>
                                        }
                                        <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600">@lesson.ExerciseCount exercice(s)</span>
                                         @if (lesson.IsCurrentAssignmentVersionLocked)
                                         {
                                             <span class="rounded-full border border-amber-200 bg-amber-100 px-3 py-1 text-xs font-black uppercase tracking-wide text-amber-800">Leçon verrouillée</span>
                                         }
                                         else if (lesson.HasSubmissionsInCurrentAssignmentVersion)
                                         {
                                             <span class="rounded-full border border-indigo-200 bg-indigo-100 px-3 py-1 text-xs font-semibold text-indigo-800">Soumissions existantes (v@lesson.AssignmentVersion)</span>
                                         }
                                    </div>
                                    <h2 class="mt-2 text-lg font-bold text-slate-900">@lesson.Title</h2>
                                    <p class="mt-1 text-sm text-slate-500">@lesson.Summary</p>
                                    <div class="mt-3 flex flex-wrap items-center gap-2">
                                        @if (lesson.ExerciseSubmissionDueAtUtc is DateTime dueAtUtc)
                                        {
                                            var isOpen = dueAtUtc > DateTime.UtcNow;
                                            <span class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-bold ring-1 @(isOpen ? "bg-emerald-50 text-emerald-800 ring-emerald-200" : "bg-rose-50 text-rose-800 ring-rose-200")">
                                                <span class="h-2 w-2 rounded-full @(isOpen ? "bg-emerald-500" : "bg-rose-500")" aria-hidden="true"></span>
                                                @(isOpen ? "Remise en cours" : "Date limite passée")
                                            </span>
                                            <span class="text-xs font-semibold text-slate-500">Jusqu'au @dueAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                        }
                                        else
                                        {
                                            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600 ring-1 ring-slate-200">Aucune date limite</span>
                                        }
                                    </div>
                                </div>
                                <div class="flex flex-wrap justify-end gap-2">
                                    <a class="rounded-full bg-slate-100 px-4 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-200" href="/teacher/lesson-exercises/@lesson.LessonId/view?from=teacher-create">Voir le contenu</a>
                                    <a class="rounded-full bg-cyan-100 px-4 py-2 text-xs font-semibold text-cyan-800 transition hover:bg-cyan-200" href="/teacher/lesson-exercises/@lesson.LessonId/pdf-file" target="_blank">Exporter PDF</a>
                                    <button type="button" class="rounded-full bg-indigo-100 px-4 py-2 text-xs font-semibold text-indigo-800 transition hover:bg-indigo-200" @onclick="() => OpenDueDateModalAsync(lesson)">Modifier la date limite</button>
                                    <button type="button" class="rounded-full bg-violet-100 px-4 py-2 text-xs font-semibold text-violet-800 transition hover:bg-violet-200" @onclick="() => OpenReassignFromListAsync(lesson.LessonId)">Modifier et réattribuer</button>
                                    <button type="button" class="rounded-full bg-slate-900 px-4 py-2 text-xs font-semibold text-white transition hover:bg-slate-800" @onclick="() => OpenEditorAsync(lesson.LessonId)">Modifier la leçon</button>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        }
        else if (form is not null)
        {
            <div class="fixed inset-0 z-[2200] flex items-center justify-center overflow-hidden bg-slate-900/50 p-4 sm:p-5">
                <div class="skoulou-modal-surface mx-auto flex h-full w-full max-w-6xl flex-col rounded-3xl bg-white shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
                    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-4 py-3 sm:px-5">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">@selectedLessonCode</p>
                            <h2 class="text-lg font-black text-slate-900">@(isReassignCreationMode ? "Nouvelle leçon + réattribution" : (string.IsNullOrWhiteSpace(form.Title) ? "Nouvelle leçon" : form.Title))</h2>
                        </div>
                        <button type="button" class="rounded-full bg-slate-100 px-4 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-200" @onclick="CloseEditor">Retour</button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="mx-4 mt-3 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-800 sm:mx-5" role="alert">@errorMessage</div>
                    }

                    <div @ref="editorScrollContainer" class="skoulou-modal-scroll min-w-0 flex-1 px-3 py-4 sm:px-5">

                @if (form.LessonId.HasValue && (isCurrentAssignmentVersionLocked || form.HasSubmissionsInCurrentAssignmentVersion))
                {
                    <div class="mb-4 rounded-2xl border border-indigo-100 bg-indigo-50/50 p-4 text-sm text-indigo-900">
                        @if (isCurrentAssignmentVersionLocked)
                        {
                            <div class="flex flex-wrap items-center justify-between gap-3">
                                <p class="inline-flex items-center rounded-full border border-amber-200 bg-amber-100 px-3 py-1 text-xs font-black uppercase tracking-wide text-amber-800">Leçon verrouillée</p>
                                <button type="button" class="rounded-full bg-violet-100 px-3 py-1.5 text-xs font-semibold text-violet-800 transition hover:bg-violet-200" @onclick="() => OpenReassignFromListAsync(form.LessonId!.Value)">Modifier et réattribuer</button>
                            </div>
                            <p class="mt-2 font-semibold">@($"Session d'attribution actuelle : v{form.AssignmentVersion}")</p>
                            <p class="mt-1">Cette session est verrouillée: des élèves ont déjà soumis et la date limite n'est pas encore atteinte. Après la date limite, tes modifications ouvriront automatiquement une nouvelle session.</p>
                        }
                        else if (form.HasSubmissionsInCurrentAssignmentVersion)
                        {
                            <p class="font-semibold">@($"Session d'attribution actuelle : v{form.AssignmentVersion}")</p>
                            <p class="mt-1">Des soumissions existent pour cette session. La prochaine modification enregistrée ouvrira une nouvelle session (v@(form.AssignmentVersion + 1)).</p>
                        }
                    </div>
                }

                @if (isReassignCreationMode)
                {
                    <div class="mb-4 rounded-2xl border border-violet-200 bg-violet-50/70 p-4 text-sm text-violet-900">
                        <p class="font-semibold">Mode nouvelle attribution</p>
                        <p class="mt-1">Tu modifies la leçon complète (contenu + exercices). Elle sera enregistrée comme une nouvelle leçon publiée.</p>
                    </div>
                }

                <EditForm Model="form" OnValidSubmit="SaveAsync" FormName="teacher-lesson-exercise-form" class="grid gap-4">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="grid gap-4 rounded-2xl border border-slate-200 bg-slate-50 p-4 xl:grid-cols-2">
                        <div>
                            <label class="skoulou-label">@(isReassignCreationMode ? "Nouveau titre de la leçon" : "Titre de la leçon")</label>
                            <InputText @bind-Value="form.Title"
                                       class="skoulou-input"
                                       disabled="@isCurrentAssignmentVersionLocked"
                                       placeholder="@(isReassignCreationMode ? "Saisir le nouveau titre (obligatoire)" : null)" />
                        </div>
                        <div>
                            <ModernDropdown TValue="Guid?" Label="École" Value="selectedSchoolId" ValueChanged="SetLessonSchoolAsync" Options="SchoolOptions" EinzigeOptionFest="true" Disabled="@isCurrentAssignmentVersionLocked" />
                        </div>
                        <div>
                            <ModernDropdown TValue="Guid?" Label="Niveau" Value="form.CourseId" ValueChanged="SetLessonCourseAsync" Options="CourseOptions" Disabled="@isCurrentAssignmentVersionLocked" />
                        </div>
                        <div class="xl:col-span-2 rounded-2xl border border-indigo-100 bg-indigo-50/40 p-3">
                            <ModernDropdown TValue="Guid?" Label="Matière" Value="form.FachId" ValueChanged="SetLessonFachAsync" Options="FachOptions" Disabled="@isCurrentAssignmentVersionLocked" />
                            @if (filteredFachOptions.Count == 0)
                            {
                                <p class="mt-2 text-xs font-semibold text-rose-700">Aucune matière attribuée. Demande à la direction d'ajouter et de t'attribuer une matière.</p>
                            }
                        </div>
                        <div class="xl:col-span-2">
                            <label class="skoulou-label">Résumé (optionnel)</label>
                            <InputTextArea @bind-Value="form.Summary" class="skoulou-input min-h-16" disabled="@isCurrentAssignmentVersionLocked" />
                        </div>
                        <div class="xl:col-span-2">
                            <label class="skoulou-label">Contenu de la leçon</label>
                            <RichTextEditor @ref="lessonContentEditor"
                                            @bind-Value="form.Content"
                                            EnableImages="true"
                                            RequestImageLibrary="OpenImageLibrary"
                                            ImageLibraryTargetRequested="SetImageLibraryTarget"
                                            Placeholder="Rédige le contenu de la leçon..."
                                            MinEditorHeightRem="28"
                                            Paged="true"
                                            ReadOnly="@isCurrentAssignmentVersionLocked" />
                        </div>
                        <div class="rounded-2xl border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-600">
                            L'ordre d'affichage est attribué automatiquement.
                        </div>
                        <label class="flex items-center gap-2">
                            <input type="checkbox" class="h-4 w-4 rounded border-slate-300" @bind="form.IsPublished" disabled="@isCurrentAssignmentVersionLocked" />
                            <span class="text-sm font-semibold text-slate-700">Publier la leçon et ses exercices</span>
                        </label>
                        <div>
                            <label class="skoulou-label">Date limite des réponses ouvertes (optionnel)</label>
                            <TailwindDateTimePicker @bind-Value="form.ExerciseSubmissionDueAtUtc" IsDisabled="@isCurrentAssignmentVersionLocked" />
                        </div>
                    </div>

                    <div class="rounded-3xl border border-cyan-100 bg-cyan-50/60 p-4">
                        <div class="flex flex-wrap items-start justify-between gap-3">
                            <div>
                                <p class="text-sm font-black text-cyan-950">Vidéo de la leçon (optionnel)</p>
                                <p class="mt-1 text-xs leading-5 text-cyan-800">Choisis une vidéo existante ou téléverse-en une nouvelle. Durée maximale : 1 heure.</p>
                            </div>
                            @if (form.VideoAssetId.HasValue)
                            {
                                <button type="button" class="rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-rose-700 ring-1 ring-rose-100 hover:bg-rose-50" disabled="@isCurrentAssignmentVersionLocked" @onclick="RemoveVideo">Retirer la vidéo</button>
                            }
                        </div>

                        @if (form.VideoAssetId.HasValue)
                        {
                            <div class="mt-3 rounded-xl bg-white px-4 py-3 text-sm font-semibold text-cyan-900 ring-1 ring-cyan-100">
                                <Icon Name="video" Groesse="16" /> @form.VideoDisplayName
                                @if (form.VideoDuration.HasValue)
                                {
                                    <span class="text-cyan-600"> · @Math.Round(form.VideoDuration.Value.TotalMinutes) min</span>
                                }
                            </div>
                        }

                        <button type="button" class="mt-4 rounded-full bg-cyan-700 px-4 py-2 text-sm font-semibold text-white hover:bg-cyan-800 disabled:opacity-50" disabled="@isCurrentAssignmentVersionLocked" @onclick="() => videoLibraryOpen = true">Choisir ou ajouter une vidéo</button>

                        @if (ShowVideoUploadProgress)
                        {
                            <div class="mt-4 rounded-2xl bg-white p-3 ring-1 ring-cyan-100">
                                <div class="flex items-center justify-between gap-3 text-xs font-semibold text-cyan-900">
                                    <span>Téléversement en cours</span>
                                    <span>@VideoUploadProgressLabel</span>
                                </div>
                                <div class="mt-2 h-3 overflow-hidden rounded-full bg-cyan-100">
                                    <div class="h-full rounded-full bg-cyan-700 transition-all duration-300" style="@($"width:{VideoUploadPercent}%")"></div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="rounded-3xl border border-slate-200 bg-slate-50/60 p-4">
                        <div class="flex items-center justify-between gap-3">
                            <div>
                                <h3 class="text-sm font-black text-slate-900">Exercices de la leçon</h3>
                                <p class="mt-1 text-xs text-slate-500">Structure comme les examens : chaque exercice contient une ou plusieurs questions.</p>
                            </div>
                        </div>

                        <div class="mt-4 space-y-4">
                            @for (var exerciseIndex = 0; exerciseIndex < exerciseBlocks.Count; exerciseIndex++)
                            {
                                var exerciseBlock = exerciseBlocks[exerciseIndex];
                                var localExerciseIndex = exerciseIndex;

                                <article class="rounded-2xl bg-white p-4 ring-1 ring-slate-200">
                                    <div class="mb-3 flex items-center justify-between gap-3">
                                        <h4 class="text-sm font-bold text-slate-800">Exercice @(localExerciseIndex + 1)</h4>
                                        <button type="button" class="rounded-full bg-rose-100 px-3 py-1.5 text-xs font-semibold text-rose-700 transition hover:bg-rose-200 disabled:opacity-50" disabled="@isCurrentAssignmentVersionLocked" @onclick="() => RemoveLessonExercise(exerciseBlock)">Supprimer</button>
                                    </div>

                                    <div class="grid gap-3">
                                        <div>
                                            <label class="skoulou-label">Titre de l'exercice</label>
                                            <InputText @bind-Value="exerciseBlock.Title" class="skoulou-input" disabled="@isCurrentAssignmentVersionLocked" />
                                        </div>

                                        <div class="mt-1 space-y-4">
                                            @for (var questionIndex = 0; questionIndex < exerciseBlock.Questions.Count; questionIndex++)
                                            {
                                                var question = exerciseBlock.Questions[questionIndex];
                                                var localQuestionIndex = questionIndex;
                                                var isChoiceType = IsChoiceType(question.ExerciseType);
                                                var isSingleChoiceType = IsSingleChoiceType(question.ExerciseType);
                                                var isAudioType = IsAudioType(question.ExerciseType);
                                                var isManualCorrectionType = question.ExerciseType is "Text" or "SentenceBuilding" or "AudioText";

                                                <div class="rounded-2xl border border-slate-200 bg-white p-4">
                                                    <div class="mb-3 flex items-center justify-between gap-2">
                                                        <p class="text-xs font-semibold uppercase tracking-wide text-slate-600">Question @(localQuestionIndex + 1)</p>
                                                        @if (exerciseBlock.Questions.Count > 1)
                                                        {
                                                            <button type="button" class="rounded-full bg-rose-100 px-3 py-1.5 text-xs font-semibold text-rose-700 transition hover:bg-rose-200 disabled:opacity-50" disabled="@isCurrentAssignmentVersionLocked" @onclick="() => RemoveLessonQuestion(exerciseBlock, question)">Supprimer</button>
                                                        }
                                                    </div>

                                                    <div class="grid gap-3 xl:grid-cols-2">
                                                        <div>
                                                            <ModernDropdown TValue="string?" Label="Type" Value="question.ExerciseType" ValueChanged="value => SetLessonExerciseTypeAsync(question, value)" Options="LessonExerciseTypeOptions" Disabled="@isCurrentAssignmentVersionLocked" />
                                                        </div>
                                                        <div>
                                                            <label class="skoulou-label">Points</label>
                                                            <InputNumber @bind-Value="question.Points" class="skoulou-input" disabled="@isCurrentAssignmentVersionLocked" />
                                                        </div>
                                                    </div>

                                                    @if (isManualCorrectionType)
                                                    {
                                                        <p class="text-xs text-amber-700">Conseil : ce type de question passe en correction manuelle si « Réponses acceptées » reste vide.</p>
                                                    }

                                                    <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-3">
                                                        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-600">Consigne (optionnel)</p>
                                                        <RichTextEditor @bind-Value="question.Instructions"
                                                                        Placeholder="Ex. : Lis la question puis réponds."
                                                                        EnableLargeEditor="true"
                                                                        MinEditorHeightRem="4"
                                                                        ReadOnly="@isCurrentAssignmentVersionLocked" />
                                                    </div>

                                                    <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-3">
                                                        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-600">Question</p>
                                                        <RichTextEditor @bind-Value="question.Question"
                                                                        EnableImages="true"
                                                                        RequestImageLibrary="OpenImageLibrary"
                                                                        ImageLibraryTargetRequested="SetImageLibraryTarget"
                                                                        Placeholder="Énoncé de la question..."
                                                                        EnableLargeEditor="true"
                                                                        MinEditorHeightRem="7"
                                                                        ReadOnly="@isCurrentAssignmentVersionLocked" />
                                                    </div>

                                                    @if (isAudioType)
                                                    {
                                                        <div class="rounded-2xl border border-cyan-100 bg-cyan-50 p-3">
                                                            <div class="grid gap-3 xl:grid-cols-2">
                                                                <div>
                                                                    <label class="skoulou-label">Texte audio (TTS) (optionnel)</label>
                                                                    <InputTextArea @bind-Value="question.AudioText" class="skoulou-input min-h-20" placeholder="Ex. : Écoute puis réponds à la question." disabled="@isCurrentAssignmentVersionLocked" />
                                                                </div>
                                                                <div>
                                                                    <ModernDropdown TValue="string?" Label="Langue TTS (optionnel)" Value="question.TtsLanguage" ValueChanged="value => SetLessonExerciseTtsLanguageAsync(question, value)" Options="TtsLanguageOptions" Disabled="@isCurrentAssignmentVersionLocked" />
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }

                                                    @if (question.ExerciseType == "GapFill")
                                                    {
                                                        <div class="rounded-2xl border border-indigo-100 bg-indigo-50/70 p-3">
                                                            <div class="mb-2 flex items-center justify-between gap-2">
                                                                <p class="text-xs font-semibold uppercase tracking-wide text-indigo-700">Réponses par trou</p>
                                                                <button type="button" class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-indigo-700 ring-1 ring-indigo-200 transition hover:bg-indigo-100 disabled:opacity-50" disabled="@isCurrentAssignmentVersionLocked" @onclick="() => AddLessonGap(question)">+ Ajouter un trou</button>
                                                            </div>
                                                            <p class="mb-2 text-xs text-indigo-800">Conseil : dans l’énoncé de la question, utilise les marqueurs <strong>[[1]]</strong>, <strong>[[2]]</strong>, <strong>[[3]]</strong>… puis définis ici les réponses acceptées pour chaque trou (une variante par ligne). Exemple : « Je <strong>[[1]]</strong> à l'école et je <strong>[[2]]</strong> mes amis. » → Trou 1: vais, Trou 2: vois.</p>
                                                            @for (var gapIndex = 0; gapIndex < question.Gaps.Count; gapIndex++)
                                                            {
                                                                var gap = question.Gaps[gapIndex];
                                                                <div class="mb-2 rounded-xl bg-white p-3 ring-1 ring-indigo-100">
                                                                    <div class="mb-1 flex items-center justify-between">
                                                                        <span class="text-xs font-bold text-slate-700">Trou @(gapIndex + 1)</span>
                                                                        <button type="button" class="text-xs font-semibold text-rose-600 disabled:opacity-50" disabled="@isCurrentAssignmentVersionLocked" @onclick="() => RemoveLessonGap(question, gap)">Supprimer</button>
                                                                    </div>
                                                                    <RichTextEditor @bind-Value="gap.AcceptedAnswers"
                                                                                    Placeholder="Une variante par ligne"
                                                                                    EnableLargeEditor="true"
                                                                                    MinEditorHeightRem="4"
                                                                                    ReadOnly="@isCurrentAssignmentVersionLocked" />
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                    else if (!isChoiceType)
                                                    {
                                                        <div>
                                                            <label class="skoulou-label">Réponses acceptées (optionnel)</label>
                                                            <RichTextEditor @bind-Value="question.AcceptedAnswers"
                                                                            Placeholder="Une variante par ligne"
                                                                            EnableLargeEditor="true"
                                                                            MinEditorHeightRem="4"
                                                                            ReadOnly="@isCurrentAssignmentVersionLocked" />
                                                        </div>
                                                    }

                                                    @if (isChoiceType)
                                                    {
                                                        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-3">
                                                            <div class="mb-2">
                                                                <p class="text-xs font-semibold uppercase tracking-wide text-slate-600">Options</p>
                                                            </div>

                                                            @for (var optionIndex = 0; optionIndex < question.Options.Count; optionIndex++)
                                                            {
                                                                var option = question.Options[optionIndex];
                                                                <div class="mb-2 rounded-xl bg-white p-3 ring-1 ring-slate-200">
                                                                    <div class="grid gap-3 xl:grid-cols-[auto_1fr_auto] xl:items-center">
                                                                        @if (isSingleChoiceType)
                                                                        {
                                                                            <input type="radio" name="@($"lesson-ex-{localExerciseIndex}-q-{localQuestionIndex}-single")" checked="@option.IsCorrect" disabled="@isCurrentAssignmentVersionLocked" @onchange="() => SelectSingleCorrectLessonOption(question, option)" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <input type="checkbox" @bind="option.IsCorrect" disabled="@isCurrentAssignmentVersionLocked" />
                                                                        }
                                                                        <InputText @bind-Value="option.Text" class="skoulou-input" disabled="@isCurrentAssignmentVersionLocked" />
                                                                        <button type="button" class="rounded-full bg-rose-100 px-3 py-1 text-xs font-semibold text-rose-700 transition hover:bg-rose-200 disabled:opacity-50" disabled="@isCurrentAssignmentVersionLocked" @onclick="() => RemoveLessonExerciseOption(question, option)">Supprimer</button>
                                                                    </div>
                                                                </div>
                                                            }

                                                            <button type="button" class="mt-1 w-fit rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 ring-1 ring-slate-200 transition hover:bg-slate-100 disabled:opacity-50" disabled="@isCurrentAssignmentVersionLocked" @onclick="() => AddLessonExerciseOption(question)">+ Ajouter une option</button>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        <div class="pt-1">
                                            <button type="button" class="rounded-full bg-violet-100 px-4 py-2 text-xs font-semibold text-violet-800 transition hover:bg-violet-200 disabled:opacity-50" disabled="@isCurrentAssignmentVersionLocked" @onclick="() => AddLessonQuestion(exerciseBlock)">+ Ajouter une question</button>
                                        </div>
                                    </div>
                                </article>
                            }

                            <div class="pt-1">
                                <button type="button" class="rounded-full bg-slate-900 px-4 py-2 text-xs font-semibold text-white transition hover:bg-slate-800 disabled:opacity-50" disabled="@isCurrentAssignmentVersionLocked" @onclick="AddLessonExercise">+ Ajouter un exercice</button>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-wrap justify-end gap-3 border-t border-slate-100 bg-white px-4 py-3 sm:px-5">
                        <button type="button" class="rounded-full bg-slate-100 px-5 py-3 text-sm font-semibold text-slate-900 transition duration-200 hover:bg-slate-200" @onclick="CloseEditor">Annuler</button>
                        <AsyncActionButton Type="submit" Class="rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-lg" IsBusy="@isSaving" BusyLabel="Enregistrement..." Disabled="@(isCurrentAssignmentVersionLocked || !HasValidSelectedFach)">Enregistrer la leçon</AsyncActionButton>
                    </div>
                </EditForm>
                </div>
                </div>
            </div>
        }
    }

    <AzureBlobImageLibrary Open="imageLibraryOpen" OpenChanged="@(open => imageLibraryOpen = open)" RequiredSchoolId="selectedSchoolId" ImageSelected="InsertLibraryImageAsync" />
    <AzureBlobImageLibrary Open="videoLibraryOpen" OpenChanged="@(open => videoLibraryOpen = open)" VideoMode="true" ImageSelected="ChooseLibraryVideoAsync" />

    <ModalDialog @bind-Open="dueDateModalOpen"
                 Title="Modifier la date limite"
                 Eyebrow="Gestion de la session"
                 ErrorMessage="@errorMessage"
                 ScrollBody="false"
                 MaxWidthClass="max-w-xl">
        <div class="space-y-4">
            <p class="text-sm text-slate-600">Leçon: <span class="font-semibold text-slate-900">@dueDateLessonTitle</span></p>
            <TailwindDateTimePicker @bind-Value="dueDateModalValue" OpenUp="true" />
            <p class="text-xs text-slate-500">Si tu prolonges la date limite, tous les élèves pourront à nouveau modifier et envoyer leurs réponses jusqu'à la nouvelle date, même s'ils ont déjà répondu. Les anciennes réponses restent conservées.</p>
            <div class="flex justify-end gap-2">
                <button type="button" class="rounded-full bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-200" @onclick="() => dueDateModalOpen = false">Annuler</button>
                <AsyncActionButton Class="rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white" IsBusy="@isSaving" BusyLabel="Enregistrement..." OnClick="ConfirmDueDateAsync">Enregistrer</AsyncActionButton>
            </div>
        </div>
    </ModalDialog>

</section>