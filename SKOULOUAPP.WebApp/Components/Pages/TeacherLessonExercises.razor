@page "/teacher/lesson-exercises"
@attribute [Authorize(Policy = "RequireTeacher")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits HalloApp.WebApp.Components.CancelableComponentBase
@using HalloApp.Core.Models.Admin
@using HalloApp.WebApp.Components.Shared

@if (!Embedded)
{
    <PageTitle>Exercices des leçons</PageTitle>
}

<section class="grid gap-6 @(Embedded ? "teacher-create-embedded" : string.Empty)">
    @if (!Embedded)
    {
        <div class="hallo-hero rounded-[2rem] p-6 text-white shadow-2xl sm:p-8">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-100">Espace enseignant</p>
            <h1 class="mt-3 text-3xl font-black">Exercices des leçons</h1>
            <p class="mt-3 max-w-3xl text-sm leading-7 text-indigo-50">Gère les exercices de tes leçons avec la même structure que les examens.</p>
        </div>
    }

    @if (isLoading)
    {
        <div class="rounded-[2rem] bg-white p-8 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
            <div class="flex items-center gap-3 text-slate-600">
                <ProgressRing Size="1.5rem" Label="Chargement des leçons" />
                <p class="text-sm">Chargement...</p>
            </div>
        </div>
    }
    else
    {
        <Toast Message="@statusMessage" MessageChanged="v => statusMessage = v" Kind="Toast.ToastKind.Success" />
        <Toast Message="@errorMessage" MessageChanged="v => errorMessage = v" Kind="Toast.ToastKind.Error" />

        @if (!editorOpen)
        {
            <div class="flex justify-end">
                <button type="button" class="hallo-btn-accent inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold shadow-lg transition" @onclick="OpenCreateAsync">
                    + Nouvelle leçon + exercices
                </button>
            </div>

            <div class="rounded-3xl bg-white p-5 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
                <div class="mb-3 flex items-center justify-between gap-3">
                    <h2 class="text-lg font-black text-slate-900">Corrections manuelles en attente</h2>
                    <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-800">@pendingManualReviews.Count</span>
                </div>

                @if (pendingManualReviews.Count == 0)
                {
                    <p class="text-sm text-slate-500">Aucune réponse ouverte à corriger pour le moment (après date limite).</p>
                }
                else
                {
                    <div class="space-y-3">
                        @foreach (var review in pendingManualReviews)
                        {
                            <article class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">@review.LessonTitle · @review.ExerciseTitle</p>
                                <p class="mt-1 text-sm font-bold text-slate-900">@review.StudentName</p>
                                <p class="mt-2 text-sm text-slate-700">@review.Question</p>
                                <p class="mt-1 text-xs text-slate-500">Max points: @review.ExercisePoints</p>
                                <div class="mt-2 rounded-xl bg-white p-3 text-sm text-slate-700 ring-1 ring-slate-200">@review.SubmittedTextAnswer</div>
                                <div class="mt-3">
                                    <label class="hallo-label">Points attribués</label>
                                    <InputNumber @bind-Value="manualPointsByAttempt[review.AttemptId]" class="hallo-input" />
                                </div>
                                <div class="mt-3">
                                    <label class="hallo-label">Feedback (optionnel)</label>
                                    <InputTextArea @bind-Value="manualFeedbackByAttempt[review.AttemptId]" class="hallo-input min-h-16" />
                                </div>
                                <div class="mt-3 flex flex-wrap gap-2">
                                    <button type="button" class="rounded-full bg-slate-900 px-4 py-2 text-xs font-semibold text-white transition hover:bg-slate-800 disabled:opacity-50" disabled="@isSavingManualReview" @onclick="() => GradeManualAsync(review.AttemptId)">Enregistrer la note</button>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>

            @if (lessons.Count == 0)
            {
                <div class="rounded-3xl bg-white p-6 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
                    <p class="text-sm text-slate-600">Aucune leçon attribuée à tes classes.</p>
                </div>
            }
            else
            {
                <div class="grid gap-4">
                    @foreach (var lesson in lessons)
                    {
                        <article class="rounded-3xl bg-white p-5 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
                            <div class="flex flex-wrap items-start justify-between gap-4">
                                <div>
                                    <div class="flex items-center gap-2">
                                        <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-bold text-indigo-700">@lesson.CourseCode</span>
                                        @if (!string.IsNullOrWhiteSpace(lesson.FachName))
                                        {
                                            <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">@lesson.FachName</span>
                                        }
                                        <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600">@lesson.ExerciseCount exercice(s)</span>
                                    </div>
                                    <h2 class="mt-2 text-lg font-bold text-slate-900">@lesson.Title</h2>
                                    <p class="mt-1 text-sm text-slate-500">@lesson.Summary</p>
                                </div>
                                <button type="button" class="rounded-full bg-slate-900 px-4 py-2 text-xs font-semibold text-white transition hover:bg-slate-800" @onclick="() => OpenEditorAsync(lesson.LessonId)">Modifier les exercices</button>
                            </div>
                        </article>
                    }
                </div>
            }
        }
        else if (form is not null)
        {
            <div class="hallo-modal-surface mx-auto w-full max-w-5xl max-h-[calc(100dvh-4.5rem)] rounded-3xl bg-white shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 sm:max-h-[calc(100dvh-6rem)]">
                <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-4 py-3 sm:px-5">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">@selectedLessonCode</p>
                        <h2 class="text-lg font-black text-slate-900">@(string.IsNullOrWhiteSpace(form.Title) ? "Nouvelle leçon" : form.Title)</h2>
                    </div>
                    <button type="button" class="rounded-full bg-slate-100 px-4 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-200" @onclick="CloseEditor">Retour</button>
                </div>

                <div class="hallo-modal-scroll px-4 py-4 sm:px-5">

                @if (form.LessonId.HasValue)
                {
                    <div class="mb-4 rounded-2xl border border-indigo-100 bg-indigo-50/50 p-4 text-sm text-indigo-900">
                        <p class="font-semibold">Session d'attribution actuelle : v@form.AssignmentVersion</p>
                        @if (isCurrentAssignmentVersionLocked)
                        {
                            <p class="mt-1">Cette session est verrouillée: des élèves ont déjà soumis et la date limite n'est pas encore atteinte. Après la date limite, tes modifications ouvriront automatiquement une nouvelle session.</p>
                        }
                        else if (form.HasSubmissionsInCurrentAssignmentVersion)
                        {
                            <p class="mt-1">Des soumissions existent pour cette session. La prochaine modification enregistrée ouvrira une nouvelle session (v@(form.AssignmentVersion + 1)).</p>
                        }
                    </div>
                }

                <EditForm Model="form" OnValidSubmit="SaveAsync" FormName="teacher-lesson-exercise-form" class="grid gap-4">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="grid gap-4 rounded-2xl border border-slate-200 bg-slate-50 p-4 xl:grid-cols-2">
                        <div>
                            <label class="hallo-label">Titre de la leçon</label>
                            <InputText @bind-Value="form.Title" class="hallo-input" disabled="@isCurrentAssignmentVersionLocked" />
                        </div>
                        <div>
                            <ModernDropdown TValue="Guid?" Label="Niveau" Value="form.CourseId" ValueChanged="SetLessonCourseAsync" Options="CourseOptions" Disabled="@isCurrentAssignmentVersionLocked" />
                        </div>
                        <div class="xl:col-span-2 rounded-2xl border border-indigo-100 bg-indigo-50/40 p-3">
                            <div class="grid gap-3 xl:grid-cols-[1fr_auto] xl:items-end">
                                <ModernDropdown TValue="Guid?" Label="Matière" Value="form.FachId" ValueChanged="SetLessonFachAsync" Options="FachOptions" Disabled="@isCurrentAssignmentVersionLocked" />
                                <div class="grid gap-2 sm:grid-cols-[1fr_auto]">
                                    <InputText @bind-Value="newFachName" class="hallo-input" placeholder="Nouvelle matière" disabled="@isCurrentAssignmentVersionLocked" />
                                    <AsyncActionButton Class="rounded-full bg-indigo-700 px-4 py-2 text-xs font-semibold text-white" Disabled="@IsAddFachDisabled" IsBusy="@isAddingFach" BusyLabel="Ajout..." OnClick="AddFachAsync">Ajouter</AsyncActionButton>
                                </div>
                            </div>
                        </div>
                        <div class="xl:col-span-2">
                            <label class="hallo-label">Résumé</label>
                            <InputTextArea @bind-Value="form.Summary" class="hallo-input min-h-16" disabled="@isCurrentAssignmentVersionLocked" />
                        </div>
                        <div class="xl:col-span-2">
                            <label class="hallo-label">Contenu de la leçon</label>
                            <RichTextEditor @bind-Value="form.Content" Placeholder="Rédige le contenu de la leçon..." MinEditorHeightRem="28" ReadOnly="@isCurrentAssignmentVersionLocked" />
                        </div>
                        <div>
                            <label class="hallo-label">Ordre</label>
                            <InputNumber @bind-Value="form.Order" class="hallo-input" disabled="@isCurrentAssignmentVersionLocked" />
                        </div>
                        <label class="flex items-center gap-2">
                            <input type="checkbox" class="h-4 w-4 rounded border-slate-300" @bind="form.IsPublished" disabled="@isCurrentAssignmentVersionLocked" />
                            <span class="text-sm font-semibold text-slate-700">Publier la leçon et ses exercices</span>
                        </label>
                        <div>
                            <label class="hallo-label">Date limite des réponses ouvertes (optionnel)</label>
                            <TailwindDateTimePicker @bind-Value="form.ExerciseSubmissionDueAtUtc" IsDisabled="@isCurrentAssignmentVersionLocked" />
                        </div>
                    </div>

                    <div class="rounded-3xl border border-slate-200 bg-slate-50/60 p-4">
                        <div class="flex items-center justify-between gap-3">
                            <div>
                                <h3 class="text-sm font-black text-slate-900">Exercices de la leçon</h3>
                                <p class="mt-1 text-xs text-slate-500">Même structure que les examens, mais rattachée à cette leçon.</p>
                            </div>
                            <button type="button" class="rounded-full bg-slate-900 px-4 py-2 text-xs font-semibold text-white transition hover:bg-slate-800 disabled:opacity-50" disabled="@isCurrentAssignmentVersionLocked" @onclick="AddLessonExercise">+ Ajouter un exercice</button>
                        </div>

                        <div class="mt-4 space-y-4">
                            @for (var exerciseIndex = 0; exerciseIndex < form.Exercises.Count; exerciseIndex++)
                            {
                                var exercise = form.Exercises[exerciseIndex];
                                var localExerciseIndex = exerciseIndex;
                                var isChoiceType = IsChoiceType(exercise.ExerciseType);
                                var isSingleChoiceType = IsSingleChoiceType(exercise.ExerciseType);
                                var isAudioType = IsAudioType(exercise.ExerciseType);

                                <article class="rounded-2xl bg-white p-4 ring-1 ring-slate-200">
                                    <div class="mb-3 flex items-center justify-between gap-3">
                                        <h4 class="text-sm font-bold text-slate-800">Exercice @(localExerciseIndex + 1)</h4>
                                        <button type="button" class="rounded-full bg-rose-100 px-3 py-1.5 text-xs font-semibold text-rose-700 transition hover:bg-rose-200 disabled:opacity-50" disabled="@isCurrentAssignmentVersionLocked" @onclick="() => RemoveLessonExercise(exercise)">Supprimer</button>
                                    </div>

                                    <div class="grid gap-3">
                                        <div class="grid gap-3 xl:grid-cols-2">
                                            <div>
                                                <label class="hallo-label">Titre de l'exercice</label>
                                                <InputText @bind-Value="exercise.Title" class="hallo-input" disabled="@isCurrentAssignmentVersionLocked" />
                                            </div>
                                            <div>
                                                <ModernDropdown TValue="string?" Label="Type d'exercice" Value="exercise.ExerciseType" ValueChanged="value => SetLessonExerciseTypeAsync(exercise, value)" Options="LessonExerciseTypeOptions" Disabled="@isCurrentAssignmentVersionLocked" />
                                            </div>
                                        </div>

                                        <div>
                                            <label class="hallo-label">Consigne (optionnel)</label>
                                            <InputTextArea @bind-Value="exercise.Instructions" class="hallo-input min-h-20" disabled="@isCurrentAssignmentVersionLocked" />
                                        </div>

                                        <div>
                                            <label class="hallo-label">Question</label>
                                            <InputTextArea @bind-Value="exercise.Question" class="hallo-input min-h-20" disabled="@isCurrentAssignmentVersionLocked" />
                                        </div>

                                        <div>
                                            <label class="hallo-label">Points</label>
                                            <InputNumber @bind-Value="exercise.Points" class="hallo-input" disabled="@isCurrentAssignmentVersionLocked" />
                                        </div>

                                        @if (isAudioType)
                                        {
                                            <div class="rounded-2xl border border-cyan-100 bg-cyan-50 p-3">
                                                <div class="grid gap-3 xl:grid-cols-2">
                                                    <div>
                                                        <label class="hallo-label">Texte audio (TTS)</label>
                                                        <InputTextArea @bind-Value="exercise.AudioText" class="hallo-input min-h-20" disabled="@isCurrentAssignmentVersionLocked" />
                                                    </div>
                                                    <div>
                                                        <ModernDropdown TValue="string?" Label="Langue TTS" Value="exercise.TtsLanguage" ValueChanged="value => SetLessonExerciseTtsLanguageAsync(exercise, value)" Options="TtsLanguageOptions" Disabled="@isCurrentAssignmentVersionLocked" />
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        @if (exercise.ExerciseType == "GapFill")
                                        {
                                            <div class="rounded-2xl border border-indigo-100 bg-indigo-50/70 p-3">
                                                <div class="mb-2 flex items-center justify-between gap-2">
                                                    <p class="text-xs font-semibold uppercase tracking-wide text-indigo-700">Réponses par trou</p>
                                                    <button type="button" class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-indigo-700 ring-1 ring-indigo-200 transition hover:bg-indigo-100 disabled:opacity-50" disabled="@isCurrentAssignmentVersionLocked" @onclick="() => AddLessonGap(exercise)">+ Ajouter un trou</button>
                                                </div>
                                                @for (var gapIndex = 0; gapIndex < exercise.Gaps.Count; gapIndex++)
                                                {
                                                    var gap = exercise.Gaps[gapIndex];
                                                    <div class="mb-2 rounded-xl bg-white p-3 ring-1 ring-indigo-100">
                                                        <div class="mb-1 flex items-center justify-between">
                                                            <span class="text-xs font-bold text-slate-700">Trou @(gapIndex + 1)</span>
                                                            <button type="button" class="text-xs font-semibold text-rose-600 disabled:opacity-50" disabled="@isCurrentAssignmentVersionLocked" @onclick="() => RemoveLessonGap(exercise, gap)">Supprimer</button>
                                                        </div>
                                                        <InputTextArea @bind-Value="gap.AcceptedAnswers" class="hallo-input min-h-16" placeholder="Une variante par ligne" disabled="@isCurrentAssignmentVersionLocked" />
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else if (!isChoiceType)
                                        {
                                            <div>
                                                <label class="hallo-label">Réponses acceptées (optionnel)</label>
                                                <InputTextArea @bind-Value="exercise.AcceptedAnswers" class="hallo-input min-h-16" placeholder="Une variante par ligne" disabled="@isCurrentAssignmentVersionLocked" />
                                            </div>
                                        }

                                        @if (isChoiceType)
                                        {
                                            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-3">
                                                <div class="mb-2 flex items-center justify-between gap-2">
                                                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-600">Options</p>
                                                    <button type="button" class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-slate-700 ring-1 ring-slate-200 transition hover:bg-slate-100 disabled:opacity-50" disabled="@isCurrentAssignmentVersionLocked" @onclick="() => AddLessonExerciseOption(exercise)">+ Ajouter une option</button>
                                                </div>

                                                @for (var optionIndex = 0; optionIndex < exercise.Options.Count; optionIndex++)
                                                {
                                                    var option = exercise.Options[optionIndex];
                                                    <div class="mb-2 rounded-xl bg-white p-3 ring-1 ring-slate-200">
                                                        <div class="grid gap-3 xl:grid-cols-[auto_1fr_auto] xl:items-center">
                                                            @if (isSingleChoiceType)
                                                            {
                                                                <input type="radio" name="@($"lesson-ex-{localExerciseIndex}-single")" checked="@option.IsCorrect" disabled="@isCurrentAssignmentVersionLocked" @onchange="() => SelectSingleCorrectLessonOption(exercise, option)" />
                                                            }
                                                            else
                                                            {
                                                                <input type="checkbox" @bind="option.IsCorrect" disabled="@isCurrentAssignmentVersionLocked" />
                                                            }
                                                            <InputText @bind-Value="option.Text" class="hallo-input" disabled="@isCurrentAssignmentVersionLocked" />
                                                            <button type="button" class="rounded-full bg-rose-100 px-3 py-1 text-xs font-semibold text-rose-700 transition hover:bg-rose-200 disabled:opacity-50" disabled="@isCurrentAssignmentVersionLocked" @onclick="() => RemoveLessonExerciseOption(exercise, option)">Supprimer</button>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    </div>

                </EditForm>
                </div>

                <div class="flex flex-wrap justify-end gap-3 border-t border-slate-100 bg-white px-4 py-3 sm:px-5">
                    <button type="button" class="rounded-full bg-slate-100 px-5 py-3 text-sm font-semibold text-slate-900 transition duration-200 hover:bg-slate-200" @onclick="CloseEditor">Annuler</button>
                    <AsyncActionButton Type="submit" Form="teacher-lesson-exercise-form" Class="rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-lg" IsBusy="@isSaving" BusyLabel="Enregistrement..." Disabled="@isCurrentAssignmentVersionLocked">Enregistrer les exercices</AsyncActionButton>
                </div>
            </div>
        }
    }
</section>