@page "/contact"
@attribute [AllowAnonymous]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Contact</PageTitle>

<div class="mx-auto grid w-full max-w-2xl gap-5">
<SeitenKopf Rubrik="Contact" Titel="Écrivez-nous" IconName="mail" Untertitel="Une question, une remarque ou besoin d'aide ? Remplissez le formulaire et nous vous répondrons par e-mail." />
<section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
    <div class="flex items-start gap-3 rounded-xl border border-blue-100 bg-blue-50 px-4 py-3 text-sm text-blue-900">
        <span class="mt-0.5 shrink-0"><Icon Name="info" Groesse="18" /></span>
        <p class="leading-6">
            <span class="font-semibold">Bon à savoir :</span> ce message est envoyé à l'équipe de support de SKOULOU,
            et non à votre école. Pour toute question concernant les cours, les inscriptions ou les paiements,
            adressez-vous directement à votre école.
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="mt-6 rounded-2xl @(succeeded ? "bg-emerald-50 text-emerald-800" : "bg-rose-50 text-rose-800") px-4 py-3 text-sm">@message</div>
    }

    <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync" FormName="contact-form" class="mt-8 grid gap-5 min-w-0">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="grid gap-5 sm:grid-cols-2">
            <div>
                <label class="skoulou-label">Votre nom</label>
                <InputText @bind-Value="Model.Name" class="skoulou-input" />
            </div>
            <div>
                <label class="skoulou-label">Votre e-mail</label>
                <InputText @bind-Value="Model.Email" type="email" class="skoulou-input" />
            </div>
        </div>

        <div>
            <label class="skoulou-label">Sujet</label>
            <InputText @bind-Value="Model.Subject" class="skoulou-input" />
        </div>

        <div>
            <label class="skoulou-label">Message</label>
            <RichTextEditor @bind-Value="Model.Message"
                            Placeholder="Écrivez votre message..."
                            EnableImages="false" />
        </div>

        <AsyncActionButton Type="submit" Class="sk-btn sk-btn-primary" IsBusy="@isSubmitting" BusyLabel="Envoi...">Envoyer le message</AsyncActionButton>
    </EditForm>
</section>
</div>
