@page "/provisionen"
@attribute [Authorize(Roles = "SuperAdmin,SchulLeiter,Koordinator,Lehrer,ProduktOwner")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits SkoulouApp.WebApp.Components.CancelableComponentBase
@using SkoulouApp.Core.Models.Billing
@using SkoulouApp.Core.Models.Dashboard
@using SkoulouApp.WebApp.Components.Shared

<PageTitle>Commissions</PageTitle>

<section class="grid gap-6">
    <div class="skoulou-hero relative overflow-hidden rounded-[1.25rem] px-5 py-4 text-white shadow-2xl sm:px-6 sm:py-5">
        <div class="pointer-events-none absolute -top-20 -right-16 h-56 w-56 rounded-full bg-violet-400/25 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-16 -left-10 h-48 w-48 rounded-full bg-indigo-400/20 blur-3xl"></div>
        <div class="relative">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-violet-200">
                @(isProduktOwner ? "Responsable produit" : isSuperAdmin ? "Administrateur" : isManager ? "Directeur" : "Enseignant")
            </p>
            <h1 class="mt-3 text-3xl font-black">@(isProduktOwner ? "Mes parts d'abonnement" : "Commissions")</h1>
            <p class="mt-4 max-w-3xl text-sm leading-7 text-slate-300">
                @(isProduktOwner
                    ? "Consultez uniquement votre part de responsable produit pour les écoles qui vous sont attribuées."
                    : isLehrerView
                    ? "Consultez le fonds enseignants global de votre école après chaque facturation clôturée. La répartition individuelle est gérée par l'école."
                    : isSuperAdmin
                    ? "Consultez toutes les parts SKOULOU : direction, enseignants, responsables produit et opérateur."
                    : "Consultez la part école ainsi que le fonds enseignants de votre école.")
            </p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="flex items-center gap-3 rounded-2xl bg-white px-5 py-4 text-sm font-semibold text-slate-500 ring-1 ring-slate-100">
            <ProgressRing Size="1.25rem" Label="Chargement des commissions" />
            <span>Chargement&#8230;</span>
        </div>
    }
    else if (isProduktOwner)
    {
        @if (produktOwnerUebersichten.Count == 0)
        {
            <div class="rounded-[2rem] bg-slate-50 px-6 py-5 text-slate-700 ring-1 ring-slate-100">
                <h2 class="text-lg font-black text-slate-900">Aucune commission disponible</h2>
                <p class="mt-2 text-sm leading-6">Les commissions des écoles qui vous sont attribuées apparaîtront après la clôture de leur facturation.</p>
            </div>
        }
        else
        {
            <div class="rounded-[2rem] bg-white p-6 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
                <p class="text-xs font-bold uppercase tracking-[0.16em] text-violet-600">Mes parts d'abonnement</p>
                <div class="mt-2 text-3xl font-black text-slate-900">@produktOwnerUebersichten.Sum(u => u.ProvisionProductOwner).ToString("N0") FCFA</div>
                <p class="mt-1 text-sm text-slate-500">Somme de vos commissions sur les écoles qui vous sont attribuées. Le chiffre d'affaires de SKOULOU n'est pas affiché.</p>
            </div>
            <div class="grid gap-4">
                @foreach (var u in produktOwnerUebersichten)
                {
                    <div class="rounded-[2rem] bg-white p-6 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
                        <div class="flex flex-wrap items-center justify-between gap-3">
                            <div>
                                <div class="font-black text-slate-900">@u.SchulName</div>
                                <div class="text-sm font-semibold text-slate-500">Du @u.VonUtc.ToLocalTime().ToString("dd.MM.yyyy") au @u.BisUtc.ToLocalTime().ToString("dd.MM.yyyy")</div>
                            </div>
                            <div class="skoulou-hero-badge rounded-3xl bg-gradient-to-br from-violet-500 to-indigo-700 px-5 py-3 text-right text-white shadow-lg shadow-indigo-200/60">
                                <div class="text-2xl font-black">@u.ProvisionProductOwner.ToString("N0") FCFA</div>
                                <div class="text-xs text-indigo-50">Ma part d'abonnement · @u.AnzahlPositionen abo(s)</div>
                            </div>
                        </div>
                        <div class="mt-4 rounded-2xl bg-violet-50 px-4 py-3 text-sm font-semibold text-violet-800 ring-1 ring-violet-100">
                            Cette vue affiche uniquement votre part liée aux abonnements de cette école.
                        </div>
                    </div>
                }
            </div>
        }
    }
    else if (isLehrerView)
    {
        @if (lehrerUebersichten.Count == 0)
        {
            <div class="rounded-[2rem] bg-slate-50 px-6 py-5 text-slate-700 ring-1 ring-slate-100">
                <h2 class="text-lg font-black text-slate-900">Aucune commission disponible</h2>
                <p class="mt-2 text-sm leading-6">Le fonds enseignants apparaîtra après la clôture d'une facturation de votre école.</p>
            </div>
        }
        else
        {
            <div class="grid gap-4">
                @foreach (var u in lehrerUebersichten)
                {
                    <div class="rounded-[2rem] bg-white p-6 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
                        <div class="flex flex-wrap items-center justify-between gap-3">
                            <div>
                                <div class="font-black text-slate-900">@u.SchulName</div>
                                <div class="text-sm font-semibold text-slate-500">
                                    Du @u.VonUtc.ToLocalTime().ToString("dd.MM.yyyy") au @u.BisUtc.ToLocalTime().ToString("dd.MM.yyyy")
                                </div>
                            </div>
                            <div class="skoulou-hero-badge rounded-3xl bg-gradient-to-br from-indigo-500 to-violet-700 px-5 py-3 text-right text-white shadow-lg shadow-indigo-200/60">
                                <div class="text-2xl font-black">@u.ProvisionLehrer.ToString("N0") FCFA</div>
                                <div class="text-xs text-indigo-50">Fonds enseignants · @u.AnzahlPositionen abo(s)</div>
                            </div>
                        </div>
                        <div class="mt-4 rounded-2xl bg-indigo-50 px-4 py-3 text-sm font-semibold text-indigo-800 ring-1 ring-indigo-100">
                            Ce montant est le fonds enseignants global de l'école. La répartition individuelle est gérée par la direction.
                        </div>
                    </div>
                }
            </div>
        }
    }
    else if (isManager)
    {
        @if (schools.Count == 0)
        {
            <div class="rounded-[2rem] bg-slate-50 px-6 py-5 text-slate-700 ring-1 ring-slate-100">
                <h2 class="text-lg font-black text-slate-900">Aucune école disponible</h2>
                <p class="mt-2 text-sm leading-6">Les commissions apparaîtront ici dès qu'une école sera créée et attribuée.</p>
            </div>
        }
        else
        {
        <div class="flex flex-wrap gap-2 rounded-2xl bg-white p-2 shadow ring-1 ring-slate-100">
            <button type="button" class="rounded-full px-4 py-2 text-sm font-semibold @(activeManagerTab == "open" ? "skoulou-btn-accent" : "bg-slate-100 text-slate-700")" @onclick='() => SetManagerTabAsync("open")'>Commissions ouvertes</button>
            <button type="button" class="rounded-full px-4 py-2 text-sm font-semibold @(activeManagerTab == "history" ? "skoulou-btn-accent" : "bg-slate-100 text-slate-700")" @onclick='() => SetManagerTabAsync("history")'>Historique</button>
        </div>

        <div class="rounded-[2rem] bg-white p-6 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 sm:p-8" style="@(schools.Count <= 1 ? "display:none" : null)">
            <h2 class="text-xl font-black text-slate-900">Écoles</h2>
            <div class="mt-4 grid gap-3">
                @foreach (var school in schools)
                {
                    <button type="button"
                            class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-100 px-4 py-3 text-left transition duration-200 hover:-translate-y-0.5 hover:border-indigo-200 hover:bg-indigo-50/50 hover:shadow-md @(selectedSchoolId == school.SchoolId ? "ring-2 ring-indigo-500" : string.Empty)"
                            @onclick="() => SelectSchoolAsync(school.SchoolId)">
                        <div>
                            <div class="font-bold text-slate-900">@school.Name</div>
                            <div class="text-sm text-slate-500">@school.City · @school.Country</div>
                        </div>
                        <span class="text-sm font-semibold text-slate-600">@school.StudentCount élèves</span>
                    </button>
                }
            </div>
        </div>

        @if (offeneUebersicht is not null)
        {
            @if (activeManagerTab == "open")
            {
            <div class="rounded-[2rem] bg-white p-6 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 sm:p-8">
                <h2 class="text-xl font-black text-slate-900">Commissions ouvertes · @offeneUebersicht.SchulName</h2>
                <p class="mt-1 text-sm font-semibold text-slate-600">
                    @offeneUebersicht.AnzahlPositionen abo(s) payé(s), non encore facturé(s)
                    · @offeneUebersicht.AnzahlPositionen SKOULOU
                </p>

                <div class="mt-4 grid gap-4 @(isSuperAdmin ? "sm:grid-cols-4" : "sm:grid-cols-2")">
                    <ProvisionKarte Titel="Part école" Betrag="@offeneUebersicht.ProvisionSchulleiter" Farbe="from-emerald-500 to-teal-700" />
                    <ProvisionKarte Titel="Fonds enseignants" Betrag="@offeneUebersicht.ProvisionLehrer" Farbe="from-indigo-500 to-violet-700" />
                    @if (isSuperAdmin)
                    {
                        <ProvisionKarte Titel="Part du responsable produit" Betrag="@offeneUebersicht.ProvisionProductOwner" Farbe="from-violet-500 to-purple-700" />
                        <ProvisionKarte Titel="Part opérateur" Betrag="@offeneUebersicht.ProvisionAdmin" Farbe="from-cyan-500 to-blue-700" />
                    }
                </div>

                <div class="mt-4 rounded-2xl bg-slate-50 px-4 py-3 text-right text-sm font-semibold text-slate-700 ring-1 ring-slate-100">
                    Total affiché : @GetVisibleTotal(offeneUebersicht).ToString("N0") FCFA
                </div>
            </div>
            }

            @if (activeManagerTab == "history")
            {
                <div class="rounded-[2rem] bg-white p-6 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 sm:p-8">
                    <h2 class="text-xl font-black text-slate-900">Commissions par période clôturée</h2>
                    <p class="mt-1 text-sm text-slate-600">@(periodenUebersichten.Count > 0 ? $"{periodenUebersichten.Count} période(s) clôturée(s)" : "Aucune période clôturée")</p>
                    @if (periodenUebersichten.Count == 0)
                    {
                        <p class="mt-3 text-sm text-slate-500">Aucune facturation clôturée pour cette école.</p>
                    }
                    else
                    {
                        <div class="mt-4 grid gap-4">
                            @foreach (var u in periodenUebersichten)
                            {
                                <div class="rounded-2xl border border-slate-100 p-4">
                                    <div class="flex flex-wrap items-center justify-between gap-2">
                                        <div class="font-bold text-slate-900">
                                            Du @u.VonUtc.ToLocalTime().ToString("dd.MM.yyyy") au @u.BisUtc.ToLocalTime().ToString("dd.MM.yyyy")
                                        </div>
                                        <div class="text-sm font-semibold text-slate-600">
                                            @u.AnzahlPositionen SKOULOU · Total affiché : @GetVisibleTotal(u).ToString("N0") FCFA
                                        </div>
                                    </div>
                                    <div class="mt-3 grid gap-3 @(isSuperAdmin ? "sm:grid-cols-4" : "sm:grid-cols-2")">
                                        <ProvisionKarte Titel="Part école" Betrag="@u.ProvisionSchulleiter" Farbe="from-emerald-500 to-teal-700" />
                                        <ProvisionKarte Titel="Fonds enseignants" Betrag="@u.ProvisionLehrer" Farbe="from-indigo-500 to-violet-700" />
                                        @if (isSuperAdmin)
                                        {
                                            <ProvisionKarte Titel="Part du responsable produit" Betrag="@u.ProvisionProductOwner" Farbe="from-violet-500 to-purple-700" />
                                            <ProvisionKarte Titel="Part opérateur" Betrag="@u.ProvisionAdmin" Farbe="from-cyan-500 to-blue-700" />
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
        }
    }
</section>
