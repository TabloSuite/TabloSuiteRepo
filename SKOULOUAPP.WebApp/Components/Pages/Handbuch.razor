@page "/handbuch"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SkoulouApp.Core.DataModels.Identity

<PageTitle>Guide utilisateur</PageTitle>

<section class="grid gap-6">
    <div class="skoulou-hero relative overflow-hidden rounded-[2rem] p-6 text-white shadow-2xl sm:p-8">
        <div class="pointer-events-none absolute -right-14 -top-16 h-48 w-48 rounded-full bg-cyan-400/25 blur-3xl"></div>
        <div class="relative">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-cyan-200">Guide utilisateur</p>
            <h1 class="mt-3 text-3xl font-black">Utiliser SKOULOUAPP avec confiance</h1>
            <p class="mt-4 max-w-3xl text-sm leading-7 text-slate-200">Retrouve les étapes importantes pour ton rôle. Les onglets affichés correspondent uniquement aux espaces auxquels ton compte a accès.</p>
        </div>
    </div>

    <div class="overflow-x-auto rounded-2xl bg-white p-2 shadow ring-1 ring-slate-100">
        <nav class="flex min-w-max gap-2" aria-label="Chapitres du guide">
            @foreach (var tab in VisibleTabs)
            {
                <button type="button"
                        class="rounded-xl px-4 py-3 text-sm font-bold transition @(activeTab == tab.Id ? "bg-slate-900 text-white shadow" : "text-slate-600 hover:bg-slate-100")"
                        @onclick="() => activeTab = tab.Id">
                    <span class="mr-2">@tab.Icon</span>@tab.Title
                </button>
            }
        </nav>
    </div>

    @if (activeTab == "start")
    {
        <section class="grid gap-5 lg:grid-cols-[1.15fr_0.85fr]">
            <div class="rounded-[2rem] bg-white p-6 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 sm:p-8">
                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-emerald-700">À faire en premier</p>
                <h2 class="mt-2 text-2xl font-black text-slate-900">Les essentiels pour @RoleLabel</h2>
                <ol class="mt-6 space-y-4">
                    @foreach (var step in StartSteps)
                    {
                        <li class="flex gap-4 rounded-2xl bg-slate-50 p-4">
                            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-emerald-600 text-sm font-black text-white">@step.Number</span>
                            <div><p class="font-bold text-slate-900">@step.Title</p><p class="mt-1 text-sm leading-6 text-slate-600">@step.Description</p></div>
                        </li>
                    }
                </ol>
            </div>
            <div class="rounded-[2rem] border border-cyan-100 bg-cyan-50 p-6 sm:p-8">
                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-cyan-700">Vue de l'application</p>
                <h2 class="mt-2 text-2xl font-black text-slate-900">Repère les espaces</h2>
                <div class="mt-6 rounded-2xl bg-slate-950 p-4 shadow-xl">
                    <div class="flex items-center gap-2 border-b border-white/10 pb-3 text-xs font-bold text-cyan-200"><span class="h-2 w-2 rounded-full bg-emerald-400"></span> SKOULOUAPP Campus</div>
                    <div class="mt-4 grid grid-cols-[0.7fr_1.3fr] gap-3 text-xs">
                        <div class="space-y-2 rounded-xl bg-slate-800 p-3 text-slate-300"><div class="rounded-lg bg-cyan-600 px-2 py-2 text-white">Accueil</div><div class="px-2 py-1">Mon espace</div><div class="px-2 py-1">Guide utilisateur</div></div>
                        <div class="rounded-xl bg-white p-3 text-slate-800"><p class="font-black">Ton espace de travail</p><div class="mt-3 h-2 rounded bg-slate-200"></div><div class="mt-2 h-2 w-4/5 rounded bg-slate-100"></div><div class="mt-4 grid grid-cols-2 gap-2"><div class="h-12 rounded bg-emerald-100"></div><div class="h-12 rounded bg-cyan-100"></div></div></div>
                    </div>
                </div>
                <p class="mt-4 text-sm leading-6 text-slate-700">Utilise le menu à gauche pour changer d'espace. Ton menu n'affiche que les fonctions autorisées pour ton rôle.</p>
            </div>
        </section>
    }
    else if (ActivePanel is not null)
    {
        <GuidePanel Panel="ActivePanel" />
    }
</section>
