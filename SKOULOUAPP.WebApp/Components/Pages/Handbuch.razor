@page "/handbuch"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SkoulouApp.Core.DataModels.Identity

<PageTitle>Guide utilisateur</PageTitle>

<section class="grid gap-6">
    <div class="skoulou-hero relative overflow-hidden rounded-[1.25rem] px-4 py-3 text-white shadow-xl sm:px-5">
        <div class="pointer-events-none absolute -right-14 -top-16 h-48 w-48 rounded-full bg-cyan-400/25 blur-3xl"></div>
        <div class="relative">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-cyan-200">Guide utilisateur</p>
            <h1 class="text-xl font-black">Utiliser SKOULOUAPP avec confiance</h1>
            Choisis un chapitre : chacun explique pas à pas ce que tu peux faire et les points d'attention.
        </div>
    </div>

    <div class="director-sticky-band handbuch-tabs overflow-x-auto rounded-2xl p-2">
        <nav class="flex min-w-max gap-2" aria-label="Chapitres du guide">
            @foreach (var tab in VisibleTabs)
            {
                <button type="button"
                        class="rounded-xl px-4 py-3 text-sm font-bold transition @(activeTab == tab.Id ? "skoulou-btn-accent shadow" : "text-slate-600 hover:bg-slate-100")"
                        @onclick="() => activeTab = tab.Id">
                    <span class="mr-2">@tab.Icon</span>@tab.Title
                </button>
            }
        </nav>
    </div>

    @if (activeTab == "start")
    {
        <section class="grid gap-5 lg:grid-cols-[1.15fr_0.85fr]">
            <div class="rounded-[2rem] bg-white p-6 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 sm:p-8">
                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-emerald-700">À faire en premier</p>
                <h2 class="mt-2 text-2xl font-black text-slate-900">Les essentiels pour @RoleLabel</h2>
                <ol class="mt-6 space-y-4">
                    @foreach (var step in StartSteps)
                    {
                        <li class="flex gap-4 rounded-2xl bg-slate-50 p-4">
                            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-emerald-600 text-sm font-black text-white">@step.Number</span>
                            <div><p class="font-bold text-slate-900">@step.Title</p><p class="mt-1 text-sm leading-6 text-slate-600">@step.Description</p></div>
                        </li>
                    }
                </ol>
            </div>
            <div class="rounded-[2rem] border border-cyan-100 bg-cyan-50 p-6 sm:p-8">
                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-cyan-700">Vue de l'application</p>
                <h2 class="mt-2 text-2xl font-black text-slate-900">Repère les espaces</h2>
                <ul class="mt-5 space-y-3 text-sm text-slate-700">
                    <li class="rounded-xl bg-white p-3 ring-1 ring-cyan-100"><strong>Menu à gauche</strong> : change d'espace (Accueil, ton espace de travail, Guide utilisateur).</li>
                    <li class="rounded-xl bg-white p-3 ring-1 ring-cyan-100"><strong>Zone centrale</strong> : le contenu de la page choisie (listes, formulaires, scores).</li>
                        <li class="rounded-xl bg-white p-3 ring-1 ring-cyan-100"><strong>Profil en haut à droite</strong> : ton compte et la déconnexion.</li>
                            </ul>
                            Ton menu n'affiche que les fonctions autorisées pour ton rôle.
                        </div>
        </section>
    }
    else if (ActivePanel is not null)
    {
        <GuidePanel Panel="ActivePanel" />
    }
</section>
