@page "/direction/parents"
@attribute [Authorize(Roles = "SchulLeiter,Koordinator")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits SkoulouApp.WebApp.Components.CancelableComponentBase

<PageTitle>Accès parents · SKOULOU</PageTitle>

<div class="mx-auto grid max-w-6xl gap-5">
    <SeitenKopf Rubrik="Établissement" Titel="Accès parents" IconName="users"
                Untertitel="Créez un compte pour les parents : ils consultent les bulletins publiés, les absences et les frais de scolarité de leurs enfants." />

    @if (!string.IsNullOrEmpty(meldung))
    {
        <p class="mb-0 flex items-start gap-2 rounded-xl px-4 py-3 text-sm @(fehler ? "border border-rose-200 bg-rose-50 text-rose-800" : "border border-emerald-200 bg-emerald-50 text-emerald-800")" role="status">
            <Icon Name="@(fehler ? "alert" : "check")" Groesse="18" /><span>@meldung</span>
        </p>
    }

    <div class="grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
        <label class="m-0 block">
            <span class="sr-only">Rechercher</span>
            <input class="skoulou-input" placeholder="Rechercher un élève, une classe ou un parent…" @bind="suche" @bind:event="oninput" @bind:after="() => anzeigeLimit = AnzeigeSchritt" />
        </label>
        <p class="mb-0 text-sm text-slate-500"><strong class="text-slate-800">@MitEltern</strong> élève(s) sur @schueler.Count avec un accès parent</p>
    </div>

    @if (laedt)
    {
        <div class="h-40 animate-pulse rounded-2xl bg-slate-200"></div>
    }
    else if (schueler.Count == 0)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-6 text-sm text-slate-500">Aucun élève actif dans l'établissement.</div>
    }
    else
    {
        var gefiltert = Gefiltert.ToList();
        @if (gefiltert.Count == 0)
        {
            <div class="rounded-2xl border border-slate-200 bg-white p-6 text-sm text-slate-500">Aucun élève ne correspond à la recherche.</div>
        }
        <div class="sk-liste-scroll grid gap-3 p-1">
            @foreach (var s in gefiltert.Take(anzeigeLimit))
            {
                <article @key="s.SchuelerID" class="grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm lg:grid-cols-[minmax(0,15rem)_minmax(0,1fr)_auto] lg:items-center">
                    <div>
                        <p class="mb-0 font-bold text-slate-900">@s.Name</p>
                        <p class="mb-0 text-sm text-slate-500">Classe @s.Klasse</p>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        @if (s.Eltern.Count == 0)
                        {
                            <span class="text-sm text-slate-400">Aucun parent lié</span>
                        }
                        @foreach (var e in s.Eltern)
                        {
                            <span class="inline-flex flex-wrap items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm">
                                <Icon Name="user" Groesse="14" />
                                <span class="font-semibold text-slate-800">@e.Name</span>
                                @if (!string.IsNullOrWhiteSpace(e.Beziehung)) { <span class="text-slate-500">· @e.Beziehung</span> }
                                <span class="text-xs text-slate-500">(@e.Identifiant)</span>
                                <button type="button" class="rounded-lg px-1.5 py-0.5 text-xs font-semibold text-blue-700 hover:bg-blue-50" disabled="@laedt" @onclick="() => NeuesPasswortAsync(e)">Nouveau mot de passe</button>
                                <button type="button" class="rounded-lg px-1.5 py-0.5 text-xs font-semibold text-rose-700 hover:bg-rose-50" disabled="@laedt" @onclick="() => TrennenAsync(s, e)">Retirer</button>
                            </span>
                        }
                    </div>
                    <div class="flex flex-wrap gap-2 lg:justify-end">
                        <button type="button" class="sk-btn sk-btn-primary" disabled="@laedt" @onclick="() => AnlegenOeffnenAsync(s)"><Icon Name="user-plus" Groesse="16" />Créer un accès</button>
                        @if (elternkonten.Count > 0)
                        {
                            <button type="button" class="sk-btn sk-btn-secondary" disabled="@laedt" @onclick="() => VerknuepfenOeffnen(s)">Lier un parent existant</button>
                        }
                    </div>
                </article>
            }
        </div>
        @if (gefiltert.Count > anzeigeLimit)
        {
            <div class="sk-liste-mehr">
                <button type="button" class="sk-btn sk-btn-sm sk-btn-secondary" @onclick="() => anzeigeLimit += AnzeigeSchritt">Afficher plus (@(gefiltert.Count - anzeigeLimit) restant(s))</button>
            </div>
        }
    }
</div>

<ModalDialog Open="anlegenOffen" OpenChanged="v => anlegenOffen = v" Title="Créer un accès parent" Eyebrow="@ausgewaehlt?.Name" MaxWidthClass="max-w-2xl" ErrorMessage="@formFehler">
    <div class="grid gap-4 sm:grid-cols-2">
        <label class="m-0">Prénom<input class="skoulou-input mt-1" @bind="eingabe.Vorname" /></label>
        <label class="m-0">Nom<input class="skoulou-input mt-1" @bind="eingabe.Nachname" /></label>
        <ModernDropdown TValue="string" @bind-Value="eingabe.Beziehung" Options="BeziehungOptionen" Label="Lien avec l'élève" />
        <div>
            <span class="skoulou-label">Identifiant de connexion</span>
            <div class="flex gap-2">
                <input class="skoulou-input min-w-0 flex-1" autocapitalize="none" spellcheck="false" placeholder="ex. ama.mensah" @bind="eingabe.Identifiant" />
                <button type="button" class="shrink-0 rounded-xl border border-slate-200 bg-slate-50 px-3 text-sm font-semibold text-slate-700 disabled:opacity-50" disabled="@(string.IsNullOrWhiteSpace(eingabe.Vorname) || string.IsNullOrWhiteSpace(eingabe.Nachname))" @onclick="IdentifiantVorschlagenAsync">Proposer</button>
            </div>
        </div>
        <label class="m-0">Téléphone <span class="font-normal text-slate-400">(facultatif)</span><input type="tel" class="skoulou-input mt-1" @bind="eingabe.Telefon" /></label>
        <label class="m-0">E-mail <span class="font-normal text-slate-400">(facultatif)</span><input type="email" class="skoulou-input mt-1" @bind="eingabe.Email" /></label>
    </div>
    <p class="mb-0 mt-3 text-sm text-slate-500">Le mot de passe initial s'affiche une seule fois après la création. Un même compte peut ensuite être lié aux frères et sœurs.</p>
    <div class="mt-4 flex justify-end gap-2">
        <button type="button" class="rounded-xl border border-slate-300 px-4 py-2.5 font-semibold text-slate-700" @onclick="() => anlegenOffen = false">Annuler</button>
        <button type="button" class="sk-btn sk-btn-primary" disabled="@laedt" @onclick="AnlegenAsync">Créer et lier</button>
    </div>
</ModalDialog>

<ModalDialog Open="verknuepfenOffen" OpenChanged="v => verknuepfenOffen = v" Title="Lier un parent existant" Eyebrow="@ausgewaehlt?.Name" MaxWidthClass="max-w-xl" ErrorMessage="@formFehler">
    <div class="grid gap-4">
        <ModernDropdown TValue="Guid" @bind-Value="verknuepfenElternID" Options="ElternOptionen" Label="Compte parent" Searchable="true" />
        <ModernDropdown TValue="string" @bind-Value="verknuepfenBeziehung" Options="BeziehungOptionen" Label="Lien avec l'élève" />
    </div>
    <div class="mt-4 flex justify-end gap-2">
        <button type="button" class="rounded-xl border border-slate-300 px-4 py-2.5 font-semibold text-slate-700" @onclick="() => verknuepfenOffen = false">Annuler</button>
        <button type="button" class="sk-btn sk-btn-primary" disabled="@(laedt || verknuepfenElternID == Guid.Empty)" @onclick="VerknuepfenAsync">Lier</button>
    </div>
</ModalDialog>

@if (zugang is not null)
{
    <ModalDialog Open="true" Title="Identifiants du parent" CloseOnBackdrop="false">
        <p>Remettez ces identifiants au parent de façon confidentielle. Ils ne seront plus affichés après fermeture. Le parent peut ensuite changer son mot de passe dans son profil.</p>
        <div class="my-3 break-all rounded-xl bg-slate-100 p-3">
            <span class="text-xs text-slate-500">Identifiant</span><br /><strong>@zugang.Identifiant</strong><br />
            <span class="text-xs text-slate-500">Mot de passe</span><br /><code>@zugang.Passwort</code>
        </div>
        <button type="button" class="skoulou-button-primary" @onclick="() => zugang = null">Identifiants transmis — fermer</button>
    </ModalDialog>
}
