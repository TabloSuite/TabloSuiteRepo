@page "/teacher-lessons/{LessonId:guid}/pdf"
@attribute [Authorize(Policy = "RequireTeacher")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits HalloApp.WebApp.Components.CancelableComponentBase
@using HalloApp.Core.Models.TeacherLessons
@using Microsoft.JSInterop

<PageTitle>@(lesson?.Title ?? "Exportation PDF")</PageTitle>

<div class="pdf-export-root">
    @if (lesson is null)
    {
        <section class="mx-auto max-w-3xl rounded-3xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
            <div class="flex items-center gap-3 text-slate-600">
                <ProgressRing Size="1.5rem" Label="Chargement du document" />
                <p>Chargement du document...</p>
            </div>
        </section>
    }
    else
    {
        <section class="mx-auto max-w-4xl space-y-6">
            <div class="no-print flex flex-wrap items-center justify-between gap-3 rounded-2xl bg-slate-950 p-4 text-white">
                <div><p class="font-bold">@lesson.Title</p><p class="text-sm text-slate-300">Export @PdfModeLabel. La boîte de dialogue d'impression permet d'enregistrer ce document au format PDF.</p></div>
                <div class="flex flex-wrap gap-2">
                    <a class="rounded-full bg-white/10 px-4 py-2.5 text-sm font-semibold text-white ring-1 ring-white/20 transition hover:bg-white/20" href="/teacher/lessons">← Retour</a>
                    <a class="rounded-full px-4 py-2.5 text-sm font-semibold ring-1 transition @(IncludeSolutions ? "bg-cyan-400 text-slate-950 ring-cyan-200 shadow-lg shadow-cyan-500/25" : "bg-slate-800 text-white ring-white/20 hover:bg-slate-700")" href="teacher-lessons/@LessonId/pdf?solutions=true">Avec solutions</a>
                    <a class="rounded-full px-4 py-2.5 text-sm font-semibold ring-1 transition @(!IncludeSolutions ? "bg-cyan-400 text-slate-950 ring-cyan-200 shadow-lg shadow-cyan-500/25" : "bg-slate-800 text-white ring-white/20 hover:bg-slate-700")" href="teacher-lessons/@LessonId/pdf?solutions=false">Sans solutions</a>
                    <button type="button" class="rounded-full bg-cyan-400 px-5 py-2.5 text-sm font-semibold text-slate-950" @onclick="@(_ => PrintAsync())">Exporter en PDF</button>
                </div>
            </div>
            <article class="pdf-document bg-white p-10 text-slate-900 shadow-sm ring-1 ring-slate-200">
                <header class="border-b-2 border-cyan-600 pb-5"><p class="text-sm font-semibold uppercase tracking-[.18em] text-cyan-700">@lesson.CourseCode</p><h1 class="mt-2 text-3xl font-black">@lesson.Title</h1>@if (!string.IsNullOrWhiteSpace(lesson.Summary)) { <p class="mt-3 text-slate-600">@lesson.Summary</p> }</header>
                @foreach (var exportPage in lesson.Pages.OrderBy(item => item.PageNumber))
                {
                    <section class="lesson-pdf-page mt-8">
                        <div class="rich-content">@((MarkupString)HtmlSanitizer.Sanitize(exportPage.ContentHtml))</div>
                        <footer class="lesson-pdf-page-footer"><span>SKOULOUAPP · @lesson.Title</span><span>@($"Page {exportPage.PageNumber}")</span></footer>
                    </section>
                }
            </article>
        </section>
    }
</div>
