@page "/auth/forgot-password"
@attribute [AllowAnonymous]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Mot de passe oublié</PageTitle>

<section class="relative mx-auto mt-12 w-full max-w-2xl overflow-hidden rounded-[2rem] bg-white p-6 shadow-xl shadow-cyan-100/80 ring-1 ring-slate-100 sm:mt-20 sm:p-8">
    <div class="pointer-events-none absolute -right-20 -top-20 h-52 w-52 rounded-full bg-cyan-100/70 blur-3xl"></div>
    <div class="relative">
    <div class="mb-6 flex items-center gap-4">
        <div class="grid h-12 w-12 place-items-center rounded-2xl bg-gradient-to-br from-cyan-600 to-blue-700 text-xl font-black text-white shadow-lg shadow-cyan-200">H</div>
        <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-cyan-700">Réinitialisation</p>
            <h1 class="mt-1 text-3xl font-black text-slate-900">Mot de passe oublié</h1>
        </div>
    </div>
    <p class="mt-4 text-sm leading-7 text-slate-600">Saisissez votre adresse e-mail. Si un compte existe, vous recevrez un lien pour choisir un nouveau mot de passe.</p>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="mt-6 rounded-2xl bg-emerald-50 px-4 py-3 text-sm text-emerald-800">@message</div>
    }

    <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync" FormName="forgot-password-form" class="mt-8 grid gap-5 min-w-0">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div>
            <label class="skoulou-label">Adresse e-mail ou identifiant</label>
            <InputText @bind-Value="Model.Email" autocomplete="username" class="skoulou-input" />
            <p class="mt-1 text-xs text-slate-500">Le lien est envoyé à l'adresse e-mail enregistrée. Sans adresse e-mail, demandez à la direction de réinitialiser votre mot de passe.</p>
        </div>

        <AsyncActionButton Type="submit" Class="sk-btn sk-btn-primary" IsBusy="@isSubmitting" BusyLabel="Envoi...">Envoyer le lien</AsyncActionButton>
    </EditForm>

    <p class="mt-6 text-sm text-slate-600"><a class="font-semibold text-cyan-700" href="/auth/login">Retour à la connexion</a></p>
    </div>
</section>
