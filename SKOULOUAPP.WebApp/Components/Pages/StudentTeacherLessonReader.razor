@page "/student/lessons/support/{LessonId:guid}"
@attribute [Authorize(Policy = "RequireStudent")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits SkoulouApp.WebApp.Components.CancelableComponentBase
@using SkoulouApp.Core.Models.TeacherLessons

<PageTitle>@(lesson?.Title ?? "Cours")</PageTitle>

@if (notFound)
{
    <div class="rounded-[2rem] bg-white p-8 text-left shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
        <p class="text-sm font-bold text-slate-900">Ce support enseignant n'est pas disponible pour votre compte.</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">
            Vous pouvez ouvrir seulement les supports publiés pour les élèves par un enseignant de votre école et rattachés à votre classe.
            Ce support est peut-être encore en brouillon, supprimé, ou lié à une autre classe.
        </p>
        <button type="button" class="mt-4 rounded-full bg-slate-100 px-6 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-200" @onclick="GoBack">Retour aux leçons</button>
    </div>
}
else if (lesson is null)
{
    <SkeletonLoader CardCount="2" />
}
else
{
    <section class="grid gap-6">
        <div class="skoulou-hero rounded-[1.25rem] px-5 py-4 text-white shadow-2xl sm:px-6 sm:py-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <span class="rounded-full bg-white/15 px-3 py-1 text-xs font-bold text-white ring-1 ring-white/30">@lesson.CourseCode</span>
                <button type="button" class="rounded-full bg-white/15 px-4 py-2 text-sm font-bold text-white ring-1 ring-white/30 transition hover:bg-white/25" @onclick="GoBack">← Retour aux leçons</button>
            </div>
            <h1 class="mt-3 text-3xl font-black">@lesson.Title</h1>
            @if (!string.IsNullOrWhiteSpace(lesson.CourseTheme))
            {
                <p class="mt-2 text-sm font-semibold text-indigo-100">@lesson.CourseTheme</p>
            }
            @if (!string.IsNullOrWhiteSpace(lesson.Summary))
            {
                <p class="mt-3 max-w-2xl text-sm leading-7 text-indigo-50">@lesson.Summary</p>
            }
        </div>

        @if (lesson.HasVideo)
        {
            <section class="-mx-2 border-y border-cyan-100 bg-white p-3 shadow-lg shadow-cyan-100/60 sm:mx-0 sm:rounded-[2rem] sm:border sm:p-5">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                        <p class="text-sm font-black text-cyan-950">Vidéo de la leçon</p>
                        <p class="mt-1 text-xs leading-5 text-slate-500">@lesson.VideoDisplayName</p>
                    </div>
                    @if (lesson.VideoDuration.HasValue)
                    {
                        <span class="rounded-full bg-cyan-50 px-3 py-1 text-xs font-bold text-cyan-800">@Math.Round(lesson.VideoDuration.Value.TotalMinutes) min</span>
                    }
                </div>
                <video class="-mx-3 mt-4 w-[calc(100%+1.5rem)] max-w-none bg-slate-950 shadow-lg sm:mx-0 sm:w-full sm:max-w-full sm:rounded-2xl" controls preload="metadata" playsinline src="@lesson.VideoUrl"></video>
            </section>
        }

        @if (lesson.Pages.Count == 0)
        {
            <div class="rounded-[2rem] bg-white p-8 text-center shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
                <p class="text-sm text-slate-600">Cette leçon ne contient aucune page.</p>
            </div>
        }
        else
        {
            <div class="lesson-a4-pages mx-auto w-full">
                <article class="lesson-a4-page ql-snow">
                    <div class="ql-editor">
                        @((MarkupString)HtmlSanitizer.SanitizeMitBildern(CurrentPage?.ContentHtml))
                    </div>
                    <p class="lesson-a4-page-number">Page @(currentPageIndex + 1)</p>
                </article>
            </div>

            <div class="lesson-content-nav sticky bottom-0 z-30 -mx-1 flex items-center justify-between gap-4 rounded-2xl border border-slate-100 bg-white/95 px-4 py-3 shadow-lg shadow-slate-200/70 backdrop-blur supports-[backdrop-filter]:bg-white/80">
                <button type="button"
                        class="rounded-full bg-slate-100 px-6 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-200 disabled:opacity-40"
                        @onclick="PreviousPage" disabled="@(currentPageIndex == 0)">
                    ← Page précédente
                </button>
                <span class="text-sm font-semibold text-slate-600">Page @(currentPageIndex + 1) / @lesson.Pages.Count</span>
                <button type="button"
                        class="skoulou-btn-accent rounded-full px-6 py-2.5 text-sm font-semibold transition disabled:opacity-40"
                        @onclick="NextPage" disabled="@(currentPageIndex >= lesson.Pages.Count - 1)">
                    Page suivante →
                </button>
            </div>

            <div class="flex justify-center">
                <button type="button" class="rounded-full bg-slate-100 px-6 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-200" @onclick="GoBack">Retour aux leçons</button>
            </div>
        }

    </section>
}
