@page "/aide/videos"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SkoulouApp.WebApp.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject IWebHostEnvironment Umgebung

<PageTitle>Vidéos d'aide</PageTitle>

<div class="mx-auto grid w-full max-w-6xl gap-5">
    <SeitenKopf Rubrik="Aide" Titel="Vidéos d'aide" IconName="monitor"
                Untertitel="Des vidéos pas à pas, une situation à la fois. Commencez par « La visite guidée », puis celles de votre rôle." />

    @if (gruppen.Count == 0)
    {
        <Abschnitt>
            <p class="mb-0 flex items-center gap-3 text-sm text-slate-600"><Icon Name="monitor" Groesse="22" />Aucune vidéo pour votre rôle pour le moment.</p>
        </Abschnitt>
    }
    else
    {
        @foreach (var g in gruppen)
        {
            var istPourquoi = g.Fuer == VideoKatalog.PourTous;
            <Abschnitt Titel="@g.Titel" IconName="@(istPourquoi ? "sparkles" : GruppenIcon(g.Fuer))"
                       Untertitel="@($"{g.Untertitel}{(g.Videos.Count > 1 ? $" · {g.Videos.Count} vidéos · {Gesamt(g.Videos)}" : "")}")">
                <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
                    @for (var i = 0; i < g.Videos.Count; i++)
                    {
                        var v = g.Videos[i];
                        var nr = i + 1;
                        var vorhanden = Vorhanden(v);
                        <li class="flex min-w-0 flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm @(vorhanden ? "" : "opacity-70")">
                            <button type="button" class="group relative block aspect-video w-full overflow-hidden border-0 bg-slate-100 p-0 disabled:cursor-not-allowed"
                                    disabled="@(!vorhanden)" aria-label="@($"Regarder : {v.Titel}")" @onclick="() => offen = v">
                                @if (PosterVorhanden(v))
                                {
                                    <img src="@PosterUrl(v)" alt="" loading="lazy" class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]" />
                                }
                                else
                                {
                                    <span class="grid h-full w-full place-items-center text-slate-400"><Icon Name="monitor" Groesse="34" /></span>
                                }
                                @if (vorhanden)
                                {
                                    <span class="absolute inset-0 grid place-items-center" aria-hidden="true">
                                        <span class="grid h-14 w-14 place-items-center rounded-full bg-white/95 text-blue-700 shadow-lg transition group-hover:scale-110">
                                            <svg viewBox="0 0 24 24" width="24" height="24"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg>
                                        </span>
                                    </span>
                                }
                                <span class="absolute bottom-2 right-2 rounded-md bg-slate-900/80 px-2 py-0.5 text-xs font-semibold text-white">@v.Dauer</span>
                            </button>
                            <div class="flex flex-1 flex-col gap-1 px-4 py-3">
                                <span class="text-xs font-semibold uppercase tracking-wide text-blue-700">@(istPourquoi ? VideoKatalog.PourTous : g.Videos.Count == 1 ? v.Fuer : $"{v.Fuer} · {nr}/{g.Videos.Count}")</span>
                                <h3 class="mb-0 text-base font-bold text-slate-900">@v.Titel</h3>
                                <p class="mb-0 text-sm leading-6 text-slate-600">@v.Beschreibung</p>
                                @if (!vorhanden)
                                {
                                    <span class="mt-1 w-fit rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600">Bientôt disponible</span>
                                }
                            </div>
                        </li>
                    }
                </ul>
            </Abschnitt>
        }
    }
</div>

@if (offen is { } aktiv)
{
    <div class="fixed inset-0 z-[3000] grid place-items-center bg-slate-950/80 p-3 sm:p-8" role="dialog" aria-modal="true" aria-label="@aktiv.Titel">
        <div class="relative w-full max-w-5xl" @onclick:stopPropagation="true">
            <div class="mb-2 flex items-center justify-between gap-3 text-white">
                <p class="mb-0 truncate text-sm font-semibold">@aktiv.Titel</p>
                <button type="button" class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-white/15 text-white hover:bg-white/25" aria-label="Fermer" @onclick="() => offen = null"><Icon Name="x" Groesse="18" /></button>
            </div>
            <video class="block aspect-video w-full rounded-2xl bg-black shadow-2xl" src="@VideoUrl(aktiv)" poster="@(PosterVorhanden(aktiv) ? PosterUrl(aktiv) : null)" controls autoplay playsinline></video>
        </div>
    </div>
}

@code {
    private IReadOnlyList<VideoKatalog.Gruppe> gruppen = [];
    private VideoKatalog.LernVideo? offen;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        gruppen = VideoKatalog.FuerNutzer(user);
    }

    private static string GruppenIcon(string fuer) => fuer switch
    {
        VideoKatalog.Direction => "school",
        VideoKatalog.Enseignant => "book-open",
        VideoKatalog.Eleve => "graduation",
        VideoKatalog.Parent => "users",
        _ => "monitor",
    };

    /// <summary>Gesamtdauer einer Reihe („2 min“).</summary>
    private static string Gesamt(IEnumerable<VideoKatalog.LernVideo> videos)
    {
        var sekunden = videos.Sum(v => v.Dauer.Split(':') is [var m, var s] && int.TryParse(m, out var mi) && int.TryParse(s, out var se) ? mi * 60 + se : 0);
        return $"{Math.Max(1, (int)Math.Round(sekunden / 60.0))} min";
    }

    private string VideoPfad(VideoKatalog.LernVideo v) => Path.Combine(Umgebung.ContentRootPath, "Medien", "videos", v.Datei);

    private bool Vorhanden(VideoKatalog.LernVideo v) => File.Exists(VideoPfad(v));

    private string VideoUrl(VideoKatalog.LernVideo v) => VideoKatalog.MitVersion(v.Url, VideoPfad(v));

    // Pfad über den File-Provider: WebRootPath kann leer sein (Start aus einem Build-Ordner mit Static-Web-Assets-Manifest).
    private string PosterUrl(VideoKatalog.LernVideo v)
        => VideoKatalog.MitVersion(v.Poster, Umgebung.WebRootFileProvider.GetFileInfo(v.Poster).PhysicalPath);

    private bool PosterVorhanden(VideoKatalog.LernVideo v) => Umgebung.WebRootFileProvider.GetFileInfo(v.Poster).Exists;
}
