@page "/profil"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Mon profil</PageTitle>

<section id="personal-data" class="mx-auto mt-16 w-full max-w-2xl space-y-8">
    <Toast Message="@profileToastMessage" MessageChanged="v => profileToastMessage = v" Kind="@profileToastKind" />
    <Toast Message="@passwordToastMessage" MessageChanged="v => passwordToastMessage = v" Kind="@passwordToastKind" />

    <div class="rounded-[2rem] bg-white p-6 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 sm:p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-cyan-700">Profil</p>
        <h1 class="mt-3 text-3xl font-black text-slate-900">Mon profil</h1>

        @if (isLoading)
        {
            <div class="mt-6 flex items-center gap-3 text-sm text-slate-500">
                <ProgressRing Size="1.25rem" Label="Chargement du profil" />
                <span>Chargement...</span>
            </div>
        }
        else if (profileModel is null)
        {
            <div class="mt-6 rounded-2xl bg-rose-50 px-4 py-3 text-sm text-rose-800">Utilisateur introuvable.</div>
        }
        else
        {
            <div class="mt-6 rounded-2xl border border-cyan-100 bg-cyan-50/50 p-4">
                <p class="text-xs font-bold uppercase tracking-[0.16em] text-cyan-700">Identité</p>
                <div class="mt-3 flex flex-wrap items-center gap-4">
                    <div class="h-20 w-20 overflow-hidden rounded-full border border-cyan-100 bg-white">
                        @if (!string.IsNullOrWhiteSpace(profileImageUrl))
                        {
                            <img class="h-full w-full object-cover" src="@profileImageUrl" alt="Photo de profil" />
                        }
                        else
                        {
                            <div class="flex h-full w-full items-center justify-center text-2xl text-cyan-700">👤</div>
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="truncate text-sm font-black text-slate-900">@fullProfile?.FullName</p>
                        <p class="truncate text-xs text-slate-500">@email</p>
                        @if (!string.IsNullOrWhiteSpace(fullProfile?.CurrentKlasseAnzeige))
                        {
                            <p class="mt-1 text-xs font-semibold text-cyan-800">Classe actuelle : @fullProfile.CurrentKlasseAnzeige</p>
                        }
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <button type="button" class="rounded-full bg-white px-4 py-2 text-xs font-semibold text-cyan-800 ring-1 ring-cyan-200" @onclick="OpenImageLibraryAsync">Choisir la photo</button>
                        @if (ProfileModel.ProfilBildAssetId.HasValue)
                        {
                            <button type="button" class="rounded-full bg-rose-100 px-4 py-2 text-xs font-semibold text-rose-700" @onclick="RemoveProfileImageAsync">Retirer</button>
                        }
                    </div>
                </div>

            <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-4">
                <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-600">Thème de couleur</p>
                <div class="mt-3 flex flex-wrap gap-2">
                    <button type="button" class="h-7 w-7 rounded-full border-2 shadow-sm transition @(currentTheme == "navy" ? "scale-110 border-slate-950 ring-2 ring-slate-900/55 ring-offset-2" : "border-transparent hover:scale-110")" style="background:#1e3a8a" title="Marine" aria-pressed="@(currentTheme == "navy")" @onclick='() => SelectThemeAsync("navy")'></button>
                    <button type="button" class="h-7 w-7 rounded-full border-2 shadow-sm transition @(currentTheme == "ocean" ? "scale-110 border-slate-950 ring-2 ring-slate-900/55 ring-offset-2" : "border-transparent hover:scale-110")" style="background:#0284c7" title="Océan" aria-pressed="@(currentTheme == "ocean")" @onclick='() => SelectThemeAsync("ocean")'></button>
                    <button type="button" class="h-7 w-7 rounded-full border-2 shadow-sm transition @(currentTheme == "coral" ? "scale-110 border-slate-950 ring-2 ring-slate-900/55 ring-offset-2" : "border-transparent hover:scale-110")" style="background:#ea580c" title="Corail" aria-pressed="@(currentTheme == "coral")" @onclick='() => SelectThemeAsync("coral")'></button>
                    <button type="button" class="h-7 w-7 rounded-full border-2 shadow-sm transition @(currentTheme == "slate" ? "scale-110 border-slate-950 ring-2 ring-slate-900/55 ring-offset-2" : "border-transparent hover:scale-110")" style="background:#334155" title="Ardoise" aria-pressed="@(currentTheme == "slate")" @onclick='() => SelectThemeAsync("slate")'></button>
                    <button type="button" class="h-7 w-7 rounded-full border-2 shadow-sm transition @(currentTheme == "sage" ? "scale-110 border-slate-950 ring-2 ring-slate-900/55 ring-offset-2" : "border-transparent hover:scale-110")" style="background:#4d7c4a" title="Sauge" aria-pressed="@(currentTheme == "sage")" @onclick='() => SelectThemeAsync("sage")'></button>
                </div>
            </div>
            </div>

            <EditForm Model="ProfileModel" OnValidSubmit="HandleProfileAsync" FormName="profile-form" class="mt-8 grid gap-5 min-w-0">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div>
                    <label class="hallo-label">Adresse e-mail</label>
                    <input type="email" value="@email" disabled class="hallo-input" />
                </div>

                <div class="grid gap-5 sm:grid-cols-2">
                    <div>
                        <label class="hallo-label">Prénom</label>
                        <InputText @bind-Value="ProfileModel.Vorname" class="hallo-input" />
                    </div>
                    <div>
                        <label class="hallo-label">Nom</label>
                        <InputText @bind-Value="ProfileModel.Nachname" class="hallo-input" />
                    </div>
                </div>

                <div>
                    <label class="hallo-label">Genre</label>
                    <InputSelect @bind-Value="ProfileModel.Geschlecht" class="hallo-input">
                        <option value="@Geschlecht.Divers">Divers / non précisé</option>
                        <option value="@Geschlecht.Maennlich">Masculin</option>
                        <option value="@Geschlecht.Weiblich">Féminin</option>
                    </InputSelect>
                </div>

                <div>
                    <label class="hallo-label">Téléphone (optionnel)</label>
                    <InputText @bind-Value="ProfileModel.TelefonNummer" class="hallo-input" />
                </div>

                @if (isTeacher)
                {
                    <div class="rounded-2xl border border-indigo-100 bg-indigo-50/40 p-4">
                        <p class="text-sm font-black text-indigo-900">Matières enseignées</p>
                        @if (teacherFachOptions.Count == 0)
                        {
                            <p class="mt-2 text-sm text-slate-600">Aucune matière disponible pour tes écoles.</p>
                        }
                        else
                        {
                            <div class="mt-3 grid gap-2 sm:grid-cols-2">
                                @foreach (var fach in teacherFachOptions)
                                {
                                    var isSelected = selectedFachIds.Contains(fach.FachId);
                                    <label class="flex items-center gap-2 rounded-xl bg-white px-3 py-2 text-sm text-slate-700 ring-1 ring-slate-100">
                                        <input type="checkbox" checked="@isSelected" @onchange="args => ToggleFachAsync(fach.FachId, args.Value as bool? == true)" />
                                        <span class="font-semibold">@fach.Name</span>
                                        <span class="text-xs text-slate-500">· @fach.SchoolName</span>
                                    </label>
                                }
                            </div>
                        }

                        <div class="mt-4 grid gap-2 sm:grid-cols-[1fr_auto]">
                            <InputText @bind-Value="newFachName" class="hallo-input" placeholder="Nouvelle matière" />
                            <AsyncActionButton Class="rounded-full bg-indigo-700 px-4 py-2 text-sm font-semibold text-white" Disabled="@string.IsNullOrWhiteSpace(newFachName)" IsBusy="@isAddingFach" BusyLabel="Ajout..." OnClick="AddFachAsync">Ajouter</AsyncActionButton>
                        </div>
                    </div>
                }

                <AsyncActionButton Type="submit" Class="rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white disabled:opacity-50" IsBusy="@isSavingProfile" BusyLabel="Enregistrement...">Enregistrer le profil</AsyncActionButton>
            </EditForm>

            <div class="mt-6 rounded-2xl border border-slate-100 bg-slate-50 p-4 text-sm text-slate-700">
                <p><span class="font-semibold text-slate-900">Créé le :</span> @fullProfile?.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
                @if (fullProfile?.UpdatedAtUtc is DateTime updatedAt)
                {
                    <p class="mt-1"><span class="font-semibold text-slate-900">Dernière mise à jour :</span> @updatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
                }
                @if (fullProfile?.Rollen?.Count > 0)
                {
                    <p class="mt-1"><span class="font-semibold text-slate-900">Rôle(s) :</span> @string.Join(", ", fullProfile.Rollen)</p>
                }
                @if (fullProfile?.Schulen?.Count > 0)
                {
                    <p class="mt-1"><span class="font-semibold text-slate-900">École(s) :</span> @string.Join(", ", fullProfile.Schulen.Select(item => item.SchoolName))</p>
                }
                @if (!string.IsNullOrWhiteSpace(fullProfile?.ElternTelefonNummer))
                {
                    <p class="mt-1"><span class="font-semibold text-slate-900">Téléphone parent :</span> @fullProfile.ElternTelefonNummer</p>
                }
                @if (!string.IsNullOrWhiteSpace(fullProfile?.ElternEmail))
                {
                    <p class="mt-1"><span class="font-semibold text-slate-900">E-mail parent :</span> @fullProfile.ElternEmail</p>
                }
            </div>
        }
    </div>

    <AzureBlobImageLibrary Open="imageLibraryOpen"
                           OpenChanged="@(open => imageLibraryOpen = open)"
                       ProfileImageMode="true"
                           ImageSelected="OnProfileImageSelectedAsync" />

    <div id="change-password" class="rounded-[2rem] bg-white p-6 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 sm:p-8">
        <h2 class="text-2xl font-black text-slate-900">Changer le mot de passe</h2>

        @if (!string.IsNullOrWhiteSpace(passwordMessage))
        {
            <div class="mt-6 rounded-2xl @(passwordSucceeded ? "bg-emerald-50 text-emerald-800" : "bg-rose-50 text-rose-800") px-4 py-3 text-sm">@passwordMessage</div>
        }

        <EditForm Model="PasswordModel" OnValidSubmit="HandlePasswordAsync" FormName="change-password-form" class="mt-8 grid gap-5 min-w-0">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">Mot de passe actuel</label>
                <PasswordInput @bind-Value="PasswordModel.CurrentPassword" />
            </div>

            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">Nouveau mot de passe</label>
                <PasswordInput @bind-Value="PasswordModel.NewPassword" Autocomplete="new-password" />
                <p class="mt-1 text-xs text-slate-500">Le mot de passe doit contenir au moins 6 caractères, dont au moins 1 chiffre et 1 lettre minuscule.</p>
            </div>

            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">Confirmer le nouveau mot de passe</label>
                <PasswordInput @bind-Value="PasswordModel.ConfirmPassword" Autocomplete="new-password" />
            </div>

            <AsyncActionButton Type="submit" Class="rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white disabled:opacity-50" IsBusy="@isSavingPassword" BusyLabel="Enregistrement...">Changer le mot de passe</AsyncActionButton>
        </EditForm>
    </div>
</section>
