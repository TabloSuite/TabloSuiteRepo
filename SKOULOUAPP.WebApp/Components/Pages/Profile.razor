@page "/profil"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Mon profil</PageTitle>

<section id="personal-data" class="mx-auto mt-16 w-full max-w-2xl space-y-8">
    <div class="rounded-[2rem] bg-white p-6 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 sm:p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-cyan-700">Profil</p>
        <h1 class="mt-3 text-3xl font-black text-slate-900">Mon profil</h1>

        @if (isLoading)
        {
            <div class="mt-6 flex items-center gap-3 text-sm text-slate-500">
                <ProgressRing Size="1.25rem" Label="Chargement du profil" />
                <span>Chargement...</span>
            </div>
        }
        else if (profileModel is null)
        {
            <div class="mt-6 rounded-2xl bg-rose-50 px-4 py-3 text-sm text-rose-800">Utilisateur introuvable.</div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(profileMessage))
            {
                <div class="mt-6 rounded-2xl @(profileSucceeded ? "bg-emerald-50 text-emerald-800" : "bg-rose-50 text-rose-800") px-4 py-3 text-sm">@profileMessage</div>
            }

            <EditForm Model="ProfileModel" OnValidSubmit="HandleProfileAsync" FormName="profile-form" class="mt-8 grid gap-5 min-w-0">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div>
                    <label class="hallo-label">Adresse e-mail</label>
                    <input type="email" value="@email" disabled class="hallo-input" />
                </div>

                <div class="grid gap-5 sm:grid-cols-2">
                    <div>
                        <label class="hallo-label">Prénom</label>
                        <InputText @bind-Value="ProfileModel.Vorname" class="hallo-input" />
                    </div>
                    <div>
                        <label class="hallo-label">Nom</label>
                        <InputText @bind-Value="ProfileModel.Nachname" class="hallo-input" />
                    </div>
                </div>

                <div>
                    <label class="hallo-label">Genre</label>
                    <InputSelect @bind-Value="ProfileModel.Geschlecht" class="hallo-input">
                        <option value="@Geschlecht.Divers">Divers / non précisé</option>
                        <option value="@Geschlecht.Maennlich">Masculin</option>
                        <option value="@Geschlecht.Weiblich">Féminin</option>
                    </InputSelect>
                </div>

                <AsyncActionButton Type="submit" Class="rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white disabled:opacity-50" IsBusy="@isSavingProfile" BusyLabel="Enregistrement...">Enregistrer le profil</AsyncActionButton>
            </EditForm>
        }
    </div>

    <div id="change-password" class="rounded-[2rem] bg-white p-6 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 sm:p-8">
        <h2 class="text-2xl font-black text-slate-900">Changer le mot de passe</h2>

        @if (!string.IsNullOrWhiteSpace(passwordMessage))
        {
            <div class="mt-6 rounded-2xl @(passwordSucceeded ? "bg-emerald-50 text-emerald-800" : "bg-rose-50 text-rose-800") px-4 py-3 text-sm">@passwordMessage</div>
        }

        <EditForm Model="PasswordModel" OnValidSubmit="HandlePasswordAsync" FormName="change-password-form" class="mt-8 grid gap-5 min-w-0">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">Mot de passe actuel</label>
                <PasswordInput @bind-Value="PasswordModel.CurrentPassword" />
            </div>

            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">Nouveau mot de passe</label>
                <PasswordInput @bind-Value="PasswordModel.NewPassword" Autocomplete="new-password" />
            </div>

            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">Confirmer le nouveau mot de passe</label>
                <PasswordInput @bind-Value="PasswordModel.ConfirmPassword" Autocomplete="new-password" />
            </div>

            <AsyncActionButton Type="submit" Class="rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white disabled:opacity-50" IsBusy="@isSavingPassword" BusyLabel="Enregistrement...">Changer le mot de passe</AsyncActionButton>
        </EditForm>
    </div>
</section>
