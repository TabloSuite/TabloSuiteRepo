@page "/auth/reset-password"
@attribute [AllowAnonymous]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Nouveau mot de passe</PageTitle>

<section class="relative mx-auto mt-12 w-full max-w-2xl overflow-hidden rounded-[2rem] bg-white p-6 shadow-xl shadow-cyan-100/80 ring-1 ring-slate-100 sm:mt-20 sm:p-8">
    <div class="pointer-events-none absolute -right-20 -top-20 h-52 w-52 rounded-full bg-cyan-100/70 blur-3xl"></div>
    <div class="relative">
    <div class="mb-6 flex items-center gap-4">
        <div class="grid h-12 w-12 place-items-center rounded-2xl bg-gradient-to-br from-cyan-600 to-blue-700 text-xl font-black text-white shadow-lg shadow-cyan-200">H</div>
        <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-cyan-700">Réinitialisation</p>
            <h1 class="mt-1 text-3xl font-black text-slate-900">Nouveau mot de passe</h1>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="mt-6 rounded-2xl @(succeeded ? "bg-emerald-50 text-emerald-800" : "bg-rose-50 text-rose-800") px-4 py-3 text-sm">@message</div>
    }

    @if (!succeeded)
    {
        <EditForm Model="Model" OnValidSubmit="HandleSubmitAsync" FormName="reset-password-form" class="mt-8 grid gap-5 min-w-0">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">Nouveau mot de passe</label>
                <PasswordInput @bind-Value="Model.Password" Autocomplete="new-password" />
            </div>

            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">Confirmer le mot de passe</label>
                <PasswordInput @bind-Value="Model.ConfirmPassword" Autocomplete="new-password" />
            </div>

            <AsyncActionButton Type="submit" Class="rounded-full bg-gradient-to-r from-cyan-600 to-blue-700 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-cyan-200 transition hover:-translate-y-0.5 disabled:opacity-50" IsBusy="@isSubmitting" BusyLabel="Enregistrement...">Enregistrer</AsyncActionButton>
        </EditForm>
    }

    <p class="mt-6 text-sm text-slate-600"><a class="font-semibold text-cyan-700" href="/auth/login">Aller à la connexion</a></p>
    </div>
</section>
