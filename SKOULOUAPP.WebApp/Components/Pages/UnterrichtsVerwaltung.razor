@page "/direction/enseignement"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SchulLeiter,Koordinator")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits CancelableComponentBase
@using SkoulouApp.WebApp.Services

<PageTitle>Organisation des enseignements</PageTitle>
<div class="mx-auto max-w-6xl space-y-6 p-4">
    <SeitenKopf Rubrik="Établissement" Titel="Organisation des enseignements" IconName="layers" Untertitel="Préparez les années scolaires et les affectations des enseignants par classe et matière." />
    @if (!string.IsNullOrEmpty(message))
    {
        <div role="status" class="rounded-xl border p-4 @(erreur ? "border-red-300 bg-red-50 text-red-800" : "border-green-300 bg-green-50 text-green-800")">@message</div>
    }
    <ModernDropdown TValue="Guid" Value="schulID" ValueChanged="ChangerEcoleAsync" Options="Options(schulen)" Label="École" EinzigeOptionFest="true" Searchable="true" Disabled="occupe" />
    @if (schulen.Count == 0 && !occupe)
    {
        <p>Aucune école active n'est disponible pour votre compte.</p>
    }
    @if (uebersicht is not null)
    {
        <details class="rounded-2xl border bg-white p-5 shadow-sm">
            <summary class="cursor-pointer text-base font-bold text-slate-900">Coordonnées officielles de l'école</summary>
            <p class="mt-2 text-sm text-slate-600">Informations destinées aux futurs documents scolaires. Tous les champs sont facultatifs.</p>
            <div class="mt-4 grid gap-4 md:grid-cols-2">
                <label>Dénomination officielle<input class="skoulou-input mt-1" maxlength="300" @bind="dokumentDaten.OffizielleBezeichnung" /></label>
                <label>Slogan de l'école<input class="skoulou-input mt-1" maxlength="300" @bind="dokumentDaten.Slogan" /></label>
                <label>Adresse<input class="skoulou-input mt-1" maxlength="300" @bind="dokumentDaten.DokumentAdresse" /></label>
                <label>Téléphone<input class="skoulou-input mt-1" maxlength="60" @bind="dokumentDaten.DokumentTelefon" /></label>
                <label>Adresse e-mail<input type="email" class="skoulou-input mt-1" maxlength="256" @bind="dokumentDaten.DokumentEmail" /></label>
                <label>Numéro d'agrément<input class="skoulou-input mt-1" maxlength="100" @bind="dokumentDaten.Zulassungsnummer" /></label>
                <label>Ministère / autorité de tutelle<input class="skoulou-input mt-1" maxlength="300" @bind="dokumentDaten.Ministerium" /></label>
                <label>République / pays<input class="skoulou-input mt-1" maxlength="300" @bind="dokumentDaten.RepublikZeile" /></label>
                <label>Devise nationale<input class="skoulou-input mt-1" maxlength="300" @bind="dokumentDaten.StaatsMotto" /></label>
                <label>Direction régionale / départementale<input class="skoulou-input mt-1" maxlength="200" placeholder="ex. Direction régionale de l'éducation Lomé-Golfe" @bind="dokumentDaten.DokumentDirection" /></label>
                <label>Statut de l'établissement<input class="skoulou-input mt-1" maxlength="60" placeholder="ex. Privé laïc, Public, Confessionnel" @bind="dokumentDaten.DokumentStatut" /></label>
            </div>
            <button type="button" class="sk-btn sk-btn-primary mt-4" disabled="@occupe" @onclick="SpeichereDokumentAsync">Enregistrer les coordonnées</button>
        </details>
        <details class="rounded-2xl border bg-white p-5 shadow-sm">
            <summary class="cursor-pointer text-base font-bold text-slate-900">Matricules et état civil des élèves</summary>
            <div class="mt-4 grid gap-4 md:grid-cols-2">
                <ModernDropdown TValue="Guid" Value="schuelerID" ValueChanged="WaehleSchueler" Options="SchuelerOptionen" Label="Élève" Searchable="true" Disabled="occupe" />
                <label>Matricule<input class="skoulou-input mt-1" maxlength="60" @bind="matrikelnummer" /><span class="text-sm">Si vide, un matricule stable est attribué automatiquement. Un matricule existant n'est pas effacé.</span></label>
                <button type="button" class="sk-btn sk-btn-secondary" @onclick="MatriculesAsync">Attribuer les matricules manquants de l'école</button>
                <label>Lieu de naissance<input class="skoulou-input mt-1" maxlength="150" @bind="geburtsort" /></label>
                <label>Nationalité<input class="skoulou-input mt-1" maxlength="80" placeholder="ex. Togolaise" @bind="nationalitaet" /></label>
                <div class="flex flex-wrap items-center gap-5"><label class="inline-flex items-center gap-2"><input type="checkbox" @bind="istInterne" /> Interne</label><label class="inline-flex items-center gap-2"><input type="checkbox" @bind="istAffecte" /> Affecté(e) par l'État</label></div>
            </div>
            <p class="mt-2 text-sm text-slate-600">Le matricule est unique dans cette école. Laissez le champ vide s'il n'est pas encore attribué.</p>
            <button type="button" class="sk-btn sk-btn-primary mt-4" disabled="@(occupe || schuelerID == Guid.Empty)" @onclick="SpeichereSchuelerAsync">Enregistrer la fiche élève</button>
        </details>
        <section class="rounded-2xl border bg-white p-5 shadow-sm">
            <h2 class="text-base font-bold text-slate-900">Années scolaires</h2>
            <div class="mt-4 grid gap-4 md:grid-cols-3">
                <label>Intitulé<input class="skoulou-input mt-1" maxlength="80" placeholder="2026–2027" @bind="bezeichnung" /></label>
                <label>Début<input type="date" class="skoulou-input mt-1" @bind="beginn" /></label>
                <label>Fin<input type="date" class="skoulou-input mt-1" @bind="ende" /></label>
            </div>
            <button type="button" class="sk-btn sk-btn-primary mt-4" disabled="@occupe" @onclick="SpeichereJahrAsync">Créer l'année scolaire</button>
            <div class="mt-4">
                <ModernDropdown TValue="Guid" Value="schuljahrID" ValueChanged="WaehleJahrAsync" Options="JahresOptionen" Label="Année scolaire sélectionnée" Disabled="occupe" />
            </div>
        </section>
        <details class="rounded-2xl border bg-white p-5 shadow-sm">
            <summary class="cursor-pointer text-base font-bold text-slate-900">Inscriptions annuelles et redoublement</summary>
            <p class="mt-2 text-sm text-slate-600">Enregistrez la classe actuelle pour l'année sélectionnée. Les années précédentes ne sont pas modifiées par une promotion.</p>
            <div class="mt-4 grid gap-4 md:grid-cols-2">
                <ModernDropdown TValue="Guid" @bind-Value="jahresSchuelerID" Options="SchuelerOptionen" Label="Élève" Searchable="true" Disabled="occupe" />
                <ModernDropdown TValue="Guid" @bind-Value="jahresKlasseID" Options="Options(uebersicht.Klassen)" Label="Classe actuelle" Searchable="true" Disabled="occupe" />
            </div>
            <label class="mt-4 block"><input type="checkbox" @bind="wiederholer" /> Redoublant pour cette année scolaire</label>
            <button type="button" class="sk-btn sk-btn-primary mt-3" disabled="@(occupe || schuljahrID == Guid.Empty || jahresSchuelerID == Guid.Empty || jahresKlasseID == Guid.Empty)" @onclick="SpeichereJahresSchuelerAsync">Enregistrer l'inscription</button>
            <div class="mt-4 flex flex-wrap items-center gap-3">
                <input type="search" class="skoulou-input min-w-0 flex-1 sm:max-w-sm" placeholder="Rechercher un élève ou une classe..." aria-label="Rechercher une inscription" @bind="jahresSuche" @bind:event="oninput" />
                <span class="text-xs font-semibold text-slate-500">@GefilterteJahresSchueler.Count / @jahresSchueler.Count inscription(s)</span>
            </div>
            <ul class="sk-liste-scroll mt-3 space-y-2">
                @foreach (var inscription in GefilterteJahresSchueler)
                {
                    <li>@inscription.Name · @inscription.Klasse · @(inscription.IstWiederholer ? "Redoublant" : "Non redoublant")</li>
                }
            </ul>
        </details>
        <details class="rounded-2xl border bg-white p-5 shadow-sm">
            <summary class="cursor-pointer text-base font-bold text-slate-900">Archives et clôture de l'année</summary>
            <ul class="mt-3 space-y-2">
                @foreach (var jahr in uebersicht.Schuljahre)
                {
                    <li>@jahr.Bezeichnung · @(jahr.IstGeschlossen ? "Clôturée" : "Ouverte")</li>
                }
            </ul>
            <label class="mt-4 block"><input type="checkbox" @bind="abschlussBestaetigt" /> Je confirme la clôture définitive de l'année sélectionnée. Les affectations et inscriptions ne seront plus modifiables.</label>
            <button type="button" class="sk-btn sk-btn-danger mt-3" disabled="@(occupe || schuljahrID == Guid.Empty || !abschlussBestaetigt)" @onclick="SchliesseJahrAsync">Clôturer l'année sélectionnée</button>
        </details>
        <section class="rounded-2xl border bg-white p-5 shadow-sm">
            <h2 class="text-base font-bold text-slate-900">Affecter un enseignant</h2>
            <p class="mt-2 text-sm text-slate-600">Affectez d'abord l'enseignant à sa classe et à sa matière dans la gestion du personnel. Le volume indiqué ici sert à la planification et ne modifie pas les commissions.</p>
            <div class="mt-4 grid gap-4 md:grid-cols-2">
                <ModernDropdown TValue="Guid" @bind-Value="klasseID" Options="Options(uebersicht.Klassen)" Label="Classe" Searchable="true" Disabled="occupe" />
                <ModernDropdown TValue="Guid" @bind-Value="fachID" Options="Options(uebersicht.Faecher)" Label="Matière" Searchable="true" Disabled="occupe" />
                <ModernDropdown TValue="Guid" @bind-Value="lehrerID" Options="Options(uebersicht.Lehrer)" Label="Enseignant" Searchable="true" Disabled="occupe" />
                <label>Heures par semaine<input type="number" min="0.01" max="168" step="0.01" class="skoulou-input mt-1" @bind="wochenstunden" /></label>
            </div>
            <button type="button" class="sk-btn sk-btn-primary mt-4" disabled="@(occupe || schuljahrID == Guid.Empty || klasseID == Guid.Empty || fachID == Guid.Empty || lehrerID == Guid.Empty)" @onclick="SpeichereUnterrichtAsync">Enregistrer l'affectation</button>
            <p class="mt-2 text-sm text-slate-500">Une affectation existante est mise à jour sans créer de doublon.</p>
        </section>
        <section class="space-y-3">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <h2 class="text-base font-bold text-slate-900">Enseignements de l'année sélectionnée</h2>
                <input type="search" class="skoulou-input min-w-0 flex-1 sm:max-w-sm" placeholder="Rechercher une classe, une matière ou un enseignant..." aria-label="Rechercher un enseignement" @bind="unterrichtSuche" @bind:event="oninput" />
            </div>
            <div class="sk-liste-scroll space-y-3 p-1">
            @foreach (var zeile in GefilterterUnterricht)
            {
                <article @key="zeile.Id" class="flex flex-wrap items-center justify-between gap-3 rounded-xl border bg-white p-4">
                    <div class="min-w-0 break-words"><h3 class="font-semibold">@zeile.Klasse · @zeile.Fach</h3><p>@zeile.Lehrer</p><p class="text-sm text-slate-600">@zeile.Wochenstunden h / semaine</p></div>
                    <button type="button" class="sk-btn sk-btn-danger" disabled="@occupe" @onclick="() => EntferneAsync(zeile.Id)">Retirer</button>
                </article>
            }
            </div>
            @if (!uebersicht.Unterricht.Any(x => x.SchuljahrID == schuljahrID))
            {
                <p class="rounded-xl bg-slate-50 p-4">Aucune affectation pour cette année scolaire.</p>
            }
        </section>
    }
</div>
