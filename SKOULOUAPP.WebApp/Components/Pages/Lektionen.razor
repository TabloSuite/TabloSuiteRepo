@page "/lektionen"
@inherits SkoulouApp.WebApp.Components.CancelableComponentBase

<PageTitle>Mes leçons</PageTitle>

<section class="skoulou-hero mb-6 overflow-hidden rounded-[1.25rem] px-5 py-4 text-white shadow-xl">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-100">Parcours d'apprentissage</p>
    <h1 class="mt-2 text-3xl font-black tracking-tight">Mes leçons</h1>
    <p class="mt-3 max-w-3xl text-sm leading-7 text-indigo-100">Choisis une leçon et progresse pas à pas avec des exercices simples, des images et des contenus audio.</p>
</section>

@if (_istGeladen is false)
{
    <div class="d-flex align-items-center gap-2 text-secondary">
        <ProgressRing Size="1.25rem" Label="Chargement des leçons" />
        <em>Chargement des leçons...</em>
    </div>
}
else if (_lektionen.Count == 0)
{
    <div class="alert alert-info" role="alert">
        Aucune leçon trouvée.
    </div>
}
else
{
    <div class="grid gap-4 xl:grid-cols-2">
        @foreach (var lektion in _lektionen)
        {
            <article class="group min-w-0 overflow-hidden rounded-[1.75rem] border border-cyan-100 bg-white p-5 shadow-lg shadow-slate-200/70 transition duration-300 hover:-translate-y-1 hover:border-cyan-200 hover:shadow-2xl hover:shadow-cyan-100">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div class="min-w-0">
                        <span class="skoulou-btn-accent inline-flex rounded-full px-3 py-1 text-xs font-black">@lektion.LevelCode</span>
                        <h2 class="mt-4 break-words text-2xl font-black text-slate-950">@lektion.Title</h2>
                    </div>
                    <Badge Accent="cyan">N° @lektion.Order</Badge>
                </div>

                <p class="mt-4 text-sm leading-7 text-slate-600">@lektion.Summary</p>

                <div class="mt-5 grid gap-3 text-center text-sm sm:grid-cols-3">
                    <div class="rounded-2xl bg-gradient-to-br from-indigo-50 to-white p-3 ring-1 ring-indigo-100">
                        <div class="text-xl font-black text-indigo-700">@lektion.Order</div>
                        <div class="text-slate-500">Ordre</div>
                    </div>
                    <div class="rounded-2xl bg-gradient-to-br from-cyan-50 to-white p-3 ring-1 ring-cyan-100">
                        <div class="text-xl font-black text-cyan-700">@lektion.MediaCount</div>
                        <div class="text-slate-500">Médias</div>
                    </div>
                    <div class="rounded-2xl bg-gradient-to-br from-emerald-50 to-white p-3 ring-1 ring-emerald-100">
                        <div class="text-xl font-black text-emerald-700">@lektion.ExerciseCount</div>
                        <div class="text-slate-500">Exercices</div>
                    </div>
                </div>
            </article>
        }
    </div>
}
