@page "/cycle-participants"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin")]
@inherits CancelableComponentBase
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using SkoulouApp.Core.Services
@using SkoulouApp.WebApp.Data
@inject IDbContextFactory<ApplicationDbContext> Factory
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider Auth

<PageTitle>Participants facturables</PageTitle>
<div class="mx-auto max-w-4xl space-y-4 p-4">
    <a class="font-semibold text-blue-700" href="/admin">← Retour à l'administration</a>
    <h1 class="text-2xl font-bold">Participants facturables des cycles</h1>
    <p>Une sortie de classe ou un compte bloqué n'annule pas la participation. Seule une affectation erronée peut être annulée ici, avec un motif obligatoire, avant la clôture. Les inscriptions annulées restent dans l'historique. Aucune modification du compte ni des droits d'accès n'est effectuée.</p>
    @if (!string.IsNullOrEmpty(message)) { <p role="status" class="rounded border p-3">@message</p> }
    @foreach (var cycle in cycles)
    {
        <section class="rounded-xl border p-4">
            <h2 class="font-semibold">@cycle.Label</h2>
            <button type="button" class="mt-2 rounded border p-2" disabled="@busy" @onclick="() => LadenAsync(cycle.Id)">Afficher les participants</button>
            @if (selected == cycle.Id)
            {
                <p class="mt-3 font-semibold">@rows.Count(x => x.StorniertAmUtc == null) participant(s) · @rows.Where(x => x.StorniertAmUtc == null).Sum(x => x.Preis).ToString("N0") FCFA</p>
                @foreach (var p in rows)
                {
                    <div class="mt-3 break-words rounded border p-3">
                        <p>@p.Name · @p.Preis.ToString("N0") FCFA</p>
                        @if (p.StorniertAmUtc != null) { <p>Annulé : @p.StornoGrund</p> }
                        else if (!cycle.Closed)
                        {
                            <button type="button" class="rounded border p-2" disabled="@busy" @onclick="() => Choisir(p.Id)">Signaler une affectation erronée</button>
                            @if (pending == p.Id)
                            {
                                <label class="block">Motif obligatoire<input maxlength="300" class="w-full rounded border p-2" @bind="reason" /></label>
                                <button type="button" class="mt-2 rounded bg-red-700 p-2 text-white" disabled="@(busy || string.IsNullOrWhiteSpace(reason))" @onclick="StornierenAsync">Confirmer l'annulation financière</button>
                            }
                        }
                    </div>
                }
            }
        </section>
    }
</div>

@code {
    private List<CycleRow> cycles = [];
    private List<ZyklusTeilnehmerZeile> rows = [];
    private Guid userID, selected, pending;
    private string reason = "", message = "";
    private bool busy;
    private sealed record CycleRow(Guid Id, string Label, bool Closed);
    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        if (!Guid.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier), out userID)) return;
        await using var db = await Factory.CreateDbContextAsync(ComponentToken);
        var admin = await db.Users.AnyAsync(u => u.Id == userID && !u.IsBlocked && db.UserRoles.Any(x => x.UserId == userID && db.Roles.Any(r => r.Id == x.RoleId && r.Name == "SuperAdmin")), ComponentToken);
        if (!admin) return;
        cycles = await db.KursNiveauDurchlaeufe.AsNoTracking().Where(x => x.PlattformPreisProSchueler != null)
            .OrderBy(x => x.Schule.Name).ThenByDescending(x => x.StartDatum)
            .Select(x => new CycleRow(x.Id, x.Schule.Name + " · " + x.Klasse.Code + " · " + (x.EndDatum == null ? "En cours" : "Clôturé"), x.EndDatum != null)).ToListAsync(ComponentToken);
    }
    private void Choisir(Guid id) { pending = id; reason = ""; }
    private async Task LadenAsync(Guid id)
    {
        busy = true;
        try
        {
            await using var db = await Factory.CreateDbContextAsync(ComponentToken);
            rows = await new ZyklusTeilnahmeService(db).ListeAsync(userID, id, ComponentToken);
            selected = id; pending = Guid.Empty;
        }
        catch (OperationCanceledException) when (ComponentToken.IsCancellationRequested) { }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { message = ex.Message; }
        finally { busy = false; }
    }
    private async Task StornierenAsync()
    {
        busy = true;
        try
        {
            await using var db = await Factory.CreateDbContextAsync(ComponentToken);
            await new ZyklusTeilnahmeService(db).StornierenAsync(userID, pending, reason, ComponentToken);
            rows = await new ZyklusTeilnahmeService(db).ListeAsync(userID, selected, ComponentToken);
            pending = Guid.Empty; reason = ""; message = "Affectation annulée avec motif. L'historique est conservé.";
        }
        catch (OperationCanceledException) when (ComponentToken.IsCancellationRequested) { }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException) { message = ex.Message; }
        finally { busy = false; }
    }
}
