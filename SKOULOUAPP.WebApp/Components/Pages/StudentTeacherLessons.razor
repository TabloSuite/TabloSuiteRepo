@page "/student/cours"
@attribute [Authorize(Policy = "RequireStudent")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits HalloApp.WebApp.Components.CancelableComponentBase
@using HalloApp.Core.Models.TeacherLessons

<PageTitle>Cours</PageTitle>

<section class="grid gap-6">
    <div class="hallo-hero rounded-[2rem] p-6 text-white shadow-2xl sm:p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-100">Espace enseignant</p>
        <h1 class="mt-3 text-3xl font-black">Supports de ma classe</h1>
        <p class="mt-3 max-w-2xl text-sm leading-7 text-indigo-50">Consulte les supports de cours préparés par ton enseignant pour ta classe actuelle.</p>
    </div>

    @if (lessons is null)
    {
        <SkeletonLoader ShowStatRow="false" />
    }
    else if (lessons.Count == 0)
    {
        <div class="rounded-[2rem] bg-white p-8 text-left shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
            <p class="text-sm font-bold text-slate-900">Aucun support enseignant n'est visible pour le moment.</p>
            <p class="mt-2 text-sm leading-6 text-slate-600">
                Tu peux voir uniquement les cours que ton enseignant a publiés pour les élèves et qui correspondent à ta classe actuelle.
                Si un cours existe mais n'apparaît pas ici, il n'est peut-être pas encore publié pour les élèves, ou il appartient à une autre classe.
            </p>
            <p class="mt-3 rounded-2xl bg-indigo-50 px-4 py-3 text-sm font-semibold text-indigo-800">
                Demande à ton enseignant ou à la direction de vérifier la publication du support et ton affectation de classe.
            </p>
        </div>
    }
    else
    {
        <div class="grid gap-4">
            @foreach (var item in lessons)
            {
                <article class="rounded-3xl bg-white p-5 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 transition duration-200 hover:-translate-y-1 hover:shadow-xl">
                    <button type="button" class="w-full text-left" @onclick="() => OpenLesson(item.Id)">
                        <div class="flex items-center gap-2">
                            <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-bold text-indigo-700">@item.CourseCode</span>
                            <span class="text-xs text-slate-400">@item.PageCount page(s)</span>
                        </div>
                        <h2 class="mt-2 text-lg font-bold text-slate-900">@item.Title</h2>
                        <p class="mt-1 text-sm text-slate-500">@item.Summary</p>
                    </button>
                    <div class="mt-4 flex flex-wrap gap-2 border-t border-slate-100 pt-4">
                        <button type="button" class="inline-flex rounded-full bg-violet-100 px-4 py-2 text-xs font-semibold text-violet-800 transition hover:bg-violet-200" @onclick="() => OpenLesson(item.Id)">Lire la leçon</button>
                        @if (item.IsPdfExportEnabled)
                        {
                            <a class="inline-flex rounded-full bg-cyan-100 px-4 py-2 text-xs font-semibold text-cyan-800 transition hover:bg-cyan-200" href="student/cours/@item.Id/pdf" target="_blank">Exporter PDF</a>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>
