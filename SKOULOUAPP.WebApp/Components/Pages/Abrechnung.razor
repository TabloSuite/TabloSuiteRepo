@page "/abrechnung"
@attribute [Authorize(Roles = "SuperAdmin,SchulLeiter,Koordinator,ProduktOwner")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits SkoulouApp.WebApp.Components.CancelableComponentBase
@using SkoulouApp.Core.DataModels.Schools
@using SkoulouApp.Core.Models.Billing
@using SkoulouApp.Core.Models.Dashboard
@using SkoulouApp.WebApp.Components.Shared

<PageTitle>Facturation SKOULOU</PageTitle>

<section class="grid gap-6">
    @if (!Embedded)
    {
    <div class="skoulou-hero relative overflow-hidden rounded-[1.25rem] px-5 py-4 text-white shadow-2xl sm:px-6 sm:py-5">
        <div class="pointer-events-none absolute -top-20 -right-16 h-56 w-56 rounded-full bg-emerald-400/25 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-16 -left-10 h-48 w-48 rounded-full bg-cyan-400/20 blur-3xl"></div>
        <div class="relative">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-200">@(isProduktOwner ? "Responsable produit" : isKoordinator ? "Coordinateur" : isReadOnly ? "Directeur" : "Administrateur")</p>
            <h1 class="mt-3 text-3xl font-black">Facturation SKOULOU</h1>
            <p class="mt-4 max-w-3xl text-sm leading-7 text-slate-300">
                @(isProduktOwner
                    ? "Gérez les facturations des écoles qui vous sont attribuées. Seuls les abonnements de ces écoles sont visibles."
                    : isReadOnly
                    ? "Consultez toutes les facturations SKOULOU de votre école et déclarez les virements effectués."
                    : "Gérez les facturations SKOULOU par école et clôturez une période une fois le paiement reçu.")
            </p>
        </div>
    </div>
    }

    <Toast Message="@message" MessageChanged="v => message = v" Kind="Toast.ToastKind.Success" />
    <Toast Message="@errorMessage" MessageChanged="v => errorMessage = v" Kind="Toast.ToastKind.Error" />

    @if (!schoolsLoaded)
    {
        <div class="rounded-[2rem] bg-white px-6 py-5 text-sm font-semibold text-slate-700 ring-1 ring-slate-100">Chargement des écoles...</div>
    }
    else if (schools.Count == 0)
    {
        <div class="rounded-[2rem] bg-slate-50 px-6 py-5 text-slate-700 ring-1 ring-slate-100">
            <h2 class="text-lg font-black text-slate-900">Aucune école attribuée pour la facturation</h2>
            <p class="mt-2 text-sm leading-6">Aucune école avec accès financier n'est liée à votre compte. Contactez l'administration si vous devriez avoir accès à une école.</p>
        </div>
    }
    else
    {
    @if (isSuperAdmin && ueberfaelligeForderungenAusAktivenKlassen.Count > 0)
    {
        <details class="group rounded-[2rem] border border-rose-200 bg-rose-50 p-5 text-rose-950 shadow-sm sm:p-6">
            <summary class="flex cursor-pointer list-none flex-wrap items-center justify-between gap-4 focus-visible:rounded-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-rose-600">
                <div class="min-w-0 flex-1">
                    <p class="text-xs font-bold uppercase tracking-[0.16em] text-rose-700">Attention requise · @ueberfaelligeForderungenAusAktivenKlassen.Count classe(s)</p>
                    <h2 class="mt-1 text-xl font-black">Cycles actifs et abonnements payés depuis au moins 10 mois</h2>
                    <p class="mt-2 text-sm leading-6 text-rose-900">Facturations encore ouvertes : contactez la direction pour connaître la raison. Afficher les classes concernées.</p>
                </div>
                <div class="flex items-center gap-3">
                    <div class="rounded-2xl bg-white px-4 py-3 text-right ring-1 ring-rose-200">
                        <p class="text-xs font-bold uppercase tracking-wide text-rose-700">Total à facturer</p>
                        <p class="mt-1 text-xl font-black text-rose-800">@ueberfaelligeForderungenAusAktivenKlassen.Sum(forderung => forderung.Plattformforderung).ToString("N0") FCFA</p>
                    </div>
                    <svg aria-hidden="true" class="h-5 w-5 shrink-0 text-rose-700 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" /></svg>
                </div>
            </summary>
            <div class="mt-5 grid gap-2 border-t border-rose-200 pt-4">
                @foreach (var forderung in ueberfaelligeForderungenAusAktivenKlassen)
                {
                    <button type="button" class="flex w-full flex-wrap items-center justify-between gap-3 rounded-2xl bg-white px-4 py-3 text-left text-sm ring-1 ring-rose-100 transition hover:bg-rose-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-rose-600" @onclick="() => SelectSchoolAsync(forderung.SchulID)">
                        <span class="min-w-0"><strong>@forderung.SchulName</strong><span class="block text-slate-600">@forderung.KlasseCode · @forderung.KlasseTitel · paiement le @forderung.AeltesteZahlungAmUtc.ToLocalTime().ToString("dd.MM.yyyy") · @forderung.TageOffen jours</span></span>
                        <span class="font-black text-rose-800">@forderung.Plattformforderung.ToString("N0") FCFA <span class="block font-medium text-slate-500">@forderung.AnzahlAbonnements abonnement(s)</span></span>
                    </button>
                }
            </div>
        </details>
    }

    @if (isSuperAdmin && offeneForderungenAusGeschlossenenKlassen.Count > 0)
    {
        <div class="rounded-[2rem] border border-amber-200 bg-amber-50 p-5 text-amber-950 shadow-sm sm:p-6">
            <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                    <p class="text-xs font-bold uppercase tracking-[0.16em] text-amber-700">À facturer</p>
                    <h2 class="mt-1 text-xl font-black">Abonnements SKOULOU issus de classes clôturées</h2>
                    <p class="mt-2 max-w-3xl text-sm leading-6 text-amber-900">Ces montants restent dus à SKOULOU. Ils ne sont pas encore inclus dans une facturation et aucune part du responsable produit n'est affichée à l'école.</p>
                </div>
                <div class="rounded-2xl bg-white px-4 py-3 text-right ring-1 ring-amber-200">
                    <p class="text-xs font-bold uppercase tracking-wide text-amber-700">Total à facturer</p>
                    <p class="mt-1 text-2xl font-black text-amber-800">@offeneForderungenAusGeschlossenenKlassen.Sum(forderung => forderung.Plattformforderung).ToString("N0") FCFA</p>
                </div>
            </div>
            <div class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl bg-white/80 px-4 py-3 ring-1 ring-amber-100">
                <p class="text-sm font-semibold text-amber-900">Créer une facturation groupée par école pour tous les abonnements affichés.</p>
                <button type="button"
                        class="rounded-xl bg-amber-600 px-4 py-2 text-sm font-black text-white transition hover:bg-amber-700 disabled:cursor-not-allowed disabled:opacity-60"
                        disabled="@isDatabaseActionInProgress"
                        @onclick="SammelabrechnungenAusGeschlossenenKlassenErstellenAsync">
                    Créer les facturations
                </button>
            </div>
            <div class="mt-4 grid gap-2">
                @foreach (var forderung in offeneForderungenAusGeschlossenenKlassen)
                {
                    <button type="button" class="flex flex-wrap items-center justify-between gap-3 rounded-2xl bg-white px-4 py-3 text-left text-sm ring-1 ring-amber-100 transition hover:bg-amber-100" @onclick="() => SelectSchoolAsync(forderung.SchulID)">
                        <span><strong>@forderung.SchulName</strong><span class="text-slate-500"> · @forderung.KlasseCode · @forderung.KlasseTitel · clôturée le @forderung.ZyklusEnde.ToLocalTime().ToString("dd.MM.yyyy")</span></span>
                        <span class="font-black text-amber-800">@forderung.Plattformforderung.ToString("N0") FCFA <span class="font-medium text-slate-500">· @forderung.AnzahlAbonnements abo(s)</span></span>
                    </button>
                }
            </div>
        </div>
    }

    <div class="rounded-[2rem] bg-white p-6 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 sm:p-8" style="@(Embedded || isReadOnly && schools.Count <= 1 ? "display:none" : null)">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
                <p class="text-xs font-bold uppercase tracking-[0.16em] text-cyan-700">Sélection</p>
                <h2 class="text-xl font-black text-slate-900">Écoles <span class="ml-1 rounded-full bg-slate-100 px-2 py-0.5 text-xs font-bold text-slate-600">@schools.Count</span></h2>
            </div>
            @if (schools.Count > 1)
            {
                <input type="search" class="skoulou-input w-full sm:w-72" placeholder="Rechercher une école..." @bind="schoolSearchTerm" @bind:event="oninput" />
            }
        </div>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
            @foreach (var school in GefilterteSchulen)
            {
                <button type="button"
                        class="flex items-center gap-3 rounded-2xl border-2 px-4 py-3 text-left transition duration-200 hover:-translate-y-0.5 hover:shadow-md @(selectedSchoolId == school.SchoolId ? "border-emerald-500 bg-emerald-50/60" : "border-slate-100 hover:border-emerald-200")"
                        @onclick="() => SelectSchoolAsync(school.SchoolId)">
                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-base font-black @(selectedSchoolId == school.SchoolId ? "bg-emerald-500 text-white" : "bg-slate-100 text-slate-600")">@(selectedSchoolId == school.SchoolId ? "✓" : school.Name.Substring(0, 1).ToUpperInvariant())</span>
                    <div class="min-w-0 flex-1">
                        <div class="truncate font-bold text-slate-900">@school.Name</div>
                        <div class="truncate text-sm text-slate-500">@school.City · @school.Country</div>
                    </div>
                    <span class="shrink-0 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">@school.StudentCount élèves</span>
                </button>
            }
            @if (GefilterteSchulen.Count == 0)
            {
                <p class="rounded-2xl bg-slate-50 px-4 py-3 text-sm text-slate-600">Aucune école ne correspond à la recherche.</p>
            }
        </div>
    </div>

    @if (uebersicht is not null)
    {
        @if (darfZahlungMelden && PendingDirectorApprovals.Count > 0)
        {
            <div class="overflow-hidden rounded-[2rem] border border-amber-200 bg-gradient-to-br from-amber-50 to-orange-50 p-5 text-amber-900 shadow-sm sm:p-6">
                <div class="flex items-start gap-3">
                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-amber-100 text-xl shadow-inner" aria-hidden="true">⏳</span>
                    <div>
                        <p class="text-xs font-bold uppercase tracking-[0.16em] text-amber-700">Action requise · Direction</p>
                        <h2 class="text-lg font-black">@PendingDirectorApprovals.Count facturation(s) à valider</h2>
                        <p class="mt-1 text-sm font-medium">Effectuez le virement, puis confirmez-le dans la liste « Facturations de l'école » ci-dessous.</p>
                    </div>
                </div>
                <div class="mt-3 grid gap-2">
                    @foreach (var periode in PendingDirectorApprovals.Take(3))
                    {
                        <div class="rounded-2xl bg-white/80 px-4 py-3 text-sm ring-1 ring-amber-100">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <span class="font-semibold">@SourceLabel(periode)</span>
                                <span>@periode.Umsatz.ToString("N0") FCFA</span>
                            </div>
                            <p class="mt-1 text-xs text-amber-800">Période: @periode.VonUtc.ToLocalTime().ToString("dd.MM.yyyy") - @periode.BisUtc.ToLocalTime().ToString("dd.MM.yyyy")</p>
                        </div>
                    }
                </div>
            </div>
        }

        @if (isSuperAdmin && automatischeOffenePerioden.Count > 0)
        {
            <div class="rounded-[2rem] border border-sky-200 bg-gradient-to-br from-sky-50 to-cyan-50 p-5 text-sky-900 shadow-sm sm:p-6">
                <div class="flex items-start gap-3">
                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-sky-100 text-xl" aria-hidden="true">ℹ️</span>
                    <div>
                        <p class="text-xs font-bold uppercase tracking-[0.16em] text-sky-700">Information automatique</p>
                        <h2 class="text-lg font-black">Facturation générée à la clôture d'un cycle</h2>
                        <p class="mt-1 text-sm text-sky-800">Elle attend la confirmation de virement par l'école. Après réception du paiement, vous pourrez la confirmer définitivement.</p>
                    </div>
                </div>
                <div class="mt-3 grid gap-2">
                    @foreach (var periode in automatischeOffenePerioden)
                    {
                        <div class="rounded-2xl bg-white/80 px-4 py-3 text-sm ring-1 ring-sky-100">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <span class="font-semibold">@uebersicht.SchulName</span>
                                <span>@periode.Umsatz.ToString("N0") FCFA · @periode.AnzahlAbonnements abo(s)</span>
                            </div>
                            <p class="mt-1 text-xs text-sky-700">
                                Créée automatiquement le @((periode.AutomatischErstelltAmUtc ?? periode.ErstelltAmUtc).ToLocalTime().ToString("dd.MM.yyyy HH:mm")) · statut actuel : @StatusLabelFr(periode.Status)
                                @if (periode.Status == AbrechnungStatus.Erstellt)
                                {
                                    <span> · en attente de virement et de confirmation par l'école</span>
                                }
                                else if (periode.Status == AbrechnungStatus.Akzeptiert)
                                {
                                    <span> · virement déclaré par l'école, en attente de confirmation finale de l'Administrateur</span>
                                }
                            </p>
                        </div>
                    }
                </div>
            </div>
        }

        @if (isSuperAdmin && offeneSuperAdminBestaetigungen.Count > 0)
        {
            <div class="rounded-[2rem] border border-emerald-100 bg-emerald-50 p-5 text-emerald-900 shadow-sm">
                <div class="flex flex-wrap items-start justify-between gap-4">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-[0.16em] text-emerald-700">Contrôle bancaire requis</p>
                        <h2 class="mt-1 text-lg font-black">@offeneSuperAdminBestaetigungen.Count paiement(s) à confirmer</h2>
                        <p class="mt-1 text-sm font-semibold">La direction a déclaré le virement. Vérifiez le compte puis marquez chaque facturation comme terminée.</p>
                    </div>
                    <div class="rounded-2xl bg-white px-4 py-3 text-right ring-1 ring-emerald-100">
                        <p class="text-xs font-bold uppercase tracking-wide text-emerald-700">À contrôler</p>
                        <p class="mt-1 text-2xl font-black text-emerald-800">@OffeneSuperAdminBestaetigungenSumme.ToString("N0") FCFA</p>
                    </div>
                </div>
                <div class="mt-4 grid gap-2">
                    @foreach (var periode in offeneSuperAdminBestaetigungen)
                    {
                        <button type="button" class="flex flex-wrap items-center justify-between gap-3 rounded-2xl bg-white px-4 py-3 text-left text-sm ring-1 ring-emerald-100 transition hover:bg-emerald-100" @onclick="() => SelectSchoolAsync(periode.SchulID)">
                            <span><strong>@periode.SchulName</strong><span class="text-slate-500"> · @periode.AnzahlAbonnements abo(s) · créée par @periode.RechnungErstelltVon · virement déclaré par @periode.ZahlungGemeldetVon le @(periode.ZahlungGemeldetAmUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")</span></span>
                            <span class="font-black text-emerald-800">@periode.Umsatz.ToString("N0") FCFA</span>
                        </button>
                    }
                </div>
            </div>
        }

        <div class="rounded-[2rem] bg-white p-6 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 sm:p-8">
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                    <p class="text-xs font-bold uppercase tracking-[0.16em] text-cyan-700">Période ouverte</p>
                    <h2 class="mt-1 text-xl font-black text-slate-900">@uebersicht.SchulName</h2>
                </div>
                <span class="flex flex-wrap items-center gap-2">
                    <button type="button" class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700 ring-1 ring-slate-200 transition hover:bg-slate-200 disabled:opacity-50" disabled="@isDatabaseActionInProgress" @onclick="AktualisierenAsync"><Icon Name="refresh" Groesse="16" /> Actualiser</button>
                    <span class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-600 ring-1 ring-slate-200"><Icon Name="calendar" Groesse="16" /> @uebersicht.VonUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm") → @uebersicht.BisUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                </span>
            </div>

            @if (zyklusVerpflichtungen is not null)
            {
                <section class="mt-4 space-y-3 rounded-2xl bg-indigo-50 p-4 text-slate-900">
                    <h3 class="font-bold">Engagements de l'école par cycle</h3>
                    <div class="grid gap-3 sm:grid-cols-2">
                        <div class="rounded-xl bg-white p-3"><strong>@zyklusVerpflichtungen.VorlaeufigerBetrag.ToString("N0") FCFA</strong><p>Engagement provisoire · @zyklusVerpflichtungen.TeilnehmerAnzahl participation(s) dans les cycles en cours</p></div>
                        <div class="rounded-xl bg-white p-3"><strong>@zyklusVerpflichtungen.OffeneRechnungenBetrag.ToString("N0") FCFA</strong><p>@zyklusVerpflichtungen.OffeneRechnungenAnzahl facture(s) en attente de confirmation du paiement</p></div>
                    </div>
                    <p class="text-sm">Le montant provisoire n'est ni une facture ni un paiement. La clôture crée automatiquement la facture au prix fixé au démarrage. Les départs et comptes bloqués restent comptabilisés ; seules les affectations annulées avec justification sont exclues.</p>
                    <p class="text-sm">Virements déclarés, en attente de vérification bancaire : <strong>@zyklusVerpflichtungen.ZahlungGemeldetBetrag.ToString("N0") FCFA</strong>. L'accès des élèves ne dépend pas du paiement de l'école.</p>
                    @foreach (var cycle in zyklusVerpflichtungen.LaufendeZyklen)
                    {
                        <div class="break-words rounded-xl border border-indigo-100 bg-white p-3">@cycle.Klasse · @cycle.StartDatum.ToString("dd/MM/yyyy") · @cycle.TeilnehmerAnzahl participant(s) × @cycle.PreisProTeilnehmer.ToString("N0") FCFA · <strong>@cycle.Betrag.ToString("N0") FCFA</strong></div>
                    }
                </section>
            }

            @if (CanManageBilling)
            {
            <div class="mt-4 flex flex-wrap items-end gap-3 rounded-2xl bg-slate-50 px-4 py-3 ring-1 ring-slate-100">
                    <div>
                        <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-slate-500">Afficher jusqu’au (date et heure)</label>
                        <div class="flex flex-wrap items-center gap-3">
                            <TailwindDateTimePicker @bind-Value="filterBisLokal" />
                            @if (filterBisLokal is not null)
                            {
                                <button type="button"
                                        class="rounded-full bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-200"
                                        @onclick="ResetFilterAsync">
                                    Jusqu'à maintenant
                                </button>
                            }
                        </div>
                        <p class="mt-1 text-xs text-slate-500">Ce filtre ne clôture pas le cycle de la classe. Sans filtre, les abonnements sont affichés jusqu'à maintenant.</p>
                    </div>
                    <button type="button"
                            class="rounded-full bg-slate-800 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-900"
                            @onclick="ApplyFilterAsync">
                        Filtrer
                    </button>
                </div>
            }

            @if (!CanManageBilling && uebersicht.AnzahlAbonnements == 0)
            {
                <p class="mt-4 flex items-center gap-3 rounded-2xl bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800 ring-1 ring-emerald-100"><span aria-hidden="true"><Icon Name="check" Groesse="16" /> </span>Aucun abonnement en attente de facturation.</p>
            }
            else
            {
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
                <div class="skoulou-hero-badge flex items-center gap-4 rounded-3xl p-5 text-white shadow-lg transition duration-200 hover:-translate-y-1 hover:shadow-xl">
                    <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white/20 text-2xl" aria-hidden="true"><Icon Name="tag" Groesse="16" /> </span>
                    <div>
                        <div class="text-3xl font-black">@uebersicht.AnzahlAbonnements</div>
                        <div class="mt-0.5 text-sm text-indigo-50">Abonnements SKOULOU</div>
                    </div>
                </div>
                <div class="flex items-center gap-4 rounded-3xl bg-gradient-to-br from-emerald-500 to-teal-700 p-5 text-white shadow-lg shadow-emerald-200/60 transition duration-200 hover:-translate-y-1 hover:shadow-xl">
                    <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white/20 text-2xl" aria-hidden="true"><Icon Name="banknote" Groesse="16" /> </span>
                    <div>
                        <div class="text-3xl font-black">@uebersicht.OffenerUmsatz.ToString("N0") FCFA</div>
                        <div class="mt-0.5 text-sm text-emerald-50">Chiffre d'affaires ouvert</div>
                    </div>
                </div>
            </div>
            }

            @if (CanManageBilling && uebersicht.AnzahlAbonnements == 0 && historie.Count == 0)
            {
                <p class="mt-4 rounded-2xl bg-indigo-50 px-4 py-3 text-sm text-indigo-900">Aucun abonnement payé à facturer et aucune facturation enregistrée pour cette école pour le moment.</p>
            }

            <div class="mt-6 flex justify-end">
                @if (CanManageBilling && uebersicht.AnzahlPositionen > 0)
                {
                    <button type="button"
                            class="skoulou-btn-accent rounded-full px-5 py-2.5 text-sm font-semibold disabled:cursor-not-allowed disabled:bg-slate-300"
                            disabled="@(uebersicht.AnzahlPositionen == 0)"
                            @onclick="() => confirmCreateOpen = true">
                        Facturer les anciennes inscriptions uniquement
                    </button>
                }
            </div>
        </div>

        <CollapsibleCard Title="Facturations de l'école"
                         Subtitle="@(historie.Count > 0 ? $"{HistorieInBearbeitungAnzahl} en cours · {HistorieAbgeschlossenAnzahl} terminée(s)" : "Aucune facturation pour le moment")"
                         Icon="receipt"
                         InitiallyExpanded="@(!CanManageBilling)">
            <HeaderRight>
                @if (historie.Count > 0)
                {
                    <Badge Accent="@StatusAccent(historie[0].Status)">@StatusLabelFr(historie[0].Status)</Badge>
                }
            </HeaderRight>
            <ChildContent>
            <div class="mb-4 flex flex-wrap gap-2" role="group" aria-label="Statut des facturations">
                <button type="button" class="rounded-full px-4 py-2 text-sm font-bold transition @(historieNurAbgeschlossene ? "bg-slate-100 text-slate-700 hover:bg-slate-200" : "bg-amber-600 text-white shadow-sm")" aria-pressed="@(!historieNurAbgeschlossene)" @onclick="() => historieNurAbgeschlossene = false">En cours (@HistorieInBearbeitungAnzahl)</button>
                <button type="button" class="rounded-full px-4 py-2 text-sm font-bold transition @(historieNurAbgeschlossene ? "bg-emerald-700 text-white shadow-sm" : "bg-slate-100 text-slate-700 hover:bg-slate-200")" aria-pressed="@historieNurAbgeschlossene" @onclick="() => historieNurAbgeschlossene = true">Terminées (@HistorieAbgeschlossenAnzahl)</button>
            </div>
            <div class="mb-4 flex flex-wrap items-end gap-3 rounded-2xl bg-slate-50 p-4">
                <div>
                    <label class="mb-1 block text-xs font-semibold text-slate-600" for="historie-von">Période : du</label>
                    <input id="historie-von" type="date" class="skoulou-input" @bind="historieVonDatum" @bind:format="yyyy-MM-dd" />
                </div>
                <div>
                    <label class="mb-1 block text-xs font-semibold text-slate-600" for="historie-bis">Au</label>
                    <input id="historie-bis" type="date" class="skoulou-input" @bind="historieBisDatum" @bind:format="yyyy-MM-dd" />
                </div>
                <button type="button" class="rounded-full bg-white px-4 py-2 text-sm font-semibold text-slate-700 ring-1 ring-slate-200 hover:bg-slate-100" @onclick="() => { historieVonDatum = null; historieBisDatum = null; }">Effacer les dates</button>
                <span class="text-xs text-slate-500">@GefilterteHistorie.Count facturation(s) affichée(s)</span>
            </div>
            @if (historieVonDatum > historieBisDatum)
            {
                <p class="mb-3 text-sm text-rose-700">La date de début doit précéder la date de fin.</p>
            }
            @if (historie.Count > 0)
            {
                <div class="grid gap-3">
                    @foreach (var periode in GefilterteHistorie)
                    {
                        <div class="rounded-2xl border border-slate-100 border-l-4 bg-white px-4 py-4 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md @(periode.Status == AbrechnungStatus.Bestaetigt ? "border-l-emerald-500" : periode.Status == AbrechnungStatus.Abgelehnt ? "border-l-rose-500" : "border-l-amber-500")">
                            <div class="flex flex-wrap items-center justify-between gap-3">
                                <div>
                                    <div class="text-xs font-bold uppercase tracking-wide text-slate-400">Période</div>
                                    <div class="text-sm font-semibold text-slate-700">@periode.VonUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm") – @periode.BisUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                                </div>
                                <div class="flex flex-wrap items-center gap-3 text-sm">
                                    <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-semibold text-indigo-700">@periode.AnzahlAbonnements abo(s)</span>
                                    <span class="text-lg font-black text-slate-900">@periode.Umsatz.ToString("N0") FCFA</span>
                                     <Badge Accent="@StatusAccent(periode.Status)">@StatusLabelFr(periode.Status)</Badge>
                                    <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-600">@SourceLabel(periode)</span>
                                </div>
                            </div>

                            <p class="mt-2 text-xs font-semibold text-slate-500">
                                @if (periode.Status == AbrechnungStatus.Erstellt)
                                {
                                    <span>En attente de la déclaration de virement par l'école.</span>
                                }
                                else if (periode.Status == AbrechnungStatus.Akzeptiert)
                                {
                                    <span>Virement déclaré le @periode.SchulLeiterReaktionAmUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · en attente du contrôle bancaire de l'Administrateur.</span>
                                }
                                else if (periode.Status == AbrechnungStatus.Bestaetigt)
                                {
                                    <span>Terminé · réception confirmée par l'Administrateur le @periode.BestaetigtAmUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm").</span>
                                }
                            </p>

                            @if (periode.AutomatischDurchKlassenabschlussErstellt)
                            {
                                <p class="mt-2 rounded-lg bg-sky-50 px-3 py-2 text-xs font-semibold text-sky-700 ring-1 ring-sky-100">
                                    @if (isSuperAdmin)
                                    {
                                        @if (periode.Status == AbrechnungStatus.Erstellt)
                                        {
                                            <span>Générée automatiquement lors d'une clôture de cycle. Elle attend le virement et la confirmation de l'école. Après réception du paiement, l'Administrateur pourra la confirmer définitivement.</span>
                                        }
                                        else if (periode.Status == AbrechnungStatus.Akzeptiert)
                                        {
                                            <span>Générée automatiquement lors d'une clôture de cycle. L'école a déclaré le virement effectué; après réception du paiement, l'Administrateur peut la confirmer définitivement.</span>
                                        }
                                        else
                                        {
                                            <span>Générée automatiquement lors d'une clôture de cycle. Le processus normal reste nécessaire.</span>
                                        }
                                    }
                                    else if (!isProduktOwner)
                                    {
                                        @if (periode.Status == AbrechnungStatus.Erstellt)
                                        {
                                            <span>Cette facturation a été générée automatiquement lors de la clôture du cycle pour un montant total de @periode.Umsatz.ToString("N0") FCFA. Après avoir effectué le virement, confirmez-la ici avec « Accepter &amp; virement effectué ».</span>
                                        }
                                        else if (periode.Status == AbrechnungStatus.Akzeptiert)
                                        {
                                            <span>Cette facturation a été générée automatiquement lors de la clôture du cycle pour un montant total de @periode.Umsatz.ToString("N0") FCFA. Le virement a été déclaré effectué; elle attend maintenant la confirmation finale de l'Administrateur.</span>
                                        }
                                        else
                                        {
                                            <span>Cette facturation a été générée automatiquement lors de la clôture du cycle. Le processus normal reste nécessaire.</span>
                                        }
                                    }
                                </p>
                            }

                            @if (periode.Status == AbrechnungStatus.Abgelehnt && !string.IsNullOrWhiteSpace(periode.AblehnungsGrund))
                            {
                                <p class="mt-2 rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700 ring-1 ring-rose-100">
                                    Motif du refus : @periode.AblehnungsGrund
                                </p>
                            }

                            <div class="mt-3 flex flex-wrap justify-end gap-2">
                                @if (CanManageBilling && periode.Status == AbrechnungStatus.Erstellt
                                    && !periode.AutomatischDurchKlassenabschlussErstellt
                                    && !periode.IstSammelabrechnungAusGeschlossenenKlassen)
                                {
                                    <button type="button"
                                            class="rounded-full border border-cyan-200 bg-cyan-50 px-4 py-2 text-xs font-semibold text-cyan-800 transition hover:bg-cyan-100 disabled:cursor-not-allowed disabled:opacity-50"
                                            disabled="@isDatabaseActionInProgress"
                                            @onclick="() => RenvoyerFacturationAsync(periode.Id)">
                                        Renvoyer l'e-mail
                                    </button>
                                }
                                @if (isSuperAdmin && periode.Status == AbrechnungStatus.Akzeptiert)
                                {
                                    <button type="button"
                                            class="skoulou-btn-accent rounded-full px-4 py-2 text-xs font-semibold"
                                            @onclick="() => confirmPeriodId = periode.Id">
                                        Marquer comme payé (compte reçu)
                                    </button>
                                }
                                @if (darfZahlungMelden && periode.Status != AbrechnungStatus.Bestaetigt)
                                {
                                    @if (periode.Status != AbrechnungStatus.Akzeptiert)
                                    {
                                        <button type="button"
                                                class="skoulou-btn-accent rounded-full px-4 py-2 text-xs font-semibold"
                                                @onclick="() => AcceptAsync(periode.Id)">
                                            Accepter &amp; virement effectué
                                        </button>
                                    }
                                    @if (periode.Status == AbrechnungStatus.Erstellt)
                                    {
                                        <button type="button"
                                                class="rounded-full bg-rose-100 px-4 py-2 text-xs font-semibold text-rose-700 transition hover:bg-rose-200"
                                                @onclick="() => { rejectPeriodId = periode.Id; rejectReason = string.Empty; }">
                                            Refuser
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }
                    @if (GefilterteHistorie.Count == 0)
                    {
                        <p class="rounded-xl bg-slate-50 px-4 py-3 text-sm text-slate-600">Aucune facturation dans cette vue. Vérifiez les dates ou changez de statut.</p>
                    }
                </div>
            }
            else
            {
                <p class="rounded-2xl bg-slate-50 px-4 py-6 text-center text-sm text-slate-500 ring-1 ring-slate-100">
                    @(isReadOnly && !isProduktOwner
                        ? "Aucune facturation n'a encore été créée pour votre école."
                        : "Aucune facturation créée pour le moment. Créez la première facturation à partir de la période ouverte ci-dessus.")
                </p>
            }
            </ChildContent>
        </CollapsibleCard>
    }
    }
</section>

<ModalDialog @bind-Open="confirmCreateOpen"
             Title="Créer la facturation"
             Eyebrow="Confirmation"
             ErrorMessage="@errorMessage"
             MaxWidthClass="max-w-lg">
    <p class="text-sm leading-6 text-slate-600">
        Créer la facturation de la période ouverte pour
        <span class="font-semibold text-slate-900">@uebersicht?.SchulName</span> ?
        Seuls les abonnements SKOULOU payés seront regroupés et envoyés au directeur pour validation.
    </p>
    <div class="mt-6 flex justify-end gap-3">
        <button type="button"
                class="rounded-full bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-200"
                @onclick="() => confirmCreateOpen = false">
            Annuler
        </button>
                    <AsyncActionButton Class="skoulou-btn-accent rounded-full px-5 py-2.5 text-sm font-semibold disabled:opacity-50"
                                       IsBusy="@isDatabaseActionInProgress"
                                       BusyLabel="Création..."
                                       OnClick="@(_ => ConfirmCreateAsync())">
            Créer
                    </AsyncActionButton>
    </div>
</ModalDialog>

<ModalDialog Open="confirmPeriodId is not null"
             OpenChanged="v => { if (!v) confirmPeriodId = null; }"
             Title="Confirmer la facturation"
             Eyebrow="Action définitive"
             ErrorMessage="@errorMessage"
             MaxWidthClass="max-w-lg">
    <p class="text-sm leading-6 text-slate-600">
        Confirmez-vous que le virement a bien été reçu ? La facturation sera clôturée définitivement
        et ne pourra plus être modifiée.
    </p>
    <div class="mt-6 flex justify-end gap-3">
        <button type="button"
                class="rounded-full bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-200"
                @onclick="() => confirmPeriodId = null">
            Annuler
        </button>
        <AsyncActionButton Class="skoulou-btn-accent rounded-full px-5 py-2.5 text-sm font-semibold disabled:opacity-50"
                           IsBusy="@isDatabaseActionInProgress"
                           BusyLabel="Confirmation..."
                           OnClick="@(_ => ConfirmBestaetigenAsync())">
            Confirmer
        </AsyncActionButton>
    </div>
</ModalDialog>

<ModalDialog Open="rejectPeriodId is not null"
             OpenChanged="v => { if (!v) { rejectPeriodId = null; rejectReason = string.Empty; } }"
             Title="Refuser la facturation"
             Eyebrow="Motif requis"
             ErrorMessage="@errorMessage"
             MaxWidthClass="max-w-lg">
    <p class="text-sm leading-6 text-slate-600">
        Indiquez le motif du refus. Le statut pourra être modifié plus tard une fois la situation clarifiée.
    </p>
    <textarea @bind="rejectReason" rows="3"
              class="skoulou-input mt-4 text-sm"
              placeholder="Motif du refus..."></textarea>
    <div class="mt-6 flex justify-end gap-3">
        <button type="button"
                class="rounded-full bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-200"
                @onclick="() => { rejectPeriodId = null; rejectReason = string.Empty; }">
            Annuler
        </button>
        <AsyncActionButton Class="rounded-full bg-rose-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-rose-700 disabled:cursor-not-allowed disabled:bg-slate-300"
                           Disabled="@string.IsNullOrWhiteSpace(rejectReason)"
                           IsBusy="@isDatabaseActionInProgress"
                           BusyLabel="Refus..."
                           OnClick="@(_ => ConfirmRejectAsync())">
            Refuser
        </AsyncActionButton>
    </div>
</ModalDialog>
