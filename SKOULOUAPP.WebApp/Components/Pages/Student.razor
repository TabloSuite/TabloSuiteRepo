@page "/student"
@attribute [Authorize(Policy = "RequireStudent")]
@inherits SkoulouApp.WebApp.Components.CancelableComponentBase

<PageTitle>Espace élève · SKOULOU</PageTitle>

@if (dashboard is null)
{
    <SkeletonLoader CardCount="3" />
}
else
{
    <div class="student-dashboard-page grid gap-5">
        <SeitenKopf Rubrik="Espace élève" Titel="@($"Bienvenue, {dashboard.FullName}")" IconName="graduation"
                    Untertitel="@($"{dashboard.SchoolName} · {KlassenLabel} actuelle : {CurrentClassDisplay}")">
            <a class="sk-btn sk-btn-hero" href="/student/lessons">
                <Icon Name="book-open" Groesse="16" />Leçons
                @if (openLessonsCount > 0)
                {
                    <span class="rounded-full bg-white px-2 py-0.5 text-xs font-bold tabular-nums text-blue-800" aria-label="@($"{openLessonsCount} leçons à terminer")">@openLessonsCount</span>
                }
            </a>
            <a class="sk-btn sk-btn-hero" href="/student/exams">
                <Icon Name="exam" Groesse="16" />Examens
                @if (openExamsCount > 0)
                {
                    <span class="rounded-full bg-white px-2 py-0.5 text-xs font-bold tabular-nums text-blue-800" aria-label="@($"{openExamsCount} examens à passer")">@openExamsCount</span>
                }
            </a>
        </SeitenKopf>

        <div class="flex flex-wrap items-center gap-2 text-sm">
            <span class="inline-flex items-center gap-2 rounded-full border px-3 py-1.5 font-semibold @ClassCycleHintAccentClass"><Icon Name="sparkles" Groesse="16" />@ClassCycleHintText</span>
            @if (HasOpenItemsHint)
            {
                <span class="inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-3 py-1.5 font-semibold text-amber-900"><Icon Name="clock" Groesse="16" />@OpenItemsHintText</span>
            }
            @if (dashboard.StreakDays >= 2)
            {
                <span class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1.5 font-semibold text-emerald-800"><Icon Name="trend-up" Groesse="16" />@dashboard.StreakDays jours de suite</span>
            }
            <span class="text-slate-500">@LastActivityText</span>
        </div>

        <section class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4" aria-label="Ma progression">
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
                <span class="flex items-center justify-between gap-2 text-sm font-semibold text-slate-500">Score<span class="grid h-9 w-9 place-items-center rounded-xl bg-blue-50 text-blue-700"><Icon Name="star" Groesse="18" /></span></span>
                @if (dashboard.CombinedScorePercent.HasValue)
                {
                    <strong class="mt-2 block text-3xl font-extrabold tabular-nums" style="color:@ScoreColorHelper.GetScoreColor(dashboard.CombinedScorePercent.Value)">@dashboard.CombinedScorePercent %</strong>
                    <span class="text-xs text-slate-500">sur @dashboard.CombinedScoreCount résultat@(dashboard.CombinedScoreCount > 1 ? "s" : "")</span>
                }
                else
                {
                    <strong class="mt-2 block text-3xl font-extrabold text-slate-300">–</strong>
                    <span class="text-xs text-slate-500">Pas encore de résultat</span>
                }
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
                <span class="flex items-center justify-between gap-2 text-sm font-semibold text-slate-500">Leçons terminées<span class="grid h-9 w-9 place-items-center rounded-xl bg-teal-50 text-teal-700"><Icon Name="book-open" Groesse="18" /></span></span>
                <strong class="mt-2 block text-3xl font-extrabold tabular-nums text-slate-900">@dashboard.CompletedLessonsCount</strong>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
                <span class="flex items-center justify-between gap-2 text-sm font-semibold text-slate-500">Exercices<span class="grid h-9 w-9 place-items-center rounded-xl bg-emerald-50 text-emerald-700"><Icon Name="pen" Groesse="18" /></span></span>
                <strong class="mt-2 block text-3xl font-extrabold tabular-nums text-slate-900">@(dashboard.ExercisePointsTotal > 0 ? dashboard.ExercisePointsEarned.ToString() : "–")</strong>
                @if (dashboard.ExercisePointsTotal > 0)
                {
                    <span class="text-xs text-slate-500">sur @dashboard.ExercisePointsTotal points</span>
                }
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
                <span class="flex items-center justify-between gap-2 text-sm font-semibold text-slate-500">Examens<span class="grid h-9 w-9 place-items-center rounded-xl bg-amber-50 text-amber-700"><Icon Name="exam" Groesse="18" /></span></span>
                <strong class="mt-2 block text-3xl font-extrabold tabular-nums text-slate-900">@(dashboard.ExamPointsTotal > 0 ? dashboard.ExamPointsEarned.ToString() : "–")</strong>
                @if (dashboard.ExamPointsTotal > 0)
                {
                    <span class="text-xs text-slate-500">sur @dashboard.ExamPointsTotal points</span>
                }
            </div>
        </section>

        <Abschnitt Titel="Ma classe" Untertitel="Les leçons, résultats et supports disponibles pour votre classe." IconName="layers">
            @if (CurrentClassCard is null)
            {
                <p class="mb-0 text-sm text-slate-500">@ClassHistoryEmptyMessage</p>
            }
            else
            {
                var course = CurrentClassCard;
                <div class="grid gap-4">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div>
                            <h3 class="mb-0 text-lg font-bold text-slate-900">@FormatClasseLabel(course.CourseCode, course.CourseTitle)</h3>
                            <p class="mb-0 mt-0.5 text-sm text-slate-500">Compte @(dashboard.IsBlocked ? "bloqué" : "validé") · @ClassCycleBadgeText</p>
                        </div>
                        <Badge Accent="@(dashboard.IsBlocked ? "rose" : "emerald")">@(dashboard.IsBlocked ? "Bloqué" : "Classe actuelle")</Badge>
                    </div>

                    <dl class="m-0 grid grid-cols-3 gap-3 text-center">
                        <div class="rounded-xl bg-slate-50 px-3 py-2.5"><dt class="text-xs font-semibold text-slate-500">Leçons</dt><dd class="m-0 text-xl font-extrabold tabular-nums text-slate-900">@course.LessonCount</dd></div>
                        <div class="rounded-xl bg-slate-50 px-3 py-2.5"><dt class="text-xs font-semibold text-slate-500">Exercices</dt><dd class="m-0 text-xl font-extrabold tabular-nums text-slate-900">@course.ExerciseCount</dd></div>
                        <div class="rounded-xl bg-slate-50 px-3 py-2.5"><dt class="text-xs font-semibold text-slate-500">Épreuves</dt><dd class="m-0 text-xl font-extrabold tabular-nums text-slate-900">@course.ExamCount</dd></div>
                    </dl>

                    <p class="mb-0 text-sm">
                        <span class="font-semibold text-slate-700">Résultats :</span>
                        @if (CurrentClassHistory?.ScorePercent is int scorePercent)
                        {
                            <span class="ml-1 font-bold" style="color:@ScoreColorHelper.GetScoreColor(scorePercent)">@scorePercent %</span>
                            <span class="ml-1 text-slate-500">sur @CurrentClassHistory.ScoreCount épreuve@(CurrentClassHistory.ScoreCount > 1 ? "s" : "")</span>
                        }
                        else
                        {
                            <span class="ml-1 text-slate-500">aucun résultat pour le moment</span>
                        }
                    </p>

                    @if (CurrentClassHistory is not null && !string.IsNullOrWhiteSpace(CurrentClassHistory.AbschlussNoteText))
                    {
                        <p class="mb-0 rounded-xl bg-blue-50 px-4 py-3 text-sm text-blue-900">Note finale : <strong>@CurrentClassHistory.AbschlussNoteText</strong> · @(CurrentClassHistory.IsBestanden == true ? "Réussi" : CurrentClassHistory.IsBestanden == false ? "Non réussi" : "Décision en attente")</p>
                    }

                    @if (CurrentClassHistory is not null && CurrentClassHistory.TeacherLessons.Count > 0)
                    {
                        <div>
                            <p class="mb-2 text-sm font-semibold text-slate-700">Supports de cours de vos enseignants</p>
                            <ul class="sk-liste-scroll m-0 grid list-none gap-2 p-0 sm:grid-cols-2">
                                @foreach (var lesson in CurrentClassHistory.TeacherLessons)
                                {
                                    <li>
                                        <a class="flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-800 no-underline transition hover:border-blue-200 hover:text-blue-700" href="/student/lessons/support/@lesson.Id">
                                            <span class="flex items-center gap-2"><Icon Name="book" Groesse="16" />@lesson.Title</span>
                                            <span class="text-xs font-normal text-slate-500">@lesson.PageCount page(s)</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    <div>
                        @if (course.IsUnlocked)
                        {
                            <a class="sk-btn sk-btn-primary" href="/student/lessons"><Icon Name="book-open" Groesse="16" />Ouvrir les leçons de la classe</a>
                        }
                        else
                        {
                            <span class="sk-btn sk-btn-secondary" aria-disabled="true" title="Cette classe n'est pas encore débloquée"><Icon Name="lock" Groesse="16" />Classe verrouillée</span>
                        }
                    </div>
                </div>
            }
        </Abschnitt>

        <Abschnitt Titel="Mes classes précédentes" Untertitel="Score, note finale et supports de cours de vos anciennes classes." IconName="history">
            @if (OtherClasses.Count > 0)
            {
                <div class="sk-liste-scroll grid gap-3 p-1 lg:grid-cols-2">
                    @foreach (var course in OtherClasses)
                    {
                        <article class="rounded-2xl border border-slate-200 p-4">
                            <div class="flex flex-wrap items-start justify-between gap-3">
                                <div>
                                    <h3 class="mb-0 text-base font-bold text-slate-900">@FormatClasseLabel(course.CourseCode, course.CourseTitle)</h3>
                                    <p class="mb-0 mt-0.5 text-xs text-slate-500">Cycle du @course.StartDatum.ToLocalTime().ToString("dd/MM/yyyy") au @(course.EndDatum?.ToLocalTime().ToString("dd/MM/yyyy") ?? "en cours")</p>
                                </div>
                                <Badge Accent="slate">Terminée</Badge>
                            </div>
                            <p class="mb-0 mt-3 text-sm">
                                <span class="font-semibold text-slate-700">Résultats :</span>
                                @if (course.ScorePercent.HasValue)
                                {
                                    <span class="ml-1 font-bold" style="color:@ScoreColorHelper.GetScoreColor(course.ScorePercent.Value)">@course.ScorePercent %</span>
                                    <span class="ml-1 text-slate-500">sur @course.ScoreCount épreuve@(course.ScoreCount > 1 ? "s" : "")</span>
                                }
                                else
                                {
                                    <span class="ml-1 text-slate-500">aucun résultat</span>
                                }
                            </p>
                            @if (!string.IsNullOrWhiteSpace(course.AbschlussNoteText))
                            {
                                <p class="mb-0 mt-2 rounded-xl px-3 py-2 text-sm @(course.IsBestanden == false ? "bg-rose-50 text-rose-800" : "bg-blue-50 text-blue-900")">Note finale : <strong>@course.AbschlussNoteText</strong> · <strong>@(course.IsBestanden == true ? "Réussi" : course.IsBestanden == false ? "Non réussi" : "Décision en attente")</strong>@if (!string.IsNullOrWhiteSpace(course.MentionText)) { <span> · Mention : <strong>@course.MentionText</strong></span> }</p>
                            }
                            @if (course.TeacherLessons.Count > 0)
                            {
                                <ul class="mb-0 mt-3 grid max-h-64 list-none gap-2 overflow-y-auto p-0">
                                    @foreach (var lesson in course.TeacherLessons)
                                    {
                                        <li>
                                            <a class="flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-800 no-underline hover:border-blue-200 hover:text-blue-700" href="/student/lessons/support/@lesson.Id">
                                                <span>@lesson.Title</span>
                                                <span class="text-xs font-normal text-slate-500">@lesson.PageCount page(s)</span>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            }
                        </article>
                    }
                </div>
            }
            else
            {
                <p class="mb-0 text-sm text-slate-500">Vos classes précédentes s'afficheront ici dès la fin d'un cycle : score, note finale et supports de cours.</p>
            }
        </Abschnitt>

        <section class="grid gap-3 sm:grid-cols-3" aria-label="Prochaines étapes">
            @foreach (var (nr, titel, text) in Schritte)
            {
                <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                    <span class="grid h-7 w-7 place-items-center rounded-full bg-blue-700 text-xs font-bold text-white">@nr</span>
                    <p class="mb-0 mt-2 text-sm font-bold text-slate-900">@titel</p>
                    <p class="mb-0 mt-1 text-sm text-slate-600">@text</p>
                </div>
            }
        </section>
    </div>
}

@code {
    private static readonly (int Nr, string Titel, string Text)[] Schritte =
    [
        (1, "Étudiez les leçons", "Travaillez les leçons de votre classe dans l'ordre."),
        (2, "Faites les exercices", "Résolvez les exercices de chaque leçon pour progresser."),
        (3, "Passez les épreuves", "Dès qu'un enseignant vous assigne une épreuve, vous pouvez la passer quand vous voulez.")
    ];
}
