                                            <span class="font-black" style="color:@ScoreColorHelper.GetScoreColor(user.CombinedScorePercent.Value)">@user.CombinedScorePercent %</span>
                                            <span class="text-xs text-slate-400">(@user.CombinedScoreCount)</span>
