                                    <Badge Accent="@(user.IsBlocked ? "rose" : "emerald")">@(user.IsBlocked ? "Compte bloqué" : "Compte actif")</Badge>
                                    @if (!isProduktOwner && user.RoleName == "Schüler" && !user.IsBlocked)
                                    {
                                        <Badge Accent="emerald">Enregistrement validé</Badge>
