                                            {
                                                <Badge Accent="@(user.IsSchoolFeeFullyPaid ? "emerald" : user.SchoolFeePaidAmount > 0m ? "cyan" : "amber")">@GetSchoolFeeHeaderLabel(user.SchoolFeePaidAmount, user.SchoolFeeAmount, user.HasActiveSchoolFeeCycle)</Badge>
