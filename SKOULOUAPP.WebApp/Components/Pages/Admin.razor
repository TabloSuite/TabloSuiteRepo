                                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487a2.25 2.25 0 1 1 3.182 3.182L8.25 19.463 4.5 20.25l.787-3.75L16.862 4.487z" />
                                    </svg>
                                    Voir les données
                                </button>
                            @if (user.IsBlocked)
                            {
                                <button type="button" class="inline-flex items-center gap-2 rounded-full bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-emerald-700 hover:shadow-md" @onclick="() => SetUserBlockedAsync(user.UserId, false)">
                                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                                    Activer
                                </button>
                            }
                            else
                            {
                                <button type="button" class="inline-flex items-center gap-2 rounded-full bg-rose-600 px-3 py-1.5 text-xs font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-rose-700 hover:shadow-md" @onclick="() => SetUserBlockedAsync(user.UserId, true)">
                                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636" /></svg>
                                    Bloquer
                                </button>
                            }
                            @if (!isProduktOwner && IsDevelopment && user.RoleName == "SchulLeiter")
                            {
                                <button type="button"
                                        class="inline-flex items-center gap-2 rounded-full bg-rose-950 px-4 py-2 text-sm font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-rose-900 hover:shadow-md"
                                        @onclick="() => RequestHardDeleteSchoolLeader(user)">
                                    Supprimer définitivement (test)
                                </button>
                            }
                        </div>
                        @if (!isProduktOwner && user.RoleName == "Schüler")
                        {
                            <div class="mt-4">
                                <button type="button"
                                        class="inline-flex items-center gap-1.5 rounded-full bg-cyan-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-cyan-700"
                                        @onclick="() => ToggleEnrollmentPanelAsync(user.UserId)">
                                    Abonnements &amp; paiements
                                    <svg class="h-4 w-4 transition-transform duration-200 @(expandedEnrollmentStudentId == user.UserId ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
                                </button>

                                @if (expandedEnrollmentStudentId == user.UserId)
                                {
                                    <div class="mt-4 grid gap-2">
                                        @foreach (var level in levelEnrollments.Where(l => l.IsUnlocked || !l.IsUnlocked && !l.IsPaid))
                                        {
                                            <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl bg-slate-50 px-4 py-3">
                                                <div>
                                                    <span class="font-semibold text-slate-800">@level.CourseCode</span>
                                                    <span class="text-sm text-slate-500">@level.CourseTitle</span>
                                                </div>
                                                <div class="flex flex-wrap items-center gap-2">
                                                    <Badge Accent="cyan">SKOULOUAPP</Badge>
                                                    @if (!level.IsUnlocked)
                                                    {
                                                        <Badge Accent="slate">Désactivé</Badge>
                                                    }
                                                    @if (level.IsPaid)
                                                    {
                                                        <Badge Accent="emerald">Paiement effectué</Badge>
                                                    }
                                                    @if (level.IstAbgerechnet)
                                                    {
                                                        <Badge Accent="slate">Facturé</Badge>
                                                    }
                                                    @if (level.IsUnlocked && !level.IstAbgerechnet)
{
    <button type="button"
            class="rounded-full bg-slate-700 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-slate-800"
            @onclick="() => RequestRemoveAbo(user.UserId, level)">
        Annuler l'abonnement
    </button>
    <button type="button"
            class="rounded-full bg-rose-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-rose-700"
            @onclick="() => RequestRemoveAboAndClass(user.UserId, level)">
        Annuler et retirer de la classe
    </button>
}
                                                </div>
                                            </div>
                                        }
                                        @if (!levelEnrollments.Any(l => l.IsUnlocked || !l.IsUnlocked && !l.IsPaid))
                                        {
                                            <p class="text-sm text-slate-500">Aucun niveau débloqué pour cet élève.</p>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </article>
                            }
                        </div>
                    </DataListPanel>
                </div>
                </div>
                </ChildContent>
            </CollapsibleCard>

            @* Medien werden für SuperAdmin/ProductOwner unten anstelle des Klassen-/Niveau-Blocks angezeigt. *@

        <CollapsibleCard Title="Bibliothèque de médias"
                 Eyebrow="Médias par école"
                 Icon="???"
                 Accent="amber"
                 Expanded="mediaExpanded"
                 ExpandedChanged="v => mediaExpanded = v">
            <HeaderRight>
                <Badge Accent="amber">@FilteredMediaLibraryItems.Count / @mediaLibraryItems.Count médias · @FormatFileSize(FilteredMediaBytes)</Badge>
            </HeaderRight>
            <ChildContent>
            <div class="mt-6 grid gap-4 rounded-3xl bg-amber-50/60 p-4 lg:grid-cols-[1fr_auto]">
                <div class="grid gap-3 sm:grid-cols-3">
                    <div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-amber-100">
                        <p class="text-xs font-black uppercase tracking-wide text-amber-700">Total médias</p>
                        <p class="mt-2 text-2xl font-black text-slate-900">@mediaLibraryItems.Count</p>
                        <p class="text-xs font-semibold text-slate-500">@FormatFileSize(TotalMediaBytes)</p>
                    </div>
                    <div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-cyan-100">
                        <p class="text-xs font-black uppercase tracking-wide text-cyan-700">Filtre actuel</p>
                        <p class="mt-2 text-2xl font-black text-slate-900">@FilteredMediaLibraryItems.Count</p>
                        <p class="text-xs font-semibold text-slate-500">@FormatFileSize(FilteredMediaBytes)</p>
                    </div>
                    <div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-100">
                        <p class="text-xs font-black uppercase tracking-wide text-slate-500">Écoles</p>
                        <p class="mt-2 text-2xl font-black text-slate-900">@MediaSchoolFilterOptions.Count(option => option.Value.HasValue)</p>
                        <p class="text-xs font-semibold text-slate-500">avec médias enregistrés</p>
                    </div>
                </div>
                <div class="min-w-72">
                    <ModernDropdown TValue="Guid?" Label="Filtrer par école" Value="mediaSchoolFilter" ValueChanged="SetMediaSchoolFilterAsync" Options="MediaSchoolFilterOptions" />
                </div>
            </div>

            <div class="mt-6">
                <DataListPanel Items="FilteredMediaLibraryItems"
                               PageSize="12"
                               SearchPlaceholder="Rechercher un média, une école, une classe..."
                               EmptyText="Aucun média trouvé."
                               ResultLabelSingular="média"
                               ResultLabelPlural="médias"
                               Filter="@((MediaLibraryItem m, string term) => Contains(m.DisplayName, term) || Contains(m.OriginalFileName, term) || Contains(m.RelativePath, term) || Contains(m.SchoolName, term) || Contains(m.KlasseCode, term) || Contains(m.ContentType, term) || Contains(m.AltText, term))">
                    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                        @foreach (var media in context)
                        {
                            <article class="rounded-3xl border border-amber-100 bg-white p-5 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-amber-300 hover:shadow-lg">
                                <div class="flex flex-wrap items-start justify-between gap-3">
                                    <div class="min-w-0">
                                        <p class="text-xs font-black uppercase tracking-wide text-amber-700">@media.SchoolName</p>
                                        <h3 class="mt-1 truncate text-lg font-bold text-slate-900">@(string.IsNullOrWhiteSpace(media.DisplayName) ? media.OriginalFileName : media.DisplayName)</h3>
                                        <p class="mt-1 truncate text-xs text-slate-400">@media.OriginalFileName</p>
                                    </div>
                                    <Badge Accent="slate">@FormatFileSize(media.Length)</Badge>
                                </div>
                                <div class="mt-4 grid gap-2 text-sm">
                                    <div class="flex items-center justify-between rounded-2xl bg-slate-50 px-3 py-2"><span class="text-slate-500">Type</span><span class="font-semibold text-slate-800">@media.ContentType</span></div>
                                    <div class="flex items-center justify-between rounded-2xl bg-slate-50 px-3 py-2"><span class="text-slate-500">Classe</span><span class="font-semibold text-slate-800">@(string.IsNullOrWhiteSpace(media.KlasseCode) ? "Sans classe" : media.KlasseCode)</span></div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(media.AltText))
                                {
                                    <p class="mt-3 line-clamp-2 text-sm text-slate-600">@media.AltText</p>
                                }
                                <p class="mt-3 truncate text-[11px] font-semibold text-amber-700">@media.RelativePath</p>
                            </article>
                        }
                    </div>
                </DataListPanel>
            </div>
            </ChildContent>
        </CollapsibleCard>

        <div class="hidden">

            <ModalDialog Open="courseModalOpen"
                         OpenChanged="OnCourseModalOpenChanged"
                         Title="@courseModalTitle"
                         Eyebrow="Gestion des classes et niveaux"
                         ErrorMessage="@courseErrorMessage"
                         MaxWidthClass="max-w-2xl">
                <EditForm Model="courseForm" OnValidSubmit="SaveCourseAsync" FormName="admin-course-form" class="grid gap-4">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="grid gap-4 xl:grid-cols-2">
                        <div>
                            <label class="skoulou-label">Nom du niveau</label>
                            <InputText @bind-Value="courseForm.Code" class="skoulou-input" />
                        </div>
                        <div>
                            <label class="skoulou-label">Titre</label>
                            <InputText @bind-Value="courseForm.Title" class="skoulou-input" />
                        </div>
                    </div>
                    <div>
                        <label class="skoulou-label">Description</label>
                        <InputTextArea @bind-Value="courseForm.Description" class="skoulou-input min-h-28" />
                    </div>
                    <div class="grid gap-4 xl:grid-cols-2">
                        <div>
                            <label class="skoulou-label">Leçons recommandées</label>
                            <InputNumber @bind-Value="courseForm.RecommendedLessonCount" class="skoulou-input" />
                        </div>
                        <div>
                            <label class="skoulou-label">Prix du niveau (FCFA)</label>
                            <InputNumber @bind-Value="courseForm.Price" class="skoulou-input" />
                        </div>
                    </div>
                    <div class="flex flex-wrap justify-end gap-3">
                        <button type="button" class="rounded-full bg-slate-100 px-5 py-3 text-sm font-semibold text-slate-900 transition duration-200 hover:bg-slate-200 disabled:cursor-not-allowed disabled:opacity-60" disabled="@isDatabaseActionInProgress" @onclick="CloseCourseModal">Annuler</button>
                        <AsyncActionButton Type="submit" Class="rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-lg disabled:opacity-50" IsBusy="@isDatabaseActionInProgress" BusyLabel="Enregistrement...">@(courseForm.CourseId.HasValue ? "Enregistrer la classe / le niveau" : "Créer la classe / le niveau")</AsyncActionButton>
                    </div>
                </EditForm>
            </ModalDialog>

            <ModalDialog Open="lessonModalOpen"
                         OpenChanged="OnLessonModalOpenChanged"
                         Title="@lessonModalTitle"
                         Eyebrow="Gestion des leçons"
                         MaxWidthClass="max-w-2xl">
                <EditForm Model="lessonForm" OnValidSubmit="SaveLessonAsync" FormName="admin-lesson-form" class="grid gap-4">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div>
                        <ModernDropdown TValue="Guid?" Label="Classe / niveau" Value="lessonForm.CourseId" ValueChanged="SetLessonCourseAsync" Options="CourseOptions" />
                    </div>
                    <div>
                        <label class="skoulou-label">Titre</label>
                        <InputText @bind-Value="lessonForm.Title" class="skoulou-input" />
                    </div>
                    <div>
                        <label class="skoulou-label">Résumé</label>
                        <InputTextArea @bind-Value="lessonForm.Summary" class="skoulou-input min-h-24" />
                    </div>
                    <div>
                        <label class="skoulou-label">Contenu</label>
                        <RichTextEditor @bind-Value="lessonForm.Content" Placeholder="Contenu HTML de la le?on..." />
                    </div>
                    <div class="grid gap-4 rounded-2xl border border-slate-200 bg-slate-50 p-4 xl:grid-cols-2">
                        <label class="flex items-center gap-2">
                            <input type="checkbox" class="h-4 w-4 rounded border-slate-300" @bind="lessonForm.IsPublished" />
                            <span class="text-sm font-semibold text-slate-700">Publier la leçon et ses exercices</span>
                        </label>
                        <div>
                            <label class="skoulou-label">Date limite des réponses ouvertes (optionnel)</label>
                            <TailwindDateTimePicker @bind-Value="lessonForm.ExerciseSubmissionDueAtUtc" />
                        </div>
                    </div>
                    <div class="rounded-3xl border border-slate-200 bg-slate-50/60 p-4">
                        <div class="flex items-center justify-between gap-3">
                            <div>
                                <h3 class="text-sm font-black text-slate-900">Exercices de la leçon</h3>
                                <p class="mt-1 text-xs text-slate-500">Même structure que les examens, mais rattachée à cette leçon.</p>
                            </div>
                            <button type="button" class="rounded-full bg-slate-900 px-4 py-2 text-xs font-semibold text-white transition hover:bg-slate-800" @onclick="AddLessonExercise">+ Ajouter un exercice</button>
                        </div>

                        <div class="mt-4 space-y-4">
                            @for (var exerciseIndex = 0; exerciseIndex < lessonForm.Exercises.Count; exerciseIndex++)
                            {
                                var exercise = lessonForm.Exercises[exerciseIndex];
                                var localExerciseIndex = exerciseIndex;
                                var isChoiceType = IsChoiceType(exercise.ExerciseType);
                                var isSingleChoiceType = IsSingleChoiceType(exercise.ExerciseType);
                                var isAudioType = IsAudioType(exercise.ExerciseType);

                                <article class="rounded-2xl bg-white p-4 ring-1 ring-slate-200">
                                    <div class="mb-3 flex items-center justify-between gap-3">
                                        <h4 class="text-sm font-bold text-slate-800">Exercice @(localExerciseIndex + 1)</h4>
                                        <button type="button" class="rounded-full bg-rose-100 px-3 py-1.5 text-xs font-semibold text-rose-700 transition hover:bg-rose-200" @onclick="() => RemoveLessonExercise(exercise)">Supprimer</button>
                                    </div>

                                    <div class="grid gap-3">
                                        <div class="grid gap-3 xl:grid-cols-2">
                                            <div>
                                                <label class="skoulou-label">Titre de l'exercice</label>
                                                <InputText @bind-Value="exercise.Title" class="skoulou-input" />
                                            </div>
                                            <div>
                                                <ModernDropdown TValue="string?" Label="Type d'exercice" Value="exercise.ExerciseType" ValueChanged="value => SetLessonExerciseTypeAsync(exercise, value)" Options="LessonExerciseTypeOptions" />
                                            </div>
                                        </div>

                                        <div>
                                            <label class="skoulou-label">Consigne (optionnel)</label>
                                            <InputTextArea @bind-Value="exercise.Instructions" class="skoulou-input min-h-20" />
                                        </div>

                                        <div>
                                            <label class="skoulou-label">Question</label>
                                            <InputTextArea @bind-Value="exercise.Question" class="skoulou-input min-h-20" />
                                        </div>

                                        <div>
                                            <label class="skoulou-label">Points</label>
                                            <InputNumber @bind-Value="exercise.Points" class="skoulou-input" />
                                        </div>

                                        @if (isAudioType)
                                        {
                                            <div class="rounded-2xl border border-cyan-100 bg-cyan-50 p-3">
                                                <div class="grid gap-3 xl:grid-cols-2">
                                                    <div>
                                                        <label class="skoulou-label">Texte audio (TTS)</label>
                                                        <InputTextArea @bind-Value="exercise.AudioText" class="skoulou-input min-h-20" />
                                                    </div>
                                                    <div>
                                                        <ModernDropdown TValue="string?" Label="Langue TTS" Value="exercise.TtsLanguage" ValueChanged="value => SetLessonExerciseTtsLanguageAsync(exercise, value)" Options="TtsLanguageOptions" />
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        @if (exercise.ExerciseType == "GapFill")
                                        {
                                            <div class="rounded-2xl border border-indigo-100 bg-indigo-50/70 p-3">
                                                <div class="mb-2 flex items-center justify-between gap-2">
                                                    <p class="text-xs font-semibold uppercase tracking-wide text-indigo-700">Réponses par trou</p>
                                                    <button type="button" class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-indigo-700 ring-1 ring-indigo-200 transition hover:bg-indigo-100" @onclick="() => AddLessonGap(exercise)">+ Ajouter un trou</button>
                                                </div>
                                                @for (var gapIndex = 0; gapIndex < exercise.Gaps.Count; gapIndex++)
                                                {
                                                    var gap = exercise.Gaps[gapIndex];
                                                    <div class="mb-2 rounded-xl bg-white p-3 ring-1 ring-indigo-100">
                                                        <div class="mb-1 flex items-center justify-between">
                                                            <span class="text-xs font-bold text-slate-700">Trou @(gapIndex + 1)</span>
                                                            <button type="button" class="text-xs font-semibold text-rose-600" @onclick="() => RemoveLessonGap(exercise, gap)">Supprimer</button>
                                                        </div>
                                                        <InputTextArea @bind-Value="gap.AcceptedAnswers" class="skoulou-input min-h-16" placeholder="Une variante par ligne" />
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else if (!isChoiceType)
                                        {
                                            <div>
                                                <label class="skoulou-label">Réponses acceptées (optionnel)</label>
                                                <InputTextArea @bind-Value="exercise.AcceptedAnswers" class="skoulou-input min-h-16" placeholder="Une variante par ligne" />
                                            </div>
                                        }

                                        @if (isChoiceType)
                                        {
                                            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-3">
                                                <div class="mb-2 flex items-center justify-between gap-2">
                                                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-600">Options</p>
                                                    <button type="button" class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-slate-700 ring-1 ring-slate-200 transition hover:bg-slate-100" @onclick="() => AddLessonExerciseOption(exercise)">+ Ajouter une option</button>
                                                </div>

                                                @for (var optionIndex = 0; optionIndex < exercise.Options.Count; optionIndex++)
                                                {
                                                    var option = exercise.Options[optionIndex];
                                                    <div class="mb-2 rounded-xl bg-white p-3 ring-1 ring-slate-200">
                                                        <div class="grid gap-3 xl:grid-cols-[auto_1fr_auto] xl:items-center">
                                                            @if (isSingleChoiceType)
                                                            {
                                                                <input type="radio" name="@($"lesson-ex-{localExerciseIndex}-single")" checked="@option.IsCorrect" @onchange="() => SelectSingleCorrectLessonOption(exercise, option)" />
                                                            }
                                                            else
                                                            {
                                                                <input type="checkbox" @bind="option.IsCorrect" />
                                                            }
                                                            <InputText @bind-Value="option.Text" class="skoulou-input" />
                                                            <button type="button" class="rounded-full bg-rose-100 px-3 py-1 text-xs font-semibold text-rose-700 transition hover:bg-rose-200" @onclick="() => RemoveLessonExerciseOption(exercise, option)">Supprimer</button>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    </div>
                    <div class="flex flex-wrap justify-end gap-3">
                        <button type="button" class="rounded-full bg-slate-100 px-5 py-3 text-sm font-semibold text-slate-900 transition duration-200 hover:bg-slate-200 disabled:cursor-not-allowed disabled:opacity-60" disabled="@isDatabaseActionInProgress" @onclick="CloseLessonModal">Annuler</button>
                        <AsyncActionButton Type="submit" Class="rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-lg disabled:opacity-50" IsBusy="@isDatabaseActionInProgress" BusyLabel="Enregistrement...">@(lessonForm.LessonId.HasValue ? "Enregistrer la leçon" : "Créer la leçon")</AsyncActionButton>
                    </div>
                </EditForm>
                </ModalDialog>

                <ModalDialog Open="mediaModalOpen"
                         OpenChanged="OnMediaModalOpenChanged"
                         Title="Téléverser une image ou un audio"
                         Eyebrow="Bibliothèque de médias"
                         MaxWidthClass="max-w-2xl">
                @if (!string.IsNullOrWhiteSpace(mediaErrorMessage))
                {
                    <div class="mb-4 rounded-2xl bg-rose-50 px-4 py-3 text-sm text-rose-800">@mediaErrorMessage</div>
                }
                <EditForm Model="mediaUploadForm" OnValidSubmit="SaveMediaAsync" FormName="admin-media-form" class="grid gap-4">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div>
                        <ModernDropdown TValue="Guid?" Label="Leçon" Value="mediaUploadForm.LessonId" ValueChanged="SetMediaLessonAsync" Options="LessonOptions" />
                    </div>
                    <div class="grid gap-4 xl:grid-cols-2">
                        <div>
                            <ModernDropdown TValue="string" Label="Type de média" Value="mediaUploadForm.MediaType" ValueChanged="SetMediaTypeAsync" Options="MediaTypeOptions" />
                        </div>
                        <div>
                            <label class="skoulou-label">Fichier</label>
                            <div class="skoulou-file-picker mt-1">
                                <div class="relative inline-flex">
                                    <span class="skoulou-file-trigger @(isDatabaseActionInProgress ? "skoulou-file-trigger-disabled" : string.Empty)">
                                        Choisir un fichier
                                    </span>
                                    <InputFile id="admin-media-file-input"
                                               OnChange="HandleMediaSelected"
                                               accept="@MediaFileAccept"
                                               class="absolute inset-0 h-full w-full cursor-pointer opacity-0"
                                               disabled="@isDatabaseActionInProgress" />
                                </div>
                                <span class="skoulou-file-selected-name">@(selectedMediaFile?.Name ?? "Aucun fichier sélectionné")</span>
                            </div>
                        </div>
                    </div>
                    <div>
                        <label class="skoulou-label">Texte alternatif</label>
                        <InputText @bind-Value="mediaUploadForm.AltText" class="skoulou-input" />
                    </div>
                    <div class="flex flex-wrap justify-end gap-3">
                        <button type="button" class="rounded-full bg-slate-100 px-5 py-3 text-sm font-semibold text-slate-900 transition duration-200 hover:bg-slate-200 disabled:cursor-not-allowed disabled:opacity-60" disabled="@isDatabaseActionInProgress" @onclick="CloseMediaModal">Annuler</button>
                        <AsyncActionButton Type="submit" Class="rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-lg disabled:opacity-50" IsBusy="@isDatabaseActionInProgress" BusyLabel="Téléverser le média" />
                    </div>
                </EditForm>
                </ModalDialog>

                <div class="mt-6">
                    <DataListPanel Items="FilteredCourseManagementItems"
                               PageSize="10"
                               SearchPlaceholder="Rechercher une classe ou un niveau..."
                               EmptyText="Aucune classe ni aucun niveau trouvé."
                               ResultLabelSingular="classe ou niveau"
                               ResultLabelPlural="classes et niveaux"
                               Filter="@((CourseManagementViewModel c, string term) => Contains(c.Code, term) || Contains(c.Title, term) || Contains(c.Description, term))">
                <div class="grid gap-4">
                @foreach (var course in context)
                {
                    <article class="rounded-3xl border p-5 transition duration-200 hover:-translate-y-0.5 hover:shadow-md @(course.IstSystemNiveau || !course.SchoolId.HasValue ? "border-emerald-100 bg-emerald-50/30 hover:border-emerald-200" : "border-cyan-100 bg-white hover:border-cyan-200")">
                        <button type="button" class="flex w-full items-start justify-between gap-3 text-left" @onclick="() => ToggleCourse(course.CourseId)">
                            <div class="flex items-start gap-3">
                                <svg class="mt-1 h-5 w-5 shrink-0 text-slate-400 transition-transform duration-200 @(IsCourseExpanded(course.CourseId) ? "rotate-90" : "")" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                                </svg>
                                <div>
                                    <div class="flex flex-wrap items-center gap-2">
                                        <h3 class="text-lg font-bold text-slate-900">@course.Code · @course.Title</h3>
                                        @if (course.IstSystemNiveau || !course.SchoolId.HasValue)
                                        {
                                            <span class="rounded-full bg-emerald-100 px-3 py-1 text-[11px] font-black uppercase tracking-wide text-emerald-700">Standard</span>
                                        }
                                        else
                                        {
                                            <span class="rounded-full bg-cyan-100 px-3 py-1 text-[11px] font-black uppercase tracking-wide text-cyan-700">@course.SchoolName</span>
                                        }
                                    </div>
                                    <p class="mt-1 text-sm text-slate-500">@course.Lessons.Count leçons</p>
                                </div>
                            </div>
                            <Badge Accent="emerald">@course.MediaCount médias</Badge>
                        </button>

                        @if (IsCourseExpanded(course.CourseId))
                        {
                        <p class="mt-3 text-sm text-slate-600">@course.Description</p>
                        <div class="mt-4">
                            <button type="button" class="inline-flex items-center gap-2 rounded-full bg-slate-950 px-4 py-2 text-sm font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-md" @onclick="() => EditCourseAsync(course.CourseId)">
                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" /></svg>
                                Modifier la classe / le niveau
                            </button>
                        </div>

                        <div class="mt-4 grid gap-3 text-sm sm:grid-cols-5">
                            <div class="rounded-xl bg-slate-50 p-2.5"><div class="font-bold text-slate-900">@course.RecommendedLessonCount</div><div class="text-slate-500">Recommandé</div></div>
                            <div class="rounded-xl bg-slate-50 p-2.5"><div class="font-bold text-slate-900">@course.ExamCount</div><div class="text-slate-500">Épreuves</div></div>
                            <div class="rounded-xl bg-slate-50 p-2.5"><div class="font-bold text-slate-900">@course.Lessons.Count</div><div class="text-slate-500">Leçons</div></div>
                            <div class="rounded-xl bg-amber-50 p-2.5"><div class="font-bold text-amber-900">@course.Price.ToString("N0") FCFA</div><div class="text-amber-600">Prix de la classe / du niveau</div></div>
                            <div class="rounded-xl bg-sky-50 p-2.5"><div class="font-bold text-sky-900">@course.StudentCount</div><div class="text-sky-600">Élèves inscrits</div></div>
                        </div>

                        <div class="mt-4 grid gap-3">
                            @foreach (var lesson in course.Lessons)
                            {
                                <div class="rounded-2xl bg-slate-50 p-4">
                                    <div class="flex items-center justify-between gap-3">
                                        <div class="font-semibold text-slate-900">@lesson.Order. @lesson.Title</div>
                                        <span class="text-xs font-medium text-slate-500">@lesson.ExerciseCount exercices</span>
                                    </div>
                                    <p class="mt-2 text-sm text-slate-600">@lesson.Summary</p>
                                    <div class="mt-3">
                                        <button type="button" class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-semibold text-slate-900 ring-1 ring-slate-200 transition duration-200 hover:-translate-y-0.5 hover:shadow-md" @onclick="() => EditLessonAsync(lesson.LessonId)">
                                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" /></svg>
                                            Modifier la leçon
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                        }
                    </article>
                }
                </div>
                </DataListPanel>
            </div>
        </div>
    </section>

    @if (!isProduktOwner)
    {
    <section class="mt-10 rounded-[2rem] bg-white p-6 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 sm:mt-12 sm:p-8">
        <p class="text-sm font-semibold uppercase tracking-[.18em] text-violet-700">Administrateur</p>
        <h2 class="mt-2 text-2xl font-black text-slate-900">Prix général et rémunération interne</h2>
        <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">Définis ici le prix général de l'abonnement. Si une école n'a pas de prix spécifique, ce prix général est utilisé automatiquement. Les nouveaux abonnements figent ensuite leur prix et leurs montants calculés.</p>

        <Toast Message="@commissionStatusMessage" MessageChanged="v => commissionStatusMessage = v" Kind="Toast.ToastKind.Success" />
        <Toast Message="@commissionErrorMessage" MessageChanged="v => commissionErrorMessage = v" Kind="Toast.ToastKind.Error" />

        <div class="mt-5 max-w-md rounded-2xl bg-slate-50 p-4 ring-1 ring-slate-200">
            <label class="skoulou-label">Prix général de l'abonnement (FCFA)</label>
            <InputNumber @bind-Value="commissionSettings.GlobalSubscriptionPrice" class="skoulou-input" />
            <p class="mt-1 text-xs text-slate-500">Prix par défaut pour toutes les écoles sans tarif spécifique.</p>
        </div>

        <div class="mt-5 grid gap-4 md:grid-cols-4">
            <div class="rounded-2xl bg-violet-50 p-4"><p class="font-bold text-slate-900">Responsable produit</p><p class="mt-1 text-2xl font-black text-slate-900">@commissionSettings.ProductOwnerAmount.ToString("N0") FCFA</p><p class="mt-1 text-sm text-violet-700">@commissionSettings.ProductOwnerPercent.ToString("N2") %</p><label class="mt-3 block text-xs font-semibold text-slate-600">FCFA</label><input type="number" min="0" @bind:get="commissionSettings.ProductOwnerAmount" @bind:set="SetProductOwnerCommissionAmountAsync" class="mt-1 w-full rounded-xl border border-violet-200 px-3 py-2" /><label class="mt-3 block text-xs font-semibold text-slate-600">Pourcentage</label><InputNumber @bind-Value="commissionSettings.ProductOwnerPercent" class="mt-1 w-full rounded-xl border border-violet-200 px-3 py-2" /></div>
            <div class="rounded-2xl bg-slate-100 p-4"><p class="font-bold text-slate-900">Plateforme</p><p class="mt-4 text-2xl font-black text-slate-900">@commissionSettings.PlatformAmount.ToString("N0") FCFA</p><p class="mt-1 text-sm text-slate-600">@commissionSettings.PlatformPercent.ToString("N2") %</p><p class="mt-5 text-xs text-slate-500">Calculé automatiquement.</p></div>
        </div>
        <p class="mt-4 text-sm text-slate-600">Aucune commission scolaire ni enseignante pour les nouveaux cycles. La rémunération du responsable produit est interne à la plateforme et ne réduit jamais la facture de l'école.</p>
        <AsyncActionButton Class="mt-5 rounded-full bg-violet-700 px-5 py-3 text-sm font-semibold text-white disabled:opacity-50" IsBusy="@isDatabaseActionInProgress" BusyLabel="Enregistrement..." OnClick="@(_ => SaveCommissionSettingsAsync())">Enregistrer le tarif et la rémunération interne</AsyncActionButton>
    </section>
    }

    @if (neueZugangsdaten.Count > 0)
    {
        <ModalDialog Open="true" Title="Identifiants initiaux" CloseOnBackdrop="false">
            <p>Transmettez ces identifiants confidentiellement. Ils ne seront plus affichés après fermeture. Le mot de passe peut être modifié dans le profil.</p>
            @foreach (var zugang in neueZugangsdaten)
            {
                <div class="my-3 break-all rounded-xl bg-slate-100 p-3"><strong>@zugang.Email</strong><br /><code>@zugang.Passwort</code></div>
            }
            <button type="button" class="skoulou-button-primary" @onclick="() => neueZugangsdaten.Clear()">Identifiants transmis — fermer</button>
        </ModalDialog>
    }

    <ModalDialog @bind-Open="confirmRemovePaymentOpen"
                 Title="Retirer le paiement"
                 Eyebrow="Action réservée à l'Administrateur"
                 MaxWidthClass="max-w-lg">
        <p class="text-sm leading-6 text-slate-600">
            Confirmes-tu le retrait du paiement pour le niveau <span class="font-semibold text-slate-900">@pendingRemoveLevelCode</span> ?
            Cette action est réservée à l'Administrateur et n'est possible que tant que le paiement n'a pas encore été facturé et que le cycle de la classe est encore ouvert.
        </p>
        <div class="mt-6 flex justify-end gap-3">
            <button type="button"
                    class="rounded-full bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-200"
                    @onclick="() => confirmRemovePaymentOpen = false">
                Annuler
            </button>
            <button type="button"
                    class="rounded-full bg-rose-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-rose-700"
                    @onclick="ConfirmRemovePaymentAsync">
                Retirer le paiement
            </button>
        </div>
    </ModalDialog>

    <ModalDialog @bind-Open="confirmRemoveAboOpen"
                 Title="Annuler l'abonnement"
                 Eyebrow="Action réservée à l'Administrateur"
                 MaxWidthClass="max-w-lg">
    <p class="text-sm leading-6 text-slate-600">
        Confirmes-tu l'annulation de l'abonnement pour le niveau <span class="font-semibold text-slate-900">@pendingRemoveAboLevelCode</span> ?
        Le niveau ne sera plus accessible à l'élève et le statut payé sera retiré. Cette action n'est possible que tant que le niveau n'est pas encore facturé.
    </p>
    <div class="mt-6 flex justify-end gap-3">
        <button type="button"
                class="rounded-full bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-200"
                @onclick="() => confirmRemoveAboOpen = false">
            Annuler
        </button>
        <button type="button"
                class="rounded-full bg-slate-700 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800"
                @onclick="ConfirmRemoveAboAsync">
            Annuler l'abonnement
        </button>
    </div>
</ModalDialog>

    <ModalDialog @bind-Open="confirmRemoveAboAndClassOpen"
                 Title="Annuler l'abonnement et retirer de la classe"
                 Eyebrow="Correction administrative irréversible"
                 MaxWidthClass="max-w-lg">
        <div class="space-y-4 text-sm leading-6 text-slate-600">
            <p>
                Confirme l'annulation de l'abonnement pour la classe <span class="font-semibold text-slate-900">@pendingRemoveAboLevelCode</span> et le retrait de l'élève de cette classe.
            </p>
            <p class="mt-2 rounded-xl bg-rose-50 p-3 font-medium text-rose-800">
                L'accès et le statut payé seront supprimés, les écritures financières liées seront annulées et l'élève n'appartiendra plus à cette classe. Cette action est impossible après facturation.
            </p>
        </div>
        <div class="mt-6 flex flex-wrap justify-end gap-3">
            <button type="button"
                    class="rounded-full bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-200"
                    @onclick="() => confirmRemoveAboAndClassOpen = false">
                Conserver l'élève dans la classe
            </button>
            <button type="button"
                    class="rounded-full bg-rose-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-rose-700"
                    @onclick="ConfirmRemoveAboAndClassAsync">
                Annuler et retirer de la classe
            </button>
        </div>
    </ModalDialog>

    @if (IsDevelopment)
    {
        <ModalDialog @bind-Open="confirmHardDeleteSchoolLeaderOpen"
                     Title="Supprimer définitivement le directeur et ses données de test"
                     Eyebrow="Development uniquement — action irréversible"
                     CloseOnBackdrop="false"
                     MaxWidthClass="max-w-lg">
            <div class="rounded-2xl bg-rose-50 p-4 text-sm leading-6 text-rose-900">
                <p class="font-bold">Cette action est définitive.</p>
                <p class="mt-2">
                    Le directeur <span class="font-semibold">@pendingHardDeleteSchoolLeaderName</span>, toutes ses écoles et toutes les données de test associées seront supprimés.
                </p>
                <p class="mt-2">Les utilisateurs également affectés à une autre école sont conservés dans cette autre école.</p>
            </div>
            <div class="mt-6 flex flex-wrap justify-end gap-3">
                <button type="button"
                        class="rounded-full bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-200"
                        @onclick="() => confirmHardDeleteSchoolLeaderOpen = false">
                    Annuler
                </button>
                <AsyncActionButton Class="rounded-full bg-rose-950 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-rose-900 disabled:opacity-50"
                                   IsBusy="@isDatabaseActionInProgress"
                                   BusyLabel="Suppression..."
                                   OnClick="@(_ => ConfirmHardDeleteSchoolLeaderAsync())">
                    Supprimer définitivement
                </AsyncActionButton>
            </div>
        </ModalDialog>
    }
}

