@page "/admin"
@attribute [Authorize(Roles = "SuperAdmin,ProduktOwner")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits SkoulouApp.WebApp.Components.CancelableComponentBase
@using SkoulouApp.Core.Models.Admin

<PageTitle>@(isProduktOwner ? "Espace responsable produit" : "Tableau administrateur")</PageTitle>

@if (!isProduktOwner)
{
    <a class="mb-4 inline-block rounded-xl border px-4 py-2 font-semibold text-indigo-700" href="/cycle-participants">Participants facturables des cycles</a>
}

@if (summary is null)
{
    <div class="rounded-[2rem] bg-white p-8 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
        <div class="flex items-center gap-3 text-slate-600">
            <ProgressRing Size="1.5rem" Label="Chargement du tableau de bord" />
            <p class="text-sm">Chargement du tableau de bord...</p>
        </div>
    </div>
}
else
{
    <section class="grid gap-6">
        <div class="skoulou-hero relative overflow-hidden rounded-[1.75rem] bg-gradient-to-br from-slate-900 via-indigo-900 to-cyan-800 p-5 text-white shadow-xl shadow-indigo-300/30 sm:p-6 xl:p-7">
            <div class="pointer-events-none absolute -top-16 -right-14 h-44 w-44 rounded-full bg-cyan-400/20 blur-3xl"></div>
            <div class="pointer-events-none absolute -bottom-14 -left-8 h-36 w-36 rounded-full bg-fuchsia-500/15 blur-3xl"></div>
            <div class="relative">
                <p class="text-sm font-semibold uppercase tracking-[0.18em] text-cyan-200">@(isProduktOwner ? "Responsable produit" : "Administrateur")</p>
                <h1 class="mt-3 text-3xl font-black xl:text-4xl">@(isProduktOwner ? "Vue d'ensemble de vos écoles" : "Vue d'ensemble de la plateforme et des écoles")</h1>
                <p class="mt-4 max-w-3xl text-sm leading-7 text-slate-300">@(isProduktOwner ? "Consultez les écoles qui vous sont attribuées et leurs utilisateurs. Les données scolaires sont gérées par chaque direction." : "Consultez les écoles, leurs utilisateurs et les données de la plateforme.")</p>
            </div>
        </div>

        <div class="grid gap-3 sm:grid-cols-2 2xl:grid-cols-4">
            <div class="group rounded-2xl bg-gradient-to-br from-cyan-500 to-blue-700 p-4 text-white shadow-md shadow-cyan-200/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-cyan-300/40"><div class="text-2xl font-black transition-transform duration-300 group-hover:scale-105">@summary.SchoolCount</div><div class="mt-0.5 text-xs font-semibold uppercase tracking-[0.08em] text-cyan-50">Écoles</div></div>
            <div class="skoulou-hero-badge group rounded-2xl bg-gradient-to-br from-indigo-500 to-violet-700 p-4 text-white shadow-md shadow-indigo-200/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-indigo-300/40"><div class="text-2xl font-black transition-transform duration-300 group-hover:scale-105">@summary.TeacherCount</div><div class="mt-0.5 text-xs font-semibold uppercase tracking-[0.08em] text-indigo-50">Enseignants</div></div>
            <div class="group rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-700 p-4 text-white shadow-md shadow-emerald-200/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-emerald-300/40"><div class="text-2xl font-black transition-transform duration-300 group-hover:scale-105">@summary.StudentCount</div><div class="mt-0.5 text-xs font-semibold uppercase tracking-[0.08em] text-emerald-50">Élèves</div></div>
            <div class="group rounded-2xl bg-gradient-to-br from-rose-500 to-orange-600 p-4 text-white shadow-md shadow-rose-200/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-rose-300/40"><div class="text-2xl font-black transition-transform duration-300 group-hover:scale-105">@summary.BlockedAccountCount</div><div class="mt-0.5 text-xs font-semibold uppercase tracking-[0.08em] text-rose-50">En attente / bloqués</div><div class="mt-1 text-[11px] text-rose-100">dont @summary.BlockedStudentCount élève(s)</div></div>
        </div>

        <div class="director-sticky-band">
            <div class="flex flex-wrap items-center gap-3 pr-14 sm:pr-16">
                <ModernDropdown TValue="string?" Value="userSchoolFilter" ValueChanged="v => SetUserSchoolFilter(v)" Options="UserSchoolFilterOptions" Searchable="true" SearchPlaceholder="Rechercher une école..." ContainerClass="w-full sm:w-72" />
                <span class="text-xs font-medium text-slate-500">Filtre la liste des utilisateurs par école.</span>
            </div>
        </div>

        <CollapsibleCard Title="Vue d'ensemble des écoles"
                     Eyebrow="Gestion des écoles"
                     Icon="??"
                     Accent="cyan"
                     Expanded="schoolOverviewExpanded"
                     ExpandedChanged="v => schoolOverviewExpanded = v">
                <HeaderRight>
                    <Badge Accent="slate">Écoles : @summary.SchoolCount · Enseignants : @summary.TeacherCount · Élèves : @summary.StudentCount · Classes : @summary.CourseCount</Badge>
                </HeaderRight>
                <ChildContent>
                <Toast Message="@(schoolModalOpen ? null : statusMessage)" MessageChanged="v => statusMessage = v" Kind="Toast.ToastKind.Success" />
                <Toast Message="@(schoolModalOpen ? null : errorMessage)" MessageChanged="v => errorMessage = v" Kind="Toast.ToastKind.Error" />

                <div class="mt-6 flex justify-end">
                    @if (!isProduktOwner)
                    {
                    <button type="button" class="inline-flex items-center gap-2 rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-lg" @onclick="OpenNewSchoolModalAsync">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                        </svg>
                        Nouvelle école
                    </button>
                    }
                </div>

                <ModalDialog Open="schoolModalOpen"
                             OpenChanged="OnSchoolModalOpenChangedAsync"
                             Title="@schoolModalTitle"
                             Eyebrow="Gestion des écoles"
                             MaxWidthClass="max-w-3xl">
                <EditForm Model="schoolForm" OnValidSubmit="SaveSchoolAsync" FormName="admin-school-form" class="grid gap-4">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div>
                        <label class="skoulou-label">Nom de l'école</label>
                        <InputText @bind-Value="schoolForm.Name" class="skoulou-input" />
                    </div>

                    <div class="grid gap-4 xl:grid-cols-2">
                        <div>
                            <label class="skoulou-label">Ville</label>
                            <InputText @bind-Value="schoolForm.City" class="skoulou-input" />
                        </div>
                        <ModernDropdown TValue="string"
                                        Label="Pays"
                                        Value="schoolForm.Country"
                                        ValueChanged="SetSchoolCountryAsync"
                                        Options="SchoolCountryOptions"
                                        Searchable="true"
                                        SearchPlaceholder="Rechercher un pays..." />
                    </div>

                    <div>
                        <label class="skoulou-label">Description de l'école (facultatif)</label>
                        <RichTextEditor @bind-Value="schoolForm.DescriptionHtml" EnableImages="false" EnableLargeEditor="true" Placeholder="Présentez l'établissement..." />
                    </div>

                    <label class="inline-flex items-center gap-3 text-sm text-slate-600">
                        <InputCheckbox @bind-Value="schoolForm.IsActive" />
                        <span>L'école est active</span>
                    </label>

                    <div>
                        <label class="skoulou-label">Prix de l'abonnement (FCFA)</label>
                        @if (!isProduktOwner)
                        {
                            <InputNumber @bind-Value="schoolForm.SubscriptionPriceOverride" class="skoulou-input" />
                            <p class="mt-1 text-xs text-slate-500">Laisser vide pour utiliser le tarif général. Un nouveau tarif ne modifie jamais les cycles déjà démarrés.</p>
                        }
                        else
                        {
                            <div class="skoulou-input">@SchoolSubscriptionPriceDisplay.ToString("N0") FCFA</div>
                        }
                        <p class="mt-1 text-xs text-slate-500">Affichage uniquement. Le prix est défini par l'admin.</p>
                    </div>

                    <p class="text-sm text-slate-600">Aucune commission scolaire. La facture de chaque nouveau cycle est due intégralement à la plateforme.</p>

                    <div>
                        <div class="mb-3 text-sm font-semibold text-slate-700">Affecter des enseignants</div>
                        <div class="grid gap-3">
                            @foreach (var teacher in teacherOptions)
                            {
                                <label class="flex items-start gap-3 rounded-2xl border border-slate-200 px-4 py-3">
                                    <input type="checkbox" checked="@selectedTeacherIds.Contains(teacher.TeacherId)" @onchange="args => ToggleTeacher(teacher.TeacherId, args.Value)" />
                                    <span>
                                        <span class="block font-semibold text-slate-900">@teacher.TeacherName</span>
                                        <span class="text-sm text-slate-500">@teacher.Email</span>
                                    </span>
                                </label>
                            }
                        </div>
                    </div>

                    <div class="flex flex-wrap justify-end gap-3">
                        <button type="button" class="rounded-full bg-slate-100 px-5 py-3 text-sm font-semibold text-slate-900 transition duration-200 hover:bg-slate-200 disabled:cursor-not-allowed disabled:opacity-60" disabled="@isDatabaseActionInProgress" @onclick="CloseSchoolModalAsync">Annuler</button>
                        <AsyncActionButton Type="submit" Class="rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-lg disabled:opacity-50" IsBusy="@isDatabaseActionInProgress" BusyLabel="Enregistrement...">@(schoolForm.Id.HasValue ? "Enregistrer l'ecole" : "Creer l'ecole")</AsyncActionButton>
                    </div>
                </EditForm>
                </ModalDialog>

                <ModalDialog Open="@(viewedUser is not null)" OpenChanged="open => { if (!open) viewedUser = null; }"
                             Title="Données de l'utilisateur" Eyebrow="Consultation" MaxWidthClass="max-w-lg">
                    @if (viewedUser is not null)
                    {
                        <div class="grid gap-3 text-sm text-slate-700">
                            <p><strong>Nom :</strong> @viewedUser.FullName</p>
                            <p><strong>E-mail :</strong> @viewedUser.Email</p>
                            <p><strong>Rôle :</strong> @GetRoleLabel(viewedUser.RoleName)</p>
                            <p><strong>Écoles :</strong> @(viewedUser.Schools.Count == 0 ? "Aucune affectation" : string.Join(", ", viewedUser.Schools))</p>
                            <p><strong>Statut :</strong> @(viewedUser.IsBlocked ? "Compte bloqué" : "Compte actif")</p>
                            <p><strong>Auto-inscription :</strong> @(viewedUser.IsSelfRegistered ? "Oui" : "Non")</p>
                        </div>
                    }
                </ModalDialog>

                <div class="mt-6">
                @if (!isProduktOwner)
                {
                    <div class="mb-4 max-w-xl">
                        <ModernDropdown TValue="Guid?"
                                        Label="Filtrer les écoles par directeur"
                                        Value="schoolDirectorFilter"
                                        ValueChanged="SetSchoolDirectorFilterAsync"
                                        Options="SchoolDirectorFilterOptions"
                                        Searchable="true"
                                        SearchPlaceholder="Rechercher un directeur..." />
                    </div>
                }
                <DataListPanel Items="FilteredSchoolManagementItems"
                               PageSize="12"
                               SearchPlaceholder="Rechercher une ecole..."
                               EmptyText="Aucune ecole trouvée."
                               ResultLabelSingular="ecole"
                               ResultLabelPlural="ecoles"
                               Filter="@((SchoolManagementViewModel s, string term) => Contains(s.Name, term) || Contains(s.City, term) || Contains(s.Country, term))">
                    <div class="grid gap-3 xl:grid-cols-2 3xl:grid-cols-3">
                        @foreach (var school in context)
                        {
                    <article class="rounded-2xl border border-slate-200 p-4 transition duration-200 hover:-translate-y-0.5 hover:border-cyan-200 hover:shadow-md">
                        <div class="flex items-start justify-between gap-3">
                            <div>
                                <h3 class="text-base font-bold text-slate-900">@school.Name</h3>
                                <p class="mt-0.5 text-xs text-slate-500">@school.City, @school.Country</p>
                            </div>
                            <Badge Accent="@(school.IsActive ? "emerald" : "rose")">@(school.IsActive ? "Ecole active" : "Ecole inactive")</Badge>
                        </div>
                        <div class="mt-3 grid gap-2 text-xs sm:grid-cols-3">
                            <div class="rounded-xl bg-slate-50 p-2.5"><div class="font-bold text-slate-900">@school.TeacherCount</div><div class="text-slate-500">Enseignants</div></div>
                            <div class="rounded-xl bg-slate-50 p-2.5"><div class="font-bold text-slate-900">@school.StudentCount</div><div class="text-slate-500">Eleves</div></div>
                            <div class="rounded-xl @(school.OutstandingDebt > 0 ? "bg-rose-50" : "bg-slate-50") p-2.5"><div class="font-bold @(school.OutstandingDebt > 0 ? "text-rose-700" : "text-slate-900")">@school.OutstandingDebt.ToString("N0") FCFA</div><div class="@(school.OutstandingDebt > 0 ? "text-rose-500" : "text-slate-500")">Dette de l'ecole envers SKOULOUAPP</div></div>
                        </div>
                        <div class="mt-2.5 grid gap-2 text-xs sm:grid-cols-2">
                            <div class="rounded-xl bg-cyan-50 p-2.5"><div class="font-bold text-cyan-800">@school.EffectiveSubscriptionPrice.ToString("N0") FCFA</div><div class="text-cyan-600">Prix de l'abonnement affiche</div></div>
                            <div class="rounded-xl bg-slate-50 p-2.5"><div class="font-bold text-slate-900">@(school.SubscriptionPriceOverride.HasValue ? school.SubscriptionPriceOverride.Value.ToString("N0") + " FCFA" : "Prix general")</div><div class="text-slate-500">Tarif specifique de l'ecole</div></div>
                        </div>
                        <div class="mt-3 flex flex-wrap gap-1.5">
                            @foreach (var director in school.DirectorAssignments)
                            {
                                <Badge Accent="indigo">Directeur: @director.TeacherName</Badge>
                            }

                            @foreach (var teacher in school.TeacherAssignments.Take(4))
                            {
                                <Badge Accent="cyan">@teacher.TeacherName</Badge>
                            }

                            @if (school.TeacherAssignments.Count > 4)
                            {
                                <Badge Accent="slate">+@(school.TeacherAssignments.Count - 4)</Badge>
                            }
                        </div>
                        <div class="mt-3">
                            @if (!isProduktOwner)
                            {
                            <button type="button" class="inline-flex items-center gap-2 rounded-full bg-slate-950 px-3.5 py-1.5 text-xs font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-md" @onclick="() => EditSchoolAsync(school.SchoolId)">
                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="@(school.IsActive ? "m4.5 15.75 7.5-7.5 7.5 7.5" : "m19.5 8.25-7.5 7.5-7.5-7.5")" />
                                </svg>
                                Modifier
                            </button>
                            }
                        </div>
                                  </article>
                                     }
                                 </div>
                             </DataListPanel>
                            </div>

                    <div class="mt-8 border-t border-slate-200 pt-8">
                        <div class="mb-4 flex items-center justify-between gap-3">
                            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-700">Gestion des utilisateurs</p>
                            <Badge Accent="slate">@FilteredUserManagementItems.Count utilisateurs</Badge>
                        </div>
                <Toast Message="@userStatusMessage" MessageChanged="v => userStatusMessage = v" Kind="Toast.ToastKind.Success" />
                <Toast Message="@userErrorMessage" MessageChanged="v => userErrorMessage = v" Kind="Toast.ToastKind.Error" />

                <div class="mt-6 flex justify-end">
                    <button type="button" class="inline-flex items-center gap-2 rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-lg" @onclick="OpenNewUserModalAsync">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                        </svg>
                        Nouvel utilisateur
                    </button>
                </div>

                <ModalDialog Open="userModalOpen"
                             OpenChanged="OnUserModalOpenChangedAsync"
                             Title="@userModalTitle"
                             Eyebrow="Gestion des utilisateurs"
                             ErrorMessage="@userErrorMessage"
                             CloseOnBackdrop="false"
                             MaxWidthClass="max-w-3xl">
                @if (!string.IsNullOrWhiteSpace(userStatusMessage))
                {
                    <div class="sticky top-0 z-20 -mx-1 mb-3 space-y-2 rounded-xl bg-white/95 pb-2 pt-1 backdrop-blur">
                        @if (!string.IsNullOrWhiteSpace(userStatusMessage))
                        {
                            <div class="flex items-start justify-between gap-3 rounded-2xl bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800 ring-1 ring-emerald-100">
                                <span>@userStatusMessage</span>
                                <button type="button" class="shrink-0 rounded-full p-1 text-emerald-700 transition hover:bg-emerald-100" aria-label="Fermer" @onclick="() => userStatusMessage = null">
                                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                                    </svg>
                                </button>
                            </div>
                        }
                    </div>
                }

                <EditForm Model="userForm" OnValidSubmit="SaveUserAsync" FormName="admin-user-form" class="grid gap-4">
                    <DataAnnotationsValidator />

                    <div class="skoulou-modal-sticky-messages">
                        <ValidationSummary />
                    </div>

                    <div class="rounded-2xl border border-indigo-100 bg-indigo-50 px-4 py-3 text-sm leading-6 text-indigo-950">
                        <p class="font-bold">Information</p>
                        <p class="mt-1">Vérifie le rôle, l'école et l'adresse e-mail avant d'enregistrer. Les droits d'accès et les leçons visibles dépendent de ces choix.</p>
                    </div>

                    <div>
                        <ModernDropdown TValue="string" Label="Rôle" Value="userForm.RoleName" ValueChanged="SetUserRoleAsync" Options="RoleOptions" />
                    </div>

                    <div class="grid gap-4 xl:grid-cols-2">
                        <div>
                            <label class="skoulou-label">Prénom</label>
                            <InputText @bind-Value="userForm.Vorname" class="skoulou-input" />
                        </div>
                        <div>
                            <label class="skoulou-label">Nom de famille</label>
                            <InputText @bind-Value="userForm.Nachname" class="skoulou-input" />
                        </div>
                    </div>

                    <div class="grid gap-4 xl:grid-cols-2">
                        <div class="xl:col-span-2">
                            <label class="skoulou-label">E-mail</label>
                            <div class="flex gap-2"><InputText @bind-Value="userForm.Email" class="skoulou-input min-w-0 flex-1" />@if (ShowSkoulouAppEmailButton) { <button type="button" class="w-44 shrink-0 rounded-2xl bg-slate-100 px-3 text-xs font-semibold text-slate-700 hover:bg-slate-200 disabled:cursor-not-allowed disabled:opacity-50" disabled="@(!CanSuggestSkoulouAppEmail)" @onclick="SuggestSkoulouAppEmail">@skoulouAppEmailButtonLabel</button> }</div>
                        </div>
                        <div>
                            <label class="skoulou-label">Téléphone <span class="font-normal text-slate-400">(optionnel)</span></label>
                            <InputText @bind-Value="userForm.TelefonNummer" type="tel" class="skoulou-input" />
                        </div>
                    </div>

                    @if (userForm.RoleName == "Schüler")
                    {
                        <div class="grid gap-4 xl:grid-cols-2"><div><label class="skoulou-label">Téléphone d'un parent <span class="font-normal text-slate-400">(optionnel)</span></label><InputText @bind-Value="userForm.ElternTelefonNummer" type="tel" class="skoulou-input" /></div><div><label class="skoulou-label">E-mail d'un parent <span class="font-normal text-slate-400">(optionnel)</span></label><InputText @bind-Value="userForm.ElternEmail" type="email" class="skoulou-input" /></div></div>
                    }

                    @if (!userForm.UserId.HasValue)
                    {
                        <div>
                            <label class="skoulou-label">Mot de passe initial (nouveau / optionnel)</label>
                            <PasswordInput @bind-Value="userForm.Password" Autocomplete="new-password" />
                            <p class="mt-1 text-xs text-slate-500">Le mot de passe doit contenir au moins 6 caractères, dont au moins 1 chiffre et 1 lettre minuscule.</p>
                        </div>

                        <div class="grid gap-4 xl:grid-cols-2">
                            <div>
                                <label class="skoulou-label">Confirmer le mot de passe</label>
                                <PasswordInput @bind-Value="userForm.PasswordConfirmation" Autocomplete="new-password" />
                                <ValidationMessage For="() => userForm.PasswordConfirmation" class="mt-1 text-xs text-rose-600" />
                            </div>
                        </div>
                    }

                    <div class="grid gap-3 xl:grid-cols-2">
                        <label class="inline-flex items-center gap-3 text-sm text-slate-600">
                            <InputCheckbox @bind-Value="userForm.IsBlocked" />
                            <span>Utilisateur bloqué</span>
                        </label>
                        <label class="inline-flex items-center gap-3 text-sm text-slate-600">
                            <InputCheckbox @bind-Value="userForm.IsSelfRegistered" />
                            <span>Auto-inscription</span>
                        </label>
                    </div>

                    @if (userForm.RoleName == "SuperAdmin")
                    {
                        <div class="rounded-2xl bg-cyan-50 px-4 py-3 text-sm text-cyan-900">
                            Ce rôle n'est attribué à aucune école.
                        </div>
                    }
                    else
                    {
                        <div>
                            <div class="mb-3 text-sm font-semibold text-slate-700">@(userForm.RoleName == "Schüler" ? "École attribuée" : "Écoles attribuées")</div>
                            <div class="grid gap-3">
                                @foreach (var schoolOption in schoolOptions)
                                {
                                    <label class="flex items-start gap-3 rounded-2xl border border-slate-200 px-4 py-3">
                                        <input type="checkbox" checked="@selectedUserSchoolIds.Contains(schoolOption.TeacherId)" @onchange="args => ToggleUserSchoolAsync(schoolOption.TeacherId, args.Value)" />
                                        <span>
                                            <span class="block font-semibold text-slate-900">@schoolOption.TeacherName</span>
                                            <span class="text-sm text-slate-500">@schoolOption.Email</span>
                                        </span>
                                    </label>
                                }
                            </div>
                        </div>
                        @if (userForm.RoleName == "Schüler")
                        {
                            <div>
                                <ModernDropdown TValue="Guid?" Label="Classe ou niveau actuel" Value="userForm.CurrentKlasseId" ValueChanged="SetUserClassAsync" Options="UserClassOptions" />
                                <p class="mt-1 text-xs text-slate-500">Cette affectation ne crée pas d'abonnement SKOULOUAPP.</p>
                            </div>
                        }
                        @if (userForm.RoleName == "Lehrer")
                        {
                            <div>
                                <div class="mb-3 text-sm font-semibold text-slate-700">Classes attribuées</div>
                                <div class="grid gap-3">
                                    @foreach (var klasse in userFormClassOptions.Where(klasse => klasse.SchoolId.HasValue && klasse.CourseId.HasValue))
                                    {
                                        <label class="flex items-center gap-3 rounded-2xl border border-slate-200 px-4 py-3 text-sm text-slate-700">
                                            <input type="checkbox" checked="@IsTeacherClassAssigned(klasse.SchoolId!.Value, klasse.CourseId!.Value)" @onchange="args => SetTeacherClassAssignment(klasse, args.Value as bool? == true)" />
                                            @klasse.Code · @klasse.Title
                                        </label>
                                    }
                                </div>
                            </div>
                        }
                    }

                    <div class="flex flex-wrap justify-end gap-3">
