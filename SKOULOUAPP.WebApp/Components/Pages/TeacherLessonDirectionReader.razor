@page "/teacher-lessons/{LessonId:guid}/view"
@attribute [Authorize(Policy = "RequireSchulLeiter")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits HalloApp.WebApp.Components.CancelableComponentBase
@using HalloApp.Core.Models.TeacherLessons

<PageTitle>@(lesson?.Title ?? "Support partagé")</PageTitle>

@if (notFound)
{
    <div class="rounded-[2rem] bg-white p-8 text-left shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
        <p class="text-sm font-bold text-slate-900">Ce support n'est pas disponible pour ton rôle.</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Seuls la direction et la coordination de l'école peuvent consulter les contenus explicitement partagés par l'enseignant.</p>
        <button type="button" class="mt-4 rounded-full bg-slate-100 px-6 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-200" @onclick="GoBack">Retour aux supports</button>
    </div>
}
else if (lesson is null)
{
    <SkeletonLoader CardCount="2" />
}
else
{
    <section class="grid gap-6">
        <div class="hallo-hero rounded-[2rem] p-6 text-white shadow-2xl sm:p-8">
            <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-white/15 px-3 py-1 text-xs font-bold text-white ring-1 ring-white/30">@lesson.CourseCode</span>
                <span class="rounded-full bg-violet-100 px-3 py-1 text-xs font-bold text-violet-800">Lecture seule</span>
            </div>
            <h1 class="mt-3 text-3xl font-black">@lesson.Title</h1>
            @if (!string.IsNullOrWhiteSpace(lesson.CourseTheme))
            {
                <p class="mt-2 text-sm font-semibold text-indigo-100">@lesson.CourseTheme</p>
            }
            @if (!string.IsNullOrWhiteSpace(lesson.Summary))
            {
                <p class="mt-3 max-w-2xl text-sm leading-7 text-indigo-50">@lesson.Summary</p>
            }
        </div>

        @if (lesson.Pages.Count == 0)
        {
            <div class="rounded-[2rem] bg-white p-8 text-center shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
                <p class="text-sm text-slate-600">Ce support ne contient aucune page.</p>
            </div>
        }
        else
        {
            <div class="mx-auto w-full max-w-3xl rounded-[2rem] bg-white p-8 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
                <div class="ql-snow">
                    <div class="ql-editor" style="padding:0;">
                        @((MarkupString)(CurrentPage?.ContentHtml ?? string.Empty))
                    </div>
                </div>
            </div>

            <div class="sticky bottom-0 z-30 -mx-1 flex items-center justify-between gap-4 rounded-2xl border border-slate-100 bg-white/95 px-4 py-3 shadow-lg shadow-slate-200/70 backdrop-blur supports-[backdrop-filter]:bg-white/80">
                <button type="button"
                        class="rounded-full bg-slate-100 px-6 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-200 disabled:opacity-40"
                        @onclick="PreviousPage" disabled="@(currentPageIndex == 0)">
                    ← Page précédente
                </button>
                <span class="text-sm font-semibold text-slate-600">Page @(currentPageIndex + 1) / @lesson.Pages.Count</span>
                <button type="button"
                        class="hallo-btn-accent rounded-full px-6 py-2.5 text-sm font-semibold transition disabled:opacity-40"
                        @onclick="NextPage" disabled="@(currentPageIndex >= lesson.Pages.Count - 1)">
                    Page suivante →
                </button>
            </div>
        }

        <div class="flex flex-wrap justify-center gap-3">
            <button type="button" class="rounded-full bg-slate-100 px-6 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-200" @onclick="GoBack">Retour aux supports</button>
            @if (lesson.IsPdfExportEnabled)
            {
                <a class="rounded-full bg-cyan-100 px-6 py-2.5 text-sm font-semibold text-cyan-800 transition hover:bg-cyan-200" href="teacher-lessons/@lesson.Id/pdf?solutions=true" target="_blank">Exporter PDF avec solutions</a>
                <a class="rounded-full bg-amber-100 px-6 py-2.5 text-sm font-semibold text-amber-800 transition hover:bg-amber-200" href="teacher-lessons/@lesson.Id/pdf?solutions=false" target="_blank">Exporter sans solutions</a>
            }
        </div>
    </section>
}
