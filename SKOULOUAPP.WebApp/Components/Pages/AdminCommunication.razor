@page "/admin/communication"
@attribute [Authorize(Roles = "SuperAdmin")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Communication · Administration</PageTitle>

<section class="grid min-w-0 gap-6">
    <div class="skoulou-hero rounded-[1.25rem] px-5 py-4 text-white shadow-xl sm:px-6 sm:py-5">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-cyan-200">Espace administrateur</p>
        <h1 class="mt-3 text-3xl font-black">Communication</h1>
        <p class="mt-3 text-sm leading-6 text-slate-200">Publiez des annonces dans l'application et gérez votre courrier électronique.</p>
    </div>

    <div class="school-page-tabs flex flex-wrap gap-2" aria-label="Rubriques de communication">
        <button type="button" class="rounded-full px-4 py-2 text-sm font-semibold @(activeTab == "annonces" ? "skoulou-btn-accent" : "bg-slate-100 text-slate-700 hover:bg-slate-200")" aria-current="@(activeTab == "annonces" ? "page" : null)" @onclick='() => activeTab = "annonces"'>Annonces</button>
        <button type="button" class="rounded-full px-4 py-2 text-sm font-semibold @(activeTab == "courrier" ? "skoulou-btn-accent" : "bg-slate-100 text-slate-700 hover:bg-slate-200")" aria-current="@(activeTab == "courrier" ? "page" : null)" @onclick='() => { mailboxVisited = true; activeTab = "courrier"; }'>E-mails</button>
    </div>

    <div class="min-w-0 @(activeTab == "annonces" ? "" : "hidden")">
        <AdminBroadcast ShowEmailComposer="false" />
    </div>
    @if (mailboxVisited)
    {
        <div class="min-w-0 @(activeTab == "courrier" ? "" : "hidden")">
            <Mailbox />
        </div>
    }
</section>

@code {
    private string activeTab = "annonces";
    private bool mailboxVisited;
}
