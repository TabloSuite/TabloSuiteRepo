@page "/emplois-du-temps"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SchulLeiter,Koordinator,Lehrer,Schüler")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits CancelableComponentBase
@using SkoulouApp.WebApp.Services

<PageTitle>Emplois du temps</PageTitle>
<div class="mx-auto max-w-6xl space-y-5 p-4">
    <SeitenKopf Rubrik="Établissement" Titel="Emplois du temps" IconName="timetable" Untertitel="Consultez les cours par jour, classe ou enseignant." />
    @if (!string.IsNullOrEmpty(message)) { <p role="status" class="rounded-xl bg-slate-100 p-4">@message</p> }
    <ModernDropdown TValue="Guid" Value="schulID" ValueChanged="EcoleAsync" Options="Options(schulen)" Label="École" EinzigeOptionFest="true" Searchable="true" Disabled="occupe" />
    @if (verwalter && uebersicht is not null)
    {
        <details class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <summary class="cursor-pointer text-lg font-semibold">Nouveau planning</summary>
            <div class="mt-4 grid gap-4 md:grid-cols-2">
                <ModernDropdown TValue="Guid" @bind-Value="jahrID" Options="Options(uebersicht.Schuljahre.Where(x => !x.IstGeschlossen).Select(x => new AuswahlEintrag(x.Id, x.Bezeichnung)))" Label="Année scolaire" Disabled="occupe" />
                <ModernDropdown TValue="Guid" @bind-Value="klasseID" Options="Options(uebersicht.Klassen)" Label="Classe" Disabled="occupe" />
                <label>Intitulé<input class="skoulou-input" maxlength="120" @bind="titel" /></label>
                <label>Valable à partir du<input type="date" class="skoulou-input" @bind="ab" /></label>
                <label>Valable jusqu'au<input type="date" class="skoulou-input" @bind="bis" /></label>
            </div>
            <button type="button" class="sk-btn sk-btn-primary mt-4" disabled="@occupe" @onclick="AnlegenAsync">Créer le brouillon</button>
        </details>
        <ModernDropdown TValue="Guid" Value="planID" ValueChanged="PlanWaehlenAsync" Options="PlanOptionen" Label="Planning à gérer" Disabled="occupe" />
        @if (AktuellerPlan is { } plan)
        {
            <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <h2 class="text-lg font-semibold">@plan.Bezeichnung</h2>
                <p>@plan.GueltigAb.ToString("dd/MM/yyyy") – @plan.GueltigBis.ToString("dd/MM/yyyy")</p>
                <details class="mt-3 rounded-xl border border-slate-200 bg-slate-50 p-3"><summary>Copier ce planning</summary>
                    <p>Renseignez l'intitulé et les dates dans « Nouveau planning », puis créez une copie dans la même classe et la même année.</p>
                    <button type="button" class="sk-btn sk-btn-secondary sk-btn-sm mt-2" disabled="@occupe" @onclick="KopierenAsync">Créer une copie brouillon</button>
                </details>
                @foreach (var volume in stunden)
                {
                    <p class="mt-2 rounded p-2 @(Math.Abs(volume.Soll - volume.Ist) > 0.01m ? "bg-amber-50" : "bg-emerald-50")">@volume.Fach · @volume.Lehrer : @volume.Ist.ToString("0.##") h planifiées / @volume.Soll.ToString("0.##") h prévues (heures de 60 minutes)</p>
                }
                @if (!plan.IstVeroeffentlicht)
                {
                    <details class="mt-3 rounded-xl border border-slate-200 bg-slate-50 p-3"><summary>Grille de saisie des horaires</summary>
                        <div class="grid gap-3 md:grid-cols-3">
                            <label>Début de journée<input type="time" class="skoulou-input" @bind="rasterBeginn" /></label>
                            <label>Fin de journée<input type="time" class="skoulou-input" @bind="rasterEnde" /></label>
                            <label>Durée d'un créneau (minutes)<input type="number" min="5" max="180" class="skoulou-input" @bind="rasterMinuten" /></label>
                        </div>
                        <ModernDropdown TValue="int" Value="rasterIndex" ValueChanged="RasterWaehlen" Options="RasterOptionen" Label="Appliquer un créneau au cours" />
                    </details>
                    <div class="mt-4 grid gap-4 md:grid-cols-2">
                        <ModernDropdown TValue="Guid" @bind-Value="unterrichtID" Options="UnterrichtOptionen" Label="Enseignement" Searchable="true" Disabled="occupe" />
                        <ModernDropdown TValue="int" @bind-Value="wochentag" Options="Tage" Label="Jour" Disabled="occupe" />
                        <label>Début<input type="time" class="skoulou-input" @bind="beginn" /></label>
                        <label>Fin<input type="time" class="skoulou-input" @bind="ende" /></label>
                        <label>Salle (facultatif)<input class="skoulou-input" maxlength="80" @bind="raum" /></label>
                    </div>
                    <button type="button" class="sk-btn sk-btn-primary mt-4" disabled="@occupe" @onclick="EintragAsync">Ajouter le cours</button>
                }
                <button type="button" class="sk-btn sk-btn-secondary m-2" disabled="@occupe" @onclick="PublierAsync">@(plan.IstVeroeffentlicht ? "Retirer la publication pour modifier" : "Publier le planning")</button>
            </section>
        }
    }
    <label class="block">Rechercher une classe, un enseignant ou une matière<input class="skoulou-input mt-1" @bind="suche" @bind:event="oninput" /></label>
    @if (schulID != Guid.Empty)
    {
        <a class="sk-btn sk-btn-secondary" href="@($"/emplois-du-temps/{schulID}/pdf")" target="_blank" rel="noopener">Télécharger le PDF</a>
    }
    <div class="sk-liste-scroll space-y-4 p-1">
    @foreach (var tag in Gefiltert.GroupBy(x => x.Wochentag).OrderBy(x => ((int)x.Key + 6) % 7))
    {
        <section class="space-y-2">
            <h2 class="text-base font-bold text-slate-900">@TagName(tag.Key)</h2>
            @foreach (var cours in tag.OrderBy(x => x.Beginn))
            {
                <article class="flex flex-wrap justify-between gap-3 rounded-xl border bg-white p-4" @key="cours.Id">
                    <div class="min-w-0 break-words"><strong>@cours.Beginn.ToString("HH:mm") – @cours.Ende.ToString("HH:mm") · @cours.Fach</strong><p>@cours.Klasse · @cours.Lehrer · @cours.Raum</p><p class="text-sm text-slate-500">@cours.Plan · @cours.GueltigAb.ToString("dd/MM/yyyy") – @cours.GueltigBis.ToString("dd/MM/yyyy") · @(cours.IstVeroeffentlicht ? "Publié" : "Brouillon")</p></div>
                    @if (verwalter && !cours.IstVeroeffentlicht)
                    {
                        <button type="button" class="sk-btn sk-btn-danger" disabled="@occupe" @onclick="() => RetirerAsync(cours.Id)">Retirer</button>
                    }
                </article>
            }
        </section>
    }
    </div>
    @if (!Gefiltert.Any() && !occupe) { <p>Aucun cours accessible pour cette sélection.</p> }
</div>
