@page "/notes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SchulLeiter,Koordinator,Lehrer")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits CancelableComponentBase
@using SkoulouApp.WebApp.Services

<PageTitle>Notes et évaluations</PageTitle>
<div class="mx-auto max-w-6xl space-y-5">
    <SeitenKopf Rubrik="Pédagogie" Titel="Notes et évaluations" IconName="clipboard-check" Untertitel="Préparez les périodes et saisissez les notes par matière." />
    @if (message.Length > 0) { <p role="status" class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm">@message</p> }
    <div class="grid gap-4 md:grid-cols-2">
        <ModernDropdown TValue="Guid" Value="schulID" ValueChanged="SchuleAsync" Options="Options(schulen)" Label="École" EinzigeOptionFest="true" Disabled="occupe" />
        <ModernDropdown TValue="Guid" Value="jahrID" ValueChanged="JahrAsync" Options="Options(jahre)" Label="Année scolaire" Disabled="occupe" />
    </div>
    @if (schulID != Guid.Empty && jahre.Count == 0)
    {
        <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 text-sm text-amber-900" role="status">
            <span class="flex items-start gap-2"><Icon Name="calendar" Groesse="18" /><span><strong>Aucune année scolaire pour le moment.</strong>
                @(verwalter ? "Créez-la d'abord dans « Organisation des enseignements » (Années scolaires) ; ensuite vous préparez ici les périodes et la saisie des notes." : "Votre direction doit d'abord créer l'année scolaire ; ensuite vous pourrez saisir les notes ici.")</span></span>
            @if (verwalter)
            {
                <a class="sk-btn sk-btn-sm sk-btn-secondary" href="direction/enseignement"><Icon Name="layers" Groesse="14" />Créer l'année scolaire</a>
            }
        </div>
    }
    @if (verwalter && jahrID != Guid.Empty)
    {
        <details class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><summary class="cursor-pointer text-base font-bold text-slate-900">Nouvelle période</summary>
            <div class="mt-4 grid gap-4 md:grid-cols-2">
                <label>Titre<input class="skoulou-input mt-1" maxlength="120" @bind="titel" /></label>
                <ModernDropdown TValue="int" @bind-Value="art" Options="Arten" Label="Type" />
                <label>Ordre (1 à 3 pour les trimestres)<input type="number" min="1" class="skoulou-input mt-1" @bind="reihenfolge" /></label>
                <label>Poids dans la moyenne annuelle<input type="number" min="0" max="100" step="0.01" class="skoulou-input mt-1" @bind="gewicht" disabled="@(art == 2)" /></label>
            </div>
            <p class="mt-2 text-sm text-slate-600">Un examen blanc / test ne compte jamais dans la moyenne annuelle.</p>
            <button type="button" class="sk-btn sk-btn-primary mt-3" disabled="@occupe" @onclick="PeriodeAsync">Créer la période</button>
        </details>
        <details class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><summary class="cursor-pointer text-base font-bold text-slate-900">Matières et coefficients</summary>
            <div class="mt-4 grid gap-4 md:grid-cols-2">
                <ModernDropdown TValue="Guid" @bind-Value="klasseID" Options="Options(unterricht?.Klassen ?? [])" Label="Classe" />
                <ModernDropdown TValue="Guid" @bind-Value="fachID" Options="Options(unterricht?.Faecher ?? [])" Label="Matière" />
                <label>Coefficient<input type="number" min="0.01" max="100" step="0.01" class="skoulou-input mt-1" @bind="koeffizient" /></label>
            </div>
            <button type="button" class="sk-btn sk-btn-primary mt-3" disabled="@occupe" @onclick="FachAsync">Enregistrer la matière</button>
        </details>
    }
    @if (daten is not null)
    {
        <ModernDropdown TValue="Guid" Value="periodeID" ValueChanged="WaehlePeriode" Options="PeriodenOptionen" Label="Période" Disabled="occupe" />
        @if (verwalter && periodeID != Guid.Empty)
        {
            <button type="button" class="rounded-lg border p-3" disabled="@occupe" @onclick="ClotureAsync">@(daten.Perioden.Single(x => x.Id == periodeID).IstGeschlossen ? "Rouvrir la période pour correction" : "Clôturer et verrouiller la période")</button>
            <details class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><summary class="cursor-pointer text-base font-bold text-slate-900">Composantes de la moyenne</summary>
                <p class="mt-2 text-sm text-slate-600">Définissez toutes les composantes avant de saisir les premières notes : interrogation, devoir, composition…</p>
                <div class="mt-4 grid gap-4 md:grid-cols-3">
                    <label>Intitulé<input class="skoulou-input mt-1" maxlength="80" @bind="komponente" /></label>
                    <label>Poids<input type="number" min="0.01" step="0.01" class="skoulou-input mt-1" @bind="komponentenGewicht" /></label>
                    <label>Barème<input type="number" min="0.01" step="0.01" class="skoulou-input mt-1" @bind="maximum" /></label>
                </div>
                <button type="button" class="sk-btn sk-btn-primary mt-3" disabled="@occupe" @onclick="KomponenteAsync">Ajouter la composante</button>
            </details>
        }
        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <h2 class="text-lg font-semibold">Saisie et correction</h2>
            <div class="mt-4 grid gap-4 md:grid-cols-2">
                <ModernDropdown TValue="Guid" Value="bewertungsFachID" ValueChanged="WaehleFach" Options="FachOptionen" Label="Classe et matière" Searchable="true" Disabled="occupe" />
                <ModernDropdown TValue="Guid" Value="bestandteilID" ValueChanged="WaehleBestandteil" Options="BestandteilOptionen" Label="Composante" Disabled="occupe" />
                <ModernDropdown TValue="Guid" Value="schuelerID" ValueChanged="WaehleSchueler" Options="SchuelerOptionen" Label="Élève" Searchable="true" Disabled="occupe" />
                <label>Note<input type="number" min="0" step="0.01" class="skoulou-input mt-1" @bind="punkte" /></label>
                <label>Appréciation (facultatif)<input class="skoulou-input mt-1" maxlength="300" @bind="bemerkung" /></label>
            </div>
            <button type="button" class="sk-btn sk-btn-primary mt-3" disabled="@(occupe || schuelerID == Guid.Empty || bestandteilID == Guid.Empty || bewertungsFachID == Guid.Empty)" @onclick="NoteAsync">Enregistrer la note</button>
        </section>
        <details class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <summary class="cursor-pointer font-semibold">Historique de la note sélectionnée</summary>
            <p class="mt-2 text-sm">Sélectionnez une matière, une composante et un élève. L'historique commence à l'activation de cette fonctionnalité ; les anciennes corrections ne peuvent pas être reconstituées.</p>
            <button type="button" class="mt-3 rounded-lg border p-3" disabled="@(occupe || schuelerID == Guid.Empty || bestandteilID == Guid.Empty || bewertungsFachID == Guid.Empty)" @onclick="HistorieAsync">Afficher / actualiser l'historique</button>
            @foreach (var changement in historie)
            {
                <article class="mt-3 break-words rounded-lg border p-3">
                    <p class="font-semibold">@changement.ErstelltAmUtc.ToString("dd/MM/yyyy HH:mm:ss") UTC · @changement.BearbeiterName</p>
                    <p>@(changement.AltePunkte?.ToString("0.##") ?? "Non saisie") → @changement.NeuePunkte.ToString("0.##")</p>
                    <p>Ancienne appréciation : @(changement.AlteBemerkung ?? "—")</p>
                    <p>Nouvelle appréciation : @(changement.NeueBemerkung ?? "—")</p>
                </article>
            }
        </details>
        @foreach (var resultat in Resultate)
        {
            <article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm"><strong>@resultat.Name</strong><p>@resultat.Ergebnis</p></article>
        }
    }
</div>
