@page "/direction"
@attribute [Authorize(Roles = "SchulLeiter,Koordinator")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits SkoulouApp.WebApp.Components.CancelableComponentBase

<PageTitle>Tableau de bord · SKOULOU</PageTitle>

<div class="mx-auto grid max-w-6xl gap-5">
    @if (laedt)
    {
        <div class="h-28 animate-pulse rounded-[1.25rem] bg-slate-200"></div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            @for (var i = 0; i < 4; i++)
            {
                <div class="h-28 animate-pulse rounded-2xl bg-slate-200"></div>
            }
        </div>
    }
    else if (cockpit is null)
    {
        <SeitenKopf Rubrik="Direction" Titel="Tableau de bord" IconName="school" />
        <div class="rounded-2xl border border-amber-200 bg-amber-50 p-5 text-sm text-amber-900">Aucun établissement n'est associé à votre compte. Contactez SKOULOU si votre établissement doit encore être validé.</div>
    }
    else
    {
        <SeitenKopf Rubrik="Tableau de bord" Titel="@cockpit.SchulName" IconName="school"
                    Untertitel="@($"{(string.IsNullOrWhiteSpace(cockpit.Stadt) ? "" : cockpit.Stadt + " · ")}{(cockpit.Schuljahr is null ? "Aucune année scolaire en cours" : "Année scolaire " + cockpit.Schuljahr)} · {Heute}")">
            <a href="schulleiter" class="inline-flex min-h-[2.6rem] items-center gap-2 rounded-xl bg-white/15 px-4 text-sm font-semibold text-white no-underline hover:bg-white/25"><Icon Name="settings" Groesse="16" />Gérer l'établissement</a>
        </SeitenKopf>

        @if (Aufgaben.Count > 0)
        {
            <section class="rounded-2xl border border-amber-200 bg-amber-50 p-4 sm:p-5" aria-label="À faire">
                <h2 class="mb-0 flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-amber-800"><Icon Name="bell" Groesse="16" />À faire</h2>
                <ul class="mb-0 mt-3 grid list-none gap-2 p-0">
                    @foreach (var (text, link, linkText) in Aufgaben)
                    {
                        <li class="flex flex-wrap items-center justify-between gap-2 rounded-xl bg-white px-4 py-3 text-sm text-slate-700 shadow-sm">
                            <span>@text</span>
                            <a href="@link" class="inline-flex items-center gap-1 font-semibold text-blue-700 no-underline hover:underline">@linkText<Icon Name="chevron-right" Groesse="16" /></a>
                        </li>
                    }
                </ul>
            </section>
        }

        <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" aria-label="Chiffres clés">
            <a href="schulleiter?onglet=eleves" class="rounded-2xl border border-slate-200 bg-white p-5 no-underline shadow-sm transition hover:shadow-md">
                <span class="flex items-center justify-between text-sm font-semibold text-slate-500">Élèves actifs<span class="grid h-9 w-9 place-items-center rounded-xl bg-blue-50 text-blue-700"><Icon Name="graduation" Groesse="18" /></span></span>
                <strong class="mt-2 block text-3xl font-extrabold tabular-nums text-slate-900">@cockpit.SchuelerAktiv</strong>
                @if (cockpit.SchuelerGesperrt > 0)
                {
                    <span class="text-xs text-slate-500">@cockpit.SchuelerGesperrt bloqué(s)</span>
                }
            </a>
            <a href="schulleiter?onglet=eleves" class="rounded-2xl border bg-white p-5 no-underline shadow-sm transition hover:shadow-md @(cockpit.AnmeldungenOffen > 0 ? "border-amber-300" : "border-slate-200")">
                <span class="flex items-center justify-between text-sm font-semibold text-slate-500">Inscriptions en attente<span class="grid h-9 w-9 place-items-center rounded-xl bg-amber-50 text-amber-700"><Icon Name="user-plus" Groesse="18" /></span></span>
                <strong class="mt-2 block text-3xl font-extrabold tabular-nums @(cockpit.AnmeldungenOffen > 0 ? "text-amber-700" : "text-slate-900")">@cockpit.AnmeldungenOffen</strong>
            </a>
            <a href="schulleiter?onglet=classes" class="rounded-2xl border border-slate-200 bg-white p-5 no-underline shadow-sm transition hover:shadow-md">
                <span class="flex items-center justify-between text-sm font-semibold text-slate-500">Classes<span class="grid h-9 w-9 place-items-center rounded-xl bg-teal-50 text-teal-700"><Icon Name="layers" Groesse="18" /></span></span>
                <strong class="mt-2 block text-3xl font-extrabold tabular-nums text-slate-900">@cockpit.Klassen</strong>
                <span class="text-xs text-slate-500">@cockpit.LaufendeZyklen cycle(s) en cours</span>
            </a>
            <a href="schulleiter?onglet=equipe" class="rounded-2xl border border-slate-200 bg-white p-5 no-underline shadow-sm transition hover:shadow-md">
                <span class="flex items-center justify-between text-sm font-semibold text-slate-500">Enseignants<span class="grid h-9 w-9 place-items-center rounded-xl bg-slate-100 text-slate-700"><Icon Name="users" Groesse="18" /></span></span>
                <strong class="mt-2 block text-3xl font-extrabold tabular-nums text-slate-900">@cockpit.Lehrkraefte</strong>
            </a>
        </section>

        <section class="grid gap-4 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
            @if (cockpit.FinanzenSichtbar)
            {
                <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
                    <div class="flex items-center justify-between gap-3">
                        <h2 class="mb-0 flex items-center gap-2 text-base font-bold text-slate-900"><Icon Name="wallet" Groesse="18" />Frais de scolarité</h2>
                        <a href="finanzen" class="text-sm font-semibold text-blue-700 no-underline hover:underline">Comptabilité</a>
                    </div>
                    <div class="mt-4 grid gap-4 sm:grid-cols-3">
                        <div><p class="mb-0 text-xs font-semibold text-slate-500">Encaissés</p><p class="mb-0 mt-1 text-xl font-extrabold tabular-nums text-emerald-700">@Betrag(cockpit.SchulgebuehrenEingenommen)</p></div>
                        <div><p class="mb-0 text-xs font-semibold text-slate-500">Reste à encaisser (cycles en cours)</p><p class="mb-0 mt-1 text-xl font-extrabold tabular-nums text-amber-700">@Betrag(cockpit.SchulgebuehrenOffen)</p></div>
                        <div><p class="mb-0 text-xs font-semibold text-slate-500">Solde de l'établissement</p><p class="mb-0 mt-1 text-xl font-extrabold tabular-nums @(cockpit.Kontostand < 0 ? "text-rose-700" : "text-slate-900")">@Betrag(cockpit.Kontostand)</p></div>
                    </div>
                    @if (cockpit.SchulgebuehrenEingenommen + cockpit.SchulgebuehrenOffen > 0)
                    {
                        var anteil = (int)Math.Round(cockpit.SchulgebuehrenEingenommen * 100m / (cockpit.SchulgebuehrenEingenommen + cockpit.SchulgebuehrenOffen));
                        <div class="mt-5">
                            <div class="flex justify-between text-xs font-semibold text-slate-500"><span>Part encaissée</span><span>@anteil %</span></div>
                            <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-slate-200"><div class="h-full rounded-full bg-emerald-500" style="width: @(anteil)%"></div></div>
                        </div>
                    }
                </article>
            }
            else
            {
                <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
                    <h2 class="mb-0 flex items-center gap-2 text-base font-bold text-slate-900"><Icon Name="wallet" Groesse="18" />Finances</h2>
                    <p class="mb-0 mt-3 text-sm text-slate-500">Les chiffres financiers sont réservés à la direction et aux coordinateurs autorisés.</p>
                </article>
            }

            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
                <h2 class="mb-0 flex items-center gap-2 text-base font-bold text-slate-900"><Icon Name="calendar" Groesse="18" />Aujourd'hui</h2>
                @if (cockpit.AnwesenheitHeuteErfasst)
                {
                    <div class="mt-4 grid grid-cols-2 gap-4">
                        <div><p class="mb-0 text-xs font-semibold text-slate-500">Absences</p><p class="mb-0 mt-1 text-2xl font-extrabold tabular-nums @(cockpit.AbwesendHeute > 0 ? "text-amber-700" : "text-slate-900")">@cockpit.AbwesendHeute</p></div>
                        <div><p class="mb-0 text-xs font-semibold text-slate-500">Retards</p><p class="mb-0 mt-1 text-2xl font-extrabold tabular-nums text-slate-900">@cockpit.VerspaetetHeute</p></div>
                    </div>
                }
                else
                {
                    <p class="mb-0 mt-3 text-sm text-slate-500">Aucune présence n'a encore été saisie aujourd'hui.</p>
                }
                <div class="mt-4 flex items-center justify-between gap-3 border-t border-slate-200 pt-4 text-sm">
                    <span class="text-slate-600"><strong class="tabular-nums text-slate-900">@cockpit.BulletinsVeroeffentlicht</strong> bulletin(s) publié(s) cette année</span>
                    <a href="bulletins" class="font-semibold text-blue-700 no-underline hover:underline">Bulletins</a>
                </div>
            </article>
        </section>

        @if (cockpit.KlassenListe.Count > 0)
        {
            <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6" aria-label="Documents">
                <h2 class="mb-0 flex items-center gap-2 text-base font-bold text-slate-900"><Icon Name="id-card" Groesse="18" />Cartes d'élève</h2>
                <p class="mb-0 mt-1 text-sm text-slate-500">Une feuille A4 avec dix cartes à découper par classe : photo de profil, matricule et QR code.</p>
                <div class="mt-4 grid gap-3 sm:grid-cols-[minmax(0,18rem)_auto] sm:items-end">
                    <ModernDropdown TValue="Guid" @bind-Value="kartenKlasseID" Options="KlassenOptionen" Label="Classe" Searchable="true" />
                    <a href="@(kartenKlasseID == Guid.Empty ? null : $"direction/cartes/{kartenKlasseID}")" target="_blank" rel="noopener"
                       class="inline-flex min-h-[2.75rem] items-center justify-center gap-2 rounded-xl px-4 text-sm font-bold no-underline @(kartenKlasseID == Guid.Empty ? "pointer-events-none bg-slate-100 text-slate-400" : "bg-blue-700 text-white")"><Icon Name="printer" Groesse="16" />Imprimer les cartes</a>
                </div>
            </section>
        }

        <section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4" aria-label="Accès rapides">
            @foreach (var (icon, titel, link) in Schnellzugriffe)
            {
                <a href="@link" class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-800 no-underline shadow-sm transition hover:border-blue-200 hover:text-blue-700">
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-slate-100 text-slate-700"><Icon Name="@icon" Groesse="18" /></span>@titel
                </a>
            }
        </section>
    }
</div>
