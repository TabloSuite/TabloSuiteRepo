@page "/teacher/lessons"
@attribute [Authorize(Policy = "RequireTeacher")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits SkoulouApp.WebApp.Components.CancelableComponentBase
@using SkoulouApp.Core.Models.TeacherLessons
@using SkoulouApp.WebApp.Components.Shared
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Cours &amp; supports</PageTitle>

<section class="grid gap-6">
    <Toast Message="@statusMessage" MessageChanged="v => statusMessage = v" Kind="Toast.ToastKind.Success" />
    <Toast Message="@videoUploadMessage" MessageChanged="v => videoUploadMessage = v" Kind="Toast.ToastKind.Success" />
    <Toast Message="@videoUploadError" MessageChanged="v => videoUploadError = v" Kind="Toast.ToastKind.Error" />
    <Toast Message="@fehlerMeldung" MessageChanged="v => fehlerMeldung = v" Kind="Toast.ToastKind.Error" />

    <div class="skoulou-hero rounded-[1.25rem] px-5 py-4 text-white shadow-2xl sm:px-6 sm:py-5">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-100">@(istDirektion ? "Espace direction" : "Espace enseignant")</p>
        <h1 class="mt-3 text-3xl font-black">Cours &amp; supports de cours</h1>
        <p class="mt-3 max-w-2xl text-sm leading-7 text-indigo-50">@(ErfasstFuerAnderenLehrer
            ? $"Vous créez et gérez les supports de cours de {FuerLehrerName} à sa place. Ils sont enregistrés à son nom et marqués « {DirektionsErfassungService.Kennzeichnung} »."
            : canManageLessons
                ? "Créez des supports de cours (scripts) page par page pour chaque niveau. Tous les élèves du niveau concerné pourront les consulter."
                : "Vous voyez ici tous les supports publiés des enseignants de vos écoles en lecture seule.")</p>
    </div>

    @if (istDirektion && !isEditing)
    {
        <LehrerFuerDirektionAuswahl Lehrer="lehrerAuswahl" Value="fuerLehrerId" ValueChanged="SetFuerLehrerAsync">
            <a class="sk-btn sk-btn-primary sk-btn-sm" href="@FuerLehrerHref("/teacher/lesson-exercises")"><Icon Name="book-open" Groesse="14" />Leçons et exercices de @FuerLehrerName</a>
            <a class="sk-btn sk-btn-primary sk-btn-sm" href="@FuerLehrerHref("/teacher-exams")"><Icon Name="exam" Groesse="14" />Examens de @FuerLehrerName</a>
        </LehrerFuerDirektionAuswahl>
    }

    @if (!canManageLessons)
    {
        <div class="rounded-3xl border border-slate-200 bg-white p-2 shadow-sm">
            <div class="flex flex-wrap gap-2" role="tablist" aria-label="Contenus pédagogiques direction">
                <button type="button"
                        role="tab"
                        aria-selected="@(IsDirectionLessonsTabActive ? "true" : "false")"
                        class="rounded-2xl border px-4 py-2 text-xs font-bold transition sm:text-sm @GetDirectionTabClass(DirectionTabLessons)"
                        @onclick="() => SetDirectionTabAsync(DirectionTabLessons)">
                    Leçons + exercices
                </button>
                <button type="button"
                        role="tab"
                        aria-selected="@(IsDirectionExamsTabActive ? "true" : "false")"
                        class="rounded-2xl border px-4 py-2 text-xs font-bold transition sm:text-sm @GetDirectionTabClass(DirectionTabExams)"
                        @onclick="() => SetDirectionTabAsync(DirectionTabExams)">
                    Examens
                </button>
            </div>
        </div>

        <div class="grid gap-3 rounded-3xl border border-slate-200 bg-white p-4 sm:grid-cols-3">
            <ModernDropdown TValue="Guid?"
                            Label="École"
                            Value="directionSchoolFilterId"
                            ValueChanged="SetDirectionSchoolFilterAsync"
                            Options="DirectionSchoolFilterOptions" EinzigeOptionFest="true" />
            <ModernDropdown TValue="Guid?"
                            Label="Classe"
                            Value="directionKlasseFilterId"
                            ValueChanged="SetDirectionKlasseFilterAsync"
                            Options="DirectionKlasseFilterOptions" />
            <ModernDropdown TValue="string?"
                            Label="Enseignant"
                            Value="directionTeacherFilter"
                            ValueChanged="SetDirectionTeacherFilterAsync"
                            Options="DirectionTeacherFilterOptions"
                            Searchable="true"
                            SearchPlaceholder="Rechercher un enseignant..." />
        </div>
    }

    @if (!isEditing)
    {
        @if (!canManageLessons && IsDirectionExamsTabActive)
        {
            <div class="rounded-3xl border border-violet-200 bg-violet-50 p-5 text-violet-900">
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-violet-700">Direction · Examens</p>
                <h2 class="mt-1 text-lg font-black">Création et gestion des examens PDF</h2>
                <p class="mt-2 text-sm leading-6">La création, modification et suppression des examens se fait dans l’espace dédié.</p>
            </div>

            <div class="grid gap-3">
                @if (VisibleSharedDirectionExams.Count == 0)
                {
                    <div class="rounded-2xl bg-white p-4 text-sm text-slate-600 shadow ring-1 ring-slate-100">
                        @if (sharedDirectionExams.Count == 0)
                        {
                            <span>Aucun examen enseignant n'est encore partagé avec la direction.</span>
                        }
                        else
                        {
                            <span>Aucun examen partagé ne correspond aux filtres sélectionnés.</span>
                        }
                    </div>
                }
                else
                {
                    <div class="grid gap-4">
                        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-violet-700">Examens enseignants partagés</p>
                        @foreach (var exam in VisibleSharedDirectionExams)
                        {
                            <article class="rounded-3xl bg-white p-5 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
                                <div class="flex flex-wrap items-start justify-between gap-4">
                                    <div>
                                        <div class="flex flex-wrap items-center gap-2">
                                            <span class="rounded-full bg-violet-50 px-3 py-1 text-xs font-bold text-violet-700">@exam.CourseCode</span>
                                            <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-bold text-indigo-700">Examen</span>
                                            <span class="rounded-full bg-cyan-50 px-3 py-1 text-xs font-bold text-cyan-700">Partagé par @exam.AuthorName</span>
                                            @if (exam.IstVonDirektionErfasst)
                                            {
                                                <DirektionErfasstMarke />
                                            }
                                        </div>
                                        <h2 class="mt-2 text-lg font-bold text-slate-900">@exam.Title</h2>
                                        <p class="mt-2 text-xs text-slate-500">@GetDirectionSchoolName(exam) · Classe: @exam.CourseCode · Enseignant: @exam.AuthorName</p>
                                    </div>
                                    <div class="flex flex-wrap items-center gap-2">
                                        <a class="sk-btn sk-btn-secondary sk-btn-sm" href="/teacher-exams/@exam.ContentId/view?scope=shared&from=teacher-lessons">
                                            Voir le contenu
                                        </a>
                                        <a class="sk-btn sk-btn-secondary sk-btn-sm" href="/teacher-exams/@exam.ContentId/pdf-file?solutions=false" target="_blank">
                                            Exporter PDF
                                        </a>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        }

        @if (canManageLessons || IsDirectionLessonsTabActive)
        {
        @if (canManageLessons)
        {
            <div class="flex justify-end">
                <button type="button"
                        class="skoulou-btn-accent inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold shadow-lg transition"
                        @onclick="StartCreate">
                    + Nouveau cours
                </button>
            </div>
        }

        @if (lessons is null)
        {
            <div class="rounded-[2rem] bg-white p-8 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
                <div class="flex items-center gap-3 text-slate-600">
                    <ProgressRing Size="1.5rem" Label="Chargement des leçons" />
                    <p class="text-sm">Chargement...</p>
                </div>
            </div>
        }
        else
        {
            @if ((canManageLessons ? lessons.Count : VisibleLessons.Count) == 0)
            {
                <div class="rounded-[2rem] bg-white p-8 text-center shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
                    <p class="text-sm text-slate-600">@(canManageLessons
                        ? (ErfasstFuerAnderenLehrer ? $"Aucun support de cours pour {FuerLehrerName} pour l'instant." : "Aucun cours créé pour l'instant.")
                        : lessons.Count == 0
                            ? "Aucune leçon d'enseignant (supports ou leçons + exercices) n'est disponible dans vos écoles pour le moment."
                            : "Aucun contenu ne correspond aux filtres sélectionnés.")</p>
                </div>
            }
            else
            {
            <div class="grid gap-4">
                @foreach (var item in VisibleLessons)
                {
                    <article class="rounded-3xl bg-white p-5 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
                        <div class="flex flex-wrap items-start justify-between gap-4">
                            <div>
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="rounded-full bg-indigo-50 px-3 py-1 text-xs font-bold text-indigo-700">@item.CourseCode</span>
                                         @if (!string.IsNullOrWhiteSpace(item.FachName))
                                         {
                                             <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">@item.FachName</span>
                                         }
                                    @if (item.IsPublished)
                                    {
                                        <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700">Publié</span>
                                    }
                                    else
                                    {
                                        <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600">Brouillon</span>
                                    }
                                    @if (item.IsSharedWithSchool)
                                    {
                                        <span class="rounded-full bg-violet-50 px-3 py-1 text-xs font-bold text-violet-700">Visible direction</span>
                                    }
                                    @if (!IsOwnLesson(item) && !string.IsNullOrWhiteSpace(GetLessonTeacherName(item)))
                                    {
                                        <span class="rounded-full bg-cyan-50 px-3 py-1 text-xs font-bold text-cyan-700">Partagé par @GetLessonTeacherName(item)</span>
                                    }
                                    @if (item.IstVonDirektionErfasst)
                                    {
                                        <DirektionErfasstMarke />
                                    }
                                </div>
                                <h2 class="mt-2 text-lg font-bold text-slate-900">@item.Title</h2>
                                <p class="mt-1 text-sm text-slate-500">@item.Summary</p>
                                @if (!canManageLessons)
                                {
                                    <p class="mt-2 text-xs text-slate-500">@GetLessonSchoolName(item) · @GetLessonKlasseLabel(item) · Enseignant: @GetLessonTeacherName(item)</p>
                                }
                                <p class="mt-2 text-xs text-slate-400">@item.PageCount page(s)</p>
                            </div>
                            <div class="flex flex-wrap items-center gap-2">
                                @if (IsOwnLesson(item) && canManageLessons)
                                {
                                    <button type="button" class="sk-btn sk-btn-secondary sk-btn-sm" @onclick="() => StartEditAsync(item.Id)">Modifier</button>
                                    <button type="button" class="sk-btn sk-btn-secondary sk-btn-sm" @onclick="() => OpenCopyModal(item)">Copier vers une classe</button>
                                }
                                else
                                {
                                    <a class="sk-btn sk-btn-secondary sk-btn-sm" href="@GetDirectionReadOnlyHref(item)">Voir le contenu</a>
                                }
                                @if (item.IsPdfExportEnabled)
                                {
                                    <a class="sk-btn sk-btn-secondary sk-btn-sm" href="@GetDirectionPdfHref(item)" target="_blank">Exporter PDF</a>
                                }
                                @if (IsOwnLesson(item) && canManageLessons)
                                {
                                    <button type="button" class="sk-btn sk-btn-secondary sk-btn-sm" @onclick="() => TogglePublishAsync(item)">@(item.IsPublished ? "Dépublier" : "Publier")</button>
                                    <button type="button" class="sk-btn sk-btn-danger sk-btn-sm" @onclick="() => DeleteAsync(item.Id)">Supprimer</button>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
            }
        }
        }
    }
    else if (form is not null)
    {
        <div class="lesson-editor-shell rounded-[2rem] bg-slate-100/80 p-4 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 sm:p-6">
            @if (ErfasstFuerAnderenLehrer || form.IstVonDirektionErfasst)
            {
                <div class="mb-3 flex flex-wrap items-center gap-2 rounded-2xl border border-violet-200 bg-violet-50 px-4 py-2 text-sm text-violet-900">
                    @if (ErfasstFuerAnderenLehrer)
                    {
                        <span>Saisie pour <strong>@FuerLehrerName</strong></span>
                    }
                    <DirektionErfasstMarke />
                </div>
            }
            <div class="lesson-editor-metadata grid gap-2 bg-white p-3 sm:grid-cols-2 sm:rounded-2xl">
                <label class="block">
                    <span class="text-sm font-semibold text-slate-700">Titre</span>
                    <input type="text" class="skoulou-input mt-1 text-sm" @bind="form.Title" />
                </label>
                <ModernDropdown TValue="Guid?" Label="École" Value="selectedSchoolId" ValueChanged="SetLessonSchoolAsync" Options="SchoolOptions" EinzigeOptionFest="true" />
                <ModernDropdown TValue="Guid?" Label="Niveau" Value="form.KlasseId" ValueChanged="SetLessonKlasseAsync" Options="KlasseOptions" />
                <label class="block sm:col-span-2">
                    <span class="text-sm font-semibold text-slate-700">Résumé (optionnel)</span>
                    <input type="text" class="skoulou-input mt-1 text-sm" @bind="form.Summary" />
                </label>
                <div class="sm:col-span-2 rounded-2xl border border-indigo-100 bg-indigo-50/40 p-3">
                    <div class="grid gap-3 sm:grid-cols-[1fr_auto] sm:items-end">
                        <ModernDropdown TValue="Guid?" Label="Matière" Value="form.FachId" ValueChanged="SetLessonFachAsync" Options="FachOptions" />
                        <div class="grid gap-2 sm:grid-cols-[1fr_auto]">
                            <input type="text" class="skoulou-input text-sm" @bind="newFachName" placeholder="Nouvelle matière" />
                            <AsyncActionButton Class="sk-btn sk-btn-primary sk-btn-sm" Disabled="@string.IsNullOrWhiteSpace(newFachName)" IsBusy="@isAddingFach" BusyLabel="Ajout..." OnClick="AddFachAsync">Ajouter</AsyncActionButton>
                        </div>
                    </div>
                </div>
                <label class="block sm:col-span-2">
                    <span class="text-sm font-semibold text-slate-700">Thème du cours (optionnel)</span>
                    <input type="text" class="skoulou-input mt-1 text-sm" @bind="form.CourseTheme" placeholder="Ex. : Se présenter" />
                </label>
                <div class="lesson-editor-options sm:col-span-2">
                    <label class="flex items-center gap-2">
                        <input type="checkbox" class="h-4 w-4 rounded border-slate-300" @bind="form.IsPublished" />
                        <span class="text-sm font-semibold text-slate-700">Publier pour les élèves</span>
                    </label>
                    <label class="flex items-center gap-2">
                        <input type="checkbox" class="h-4 w-4 rounded border-slate-300" @bind="form.IsSharedWithSchool" />
                        <span class="text-sm font-semibold text-slate-700">Visible par la direction</span>
                    </label>
                    <label class="flex items-center gap-2">
                        <input type="checkbox" class="h-4 w-4 rounded border-slate-300" @bind="form.IsPdfExportEnabled" />
                        <span class="text-sm font-semibold text-slate-700">Autoriser l'export PDF</span>
                    </label>
                </div>
                <div class="sm:col-span-2 rounded-2xl border border-cyan-100 bg-cyan-50/60 p-4">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div>
                            <p class="text-sm font-black text-cyan-950">Vidéo de cours optionnelle</p>
                            <p class="mt-1 text-xs leading-5 text-cyan-800">Choisissez une vidéo enregistrée ou téléversez-en une nouvelle. La vidéo n'apparaît pas dans le PDF. Durée maximale : 1 heure.</p>
                        </div>
                        @if (form.VideoAssetId.HasValue)
                        {
                            <button type="button" class="sk-btn sk-btn-danger sk-btn-sm" @onclick="RemoveVideo">Retirer la vidéo</button>
                        }
                    </div>
                    @if (form.VideoAssetId.HasValue)
                    {
                        <div class="mt-3 rounded-xl bg-white px-4 py-3 text-sm font-semibold text-cyan-900 ring-1 ring-cyan-100">
                            <Icon Name="video" Groesse="16" /> @form.VideoDisplayName
                            @if (form.VideoDuration.HasValue)
                            {
                                <span class="text-cyan-600"> · @Math.Round(form.VideoDuration.Value.TotalMinutes) min</span>
                            }
                        </div>
                    }
                    <button type="button" class="sk-btn sk-btn-primary mt-4" @onclick="() => videoLibraryOpen = true">Choisir ou ajouter une vidéo</button>
                    @if (ShowVideoUploadProgress)
                    {
                        <div class="mt-4 rounded-2xl bg-white p-3 ring-1 ring-cyan-100">
                            <div class="flex items-center justify-between gap-3 text-xs font-semibold text-cyan-900">
                                <span>Téléversement en cours</span>
                                <span>@VideoUploadProgressLabel</span>
                            </div>
                            <div class="mt-2 h-3 overflow-hidden rounded-full bg-cyan-100">
                                <div class="h-full rounded-full bg-cyan-700 transition-all duration-300" style="@($"width:{VideoUploadPercent}%")"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="lesson-editor-pages mt-6">
                <section class="lesson-editor-doc">
                    <RichTextEditor @ref="lessonEditor"
                                    @bind-Value="editorHtml"
                                    EnableImages="true"
                                    RequestImageLibrary="OpenImageLibrary"
                                    ImageLibraryTargetRequested="SetImageLibraryTarget"
                                    Paged="true"
                                    OnPageCount="OnPageCountChanged"
                                    DefaultFont="inter"
                                    MinEditorHeightRem="28"
                                    Placeholder="Rédigez le contenu du cours..." />
                </section>
                <p class="lesson-editor-pagecount">@pageCount page(s)</p>
            </div>

<AzureBlobImageLibrary Open="imageLibraryOpen"
                       OpenChanged="@(open => imageLibraryOpen = open)"
                       ImageSelected="InsertLibraryImageAsync" />
<AzureBlobImageLibrary Open="videoLibraryOpen" OpenChanged="@(open => videoLibraryOpen = open)" VideoMode="true" ImageSelected="ChooseLibraryVideoAsync" />

            <div class="mt-6 flex flex-wrap gap-2">
                <button type="button" class="skoulou-btn-accent rounded-full px-6 py-2.5 text-sm font-semibold shadow-lg transition disabled:opacity-50" @onclick="SaveAsync" disabled="@isSaving">Enregistrer</button>
                <button type="button" class="sk-btn sk-btn-secondary" @onclick="CancelEdit">Retour</button>
            </div>
        </div>
    }
    <ModalDialog Open="copyModalOpen"
                 OpenChanged="OnCopyModalOpenChanged"
                 Title="Copier le support"
                 Eyebrow="Nouvelle copie"
                 ErrorMessage="@copyErrorMessage"
                 MaxWidthClass="max-w-xl">
                <div class="grid gap-4">
                    <p class="text-sm text-slate-600">Créez une nouvelle copie en brouillon dans une autre classe. Le support original reste inchangé.</p>
                    <ModernDropdown TValue="Guid?"
                                    Label="Classe cible"
                                    Value="copyTargetKlasseId"
                                    ValueChanged="(Guid? value) => copyTargetKlasseId = value"
                                    Options="CopyTargetKlasseOptions" />
                    <label class="inline-flex items-center gap-2 rounded-xl bg-indigo-50 px-3 py-2 text-sm font-semibold text-indigo-900 ring-1 ring-indigo-100">
                        <InputCheckbox @bind-Value="copyPublishDirectly" class="h-4 w-4 rounded border-indigo-300" />
                        <span>Publier directement la copie</span>
                    </label>
                    <div class="flex justify-end gap-2">
                        <button type="button" class="sk-btn sk-btn-secondary" @onclick="() => OnCopyModalOpenChanged(false)">Annuler</button>
                        <AsyncActionButton Class="sk-btn sk-btn-primary" Disabled="@(copyTargetKlasseId is null)" IsBusy="@isCopying" BusyLabel="Copie..." OnClick="CopyLessonAsync">Créer la copie</AsyncActionButton>
                    </div>
                </div>
    </ModalDialog>
</section>
