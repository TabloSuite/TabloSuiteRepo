@page "/student/lessons"
@attribute [Authorize(Policy = "RequireStudent")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits SkoulouApp.WebApp.Components.CancelableComponentBase
@using SkoulouApp.Core.Models.Student

<PageTitle>Mes leçons · SKOULOU</PageTitle>

@if (lessons is null)
{
    <SkeletonLoader />
}
else
{
    <div class="student-learning-page grid gap-5">
        <SeitenKopf Rubrik="Espace élève" Titel="Mes leçons" IconName="book-open"
                    Untertitel="Les leçons, supports et exercices publiés pour votre classe. Vos résultats sont enregistrés automatiquement." />

        @if (lessons.Count == 0)
        {
            <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
                <h2 class="mb-0 text-base font-bold text-slate-900">Aucune leçon disponible</h2>
                <p class="mb-0 mt-2 text-sm text-slate-600">Aucun contenu n'est encore publié pour votre classe. Si nécessaire, demandez à la direction de vérifier votre affectation.</p>
            </div>
        }
        else
        {
            <section class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4" aria-label="Ma progression">
                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                    <span class="text-sm font-semibold text-slate-500">Leçons terminées</span>
                    <strong class="mt-1 block text-3xl font-extrabold tabular-nums text-slate-900">@completedCount <span class="text-lg font-bold text-slate-400">/ @lessons.Count</span></strong>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                    <span class="text-sm font-semibold text-slate-500">Exercices résolus</span>
                    <strong class="mt-1 block text-3xl font-extrabold tabular-nums text-slate-900">@solvedExercises <span class="text-lg font-bold text-slate-400">/ @totalExercises</span></strong>
                </div>
                <div class="col-span-2 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:col-span-1">
                    <span class="flex items-center justify-between text-sm font-semibold text-slate-500">Progression<span class="tabular-nums text-slate-900">@overallPercent %</span></span>
                    <div class="mt-4 h-2.5 w-full overflow-hidden rounded-full bg-slate-100">
                        <div class="h-full rounded-full bg-emerald-500 transition-all duration-500" style="width:@(overallPercent)%"></div>
                    </div>
                </div>
            </section>

            <div class="grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                <div class="grid gap-3 md:grid-cols-12 md:items-end">
                    <label class="m-0 md:col-span-12 lg:col-span-4">
                        <span class="skoulou-label">Rechercher</span>
                        <span class="relative block">
                            <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"><Icon Name="search" Groesse="18" /></span>
                            <input type="text" class="skoulou-input" style="padding-left: 2.6rem" placeholder="Titre, classe, résumé, matière…" @bind="searchTerm" @bind:event="oninput" />
                        </span>
                    </label>
                    <ModernDropdown TValue="Guid?"
                                    Label="Enseignant"
                                    Value="selectedTeacherId"
                                    ValueChanged="SetSelectedTeacherAsync"
                                    Options="TeacherFilterOptions"
                                    ContainerClass="md:col-span-5 lg:col-span-3"
                                    Searchable="true"
                                    SearchPlaceholder="Rechercher un enseignant..." />
                    <ModernDropdown TValue="string"
                                    Label="Matière"
                                    Value="selectedFach"
                                    ValueChanged="SetSelectedFachAsync"
                                    Options="FachFilterOptions"
                                    ContainerClass="md:col-span-5 lg:col-span-3"
                                    Searchable="true"
                                    SearchPlaceholder="Rechercher une matière..." />
                    <ModernDropdown TValue="string"
                                    Label="Statut"
                                    Value="selectedStatus"
                                    ValueChanged="SetSelectedStatusAsync"
                                    Options="StatusFilterOptions"
                                    ContainerClass="md:col-span-2" />
                </div>
                <div class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-3">
                    <div class="inline-flex rounded-xl border border-slate-200 bg-slate-50 p-1" role="tablist" aria-label="Affichage des leçons">
                        <button type="button" role="tab" aria-selected="@(IsPathView ? "true" : "false")"
                                class="inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-semibold @(IsPathView ? "bg-white text-blue-800 shadow-sm" : "text-slate-500 hover:text-slate-800")"
                                @onclick="() => ToggleView(true)">
                            <Icon Name="trend-up" Groesse="16" />Parcours
                        </button>
                        <button type="button" role="tab" aria-selected="@(!IsPathView ? "true" : "false")"
                                class="inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-sm font-semibold @(!IsPathView ? "bg-white text-blue-800 shadow-sm" : "text-slate-500 hover:text-slate-800")"
                                @onclick="() => ToggleView(false)">
                            <Icon Name="clipboard" Groesse="16" />Liste
                        </button>
                    </div>
                    <span class="text-sm font-semibold text-slate-500">@VisibleCount leçon(s) affichée(s)</span>
                    <div class="flex items-center gap-2">
                        <label class="m-0 text-sm font-semibold text-slate-600" for="lecon-numero">Aller à la leçon n°</label>
                        <input id="lecon-numero" type="number" min="1" max="@OrderedLessons.Count" class="skoulou-input" style="width: 5.5rem" @bind="lessonJumpNumber" @bind:event="oninput" />
                        <button type="button" class="sk-btn sk-btn-secondary min-h-[2.75rem]" disabled="@(!CanJumpToLesson)" @onclick="JumpToLesson">Ouvrir</button>
                    </div>
                </div>
            </div>

            @if (IsPathView)
            {
                <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
                    <div class="lesson-path">
                        @foreach (var lesson in VisibleLessons)
                        {
                            var status = GetPathNodeStatus(lesson);
                            <div class="lesson-path-item lesson-path-item--@status card-stack-enter">
                                <div class="lesson-path-connector"></div>
                                <div class="lesson-path-node lesson-path-node--@status" aria-hidden="true">
                                    @if (status == "completed")
                                    {
                                        <span>✓</span>
                                    }
                                    else if (status == "locked")
                                    {
                                        <span><Icon Name="lock" Groesse="16" /> </span>
                                    }
                                    else
                                    {
                                        <span>@lesson.Order</span>
                                    }
                                </div>
                                <div class="lesson-path-card rounded-2xl border border-slate-200 bg-white p-4 transition duration-200 hover:border-blue-200 hover:shadow-md">
                                    <div class="flex flex-wrap items-start justify-between gap-3">
                                        <div>
                                            <p class="mb-0 text-xs font-semibold text-slate-500">@lesson.CourseCode@(string.IsNullOrWhiteSpace(lesson.FachName) ? "" : " · " + lesson.FachName)</p>
                                            <h2 class="mb-0 mt-1 text-base font-bold text-slate-900">@lesson.Title</h2>
                                        </div>
                                        @if (status == "current")
                                        {
                                            <Badge Accent="blue">En cours</Badge>
                                        }
                                        else if (status == "completed")
                                        {
                                            <Badge Accent="emerald">Terminé</Badge>
                                        }
                                    </div>
                                    <p class="mb-0 mt-2 text-sm text-slate-600">@lesson.Summary</p>
                                    @if (!string.IsNullOrWhiteSpace(lesson.TeacherName))
                                    {
                                        <p class="mb-0 mt-1 text-xs text-slate-500">Par @lesson.TeacherName</p>
                                    }
                                    @if (lesson.ExerciseSubmissionDueAtUtc is DateTime dueAtUtc)
                                    {
                                        var isOpen = dueAtUtc > DateTime.UtcNow;
                                        <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
                                            <span class="rounded-full px-3 py-1 font-bold ring-1 @(isOpen ? "bg-emerald-50 text-emerald-800 ring-emerald-200" : "bg-rose-50 text-rose-800 ring-rose-200")">@(isOpen ? "Réponses ouvertes" : "Date limite passée")</span>
                                            <span class="font-semibold text-slate-600">@(isOpen ? "Envoyer les réponses avant le" : "Envoi terminé le") @dueAtUtc.ToLocalTime().ToString("dd/MM/yyyy à HH:mm")</span>
                                        </div>
                                    }
                                    else if (lesson.ExerciseCount > 0)
                                    {
                                        <p class="mt-3 inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600 ring-1 ring-slate-200">Aucune date limite fixée pour les exercices</p>
                                    }
                                    <div class="mt-3">
                                        <div class="flex items-center justify-between text-sm font-semibold text-slate-500">
                                            <span>@lesson.CorrectExerciseCount / @lesson.ExerciseCount exercices</span>
                                            <span>@lesson.ProgressPercent %</span>
                                        </div>
                                        <div class="mt-1 flex items-center justify-between text-sm font-semibold text-slate-500">
                                            <span>Points de la leçon</span>
                                            <span>@lesson.ExercisePointsEarned / @lesson.ExercisePointsTotal</span>
                                        </div>
                                        <div class="mt-1 h-2 w-full overflow-hidden rounded-full bg-slate-100">
                                            <div class="h-full rounded-full bg-emerald-500 transition-all duration-300" style="width:@(lesson.ProgressPercent)%"></div>
                                        </div>
                                    </div>
                                    <button type="button"
                                            class="sk-btn sk-btn-primary mt-4"
                                            disabled="@(!lesson.IsUnlocked)"
                                            @onclick="() => OpenLesson(lesson.LessonId)">
                                        @GetLessonActionText(lesson)
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
                <DataListPanel Items="lessons"
                               PageSize="10"
                               SearchPlaceholder="Rechercher une leçon..."
                               EmptyText="Aucune leçon correspondante."
                               ResultLabelSingular="leçon"
                               ResultLabelPlural="leçons"
                               Filter="@((LessonListItem l, string term) => Contains(l.Title, term) || Contains(l.CourseCode, term) || Contains(l.Summary, term))">
                    <div class="grid gap-4 xl:grid-cols-2">
                        @foreach (var lesson in context.Where(PassesSearchAndFilters))
                        {
                    <article class="card-stack-enter flex flex-col rounded-2xl border border-slate-200 bg-white p-4 transition duration-200 hover:border-blue-200 hover:shadow-md">
                        <div class="flex flex-wrap items-start justify-between gap-3">
                            <div>
                                <p class="mb-0 text-xs font-semibold text-slate-500">@lesson.CourseCode@(string.IsNullOrWhiteSpace(lesson.FachName) ? "" : " · " + lesson.FachName)</p>
                                <h2 class="mb-0 mt-1 text-base font-bold text-slate-900">@lesson.Title</h2>
                            </div>
                            <Badge Accent="@(lesson.IsCompleted ? "emerald" : "slate")">
                                @(lesson.IsCompleted ? "Terminé" : "À faire")
                            </Badge>
                        </div>
                        <p class="mb-0 mt-2 text-sm text-slate-600">@lesson.Summary</p>
                        @if (!string.IsNullOrWhiteSpace(lesson.TeacherName))
                        {
                            <p class="mb-0 mt-1 text-xs text-slate-500">Par @lesson.TeacherName</p>
                        }
                        @if (lesson.ExerciseSubmissionDueAtUtc is DateTime dueAtUtc)
                        {
                            var isOpen = dueAtUtc > DateTime.UtcNow;
                            <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
                                <span class="rounded-full px-3 py-1 font-bold ring-1 @(isOpen ? "bg-emerald-50 text-emerald-800 ring-emerald-200" : "bg-rose-50 text-rose-800 ring-rose-200")">@(isOpen ? "Réponses ouvertes" : "Date limite passée")</span>
                                <span class="font-semibold text-slate-600">@(isOpen ? "Envoyer les réponses avant le" : "Envoi terminé le") @dueAtUtc.ToLocalTime().ToString("dd/MM/yyyy à HH:mm")</span>
                            </div>
                        }
                        else if (lesson.ExerciseCount > 0)
                        {
                            <p class="mt-3 inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600 ring-1 ring-slate-200">Aucune date limite fixée pour les exercices</p>
                        }

                        <div class="mt-4">
                            <div class="flex items-center justify-between text-sm font-semibold text-slate-500">
                                <span>@lesson.CorrectExerciseCount / @lesson.ExerciseCount exercices</span>
                                <span>@lesson.ProgressPercent %</span>
                            </div>
                            <div class="mt-1 flex items-center justify-between text-sm font-semibold text-slate-500">
                                <span>Points de la leçon</span>
                                <span>@lesson.ExercisePointsEarned / @lesson.ExercisePointsTotal</span>
                            </div>
                            <div class="mt-1 h-2 w-full overflow-hidden rounded-full bg-slate-100">
                                <div class="h-full rounded-full bg-emerald-500 transition-all duration-300" style="width:@(lesson.ProgressPercent)%"></div>
                            </div>
                        </div>

                        <button type="button"
                                class="sk-btn sk-btn-primary mt-5 self-start"
                                disabled="@(!lesson.IsUnlocked)"
                                @onclick="() => OpenLesson(lesson.LessonId)">
                            @GetLessonActionText(lesson)
                        </button>
                    </article>
                        }
                    </div>
                </DataListPanel>
            </div>
            }
        }
    </div>
}

