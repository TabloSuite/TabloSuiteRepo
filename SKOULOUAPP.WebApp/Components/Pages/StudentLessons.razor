@page "/student/lessons"
@attribute [Authorize(Policy = "RequireStudent")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits SkoulouApp.WebApp.Components.CancelableComponentBase
@using SkoulouApp.Core.Models.Student

<PageTitle>Mes leçons</PageTitle>

@if (lessons is null)
{
    <SkeletonLoader />
}
else
{
    <section class="student-learning-page grid gap-4 sm:gap-5 lg:gap-6">
        <div class="skoulou-hero rounded-[1.5rem] px-4 py-3 text-white shadow-xl sm:rounded-[1.25rem] sm:px-5 sm:py-4 lg:px-6 lg:py-5">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-indigo-100 sm:text-sm">Espace d'apprentissage</p>
            <h1 class="mt-2 text-2xl font-black sm:text-3xl">Mes leçons</h1>
            <p class="mt-2 max-w-2xl text-xs leading-6 text-indigo-50 sm:text-sm sm:leading-7">Retrouvez les leçons, les supports et les exercices publiés pour votre classe. Vos résultats sont enregistrés automatiquement.</p>

            @if (lessons.Count > 0)
            {
                <div class="mt-4 grid gap-2 sm:grid-cols-3 sm:gap-3">
                    <div class="rounded-2xl bg-white/10 p-3 backdrop-blur sm:p-4">
                        <div class="text-xl font-black sm:text-2xl">@completedCount / @lessons.Count</div>
                        <div class="text-xs font-medium text-indigo-100">leçons terminées</div>
                    </div>
                    <div class="rounded-2xl bg-white/10 p-3 backdrop-blur sm:p-4">
                        <div class="text-xl font-black sm:text-2xl">@solvedExercises / @totalExercises</div>
                        <div class="text-xs font-medium text-indigo-100">exercices résolus</div>
                    </div>
                    <div class="rounded-2xl bg-white/10 p-3 backdrop-blur sm:p-4">
                        <div class="text-xl font-black sm:text-2xl">@overallPercent %</div>
                        <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-white/20">
                            <div class="h-full rounded-full bg-emerald-400 transition-all duration-500" style="width:@(overallPercent)%"></div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 w-full rounded-[1.5rem] border border-slate-200 bg-white p-3 shadow-sm sm:p-4 md:p-5">
                    <div class="grid gap-3 md:grid-cols-12">
                        <label class="md:col-span-12">
                        <span class="mb-1 block text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">Recherche rapide</span>
                        <input type="text"
                               class="w-full rounded-2xl border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-800 focus:border-indigo-400 focus:outline-none"
                               placeholder="Titre, classe, résumé, matière..."
                               @bind="searchTerm"
                               @bind:event="oninput" />
                    </label>

                    <ModernDropdown TValue="Guid?"
                                    Label="Enseignant"
                                    Value="selectedTeacherId"
                                    ValueChanged="SetSelectedTeacherAsync"
                                    Options="TeacherFilterOptions"
                                    ContainerClass="md:col-span-5"
                                    Searchable="true"
                                    SearchPlaceholder="Rechercher un enseignant..." />

                    <ModernDropdown TValue="string"
                                    Label="Matière"
                                    Value="selectedFach"
                                    ValueChanged="SetSelectedFachAsync"
                                    Options="FachFilterOptions"
                                    ContainerClass="md:col-span-5"
                                    Searchable="true"
                                    SearchPlaceholder="Rechercher une matière..." />

                    <ModernDropdown TValue="string"
                                    Label="Statut"
                                    Value="selectedStatus"
                                    ValueChanged="SetSelectedStatusAsync"
                                    Options="StatusFilterOptions"
                                    ContainerClass="md:col-span-2" />
                    </div>

                    <p class="mt-3 text-xs font-semibold text-slate-500">@VisibleCount leçon(s) affichée(s)</p>
                </div>
            }
        </div>

        @if (lessons.Count == 0)
        {
            <div class="rounded-[2rem] bg-white p-8 text-center shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
                    <h2 class="text-lg font-black text-slate-900">Aucune leçon disponible</h2>
                    <p class="mt-2 text-sm text-slate-600">Aucun contenu publié n'est disponible pour vos classes. Si nécessaire, contactez la direction pour vérifier votre affectation.</p>
            </div>
        }
        else
        {
            <div class="flex flex-wrap items-center justify-between gap-3">
                <p class="text-sm font-semibold text-slate-600">@(IsPathView ? "Vue parcours d'apprentissage" : "Vue liste")</p>
                <div class="inline-flex rounded-full bg-slate-100 p-1">
                    <button type="button"
                            class="@(IsPathView ? "rounded-full bg-white px-4 py-1.5 text-sm font-semibold text-indigo-700 shadow" : "rounded-full px-4 py-1.5 text-sm font-semibold text-slate-500")"
                            @onclick="() => ToggleView(true)">
                        <Icon Name="info" Groesse="16" /> Parcours
                    </button>
                    <button type="button"
                            class="@(!IsPathView ? "rounded-full bg-white px-4 py-1.5 text-sm font-semibold text-indigo-700 shadow" : "rounded-full px-4 py-1.5 text-sm font-semibold text-slate-500")"
                            @onclick="() => ToggleView(false)">
                        <Icon Name="clipboard" Groesse="16" /> Liste
                    </button>
                </div>
            </div>

            <div class="rounded-[1.5rem] bg-white p-3 shadow-md shadow-slate-200/70 ring-1 ring-slate-100 sm:p-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div>
                        <p class="text-sm font-bold text-slate-900">Aller directement à une leçon</p>
                        <p class="text-xs text-slate-500">Entrez un numéro visible, par exemple 10 ou 18.</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="number"
                               min="1"
                               max="@OrderedLessons.Count"
                               class="w-24 rounded-2xl border border-slate-200 px-3 py-2 text-base font-semibold text-slate-800 focus:border-indigo-400 focus:outline-none"
                               @bind="lessonJumpNumber"
                               @bind:event="oninput" />
                        <button type="button"
                                class="skoulou-btn-accent inline-flex items-center justify-center rounded-full px-4 py-2 text-sm font-semibold transition duration-200 hover:-translate-y-0.5 disabled:cursor-not-allowed disabled:bg-slate-200 disabled:text-slate-500 disabled:hover:translate-y-0"
                                disabled="@(!CanJumpToLesson)"
                                @onclick="JumpToLesson">
                            Ouvrir
                        </button>
                    </div>
                </div>
            </div>

            @if (IsPathView)
            {
                <div class="rounded-[1.5rem] bg-white p-3 shadow-md shadow-slate-200/70 ring-1 ring-slate-100 sm:p-4 lg:rounded-[2rem] lg:p-6">
                    <div class="lesson-path">
                        @foreach (var lesson in VisibleLessons)
                        {
                            var status = GetPathNodeStatus(lesson);
                            <div class="lesson-path-item lesson-path-item--@status card-stack-enter">
                                <div class="lesson-path-connector"></div>
                                <div class="lesson-path-node lesson-path-node--@status" aria-hidden="true">
                                    @if (status == "completed")
                                    {
                                        <span>✓</span>
                                    }
                                    else if (status == "locked")
                                    {
                                        <span><Icon Name="lock" Groesse="16" /> </span>
                                    }
                                    else
                                    {
                                        <span>@lesson.Order</span>
                                    }
                                </div>
                                 <div class="lesson-path-card rounded-2xl border border-slate-200 bg-white p-3 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-emerald-200 hover:shadow-md sm:p-4">
                                    <div class="flex flex-wrap items-start justify-between gap-3">
                                        <div>
                                            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-indigo-600">@lesson.CourseCode</p>
                                            <h2 class="mt-1 text-base font-bold text-slate-900">@lesson.Title</h2>
                                        </div>
                                        @if (status == "current")
                                        {
                                            <Badge Accent="indigo">En cours</Badge>
                                        }
                                        else if (status == "completed")
                                        {
                                            <Badge Accent="emerald">Terminé</Badge>
                                        }
                                    </div>
                                    <p class="mt-2 text-sm text-slate-600">@lesson.Summary</p>
                                    @if (!string.IsNullOrWhiteSpace(lesson.FachName))
                                    {
                                        <p class="mt-1 text-xs font-semibold text-indigo-600">Matière : @lesson.FachName</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(lesson.TeacherName))
                                    {
                                        <p class="mt-1 text-xs font-semibold text-cyan-700">Par : @lesson.TeacherName</p>
                                    }
                                    @if (lesson.ExerciseSubmissionDueAtUtc is DateTime dueAtUtc)
                                    {
                                        var isOpen = dueAtUtc > DateTime.UtcNow;
                                        <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
                                            <span class="rounded-full px-3 py-1 font-bold ring-1 @(isOpen ? "bg-emerald-50 text-emerald-800 ring-emerald-200" : "bg-rose-50 text-rose-800 ring-rose-200")">@(isOpen ? "Réponses ouvertes" : "Date limite passée")</span>
                                            <span class="font-semibold text-slate-600">@(isOpen ? "Envoyer les réponses avant le" : "Envoi terminé le") @dueAtUtc.ToLocalTime().ToString("dd/MM/yyyy à HH:mm")</span>
                                        </div>
                                    }
                                    else if (lesson.ExerciseCount > 0)
                                    {
                                        <p class="mt-3 inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600 ring-1 ring-slate-200">Aucune date limite fixée pour les exercices</p>
                                    }
                                    <div class="mt-3">
                                        <div class="flex items-center justify-between text-sm font-semibold text-slate-500">
                                            <span>@lesson.CorrectExerciseCount / @lesson.ExerciseCount exercices</span>
                                            <span>@lesson.ProgressPercent %</span>
                                        </div>
                                        <div class="mt-1 flex items-center justify-between text-sm font-semibold text-indigo-600">
                                            <span>Points de la leçon</span>
                                            <span>@lesson.ExercisePointsEarned / @lesson.ExercisePointsTotal</span>
                                        </div>
                                        <div class="mt-1 h-2 w-full overflow-hidden rounded-full bg-slate-100">
                                            <div class="h-full rounded-full bg-emerald-500 transition-all duration-300" style="width:@(lesson.ProgressPercent)%"></div>
                                        </div>
                                    </div>
                                    <button type="button"
                                            class="skoulou-btn-accent mt-4 inline-flex w-fit items-center justify-center rounded-full px-4 py-2 text-sm font-semibold transition duration-200 hover:-translate-y-0.5 disabled:cursor-not-allowed disabled:bg-slate-200 disabled:text-slate-500 disabled:hover:translate-y-0"
                                            disabled="@(!lesson.IsUnlocked)"
                                            @onclick="() => OpenLesson(lesson.LessonId)">
                                        @GetLessonActionText(lesson)
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
            <div class="rounded-[2rem] bg-white p-5 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 sm:p-6">
                <DataListPanel Items="lessons"
                               PageSize="10"
                               SearchPlaceholder="Rechercher une leçon..."
                               EmptyText="Aucune leçon correspondante."
                               ResultLabelSingular="leçon"
                               ResultLabelPlural="leçons"
                               Filter="@((LessonListItem l, string term) => Contains(l.Title, term) || Contains(l.CourseCode, term) || Contains(l.Summary, term))">
                    <div class="grid gap-4 xl:grid-cols-2">
                        @foreach (var lesson in context.Where(PassesSearchAndFilters))
                        {
                    <article class="card-stack-enter flex flex-col rounded-3xl border border-slate-200 bg-white p-5 shadow-lg shadow-slate-200/70 transition duration-200 hover:-translate-y-0.5 hover:border-emerald-200 hover:shadow-xl">
                        <div class="flex flex-wrap items-start justify-between gap-3">
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-indigo-600">@lesson.CourseCode</p>
                                <h2 class="mt-1 text-lg font-bold text-slate-900">@lesson.Title</h2>
                            </div>
                            <Badge Accent="@(lesson.IsCompleted ? "emerald" : "slate")">
                                @(lesson.IsCompleted ? "Terminé" : "À faire")
                            </Badge>
                        </div>
                        <p class="mt-2 text-sm text-slate-600">@lesson.Summary</p>
                        @if (!string.IsNullOrWhiteSpace(lesson.FachName))
                        {
                            <p class="mt-1 text-xs font-semibold text-indigo-600">Matière : @lesson.FachName</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(lesson.TeacherName))
                        {
                            <p class="mt-1 text-xs font-semibold text-cyan-700">Par : @lesson.TeacherName</p>
                        }
                        @if (lesson.ExerciseSubmissionDueAtUtc is DateTime dueAtUtc)
                        {
                            var isOpen = dueAtUtc > DateTime.UtcNow;
                            <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
                                <span class="rounded-full px-3 py-1 font-bold ring-1 @(isOpen ? "bg-emerald-50 text-emerald-800 ring-emerald-200" : "bg-rose-50 text-rose-800 ring-rose-200")">@(isOpen ? "Réponses ouvertes" : "Date limite passée")</span>
                                <span class="font-semibold text-slate-600">@(isOpen ? "Envoyer les réponses avant le" : "Envoi terminé le") @dueAtUtc.ToLocalTime().ToString("dd/MM/yyyy à HH:mm")</span>
                            </div>
                        }
                        else if (lesson.ExerciseCount > 0)
                        {
                            <p class="mt-3 inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600 ring-1 ring-slate-200">Aucune date limite fixée pour les exercices</p>
                        }

                        <div class="mt-4">
                            <div class="flex items-center justify-between text-sm font-semibold text-slate-500">
                                <span>@lesson.CorrectExerciseCount / @lesson.ExerciseCount exercices</span>
                                <span>@lesson.ProgressPercent %</span>
                            </div>
                            <div class="mt-1 flex items-center justify-between text-sm font-semibold text-indigo-600">
                                <span>Points de la leçon</span>
                                <span>@lesson.ExercisePointsEarned / @lesson.ExercisePointsTotal</span>
                            </div>
                            <div class="mt-1 h-2 w-full overflow-hidden rounded-full bg-slate-100">
                                <div class="h-full rounded-full bg-emerald-500 transition-all duration-300" style="width:@(lesson.ProgressPercent)%"></div>
                            </div>
                        </div>

                        <button type="button"
                                class="skoulou-btn-accent mt-5 inline-flex w-fit self-start items-center justify-center rounded-full px-4 py-2 text-sm font-semibold transition duration-200 hover:-translate-y-0.5 disabled:cursor-not-allowed disabled:bg-slate-200 disabled:text-slate-500 disabled:hover:translate-y-0"
                                disabled="@(!lesson.IsUnlocked)"
                                @onclick="() => OpenLesson(lesson.LessonId)">
                            @GetLessonActionText(lesson)
                        </button>
                    </article>
                        }
                    </div>
                </DataListPanel>
            </div>
            }
        }
    </section>
}

