@page "/admin/exception-logs"
@attribute [Authorize(Roles = "SuperAdmin")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Journal des erreurs</PageTitle>

<section class="mx-auto w-full max-w-7xl space-y-6">
    <header class="skoulou-hero rounded-[1.25rem] bg-slate-950 px-5 py-4 text-white shadow-xl sm:px-6 sm:py-5">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-cyan-300">Administrateur</p>
        <h1 class="mt-3 text-3xl font-black">Journal des exceptions</h1>
        <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-300">Consultez les erreurs applicatives, filtrez-les par période ou école, marquez-les comme traitées et supprimez les entrées obsolètes.</p>
    </header>

    <div class="rounded-[2rem] bg-white p-5 shadow-sm ring-1 ring-slate-200 sm:p-6">
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-12">
            <div class="xl:col-span-2">
                <label class="mb-2 block text-sm font-semibold text-slate-700">Du</label>
                <TailwindDateTimePicker Value="fromDate" ValueChanged="SetFromDateAsync" ShowTime="false" />
            </div>
            <div class="xl:col-span-2">
                <label class="mb-2 block text-sm font-semibold text-slate-700">Au</label>
                <TailwindDateTimePicker Value="toDate" ValueChanged="SetToDateAsync" ShowTime="false" />
            </div>
            <div class="xl:col-span-3">
                <ModernDropdown TValue="Guid?" Label="École" Value="schoolId" ValueChanged="SetSchoolAsync" Options="SchoolOptions" />
            </div>
            <label class="flex items-end gap-3 pb-2 text-sm font-semibold text-slate-700 xl:col-span-2">
                <InputCheckbox @bind-Value="onlyUnhandled" />
                Non traitées uniquement
            </label>
            <div class="flex flex-wrap items-end justify-end gap-3 xl:col-span-3">
                <AsyncActionButton Class="sk-btn sk-btn-primary w-full sm:w-auto" IsBusy="@isLoading" BusyLabel="Filtrage..." OnClick="ApplyFiltersAsync">Filtrer</AsyncActionButton>
                <button type="button" class="sk-btn sk-btn-secondary w-full sm:w-auto" @onclick="ResetFiltersAsync">Réinitialiser</button>
            </div>
            <label class="relative m-0 md:col-span-2 xl:col-span-12">
                <span class="sr-only">Rechercher dans les erreurs</span>
                <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"><Icon Name="search" Groesse="18" /></span>
                <input type="search" class="skoulou-input" style="padding-left: 2.6rem" placeholder="Rechercher un message, un type d'exception ou une adresse..."
                       @bind="search" @bind:event="oninput" @bind:after="SearchChangedAsync" />
            </label>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="flex justify-center py-12 text-slate-600"><ProgressRing Size="2rem" Label="Chargement des erreurs" /></div>
    }
    else if (logs.Count == 0)
    {
        <div class="rounded-[2rem] bg-emerald-50 p-8 text-center text-emerald-900">Aucune exception ne correspond aux filtres sélectionnés.</div>
    }
    else
    {
        <p class="text-sm font-semibold text-slate-500">@logs.Count@(hasMore ? "+" : "") erreur(s) affichée(s)</p>
        <div class="sk-liste-scroll grid gap-4 p-1">
            @foreach (var log in logs)
            {
                <CollapsibleCard @key="log.Id" Title="@GetHeaderTitle(log)"
                                 Subtitle="@($"{log.OccurredAtUtc.ToLocalTime():dd.MM.yyyy HH:mm:ss} • {(log.School?.Name ?? "École non attribuée")}")"
                                 Eyebrow="Journal des erreurs"
                                 Icon="alert"
                                 Accent="rose">
                    <HeaderRight>
                        <div class="flex flex-wrap items-center justify-end gap-2">
                            @if (log.IsHandled)
                            {
                                <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-800">Traitée</span>
                            }
                            else
                            {
                                <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800">À traiter</span>
                            }

                            <AsyncActionButton Class="sk-btn sk-btn-secondary sk-btn-sm"
                                               IsBusy="@(copyingLogId == log.Id)"
                                               BusyLabel="Copie..."
                                               OnClick="@(_ => CopyLogAsync(log))">
                                @(copiedLogId == log.Id ? "Copié" : "Copier")
                            </AsyncActionButton>

                            @if (!log.IsHandled)
                            {
                                <AsyncActionButton Class="sk-btn sk-btn-success sk-btn-sm"
                                                   IsBusy="@(busyLogId == log.Id)"
                                                   BusyLabel="..."
                                                   OnClick="@(_ => MarkHandledAsync(log.Id))">
                                    Traiter
                                </AsyncActionButton>
                            }

                            <AsyncActionButton Class="sk-btn sk-btn-danger sk-btn-sm"
                                               IsBusy="@(busyLogId == log.Id)"
                                               BusyLabel="..."
                                               OnClick="@(_ => DeleteAsync(log.Id))">
                                Supprimer
                            </AsyncActionButton>
                        </div>
                    </HeaderRight>

                    <ChildContent>
                        <div class="grid gap-4 text-sm">
                            <div class="rounded-2xl bg-rose-50 p-4 text-rose-900 ring-1 ring-rose-100">
                                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-rose-600">Message</p>
                                <p class="mt-2 whitespace-pre-wrap break-words font-semibold">@log.Message</p>
                            </div>
                            <div class="rounded-2xl bg-slate-950 p-4 text-xs text-slate-100 ring-1 ring-slate-800">
                                <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-300">Stack trace</p>
                                <pre class="max-h-80 overflow-auto whitespace-pre-wrap break-words">@log.StackTrace</pre>
                            </div>
                        </div>
                    </ChildContent>
                </CollapsibleCard>
            }
        </div>
        @if (hasMore)
        {
            <div class="sk-liste-mehr">
                <AsyncActionButton Class="sk-btn sk-btn-sm sk-btn-secondary" IsBusy="loadingMore" BusyLabel="Chargement..." OnClick="LoadMoreAsync">Afficher plus</AsyncActionButton>
            </div>
        }
    }
</section>
