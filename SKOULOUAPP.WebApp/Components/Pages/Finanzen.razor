@page "/finanzen"
@attribute [Authorize(Roles = "SchulLeiter,Koordinator,SuperAdmin,ProduktOwner")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits SkoulouApp.WebApp.Components.CancelableComponentBase
@using SkoulouApp.Core.DataModels.Finanzen
@using SkoulouApp.Core.Services
@using SkoulouApp.WebApp.Components.Shared

<PageTitle>Finances</PageTitle>

<section class="pdf-export-container flex flex-col gap-4">
    <div class="skoulou-hero relative overflow-hidden rounded-[1.25rem] px-5 py-4 text-white shadow-2xl">
        <div class="relative">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-200">Gestion financière</p>
            <h1 class="mt-3 text-3xl font-black">Recettes &amp; dépenses de l'école</h1>
            <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-300">
                @(isPlatformViewer ? "Consultez les finances des écoles sans modifier leurs écritures, paiements ou cycles." : !canViewDashboard && !canCreateEntries && !canManageCycles ? "Consultez les facturations SKOULOU de l'école sélectionnée et déclarez les virements effectués." : "Saisir les recettes/dépenses, gérer les cycles de classes (démarrage/clôture) et suivre les paiements échelonnés des élèves.")
            </p>
        </div>
    </div>

    @if (!schulenGeladen)
    {
        <div class="rounded-[2rem] bg-white px-6 py-5 text-slate-700 ring-1 ring-slate-100">
            <p class="text-sm font-semibold">Chargement des écoles...</p>
        </div>
    }
    else if (schulen.Count == 0)
    {
        <div class="rounded-[2rem] bg-amber-50 px-6 py-5 text-amber-800 ring-1 ring-amber-100">
            <h2 class="text-lg font-black text-amber-950">Aucune école disponible</h2>
            <p class="mt-2 text-sm leading-6">Les recettes, dépenses et cycles apparaîtront après la création ou l'attribution d'une école.</p>
        </div>
    }
    else
    {
        <div class="director-sticky-band print:hidden">
        @if (schulen.Count > 1)
        {
            <div class="mb-2 flex flex-wrap items-center gap-3 pr-14 sm:pr-16">
                <ModernDropdown TValue="Guid?" Value="aktiveSchulID" ValueChanged="SchuleWechselnAsync" Options="SchulOptionen" Searchable="true" SearchPlaceholder="Rechercher une école..." ContainerClass="w-full sm:w-72" />
                <span class="text-xs font-medium text-slate-500">Toutes les données affichées concernent l'école sélectionnée.</span>
            </div>
        }
        else if (schulen.Count == 1)
        {
            <div class="mb-2 pr-14 text-sm font-semibold text-slate-800 sm:pr-16">École gérée : <span class="text-cyan-700">@schulen[0].Name</span></div>
        }

        <Toast Message="@message" MessageChanged="v => message = v" Kind="Toast.ToastKind.Success" />
        <QuittungHinweis @bind-ZahlungID="letzteQuittungID" />
        <Toast Message="@errorMessage" MessageChanged="v => errorMessage = v" Kind="Toast.ToastKind.Error" />

        @* Tabs *@
        <div class="school-page-tabs">
            @if (canViewDashboard) { <button type="button" class="rounded-full px-4 py-2 text-sm font-semibold @(aktiverTab == "dashboard" ? "skoulou-btn-accent" : "bg-slate-100 text-slate-700")" @onclick='() => SetTab("dashboard")'>Finances de l'école</button> }
            @if (canCreateEntries) { <button type="button" class="rounded-full px-4 py-2 text-sm font-semibold @(aktiverTab == "erfassen" ? "skoulou-btn-accent" : "bg-slate-100 text-slate-700")" @onclick='() => SetTab("erfassen")'>Nouvelle écriture</button> }
            @if (canManageCycles) { <button type="button" class="rounded-full px-4 py-2 text-sm font-semibold @(aktiverTab == "durchlaeufe" ? "skoulou-btn-accent" : "bg-slate-100 text-slate-700")" @onclick='() => SetTab("durchlaeufe")'>Paiements des cycles</button> }
            @if (canAccessBilling) { <button type="button" class="rounded-full px-4 py-2 text-sm font-semibold @(aktiverTab == "facturation" ? "skoulou-btn-accent" : "bg-slate-100 text-slate-700")" @onclick='() => SetTab("facturation")'>Facturation SKOULOU</button> }
        </div>
        </div>

        @if (aktiverTab == "facturation" && canAccessBilling && aktiveSchulID is Guid billingSchoolId)
        {
            <Abrechnung @key="billingSchoolId" Embedded="true" SchoolId="billingSchoolId" />
        }

        @if (aktiverTab == "dashboard" && canViewDashboard)
        {
            @* -------------------- DASHBOARD -------------------- *@
            <div class="rounded-2xl bg-white p-5 shadow ring-1 ring-slate-100">
                @if (finanzAbgleich is not null)
                {
                    <div class="mb-5 rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700">
                        <h2 class="font-bold text-slate-900">Rapprochement des justificatifs et des écritures</h2>
                        <p class="mt-2">Scolarité : paiements enregistrés @finanzAbgleich.SchulgebuehrenZahlungen.ToString("N0") FCFA · écritures liées @finanzAbgleich.SchulgebuehrenBuchungen.ToString("N0") FCFA · anomalies @finanzAbgleich.SchulgebuehrenAbweichungen</p>
                        <p class="mt-1">Factures SKOULOU : total facturé @finanzAbgleich.PlattformRechnungen.ToString("N0") FCFA · parts comptabilisées pour ces factures @finanzAbgleich.PlattformBuchungenZuRechnungen.ToString("N0") FCFA · virements confirmés @finanzAbgleich.BestaetigtePlattformZahlungen.ToString("N0") FCFA · factures à vérifier @finanzAbgleich.PlattformRechnungenMitAbweichung</p>
                        <p class="mt-1 text-xs text-slate-500">Les factures en attente ne sont pas des paiements reçus. La confirmation d'un virement ne crée pas une seconde dépense.</p>
                    </div>
                }
                @if (uebersicht is not null)
                {
                    @if (direktorKontostand is not null)
                    {
                        <div class="mt-5 overflow-hidden rounded-[2rem] bg-slate-950 text-white shadow-2xl print:border print:border-slate-300 print:bg-white print:text-slate-950 print:shadow-none">
                            <div class="bg-gradient-to-r from-cyan-700 via-blue-800 to-indigo-900 p-6 sm:p-8">
                                <div class="flex flex-wrap items-center justify-between gap-2">
                                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan-100">Trésorerie actuelle · @AktiveSchuleName</p>
                                    <div class="flex flex-wrap items-center gap-2">
                                        <span class="rounded-full bg-white/15 px-3 py-1 text-xs font-semibold text-cyan-100">Indépendante des filtres</span>
                                        <span class="rounded-full px-3 py-1 text-xs font-bold ring-1 @SoldeEtatBadgeClass(direktorKontostand.WirklicherKontostandNachAboVerteilung)">@SoldeEtatLabel(direktorKontostand.WirklicherKontostandNachAboVerteilung)</span>
                                    </div>
                                </div>
                                <div class="mt-6 grid items-stretch gap-5 lg:grid-cols-2 lg:gap-8">
                                    <div class="flex flex-col justify-center">
                                        <h2 class="text-2xl font-black leading-tight sm:text-3xl">Le solde qui revient à l'école</h2>
                                        <p class="mt-3 max-w-xl text-sm leading-6 text-cyan-50">Recettes et dépenses de l'école, après déduction de la part SKOULOU comptabilisée. Les paiements encore attendus ne sont pas inclus.</p>
                                    </div>
                                    <div class="min-w-0 rounded-3xl bg-white px-6 py-7 text-slate-950 shadow-xl ring-1 ring-emerald-100 sm:px-8 sm:py-9 print:border print:border-slate-200">
                                        <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-emerald-800">Montant revenant à l'école</p>
                                        <p class="mt-3 break-words text-4xl font-black leading-none tabular-nums sm:text-5xl xl:text-6xl @SoldeFarbe(direktorKontostand.WirklicherKontostandNachAboVerteilung)">@direktorKontostand.WirklicherKontostandNachAboVerteilung.ToString("N0") <span class="text-2xl sm:text-3xl">FCFA</span></p>
                                        <div class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4 sm:px-5">
                                            <p class="text-xs font-bold uppercase tracking-wide text-slate-600">Solde provisoire avant règlement SKOULOU</p>
                                            <p class="mt-2 break-words text-2xl font-black leading-tight tabular-nums text-slate-900 sm:text-3xl">@direktorKontostand.KontostandMitNichtUeberwiesenenSkoulouAppAnteilen.ToString("N0") <span class="text-lg sm:text-xl">FCFA</span></p>
                                            <p class="mt-2 text-xs font-semibold text-rose-700 sm:text-sm">(Part SKOULOU comptabilisée : @direktorKontostand.SkoulouAppAboAnteil.ToString("N0") FCFA)</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-5 grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
                                    <div class="rounded-xl bg-white/10 px-4 py-3 ring-1 ring-white/20">
                                        <p class="text-[11px] font-bold uppercase tracking-wide text-cyan-100">Solde provisoire avant règlement SKOULOU</p>
                                        <p class="mt-1 text-xl font-black tabular-nums text-emerald-300">@direktorKontostand.KontostandMitNichtUeberwiesenenSkoulouAppAnteilen.ToString("N0") FCFA</p>
                                    </div>
                                    <div class="rounded-xl bg-white/10 px-4 py-3 ring-1 ring-white/20">
                                        <p class="text-[11px] font-bold uppercase tracking-wide text-cyan-100">Part SKOULOU comptabilisée</p>
                                        <p class="mt-1 text-xl font-black tabular-nums text-rose-300">@direktorKontostand.SkoulouAppAboAnteil.ToString("N0") FCFA</p>
                                    </div>
                                    <div class="rounded-xl bg-white/10 px-4 py-3 ring-1 ring-white/20">
                                        <p class="text-[11px] font-bold uppercase tracking-wide text-cyan-100">Parts gardées par l'école</p>
                                        <p class="mt-1 text-xl font-black tabular-nums text-emerald-300">@((direktorKontostand.SchulleiterAboAnteil + direktorKontostand.LehrerAboAnteil).ToString("N0")) FCFA</p>
                                    </div>
                                    <div class="rounded-xl bg-white/10 px-4 py-3 ring-1 ring-white/20">
                                        <p class="text-[11px] font-bold uppercase tracking-wide text-cyan-100">Scolarité restant à payer (cycles actifs)</p>
                                        <p class="mt-1 text-xl font-black tabular-nums text-cyan-100">@direktorKontostand.OffeneSchulgebuehrenAktiveKlassen.ToString("N0") FCFA</p>
                                        <span class="mt-2 inline-flex rounded-full px-2.5 py-1 text-[11px] font-bold ring-1 @PaiementsAttenteBadgeClass">@PaiementsAttenteEtatLabel</span>
                                    </div>
                                </div>
                            </div>

                            <div class="grid gap-4 p-5 lg:grid-cols-5">
                                <div class="rounded-2xl bg-white/10 p-4 lg:col-span-2">
                                    <p class="text-xs font-bold uppercase tracking-[0.16em] text-cyan-200">Mouvements de l'école</p>
                                    <div class="mt-4 space-y-3 text-sm">
                                        <div class="flex justify-between gap-3"><span class="text-slate-300">Scolarité encaissée</span><strong class="text-emerald-300">+ @direktorKontostand.SchulgebuehrenEingenommen.ToString("N0") FCFA</strong></div>
                                        <div class="flex justify-between gap-3"><span class="text-slate-300">Autres recettes</span><strong class="text-emerald-300">+ @direktorKontostand.SonstigeEinnahmen.ToString("N0") FCFA</strong></div>
                                         <div class="flex justify-between gap-3"><span class="text-slate-300">Abonnements SKOULOU encaissés</span><strong class="text-emerald-300">+ @direktorKontostand.SkoulouAppAboEingenommen.ToString("N0") FCFA</strong></div>
                                        <div class="flex justify-between gap-3"><span class="text-slate-300">Dépenses de fonctionnement</span><strong class="text-rose-300">− @direktorKontostand.BetrieblicheAusgaben.ToString("N0") FCFA</strong></div>
                                    </div>
                                     <div class="mt-4 flex items-center justify-between gap-3 border-t border-white/15 pt-3">
                                         <span class="text-xs font-bold uppercase tracking-[0.14em] text-cyan-200">Solde provisoire avant répartition</span>
                                         <strong class="text-lg @SoldeFarbe(direktorKontostand.KontostandMitNichtUeberwiesenenSkoulouAppAnteilen)">@direktorKontostand.KontostandMitNichtUeberwiesenenSkoulouAppAnteilen.ToString("N0") FCFA</strong>
                                     </div>
                                </div>

                                <div class="rounded-2xl bg-cyan-950/45 p-4 ring-1 ring-cyan-300/20 lg:col-span-3">
                                    <div class="flex flex-wrap items-start justify-between gap-3">
                                        <div>
                                            <p class="text-xs font-bold uppercase tracking-[0.16em] text-cyan-200">Abonnements SKOULOU encaissés</p>
                                            <p class="mt-1 text-2xl font-black text-cyan-100">@direktorKontostand.SkoulouAppAboEingenommen.ToString("N0") FCFA</p>
                                            <p class="mt-2 text-sm font-semibold text-cyan-100">@direktorKontostand.SchuelerMitBezahltemAboAnzahl élève(s) avec abonnement payé</p>
                                        </div>
                                        <div class="rounded-full bg-cyan-300/15 px-3 py-1 text-xs font-semibold text-cyan-100">Montant encaissé pour le compte de SKOULOU</div>
                                    </div>
                                    <div class="mt-4 grid gap-2 sm:grid-cols-3">
                                        <div class="rounded-xl bg-slate-950/35 p-3"><p class="text-xs text-slate-300">Part direction (dans l'école)</p><p class="mt-1 font-black text-emerald-300">+ @direktorKontostand.SchulleiterAboAnteil.ToString("N0") FCFA</p></div>
                                        <div class="rounded-xl bg-slate-950/35 p-3"><p class="text-xs text-slate-300">Part enseignants (dans l'école)</p><p class="mt-1 font-black text-emerald-300">+ @direktorKontostand.LehrerAboAnteil.ToString("N0") FCFA</p></div>
                                        <div class="rounded-xl bg-slate-950/35 p-3"><p class="text-xs text-slate-300">Part SKOULOU comptabilisée</p><p class="mt-1 font-black text-rose-300">− @direktorKontostand.SkoulouAppAboAnteil.ToString("N0") FCFA</p></div>
                                    </div>
                                    <p class="mt-3 text-xs leading-5 text-cyan-100">Calcul appliqué: @direktorKontostand.KontostandMitNichtUeberwiesenenSkoulouAppAnteilen.ToString("N0") FCFA − @direktorKontostand.SkoulouAppAboAnteil.ToString("N0") FCFA = @direktorKontostand.WirklicherKontostandNachAboVerteilung.ToString("N0") FCFA.</p>
                                </div>
                            </div>

                            <div class="mx-5 mt-5 flex flex-wrap items-center justify-between gap-4 border-t border-white/10 pt-5">
                                <div>
                                    <p class="text-xs font-bold uppercase tracking-[0.16em] text-cyan-200">Paiements encore attendus · tous les cycles actifs</p>
                                    <p class="mt-1 text-sm text-slate-300">Estimation à partir des prix des cycles et des paiements enregistrés, non facturée ici. Elle n'est pas incluse dans le solde ni dans le rapport filtré.</p>
                                </div>
                                <div class="text-right">
                                    <p class="text-3xl font-black text-cyan-200">@direktorKontostand.OffeneSchulgebuehrenAktiveKlassen.ToString("N0") FCFA</p>
                                    <span class="mt-2 inline-flex rounded-full px-2.5 py-1 text-[11px] font-bold ring-1 @PaiementsAttenteBadgeClass">@PaiementsAttenteEtatLabel</span>
                                </div>
                            </div>
                            @if (offeneSkoulouAppAbrechnungen.Count > 0)
                            {
                                <div class="mx-5 mt-4 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-amber-300/30 bg-amber-300/10 px-5 py-4">
                                    <div>
                                        <p class="text-xs font-bold uppercase tracking-[0.16em] text-amber-200">Facturation SKOULOU à régler</p>
                                        <p class="mt-1 text-sm text-amber-50">@offeneSkoulouAppAbrechnungen.Count facture(s) demandée(s) par l'Administrateur. Les parts du responsable produit ne sont pas affichées dans cet espace.</p>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-2xl font-black text-amber-200">@offeneSkoulouAppAbrechnungen.Sum(periode => periode.Umsatz).ToString("N0") FCFA</p>
                                        <a href="/abrechnung" class="mt-1 inline-block text-xs font-bold text-white underline">Voir et déclarer le virement</a>
                                    </div>
                                </div>
                            }
                            <div class="mx-5 mb-5 mt-4 flex flex-wrap items-center justify-between gap-4 rounded-2xl bg-white px-5 py-4 text-slate-950 shadow-lg ring-1 ring-slate-200 print:border print:border-slate-300">
                                <div>
                                    <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-500">Récapitulatif du calcul</p>
                                    <h3 class="mt-1 text-xl font-black">Solde disponible après règlement</h3>
                                    <p class="mt-1 text-sm text-slate-600">Solde calculé à partir des écritures enregistrées. Les parts direction et enseignants restent dans l'école; seule la part SKOULOU comptabilisée est déduite. Les factures encore à régler sont indiquées séparément.</p>
                                    <div class="mt-3 flex flex-wrap items-center gap-2 text-sm font-bold">
                                        <span class="rounded-lg bg-slate-100 px-3 py-2 text-slate-700">Solde avec abonnement SKOULOU&nbsp;: @direktorKontostand.KontostandMitNichtUeberwiesenenSkoulouAppAnteilen.ToString("N0") FCFA</span>
                                        <span class="text-lg text-slate-400">−</span>
                                        <span class="rounded-lg bg-cyan-50 px-3 py-2 text-cyan-800">Part SKOULOU comptabilisée&nbsp;: @direktorKontostand.SkoulouAppAboAnteil.ToString("N0") FCFA</span>
                                        <span class="text-lg text-slate-400">=</span>
                                        <span class="rounded-lg bg-emerald-50 px-3 py-2 text-emerald-800">Solde disponible après règlement&nbsp;: @direktorKontostand.WirklicherKontostandNachAboVerteilung.ToString("N0") FCFA</span>
                                    </div>
                                </div>
                                <p class="text-4xl font-black @SoldeFarbe(direktorKontostand.WirklicherKontostandNachAboVerteilung)">@direktorKontostand.WirklicherKontostandNachAboVerteilung.ToString("N0") FCFA</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mt-5 rounded-[2rem] bg-slate-950 p-6 text-white shadow-2xl print:bg-white print:text-slate-950">
                            <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan-200">Rapport financier filtré · @AktiveSchuleName</p>
                            <p class="mt-2 text-sm text-slate-300">@BerichtZeitraumLabel · @BerichtTypLabel · @BerichtSortierungLabel</p>
                            <p class="mt-4 text-4xl font-black text-emerald-300">@uebersicht.Saldo.ToString("N0") FCFA</p>
                        </div>
                    }

                    <div class="mt-5">
                        <div class="rounded-[1.5rem] border border-indigo-100 bg-gradient-to-br from-indigo-50 via-white to-cyan-50 p-5 shadow-sm print:hidden">
                            <div class="flex flex-wrap items-start justify-between gap-4">
                                <div class="flex min-w-0 items-start gap-3">
                                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-indigo-600 text-lg text-white shadow-lg shadow-indigo-200">⌕</div>
                                    <div>
                                    <p class="text-xs font-bold uppercase tracking-[0.16em] text-indigo-700">Journal opérationnel</p>
                                    <h2 class="mt-1 text-lg font-black text-slate-900">Filtrer les écritures de l'école</h2>
                                    <p class="mt-1 text-sm text-slate-600">Les filtres et le tri ci-dessous concernent uniquement ce journal.</p>
                                    </div>
                                </div>
                                <div class="flex w-full flex-wrap items-center gap-2 lg:w-auto lg:justify-end">
                                    <span class="max-w-full rounded-full bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white shadow-sm">@BerichtZeitraumLabel · @BerichtTypLabel</span>
                                    <a class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl bg-white px-4 py-2.5 text-sm font-bold text-indigo-800 no-underline ring-1 ring-indigo-200 transition hover:bg-indigo-50 sm:flex-none" href="@FinanzBerichtUrl">Voir le rapport</a>
                                    <a class="skoulou-btn-accent inline-flex flex-1 items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-sm font-bold no-underline shadow-md transition hover:shadow-lg sm:flex-none" href="@FinanzPdfUrl" aria-label="Exporter le rapport filtré en PDF">↓ Exporter PDF</a>
                                </div>
                            </div>
                            <label class="mt-4 flex cursor-pointer flex-wrap items-center gap-x-3 gap-y-1 rounded-xl border border-indigo-100 bg-white/90 p-3 text-sm text-slate-800 shadow-sm">
                                <input type="checkbox" class="h-5 w-5 shrink-0 accent-indigo-600" @bind="mitSkoulouAbos" />
                                <span class="font-bold">Avec les abonnements SKOULOU</span>
                                <span class="text-xs text-slate-500">Totaux regroupés, sans détail par élève. La part de la direction est indiquée séparément.</span>
                            </label>
                            <div class="mt-5 grid min-w-0 grid-cols-1 gap-3 sm:grid-cols-2 2xl:grid-cols-4">
                                <div class="min-w-0 rounded-xl bg-white/90 p-3 shadow-sm ring-1 ring-slate-200">
                                    <label class="mb-2 block text-xs font-semibold uppercase tracking-wide text-slate-500">Du</label>
                                    <TailwindDateTimePicker Value="filter.Von" ValueChanged="SetFilterVonAsync" ShowTime="false" Compact="true" />
                                </div>
                                <div class="min-w-0 rounded-xl bg-white/90 p-3 shadow-sm ring-1 ring-slate-200">
                                    <label class="mb-2 block text-xs font-semibold uppercase tracking-wide text-slate-500">Au</label>
                                    <TailwindDateTimePicker Value="filter.Bis" ValueChanged="SetFilterBisAsync" ShowTime="false" Compact="true" />
                                </div>
                                <div class="min-w-0 rounded-xl bg-white/90 p-3 shadow-sm ring-1 ring-slate-200"><ModernDropdown TValue="FinanzRichtung?" Label="Type" Value="filter.Richtung" ValueChanged="SetFilterRichtungAsync" Options="RichtungsOptionen" /></div>
                                <div class="min-w-0 rounded-xl bg-white/90 p-3 shadow-sm ring-1 ring-slate-200"><ModernDropdown TValue="FinanzSortierung?" Label="Tri" Value="filter.Sortierung" ValueChanged="SetFilterSortierungAsync" Options="SortierungsOptionen" /></div>
                                <div class="flex min-w-0 items-end sm:col-span-2 sm:justify-end 2xl:col-span-4">
                                    <AsyncActionButton Class="skoulou-btn-accent w-full rounded-xl px-5 py-2.5 text-sm font-semibold shadow-sm sm:w-auto" IsBusy="IsBusy" OnClick="LadeUebersichtAsync">Appliquer</AsyncActionButton>
                                </div>
                            </div>
                            <div class="mt-4 rounded-xl bg-white/90 px-3 py-2 text-xs font-semibold text-slate-700 ring-1 ring-slate-200">
                                Mode de calcul actif: @ZeitraumOptionLabel
                            </div>
                        </div>
                        <div class="finance-journal-export space-y-3">
