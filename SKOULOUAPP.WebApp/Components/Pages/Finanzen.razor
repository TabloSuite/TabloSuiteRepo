            @if (GefilterteDurchlaeufe.Count == 0)
            {
                <div class="rounded-2xl bg-slate-50 px-5 py-4 text-sm text-slate-600 ring-1 ring-slate-100">Aucun cycle ne correspond aux filtres sélectionnés.</div>
            }
        }
    }
</section>

@* -------------------- Zahlungs-Panel (Modal) -------------------- *@
@if (ausgewaehlterDurchlauf is not null)
{
    <div class="fixed inset-0 z-[2200] flex items-center justify-center bg-black/40 p-6 sm:p-8">
        <div class="skoulou-modal-surface w-full max-w-2xl rounded-3xl bg-white p-7 shadow-2xl">
            <div class="skoulou-modal-scroll">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-emerald-700">Gestion des paiements</p>
            <h3 class="mt-1 text-2xl font-black text-slate-900">Paiement — @ausgewaehlterDurchlauf.NiveauCode</h3>
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="mt-4 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-800" role="alert">@errorMessage</div>
            }
            <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div class="sm:col-span-2">
                    <ModernDropdown TValue="Guid?" Label="Élève" Value="zahlungForm.StudentId" ValueChanged="SetZahlungStudentAsync" Options="ZahlungsSchuelerOptionen" Searchable="true" SearchPlaceholder="Rechercher un élève..." />
                </div>
                <div>
                    <ModernDropdown TValue="ZahlungsArt?" Label="Type" Value="zahlungForm.ZahlungsArt" ValueChanged="SetZahlungsArtAsync" Options="ZahlungsArtOptionen" />
                </div>
                <div>
                    <label class="text-xs font-semibold text-slate-500">@(IstCashZahlung ? "Montant restant à payer" : "Montant")</label>
                    <input type="number" step="1" min="0" class="skoulou-input text-sm disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500" @bind="zahlungForm.Betrag" disabled="@IstCashZahlung" />
                    @if (IstCashZahlung)
                    {
                        <p class="mt-1 text-xs font-semibold text-emerald-700">Montant ouvert appliqué automatiquement.</p>
                    }
                </div>
                <div>
                    <label class="mb-2 block text-xs font-semibold uppercase tracking-wide text-slate-500">Date d'effet</label>
                    <TailwindDateTimePicker Value="zahlungForm.Wirkungsdatum" ValueChanged="SetZahlungWirkungsdatumAsync" ShowTime="false" />
                </div>
            </div>
            <div class="mt-5 flex justify-end gap-2">
                <button type="button" class="rounded-xl bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700" @onclick="ZahlungPanelSchliessen">Fermer</button>
                <AsyncActionButton Class="rounded-xl bg-emerald-600 px-4 py-2 text-sm font-semibold text-white" IsBusy="IsBusy" OnClick="ZahlungBuchenAsync">Enregistrer</AsyncActionButton>
            </div>
            </div>
        </div>
    </div>
}

@* -------------------- Beenden-Bestätigung (Modal) -------------------- *@
<AbschlussNotenDialog @bind-Open="abschlussNotenOpen" DurchlaufId="abschlussNotenDurchlaufId" BearbeiterId="currentUserId" />
<ModalDialog @bind-Open="BeendenOffen"
			 Title="Clôturer le cycle"
			 Eyebrow="Cycle de classe"
            ErrorMessage="@errorMessage"
			 CloseOnBackdrop="false"
			 MaxWidthClass="max-w-lg">
	@if (beendenDurchlauf is not null)
	{
		<div class="grid gap-3 sm:grid-cols-2">
			<div class="flex items-start gap-3 rounded-2xl border-2 p-3 shadow-sm @(beendenOffeneSchuld > 0 ? "border-rose-300 bg-rose-50 text-rose-900" : "border-emerald-200 bg-emerald-50 text-emerald-900")">
				<span class="text-xl" aria-hidden="true"><Icon Name="@(beendenOffeneSchuld > 0 ? "wallet" : "check")" /></span>
				<div>
					<p class="text-[11px] font-bold uppercase tracking-wide @(beendenOffeneSchuld > 0 ? "text-rose-700" : "text-emerald-700")">Frais de scolarité impayés</p>
					@if (beendenOffeneSchuld > 0)
					{
						<p class="text-xl font-black text-rose-700">@beendenOffeneSchuld.ToString("N0") FCFA</p>
						<p class="mt-1 text-xs font-medium">Ce montant sera signalé comme perte dans le rapport financier.</p>
					}
					else
					{
						<p class="text-base font-black">Tout est payé</p>
					}
				</div>
			</div>
			<div class="flex items-start gap-3 rounded-2xl border-2 p-3 shadow-sm @(beendenOhneNote > 0 ? "border-amber-300 bg-amber-50 text-amber-900" : "border-emerald-200 bg-emerald-50 text-emerald-900")">
				<span class="text-xl" aria-hidden="true"><Icon Name="@(beendenOhneNote > 0 ? "pen" : "check")" /></span>
				<div>
					<p class="text-[11px] font-bold uppercase tracking-wide @(beendenOhneNote > 0 ? "text-amber-700" : "text-emerald-700")">Notes finales</p>
					@if (beendenOhneNote > 0)
					{
						<p class="text-xl font-black text-amber-700">@beendenOhneNote / @beendenTeilnehmerGesamt <span class="text-sm font-bold">non définies</span></p>
                        <p class="mt-1 text-xs font-medium">Information : vous pouvez clôturer sans les définir. Ces résultats resteront non renseignés après la clôture.</p>
					}
					else
					{
						<p class="text-base font-black">Toutes les notes sont définies</p>
					}
				</div>
			</div>
		</div>
		<div class="mt-3 rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm leading-6 text-slate-700">
			<p class="flex items-center gap-2 text-base font-bold text-slate-900"><span aria-hidden="true"><Icon Name="alert" Groesse="16" /> </span>Clôture définitive du cycle de classe</p>
			<p class="mt-2">La clôture n'effectue aucune promotion automatique. Après réouverture d'une classe, le remplissage des élèves se fait manuellement par le directeur ou le coordinateur.</p>
            <p class="mt-2 font-semibold">Les notes finales et décisions déjà enregistrées seront conservées. Les résultats manquants ne bloquent pas la clôture et resteront non renseignés. Après la clôture, ils ne pourront plus être modifiés. @(beendenNeuerZyklus ? "Les élèves restent affectés à leur classe ; leur promotion est une opération distincte." : "Les élèves quitteront cette classe.")</p>
            @if (beendenNeuerZyklus)
            {
                <p class="mt-2 font-semibold">La facturation inclut tous les élèves admis pendant ce cycle, même partis, transférés ou bloqués depuis. L'école doit le montant ; l'utilisation d'un appareil n'est pas un critère. Seules les affectations erronées annulées avec motif par l'administrateur sont exclues.</p>
                <p>@beendenOffeneSkoulouAppAbos participant(s) · @beendenOffenerSkoulouAppUmsatz.ToString("N0") FCFA. La facture est créée automatiquement à la clôture, y compris par un coordinateur autorisé.</p>
                <details class="mt-2"><summary class="cursor-pointer font-semibold">Participants enregistrés pour la facturation</summary>
                    @foreach (var p in beendenZyklusTeilnehmer)
                    {
                        <div class="break-words border-b py-2"><strong>@p.Name</strong> · @p.Preis.ToString("N0") FCFA @(p.StorniertAmUtc != null ? "— Annulé : " + p.StornoGrund : "— À facturer")</div>
                    }
                </details>
            }
            else
            {
            <p class="mt-2">@(!istDirektor
				? "La clôture par un coordinateur ne crée pas de facturation automatique. La direction doit demander la facturation des abonnements non encore facturés dans Facturation SKOULOU."
				: "Les abonnements SKOULOU payés et non encore facturés seront facturés automatiquement lors de la clôture. Vous devrez ensuite déclarer le virement dans Facturation SKOULOU avant de démarrer un nouveau cycle.")</p>
			@if (beendenOffeneSkoulouAppAbos > 0 && istDirektor)
			{
				<p class="mt-2 text-xs font-semibold text-sky-700">@beendenOffeneSkoulouAppAbos abonnement(s) payé(s) non encore facturé(s) (@beendenOffenerSkoulouAppUmsatz.ToString("N0") FCFA).</p>
			}
            }
		</div>
		<div class="mt-5">
			<label class="skoulou-label">Date de fin effective</label>
			<TailwindDateTimePicker Value="beendenDatum" ValueChanged="SetBeendenDatumAsync" ShowTime="false" />
		</div>
		<div class="mt-6 flex flex-col-reverse gap-3 border-t border-slate-100 pt-4 md:flex-row md:flex-wrap md:justify-end">
			<button type="button" class="sk-btn sk-btn-secondary w-full whitespace-nowrap md:w-auto" @onclick="BeendenAbbrechen">Annuler</button>
			<AsyncActionButton Class="sk-btn sk-btn-danger w-full whitespace-nowrap md:w-auto" IsBusy="IsBusy" OnClick="DurchlaufBeendenBestaetigenAsync">Confirmer la clôture</AsyncActionButton>
		</div>
	}
</ModalDialog>

<ModalDialog @bind-Open="beendenEndgueltigOffen"
             Title="Confirmer la clôture définitive"
             Eyebrow="Dernière confirmation"
             CloseOnBackdrop="false"
             MaxWidthClass="max-w-md"
             ZIndexClass="z-[2300]">
    <div class="rounded-2xl border border-rose-200 bg-rose-50 p-4 text-sm leading-6 text-rose-950">
        <p class="font-black">Cette action est définitive.</p>
        <p class="mt-2">@(beendenNeuerZyklus ? "Le cycle sera clôturé. Les élèves restent dans leur classe ; la promotion est effectuée séparément." : "Le cycle sera clôturé et tous les élèves quitteront la classe active.")</p>
        @if (beendenOhneNote > 0)
        {
            <p class="mt-2 font-semibold">@beendenOhneNote élève(s) n'ont pas encore de note finale ou de décision complète. Ces informations resteront non renseignées.</p>
        }
        @if (beendenOffeneSchuld > 0)
        {
            <p class="mt-2 font-semibold">La dette restante de @beendenOffeneSchuld.ToString("N0") FCFA sera enregistrée comme perte.</p>
        }
    </div>
    <div class="mt-5 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <button type="button" class="sk-btn sk-btn-secondary" @onclick="() => beendenEndgueltigOffen = false">Retour</button>
        <AsyncActionButton Class="sk-btn sk-btn-danger"
                           IsBusy="IsBusy"
                           BusyLabel="Clôture..."
                           OnClick="DurchlaufEndgueltigBeendenAsync">
            Clôturer définitivement
        </AsyncActionButton>
    </div>
</ModalDialog>
