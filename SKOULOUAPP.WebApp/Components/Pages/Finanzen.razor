            @if (beendenOffeneSchuld > 0)
            {
                <div class="mt-3 rounded-xl bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-800 ring-1 ring-amber-100">
                ⚠ Dette ouverte : @beendenOffeneSchuld.ToString("N0") FCFA. Si tu continues, elle sera automatiquement comptabilisée comme perte de l'école.
                </div>
            }
            @if (beendenOffeneHalloAppAbos > 0)
            {
                <div class="mt-3 rounded-xl bg-sky-50 px-4 py-3 text-sm text-sky-900 ring-1 ring-sky-100">
                    <p class="font-semibold">ℹ Abonnements SKOULOUAPP ouverts</p>
                    <p class="mt-1">
                        @beendenOffeneHalloAppAbos abonnement(s) payé(s) ne sont pas encore facturés
                        (@beendenOffenerHalloAppUmsatz.ToString("N0") FCFA). En confirmant la clôture,
                        le système générera automatiquement la facturation technique SKOULOUAPP pour cette école.
                    </p>
                    <p class="mt-1 text-xs font-semibold text-sky-700">
                        Cette exception est uniquement liée à la clôture du cycle : elle ne donne pas au directeur le droit de créer librement des facturations SKOULOUAPP.
                    </p>
                </div>
            }
            <p class="mt-3 text-sm text-slate-600">Tu peux annuler pour encaisser d'abord les frais scolaires restants, ou continuer et clôturer le cycle. Après la clôture, aucun paiement échelonné n'est possible jusqu'à la réouverture pour la prochaine cohorte.</p>
            <div class="mt-3">
                <label class="mb-2 block text-xs font-semibold uppercase tracking-wide text-slate-500">Clôturer le</label>
                <TailwindDateTimePicker Value="beendenDatum" ValueChanged="SetBeendenDatumAsync" ShowTime="false" />
            </div>
            <div class="mt-5 flex justify-end gap-2">
                <button type="button" class="rounded-xl bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700" @onclick="BeendenAbbrechen">Annuler</button>
                <AsyncActionButton Class="rounded-xl bg-rose-600 px-4 py-2 text-sm font-semibold text-white" IsBusy="IsBusy" OnClick="DurchlaufBeendenBestaetigenAsync">Confirmer la clôture</AsyncActionButton>
            </div>
            </div>
        </div>
    </div>
}
