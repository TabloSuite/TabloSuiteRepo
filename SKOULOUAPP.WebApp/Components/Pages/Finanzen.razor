@page "/finanzen"
@attribute [Authorize(Roles = "SchulLeiter,Koordinator,SuperAdmin")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits HalloApp.WebApp.Components.CancelableComponentBase
@using HalloApp.Core.DataModels.Finanzen
@using HalloApp.Core.Services
@using HalloApp.WebApp.Components.Shared

<PageTitle>Finances</PageTitle>

<section class="pdf-export-container flex flex-col gap-4">
    <div class="hallo-hero relative overflow-hidden rounded-[2rem] p-6 text-white shadow-2xl">
        <div class="relative">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-200">Gestion financière</p>
            <h1 class="mt-3 text-3xl font-black">Recettes &amp; dépenses de l'école</h1>
            <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-300">
                Saisir les recettes/dépenses, gérer les cycles de classes (démarrage/clôture) et suivre les paiements échelonnés des élèves.
            </p>
        </div>
    </div>

    @if (!schulenGeladen)
    {
        <div class="rounded-[2rem] bg-white px-6 py-5 text-slate-700 ring-1 ring-slate-100">
            <p class="text-sm font-semibold">Chargement des écoles...</p>
        </div>
    }
    else if (schulen.Count == 0)
    {
        <div class="rounded-[2rem] bg-amber-50 px-6 py-5 text-amber-800 ring-1 ring-amber-100">
            <h2 class="text-lg font-black text-amber-950">Aucune école disponible</h2>
            <p class="mt-2 text-sm leading-6">Les recettes, dépenses et cycles apparaîtront après la création ou l'attribution d'une école.</p>
        </div>
    }
    else
    {
        @if (schulen.Count > 1)
        {
            <div class="flex flex-wrap items-center gap-3 rounded-2xl bg-white px-5 py-4 shadow ring-1 ring-slate-100">
                <ModernDropdown TValue="Guid?" Label="École" Value="aktiveSchulID" ValueChanged="SchuleWechselnAsync" Options="SchulOptionen" Searchable="true" SearchPlaceholder="Rechercher une école..." ContainerClass="w-full sm:w-72" />
                <span class="text-xs font-medium text-slate-500">Toutes les données affichées concernent l'école sélectionnée.</span>
            </div>
        }
        else if (schulen.Count == 1)
        {
            <div class="rounded-2xl bg-cyan-50 px-5 py-4 text-sm font-semibold text-cyan-800 ring-1 ring-cyan-100">École gérée : @schulen[0].Name</div>
        }

        <Toast Message="@message" MessageChanged="v => message = v" Kind="Toast.ToastKind.Success" />
        <Toast Message="@errorMessage" MessageChanged="v => errorMessage = v" Kind="Toast.ToastKind.Error" />

        @* Tabs *@
        <div class="school-page-tabs print:hidden">
            @if (canViewDashboard) { <button type="button" class="rounded-full px-4 py-2 text-sm font-semibold @(aktiverTab == "dashboard" ? "hallo-btn-accent" : "bg-slate-100 text-slate-700")" @onclick='() => SetTab("dashboard")'>Finances de l'école</button> }
            @if (canCreateEntries) { <button type="button" class="rounded-full px-4 py-2 text-sm font-semibold @(aktiverTab == "erfassen" ? "hallo-btn-accent" : "bg-slate-100 text-slate-700")" @onclick='() => SetTab("erfassen")'>Nouvelle écriture</button> }
            @if (canManageCycles) { <button type="button" class="rounded-full px-4 py-2 text-sm font-semibold @(aktiverTab == "durchlaeufe" ? "hallo-btn-accent" : "bg-slate-100 text-slate-700")" @onclick='() => SetTab("durchlaeufe")'>Paiements des cycles</button> }
        </div>

        @if (aktiverTab == "dashboard" && canViewDashboard)
        {
            @* -------------------- DASHBOARD -------------------- *@
            <div class="rounded-2xl bg-white p-5 shadow ring-1 ring-slate-100">
                @if (finanzAbgleich is not null)
                {
                    <div class="mb-5 rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700">
                        <h2 class="font-bold text-slate-900">Rapprochement des justificatifs et des écritures</h2>
                        <p class="mt-2">Scolarité : paiements enregistrés @finanzAbgleich.SchulgebuehrenZahlungen.ToString("N0") FCFA · écritures liées @finanzAbgleich.SchulgebuehrenBuchungen.ToString("N0") FCFA · anomalies @finanzAbgleich.SchulgebuehrenAbweichungen</p>
                        <p class="mt-1">Factures SKOULOUAPP : total facturé @finanzAbgleich.PlattformRechnungen.ToString("N0") FCFA · parts comptabilisées pour ces factures @finanzAbgleich.PlattformBuchungenZuRechnungen.ToString("N0") FCFA · virements confirmés @finanzAbgleich.BestaetigtePlattformZahlungen.ToString("N0") FCFA · factures à vérifier @finanzAbgleich.PlattformRechnungenMitAbweichung</p>
                        <p class="mt-1 text-xs text-slate-500">Les factures en attente ne sont pas des paiements reçus. La confirmation d'un virement ne crée pas une seconde dépense.</p>
                    </div>
                }
                @if (uebersicht is not null)
                {
                    @if (direktorKontostand is not null)
                    {
                        <div class="mt-5 overflow-hidden rounded-[2rem] bg-slate-950 text-white shadow-2xl print:border print:border-slate-300 print:bg-white print:text-slate-950 print:shadow-none">
                            <div class="bg-gradient-to-r from-cyan-700 via-blue-800 to-indigo-900 p-6">
                                <div class="flex flex-wrap items-center justify-between gap-2">
                                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan-100">Trésorerie actuelle · @AktiveSchuleName</p>
                                    <div class="flex flex-wrap items-center gap-2">
                                        <span class="rounded-full bg-white/15 px-3 py-1 text-xs font-semibold text-cyan-100">Indépendante des filtres</span>
                                        <span class="rounded-full px-3 py-1 text-xs font-bold ring-1 @SoldeEtatBadgeClass(direktorKontostand.WirklicherKontostandNachAboVerteilung)">@SoldeEtatLabel(direktorKontostand.WirklicherKontostandNachAboVerteilung)</span>
                                    </div>
                                </div>
                                <div class="mt-4 flex flex-wrap items-end justify-between gap-4">
                                    <div>
                                        <h2 class="text-2xl font-black sm:text-3xl">Solde provisoire avant règlement SKOULOUAPP</h2>
                                        <p class="mt-2 text-sm font-semibold text-cyan-50 sm:hidden">Montant total avant déduction de la part SKOULOUAPP.</p>
                                        <p class="mt-2 hidden max-w-xl text-sm leading-6 text-cyan-100 sm:block">Ce montant inclut toutes les recettes et dépenses de l'école avant le règlement de la part SKOULOUAPP.</p>
                                    </div>
                                    <div class="w-full rounded-2xl bg-white px-5 py-4 text-left text-slate-950 shadow-xl sm:w-auto sm:text-right print:border print:border-slate-200">
                                        <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Avant règlement SKOULOUAPP</p>
                                        <p class="mt-1 text-4xl font-black tabular-nums sm:text-5xl @SoldeFarbe(direktorKontostand.KontostandMitNichtUeberwiesenenHalloAppAnteilen)">@direktorKontostand.KontostandMitNichtUeberwiesenenHalloAppAnteilen.ToString("N0") FCFA</p>
                                        <p class="mt-1 text-xs font-semibold text-slate-500">Après règlement SKOULOUAPP (prévision): @direktorKontostand.WirklicherKontostandNachAboVerteilung.ToString("N0") FCFA</p>
                                    </div>
                                </div>

                                <div class="mt-5 grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
                                    <div class="rounded-xl bg-white/10 px-4 py-3 ring-1 ring-white/20">
                                        <p class="text-[11px] font-bold uppercase tracking-wide text-cyan-100">Avant règlement SKOULOUAPP</p>
                                        <p class="mt-1 text-xl font-black tabular-nums text-emerald-300">@direktorKontostand.KontostandMitNichtUeberwiesenenHalloAppAnteilen.ToString("N0") FCFA</p>
                                    </div>
                                    <div class="rounded-xl bg-white/10 px-4 py-3 ring-1 ring-white/20">
                                        <p class="text-[11px] font-bold uppercase tracking-wide text-cyan-100">Part SKOULOUAPP comptabilisée</p>
                                        <p class="mt-1 text-xl font-black tabular-nums text-rose-300">@direktorKontostand.HalloAppAboAnteil.ToString("N0") FCFA</p>
                                    </div>
                                    <div class="rounded-xl bg-white/10 px-4 py-3 ring-1 ring-white/20">
                                        <p class="text-[11px] font-bold uppercase tracking-wide text-cyan-100">Parts gardées par l'école</p>
                                        <p class="mt-1 text-xl font-black tabular-nums text-emerald-300">@((direktorKontostand.SchulleiterAboAnteil + direktorKontostand.LehrerAboAnteil).ToString("N0")) FCFA</p>
                                    </div>
                                    <div class="rounded-xl bg-white/10 px-4 py-3 ring-1 ring-white/20">
                                        <p class="text-[11px] font-bold uppercase tracking-wide text-cyan-100">Scolarité restant à payer (cycles actifs)</p>
                                        <p class="mt-1 text-xl font-black tabular-nums text-cyan-100">@direktorKontostand.OffeneSchulgebuehrenAktiveKlassen.ToString("N0") FCFA</p>
                                        <span class="mt-2 inline-flex rounded-full px-2.5 py-1 text-[11px] font-bold ring-1 @PaiementsAttenteBadgeClass">@PaiementsAttenteEtatLabel</span>
                                    </div>
                                </div>
                            </div>

                            <div class="grid gap-4 p-5 lg:grid-cols-5">
                                <div class="rounded-2xl bg-white/10 p-4 lg:col-span-2">
                                    <p class="text-xs font-bold uppercase tracking-[0.16em] text-cyan-200">Mouvements de l'école</p>
                                    <div class="mt-4 space-y-3 text-sm">
                                        <div class="flex justify-between gap-3"><span class="text-slate-300">Scolarité encaissée</span><strong class="text-emerald-300">+ @direktorKontostand.SchulgebuehrenEingenommen.ToString("N0") FCFA</strong></div>
                                        <div class="flex justify-between gap-3"><span class="text-slate-300">Autres recettes</span><strong class="text-emerald-300">+ @direktorKontostand.SonstigeEinnahmen.ToString("N0") FCFA</strong></div>
                                         <div class="flex justify-between gap-3"><span class="text-slate-300">Abonnements SKOULOUAPP encaissés</span><strong class="text-emerald-300">+ @direktorKontostand.HalloAppAboEingenommen.ToString("N0") FCFA</strong></div>
                                        <div class="flex justify-between gap-3"><span class="text-slate-300">Dépenses de fonctionnement</span><strong class="text-rose-300">− @direktorKontostand.BetrieblicheAusgaben.ToString("N0") FCFA</strong></div>
                                    </div>
                                     <div class="mt-4 flex items-center justify-between gap-3 border-t border-white/15 pt-3">
                                         <span class="text-xs font-bold uppercase tracking-[0.14em] text-cyan-200">Solde provisoire avant répartition</span>
                                         <strong class="text-lg @SoldeFarbe(direktorKontostand.KontostandMitNichtUeberwiesenenHalloAppAnteilen)">@direktorKontostand.KontostandMitNichtUeberwiesenenHalloAppAnteilen.ToString("N0") FCFA</strong>
                                     </div>
                                </div>

                                <div class="rounded-2xl bg-cyan-950/45 p-4 ring-1 ring-cyan-300/20 lg:col-span-3">
                                    <div class="flex flex-wrap items-start justify-between gap-3">
                                        <div>
                                            <p class="text-xs font-bold uppercase tracking-[0.16em] text-cyan-200">Abonnements SKOULOUAPP encaissés</p>
                                            <p class="mt-1 text-2xl font-black text-cyan-100">@direktorKontostand.HalloAppAboEingenommen.ToString("N0") FCFA</p>
                                        </div>
                                        <div class="rounded-full bg-cyan-300/15 px-3 py-1 text-xs font-semibold text-cyan-100">Montant encaissé pour le compte de SKOULOUAPP</div>
                                    </div>
                                    <div class="mt-4 grid gap-2 sm:grid-cols-3">
                                        <div class="rounded-xl bg-slate-950/35 p-3"><p class="text-xs text-slate-300">Part direction (dans l'école)</p><p class="mt-1 font-black text-emerald-300">+ @direktorKontostand.SchulleiterAboAnteil.ToString("N0") FCFA</p></div>
                                        <div class="rounded-xl bg-slate-950/35 p-3"><p class="text-xs text-slate-300">Part enseignants (dans l'école)</p><p class="mt-1 font-black text-emerald-300">+ @direktorKontostand.LehrerAboAnteil.ToString("N0") FCFA</p></div>
                                        <div class="rounded-xl bg-slate-950/35 p-3"><p class="text-xs text-slate-300">Part SKOULOUAPP comptabilisée</p><p class="mt-1 font-black text-rose-300">− @direktorKontostand.HalloAppAboAnteil.ToString("N0") FCFA</p></div>
                                    </div>
                                    <p class="mt-3 text-xs leading-5 text-cyan-100">Calcul appliqué: @direktorKontostand.KontostandMitNichtUeberwiesenenHalloAppAnteilen.ToString("N0") FCFA − @direktorKontostand.HalloAppAboAnteil.ToString("N0") FCFA = @direktorKontostand.WirklicherKontostandNachAboVerteilung.ToString("N0") FCFA.</p>
                                </div>
                            </div>

                            <div class="mx-5 mt-5 flex flex-wrap items-center justify-between gap-4 border-t border-white/10 pt-5">
                                <div>
                                    <p class="text-xs font-bold uppercase tracking-[0.16em] text-cyan-200">Paiements encore attendus · tous les cycles actifs</p>
                                    <p class="mt-1 text-sm text-slate-300">Estimation à partir des prix des cycles et des paiements enregistrés, non facturée ici. Elle n'est pas incluse dans le solde ni dans le rapport filtré.</p>
                                </div>
                                <div class="text-right">
                                    <p class="text-3xl font-black text-cyan-200">@direktorKontostand.OffeneSchulgebuehrenAktiveKlassen.ToString("N0") FCFA</p>
                                    <span class="mt-2 inline-flex rounded-full px-2.5 py-1 text-[11px] font-bold ring-1 @PaiementsAttenteBadgeClass">@PaiementsAttenteEtatLabel</span>
                                </div>
                            </div>
                            @if (offeneHalloAppAbrechnungen.Count > 0)
                            {
                                <div class="mx-5 mt-4 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-amber-300/30 bg-amber-300/10 px-5 py-4">
                                    <div>
                                        <p class="text-xs font-bold uppercase tracking-[0.16em] text-amber-200">Facturation SKOULOUAPP à régler</p>
                                        <p class="mt-1 text-sm text-amber-50">@offeneHalloAppAbrechnungen.Count facture(s) demandée(s) par l'Administrateur. Les parts du responsable produit ne sont pas affichées dans cet espace.</p>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-2xl font-black text-amber-200">@offeneHalloAppAbrechnungen.Sum(periode => periode.Umsatz).ToString("N0") FCFA</p>
                                        <a href="/abrechnung" class="mt-1 inline-block text-xs font-bold text-white underline">Voir et déclarer le virement</a>
                                    </div>
                                </div>
                            }
                            <div class="mx-5 mb-5 mt-4 flex flex-wrap items-center justify-between gap-4 rounded-2xl bg-white px-5 py-4 text-slate-950 shadow-lg ring-1 ring-slate-200 print:border print:border-slate-300">
                                <div>
                                    <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-500">Récapitulatif du calcul</p>
                                    <h3 class="mt-1 text-xl font-black">Solde disponible après règlement</h3>
                                    <p class="mt-1 text-sm text-slate-600">Solde calculé à partir des écritures enregistrées. Les parts direction et enseignants restent dans l'école; seule la part SKOULOUAPP comptabilisée est déduite. Les factures encore à régler sont indiquées séparément.</p>
                                    <div class="mt-3 flex flex-wrap items-center gap-2 text-sm font-bold">
                                        <span class="rounded-lg bg-slate-100 px-3 py-2 text-slate-700">Solde avec abonnement SKOULOUAPP&nbsp;: @direktorKontostand.KontostandMitNichtUeberwiesenenHalloAppAnteilen.ToString("N0") FCFA</span>
                                        <span class="text-lg text-slate-400">−</span>
                                        <span class="rounded-lg bg-cyan-50 px-3 py-2 text-cyan-800">Part SKOULOUAPP comptabilisée&nbsp;: @direktorKontostand.HalloAppAboAnteil.ToString("N0") FCFA</span>
                                        <span class="text-lg text-slate-400">=</span>
                                        <span class="rounded-lg bg-emerald-50 px-3 py-2 text-emerald-800">Solde disponible après règlement&nbsp;: @direktorKontostand.WirklicherKontostandNachAboVerteilung.ToString("N0") FCFA</span>
                                    </div>
                                </div>
                                <p class="text-4xl font-black @SoldeFarbe(direktorKontostand.WirklicherKontostandNachAboVerteilung)">@direktorKontostand.WirklicherKontostandNachAboVerteilung.ToString("N0") FCFA</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mt-5 rounded-[2rem] bg-slate-950 p-6 text-white shadow-2xl print:bg-white print:text-slate-950">
                            <p class="text-xs font-bold uppercase tracking-[0.18em] text-cyan-200">Rapport financier filtré · @AktiveSchuleName</p>
                            <p class="mt-2 text-sm text-slate-300">@BerichtZeitraumLabel · @BerichtTypLabel · @BerichtSortierungLabel</p>
                            <p class="mt-4 text-4xl font-black text-emerald-300">@uebersicht.Saldo.ToString("N0") FCFA</p>
                        </div>
                    }

                    <div class="mt-5">
                        <div class="rounded-[1.5rem] border border-indigo-100 bg-gradient-to-br from-indigo-50 via-white to-cyan-50 p-5 shadow-sm print:hidden">
                            <div class="flex flex-wrap items-start justify-between gap-3">
                                <div class="flex items-start gap-3">
                                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-indigo-600 text-lg text-white shadow-lg shadow-indigo-200">⌕</div>
                                    <div>
                                    <p class="text-xs font-bold uppercase tracking-[0.16em] text-indigo-700">Journal opérationnel</p>
                                    <h2 class="mt-1 text-lg font-black text-slate-900">Filtrer les écritures de l'école</h2>
                                    <p class="mt-1 text-sm text-slate-600">Les filtres et le tri ci-dessous concernent uniquement ce journal.</p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="rounded-full bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white shadow-sm">@BerichtZeitraumLabel · @BerichtTypLabel</span>
                    <a class="rounded-full bg-slate-800 px-4 py-2 text-sm font-bold text-white no-underline shadow-sm transition hover:bg-slate-700" href="@FinanzBerichtUrl">Voir le rapport</a>
                                </div>
                            </div>
                            <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-5">
                                <div class="rounded-xl bg-white/90 p-3 shadow-sm ring-1 ring-slate-200">
                                    <label class="mb-2 block text-xs font-semibold uppercase tracking-wide text-slate-500">Du</label>
                                    <TailwindDateTimePicker Value="filter.Von" ValueChanged="SetFilterVonAsync" ShowTime="false" />
                                </div>
                                <div class="rounded-xl bg-white/90 p-3 shadow-sm ring-1 ring-slate-200">
                                    <label class="mb-2 block text-xs font-semibold uppercase tracking-wide text-slate-500">Au</label>
                                    <TailwindDateTimePicker Value="filter.Bis" ValueChanged="SetFilterBisAsync" ShowTime="false" />
                                </div>
                                <div class="rounded-xl bg-white/90 p-3 shadow-sm ring-1 ring-slate-200"><ModernDropdown TValue="FinanzRichtung?" Label="Type" Value="filter.Richtung" ValueChanged="SetFilterRichtungAsync" Options="RichtungsOptionen" /></div>
                                <div class="rounded-xl bg-white/90 p-3 shadow-sm ring-1 ring-slate-200"><ModernDropdown TValue="FinanzSortierung?" Label="Tri" Value="filter.Sortierung" ValueChanged="SetFilterSortierungAsync" Options="SortierungsOptionen" /></div>
                                <div class="flex items-end">
                                    <AsyncActionButton Class="hallo-btn-accent rounded-xl px-5 py-2.5 text-sm font-semibold shadow-sm" IsBusy="IsBusy" OnClick="LadeUebersichtAsync">Appliquer</AsyncActionButton>
                                </div>
                            </div>
                            <div class="mt-4 rounded-xl bg-white/90 px-3 py-2 text-xs font-semibold text-slate-700 ring-1 ring-slate-200">
                                Mode de calcul actif: @ZeitraumOptionLabel
                            </div>
                        </div>
                        <div class="finance-journal-export space-y-3">
                        <CollapsibleCard Title="Synthèse du journal réel"
                                         Subtitle="Vue de calcul pour la période sélectionnée"
                                         Eyebrow="Journal opérationnel"
                                         Icon="🧾"
                                         Accent="indigo"
                                         InitiallyExpanded="false">
                            <HeaderRight>
                                <div class="flex flex-wrap items-center gap-2">
                                    <Badge Accent="emerald">Entrées période: @EchteBuchungenEntrees.ToString("N0") FCFA</Badge>
                                    <Badge Accent="rose">Sorties période: @ZeitraumSortiesBasis.ToString("N0") FCFA</Badge>
                                    <Badge Accent="indigo">Solde App: @ZeitraumSaldoAnzeige.ToString("N0") FCFA</Badge>
                                </div>
                            </HeaderRight>
                            <ChildContent>
                                <div class="rounded-2xl border border-slate-100 bg-slate-50 px-4 py-3 text-xs text-slate-700">
                                        <div class="space-y-2 border-y border-slate-200 py-3 text-sm">
                                            <div style="display:grid;grid-template-columns:1fr 12rem;column-gap:1rem;align-items:center;">
                                                <span class="text-slate-600">Entrées période</span>
                                                <span class="text-right text-base font-bold text-emerald-700">@EchteBuchungenEntrees.ToString("N0") FCFA</span>
                                            </div>
                                            <div style="display:grid;grid-template-columns:1fr 12rem;column-gap:1rem;align-items:center;">
                                                <span class="text-slate-600">Entrées SKOULOUAPP</span>
                                                <span class="text-right text-base font-bold text-emerald-700">@HalloAppAboTotal.ToString("N0") FCFA</span>
                                            </div>
                                            <div style="display:grid;grid-template-columns:1fr 12rem;column-gap:1rem;align-items:center;">
                                                <span class="text-slate-600">Sorties période</span>
                                                <span class="text-right text-base font-bold text-rose-700">@ZeitraumSortiesBasis.ToString("N0") FCFA</span>
                                            </div>
                                        </div>
                                        <div class="border-b border-dashed border-slate-300 py-3">
                                            <div style="display:grid;grid-template-columns:1fr 12rem;column-gap:1rem;align-items:center;">
                                                <span class="text-xl font-extrabold text-slate-900">Sous-total avant part SKOULOUAPP</span>
                                                <span class="text-right text-2xl font-extrabold text-emerald-700">@ZeitraumSoldeAvantPartSkoulou.ToString("N0") FCFA</span>
                                            </div>
                                        </div>
                                        <div class="space-y-2 py-3 text-sm">
                                            <div style="display:grid;grid-template-columns:1fr 12rem;column-gap:1rem;align-items:center;">
                                                <span class="text-slate-600">Part direction</span>
                                                <span class="text-right font-semibold text-slate-900">@CommissionSchulleiter.ToString("N0") FCFA</span>
                                            </div>
                                            <div style="display:grid;grid-template-columns:1fr 12rem;column-gap:1rem;align-items:center;">
