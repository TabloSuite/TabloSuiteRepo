@page "/teacher"
@attribute [Authorize(Policy = "RequireTeacher")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits HalloApp.WebApp.Components.CancelableComponentBase
@using HalloApp.Core.Models.Dashboard
@using HalloApp.Core.DataModels.Schools

<PageTitle>Espace enseignant</PageTitle>

@if (isLoading)
{
    <div class="rounded-[2rem] bg-white p-8 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
        <div class="flex items-center gap-3 text-slate-600">
            <ProgressRing Size="1.5rem" Label="Chargement du tableau de bord" />
            <p class="text-sm">Chargement du tableau de bord...</p>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(loadErrorMessage))
{
    <div class="rounded-[2rem] bg-rose-50 p-8 text-rose-800 shadow-lg shadow-rose-100/70 ring-1 ring-rose-100">
        <h2 class="text-lg font-black">Chargement impossible</h2>
        <p class="mt-2 text-sm">@loadErrorMessage</p>
        <button type="button" class="mt-5 rounded-full bg-rose-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-rose-700" @onclick="LoadAsync">Réessayer</button>
    </div>
}
else if (teacherSchools.Count == 0 && students.Count == 0)
{
    <div class="rounded-[2rem] bg-white p-8 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
        <h2 class="text-lg font-black text-slate-900">@(isSchoolDirectionUser ? "Aucune classe d'enseignant configurée" : "Aucune classe attribuée")</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">@(isSchoolDirectionUser
            ? "Aucun enseignant n'a encore de classe attribuée. Dès qu'une classe est affectée à un enseignant, elle apparaîtra ici."
            : "Ton directeur doit d'abord t'attribuer au moins une classe et indiquer tes heures hebdomadaires. Tu verras ensuite uniquement les élèves de ces classes.")</p>
    </div>
}
else
{
    <section class="teacher-dashboard grid gap-6">
        <div class="hallo-hero relative overflow-hidden rounded-[2rem] p-8 text-white shadow-2xl xl:p-10">
            <div class="pointer-events-none absolute -top-20 -right-14 h-56 w-56 rounded-full bg-cyan-300/20 blur-3xl"></div>
            <div class="pointer-events-none absolute -bottom-16 -left-10 h-48 w-48 rounded-full bg-violet-300/20 blur-3xl"></div>
            <div class="relative">
                <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-100">Espace enseignant</p>
                <h1 class="mt-3 text-3xl font-black xl:text-4xl">Gérer les élèves, les classes et les écoles</h1>
                <p class="mt-4 max-w-3xl text-sm leading-7 text-indigo-50">Valide les auto-inscriptions, débloque les élèves, gère les classes attribuées et suis l'activité de tes différentes écoles.</p>
                <button type="button"
                        class="mt-6 inline-flex items-center gap-2 rounded-full bg-white/15 px-5 py-2.5 text-sm font-semibold text-white ring-1 ring-white/30 backdrop-blur transition duration-200 hover:bg-white/25"
                        @onclick="ToggleAllSections">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="@(AllExpanded ? "m4.5 15.75 7.5-7.5 7.5 7.5" : "m19.5 8.25-7.5 7.5-7.5-7.5")" />
                    </svg>
                    @(AllExpanded ? "Tout réduire" : "Tout développer")
                </button>
            </div>
        </div>

        <div class="grid gap-4 2xl:grid-cols-3">
            @if (HasMultipleSchools)
            {
                <button type="button"
                        class="rounded-3xl bg-white p-5 text-left shadow-lg shadow-slate-200/70 ring-1 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl @(selectedSchoolId is null ? "ring-2 ring-indigo-500 shadow-indigo-200/50" : "ring-slate-100")"
                        @onclick="() => SelectSchool(null)">
                    <h2 class="text-lg font-bold text-slate-900">Toutes les écoles</h2>
                    <p class="mt-1 text-sm text-slate-500">Vue combinée de tes classes</p>
                    <div class="mt-4 rounded-2xl bg-slate-50 p-3 text-center text-sm"><div class="font-black text-slate-900">@students.Count</div><div class="text-slate-500">Élèves attribués</div></div>
                </button>
            }
            @foreach (var school in teacherSchools)
            {
                <button type="button"
                        class="rounded-3xl bg-white p-5 text-left shadow-lg shadow-slate-200/70 ring-1 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl @(selectedSchoolId == school.SchoolId ? "ring-2 ring-indigo-500 shadow-indigo-200/50" : "ring-slate-100")"
                        @onclick="() => SelectSchool(school.SchoolId)">
                    <h2 class="text-lg font-bold text-slate-900">@school.SchoolName</h2>
                    <p class="mt-1 text-sm text-slate-500">@school.City</p>
                    <div class="mt-4 grid gap-3 text-center text-sm sm:grid-cols-1">
                        <div class="rounded-2xl bg-slate-50 p-3"><div class="font-black text-slate-900">@school.StudentCount</div><div class="text-slate-500">Élèves</div></div>
                    </div>
                </button>
            }
        </div>

        <div class="teacher-student-management-heading rounded-3xl bg-slate-50 px-6 py-5 ring-1 ring-slate-100">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-cyan-700">Validations et suivi</p>
            <h2 class="mt-1 text-xl font-black text-slate-900">Statut et progression des élèves</h2>
            <p class="mt-1 text-sm text-slate-500">Consulte le statut et la progression des élèves de tes classes.</p>
        </div>

        <CollapsibleCard Title="Statut des élèves"
                         Eyebrow="Statut"
                         Subtitle="Consulter le statut des élèves"
                         Icon="??"
                         Accent="blue"
                         Expanded="statusExpanded"
                         ExpandedChanged="v => statusExpanded = v">
            <HeaderRight>
                <Badge Accent="slate">@filteredStudents.Count élèves</Badge>
            </HeaderRight>
            <ChildContent>
                <div class="mb-4 flex flex-wrap items-end gap-3">
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-slate-600">Inscrit depuis le</label>
                        <TailwindDateTimePicker @bind-Value="enrolledFromDate" ShowTime="false" @bind-Value:after="OnDateFilterChanged" />
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-slate-600">Inscrit jusqu'au</label>
                        <TailwindDateTimePicker @bind-Value="enrolledToDate" ShowTime="false" @bind-Value:after="OnDateFilterChanged" />
                    </div>
                </div>

                <DataListPanel Items="filteredStudents"
                               PageSize="10"
                               SearchPlaceholder="Rechercher un élève..."
                               EmptyText="Aucun élève trouvé."
                               ResultLabelSingular="élève"
                               ResultLabelPlural="élèves"
                               Chips="studentChips"
                               SortOptions="studentSortOptions"
                               Filter="@((StudentApprovalItem s, string term) => Contains(s.FullName, term) || Contains(s.Email, term) || Contains(s.SchoolName, term) || Contains(s.CurrentLevelCode, term))">
                    <div class="grid gap-4">
                        @foreach (var student in context)
                        {
                            <article class="rounded-3xl border border-slate-200 p-5 transition duration-200 hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-md">
                                <div class="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
                                    <div>
                                        <div class="flex flex-wrap items-center gap-3">
                                            <h3 class="text-lg font-bold text-slate-900">@student.FullName</h3>
                                            <Badge Accent="@(student.IsBlocked ? "rose" : "emerald")">@(student.IsBlocked ? "Bloqué / en attente" : "Validé")</Badge>
                                        </div>
                                        <p class="mt-2 text-sm text-slate-500">@student.Email · @student.SchoolName · Classe @student.CurrentLevelCode</p>
                                        <p class="mt-2 text-sm text-slate-600">Leçons terminées : @student.CompletedLessonsCount</p>
                                        <div class="mt-2 flex flex-wrap gap-2">
                                            <Badge Accent="@GetAboStatusAccent(student)">@GetAboStatusLabel(student)</Badge>
                                            <div class="inline-flex items-center gap-2 rounded-full bg-slate-50 px-3 py-1.5 text-sm ring-1 ring-slate-200">
                                                <span aria-hidden="true">??</span>
                                                <span class="text-slate-600">Score exercices & examens :</span>
                                                @if (student.CombinedScorePercent.HasValue)
                                                {
                                                    <span class="font-black" style="color:@ScoreColorHelper.GetScoreColor(student.CombinedScorePercent.Value)">@student.CombinedScorePercent %</span>
                                                    <span class="text-xs text-slate-400">(@student.CombinedScoreCount)</span>
                                                }
                                                else
                                                {
                                                    <span class="text-slate-400">—</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                </DataListPanel>
            </ChildContent>
        </CollapsibleCard>

        <CollapsibleCard Title="Progression des élèves"
                         Eyebrow="Suivi de progression"
                         Subtitle="Leçons, exercices et examens"
                         Icon="??"
                         Accent="emerald"
                         Expanded="progressExpanded"
                         ExpandedChanged="v => progressExpanded = v">
            <HeaderRight>
                <Badge Accent="slate">@filteredProgress.Count élèves</Badge>
            </HeaderRight>
            <ChildContent>
                <DataListPanel Items="filteredProgress"
                               PageSize="10"
                               SearchPlaceholder="Rechercher un élève..."
                               EmptyText="Aucune donnée de progression disponible pour le moment."
                               ResultLabelSingular="élève"
                               ResultLabelPlural="élèves"
                               Chips="progressChips"
                               Filter="@((StudentProgressItem p, string term) => Contains(p.FullName, term) || Contains(p.SchoolName, term) || Contains(p.CurrentLevelCode, term))">
                    <div class="grid gap-4">
                        @foreach (var item in context)
                        {
                            <article class="rounded-3xl border border-slate-200 p-5">
                                <div class="flex flex-wrap items-center justify-between gap-3">
                                    <div>
                                        <h3 class="text-lg font-bold text-slate-900">@item.FullName</h3>
                                        <p class="text-sm text-slate-500">@item.SchoolName · Classe @item.CurrentLevelCode</p>
                                    </div>
                                    <Badge Accent="@(item.IsBlocked ? "rose" : "emerald")">@(item.IsBlocked ? "Bloqué" : "Actif")</Badge>
                                </div>
                                <div class="mt-4 grid gap-3 text-center text-sm sm:grid-cols-3 lg:grid-cols-4">
                                    <div class="rounded-2xl bg-slate-50 p-3"><div class="text-lg font-black text-slate-900">@item.CompletedLessonsCount</div><div class="text-slate-500">Leçons terminées</div></div>
                                    <div class="rounded-2xl bg-slate-50 p-3"><div class="text-lg font-black text-slate-900">@item.SolvedExerciseCount</div><div class="text-slate-500">Exercices réussis</div></div>
                                    <div class="rounded-2xl bg-slate-50 p-3"><div class="text-lg font-black text-slate-900">@item.ExamsPassed / @item.ExamsTaken</div><div class="text-slate-500">Examens réussis</div></div>
                                    <div class="rounded-2xl bg-slate-50 p-3"><div class="text-lg font-black" style="color:@ScoreColorHelper.GetScoreColor(item.CombinedScorePercent ?? 0)">@(item.CombinedScorePercent?.ToString() ?? "—") @(item.CombinedScorePercent is null ? "" : "%")</div><div class="text-slate-500">Score exercices & examens</div></div>
                                </div>
                                @if (item.LastActivityUtc is not null)
                                {
                                    <p class="mt-3 text-xs text-slate-400">Dernière activité : @item.LastActivityUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
                                }
                            </article>
                        }
                    </div>
                </DataListPanel>
            </ChildContent>
        </CollapsibleCard>

        <div class="rounded-3xl border border-violet-100 bg-violet-50 px-6 py-5 text-sm text-violet-900 ring-1 ring-violet-100">
            <p class="font-semibold uppercase tracking-[0.18em] text-violet-700">Organisation des classes</p>
            <h2 class="mt-2 text-xl font-black text-slate-900">Le tableau de bord se concentre sur les contenus de classe</h2>
            <p class="mt-2 leading-7">Retrouve ici un pilotage centré sur les classes, les supports, les exercices et les examens.</p>
        </div>
    </section>
}
