@page "/teacher"
@attribute [Authorize(Policy = "RequireTeacher")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits SkoulouApp.WebApp.Components.CancelableComponentBase
@using SkoulouApp.Core.Models.Dashboard
@using SkoulouApp.Core.DataModels.Schools

<PageTitle>Tableau pédagogique · SKOULOU</PageTitle>

<div class="mx-auto grid max-w-6xl gap-5">
    <SeitenKopf Rubrik="@(isSchoolDirectionUser ? "Direction" : "Espace enseignant")" Titel="Tableau pédagogique" IconName="grid"
                Untertitel="Suivez la progression de vos élèves : leçons terminées, exercices, examens et score." />

    @if (isLoading)
    {
        <div class="h-40 animate-pulse rounded-2xl bg-slate-200" role="status" aria-label="Chargement du tableau de bord"></div>
    }
    else if (!string.IsNullOrWhiteSpace(loadErrorMessage))
    {
        <div class="rounded-2xl border border-rose-200 bg-rose-50 p-5 text-rose-800">
            <h2 class="mb-0 text-base font-bold">Chargement impossible</h2>
            <p class="mb-0 mt-1 text-sm">@loadErrorMessage</p>
            <button type="button" class="sk-btn sk-btn-danger mt-4" @onclick="LoadAsync"><Icon Name="refresh" Groesse="16" />Réessayer</button>
        </div>
    }
    else if (teacherSchools.Count == 0 && students.Count == 0)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <h2 class="mb-0 flex items-center gap-2 text-base font-bold text-slate-900"><Icon Name="info" Groesse="18" />@(isSchoolDirectionUser ? "Aucune classe d'enseignant configurée" : "Aucune classe attribuée")</h2>
            <p class="mb-0 mt-2 text-sm leading-6 text-slate-600">@(isSchoolDirectionUser
                ? "Aucun enseignant n'a encore de classe attribuée. Dès qu'une classe est affectée à un enseignant, elle apparaîtra ici."
                : "Votre direction doit d'abord vous attribuer au moins une classe. Vous verrez ensuite uniquement les élèves de ces classes.")</p>
        </div>
    }
    else
    {
        <Abschnitt Titel="Élèves" Untertitel="@($"{filteredStudents.Count} élève(s) dans la sélection")" IconName="graduation">
            <div class="grid gap-4">
                <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                    @if (teacherSchools.Count > 0)
                    {
                        <ModernDropdown TValue="Guid?" Label="École" Value="selectedSchoolId" ValueChanged="SelectSchool" Options="SchoolFilterOptions" EinzigeOptionFest="true" />
                        <ModernDropdown TValue="Guid?" Label="Classe" Value="selectedKlasseId" ValueChanged="SelectKlasse" Options="KlasseFilterOptions" />
                    }
                    <div>
                        <label class="skoulou-label">Inscrit depuis le</label>
                        <TailwindDateTimePicker @bind-Value="enrolledFromDate" ShowTime="false" @bind-Value:after="OnDateFilterChanged" />
                    </div>
                    <div>
                        <label class="skoulou-label">Inscrit jusqu'au</label>
                        <TailwindDateTimePicker @bind-Value="enrolledToDate" ShowTime="false" @bind-Value:after="OnDateFilterChanged" />
                    </div>
                </div>

                <DataListPanel Items="filteredStudents"
                               PageSize="10"
                               SearchPlaceholder="Rechercher un élève…"
                               EmptyText="@(selectedSchoolId.HasValue && selectedKlasseId.HasValue ? "Aucun élève trouvé." : "Sélectionnez d'abord une école et une classe.")"
                               ResultLabelSingular="élève"
                               ResultLabelPlural="élèves"
                               SortOptions="studentSortOptions"
                               Filter="@((StudentApprovalItem s, string term) => Contains(s.FullName, term) || Contains(s.Email, term) || Contains(s.SchoolName, term) || Contains(s.CurrentLevelCode, term))">
                    <ul class="m-0 grid list-none gap-2 p-0">
                        @foreach (var student in context)
                        {
                            var studentProgress = GetProgress(student.UserId);
                            <li class="rounded-2xl border border-slate-200 bg-white p-3 sm:p-4" @key="student.UserId">
                                <div class="flex flex-wrap items-center gap-3">
                                    <NamensKreis Name="@student.FullName" />
                                    <div class="min-w-0 flex-1">
                                        <div class="flex flex-wrap items-center gap-2">
                                            <p class="mb-0 font-bold text-slate-900">@student.FullName</p>
                                            @if (student.IsBlocked)
                                            {
                                                <Badge Accent="rose">Bloqué / en attente</Badge>
                                            }
                                        </div>
                                        <p class="mb-0 mt-0.5 text-sm text-slate-500">
                                            Classe @student.CurrentLevelCode
                                            @if (!string.IsNullOrWhiteSpace(student.Email))
                                            {
                                                <span> · @student.Email</span>
                                            }
                                            @if (studentProgress?.LastActivityUtc is DateTime letzte)
                                            {
                                                <span> · Dernière activité le @letzte.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                            }
                                        </p>
                                        <div class="mt-2 flex flex-wrap gap-2 text-xs">
                                            <Badge Accent="@GetAboStatusAccent(student)">@GetAboStatusLabel(student)</Badge>
                                        </div>
                                    </div>
                                    <dl class="m-0 grid grid-cols-4 gap-2 text-center">
                                        <div class="min-w-[4.5rem] rounded-xl bg-slate-50 px-2 py-1.5">
                                            <dt class="text-[0.68rem] font-semibold text-slate-500">Leçons</dt>
                                            <dd class="m-0 text-base font-extrabold tabular-nums text-slate-900">@student.CompletedLessonsCount</dd>
                                        </div>
                                        <div class="min-w-[4.5rem] rounded-xl bg-slate-50 px-2 py-1.5">
                                            <dt class="text-[0.68rem] font-semibold text-slate-500">Exercices</dt>
                                            <dd class="m-0 text-base font-extrabold tabular-nums text-slate-900">@(studentProgress?.SolvedExerciseCount ?? 0)</dd>
                                        </div>
                                        <div class="min-w-[4.5rem] rounded-xl bg-slate-50 px-2 py-1.5">
                                            <dt class="text-[0.68rem] font-semibold text-slate-500">Examens</dt>
                                            <dd class="m-0 text-base font-extrabold tabular-nums text-slate-900">@(studentProgress is null ? "–" : $"{studentProgress.ExamsPassed}/{studentProgress.ExamsTaken}")</dd>
                                        </div>
                                        <div class="min-w-[4.5rem] rounded-xl bg-slate-50 px-2 py-1.5">
                                            <dt class="text-[0.68rem] font-semibold text-slate-500">Score</dt>
                                            <dd class="m-0 text-base font-extrabold tabular-nums" style="color:@(student.CombinedScorePercent.HasValue ? ScoreColorHelper.GetScoreColor(student.CombinedScorePercent.Value) : "#8a95a8")">@(student.CombinedScorePercent.HasValue ? $"{student.CombinedScorePercent} %" : "–")</dd>
                                        </div>
                                    </dl>
                                </div>
                            </li>
                        }
                    </ul>
                </DataListPanel>
            </div>
        </Abschnitt>
    }
</div>
