@page "/admin/courrier"
@attribute [Authorize(Roles = "SuperAdmin,ProduktOwner")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using HalloApp.Core.Services.Text

<PageTitle>Messagerie</PageTitle>
<section class="mx-auto mt-8 grid max-w-6xl gap-5 px-3 sm:px-6">
    <div class="rounded-3xl bg-slate-900 p-6 text-white">
        <a href="/" class="text-sm text-cyan-200">← Retour à l’accueil</a>
        <h1 class="mt-3 text-2xl font-black">Messagerie</h1>
        <p class="mt-2 text-sm text-slate-200">Messages reçus et envoyés depuis contact.skoulou@etsetech.com</p>
    </div>
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="rounded-2xl bg-cyan-50 p-4 text-sm text-cyan-900" role="status">@message</p>
    }
    @if (isAdmin)
    {
        <label class="block max-w-sm text-sm font-semibold text-slate-700">Filtrer par propriétaire
            <select class="hallo-input mt-1" @bind="ownerFilter" @bind:after="ReloadAsync">
                <option value="">Tous les messages</option>
                @foreach (var owner in owners)
                {
                    <option value="@owner.Id">@owner.Name</option>
                }
            </select>
        </label>
    }
    <div class="grid gap-5 lg:grid-cols-2">
        <div class="rounded-3xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
            <h2 class="text-lg font-bold">Écrire un message</h2>
            <p class="mt-1 text-sm text-slate-500">Choisis une école pour associer le message à son suivi.</p>
            <div class="mt-4 grid gap-3">
                <label class="text-sm font-semibold">École
                    <select class="hallo-input mt-1" @bind="schoolId">
                        <option value="">@(isAdmin ? "Sans école (administration)" : "Choisir une école")</option>
                        @foreach (var school in schools)
                        {
                            <option value="@school.Id">@school.Name</option>
                        }
                    </select>
                </label>
                <label class="text-sm font-semibold">Destinataire
                    <input type="email" class="hallo-input mt-1" @bind="recipient" maxlength="256" />
                </label>
                <label class="text-sm font-semibold">Objet
                    <input class="hallo-input mt-1" @bind="subject" maxlength="300" />
                </label>
                <label class="text-sm font-semibold">Message
                    <textarea class="hallo-input mt-1 min-h-36" @bind="body"></textarea>
                </label>
                <button type="button" class="rounded-full bg-cyan-700 px-5 py-3 text-sm font-bold text-white disabled:opacity-50" disabled="@sending" @onclick="SendAsync">@(sending ? "Envoi..." : "Envoyer")</button>
            </div>
        </div>
        <div class="min-w-0 rounded-3xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
            <h2 class="text-lg font-bold">Messages</h2>
            @if (mails.Count == 0)
            {
                <p class="mt-4 text-sm text-slate-500">Aucun message pour cette sélection.</p>
            }
            <div class="mt-4 max-h-[70vh] space-y-3 overflow-y-auto">
                @foreach (var mail in mails)
                {
                    <article class="min-w-0 rounded-2xl border border-slate-200 p-4">
                        <div class="flex flex-wrap justify-between gap-2 text-xs font-semibold text-cyan-700">
                            <span>@(mail.IstEingehend ? "Reçu" : "Envoyé") · @mail.ErstelltAmUtc.ToLocalTime().ToString("g")</span>
                            <span>@(mail.SchulID.HasValue ? schools.FirstOrDefault(s => s.Id == mail.SchulID.Value).Name ?? "École" : "Administration")</span>
                        </div>
                        <h3 class="mt-2 break-words font-bold text-slate-900">@mail.Betreff</h3>
                        <p class="mt-1 break-all text-xs text-slate-500">De : @mail.Absender · À : @mail.Empfaenger</p>
                        <p class="mt-3 whitespace-pre-wrap break-words text-sm text-slate-700">@HtmlSanitizer.ToPlainText(mail.Inhalt)</p>
                        @if (isAdmin && mail.IstEingehend)
                        {
                            <div class="mt-3 flex flex-wrap items-center gap-2">
                                <select class="hallo-input max-w-52 text-xs" value="@(mail.SchulID?.ToString() ?? string.Empty)" @onchange="e => AssignAsync(mail.Id, e.Value?.ToString())">
                                    <option value="">Administration uniquement</option>
                                    @foreach (var school in schools)
                                    {
                                        <option value="@school.Id">@school.Name</option>
                                    }
                                </select>
                            </div>
                        }
                        @if (mail.IstEingehend)
                        {
                            <button type="button" class="mt-3 rounded-full bg-cyan-50 px-3 py-1.5 text-xs font-bold text-cyan-800" @onclick="() => Reply(mail)">Répondre</button>
                        }
                    </article>
                }
            </div>
        </div>
    </div>
</section>
