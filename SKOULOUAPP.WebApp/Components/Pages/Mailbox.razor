@page "/admin/courrier"
@attribute [Authorize(Roles = "SuperAdmin,ProduktOwner")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using SkoulouApp.Core.Services.Text

<PageTitle>Messagerie</PageTitle>
<section class="mx-auto mt-4 grid w-full max-w-7xl min-w-0 gap-5 px-2 sm:px-4">
    <div class="rounded-3xl bg-slate-900 p-6 text-white">
        <a href="/" class="text-sm text-cyan-200">← Retour à l’accueil</a>
        <h1 class="mt-3 text-2xl font-black">Messagerie</h1>
        <p class="mt-2 text-sm text-slate-200">Courrier reçu et envoyé depuis contact.skoulou@etsetech.com</p>
    </div>
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="rounded-2xl bg-cyan-50 p-4 text-sm text-cyan-900" role="status">@message</p>
    }
    @if (isAdmin)
    {
        <ModernDropdown TValue="Guid?" Label="Filtrer par propriétaire" Value="ownerFilter" ValueChanged="SetOwnerFilterAsync" Options="OwnerOptions" ContainerClass="max-w-sm" Searchable="true" SearchPlaceholder="Rechercher un propriétaire..." />
    }
    <div class="min-w-0 rounded-3xl bg-white p-4 shadow-sm ring-1 ring-slate-200 sm:p-6">
        <div class="flex flex-wrap items-center justify-between gap-4">
            <div><h2 class="text-xl font-black text-slate-900">@(showSent ? "Messages envoyés" : "Boîte de réception")</h2><p class="text-sm text-slate-500">@(showSent ? "Consultez vos envois." : "Consultez les messages reçus et répondez-y.")</p></div>
            <button type="button" class="skoulou-btn-accent rounded-full px-5 py-2.5 text-sm font-semibold" @onclick="() => { broadcastMode = isAdmin; composeOpen = true; }">+ Nouvel e-mail</button>
        </div>
        <div class="mt-5 flex flex-wrap items-center gap-3">
            <div class="school-page-tabs" aria-label="Dossiers de messagerie">
                <button type="button" class="rounded-full px-4 py-2 text-sm font-semibold @(showSent ? "bg-slate-100 text-slate-700" : "skoulou-btn-accent")" @onclick="() => showSent = false">Réception</button>
                <button type="button" class="rounded-full px-4 py-2 text-sm font-semibold @(showSent ? "skoulou-btn-accent" : "bg-slate-100 text-slate-700")" @onclick="() => showSent = true">Envoyés</button>
            </div>
            <input type="search" class="skoulou-input min-w-0 flex-1 sm:max-w-sm" placeholder="Rechercher un objet, une adresse ou un message..." aria-label="Rechercher des e-mails" @bind="search" @bind:event="oninput" />
            <span class="text-xs font-semibold text-slate-500">@VisibleMails.Count message(s)</span>
        </div>
        @if (VisibleMails.Count == 0)
            {
                <p class="mt-4 rounded-2xl bg-slate-50 p-5 text-sm text-slate-500">Aucun message pour cette sélection.</p>
            }
            <div class="mt-4 space-y-3">
                @foreach (var mail in VisibleMails)
                {
                    <article class="min-w-0 rounded-2xl border border-slate-200 p-4">
                        <div class="flex flex-wrap justify-between gap-2 text-xs font-semibold text-cyan-700">
                            <span>@(mail.IstEingehend ? "Reçu" : "Envoyé") · @mail.ErstelltAmUtc.ToLocalTime().ToString("g")</span>
                            <span>@(mail.SchulID.HasValue ? schools.FirstOrDefault(s => s.Id == mail.SchulID.Value).Name ?? "École" : "Administration")</span>
                        </div>
                        <h3 class="mt-2 break-words font-bold text-slate-900">@mail.Betreff</h3>
                        <p class="mt-1 break-all text-xs text-slate-500">De : @mail.Absender · À : @mail.Empfaenger</p>
                        <p class="mt-3 whitespace-pre-wrap break-words text-sm text-slate-700">@HtmlSanitizer.ToPlainText(mail.Inhalt)</p>
                        @if (isAdmin && mail.IstEingehend)
                        {
                            <div class="mt-3 max-w-xs">
                                <ModernDropdown TValue="Guid?" Label="Attribuer à une école" Value="mail.SchulID" ValueChanged="id => SetAssignmentAsync(mail.Id, id)" Options="AssignmentOptions" Searchable="true" SearchPlaceholder="Rechercher une école..." />
                            </div>
                        }
                        @if (mail.IstEingehend)
                        {
                            <button type="button" class="mt-3 rounded-full bg-cyan-50 px-3 py-1.5 text-xs font-bold text-cyan-800" @onclick="() => Reply(mail)">Répondre</button>
                        }
                    </article>
                }
            </div>
    </div>
</section>

<ModalDialog @bind-Open="composeOpen" Title="Nouvel e-mail" Eyebrow="Communication" MaxWidthClass="max-w-4xl">
    @if (isAdmin)
    {
        <div class="mb-5 flex flex-wrap gap-2" aria-label="Mode d'envoi">
            <button type="button" class="rounded-full px-4 py-2 text-sm font-semibold @(broadcastMode ? "bg-slate-100 text-slate-700" : "skoulou-btn-accent")" @onclick="() => broadcastMode = false">Message individuel</button>
            <button type="button" class="rounded-full px-4 py-2 text-sm font-semibold @(broadcastMode ? "skoulou-btn-accent" : "bg-slate-100 text-slate-700")" @onclick="() => broadcastMode = true">Envoi ciblé ou groupé</button>
        </div>
    }
    @if (composeOpen && isAdmin && broadcastMode)
    {
        <AdminBroadcast ShowAnnouncements="false" EmailSent="OnBroadcastSentAsync" />
    }
    else
    {
        <div class="grid gap-4">
            <p class="text-sm text-slate-500">@(isAdmin ? "L'école est facultative ; sélectionnez-en une pour associer le message à son suivi." : "Choisissez votre école pour envoyer le message à un destinataire de cette école.")</p>
            <ModernDropdown TValue="Guid?" Label="@(isAdmin ? "École (facultatif)" : "École *")" Value="schoolId" ValueChanged="SetSchoolAsync" Options="SchoolOptions" Searchable="true" SearchPlaceholder="Rechercher une école..." />
            @if (schoolId.HasValue)
            {
                <div class="grid gap-3 sm:grid-cols-2">
                    <ModernDropdown TValue="string" Label="Filtrer les destinataires" Value="recipientRole" ValueChanged="SetRecipientRoleAsync" Options="RecipientRoleOptions" />
                    <ModernDropdown TValue="Guid?" Label="Rechercher un destinataire" Value="selectedRecipientId" ValueChanged="SetRecipientAsync" Options="RecipientOptions" Searchable="true" SearchPlaceholder="Rechercher un nom ou une adresse e-mail..." EmptyText="Aucun destinataire dans cette catégorie." />
                </div>
                <p class="text-xs text-slate-500">Sélectionnez une personne ou saisissez une adresse e-mail ci-dessous.</p>
            }
            <label class="text-sm font-semibold">Adresses e-mail destinataire
                <input type="email" class="skoulou-input mt-1" @bind="recipient" @bind:after="() => selectedRecipientId = null" maxlength="256" />
            </label>
            <label class="text-sm font-semibold">Objet
                <input class="skoulou-input mt-1" @bind="subject" maxlength="300" />
            </label>
            <div><label class="skoulou-label">Message</label><RichTextEditor @bind-Value="body" EnableImages="false" EnableLargeEditor="true" /></div>
            <div class="flex justify-end gap-2">
                <button type="button" class="rounded-full bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-700" @onclick="() => composeOpen = false">Annuler</button>
                <button type="button" class="skoulou-btn-accent rounded-full px-5 py-2.5 text-sm font-semibold disabled:opacity-50" disabled="@(sending || (!isAdmin && !schoolId.HasValue))" @onclick="SendAsync">@(sending ? "Envoi..." : "Envoyer")</button>
            </div>
        </div>
    }
</ModalDialog>
