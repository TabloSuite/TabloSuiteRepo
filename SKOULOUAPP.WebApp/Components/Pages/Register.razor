@page "/auth/register"
@attribute [AllowAnonymous]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@using SkoulouApp.WebApp.Models.Auth
@using SkoulouApp.Core.DataModels.Identity
@using SkoulouApp.Core.DataModels.Schools

<PageTitle>Inscription</PageTitle>

<section class="relative mx-auto flex max-h-[calc(100dvh-6rem)] w-full max-w-3xl min-w-0 flex-col overflow-hidden rounded-[2rem] bg-white shadow-xl shadow-emerald-100/80 ring-1 ring-slate-100">
    <div class="pointer-events-none absolute -right-20 -top-20 h-56 w-56 rounded-full bg-emerald-100/70 blur-3xl"></div>
    <header class="relative z-10 shrink-0 border-b border-slate-100 bg-white/95 px-6 py-5 backdrop-blur sm:px-8">
        <div class="flex items-center gap-4">
            <div class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-emerald-600 to-teal-700 text-xl font-black text-white shadow-lg shadow-emerald-200">H</div>
            <div class="min-w-0">
                <p class="text-sm font-semibold uppercase tracking-[0.18em] text-emerald-700">Inscription</p>
                <h1 class="mt-1 text-2xl font-black text-slate-900 sm:text-3xl">Créer un compte</h1>
                <p class="mt-1 text-xs leading-5 text-slate-500 sm:text-sm">Après l'inscription, le compte doit être validé par la direction compétente.</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="mt-4 rounded-2xl bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800" role="status" aria-live="polite">@message</div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="mt-4 rounded-2xl bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-800" role="alert">@errorMessage</div>
        }
    </header>

    <div class="relative min-h-0 flex-1 overflow-y-auto overscroll-contain px-6 pb-8 sm:px-8">
    <EditForm Model="Model" OnValidSubmit="OpenTermsAsync" FormName="register-form" class="grid min-w-0 gap-5 pt-6 xl:grid-cols-2">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <ModernDropdown TValue="RegistrierungsArt" ContainerClass="md:col-span-2" Label="Je m'inscris en tant que" Value="Model.Art" ValueChanged="SetRegistrierungsArtAsync" Options="RegistrierungsArtOptions" />

        <div>
            <label class="mb-2 block text-sm font-semibold text-slate-700">Prénom</label>
            <InputText @bind-Value="Model.Vorname" class="w-full rounded-2xl border border-slate-200 px-4 py-3 outline-none" />
        </div>

        <div>
            <label class="mb-2 block text-sm font-semibold text-slate-700">Nom de famille</label>
            <InputText @bind-Value="Model.Nachname" class="w-full rounded-2xl border border-slate-200 px-4 py-3 outline-none" />
        </div>

        <div>
            <label class="mb-2 block text-sm font-semibold text-slate-700">Identifiant de connexion</label>
            <div class="flex gap-2">
                <InputText @bind-Value="Model.Identifiant" autocomplete="username" autocapitalize="none" spellcheck="false" placeholder="ex. ama.mensah" class="w-full min-w-0 flex-1 rounded-2xl border border-slate-200 px-4 py-3 outline-none" />
                <button type="button" class="shrink-0 rounded-2xl bg-slate-100 px-4 text-sm font-semibold text-slate-700 hover:bg-slate-200 disabled:opacity-50" disabled="@(string.IsNullOrWhiteSpace(Model.Vorname) || string.IsNullOrWhiteSpace(Model.Nachname))" @onclick="IdentifiantVorschlagenAsync">Proposer</button>
            </div>
            <p class="mt-1 text-xs text-slate-500">Vous vous connecterez avec cet identifiant (lettres minuscules, chiffres, point ou tiret).</p>
        </div>

        <div>
            <label class="mb-2 block text-sm font-semibold text-slate-700">Adresse e-mail @(Model.Art == RegistrierungsArt.SchulLeiter ? "" : "(facultative)")</label>
            <InputText @bind-Value="Model.Email" type="email" class="w-full rounded-2xl border border-slate-200 px-4 py-3 outline-none" />
            <p class="mt-1 text-xs text-slate-500">@(Model.Art == RegistrierungsArt.SchulLeiter ? "Obligatoire pour la direction : validation, factures et mot de passe oublié." : "Pour les messages et « Mot de passe oublié ».")</p>
        </div>

        <div>
            <label class="mb-2 block text-sm font-semibold text-slate-700">Téléphone <span class="font-normal text-slate-400">(optionnel)</span></label>
            <InputText @bind-Value="Model.TelefonNummer" type="tel" class="w-full rounded-2xl border border-slate-200 px-4 py-3 outline-none" />
        </div>

        <div>
            <label class="mb-2 block text-sm font-semibold text-slate-700">Date de naissance <span class="font-normal text-slate-400">(optionnel)</span></label>
            <input @ref="dateInput" type="text" placeholder="jj.mm.aaaa" readonly
                   class="w-full cursor-pointer rounded-2xl border border-slate-200 bg-white px-4 py-3 outline-none focus:border-emerald-400 focus:ring-2 focus:ring-emerald-100" />
        </div>

        <ModernDropdown TValue="Geschlecht" Label="Genre" Value="Model.Geschlecht" ValueChanged="SetGeschlechtAsync" Options="GeschlechtOptions" />

        @if (Model.Art == RegistrierungsArt.Schueler)
        {
            <div class="md:col-span-2 rounded-2xl border border-sky-100 bg-sky-50 px-4 py-3 text-sm leading-6 text-sky-900">
                Tu t'inscris comme élève : choisis l'école existante qui validera ton compte.
            </div>

            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">Téléphone d'un parent <span class="font-normal text-slate-400">(optionnel)</span></label>
                <InputText @bind-Value="Model.ElternTelefonNummer" type="tel" class="w-full rounded-2xl border border-slate-200 px-4 py-3 outline-none" />
            </div>
            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">E-mail d'un parent <span class="font-normal text-slate-400">(optionnel)</span></label>
                <InputText @bind-Value="Model.ElternEmail" type="email" class="w-full rounded-2xl border border-slate-200 px-4 py-3 outline-none" />
            </div>
            <ModernDropdown TValue="Guid?"
                            ContainerClass="md:col-span-2"
                            Label="École"
                            Value="Model.SelectedSchoolId"
                            ValueChanged="SetSchoolAsync"
                            Options="SchoolOptions" />
        }
        else
        {
            <div class="md:col-span-2 rounded-2xl border border-emerald-100 bg-emerald-50 px-4 py-3 text-sm leading-6 text-emerald-900">
                Tu t'inscris comme directeur : indique ici les informations de ta propre école. Elle sera créée avec ton compte et attendra la validation de SKOULOUAPP.
            </div>

            <div class="md:col-span-2">
                <label class="mb-2 block text-sm font-semibold text-slate-700">Nom de l'école</label>
                <InputText @bind-Value="Model.SchulName" class="w-full rounded-2xl border border-slate-200 px-4 py-3 outline-none" />
            </div>

            <div class="md:col-span-2 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm leading-6 text-slate-700">
                SKOULOUAPP fonctionne maintenant comme une <strong>plateforme de gestion scolaire</strong> unique&nbsp;: tu crées ton école, puis tu organises librement tes classes, tes enseignants, tes leçons, tes supports et tes examens.
            </div>

            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">Ville de l'école</label>
                <InputText @bind-Value="Model.SchulStadt" class="w-full rounded-2xl border border-slate-200 px-4 py-3 outline-none" />
            </div>

            <ModernDropdown TValue="string"
                            Label="Pays de l'école"
                            Value="Model.SchulLand"
                            ValueChanged="SetSchoolCountryAsync"
                            Options="SchoolCountryOptions"
                            Searchable="true"
                            SearchPlaceholder="Rechercher un pays..." />
        }

        <div>
            <label class="mb-2 block text-sm font-semibold text-slate-700">Mot de passe</label>
            <PasswordInput @bind-Value="Model.Password" Autocomplete="new-password" />
            <p class="mt-1 text-xs text-slate-500">Le mot de passe doit contenir au moins 6 caractères, dont au moins 1 chiffre et 1 lettre minuscule.</p>
        </div>

        <div>
            <label class="mb-2 block text-sm font-semibold text-slate-700">Confirmer le mot de passe</label>
            <PasswordInput @bind-Value="Model.ConfirmPassword" Autocomplete="new-password" />
        </div>

        <div class="md:col-span-2">
            <AsyncActionButton Type="submit" Class="rounded-full bg-gradient-to-r from-emerald-600 to-teal-700 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-emerald-200 transition hover:-translate-y-0.5 disabled:opacity-50" IsBusy="@isSubmitting" BusyLabel="Inscription...">S'inscrire</AsyncActionButton>
        </div>
    </EditForm>
    </div>
</section>

<ModalDialog @bind-Open="showTermsModal" Title="Conditions d'utilisation" Eyebrow="Avant de finaliser l'inscription" MaxWidthClass="max-w-4xl" CloseOnBackdrop="false">
    <div class="space-y-6">
        <div class="rounded-2xl bg-sky-50 p-4 text-sm leading-6 text-sky-950">
            <p class="font-bold">Bienvenue sur SKOULOUAPP Campus</p>
            <p class="mt-1">Lis les conditions correspondant à ton rôle. Ton inscription ne sera créée qu'après ton accord explicite.</p>
        </div>

        <nav class="flex flex-wrap gap-2 text-sm font-semibold" aria-label="Sections des conditions">
            <button type="button" class="rounded-full px-3 py-2 @(Model.Art == RegistrierungsArt.Schueler ? "bg-emerald-600 text-white" : "bg-slate-100 text-slate-700")" @onclick='() => ScrollToTermsAsync("terms-student")'>Élève</button>
            <button type="button" class="rounded-full px-3 py-2 @(Model.Art == RegistrierungsArt.SchulLeiter ? "bg-emerald-600 text-white" : "bg-slate-100 text-slate-700")" @onclick='() => ScrollToTermsAsync("terms-school")'>Direction & coordination</button>
            <button type="button" class="rounded-full bg-slate-100 px-3 py-2 text-slate-700" @onclick='() => ScrollToTermsAsync("terms-teacher")'>Enseignant</button>
            <button type="button" class="rounded-full bg-slate-100 px-3 py-2 text-slate-700" @onclick='() => ScrollToTermsAsync("terms-owner")'>Responsable produit</button>
        </nav>

        <div class="max-h-[46vh] space-y-5 overflow-y-auto pr-2 text-sm leading-6 text-slate-700">
            <section id="terms-student" class="scroll-mt-4 rounded-2xl border border-emerald-100 bg-emerald-50/60 p-5">
                <h3 class="text-xl font-black text-emerald-900">Élèves</h3>
                <p class="mt-2">SKOULOUAPP ne conclut pas de contrat directement avec toi. L'accès à la plateforme est organisé par ton école, avec laquelle toi ou ton représentant légal êtes liés.</p>
                <p class="mt-2">Pour toute question concernant ton compte, tes cours, tes paiements ou tes droits d'accès, adresse-toi d'abord à ton école, tant qu'elle administre l'application.</p>
                <p class="mt-2">Les leçons et exercices publiés dans SKOULOUAPP accompagnent le travail de ta classe et ne remplacent ni le programme scolaire ni l'enseignement de ton école.</p>
            </section>

            <section id="terms-school" class="scroll-mt-4 rounded-2xl border border-indigo-100 bg-indigo-50/60 p-5">
                <h3 class="text-xl font-black text-indigo-900">Directions d'école & coordinateurs</h3>
                <p class="mt-2">Vous administrez les écoles qui vous sont attribuées et êtes responsables de la gestion des élèves, enseignants, contenus pédagogiques et autorisations qui relèvent de ces écoles.</p>
                <p class="mt-2">L'accès de votre école peut être suspendu ou limité lorsqu'une facture arrivée à échéance n'est pas réglée. Les abonnements et règlements restent dus selon les périodes facturées.</p>
                <p class="mt-2">Contactez SKOULOUAPP pour une difficulté technique d'utilisation ou pour transmettre une suggestion d'amélioration. Les demandes individuelles des élèves sont d'abord traitées par l'école.</p>
            </section>

            <section id="terms-teacher" class="scroll-mt-4 rounded-2xl border border-amber-100 bg-amber-50/60 p-5">
                <h3 class="text-xl font-black text-amber-900">Enseignants</h3>
                <p class="mt-2">Votre accès est accordé par votre école. Utilisez uniquement les élèves, classes et écoles qui vous sont attribués et protégez les informations qui vous sont confiées.</p>
                <p class="mt-2">Vous êtes responsable des leçons, exercices, examens et autres contenus que vous créez ou partagez, ainsi que du respect des droits d'auteur, de la protection des données et des règles de votre établissement.</p>
                <p class="mt-2">Les commissions éventuelles sont calculées par école. Les enseignants voient le fonds enseignants global de leur école; la répartition individuelle est organisée par l'école en dehors de SKOULOUAPP.</p>
            </section>

            <section id="terms-owner" class="scroll-mt-4 rounded-2xl border border-fuchsia-100 bg-fuchsia-50/60 p-5">
                <h3 class="text-xl font-black text-fuchsia-900">Responsables produit</h3>
                <p class="mt-2">En tant que partenaire SKOULOUAPP, vous accompagnez uniquement les écoles qui vous sont attribuées. Votre rôle porte sur le suivi financier et commercial convenu; il ne vous autorise pas à accéder aux contenus pédagogiques ou aux données des élèves au-delà de vos droits.</p>
                <p class="mt-2">Les commissions sont calculées à partir des factures réglées et des périodes validées. Une commission affichée est un relevé transparent de la part du responsable produit des écoles attribuées; aucune confirmation de réception n'est requise dans SKOULOUAPP.</p>
            </section>

            <section class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
                <h3 class="text-xl font-black text-slate-900">Règles communes</h3>
                <p class="mt-2">Un compte ne peut être utilisé que sur un appareil à la fois. Une nouvelle connexion met fin à la session active précédente.</p>
                <p class="mt-2">SKOULOUAPP utilise des ressources de prestataires tiers, notamment pour l'hébergement. En cas d'indisponibilité indépendante de SKOULOUAPP, par exemple une panne de service Microsoft, le remboursement des contributions d'abonnement n'est pas dû pour cette indisponibilité.</p>
                <p class="mt-2">En poursuivant, vous confirmez avoir lu et accepté ces conditions d'utilisation.</p>
            </section>
        </div>

        <div class="flex flex-col-reverse gap-3 border-t border-slate-100 pt-5 sm:flex-row sm:justify-end">
            <button type="button" class="rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 disabled:cursor-not-allowed disabled:opacity-60" disabled="@isSubmitting" @onclick="CancelTerms">Annuler l'inscription</button>
            <AsyncActionButton Type="button" Class="rounded-full bg-gradient-to-r from-emerald-600 to-teal-700 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-emerald-200 disabled:opacity-50" IsBusy="@isSubmitting" BusyLabel="Inscription..." OnClick="ConfirmTermsAsync">J'accepte et je poursuis</AsyncActionButton>
        </div>
    </div>
</ModalDialog>
