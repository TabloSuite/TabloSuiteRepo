@page "/parents"
@attribute [Authorize(Roles = "Eltern")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits SkoulouApp.WebApp.Components.CancelableComponentBase
@using SkoulouApp.Core.DataModels.Unterricht

<PageTitle>Espace parents · SKOULOU</PageTitle>

<div class="mx-auto grid max-w-5xl gap-5">
    <SeitenKopf Rubrik="Espace parents" Titel="Le suivi de vos enfants" IconName="users"
                Untertitel="Bulletins publiés, absences et frais de scolarité, mis à jour par l'établissement." />

    @if (laedt)
    {
        <div class="h-48 animate-pulse rounded-2xl bg-slate-200"></div>
    }
    else if (kinder.Count == 0)
    {
        <div class="rounded-2xl border border-amber-200 bg-amber-50 p-5 text-sm text-amber-900">
            Aucun enfant n'est encore lié à votre compte. Contactez la direction de l'établissement pour qu'elle relie votre compte à votre enfant.
        </div>
    }
    else
    {
        @if (kinder.Count > 1)
        {
            <div class="flex flex-wrap gap-2" role="tablist" aria-label="Enfants">
                @foreach (var k in kinder)
                {
                    <button type="button" role="tab" aria-selected="@(k.SchuelerID == aktivID)" @onclick="() => aktivID = k.SchuelerID"
                            class="inline-flex min-h-[2.75rem] items-center gap-2 rounded-xl border px-4 text-sm font-semibold @(k.SchuelerID == aktivID ? "border-blue-600 bg-blue-50 text-blue-800" : "border-slate-200 bg-white text-slate-700")">
                        <Icon Name="graduation" Groesse="16" />@k.Name
                    </button>
                }
            </div>
        }

        @if (Aktiv is { } kind)
        {
            <section class="flex flex-wrap items-center gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <span class="grid h-12 w-12 place-items-center rounded-xl text-white" style="background: var(--sk-gradient);"><Icon Name="graduation" /></span>
                <div class="min-w-0 flex-1">
                    <p class="mb-0 text-lg font-bold text-slate-900">@kind.Name</p>
                    <p class="mb-0 text-sm text-slate-500">Classe @kind.Klasse · @kind.Schule@(kind.Beziehung is null ? "" : $" · {kind.Beziehung}")</p>
                </div>
            </section>

            <div class="grid gap-4 lg:grid-cols-2">
                <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                    <h2 class="mb-0 flex items-center gap-2 text-base font-bold text-slate-900"><Icon Name="report" Groesse="18" />Bulletins</h2>
                    @if (kind.Bulletins.Count == 0)
                    {
                        <p class="mb-0 mt-3 text-sm text-slate-500">Aucun bulletin publié pour le moment.</p>
                    }
                    else
                    {
                        <ul class="mb-0 mt-3 grid list-none gap-2 p-0">
                            @foreach (var b in kind.Bulletins)
                            {
                                <li class="flex items-center justify-between gap-3 rounded-xl border border-slate-200 px-3 py-2 text-sm">
                                    <span><span class="font-semibold text-slate-800">@b.Titel</span>@if (b.Ersetzt) { <span class="ml-2 rounded-full bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-700">remplacé</span> }</span>
                                    <a href="/bulletins/@b.AusgabeID/pdf" target="_blank" rel="noopener" class="inline-flex items-center gap-1 font-semibold text-blue-700 no-underline hover:underline"><Icon Name="download" Groesse="16" />PDF</a>
                                </li>
                            }
                        </ul>
                    }
                </section>

                <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                    <h2 class="mb-0 flex items-center gap-2 text-base font-bold text-slate-900"><Icon Name="calendar" Groesse="18" />Assiduité (année en cours)</h2>
                    <div class="mt-3 grid grid-cols-3 gap-3 text-center">
                        <div class="rounded-xl bg-slate-50 p-3"><p class="mb-0 text-2xl font-extrabold tabular-nums @(kind.Abwesenheiten > 0 ? "text-amber-700" : "text-slate-900")">@kind.Abwesenheiten</p><p class="mb-0 text-xs text-slate-500">absence(s)</p></div>
                        <div class="rounded-xl bg-slate-50 p-3"><p class="mb-0 text-2xl font-extrabold tabular-nums text-slate-900">@kind.Entschuldigt</p><p class="mb-0 text-xs text-slate-500">justifiée(s)</p></div>
                        <div class="rounded-xl bg-slate-50 p-3"><p class="mb-0 text-2xl font-extrabold tabular-nums text-slate-900">@kind.Verspaetungen</p><p class="mb-0 text-xs text-slate-500">retard(s)</p></div>
                    </div>
                    @if (kind.LetzteEintraege.Count > 0)
                    {
                        <ul class="mb-0 mt-3 grid list-none gap-1 p-0 text-sm">
                            @foreach (var e in kind.LetzteEintraege)
                            {
                                <li class="flex justify-between gap-3 border-b border-slate-100 py-1.5 last:border-0">
                                    <span class="text-slate-700">@e.Datum.ToString("dd'/'MM'/'yyyy")</span>
                                    <span class="@(e.Status == AnwesenheitsStatus.Abwesend && !e.Entschuldigt ? "font-semibold text-amber-700" : "text-slate-600")">@AnwesenheitText(e)</span>
                                </li>
                            }
                        </ul>
                    }
                </section>
            </div>

            <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <h2 class="mb-0 flex items-center gap-2 text-base font-bold text-slate-900"><Icon Name="wallet" Groesse="18" />Frais de scolarité</h2>
                @if (kind.Gebuehren.Count == 0)
                {
                    <p class="mb-0 mt-3 text-sm text-slate-500">Aucun frais de scolarité en cours pour la classe.</p>
                }
                @foreach (var g in kind.Gebuehren)
                {
                    var anteil = g.Schulgeld > 0 ? (int)Math.Min(100, Math.Round(g.Bezahlt * 100m / g.Schulgeld)) : 100;
                    <div class="mt-4 grid gap-3">
                        <div class="grid grid-cols-3 gap-3">
                            <div><p class="mb-0 text-xs font-semibold text-slate-500">Frais (@g.Klasse)</p><p class="mb-0 mt-1 text-lg font-extrabold tabular-nums text-slate-900">@Betrag(g.Schulgeld)</p></div>
                            <div><p class="mb-0 text-xs font-semibold text-slate-500">Déjà payé</p><p class="mb-0 mt-1 text-lg font-extrabold tabular-nums text-emerald-700">@Betrag(g.Bezahlt)</p></div>
                            <div><p class="mb-0 text-xs font-semibold text-slate-500">Reste à payer</p><p class="mb-0 mt-1 text-lg font-extrabold tabular-nums @(g.Rest > 0 ? "text-amber-700" : "text-slate-900")">@Betrag(g.Rest)</p></div>
                        </div>
                        <div class="h-2 overflow-hidden rounded-full bg-slate-200"><div class="h-full rounded-full bg-emerald-500" style="width: @(anteil)%"></div></div>
                        @if (g.Zahlungen.Count > 0)
                        {
                            <ul class="mb-0 grid list-none gap-1 p-0 text-sm">
                                @foreach (var z in g.Zahlungen)
                                {
                                    <li class="flex items-center justify-between gap-3 border-b border-slate-100 py-1.5 last:border-0">
                                        <span class="text-slate-700">@z.Datum.ToString("dd'/'MM'/'yyyy") · <strong class="tabular-nums">@Betrag(z.Betrag)</strong></span>
                                        <a href="/finanzen/recu/@z.ZahlungID" target="_blank" rel="noopener" class="inline-flex items-center gap-1 font-semibold text-blue-700 no-underline hover:underline"><Icon Name="receipt" Groesse="16" />Reçu</a>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                }
            </section>
        }
    }
</div>
