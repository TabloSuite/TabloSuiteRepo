                        @if (teacherImportPreview is not null)
                        {
                            <SchoolUserImportPreviewTable Preview="teacherImportPreview" />
                            <AsyncActionButton Class="sk-btn sk-btn-primary justify-self-start" IsBusy="@isDatabaseActionInProgress" BusyLabel="Import..." OnClick="@(_ => CommitTeacherImportAsync())" Disabled="@(!teacherImportPreview.Succeeded || teacherImportPreview.ValidRowCount == 0)">
                                Importer les enseignants (@teacherImportPreview.ValidRowCount)
                            </AsyncActionButton>
