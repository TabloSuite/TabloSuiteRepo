@page "/schulleiter"
@attribute [Authorize(Policy = "RequireSchulLeiter")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits SkoulouApp.WebApp.Components.CancelableComponentBase
@using SkoulouApp.Core.DataModels.Schools
@using SkoulouApp.Core.DataModels.Finanzen
@using SkoulouApp.Core.Models.Admin
@using SkoulouApp.Core.Models.Dashboard
@using SkoulouApp.Core.Models.Import
@using SkoulouApp.Core.Models.TeacherLessons
@using SkoulouApp.WebApp.Components.Shared
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>@(isKoordinator ? "Coordination" : "Direction") · SKOULOU</PageTitle>

<div class="mx-auto grid max-w-6xl gap-5">
    <SeitenKopf Rubrik="@DirectorRubrik" Titel="Élèves, classes et équipe" IconName="school" Untertitel="@DirectorUntertitel">
        @if (!HasMultipleSchools)
        {
            @foreach (var school in schools)
            {
                <button type="button" class="sk-btn sk-btn-hero" @onclick="() => OpenEditSchoolAsync(school.SchoolId)"><Icon Name="settings" Groesse="16" />Modifier l'établissement</button>
            }
        }
        else if (schoolFilterName is not null && SelectedSchoolForManagement is { } selectedSchool)
        {
            <button type="button" class="sk-btn sk-btn-hero" @onclick="() => OpenEditSchoolAsync(selectedSchool.SchoolId)"><Icon Name="settings" Groesse="16" />Modifier l'établissement</button>
        }
    </SeitenKopf>

    <Toast Message="@message" MessageChanged="v => message = v" Kind="Toast.ToastKind.Success" />
    <QuittungHinweis @bind-ZahlungID="letzteQuittungID" />
    <Toast Message="@errorMessage" MessageChanged="v => errorMessage = v" Kind="Toast.ToastKind.Error" />
    <Toast Message="@userStatusMessage" MessageChanged="v => userStatusMessage = v" Kind="Toast.ToastKind.Success" />
    <Toast Message="@userErrorMessage" MessageChanged="v => userErrorMessage = v" Kind="Toast.ToastKind.Error" />
    <Toast Message="@(klasseModalOpen ? null : klasseStatusMessage)" MessageChanged="v => klasseStatusMessage = v" Kind="Toast.ToastKind.Success" />
    <Toast Message="@(klasseModalOpen ? null : klasseErrorMessage)" MessageChanged="v => klasseErrorMessage = v" Kind="Toast.ToastKind.Error" />

    @if (HasMultipleSchools)
    {
        <div class="flex flex-wrap items-center gap-3 rounded-2xl border border-slate-200 bg-white p-3 shadow-sm">
            <div class="w-full sm:w-80">
                <ModernDropdown TValue="string" Value="schoolFilterName" ValueChanged="SelectSchoolFilterAsync" Options="SchoolFilterOptions" Placeholder="Choisir une école" />
            </div>
            <span class="text-sm text-slate-500"><strong class="text-slate-800">@schools.Count</strong> écoles · <strong class="text-slate-800">@ActiveStudentCount</strong> élèves · <strong class="text-slate-800">@ActivePendingCount</strong> en attente</span>
        </div>
    }

    <Reiter Eintraege="DirectorReiter" Aktiv="@activeDirectorTab" AktivChanged="SetDirectorTab" AriaLabel="Navigation direction" />

    @if (IsDirectorTabActive(DirectorTabStudents))
    {
        @if (ActivePendingCount > 0)
        {
            <p class="mb-0 flex items-start gap-2 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900" role="status">
                <Icon Name="bell" Groesse="18" /><span><strong>@ActivePendingCount inscription(s)</strong> attendent votre validation. Filtrez avec « À valider » ci-dessous, puis « Valider » ou « Supprimer l'inscription ».</span>
            </p>
        }

        <Abschnitt Titel="Élèves" Untertitel="Validez les inscriptions, gérez les accès, les classes et la scolarité de chaque élève." IconName="graduation">
            <Aktionen>
                <button type="button" class="sk-btn sk-btn-secondary" @onclick="() => SetDirectorTab(DirectorTabImport)"><Icon Name="upload" Groesse="16" />Importer</button>
                <button type="button" class="sk-btn sk-btn-primary" @onclick="OpenNewStudentModalAsync"><Icon Name="user-plus" Groesse="16" />Ajouter un élève</button>
            </Aktionen>
            <ChildContent>
                <div class="grid gap-4">
                    @if (schoolKlassen.Count > 1)
                    {
                        <div class="grid gap-3 sm:grid-cols-2">
                            <ModernDropdown TValue="Guid?" Label="Classe de référence" Value="studentKlassenStufeFilterId" ValueChanged="SetStudentKlassenStufeFilterAsync" Options="StudentKlassenStufeFilterOptions" />
                            <ModernDropdown TValue="Guid?" Label="Classe" Value="studentKlasseFilterId" ValueChanged="SetStudentKlasseFilterAsync" Options="StudentKlasseFilterOptionsModern" />
                        </div>
                    }

                    @if (ArchivableFilteredStudents.Count > 0)
                    {
                        <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5">
                            <label class="m-0 inline-flex items-center gap-2 text-sm font-semibold text-slate-700">
                                <input type="checkbox"
                                       class="h-4 w-4 rounded border-slate-300"
                                       checked="@AreAllFilteredStudentsSelectedForArchive"
                                       @onchange="args => ToggleSelectAllFilteredStudentsForArchiveAsync(args.Value as bool? == true)" />
                                Tout sélectionner pour l'archivage
                                <span class="font-normal text-slate-500">(@ArchivableFilteredStudents.Count élève(s) sans classe active)</span>
                            </label>
                            <div class="flex items-center gap-3">
                                <span class="text-xs font-semibold text-slate-500">@ArchiveSelectedCount sélectionné(s)</span>
                                <AsyncActionButton Class="sk-btn sk-btn-sm sk-btn-secondary"
                                                   IsBusy="@isDatabaseActionInProgress"
                                                   BusyLabel="Archivage..."
                                                   Disabled="@(!CanArchiveSelectedStudents)"
                                                   OnClick="ArchiveSelectedStudentsAsync">
                                    <Icon Name="package" Groesse="14" />Archiver la sélection
                                </AsyncActionButton>
                            </div>
                        </div>
                    }

                    @if (FilteredStudents.Count == 0)
                    {
                        <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 px-5 py-8 text-center text-sm text-slate-500">
                            Aucun élève pour le moment. Ajoutez un élève ou importez une liste depuis Excel.
                        </div>
                    }
                    else
                    {
                        <DataListPanel Items="FilteredStudents"
                                       PageSize="10"
                                       SearchPlaceholder="Rechercher un élève, une classe…"
                                       EmptyText="Aucun élève trouvé."
                                       ResultLabelSingular="élève"
                                       ResultLabelPlural="élèves"
                                       SortOptions="studentSortOptions"
                                       Chips="studentChips"
                                       Filter="@((StudentApprovalItem s, string term) => Contains(s.FullName, term) || Contains(s.Email, term) || Contains(s.SchoolName, term) || Contains(s.CurrentLevelCode, term) || Contains(s.CurrentKlasseName, term))">
                            <ul class="m-0 grid list-none gap-2 p-0">
                                @foreach (var student in context)
                                {
                                    var offen = expandedStudentId == student.UserId;
                                    <li class="rounded-2xl border p-3 sm:p-4 @(student.IsBlocked ? "border-amber-200 bg-amber-50/50" : "border-slate-200 bg-white")" @key="student.UserId">
                                        <div class="flex flex-wrap items-center gap-3">
                                            @if (IsStudentArchivable(student))
                                            {
                                                <input type="checkbox"
                                                       class="h-4 w-4 shrink-0 rounded border-slate-300"
                                                       aria-label="@($"Sélectionner {student.FullName} pour l'archivage")"
                                                       title="Sélectionner pour l'archivage"
                                                       checked="@IsStudentSelectedForArchive(student.UserId)"
                                                       @onchange="args => ToggleArchiveStudentAsync(student.UserId, args.Value as bool? == true)" />
                                            }
                                            <NamensKreis Name="@student.FullName" />
                                            <div class="min-w-0 flex-1">
                                                <div class="flex flex-wrap items-center gap-2">
                                                    <p class="mb-0 font-bold text-slate-900">@student.FullName</p>
                                                    @if (student.IsBlocked)
                                                    {
                                                        <Badge Accent="amber">@(student.IsSelfRegistered ? "Inscription à valider" : "Accès bloqué")</Badge>
                                                    }
                                                    else if (!student.CurrentKlasseId.HasValue)
                                                    {
                                                        <Badge Accent="rose">Classe à attribuer</Badge>
                                                    }
                                                </div>
                                                <p class="mb-0 mt-0.5 text-sm text-slate-500">
                                                    @if (student.CurrentKlasseId.HasValue)
                                                    {
                                                        <span>Classe @student.CurrentLevelCode@if (!string.IsNullOrWhiteSpace(student.CurrentKlasseName) && student.CurrentKlasseName != student.CurrentLevelCode) { <text> · @student.CurrentKlasseName</text> }</span>
                                                    }
                                                    else
                                                    {
                                                        <span>Sans classe active</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(student.Email))
                                                    {
                                                        <span> · @student.Email</span>
                                                    }
                                                    @if (HasMultipleSchools)
                                                    {
                                                        <span> · @student.SchoolName</span>
                                                    }
                                                </p>
                                                <div class="mt-2 flex flex-wrap gap-2 text-xs">
                                                    @if (student.HasSchoolFeeInfo)
                                                    {
                                                        <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 font-semibold @(student.IsSchoolFeeFullyPaid ? "bg-emerald-50 text-emerald-800" : student.SchoolFeePaidAmount > 0m ? "bg-blue-50 text-blue-800" : "bg-amber-50 text-amber-800")">
                                                            <Icon Name="wallet" Groesse="14" />@GetSchoolFeeHeaderLabel(student.SchoolFeePaidAmount, student.SchoolFeeAmount, student.HasActiveSchoolFeeCycle)
                                                        </span>
                                                    }
                                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2.5 py-1 font-semibold text-slate-600">
                                                        <Icon Name="chart" Groesse="14" />Exercices et examens :
                                                        @if (student.CombinedScorePercent.HasValue)
                                                        {
                                                            <span class="font-extrabold" style="color:@ScoreColorHelper.GetScoreColor(student.CombinedScorePercent.Value)">@student.CombinedScorePercent %</span>
                                                            <span class="font-normal text-slate-400">(@student.CombinedScoreCount)</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-slate-400">–</span>
                                                        }
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="flex flex-wrap items-center gap-2">
                                                @if (student.IsBlocked)
                                                {
                                                    <button type="button" class="sk-btn sk-btn-sm sk-btn-success" @onclick="() => SetBlockedAsync(student.UserId, false)"><Icon Name="check" Groesse="14" />Valider</button>
                                                    @if (student.IsSelfRegistered)
                                                    {
                                                        <button type="button" class="sk-btn sk-btn-sm sk-btn-danger" @onclick="() => DeletePendingStudentAsync(student.UserId)">Supprimer l'inscription</button>
                                                    }
                                                }
                                                <button type="button" class="sk-btn sk-btn-sm sk-btn-secondary" @onclick="() => OpenEditStudentPersonalAsync(student.UserId)"><Icon Name="edit" Groesse="14" />Modifier</button>
                                                <button type="button" class="sk-btn sk-btn-sm sk-btn-secondary" aria-expanded="@(offen ? "true" : "false")" @onclick="() => ToggleLevelPanelAsync(student.UserId)">
                                                    Classes et abonnement<Icon Name="chevron-down" Groesse="14" CssClass="@(offen ? "rotate-180 transition-transform" : "transition-transform")" />
                                                </button>
                                                @if (!student.IsBlocked)
                                                {
                                                    <button type="button" class="sk-btn sk-btn-sm sk-btn-ghost" title="Bloquer l'accès de l'élève" @onclick="() => SetBlockedAsync(student.UserId, true)"><Icon Name="lock" Groesse="14" />Bloquer</button>
                                                }
                                            </div>
                                        </div>

                                        @if (offen)
                                        {
                                            <div class="mt-3 grid gap-2 border-t border-slate-100 pt-3">
                                                @foreach (var level in levelEnrollments)
                                                {
                                                    <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl px-3 py-2.5 @(level.IsCurrentKlasse ? "bg-blue-50 ring-1 ring-inset ring-blue-100" : "bg-slate-50")">
                                                        <div class="flex flex-wrap items-center gap-2">
                                                            <span class="font-semibold text-slate-800">@level.CourseCode</span>
                                                            <span class="text-sm text-slate-500">@level.CourseTitle</span>
                                                            @if (level.IsCurrentKlasse)
                                                            {
                                                                <Badge Accent="blue">Classe actuelle</Badge>
                                                            }
                                                        </div>
                                                        <div class="flex flex-wrap items-center gap-2">
                                                            @if (level.AutomatischeZyklusabrechnung)
                                                            {
                                                                <Badge Accent="cyan">Facturation automatique par cycle</Badge>
                                                                <span class="text-xs text-slate-600">Aucun paiement individuel requis pour l'accès.</span>
                                                            }
                                                            else if (level.IsUnlocked)
                                                            {
                                                                <Badge Accent="cyan">Abonnement SKOULOU</Badge>
                                                                <Badge Accent="slate">@level.AboPreis.ToString("N0", Fr) FCFA</Badge>
                                                            }

                                                            @if (!level.AutomatischeZyklusabrechnung && level.IsPaid)
                                                            {
                                                                <Badge Accent="emerald">Paiement effectué</Badge>
                                                            }

                                                            @if (level.IsCurrentKlasse && level.HasActiveClassCycle)
                                                            {
                                                                <Badge Accent="emerald">Cycle en cours</Badge>
                                                            }
                                                            else if (level.IsClassCycleClosed)
                                                            {
                                                                <Badge Accent="slate">Cycle clôturé</Badge>
                                                            }
                                                            else if (level.IsCurrentKlasse && !level.HasActiveClassCycle)
                                                            {
                                                                <Badge Accent="amber">Cycle non démarré</Badge>
                                                            }

                                                            @if (level.CanAssignOrUpgradeAbo)
                                                            {
                                                                <button type="button" class="sk-btn sk-btn-sm sk-btn-primary" @onclick="() => OpenAboModal(student, level)">Gérer l'abonnement</button>
                                                            }

                                                            @if (!level.AutomatischeZyklusabrechnung && !level.IsCurrentKlasse && !level.IsUnlocked)
                                                            {
                                                                <span class="text-xs font-medium text-slate-400">Aucun abonnement</span>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </li>
                                }
                            </ul>
                        </DataListPanel>
                    }
                </div>
            </ChildContent>
        </Abschnitt>
    }

    @if (IsDirectorTabActive(DirectorTabClasses))
    {
        <Abschnitt Titel="Classes" Untertitel="Créez vos classes, démarrez et clôturez les cycles, suivez l'occupation." IconName="layers">
            <Aktionen>
                <button type="button" class="sk-btn sk-btn-primary" disabled="@(SelectedKlasseSchoolId is null)" @onclick="OpenNewKlasseModal"><Icon Name="plus" Groesse="16" />Nouvelle classe</button>
            </Aktionen>
            <ChildContent>
                @if (!klasseModalOpen && !string.IsNullOrEmpty(klasseWarnMessage))
                {
                    <p class="mb-4 flex items-start gap-2 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900"><Icon Name="alert" Groesse="18" /><span>@klasseWarnMessage</span></p>
                }

                @if (SelectedKlasseSchoolId is null)
                {
                    <p class="mb-0 rounded-xl bg-slate-50 px-4 py-5 text-sm text-slate-600">Sélectionnez une école pour gérer ses classes.</p>
                }
                else if (schoolKlassen.Count == 0)
                {
                    <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 px-5 py-8 text-center text-sm text-slate-500">
                        Aucune classe pour le moment. Créez la première avec « Nouvelle classe ».
                    </div>
                }
                else
                {
                    <div class="mb-4 grid gap-3 sm:grid-cols-2">
                        <ModernDropdown TValue="string" Label="Statut des cycles" Value="durchlaufStatusFilter" ValueChanged="SetDurchlaufStatusFilterAsync" Options="DurchlaufStatusOptions" />
                        <ModernDropdown TValue="Guid?" Label="Nom de référence" Value="klassenStufeFilterId" ValueChanged="SetKlassenStufeFilterAsync" Options="KlassenStufeFilterOptions" />
                    </div>
                    @if (GefilterteKlassen.Count == 0)
                    {
                        <p class="mb-0 rounded-xl bg-slate-50 px-4 py-5 text-sm text-slate-600">Aucune classe ne correspond aux filtres sélectionnés.</p>
                    }
                    else
                    {
                        <div class="grid gap-3 lg:grid-cols-2">
                            @foreach (var klasse in GefilterteKlassen)
                            {
                                SkoulouApp.Core.Services.DurchlaufUebersicht? durchlauf = null;
                                var hatDurchlauf = klasse.CourseId.HasValue && durchlaeufeNachKlasse.TryGetValue(klasse.CourseId.Value, out durchlauf);
                                var zyklusAktiv = hatDurchlauf && durchlauf!.IstAktiv;
                                <article class="flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-4" @key="klasse.CourseId">
                                    <div class="flex items-start justify-between gap-3">
                                        <div class="min-w-0">
                                            <p class="mb-0 text-base font-bold text-slate-900">@klasse.Title</p>
                                            <p class="mb-0 mt-0.5 text-sm text-slate-500">@KlassenMeta(klasse)</p>
                                        </div>
                                        <div class="flex shrink-0 items-center gap-1">
                                            @if (zyklusAktiv)
                                            {
                                                <Badge Accent="emerald">Cycle en cours</Badge>
                                            }
                                            else if (hatDurchlauf)
                                            {
                                                <Badge Accent="slate">Cycle clôturé</Badge>
                                            }
                                            else
                                            {
                                                <Badge Accent="amber">Aucun cycle</Badge>
                                            }
                                            <button type="button" class="sk-btn sk-btn-sm sk-btn-ghost px-2" aria-label="@($"Modifier la classe {klasse.Title}")" title="Modifier la classe" @onclick="() => OpenEditKlasseModal(klasse)"><Icon Name="edit" Groesse="16" /></button>
                                        </div>
                                    </div>

                                    <div>
                                        <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-semibold">
                                            <span class="text-slate-500">Occupation</span>
                                            @if (klasse.MaxPlaetze.HasValue)
                                            {
                                                <span class="tabular-nums @(IsKlasseOverbooked(klasse) ? "text-rose-700" : "text-slate-700")">@klasse.CurrentStudentCount / @klasse.MaxPlaetze.Value élève(s)</span>
                                            }
                                            else
                                            {
                                                <span class="text-slate-700">@klasse.CurrentStudentCount élève(s) · capacité libre</span>
                                            }
                                        </div>
                                        @if (klasse.MaxPlaetze.HasValue)
                                        {
                                            <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-slate-100">
                                                <div class="h-full rounded-full @GetOccupancyBarClass(klasse)" style="@($"width:{GetOccupancyPercent(klasse)}%")"></div>
                                            </div>
                                            @if (IsKlasseOverbooked(klasse))
                                            {
                                                <p class="mb-0 mt-1.5 text-xs font-semibold text-rose-700">Sur-occupation autorisée : +@(klasse.CurrentStudentCount - klasse.MaxPlaetze.Value) élève(s) au-dessus de la capacité.</p>
                                            }
                                            else if (GetRemainingPlaetze(klasse) is int reste)
                                            {
                                                <p class="mb-0 mt-1.5 text-xs text-slate-500">Places restantes : @reste</p>
                                            }
                                        }
                                    </div>

                                    @if (hatDurchlauf)
                                    {
                                        <p class="mb-0 flex items-center gap-1.5 text-xs text-slate-600">
                                            <Icon Name="calendar" Groesse="14" />
                                            @if (zyklusAktiv)
                                            {
                                                <span>Depuis le @durchlauf!.StartDatum.ToString("dd.MM.yyyy") · <strong class="tabular-nums text-slate-800">@durchlauf.NiveauPreis.ToString("N0", Fr) FCFA</strong></span>
                                            }
                                            else
                                            {
                                                <span>Dernier cycle : @durchlauf!.StartDatum.ToString("dd.MM.yyyy") – @durchlauf.EndDatum?.ToString("dd.MM.yyyy")</span>
                                            }
                                        </p>
                                    }

                                    <div class="mt-auto flex flex-wrap items-center gap-2 border-t border-slate-100 pt-3">
                                        <button type="button" class="sk-btn sk-btn-sm sk-btn-secondary" @onclick="() => OpenNewStudentForKlasseAsync(klasse)"><Icon Name="user-plus" Groesse="14" />Ajouter un élève</button>
                                        @if (darfCycleZahlungenVerwalten && zyklusAktiv)
                                        {
                                            <button type="button" class="sk-btn sk-btn-sm sk-btn-secondary" @onclick="() => OpenAbschlussNoten(durchlauf!.DurchlaufID)"><Icon Name="clipboard-check" Groesse="14" />Notes finales</button>
                                            <button type="button" class="sk-btn sk-btn-sm sk-btn-danger" @onclick="() => OpenDurchlaufEndeModal(durchlauf!)">Clôturer le cycle</button>
                                        }
                                        else if (darfCycleZahlungenVerwalten)
                                        {
                                            <button type="button" class="sk-btn sk-btn-sm sk-btn-success" @onclick="() => OpenDurchlaufStartModalAsync(klasse)"><Icon Name="calendar" Groesse="14" />Démarrer le cycle</button>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                }
            </ChildContent>
        </Abschnitt>

        @if (SelectedKlasseSchoolId is not null)
        {
            <Abschnitt Titel="Mentions de fin de cycle" Untertitel="Définissez les mentions de l'établissement une seule fois. Les mentions déjà attribuées aux élèves restent inchangées si la liste évolue." IconName="star">
                @if (!string.IsNullOrWhiteSpace(mentionError)) { <p class="mb-3 rounded-xl border border-rose-200 bg-rose-50 px-4 py-2.5 text-sm text-rose-800">@mentionError</p> }
                @if (!string.IsNullOrWhiteSpace(mentionMessage)) { <p class="mb-3 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-2.5 text-sm text-emerald-800">@mentionMessage</p> }
                <div class="flex flex-wrap gap-2">
                    <input class="skoulou-input min-w-0 flex-1" maxlength="80" aria-label="Texte de la mention" placeholder="Ex. Très bien" @bind="mentionText" />
                    <button type="button" class="sk-btn sk-btn-primary min-h-[2.75rem]" @onclick="SaveMentionAsync">@(mentionEditId.HasValue ? "Enregistrer" : "Ajouter")</button>
                    @if (mentionEditId.HasValue)
                    {
                        <button type="button" class="sk-btn sk-btn-ghost min-h-[2.75rem]" @onclick="() => { mentionEditId = null; mentionText = string.Empty; }">Annuler</button>
                    }
                </div>
                @if (schulMentions.Count == 0)
                {
                    <p class="mb-0 mt-3 text-sm text-slate-500">Aucune mention pour le moment. Exemples : Passable, Assez bien, Bien, Très bien.</p>
                }
                else
                {
                    <ul class="mb-0 mt-3 flex list-none flex-wrap gap-2 p-0">
                        @foreach (var mention in schulMentions)
                        {
                            <li class="inline-flex items-center gap-1 rounded-full border border-slate-200 bg-slate-50 py-1 pl-3 pr-1 text-sm text-slate-800" @key="mention.Id">
                                <span class="font-semibold">@mention.Text</span>
                                <button type="button" class="rounded-full px-2 py-0.5 text-xs font-semibold text-blue-700 hover:bg-blue-50" aria-label="Modifier @mention.Text" @onclick="() => EditMention(mention)">Modifier</button>
                                <button type="button" class="rounded-full px-2 py-0.5 text-xs font-semibold text-rose-700 hover:bg-rose-50" aria-label="Supprimer @mention.Text" @onclick="() => DeleteMentionAsync(mention.Id)" @onclick:stopPropagation="true">Supprimer</button>
                            </li>
                        }
                    </ul>
                }
            </Abschnitt>
        }
    }

    @if (IsDirectorTabActive(DirectorTabUsers))
    {
        <Abschnitt Titel="@SchoolUsersCardTitle" Untertitel="@SchoolUsersCardSubtitle" IconName="users">
            <Aktionen>
                <button type="button" class="sk-btn sk-btn-primary" @onclick="OpenNewUserModalAsync"><Icon Name="user-plus" Groesse="16" />Nouvel utilisateur</button>
            </Aktionen>
            <ChildContent>
                @if (FilteredSchoolUsersOhneSchueler.Count == 0)
                {
                    <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 px-5 py-8 text-center text-sm text-slate-500">@EmptySchoolUsersText</div>
                }
                else
                {
                    <DataListPanel Items="FilteredSchoolUsersOhneSchueler"
                                   PageSize="10"
                                   SearchPlaceholder="Rechercher un nom, un identifiant…"
                                   EmptyText="Aucun utilisateur trouvé."
                                   ResultLabelSingular="utilisateur"
                                   ResultLabelPlural="utilisateurs"
                                   Chips="schoolUserChips"
                                   Filter="@((SchoolUserItem u, string term) => Contains(u.FullName, term) || Contains(u.Identifiant, term) || Contains(u.Email, term) || Contains(GetRoleLabel(u.RoleName), term))">
                        <ul class="m-0 grid list-none gap-2 p-0">
                            @foreach (var user in context)
                            {
                                <li class="flex flex-wrap items-center gap-3 rounded-2xl border border-slate-200 bg-white p-3 sm:p-4" @key="user.UserId">
                                    <NamensKreis Name="@user.FullName" Farbe="bg-slate-100 text-slate-700" />
                                    <div class="min-w-0 flex-1">
                                        <div class="flex flex-wrap items-center gap-2">
                                            <p class="mb-0 font-bold text-slate-900">@user.FullName</p>
                                            <Badge Accent="blue">@GetRoleLabel(user.RoleName)</Badge>
                                            @if (user.IsBlocked)
                                            {
                                                <Badge Accent="rose">Compte bloqué</Badge>
                                            }
                                        </div>
                                        <p class="mb-0 mt-0.5 text-sm text-slate-500">
                                            Identifiant <span class="font-semibold text-slate-700">@user.Identifiant</span>
                                            @if (!string.IsNullOrWhiteSpace(user.Email))
                                            {
                                                <span> · @user.Email</span>
                                            }
                                            @if (isProduktOwner || HasMultipleSchools)
                                            {
                                                <span> · @(user.Schools.Count == 0 ? "Aucune affectation" : string.Join(", ", user.Schools))</span>
                                            }
                                        </p>
                                    </div>
                                    <div class="flex flex-wrap items-center gap-2">
                                        <button type="button" class="sk-btn sk-btn-sm sk-btn-secondary" @onclick="() => OpenEditUserAsync(user.UserId)"><Icon Name="edit" Groesse="14" />Modifier</button>
                                        @if (user.RoleName == "Lehrer")
                                        {
                                            <button type="button" class="sk-btn sk-btn-sm sk-btn-secondary" @onclick="() => OpenZuordnungAsync(user.UserId, user.FullName)"><Icon Name="layers" Groesse="14" />Classes</button>
                                        }
                                        @if (user.IsBlocked)
                                        {
                                            <button type="button" class="sk-btn sk-btn-sm sk-btn-success" @onclick="() => SetUserBlockedAsync(user.UserId, false)"><Icon Name="unlock" Groesse="14" />Activer</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="sk-btn sk-btn-sm sk-btn-ghost" @onclick="() => SetUserBlockedAsync(user.UserId, true)"><Icon Name="lock" Groesse="14" />Bloquer</button>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    </DataListPanel>
                }
            </ChildContent>
        </Abschnitt>
    }

    @if (IsDirectorTabActive(DirectorTabSubjects))
    {
        <Abschnitt Titel="Matières" Untertitel="Les matières de l'établissement : proposées dans le formulaire enseignant et regroupées pour les bilans du bulletin." IconName="book">
            @if (!string.IsNullOrWhiteSpace(fachVerwaltungErrorMessage))
            {
                <p class="mb-3 rounded-xl border border-rose-200 bg-rose-50 px-4 py-2.5 text-sm text-rose-800">@fachVerwaltungErrorMessage</p>
            }
            @if (!string.IsNullOrWhiteSpace(fachVerwaltungStatusMessage))
            {
                <p class="mb-3 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-2.5 text-sm text-emerald-800">@fachVerwaltungStatusMessage</p>
            }
            @if (HasMultipleSchools)
            {
                <p class="mb-3 rounded-xl bg-blue-50 px-4 py-2.5 text-sm font-semibold text-blue-900">
                    @(SelectedSchoolForManagement is null ? "Sélectionnez une école en haut de la page pour gérer les matières." : $"École active : {SelectedSchoolForManagement.SchoolName}")
                </p>
            }

            <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] sm:items-end">
                <div>
                    <label class="skoulou-label">Rechercher</label>
                    <input @bind="fachSuchbegriff" @bind:event="oninput" class="skoulou-input" placeholder="Rechercher une matière" />
                </div>
                <div>
                    <label class="skoulou-label">Nouvelle matière</label>
                    <input @bind="neueSchulFachBezeichnung" @bind:event="oninput" class="skoulou-input" placeholder="Ex. Mathématiques" disabled="@isDatabaseActionInProgress" />
                </div>
                <AsyncActionButton Class="sk-btn sk-btn-primary min-h-[2.75rem]"
                                   Disabled="@(!CanAddSchoolFach)"
                                   IsBusy="@isDatabaseActionInProgress"
                                   BusyLabel="Ajout..."
                                   OnClick="@(_ => AddSchoolFachAsync())">
                    <Icon Name="plus" Groesse="16" />Ajouter
                </AsyncActionButton>
            </div>

            @if (SelectedSchoolForManagement is null)
            {
                <p class="mb-0 mt-4 text-sm text-slate-500">La liste des matières s'affiche après sélection d'une école.</p>
            }
            else if (GefilterteSchoolFachOptions.Count == 0)
            {
                <div class="mt-4 rounded-2xl border border-dashed border-slate-200 bg-slate-50 px-5 py-8 text-center text-sm text-slate-500">
                    @(string.IsNullOrWhiteSpace(fachSuchbegriff) ? "Aucune matière pour le moment. Ajoutez la première ci-dessus." : "Aucune matière ne correspond à la recherche.")
                </div>
            }
            else
            {
                <p class="mb-0 mt-4 text-xs text-slate-500">Le groupe sert aux bilans du bulletin (Bilan lettres, Bilan sciences, Bilan autres).</p>
                <ul class="mb-0 mt-2 grid max-h-[28rem] list-none gap-2 overflow-y-auto p-0 sm:grid-cols-2">
                    @foreach (var fach in GefilterteSchoolFachOptions)
                    {
                        <li class="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2">
                            <span class="min-w-0 flex-1 text-sm font-semibold text-slate-800">@fach.Name</span>
                            <ModernDropdown TValue="string" ContainerClass="w-36" ButtonClass="py-1.5 text-xs" Value="@(fach.Gruppe ?? "")" ValueChanged="g => FachGruppeAsync(fach, g)" Options="FachGruppenOptionen" />
                            <button type="button"
                                    class="sk-btn sk-btn-sm sk-btn-ghost"
                                    disabled="@fach.IstLehrerZugewiesen"
                                    aria-label="@($"Supprimer {fach.Name}")"
                                    title="@(fach.IstLehrerZugewiesen ? "Attribuée à un enseignant" : $"Supprimer {fach.Name}")"
                                    @onclick="() => AskDeleteSchoolFach(fach)">
                                <Icon Name="trash" Groesse="15" />
                            </button>
                        </li>
                    }
                </ul>
            }
        </Abschnitt>
    }

    @if (IsDirectorTabActive(DirectorTabReassign))
    {
        <Abschnitt Titel="Réattribution" Untertitel="Placez les élèves sans classe active dans une classe : choisissez la classe à gauche, cochez les élèves à droite." IconName="refresh">
            @if (SelectedKlasseSchoolId is null)
            {
                <p class="mb-0 rounded-xl bg-slate-50 px-4 py-5 text-sm text-slate-600">Sélectionnez une école pour réattribuer les élèves.</p>
            }
            else
            {
                <div class="grid gap-4 lg:grid-cols-2">
                    <article class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                        <h3 class="mb-0 text-sm font-bold text-slate-900">1. Classe cible</h3>
                        <div class="mt-3">
                            <ModernDropdown TValue="Guid?" Label="Classe" Value="reassignTargetKlasseId" ValueChanged="SetReassignTargetKlasseAsync" Options="ReassignKlasseOptions" />
                        </div>
                        @if (ReassignTargetKlasse is not null)
                        {
                            <div class="mt-4 rounded-xl border border-slate-200 bg-white p-3">
                                <div class="flex items-center justify-between gap-3">
                                    <p class="mb-0 text-sm font-bold text-slate-800">Élèves déjà dans la classe</p>
                                    <Badge Accent="blue">@ReassignTargetKlasse.CurrentStudentCount</Badge>
                                </div>
                                @if (ReassignTargetStudents.Count > 0)
                                {
                                    <ul class="mb-0 mt-3 max-h-48 list-none overflow-auto rounded-xl border border-slate-100 p-0">
                                        @foreach (var student in ReassignTargetStudents)
                                        {
                                            <li class="flex items-center justify-between gap-3 border-b border-slate-100 px-3 py-2 last:border-b-0">
                                                <div class="min-w-0">
                                                    <p class="mb-0 truncate text-sm font-semibold text-slate-900">@student.FullName</p>
                                                    @if (!string.IsNullOrWhiteSpace(student.Email))
                                                    {
                                                        <p class="mb-0 truncate text-xs text-slate-500">@student.Email</p>
                                                    }
                                                </div>
                                                <button type="button" class="sk-btn sk-btn-sm sk-btn-danger" @onclick="() => OpenReassignRemoveConfirmation(student)">Retirer</button>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    </article>

                    <article class="rounded-2xl border border-slate-200 bg-white p-4">
                        <div class="flex items-center justify-between gap-3">
                            <h3 class="mb-0 text-sm font-bold text-slate-900">2. Élèves sans classe active</h3>
                            <Badge Accent="slate">@FilteredStudentsWithoutActiveClass.Count</Badge>
                        </div>
                        <div class="mt-3 grid gap-3 sm:grid-cols-2">
                            <ModernDropdown TValue="string"
                                            Label="Situation précédente"
                                            Value="reassignPreviousKlasseFilter"
                                            ValueChanged="SetReassignPreviousKlasseFilterAsync"
                                            Options="ReassignPreviousKlasseOptions"
                                            Searchable="true"
                                            SearchPlaceholder="Rechercher une ancienne classe..." />
                            <div>
                                <label class="skoulou-label">Recherche</label>
                                <input class="skoulou-input" placeholder="Nom, e-mail, ancienne classe…" value="@reassignSearch" @oninput="SetReassignSearchAsync" />
                            </div>
                        </div>
                        <div class="mt-3 max-h-72 overflow-auto rounded-xl border border-slate-200">
                            @if (FilteredStudentsWithoutActiveClass.Count == 0)
                            {
                                <p class="mb-0 p-4 text-sm text-slate-500">Aucun élève sans classe active.</p>
                            }
                            else
                            {
                                @foreach (var student in FilteredStudentsWithoutActiveClass)
                                {
                                    <label class="m-0 flex cursor-pointer items-start gap-3 border-b border-slate-100 px-3 py-2 text-sm last:border-b-0 hover:bg-slate-50">
                                        <input type="checkbox"
                                               checked="@IsStudentSelectedForReassign(student.UserId)"
                                               @onchange="args => ToggleReassignStudentAsync(student.UserId, args.Value as bool? == true)"
                                               class="mt-1 h-4 w-4 rounded border-slate-300" />
                                        <span>
                                            <span class="block font-semibold text-slate-900">@student.FullName</span>
                                            @if (!string.IsNullOrWhiteSpace(student.Email))
                                            {
                                                <span class="block text-xs text-slate-500">@student.Email</span>
                                            }
                                            <span class="block text-xs font-medium @(student.PreviousKlasseId.HasValue ? "text-blue-700" : "text-emerald-700")">
                                                @(student.PreviousKlasseId.HasValue ? $"Ancienne classe : {student.PreviousKlasseName}" : "Nouvel élève · aucune classe précédente")
                                            </span>
                                        </span>
                                    </label>
                                }
                            }
                        </div>
                        <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
                            <p class="mb-0 text-xs font-semibold text-slate-500">@ReassignSelectedCount sélectionné(s)</p>
                            <AsyncActionButton Class="sk-btn sk-btn-primary"
                                               IsBusy="@isDatabaseActionInProgress"
                                               BusyLabel="Attribution..."
                                               Disabled="@(!CanSubmitReassign)"
                                               OnClick="@(_ => AssignSelectedStudentsToKlasseAsync())">
                                Ajouter à la classe
                            </AsyncActionButton>
                        </div>
                    </article>
                </div>
            }
        </Abschnitt>
    }

    @if (IsDirectorTabActive(DirectorTabImport))
    {
        <Abschnitt Titel="Import depuis Excel" Untertitel="Créez beaucoup d'enseignants ou d'élèves d'un coup. Champs obligatoires : Prénom, Nom, Classe." IconName="upload">
