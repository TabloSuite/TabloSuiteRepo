@page "/schulleiter"
@attribute [Authorize(Policy = "RequireSchulLeiter")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits SkoulouApp.WebApp.Components.CancelableComponentBase
@using SkoulouApp.Core.DataModels.Schools
@using SkoulouApp.Core.DataModels.Finanzen
@using SkoulouApp.Core.Models.Admin
@using SkoulouApp.Core.Models.Dashboard
@using SkoulouApp.Core.Models.Import
@using SkoulouApp.Core.Models.TeacherLessons
@using SkoulouApp.WebApp.Components.Shared
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>@(isKoordinator ? "Espace coordinateur" : "Espace directeur")</PageTitle>

<section class="flex flex-col gap-3">
	<div class="skoulou-hero relative overflow-hidden rounded-[1.25rem] px-5 py-3 text-white shadow-lg sm:px-6 sm:py-4">
		<div class="pointer-events-none absolute -top-16 -right-12 h-32 w-32 rounded-full bg-cyan-400/25 blur-3xl"></div>
		<div class="relative flex flex-wrap items-center justify-between gap-3 pr-14">
			<div class="min-w-0">
				<p class="text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-cyan-200">@(isProduktOwner ? "Établissements suivis" : "Direction de l'établissement")</p>
				<h1 class="mt-1 text-xl font-bold leading-tight xl:text-2xl">Gestion des élèves, des classes et des abonnements</h1>
				<p class="mt-1 hidden max-w-2xl text-sm text-slate-300 md:block">Valide les inscriptions, active les accès des élèves et pilote les classes, supports et examens de ton établissement.</p>
			</div>
		</div>
	</div>

	<Toast Message="@message" MessageChanged="v => message = v" Kind="Toast.ToastKind.Success" />
	<Toast Message="@errorMessage" MessageChanged="v => errorMessage = v" Kind="Toast.ToastKind.Error" />

	<div class="director-sticky-band">
		<div class="flex flex-wrap items-center gap-x-4 gap-y-2 pr-14 sm:pr-16">
			@if (HasMultipleSchools)
			{
				<div class="w-full min-w-[14rem] sm:w-72">
					<ModernDropdown TValue="string" Value="schoolFilterName" ValueChanged="SelectSchoolFilterAsync" Options="SchoolFilterOptions" Placeholder="Choisir une école" />
				</div>
				@if (schoolFilterName is not null && SelectedSchoolForManagement is { } selectedSchool)
				{
					<button type="button"
							class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-200"
							@onclick="() => OpenEditSchoolAsync(selectedSchool.SchoolId)">
						<Icon Name="edit" Groesse="16" /> Modifier école
					</button>
				}
			}
			else
			{
				@foreach (var school in schools)
				{
					<span class="text-sm font-bold text-slate-900">@school.SchoolName <span class="font-normal text-slate-500">· @school.City</span></span>
					<button type="button"
							class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-200"
							@onclick="() => OpenEditSchoolAsync(school.SchoolId)">
						<Icon Name="edit" Groesse="16" /> Modifier école
					</button>
				}
			}
			<div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
				<span class="rounded-full bg-indigo-50 px-3 py-1 text-indigo-700">@ActiveStudentCount élèves</span>
				<span class="rounded-full bg-rose-50 px-3 py-1 text-rose-700">@ActivePendingCount en attente</span>
				@if (HasMultipleSchools)
				{
					<span class="rounded-full bg-slate-100 px-3 py-1 text-slate-600">@schools.Count écoles</span>
				}
			</div>
		</div>
		<div class="mt-2">
        <div class="school-page-tabs" role="tablist" aria-label="Navigation direction">
            <button type="button"
                    role="tab"
                    aria-selected="@IsDirectorTabActive(DirectorTabSubjects)"
                    class="rounded-2xl border px-4 py-2 text-xs font-bold transition sm:text-sm @GetDirectorTabButtonClass(DirectorTabSubjects)"
                    @onclick="() => SetDirectorTab(DirectorTabSubjects)">
                Matières
            </button>
            <button type="button"
                    role="tab"
                    aria-selected="@IsDirectorTabActive(DirectorTabClasses)"
                    class="rounded-2xl border px-4 py-2 text-xs font-bold transition sm:text-sm @GetDirectorTabButtonClass(DirectorTabClasses)"
                    @onclick="() => SetDirectorTab(DirectorTabClasses)">
                Classes
            </button>
            <button type="button"
                    role="tab"
                    aria-selected="@IsDirectorTabActive(DirectorTabUsers)"
                    class="rounded-2xl border px-4 py-2 text-xs font-bold transition sm:text-sm @GetDirectorTabButtonClass(DirectorTabUsers)"
                    @onclick="() => SetDirectorTab(DirectorTabUsers)">
                Utilisateurs
            </button>
            <button type="button"
                    role="tab"
                    aria-selected="@IsDirectorTabActive(DirectorTabReassign)"
                    class="rounded-2xl border px-4 py-2 text-xs font-bold transition sm:text-sm @GetDirectorTabButtonClass(DirectorTabReassign)"
                    @onclick="() => SetDirectorTab(DirectorTabReassign)">
                Réattribution
            </button>
            <button type="button"
                    role="tab"
                    aria-selected="@IsDirectorTabActive(DirectorTabImport)"
                    class="rounded-2xl border px-4 py-2 text-xs font-bold transition sm:text-sm @GetDirectorTabButtonClass(DirectorTabImport)"
                    @onclick="() => SetDirectorTab(DirectorTabImport)">
                Import
            </button>
            @if (canViewSharedTeacherContent)
            {
                <button type="button"
                        role="tab"
                        aria-selected="@IsDirectorTabActive(DirectorTabShared)"
                        class="rounded-2xl border px-4 py-2 text-xs font-bold transition sm:text-sm @GetDirectorTabButtonClass(DirectorTabShared)"
                        @onclick="() => SetDirectorTab(DirectorTabShared)">
                    Contenus partagés
                </button>
            }
        </div>
        </div>
    </div>

    @if (IsDirectorTabActive(DirectorTabSubjects))
    {
    <CollapsibleCard Title="Matières de l'école"
                     Eyebrow="Gestion des matières"
                     Subtitle="Gestion scolaire des matières. Elles seront disponibles dans le formulaire enseignant."
                     Icon="book"
                     Accent="indigo"
                     Expanded="fachVerwaltungExpanded"
                     ExpandedChanged="value => fachVerwaltungExpanded = value">
        <ChildContent>

        @if (!string.IsNullOrWhiteSpace(fachVerwaltungErrorMessage))
        {
            <div class="mt-3 rounded-2xl bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-800">@fachVerwaltungErrorMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(fachVerwaltungStatusMessage))
        {
            <div class="mt-3 rounded-2xl bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800">@fachVerwaltungStatusMessage</div>
        }

        <div class="mt-3 rounded-2xl bg-indigo-50 px-4 py-3 text-sm font-semibold text-indigo-900 ring-1 ring-indigo-100">
            @if (SelectedSchoolForManagement is null)
            {
                <span>Sélectionne une école en haut de la page pour gérer les matières.</span>
            }
            else
            {
                <span>École active : @SelectedSchoolForManagement.SchoolName</span>
            }
        </div>

        <div class="mt-3 grid gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end">
            <div>
                <label class="skoulou-label">Recherche matière</label>
                <input @bind="fachSuchbegriff" @bind:event="oninput" class="skoulou-input" placeholder="Rechercher une matière" />
            </div>
            <div>
                <label class="skoulou-label">Nouvelle matière</label>
                <input @bind="neueSchulFachBezeichnung" @bind:event="oninput" class="skoulou-input" disabled="@isDatabaseActionInProgress" />
            </div>
            <AsyncActionButton Class="rounded-full bg-indigo-700 px-4 py-2 text-sm font-semibold text-white"
                               Disabled="@(!CanAddSchoolFach)"
                               IsBusy="@isDatabaseActionInProgress"
                               BusyLabel="Ajout..."
                               OnClick="@(_ => AddSchoolFachAsync())">
                Ajouter
            </AsyncActionButton>
        </div>

        @if (SelectedSchoolForManagement is null)
        {
            <p class="mt-4 text-xs text-slate-500">La liste des matières s'affiche après sélection d'une école.</p>
        }
        else if (GefilterteSchoolFachOptions.Count == 0)
        {
            <p class="mt-4 text-xs text-slate-500">Aucune matière pour la sélection actuelle.</p>
        }
        else
        {
            <div class="mt-4 max-h-[7.9rem] overflow-y-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                <div class="grid gap-2 sm:grid-cols-2">
                @foreach (var fach in GefilterteSchoolFachOptions)
                {
                    <div class="flex items-center justify-between gap-2 rounded-xl bg-slate-50 px-3 py-2 ring-1 ring-slate-200">
                        <span class="text-xs font-semibold text-slate-700">@fach.Name</span>
                        <button type="button"
                                class="rounded-full bg-rose-100 px-3 py-1 text-[11px] font-bold text-rose-700 transition hover:bg-rose-200 disabled:cursor-not-allowed disabled:opacity-50"
                                disabled="@fach.IstLehrerZugewiesen"
                                title="@(fach.IstLehrerZugewiesen ? "Attribuée à un enseignant" : $"Supprimer {fach.Name}")"
                                @onclick="() => AskDeleteSchoolFach(fach)">
                            Supprimer
                        </button>
                    </div>
                }
                </div>
            </div>
        }
        </ChildContent>
    </CollapsibleCard>
    }

    @if (IsDirectorTabActive(DirectorTabClasses))
    {
    <CollapsibleCard Title="Classes de mon école"
                      Eyebrow="Gestion des classes"
                      Subtitle="Crée et gère uniquement les classes propres à ton école."
                     Icon="school"
                     Accent="violet"
                     Expanded="klassenExpanded"
                     ExpandedChanged="value => klassenExpanded = value">
        <HeaderRight>
            <button type="button"
                    class="skoulou-btn-accent inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold transition hover:-translate-y-0.5 hover:shadow-md disabled:cursor-not-allowed disabled:opacity-50"
                    disabled="@(SelectedKlasseSchoolId is null)"
                    @onclick="OpenNewKlasseModal">
                <Icon Name="plus" Groesse="16" /> Nouvelle classe
            </button>
        </HeaderRight>
        <ChildContent>
            <Toast Message="@(klasseModalOpen ? null : klasseStatusMessage)" MessageChanged="v => klasseStatusMessage = v" Kind="Toast.ToastKind.Success" />
            <Toast Message="@(klasseModalOpen ? null : klasseErrorMessage)" MessageChanged="v => klasseErrorMessage = v" Kind="Toast.ToastKind.Error" />
            @if (!klasseModalOpen && !string.IsNullOrEmpty(klasseWarnMessage))
            {
                <div class="mb-4 rounded-2xl bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-800 ring-1 ring-amber-100">@klasseWarnMessage</div>
            }

            @if (SelectedKlasseSchoolId is null)
            {
                <p class="rounded-2xl bg-slate-50 px-4 py-5 text-sm text-slate-600">Sélectionne une école pour gérer ses classes.</p>
            }
            else
            {
                <div class="mb-5 rounded-2xl border border-indigo-100 bg-indigo-50/50 p-4">
                    <h3 class="font-bold text-slate-900">Mentions de fin de cycle</h3>
                    <p class="mt-1 text-sm text-slate-600">Définis les mentions de l'école une seule fois. Les mentions déjà enregistrées pour les élèves restent inchangées si cette liste évolue.</p>
                    @if (!string.IsNullOrWhiteSpace(mentionError)) { <p class="mt-2 text-sm text-rose-700">@mentionError</p> }
                    @if (!string.IsNullOrWhiteSpace(mentionMessage)) { <p class="mt-2 text-sm text-emerald-700">@mentionMessage</p> }
                    <div class="mt-3 flex flex-wrap gap-2">
                        <input class="skoulou-input min-w-0 flex-1" maxlength="80" aria-label="Texte de la mention" placeholder="Ex. Très bien" @bind="mentionText" />
                        <button type="button" class="skoulou-btn-accent rounded-full px-4 py-2 text-sm font-semibold" @onclick="SaveMentionAsync">@(mentionEditId.HasValue ? "Modifier" : "Ajouter")</button>
                        @if (mentionEditId.HasValue)
                        {
                            <button type="button" class="rounded-full bg-white px-4 py-2 text-sm font-semibold" @onclick="() => { mentionEditId = null; mentionText = string.Empty; }">Annuler</button>
                        }
                    </div>
                    <ul class="mt-3 flex flex-wrap gap-2">
                        @foreach (var mention in schulMentions)
                        {
                            <li class="flex items-center gap-1 rounded-full bg-white px-3 py-1 text-sm ring-1 ring-slate-200" @key="mention.Id">
                                <span>@mention.Text</span>
                                <button type="button" class="px-2 font-semibold text-indigo-700" aria-label="Modifier @mention.Text" @onclick="() => EditMention(mention)">Modifier</button>
                                <button type="button" class="px-2 font-semibold text-rose-700" aria-label="Supprimer @mention.Text" @onclick="() => DeleteMentionAsync(mention.Id)" @onclick:stopPropagation="true">Supprimer</button>
                            </li>
                        }
                    </ul>
                </div>
                <div class="mb-5 flex flex-wrap items-center justify-between gap-4">
                    <div>
                        <p class="font-bold text-slate-900">@schoolKlassen.Count classe(s)</p>
                    </div>
                </div>

                @if (schoolKlassen.Count == 0)
                {
                    <p class="rounded-2xl bg-slate-50 px-4 py-5 text-sm text-slate-600">Aucune classe propre pour le moment.</p>
                }
                else
                {
                    <div class="mb-5 grid gap-3 rounded-2xl bg-slate-50 p-4 ring-1 ring-slate-100 sm:grid-cols-2">
                        <div>
                            <ModernDropdown TValue="string" Label="Statut des cycles" Value="durchlaufStatusFilter" ValueChanged="SetDurchlaufStatusFilterAsync" Options="DurchlaufStatusOptions" />
                        </div>
                        <ModernDropdown TValue="Guid?" Label="Nom de référence" Value="klassenStufeFilterId" ValueChanged="SetKlassenStufeFilterAsync" Options="KlassenStufeFilterOptions" />
                    </div>
                    @if (GefilterteKlassen.Count == 0)
                    {
                        <p class="rounded-2xl bg-slate-50 px-4 py-5 text-sm text-slate-600">Aucune classe ne correspond aux filtres sélectionnés.</p>
                    }
                    else
                    {
                    <div class="grid gap-3">
                        @foreach (var klasse in GefilterteKlassen)
                        {
                            <article class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200 p-4">
                                <div>
                                    <p class="font-bold text-slate-900">@klasse.Title</p>
                                    <p class="mt-1 text-sm text-slate-500">
                                        @klasse.Price FCFA
                                        @if (!string.IsNullOrWhiteSpace(klasse.ReferenceName))
                                        {
                                            <span> · Réf. @klasse.ReferenceName</span>
                                        }
                                    </p>
                                    <div class="mt-2 rounded-xl border border-slate-200 bg-white px-3 py-2">
                                        <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-semibold">
                                            <span class="text-slate-600">Occupation</span>
                                            @if (klasse.MaxPlaetze.HasValue)
                                            {
                                                <span class="@(IsKlasseOverbooked(klasse) ? "text-rose-700" : "text-slate-700")">@klasse.CurrentStudentCount / @klasse.MaxPlaetze.Value élève(s)</span>
                                            }
                                            else
                                            {
                                                <span class="text-slate-500">@klasse.CurrentStudentCount élève(s) · capacité libre</span>
                                            }
                                        </div>
                                        @if (klasse.MaxPlaetze.HasValue)
                                        {
                                            <div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-100">
                                                <div class="h-full @GetOccupancyBarClass(klasse)" style="@($"width:{GetOccupancyPercent(klasse)}%")"></div>
                                            </div>
                                            @if (IsKlasseOverbooked(klasse))
                                            {
                                                <p class="mt-2 text-xs font-semibold text-rose-700">Sur-occupation autorisée : +@(klasse.CurrentStudentCount - klasse.MaxPlaetze.Value) élève(s) au-dessus de la capacité.</p>
                                            }
                                            else if (GetRemainingPlaetze(klasse) is int reste)
                                            {
                                                <p class="mt-2 text-xs text-slate-500">Places restantes : @reste</p>
                                            }
                                        }
                                    </div>
                                    @if (klasse.CourseId.HasValue && durchlaeufeNachKlasse.TryGetValue(klasse.CourseId.Value, out var durchlauf))
                                    {
                                        @if (durchlauf.IstAktiv)
                                        {
                                            <p class="mt-2 text-xs font-semibold text-emerald-700">Cycle actif depuis le @durchlauf.StartDatum.ToString("dd.MM.yyyy") · @durchlauf.NiveauPreis:N0 FCFA</p>
                                        }
                                        else
                                        {
                                            <p class="mt-2 text-xs font-semibold text-slate-500">Dernier cycle : @durchlauf.StartDatum.ToString("dd.MM.yyyy") – @durchlauf.EndDatum?.ToString("dd.MM.yyyy")</p>
                                        }
                                    }
                                    else
                                    {
                                        <p class="mt-2 text-xs font-semibold text-amber-700">Aucun cycle démarré</p>
                                    }
                                </div>

                                <div class="flex flex-wrap items-center gap-2">
                                    <button type="button" class="rounded-full bg-indigo-600 px-4 py-2 text-xs font-semibold text-white transition hover:bg-indigo-700" @onclick="() => OpenNewStudentForKlasseAsync(klasse)">Ajouter élève</button>
                                    @if (darfCycleZahlungenVerwalten && klasse.CourseId.HasValue && durchlaeufeNachKlasse.TryGetValue(klasse.CourseId.Value, out var aktuellerDurchlauf) && aktuellerDurchlauf.IstAktiv)
                                    {
                                        <button type="button" class="rounded-full bg-indigo-700 px-4 py-2 text-xs font-semibold text-white transition hover:bg-indigo-800" @onclick="() => OpenAbschlussNoten(aktuellerDurchlauf.DurchlaufID)">Définir les notes finales</button>
                                        <button type="button" class="rounded-full bg-rose-600 px-4 py-2 text-xs font-semibold text-white transition hover:bg-rose-700" @onclick="() => OpenDurchlaufEndeModal(aktuellerDurchlauf)">Clôturer le cycle</button>
                                    }
                                    else if (darfCycleZahlungenVerwalten && (!klasse.CourseId.HasValue || !durchlaeufeNachKlasse.TryGetValue(klasse.CourseId.Value, out var laufenderDurchlauf) || !laufenderDurchlauf.IstAktiv))
                                    {
                                        @if (klasse.CourseId.HasValue && durchlaeufeNachKlasse.TryGetValue(klasse.CourseId.Value, out var letzterDurchlauf))
                                        {
                                        }
                                        <button type="button" class="rounded-full bg-emerald-600 px-4 py-2 text-xs font-semibold text-white transition hover:bg-emerald-700" @onclick="() => OpenDurchlaufStartModalAsync(klasse)">Démarrer le cycle</button>
                                    }
                                    <button type="button" class="rounded-full bg-slate-950 px-4 py-2 text-xs font-semibold text-white transition hover:bg-slate-800" @onclick="() => OpenEditKlasseModal(klasse)">Modifier</button>
                                </div>
                            </article>
                        }
                    </div>
                    }
                }
            }
        </ChildContent>
    </CollapsibleCard>
    }

    @if (IsDirectorTabActive(DirectorTabUsers))
    {
    <CollapsibleCard Title="@SchoolUsersCardTitle"
                 Eyebrow="Gestion des utilisateurs"
                 Icon="users"
                 Accent="cyan"
                 Expanded="usersExpanded"
                 ExpandedChanged="v => usersExpanded = v">
    <HeaderRight>
        <button type="button"
                class="inline-flex items-center gap-2 rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-lg"
                @onclick="OpenNewUserModalAsync">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            Nouvel utilisateur
        </button>
    </HeaderRight>
    <ChildContent>
    <Toast Message="@userStatusMessage" MessageChanged="v => userStatusMessage = v" Kind="Toast.ToastKind.Success" />
    <Toast Message="@userErrorMessage" MessageChanged="v => userErrorMessage = v" Kind="Toast.ToastKind.Error" />

    @if (FilteredSchoolUsersOhneSchueler.Count == 0)
    {
        <p class="mt-6 text-sm text-slate-600">@EmptySchoolUsersText</p>
    }
    else
    {
        <div class="mt-6">
            <DataListPanel Items="FilteredSchoolUsersOhneSchueler"
                           PageSize="10"
                           SearchPlaceholder="Rechercher un utilisateur..."
                           EmptyText="Aucun utilisateur trouvé."
                           ResultLabelSingular="utilisateur"
                           ResultLabelPlural="utilisateurs"
                           Chips="schoolUserChips"
                           Filter="@((SchoolUserItem u, string term) => Contains(u.FullName, term) || Contains(u.Email, term) || Contains(GetRoleLabel(u.RoleName), term))">
                <div class="grid gap-4">
                    @foreach (var user in context)
                    {
                        var studentInfo = user.RoleName == "Schüler"
                            ? students.FirstOrDefault(s => s.UserId == user.UserId)
                            : null;
                        <article class="rounded-2xl border border-slate-200 @(user.RoleName == "Schüler" ? "p-3" : "p-5") transition duration-200 hover:-translate-y-0.5 hover:border-cyan-200 hover:shadow-md">
                            <div class="flex flex-wrap items-start justify-between gap-3">
                                <div>
                                    <h3 class="text-lg font-bold text-slate-900">@user.FullName</h3>
                                    <p class="mt-1 text-sm text-slate-500">@user.Email</p>
                                    @if (studentInfo is not null)
                                    {
                                        <div class="mt-2 flex flex-wrap gap-2 text-xs">
                                            <span class="inline-flex items-center rounded-full bg-cyan-50 px-3 py-1 font-semibold text-cyan-800 ring-1 ring-cyan-100">
                                                SKOULOUAPP: @(studentInfo.HasPaidEnrollment ? "Actif" : "Inactif")
                                            </span>
                                            <span class="inline-flex items-center rounded-full bg-emerald-50 px-3 py-1 font-semibold text-emerald-800 ring-1 ring-emerald-100">
                                                @(studentInfo.IsSchoolFeeFullyPaid
                                                    ? "Scolarité: tout payé"
                                                    : studentInfo.SchoolFeeAmount.HasValue
                                                        ? $"Scolarité: reste {(studentInfo.SchoolFeeAmount.Value - studentInfo.SchoolFeePaidAmount):N0} FCFA"
                                                        : "Scolarité: non définie")
                                            </span>
                                            <span class="inline-flex items-center rounded-full bg-slate-50 px-3 py-1 font-semibold text-slate-700 ring-1 ring-slate-200">
                                                Score: @(studentInfo.CombinedScorePercent.HasValue ? $"{studentInfo.CombinedScorePercent}%" : "non défini")
                                            </span>
                                        </div>
                                    }
                                </div>
                                <div class="flex flex-wrap gap-2">
                                    <Badge Accent="slate">@GetRoleLabel(user.RoleName)</Badge>
                                    <Badge Accent="@(user.IsBlocked ? "rose" : "emerald")">@(user.IsBlocked ? "Compte bloqué" : "Compte actif")</Badge>
                                </div>
                            </div>
                            <p class="mt-3 text-sm text-slate-600">Écoles : @(user.Schools.Count == 0 ? "Aucune affectation" : string.Join(", ", user.Schools))</p>
                            <div class="mt-3 flex flex-wrap gap-2">
                                <button type="button" class="inline-flex items-center gap-2 rounded-full bg-slate-950 px-4 py-2 @(user.RoleName == "Schüler" ? "text-xs" : "text-sm") font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-md" @onclick="() => OpenEditUserAsync(user.UserId)">
                                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" /></svg>
                                    Modifier
                                </button>
                                @if (user.RoleName == "Lehrer")
                                {
                                    <button type="button" class="skoulou-btn-accent inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold transition duration-200 hover:-translate-y-0.5 hover:shadow-md" @onclick="() => OpenZuordnungAsync(user.UserId, user.FullName)">
                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25Z" /></svg>
                                         Classes
                                    </button>
                                }
                                @if (user.IsBlocked)
                                {
                                    <button type="button" class="inline-flex items-center gap-2 rounded-full bg-emerald-600 px-4 py-2 @(user.RoleName == "Schüler" ? "text-xs" : "text-sm") font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-emerald-700 hover:shadow-md" @onclick="() => SetUserBlockedAsync(user.UserId, false)">
                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                                        Activer
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="inline-flex items-center gap-2 rounded-full bg-rose-600 px-4 py-2 @(user.RoleName == "Schüler" ? "text-xs" : "text-sm") font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-rose-700 hover:shadow-md" @onclick="() => SetUserBlockedAsync(user.UserId, true)">
                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636" /></svg>
                                        Bloquer
                                    </button>
                                }
                            </div>
                        </article>
                    }
                </div>
            </DataListPanel>
        </div>
    }

    <div class="mt-8 border-t border-slate-200 pt-8">
        <div class="mb-4 flex items-center justify-between gap-3">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-700">Élèves</p>
            <Badge Accent="slate">@FilteredStudents.Count élèves</Badge>
        </div>

        <div class="mb-4 grid gap-3 sm:grid-cols-2">
            <ModernDropdown TValue="Guid?" Label="Classe de référence" Value="studentKlassenStufeFilterId" ValueChanged="SetStudentKlassenStufeFilterAsync" Options="StudentKlassenStufeFilterOptions" />
            <ModernDropdown TValue="Guid?" Label="Classe" Value="studentKlasseFilterId" ValueChanged="SetStudentKlasseFilterAsync" Options="StudentKlasseFilterOptionsModern" />
        </div>
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl bg-slate-50 px-4 py-3 ring-1 ring-slate-100">
            <label class="inline-flex items-center gap-2 text-sm font-semibold text-slate-700">
                <input type="checkbox"
                       class="h-4 w-4 rounded border-slate-300"
                       disabled="@(ArchivableFilteredStudents.Count == 0)"
                       checked="@AreAllFilteredStudentsSelectedForArchive"
                       @onchange="args => ToggleSelectAllFilteredStudentsForArchiveAsync(args.Value as bool? == true)" />
                Tout sélectionner (@ArchivableFilteredStudents.Count)
            </label>
            <div class="flex items-center gap-2">
                <span class="text-xs font-semibold text-indigo-700">Sélectionnés: @ArchiveSelectedCount</span>
                <AsyncActionButton Class="rounded-full bg-amber-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-amber-700 disabled:opacity-50"
                                   IsBusy="@isDatabaseActionInProgress"
                                   BusyLabel="Archivage..."
                                   Disabled="@(!CanArchiveSelectedStudents)"
                                   OnClick="ArchiveSelectedStudentsAsync">
                    Archiver la sélection
                </AsyncActionButton>
            </div>
        </div>
        @if (FilteredStudents.Count == 0)
        {
            <div class="rounded-2xl bg-slate-50 px-5 py-4 text-sm text-slate-600 ring-1 ring-slate-100">
                Aucun élève pour le moment.
            </div>
        }
        else
        {
            <DataListPanel Items="FilteredStudents"
                           PageSize="10"
                           SearchPlaceholder="Rechercher un élève..."
                           EmptyText="Aucun élève trouvé."
                           ResultLabelSingular="élève"
                           ResultLabelPlural="élèves"
                           SortOptions="studentSortOptions"
                            Filter="@((StudentApprovalItem s, string term) => Contains(s.FullName, term) || Contains(s.Email, term) || Contains(s.SchoolName, term) || Contains(s.CurrentLevelCode, term) || Contains(s.CurrentKlasseName, term))">
                <div class="flex flex-col gap-3">
                @foreach (var student in context)
                {
                    <div class="rounded-2xl border border-slate-100 p-4 transition duration-200 hover:border-cyan-200 hover:shadow-md">
                        <div class="flex flex-wrap items-center justify-between gap-3">
                            <div>
                                <label class="mb-2 inline-flex items-center gap-2 text-xs font-semibold text-slate-600">
                                    <input type="checkbox"
                                           class="h-4 w-4 rounded border-slate-300"
                                            disabled="@(!IsStudentArchivable(student))"
                                           checked="@IsStudentSelectedForArchive(student.UserId)"
                                           @onchange="args => ToggleArchiveStudentAsync(student.UserId, args.Value as bool? == true)" />
                                    Sélectionner pour archivage
                                </label>
                                @if (!IsStudentArchivable(student))
                                {
                                    <p class="mb-2 text-xs font-medium text-slate-500">Archivage possible uniquement pour les élèves sans classe active.</p>
                                }
                                <div class="flex flex-wrap items-center gap-2">
                                    <div class="font-bold text-slate-900">@student.FullName</div>
                                    @if (!student.IsBlocked)
                                    {
                                        <Badge Accent="cyan">@(student.CurrentKlasseId.HasValue ? "Accès scolaire validé" : "Classe à attribuer")</Badge>
                                    }
                                    @if (student.HasSchoolFeeInfo)
                                    {
                                        <Badge Accent="@(student.IsSchoolFeeFullyPaid ? "emerald" : student.SchoolFeePaidAmount > 0m ? "cyan" : "amber")">@GetSchoolFeeHeaderLabel(student.SchoolFeePaidAmount, student.SchoolFeeAmount, student.HasActiveSchoolFeeCycle)</Badge>
                                    }
                                </div>
                                <div class="text-sm text-slate-500">@student.Email · @student.SchoolName</div>
                                <div class="mt-2 flex flex-wrap gap-2">
                                     <div class="inline-flex items-center gap-2 rounded-full bg-cyan-50 px-3 py-1.5 text-sm text-cyan-800 ring-1 ring-cyan-100">
                                         <span aria-hidden="true"><Icon Name="school" Groesse="16" /> </span>
                                          <span class="font-semibold">Classe active :</span>
                                         <span>@student.CurrentLevelCode@if (!string.IsNullOrWhiteSpace(student.CurrentKlasseName) && student.CurrentKlasseName != student.CurrentLevelCode) { <text> · @student.CurrentKlasseName</text> }</span>
                                     </div>
                                    <div class="inline-flex items-center gap-2 rounded-full bg-slate-50 px-3 py-1.5 text-sm ring-1 ring-slate-200">
                                        <span aria-hidden="true"><Icon Name="book" Groesse="16" /> </span>
                                        <span class="text-slate-600">Score exercices &amp; examens :</span>
                                        @if (student.CombinedScorePercent.HasValue)
                                        {
                                            <span class="font-black" style="color:@ScoreColorHelper.GetScoreColor(student.CombinedScorePercent.Value)">@student.CombinedScorePercent %</span>
                                            <span class="text-xs text-slate-400">(@student.CombinedScoreCount)</span>
                                        }
                                        else
                                        {
                                            <span class="text-slate-400">–</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                @if (student.IsBlocked)
                                {
                                    <Badge Accent="rose">Enregistrement bloqué / en attente</Badge>
                                    <button type="button"
                                            class="rounded-full bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-700"
                                            @onclick="() => SetBlockedAsync(student.UserId, false)">
                                        Valider
                                    </button>
                                     @if (student.IsSelfRegistered)
                                     {
                                         <button type="button"
                                                 class="rounded-full bg-rose-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-rose-700"
                                                 @onclick="() => DeletePendingStudentAsync(student.UserId)">
                                             Supprimer l'inscription
                                         </button>
                                     }
                                }
                                else
                                {
                                    <Badge Accent="emerald">Enregistrement validé</Badge>
                                    <Badge Accent="cyan">@(student.CurrentKlasseId.HasValue ? "Supports publiés de la classe accessibles" : "Classe à attribuer")</Badge>
                                        <button type="button"
                                                class="rounded-full bg-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-300"
                                                @onclick="() => SetBlockedAsync(student.UserId, true)">
                                            Bloquer
                                        </button>
                                }
                                <button type="button"
                                        class="rounded-full bg-slate-950 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-800"
                                        @onclick="() => OpenEditStudentPersonalAsync(student.UserId)">
                                    Modifier
                                </button>
                                 <button type="button"
                                        class="inline-flex items-center gap-1.5 rounded-full bg-cyan-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-cyan-700"
                                        @onclick="() => ToggleLevelPanelAsync(student.UserId)">
                                    Classes et participation
                                    <svg class="h-4 w-4 transition-transform duration-200 @(expandedStudentId == student.UserId ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
                                </button>
                            </div>
                        </div>

                        @if (expandedStudentId == student.UserId)
                        {
                            <div class="mt-4 grid gap-2">
                                @foreach (var level in levelEnrollments)
                                {
                                    <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl px-4 py-3 @(level.IsCurrentKlasse ? "bg-cyan-50 ring-1 ring-cyan-200" : "bg-slate-50")">
                                        <div>
                                            <span class="font-semibold text-slate-800">@level.CourseCode</span>
                                            <span class="text-sm text-slate-500">@level.CourseTitle</span>
                                            @if (level.IsCurrentKlasse)
                                            {
                                                <Badge Accent="cyan">Classe actuelle</Badge>
                                            }
                                        </div>
                                        <div class="flex flex-wrap items-center gap-2">
                                            @if (level.AutomatischeZyklusabrechnung)
                                            {
                                                <Badge Accent="cyan">Facturation automatique par cycle</Badge>
                                                <span class="text-xs text-slate-600">Aucun paiement individuel requis pour l'accès.</span>
                                            }
                                            else if (level.IsUnlocked)
                                            {
                                                <Badge Accent="cyan">Abonnement SKOULOUAPP</Badge>
                                                <Badge Accent="slate">@level.AboPreis.ToString("N0") FCFA</Badge>
                                            }

                                            @if (!level.AutomatischeZyklusabrechnung && level.IsPaid)
                                            {
                                                <Badge Accent="emerald">Paiement effectué</Badge>
                                            }

                                            @if (level.IsCurrentKlasse && level.HasActiveClassCycle)
                                            {
                                                <Badge Accent="emerald">Cycle actif</Badge>
                                            }
                                            else if (level.IsClassCycleClosed)
                                            {
                                                <Badge Accent="slate">Cycle clôturé</Badge>
                                            }
                                            else if (level.IsCurrentKlasse && !level.HasActiveClassCycle)
                                            {
                                                <Badge Accent="amber">Cycle non démarré</Badge>
                                            }

                                            @if (level.CanAssignOrUpgradeAbo)
                                            {
                                                <button type="button"
                                                        class="skoulou-btn-accent rounded-full px-3 py-1.5 text-xs font-semibold"
                                                        @onclick="() => OpenAboModal(student, level)">
                                                    Gérer l'abonnement
                                                </button>
                                            }

                                            @if (!level.AutomatischeZyklusabrechnung && !level.IsCurrentKlasse && !level.IsUnlocked)
                                            {
                                                <span class="text-xs font-medium text-slate-400">Aucun abonnement</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            </DataListPanel>
        }
    </div>

    </ChildContent>
</CollapsibleCard>
    }

    @if (IsDirectorTabActive(DirectorTabReassign))
    {
    <CollapsibleCard InitiallyExpanded="true" Title="Réassignation des élèves sans classe active"
                     Eyebrow="Session de réattribution"
                     Subtitle="À gauche: classe cible. À droite: élèves sans classe active avec recherche et sélection multiple."
                     Icon="refresh"
                     Accent="indigo">
        <ChildContent>
            @if (SelectedKlasseSchoolId is null)
            {
                <p class="rounded-2xl bg-slate-50 px-4 py-5 text-sm text-slate-600">Sélectionne une école pour réattribuer les élèves.</p>
            }
            else
            {
                <div class="grid gap-4 lg:grid-cols-2">
                    <article class="rounded-2xl border border-slate-100 bg-slate-50 p-4">
                        <h3 class="text-sm font-black uppercase tracking-[0.14em] text-slate-700">Classe cible</h3>
                        <div class="mt-3">
                            <ModernDropdown TValue="Guid?" Label="Classe" Value="reassignTargetKlasseId" ValueChanged="SetReassignTargetKlasseAsync" Options="ReassignKlasseOptions" />
                        </div>
                        @if (ReassignTargetKlasse is not null)
                        {
                            <div class="mt-4 rounded-2xl border border-indigo-100 bg-white p-3">
                                <div class="flex items-center justify-between gap-3">
                                    <p class="text-sm font-bold text-slate-800">Élèves actuellement dans la classe</p>
                                    <Badge Accent="indigo">@ReassignTargetKlasse.CurrentStudentCount</Badge>
                                </div>
                                @if (ReassignTargetStudents.Count > 0)
                                {
                                    <div class="mt-3 max-h-48 overflow-auto rounded-xl border border-slate-100">
                                        @foreach (var student in ReassignTargetStudents)
                                        {
                                            <div class="flex items-center justify-between gap-3 border-b border-slate-100 px-3 py-2 last:border-b-0">
                                                <div class="min-w-0">
                                                    <p class="truncate text-sm font-semibold text-slate-900">@student.FullName</p>
                                                    <p class="truncate text-xs text-slate-500">@student.Email</p>
                                                </div>
                                                <button type="button" class="shrink-0 rounded-full bg-rose-50 px-3 py-1.5 text-xs font-semibold text-rose-700 transition hover:bg-rose-100" @onclick="() => OpenReassignRemoveConfirmation(student)">Retirer</button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        <p class="mt-3 text-xs text-slate-500">Astuce: utilise le filtre de référence (CP1, CP2, etc.) au-dessus pour limiter la liste des classes.</p>
                    </article>

                    <article class="rounded-2xl border border-slate-100 bg-white p-4">
                        <div class="flex items-center justify-between gap-3">
                            <h3 class="text-sm font-black uppercase tracking-[0.14em] text-slate-700">Élèves sans classe active</h3>
                            <Badge Accent="slate">@FilteredStudentsWithoutActiveClass.Count</Badge>
                        </div>
                        <div class="mt-3 grid gap-3 sm:grid-cols-2">
                            <ModernDropdown TValue="string"
                                            Label="Situation précédente"
                                            Value="reassignPreviousKlasseFilter"
                                            ValueChanged="SetReassignPreviousKlasseFilterAsync"
                                            Options="ReassignPreviousKlasseOptions"
                                            Searchable="true"
                                            SearchPlaceholder="Rechercher une ancienne classe..." />
                            <div>
                                <label class="mb-1 block text-xs font-semibold text-slate-600">Recherche</label>
                                <input class="skoulou-input text-sm" placeholder="Nom, email, ancienne classe..." value="@reassignSearch" @oninput="SetReassignSearchAsync" />
                            </div>
                        </div>
                        <div class="mt-3 max-h-72 overflow-auto rounded-xl ring-1 ring-slate-100">
                            @if (FilteredStudentsWithoutActiveClass.Count == 0)
                            {
                                <p class="p-4 text-sm text-slate-500">Aucun élève sans classe active.</p>
                            }
                            else
                            {
                                @foreach (var student in FilteredStudentsWithoutActiveClass)
                                {
                                    <label class="flex items-start gap-3 border-b border-slate-100 px-3 py-2 text-sm last:border-b-0">
                                        <input type="checkbox"
                                               checked="@IsStudentSelectedForReassign(student.UserId)"
                                               @onchange="args => ToggleReassignStudentAsync(student.UserId, args.Value as bool? == true)"
                                               class="mt-1 h-4 w-4 rounded border-slate-300" />
                                        <span>
                                            <span class="block font-semibold text-slate-900">@student.FullName</span>
                                            <span class="block text-xs text-slate-500">@student.Email</span>
                                            <span class="block text-xs font-medium @(student.PreviousKlasseId.HasValue ? "text-indigo-700" : "text-emerald-700")">
                                                @(student.PreviousKlasseId.HasValue ? $"Ancienne classe : {student.PreviousKlasseName}" : "Nouvel élève · aucune classe précédente")
                                            </span>
                                        </span>
                                    </label>
                                }
                            }
                        </div>
                        <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
                            <p class="text-xs font-semibold text-indigo-700">Sélectionnés: @ReassignSelectedCount</p>
                            <AsyncActionButton Class="skoulou-btn-accent rounded-full px-4 py-2 text-sm font-semibold disabled:opacity-50"
                                               IsBusy="@isDatabaseActionInProgress"
                                               BusyLabel="Attribution..."
                                               Disabled="@(!CanSubmitReassign)"
                                               OnClick="@(_ => AssignSelectedStudentsToKlasseAsync())">
                                Ajouter à la classe
                            </AsyncActionButton>
                        </div>
                    </article>
                </div>
            }
        </ChildContent>
    </CollapsibleCard>
    }

@if (neueZugangsdaten.Count > 0)
{
    <ModalDialog Open="true" Title="Identifiants initiaux" CloseOnBackdrop="false">
        <p>Transmettez ces identifiants individuellement et confidentiellement. Ils ne seront plus affichés après fermeture. Chaque personne peut modifier son mot de passe dans son profil.</p>
        @foreach (var zugang in neueZugangsdaten)
        {
            <div class="my-3 break-all rounded-xl bg-slate-100 p-3"><span class="text-xs text-slate-500">Identifiant</span><br /><strong>@zugang.Identifiant</strong><br /><span class="text-xs text-slate-500">Mot de passe</span><br /><code>@zugang.Passwort</code></div>
        }
        <button type="button" class="skoulou-button-primary" @onclick="() => neueZugangsdaten.Clear()">J'ai transmis les identifiants — fermer</button>
    </ModalDialog>
}

<ModalDialog @bind-Open="reassignRemoveConfirmOpen"
             Title="Retirer l'élève de la classe"
             Eyebrow="Confirmation"
             ErrorMessage="@reassignRemoveErrorMessage"
             CloseOnBackdrop="false"
             MaxWidthClass="max-w-md">
    @if (reassignStudentToRemove is not null && ReassignTargetKlasse is not null)
    {
        <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-950">
            <p>Retirer <strong>@reassignStudentToRemove.FullName</strong> de <strong>@GetKlassenAnzeige(ReassignTargetKlasse)</strong> ?</p>
            <p class="mt-2">L'élève reviendra dans la liste des élèves sans classe active. Son compte ne sera pas supprimé.</p>
            <p class="mt-2 text-xs">Une affectation avec abonnement actif ou payé ne peut pas être retirée ici.</p>
        </div>
        <div class="mt-5 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
            <button type="button" class="rounded-full bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-200" @onclick="CloseReassignRemoveConfirmation">Annuler</button>
            <AsyncActionButton Class="rounded-full bg-rose-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-rose-700"
                               IsBusy="@isDatabaseActionInProgress"
                               BusyLabel="Retrait..."
                               OnClick="@(_ => RemoveReassignedStudentAsync())">
                Retirer de la classe
            </AsyncActionButton>
        </div>
    }
</ModalDialog>

    @if (IsDirectorTabActive(DirectorTabImport))
    {
    <CollapsibleCard Title="Import utilisateurs"
                     Eyebrow="Création automatique"
                     Subtitle="Ajoute beaucoup d'enseignants ou d'élèves à partir d'un fichier CSV Excel. Champs obligatoires : Prénom, Nom, Classe."
                     Icon="download"
                     Accent="cyan"
                     Expanded="userImportExpanded"
                     ExpandedChanged="value => userImportExpanded = value">
        <ChildContent>
            @if (SelectedKlasseSchoolId is null)
            {
                <p class="rounded-2xl bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-800 ring-1 ring-amber-100">
                    Sélectionne d'abord une école précise. L'import n'est pas disponible dans la vue combinée « Toutes les écoles ».
                </p>
            }

            <div class="grid gap-6">
                <article class="rounded-3xl border border-cyan-100 bg-gradient-to-br from-cyan-50 to-white p-6 shadow-sm sm:p-8">
                    <div class="flex items-start gap-3">
                        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-2xl bg-cyan-600 text-lg font-black text-white">1</span>
                        <div>
                            <h3 class="text-lg font-black text-slate-900">Prépare ton fichier en 4 étapes</h3>
                            <ol class="mt-3 grid gap-3 text-sm leading-6 text-slate-700 sm:grid-cols-2">
                                <li><strong>1. Ouvre Excel</strong> et crée un nouveau tableau.</li>
                                <li><strong>2. Copie les titres de colonnes</strong> indiqués dans l'exemple correspondant.</li>
                                <li><strong>3. Ajoute une personne par ligne.</strong> Les champs optionnels peuvent rester vides. Si l'e-mail est vide, il est créé automatiquement. Chaque personne reçoit un mot de passe initial individuel, affiché après l'import pour transmission confidentielle.</li>

                                <li><strong>4. Enregistre le fichier</strong> au format <strong>CSV UTF-8 (*.csv)</strong> ou <strong>Excel (*.xlsx)</strong>, puis charge-le ci-dessous.</li>
                            </ol>
                            <p class="mt-3 text-xs font-medium text-cyan-900">Les classes doivent déjà exister dans l'école sélectionnée. Seule la première feuille Excel est lue. Taille maximale : 2 Mo par fichier.</p>
                        </div>
                    </div>
                </article>

                <article class="rounded-3xl border border-cyan-100 border-l-8 border-l-cyan-500 bg-white p-6 shadow-md sm:p-8">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <h3 class="text-xl font-black text-slate-900">Ajouter des enseignants</h3>
                            <p class="mt-1 text-sm text-slate-600">Un enseignant peut être attribué à une ou plusieurs classes. Sépare plusieurs classes par une virgule.</p>
                        </div>
                        <Badge Accent="cyan">CSV / Excel</Badge>
                    </div>
                    <div class="mt-4 overflow-x-auto rounded-2xl bg-white ring-1 ring-slate-100">
                        <p class="border-b border-slate-100 px-3 py-2 text-xs font-black uppercase tracking-[0.14em] text-slate-500">Exemple dans Excel</p>
                        <table class="w-full text-left text-xs text-slate-700">
                            <thead class="bg-slate-50 font-black text-slate-900">
                                <tr><th class="px-3 py-2 text-rose-600">Prénom *</th><th class="px-3 py-2 text-rose-600">Nom *</th><th class="px-3 py-2 text-rose-600">Classe *</th><th class="px-3 py-2">E-mail</th><th class="px-3 py-2">Téléphone</th></tr>
                            </thead>
                            <tbody>
                                <tr class="border-t border-slate-100"><td class="px-3 py-2">Afi</td><td class="px-3 py-2">Kodjo</td><td class="px-3 py-2">CM2A, CM2B</td><td class="px-3 py-2">afi.kodjo@ecole.tg</td><td class="px-3 py-2">+22890112233</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-4 grid gap-3">
                        <label class="group flex cursor-pointer items-center justify-between gap-4 rounded-2xl border border-dashed border-cyan-200 bg-white px-4 py-3 shadow-sm transition hover:border-cyan-400 hover:bg-cyan-50/60 hover:shadow-md @(SelectedKlasseSchoolId is null || isDatabaseActionInProgress ? "pointer-events-none opacity-50" : null)">
                            <span class="flex items-center gap-3">
                                <span class="grid h-11 w-11 place-items-center rounded-2xl bg-cyan-100 text-xl text-cyan-700 transition group-hover:bg-cyan-600 group-hover:text-white"><Icon Name="log" Groesse="16" /> </span>
                                <span>
                                    <span class="block text-sm font-black text-slate-900">Choisir un fichier CSV ou Excel</span>
                                    <span class="block text-xs font-semibold text-slate-500">CSV ou Excel (.xlsx, première feuille) · max. 2 Mo</span>
                                </span>
                            </span>
                            <span class="rounded-full bg-cyan-600 px-4 py-2 text-xs font-bold text-white shadow-sm transition group-hover:bg-cyan-700">Parcourir</span>
                            <InputFile class="sr-only" OnChange="OnTeacherImportFileSelectedAsync" accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" disabled="@(SelectedKlasseSchoolId is null || isDatabaseActionInProgress)" />
                        </label>
                        @if (teacherImportPreview is not null)
                        {
                            <SchoolUserImportPreviewTable Preview="teacherImportPreview" />
                            <AsyncActionButton Class="skoulou-btn-accent rounded-full px-4 py-2 text-sm font-semibold disabled:opacity-50" IsBusy="@isDatabaseActionInProgress" BusyLabel="Import..." OnClick="@(_ => CommitTeacherImportAsync())" Disabled="@(!teacherImportPreview.Succeeded || teacherImportPreview.ValidRowCount == 0)">
                                Importer les enseignants (@teacherImportPreview.ValidRowCount)
                            </AsyncActionButton>
                        }
                    </div>
                </article>

                <article class="rounded-3xl border border-emerald-100 border-l-8 border-l-emerald-500 bg-white p-6 shadow-md sm:p-8">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <h3 class="text-xl font-black text-slate-900">Ajouter des élèves</h3>
                            <p class="mt-1 text-sm text-slate-600">Attribue chaque élève à une classe existante. L'e-mail et le téléphone sont optionnels.</p>
                        </div>
                        <Badge Accent="emerald">CSV / Excel</Badge>
                    </div>
                    <div class="mt-4 overflow-x-auto rounded-2xl bg-white ring-1 ring-slate-100">
                        <p class="border-b border-slate-100 px-3 py-2 text-xs font-black uppercase tracking-[0.14em] text-slate-500">Exemple dans Excel</p>
                        <table class="w-full text-left text-xs text-slate-700">
                            <thead class="bg-slate-50 font-black text-slate-900">
                                <tr><th class="px-3 py-2 text-rose-600">Prénom *</th><th class="px-3 py-2 text-rose-600">Nom *</th><th class="px-3 py-2 text-rose-600">Classe *</th><th class="px-3 py-2">E-mail</th><th class="px-3 py-2">Téléphone</th><th class="px-3 py-2">E-mail parent</th><th class="px-3 py-2">Téléphone parent</th></tr>
                            </thead>
                            <tbody>
                                <tr class="border-t border-slate-100"><td class="px-3 py-2">Dela</td><td class="px-3 py-2">Mensah</td><td class="px-3 py-2">CM1A</td><td class="px-3 py-2">dela.mensah@famille.tg</td><td class="px-3 py-2">+22898001122</td><td class="px-3 py-2">parent@famille.tg</td><td class="px-3 py-2">+22897001122</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-4 grid gap-3">
                        <label class="group flex cursor-pointer items-center justify-between gap-4 rounded-2xl border border-dashed border-emerald-200 bg-white px-4 py-3 shadow-sm transition hover:border-emerald-400 hover:bg-emerald-50/60 hover:shadow-md @(SelectedKlasseSchoolId is null || isDatabaseActionInProgress ? "pointer-events-none opacity-50" : null)">
                            <span class="flex items-center gap-3">
                                <span class="grid h-11 w-11 place-items-center rounded-2xl bg-emerald-100 text-xl text-emerald-700 transition group-hover:bg-emerald-600 group-hover:text-white"><Icon Name="log" Groesse="16" /> </span>
                                <span>
                                    <span class="block text-sm font-black text-slate-900">Choisir un fichier CSV ou Excel</span>
                                    <span class="block text-xs font-semibold text-slate-500">CSV ou Excel (.xlsx, première feuille) · max. 2 Mo</span>
                                </span>
                            </span>
                            <span class="rounded-full bg-emerald-600 px-4 py-2 text-xs font-bold text-white shadow-sm transition group-hover:bg-emerald-700">Parcourir</span>
                            <InputFile class="sr-only" OnChange="OnStudentImportFileSelectedAsync" accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" disabled="@(SelectedKlasseSchoolId is null || isDatabaseActionInProgress)" />
                        </label>
                        @if (studentImportPreview is not null)
                        {
                            <SchoolUserImportPreviewTable Preview="studentImportPreview" />
                            <AsyncActionButton Class="skoulou-btn-accent rounded-full px-4 py-2 text-sm font-semibold disabled:opacity-50" IsBusy="@isDatabaseActionInProgress" BusyLabel="Import..." OnClick="@(_ => CommitStudentImportAsync())" Disabled="@(!studentImportPreview.Succeeded || studentImportPreview.ValidRowCount == 0)">
                                Importer les élèves (@studentImportPreview.ValidRowCount)
                            </AsyncActionButton>
                        }
                    </div>
                </article>
            </div>
        </ChildContent>
    </CollapsibleCard>
    }

    @if (canViewSharedTeacherContent && IsDirectorTabActive(DirectorTabShared))
    {
        <CollapsibleCard Title="Contenus partagés par les enseignants"
                         Eyebrow="Consultation"
                         Subtitle="Seuls les contenus que leurs auteurs ont explicitement partagés avec la direction sont affichés ici."
                         Icon="book"
                         Accent="violet"
                         Expanded="sharedContentExpanded"
                         ExpandedChanged="value => sharedContentExpanded = value">
            <ChildContent>
                @if (FilteredSharedTeacherContent.Count == 0)
                {
                    <p class="rounded-2xl bg-slate-50 px-4 py-5 text-sm text-slate-600">Aucun contenu partagé pour le moment.</p>
                }
                else
                {
                    <div class="grid gap-3">
                        @foreach (var item in FilteredSharedTeacherContent)
                        {
                            <article class="rounded-2xl border border-slate-200 p-4">
                                <div class="flex flex-wrap items-center gap-2 text-xs font-semibold text-violet-700">
                                    <span class="rounded-full bg-violet-50 px-3 py-1">@item.ContentType</span>
                                    <span>@item.CourseCode</span>
                                </div>
                                <p class="mt-2 font-bold text-slate-900">@item.Title</p>
                                <p class="mt-1 text-sm text-slate-500">@item.AuthorName</p>
                            </article>
                        }
                    </div>
                }
            </ChildContent>
        </CollapsibleCard>
    }
</section>

<div class="mt-8">

<ModalDialog @bind-Open="schoolModalOpen"
             Title="@schoolModalTitle"
             Eyebrow="Mes écoles"
             ErrorMessage="@schoolErrorMessage"
             CloseOnBackdrop="false"
             MaxWidthClass="max-w-xl">
    <EditForm Model="schoolForm" OnValidSubmit="SaveOwnSchoolAsync" FormName="schulleiter-school-form" class="grid gap-4">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div>
            <label class="skoulou-label">Nom de l'école</label>
            <InputText @bind-Value="schoolForm.Name" class="skoulou-input" />
            @if (schoolNameAlreadyExists)
            {
                <p class="mt-1 text-xs font-semibold text-rose-700">Une école avec ce nom existe déjà.</p>
            }
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
            <div><label class="skoulou-label">Ville</label><InputText @bind-Value="schoolForm.City" class="skoulou-input" /></div>
            <ModernDropdown TValue="string"
                            Label="Pays"
                            Value="schoolForm.Country"
                            ValueChanged="SetSchoolCountryAsync"
                            Options="SchoolCountryOptions"
                            Searchable="true"
                            SearchPlaceholder="Rechercher un pays..." />
        </div>
        <div>
            <label class="skoulou-label">Description de l'école (facultatif)</label>
            <RichTextEditor @bind-Value="schoolForm.DescriptionHtml" EnableImages="false" EnableLargeEditor="true" Placeholder="Présente ton établissement..." />
        </div>
        <div class="mt-2 flex justify-end gap-3">
            <button type="button" class="rounded-full bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-700 disabled:cursor-not-allowed disabled:opacity-60" disabled="@isDatabaseActionInProgress" @onclick="() => schoolModalOpen = false">Annuler</button>
            <AsyncActionButton Type="submit" Class="rounded-full bg-cyan-600 px-5 py-2.5 text-sm font-semibold text-white" Disabled="@schoolNameAlreadyExists" IsBusy="@isDatabaseActionInProgress" BusyLabel="Enregistrement...">@schoolModalSubmitLabel</AsyncActionButton>
        </div>
    </EditForm>
</ModalDialog>

<ModalDialog Open="fachDeleteConfirmOpen"
             OpenChanged="OnFachDeleteConfirmOpenChanged"
             Title="Supprimer la matière"
             Eyebrow="Confirmation"
             ErrorMessage="@fachVerwaltungErrorMessage"
             CloseOnBackdrop="false"
             MaxWidthClass="max-w-md">
    <p class="text-sm text-slate-700">Veux-tu vraiment supprimer la matière <strong>@fachToDeleteName</strong> ?</p>
    <p class="mt-2 text-xs text-slate-500">La suppression n'est possible que si la matière n'est attribuée à aucun enseignant.</p>
    <div class="mt-5 flex justify-end gap-2">
        <button type="button"
                class="rounded-full bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-200"
                disabled="@isDatabaseActionInProgress"
                @onclick="() => OnFachDeleteConfirmOpenChanged(false)">
            Annuler
        </button>
        <AsyncActionButton Class="rounded-full bg-rose-600 px-4 py-2 text-sm font-semibold text-white"
                           IsBusy="@isDatabaseActionInProgress"
                           BusyLabel="Suppression..."
                           OnClick="@(_ => ConfirmDeleteSchoolFachAsync())">
            Supprimer
        </AsyncActionButton>
    </div>
</ModalDialog>

<ModalDialog Open="userModalOpen"
             OpenChanged="OnUserModalOpenChanged"
             Title="@userModalTitle"
             Eyebrow="Gestion des utilisateurs"
             ErrorMessage="@userErrorMessage"
             CloseOnBackdrop="false"
             MaxWidthClass="max-w-3xl">
    @if (!string.IsNullOrWhiteSpace(userStatusMessage))
    {
        <div class="sticky top-0 z-20 -mx-1 mb-3 space-y-2 rounded-xl bg-white/95 pb-2 pt-1 backdrop-blur">
            @if (!string.IsNullOrWhiteSpace(userStatusMessage))
            {
                <div class="flex items-start justify-between gap-3 rounded-2xl bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800 ring-1 ring-emerald-100">
                    <span>@userStatusMessage</span>
                    <button type="button" class="shrink-0 rounded-full p-1 text-emerald-700 transition hover:bg-emerald-100" aria-label="Fermer" @onclick="() => userStatusMessage = null">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            }
        </div>
    }

    <EditForm Model="userForm" OnValidSubmit="SaveUserAsync" FormName="schulleiter-user-form" class="grid gap-4">
        <DataAnnotationsValidator />

        <div class="skoulou-modal-sticky-messages">
            <ValidationSummary />
        </div>

        @if (isStudentPersonalEditMode)
        {
            <div class="rounded-2xl border border-cyan-200 bg-cyan-50 px-4 py-3 text-sm text-cyan-900">
                Seules les informations personnelles de l'élève sont modifiables ici.
            </div>
        }
        else
        {
            <div>
                <ModernDropdown TValue="string" Label="Rôle" Value="userForm.RoleName" ValueChanged="SetSchoolUserRoleAsync" Options="SchoolUserRoleOptions" />
            </div>
        }

        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label class="skoulou-label">Prénom</label>
                <InputText @bind-Value="userForm.Vorname" class="skoulou-input" />
            </div>
            <div>
                <label class="skoulou-label">Nom de famille</label>
                <InputText @bind-Value="userForm.Nachname" class="skoulou-input" />
            </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
            <div class="sm:col-span-2">
                <label class="skoulou-label">Identifiant de connexion</label>
                <div class="flex gap-2"><InputText @bind-Value="userForm.Identifiant" autocomplete="off" autocapitalize="none" spellcheck="false" class="skoulou-input min-w-0 flex-1" placeholder="ex. ama.mensah" /><button type="button" class="w-32 shrink-0 rounded-2xl bg-slate-100 px-3 text-xs font-semibold text-slate-700 hover:bg-slate-200 disabled:cursor-not-allowed disabled:opacity-50" disabled="@(!KannIdentifiantVorschlagen)" @onclick="IdentifiantVorschlagenAsync">Proposer</button></div>
                <p class="mt-1 text-xs text-slate-500">Sert à la connexion. Laissé vide, il est proposé automatiquement à partir du prénom et du nom.</p>
            </div>
            <div class="sm:col-span-2">
                <label class="skoulou-label">E-mail <span class="font-normal text-slate-400">@(userForm.RoleName is "SchulLeiter" or "ProduktOwner" or "SuperAdmin" ? "(obligatoire pour ce rôle)" : "(contact, facultatif)")</span></label>
                <InputText @bind-Value="userForm.Email" type="email" class="skoulou-input" />
                <p class="mt-1 text-xs text-slate-500">Pour les messages et « Mot de passe oublié ». Une même adresse peut servir à plusieurs comptes.</p>
            </div>
            <div><label class="skoulou-label">Téléphone <span class="font-normal text-slate-400">(optionnel)</span></label><InputText @bind-Value="userForm.TelefonNummer" type="tel" class="skoulou-input" /></div>
        </div>

        @if (userForm.RoleName == "Schüler")
        {
            <div class="grid gap-4 sm:grid-cols-2"><div><label class="skoulou-label">Téléphone d'un parent <span class="font-normal text-slate-400">(optionnel)</span></label><InputText @bind-Value="userForm.ElternTelefonNummer" type="tel" class="skoulou-input" /></div><div><label class="skoulou-label">E-mail d'un parent <span class="font-normal text-slate-400">(optionnel)</span></label><InputText @bind-Value="userForm.ElternEmail" type="email" class="skoulou-input" /></div></div>
        }

        @if (!isStudentPersonalEditMode)
        {
            <div class="grid gap-4 sm:grid-cols-2">
                @if (userForm.RoleName == "Lehrer")
                {
                    <EtablissementZeile Schulen="schools" />
                    <div class="sm:col-span-2">
                        <label class="skoulou-label">Classes attribuées</label>
                        @if (TeacherClassReferenceFilterOptions.Count > 1)
                        {
                            <div class="mb-3 max-w-sm">
                                <ModernDropdown TValue="string"
                                                Label="Classe de référence"
                                                Value="teacherClassReferenceFilter"
                                                ValueChanged="SetTeacherClassReferenceFilterAsync"
                                                Options="TeacherClassReferenceFilterOptions" />
                            </div>
                        }
                        <div class="grid gap-2 rounded-2xl border border-slate-200 p-3 sm:grid-cols-2">
                            @foreach (var option in FilteredUserFormTeacherClassOptions)
                            {
                                <label class="flex items-center gap-2 text-sm text-slate-700">
                                    <input type="checkbox"
                                           checked="@IsTeacherClassAssigned(option.SchulID, option.KlasseId)"
                                           @onchange="args => SetTeacherClassAssignment(option, args.Value as bool? == true)" />
                                    @GetTeacherClassAssignmentLabel(option)
                                </label>
                            }
                        </div>
                        <p class="mt-1 text-xs text-slate-500">Les classes sélectionnées déterminent les élèves et contenus accessibles à l'enseignant.</p>
                    </div>
                    <div class="sm:col-span-2">
                        <label class="skoulou-label">Matières attribuées</label>
                        @if (UserFormTeacherFachOptions.Count == 0)
                        {
                            <p class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">Aucune matière disponible pour les écoles attribuées. Ajoute d'abord les matières de l'école ci-dessus.</p>
                        }
                        else
                        {
                            <div class="grid gap-2 rounded-2xl border border-slate-200 p-3 sm:grid-cols-2">
                                @foreach (var option in UserFormTeacherFachOptions)
                                {
                                    <label class="flex items-center gap-2 text-sm text-slate-700">
                                        <input type="checkbox"
                                               checked="@IsTeacherFachAssigned(option.FachId)"
                                               @onchange="args => SetTeacherFachAssignment(option.FachId, args.Value as bool? == true)" />
                                        @GetTeacherFachAssignmentLabel(option)
                                    </label>
                                }
                            </div>
                        }
                        <p class="mt-1 text-xs text-slate-500">Ces matières seront proposées à l'enseignant lors de la création de « Leçon + exercices ».</p>
                    </div>
                }
                else if (userForm.RoleName == "Koordinator")
                {
                    <EtablissementZeile Schulen="schools" />
                }
                else
                {
                    @if (HasMultipleSchools)
                    {
                        <div>
                            <ModernDropdown TValue="Guid?" Label="École *" Value="SelectedStudentSchoolId" ValueChanged="SetSelectedStudentSchoolAsync" Options="UserSchoolOptions" />
                            <p class="mt-1 text-xs text-slate-500">@SchoolAssignmentHintText</p>
                        </div>
                    }
                    else
                    {
                        <EtablissementZeile Schulen="schools" />
                    }
                    @if (userForm.RoleName == "Schüler")
                    {
                        <div>
                        @if (SelectedStudentSchoolId == Guid.Empty)
                        {
                            <div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-800">
                                Choisis d'abord l'école pour afficher les classes disponibles.
                            </div>
                        }
                        else
                        {
                            <ModernDropdown TValue="Guid?"
                                           Label="Classe actuelle"
                                           Value="userForm.CurrentKlasseId"
                                           ValueChanged="SetUserCurrentClassAsync"
                                           Options="UserCurrentClassOptions"
                                           Searchable="true"
                                           SearchPlaceholder="Rechercher une classe..." />
                            <p class="mt-1 text-xs text-slate-500">Cette affectation ne crée pas d'abonnement SKOULOUAPP.</p>
                        }
                        </div>
                    }
                }
            </div>
        }

        @if (!isKoordinator && userForm.RoleName == "Koordinator")
        {
            <div class="rounded-2xl border border-cyan-200 bg-cyan-50 p-4 text-sm text-slate-800">
                <h3 class="font-bold">Accès financier du coordinateur</h3>
                <p class="mt-1 text-xs text-slate-600">Les mêmes accès financiers s'appliquent à toutes les écoles sélectionnées lors de l'enregistrement.</p>
                @if (coordinatorFinanceHadDifferentAccess)
                {
                    <p class="mt-2 text-xs text-amber-800">Les droits existants diffèrent selon les écoles. Seuls les accès déjà autorisés partout sont présélectionnés ; vérifie-les avant d'enregistrer.</p>
                }
                @if (userForm.SchoolIds.Count == 0)
                {
                    <p class="mt-3 text-xs text-slate-600">Sélectionne au moins une école pour définir les accès financiers.</p>
                }
                else
                {
                    <label class="mt-3 flex items-center gap-2"><InputCheckbox @bind-Value="coordinatorFinanceMenu" @bind-Value:after="OnCoordinatorFinanceMenuChanged" />Afficher le menu Finances</label>
                    <div class="mt-3 grid gap-2 sm:grid-cols-2">
                        <label class="flex items-center gap-2"><InputCheckbox @bind-Value="coordinatorFinanceDashboard" disabled="@(!coordinatorFinanceMenu)" />Finances de l'école</label>
                        <label class="flex items-center gap-2"><InputCheckbox @bind-Value="coordinatorFinanceEntries" disabled="@(!coordinatorFinanceMenu)" />Nouvelle écriture</label>
                        <label class="flex items-center gap-2"><InputCheckbox @bind-Value="coordinatorFinanceCycles" disabled="@(!coordinatorFinanceMenu)" />Paiements des cycles</label>
                        <label class="flex items-center gap-2"><InputCheckbox @bind-Value="coordinatorFinanceBilling" disabled="@(!coordinatorFinanceMenu)" />Facturation SKOULOUAPP</label>
                    </div>
                    @if (!coordinatorFinanceMenu || !coordinatorFinanceCycles)
                    {
                        <p class="mt-3 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-semibold leading-5 text-amber-900">Sans « Paiements des cycles », ce coordinateur ne pourra ni démarrer ni clôturer un cycle, ni enregistrer les paiements des frais scolaires (y compris les acomptes et les versements échelonnés). Ces actions resteront réservées au directeur ou à un coordinateur autorisé.</p>
                    }
                    <p class="mt-3 text-xs text-slate-600">Les accès de toutes les écoles sélectionnées seront enregistrés avec l'utilisateur.</p>
                    @if (!string.IsNullOrWhiteSpace(userErrorMessage)) { <p class="mt-2 text-xs text-rose-700">@userErrorMessage</p> }
                    @if (!string.IsNullOrWhiteSpace(userStatusMessage)) { <p class="mt-2 text-xs text-emerald-700">@userStatusMessage</p> }
                }
            </div>
        }

        @if (!userForm.UserId.HasValue)
        {
            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <label class="skoulou-label">Mot de passe (optionnel)</label>
                    <PasswordInput @bind-Value="userForm.Password" Autocomplete="new-password" />
                    <p class="mt-1 text-xs text-slate-500">Si vide, un mot de passe individuel sécurisé sera affiché après la création pour transmission confidentielle.</p>
                    <p class="mt-1 text-xs text-slate-500">Le mot de passe doit contenir au moins 6 caractères, dont au moins 1 chiffre et 1 lettre minuscule.</p>
                </div>
                <div>
                    <label class="skoulou-label">Confirmer le mot de passe</label>
                    <PasswordInput @bind-Value="userForm.PasswordConfirmation" Autocomplete="new-password" />
                    <ValidationMessage For="() => userForm.PasswordConfirmation" class="mt-1 text-xs text-rose-600" />
                </div>
            </div>
        }

        @if (userForm.RoleName == "Lehrer")
        {
            <label class="inline-flex items-center gap-2 text-sm font-semibold text-slate-700">
                <InputCheckbox @bind-Value="userForm.IsBlocked" class="h-4 w-4 rounded border-slate-300" />
                Compte bloqué
            </label>
        }

        <div class="mt-2 flex justify-end gap-3">
            <button type="button" class="rounded-full bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-200 disabled:cursor-not-allowed disabled:opacity-60" disabled="@isDatabaseActionInProgress" @onclick="() => OnUserModalOpenChanged(false)">Annuler</button>
            <AsyncActionButton Type="submit" Class="rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-lg disabled:opacity-50" IsBusy="@isDatabaseActionInProgress" BusyLabel="Enregistrement...">@(userForm.UserId.HasValue ? "Enregistrer l'utilisateur" : "Créer l'utilisateur")</AsyncActionButton>
        </div>
    </EditForm>
</ModalDialog>

<ModalDialog @bind-Open="aboModalOpen"
              Title="Gérer l'abonnement"
              Eyebrow="@($"{pendingAboStudentName} · {pendingLevelCode}")"
              ErrorMessage="@errorMessage"
              CloseOnBackdrop="false"
              MaxWidthClass="max-w-lg">
    @if (pendingAboTyp is null)
    {
        <div class="grid gap-3">
                <div class="rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
                    Attention : après attribution, cet abonnement est définitif pour la direction et ne peut plus être annulé ni modifié.
                    Seul l'Administrateur peut intervenir après clarification avec la direction.
                </div>
            <button type="button" class="rounded-2xl border border-cyan-200 bg-cyan-50 p-4 text-left transition hover:border-cyan-500 hover:bg-cyan-100" @onclick="() => SelectAboTyp(AboTyp.SkoulouApp)">
                <span class="flex items-center justify-between gap-3 font-bold text-cyan-950"><span>SKOULOUAPP</span><span>@PendingAboPreis?.ToString("N0") FCFA</span></span>
                <span class="mt-1 block text-sm text-cyan-800">Abonnement unique pour l'accès aux contenus et évaluations de la classe.</span>
            </button>
        </div>
    }
    else
    {
        <div class="rounded-2xl bg-cyan-50 p-4 text-sm leading-6 text-cyan-950">
            <div class="mb-3 rounded-xl bg-white/80 px-4 py-3 ring-1 ring-white/70">
                <p class="text-xs font-bold uppercase tracking-[0.16em] opacity-70">Prix de l'abonnement</p>
                <p class="mt-1 text-2xl font-black">@PendingAboPreis?.ToString("N0") FCFA</p>
                <p class="mt-1 text-xs opacity-75">Prix spécifique à l'école de l'élève s'il existe, sinon prix général admin. Cette action valide directement l'abonnement comme payé.</p>
            </div>
            <p>L'abonnement est activé et marqué payé en un seul enregistrement.</p>
        </div>
    }
    <div class="mt-6 flex justify-end gap-3">
        <button type="button" class="rounded-full bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-200 disabled:cursor-not-allowed disabled:opacity-60" disabled="@isDatabaseActionInProgress" @onclick="() => aboModalOpen = false">Annuler</button>
        <AsyncActionButton Class="skoulou-btn-accent rounded-full px-5 py-2.5 text-sm font-semibold disabled:opacity-50"
                           IsBusy="@isDatabaseActionInProgress"
                           BusyLabel="Enregistrement..."
                           Disabled="@(pendingAboTyp is null)"
                           OnClick="@(_ => ConfirmAboAsync())">
            Enregistrer comme payé
        </AsyncActionButton>
    </div>
</ModalDialog>

<ModalDialog Open="zuordnungModalOpen"
             OpenChanged="OnZuordnungModalOpenChanged"
             Title="@($"Classes de {zuordnungLehrerName}")"
             Eyebrow="Affectation des classes"
             ErrorMessage="@userErrorMessage"
             CloseOnBackdrop="false"
             MaxWidthClass="max-w-2xl">
    <p class="text-sm leading-6 text-slate-600">
        Sélectionne les classes que cet enseignant peut gérer dans chaque école et indique ses heures hebdomadaires.
        Sans classe attribuée, l'enseignant ne voit aucun élève.
    </p>

    @if (zuordnungItems.Count == 0)
    {
        <p class="mt-6 text-sm text-slate-600">Aucune école ou aucune classe disponible pour cet enseignant.</p>
    }
    else
    {
        <div class="mt-6 grid gap-6">
            @foreach (var gruppe in zuordnungItems.GroupBy(z => z.SchulName))
            {
                <div class="rounded-3xl border border-slate-200 p-5">
                    <h3 class="text-base font-bold text-slate-900">@gruppe.Key</h3>
                    <div class="mt-3 grid gap-2 sm:grid-cols-2">
                        @foreach (var item in gruppe)
                        {
                            <div class="flex items-center gap-2 text-sm font-medium text-slate-700">
                                <input type="checkbox" class="h-4 w-4 rounded border-slate-300"
                                       checked="@item.IstZugeordnet"
                                       @onchange="e => item.IstZugeordnet = (bool)(e.Value ?? false)" />
                                <span>@item.NiveauCode<span class="text-slate-400"> · @item.NiveauTitel</span></span>
                                @if (item.IstZugeordnet)
                                {
                                    <InputNumber @bind-Value="item.Wochenstunden" min="1" step="0.5" class="skoulou-input ml-auto w-20 text-right" />
                                    <span class="text-xs text-slate-500">h/semaine</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <div class="mt-6 flex justify-end gap-3">
        <button type="button" class="rounded-full bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-200 disabled:cursor-not-allowed disabled:opacity-60" disabled="@isDatabaseActionInProgress" @onclick="() => OnZuordnungModalOpenChanged(false)">Annuler</button>
        <AsyncActionButton Class="rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-lg" IsBusy="@isDatabaseActionInProgress" BusyLabel="Enregistrement..." OnClick="@(_ => SaveZuordnungenAsync())">Enregistrer les classes</AsyncActionButton>
    </div>
</ModalDialog>

<ModalDialog Open="klasseModalOpen"
             OpenChanged="OnKlasseModalOpenChanged"
               Title="@(klasseForm.CourseId.HasValue ? "Modifier la classe" : "Nouvelle classe")"
               Eyebrow="Gestion des classes"
             ErrorMessage="@klasseErrorMessage"
             CloseOnBackdrop="false"
             MaxWidthClass="max-w-2xl">
    @if (!string.IsNullOrWhiteSpace(klasseErrorMessage) || !string.IsNullOrWhiteSpace(klasseStatusMessage) || !string.IsNullOrWhiteSpace(klasseWarnMessage))
    {
        <div class="sticky top-0 z-20 -mx-1 mb-3 space-y-2 rounded-xl bg-white/95 pb-2 pt-1 backdrop-blur">
            @if (!string.IsNullOrWhiteSpace(klasseStatusMessage))
            {
                <div class="rounded-2xl bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800 ring-1 ring-emerald-100">@klasseStatusMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(klasseWarnMessage))
            {
                <div class="rounded-2xl bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-800 ring-1 ring-amber-100">@klasseWarnMessage</div>
            }
        </div>
    }

    <EditForm Model="klasseForm" OnValidSubmit="SaveKlasseAsync" FormName="schulleiter-klasse-form" class="grid gap-4">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div>
            <ModernDropdown TValue="Guid?" Label="École *" Value="klasseForm.SchoolId" ValueChanged="SetKlasseSchoolAsync" Options="KlasseSchoolOptions" Disabled="@klasseForm.CourseId.HasValue" />
            <p class="mt-1 text-xs text-slate-500">L'école est obligatoire pour créer une classe.</p>
        </div>

        <div>
            <label class="skoulou-label">Nom de la classe</label>
            <InputText @bind-Value="klasseForm.Title" placeholder="Ex. : CP1A" class="skoulou-input" />
            <ValidationMessage For="() => klasseForm.Title" class="mt-1 text-xs text-rose-600" />
        </div>

        <div>
            <ModernDropdown TValue="Guid?" Label="Nom de référence" Value="klasseForm.KlassenStufeId" ValueChanged="SetKlassenStufeAsync" Options="KlassenStufeOptions" Disabled="@(!string.IsNullOrWhiteSpace(klasseForm.NeueKlassenStufe))" />
            <p class="mt-2 text-xs text-slate-500">Choisis un nom de référence existant ou crée-en un nouveau ci-dessous. Exemples : CP1, CP2, CE1, CE2, CM1, CM2.</p>
            <input type="text" @bind="klasseForm.NeueKlassenStufe" placeholder="Nouveau nom de référence, ex. CP1" class="skoulou-input mt-2 text-sm" />
            <ValidationMessage For="() => klasseForm.NeueKlassenStufe" class="mt-1 text-xs text-rose-600" />
        </div>

        <div>
            <label class="skoulou-label">Description</label>
            <InputTextArea @bind-Value="klasseForm.Description" rows="3" class="skoulou-input" />
            <ValidationMessage For="() => klasseForm.Description" class="mt-1 text-xs text-rose-600" />
        </div>

        <div>
            <label class="skoulou-label">Prix (FCFA)</label>
            <InputNumber @bind-Value="klasseForm.Price" class="skoulou-input" />
            <ValidationMessage For="() => klasseForm.Price" class="mt-1 text-xs text-rose-600" />
            @if (klasseForm.SchoolId is Guid klasseSchoolId)
            {
                var selectedSchool = schools.FirstOrDefault(s => s.SchoolId == klasseSchoolId);
                if (selectedSchool is not null)
                {
                    <p class="mt-1 text-xs text-cyan-700">Prix d'abonnement affich&eacute; pour cette &eacute;cole : <strong>@selectedSchool.EffectiveSubscriptionPrice.ToString("N0") FCFA</strong></p>
                    <p class="mt-1 text-xs text-cyan-700">Part direction : <strong>@Math.Round(selectedSchool.EffectiveSubscriptionPrice * selectedSchool.SchoolLeaderCommissionPercent / 100m, 0, MidpointRounding.AwayFromZero).ToString("N0") FCFA</strong> (@selectedSchool.SchoolLeaderCommissionPercent.ToString("N2") %)</p>
                    <p class="mt-1 text-xs text-cyan-700">Part enseignants : <strong>@Math.Round(selectedSchool.EffectiveSubscriptionPrice * selectedSchool.TeacherCommissionPercent / 100m, 0, MidpointRounding.AwayFromZero).ToString("N0") FCFA</strong> (@selectedSchool.TeacherCommissionPercent.ToString("N2") %)</p>
                }
            }
        </div>

        <div>
            <label class="skoulou-label">Capacité optimale (places)</label>
            <InputNumber @bind-Value="klasseForm.MaxPlaetze" class="skoulou-input" />
            <ValidationMessage For="() => klasseForm.MaxPlaetze" class="mt-1 text-xs text-rose-600" />
            <p class="mt-1 text-xs text-slate-500">Optionnel. L'application autorise la sur-occupation, mais affiche un avertissement clair dans la liste des classes.</p>
            @if (klasseForm.CourseId.HasValue)
            {
                <p class="mt-1 text-xs font-semibold text-slate-700">Occupation actuelle : @klasseForm.CurrentStudentCount élève(s)</p>
            }
        </div>

        <p class="rounded-2xl bg-cyan-50 px-4 py-3 text-sm text-cyan-900">
            Les élèves admis accèdent à l'application sans activation individuelle ni paiement préalable.
            Chaque nouveau cycle enregistre automatiquement ses participants et génère la facture de l'école à sa clôture.
            Cette inscription ne constitue pas un paiement.
        </p>

        <div class="mt-2 flex justify-end gap-3">
            <button type="button" class="rounded-full bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-200 disabled:cursor-not-allowed disabled:opacity-60" disabled="@isDatabaseActionInProgress" @onclick="() => OnKlasseModalOpenChanged(false)">Annuler</button>
            <AsyncActionButton Type="submit" Class="skoulou-btn-accent rounded-full px-5 py-3 text-sm font-semibold transition duration-200 hover:-translate-y-0.5 hover:shadow-lg disabled:opacity-50" IsBusy="@isDatabaseActionInProgress" BusyLabel="Enregistrement...">@(klasseForm.CourseId.HasValue ? "Enregistrer la classe" : "Créer la classe")</AsyncActionButton>
        </div>
    </EditForm>
</ModalDialog>

<ModalDialog Open="autoAssignConfirmOpen"
             OpenChanged="OnAutoAssignConfirmOpenChanged"
             Title="Confirmer l'activation automatique"
             Eyebrow="Confirmation"
             CloseOnBackdrop="false"
             MaxWidthClass="max-w-lg">
    <p class="text-sm leading-6 text-slate-700">
        Ce cycle est actif. Si tu continues, tous les élèves actuellement attribués à cette classe recevront immédiatement l'abonnement SKOULOUAPP.
    </p>
    <p class="mt-3 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-800">
        Cette action n'est plus réversible pendant ce cycle. Le retour en arrière sera possible seulement après ouverture d'un nouveau cycle.
    </p>
    <div class="mt-5 flex justify-end gap-3">
        <button type="button"
                class="rounded-full bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-200 disabled:cursor-not-allowed disabled:opacity-60"
                disabled="@isDatabaseActionInProgress"
                @onclick="() => OnAutoAssignConfirmOpenChanged(false)">
            Annuler
        </button>
        <AsyncActionButton Class="rounded-full bg-rose-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-rose-700"
                           IsBusy="@isDatabaseActionInProgress"
                           BusyLabel="Activation..."
                           OnClick="@(_ => ConfirmAutoAssignActivationAsync())">
            Oui, activer maintenant
        </AsyncActionButton>
    </div>
</ModalDialog>



<ModalDialog @bind-Open="durchlaufStartModalOpen"
             Title="Démarrer le cycle"
             Eyebrow="Cycle de classe"
             ErrorMessage="@klasseErrorMessage"
             CloseOnBackdrop="false"
             MaxWidthClass="max-w-lg">
    @if (startKlasse is not null)
    {
        <p class="text-sm leading-6 text-slate-600">Démarre un nouveau cycle pour <span class="font-semibold text-slate-900">@startKlasse.Title</span>. La date de fin sera définie lorsque le cycle sera réellement clôturé.</p>
        @if (durchlaufStartDurchUeberweisungGesperrt)
        {
            <p class="mt-4 rounded-xl bg-amber-50 p-4 text-sm text-amber-900">Déclare d'abord le virement de la facturation du cycle précédent dans <a class="font-bold underline" href="/abrechnung">Facturation SKOULOUAPP</a>. La confirmation bancaire de l'Administrateur n'est pas nécessaire pour démarrer.</p>
        }
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
            <div>
                <label class="skoulou-label">Prix du cycle (FCFA)</label>
                <InputNumber @bind-Value="durchlaufPreis" class="skoulou-input" />
            </div>
            <div>
                <label class="skoulou-label">Date de début</label>
                <TailwindDateTimePicker Value="durchlaufStartDatum" ValueChanged="SetDurchlaufStartDatumAsync" ShowTime="false" />
            </div>
        </div>
        <div class="mt-6 flex justify-end gap-3">
            <button type="button" class="rounded-full bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-200" @onclick="() => durchlaufStartModalOpen = false">Annuler</button>
            <button type="button" class="rounded-full bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:bg-slate-300" disabled="@(isDatabaseActionInProgress || durchlaufStartDurchUeberweisungGesperrt)" @onclick="StartDurchlaufAsync">Démarrer</button>
        </div>
    }
</ModalDialog>

<AbschlussNotenDialog @bind-Open="abschlussNotenOpen" DurchlaufId="abschlussNotenDurchlaufId" BearbeiterId="currentUserId" />

<ModalDialog @bind-Open="durchlaufEndeModalOpen"
             Title="Clôturer le cycle"
             Eyebrow="Cycle de classe"
             CloseOnBackdrop="false"
             MaxWidthClass="max-w-lg">
    @if (zuBeendenderDurchlauf is not null)
    {
        <div class="grid gap-3 sm:grid-cols-2">
            <div class="flex items-start gap-3 rounded-2xl border-2 p-3 shadow-sm @(zuBeendenderDurchlauf.SummeOffen > 0 ? "border-rose-300 bg-rose-50 text-rose-900" : "border-emerald-200 bg-emerald-50 text-emerald-900")">
                <span class="text-xl" aria-hidden="true"><Icon Name="@(zuBeendenderDurchlauf.SummeOffen > 0 ? "wallet" : "check")" /></span>
                <div>
                    <p class="text-[11px] font-bold uppercase tracking-wide @(zuBeendenderDurchlauf.SummeOffen > 0 ? "text-rose-700" : "text-emerald-700")">Frais de scolarité impayés</p>
                    @if (zuBeendenderDurchlauf.SummeOffen > 0)
                    {
                        <p class="text-xl font-black text-rose-700">@zuBeendenderDurchlauf.SummeOffen.ToString("N0") FCFA</p>
                        <p class="mt-1 text-xs font-medium">Ce montant sera signalé comme perte dans le rapport financier.</p>
                    }
                    else
                    {
                        <p class="text-base font-black">Tout est payé</p>
                    }
                </div>
            </div>
            <div class="flex items-start gap-3 rounded-2xl border-2 p-3 shadow-sm @(beendenOhneNote > 0 ? "border-amber-300 bg-amber-50 text-amber-900" : "border-emerald-200 bg-emerald-50 text-emerald-900")">
                <span class="text-xl" aria-hidden="true"><Icon Name="@(beendenOhneNote > 0 ? "pen" : "check")" /></span>
                <div>
                    <p class="text-[11px] font-bold uppercase tracking-wide @(beendenOhneNote > 0 ? "text-amber-700" : "text-emerald-700")">Notes finales</p>
                    @if (beendenOhneNote > 0)
                    {
                        <p class="text-xl font-black text-amber-700">@beendenOhneNote / @beendenTeilnehmerGesamt <span class="text-sm font-bold">non définies</span></p>
                        <p class="mt-1 text-xs font-medium">Information : tu peux clôturer sans les définir. Ces résultats resteront non renseignés après la clôture.</p>
                    }
                    else
                    {
                        <p class="text-base font-black">Toutes les notes sont définies</p>
                    }
                </div>
            </div>
        </div>
        <div class="mt-3 rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm leading-6 text-slate-700">
            <p class="flex items-center gap-2 text-base font-bold text-slate-900"><span aria-hidden="true"><Icon Name="alert" Groesse="16" /> </span>Clôture définitive du cycle de classe</p>
            <p class="mt-2">La clôture n'effectue aucune promotion automatique. Après réouverture d'une classe, le remplissage des élèves se fait manuellement par le directeur ou le coordinateur.</p>
            <p class="mt-2 font-semibold">Les notes finales et décisions déjà enregistrées seront conservées. Les résultats manquants ne bloquent pas la clôture. Pour les nouveaux cycles, les élèves restent dans leur classe et conservent l'accès aux supports publiés ; la promotion est une opération distincte. Les anciens cycles conservent leur traitement historique.</p>
            <p class="mt-2">Pour les nouveaux cycles, la clôture par la direction ou un coordinateur autorisé crée automatiquement la facture de toutes les participations enregistrées, au tarif fixé au démarrage. Aucun paiement individuel SKOULOUAPP n'est demandé. Déclare ensuite le virement dans Facturation SKOULOUAPP ; le paiement de l'école ne conditionne pas l'accès des élèves ni le démarrage du cycle suivant.</p>
        </div>
        <div class="mt-5">
            <label class="skoulou-label">Date de fin effective</label>
            <TailwindDateTimePicker Value="durchlaufEndDatum" ValueChanged="SetDurchlaufEndDatumAsync" ShowTime="false" />
        </div>
        <div class="mt-6 flex flex-col-reverse gap-3 border-t border-slate-100 pt-4 md:flex-row md:flex-wrap md:justify-end">
            <button type="button" class="w-full whitespace-nowrap rounded-full bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-200 md:w-auto" @onclick="() => durchlaufEndeModalOpen = false">Annuler</button>
            <AsyncActionButton Class="w-full whitespace-nowrap rounded-full bg-rose-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-rose-700 md:w-auto" IsBusy="@isDatabaseActionInProgress" BusyLabel="Clôture..." OnClick="@(_ => BeendeDurchlaufAsync())">Confirmer la clôture</AsyncActionButton>
        </div>
    }
</ModalDialog>

<ModalDialog @bind-Open="durchlaufEndeEndgueltigModalOpen"
             Title="Confirmer la clôture définitive"
             Eyebrow="Dernière confirmation"
             CloseOnBackdrop="false"
             MaxWidthClass="max-w-md"
             ZIndexClass="z-[2300]">
    <div class="rounded-2xl border border-rose-200 bg-rose-50 p-4 text-sm leading-6 text-rose-950">
        <p class="font-black">Cette action est définitive.</p>
        <p class="mt-2">Le cycle sera clôturé et tous les élèves quitteront la classe active.</p>
        @if (beendenOhneNote > 0)
        {
            <p class="mt-2 font-semibold">@beendenOhneNote élève(s) n'ont pas encore de note finale ou de décision complète. Ces informations resteront non renseignées.</p>
        }
        @if (zuBeendenderDurchlauf?.SummeOffen > 0)
        {
            <p class="mt-2 font-semibold">La dette restante de @zuBeendenderDurchlauf.SummeOffen.ToString("N0") FCFA sera enregistrée comme perte.</p>
        }
    </div>
    <div class="mt-5 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <button type="button" class="rounded-full bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-200" @onclick="() => durchlaufEndeEndgueltigModalOpen = false">Retour</button>
        <AsyncActionButton Class="rounded-full bg-rose-700 px-5 py-2.5 text-sm font-semibold text-white hover:bg-rose-800"
                           IsBusy="@isDatabaseActionInProgress"
                           BusyLabel="Clôture..."
                           OnClick="@(_ => BeendeDurchlaufEndgueltigAsync())">
            Clôturer définitivement
        </AsyncActionButton>
    </div>
</ModalDialog>

<ModalDialog @bind-Open="zahlungModalOpen"
             Title="Enregistrer un paiement"
             Eyebrow="@zahlungDurchlauf?.NiveauCode"
             CloseOnBackdrop="false"
             MaxWidthClass="max-w-4xl">
    @if (zahlungDurchlauf is not null)
    {
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
            <div>
                <label class="skoulou-label">Rechercher un élève</label>
                <input type="search"
                       @bind="zahlungSchuelerSuche"
                       placeholder="Nom de l'élève..."
                       class="skoulou-input" />

                <div class="mt-3 max-h-80 overflow-y-auto rounded-2xl border border-slate-200 p-2">
                    @if (GefilterteZahlungsSchueler.Count == 0)
                    {
                        <p class="p-4 text-sm text-slate-500">Aucun élève trouvé.</p>
                    }
                    else
                    {
                        @foreach (var schueler in GefilterteZahlungsSchueler)
                        {
                            <button type="button"
                                    class="flex w-full items-center justify-between gap-3 rounded-xl px-4 py-3 text-left transition @(zahlungStudentId == schueler.StudentId ? "bg-cyan-600 text-white" : "hover:bg-slate-50")"
                                    @onclick="() => WaehleZahlungSchueler(schueler.StudentId)">
                                <span class="font-semibold">@schueler.Name</span>
                                <span class="text-xs @(zahlungStudentId == schueler.StudentId ? "text-cyan-100" : "text-slate-500")">Ouvert : @schueler.Offen.ToString("N0") FCFA</span>
                            </button>
                        }
                    }
                </div>
            </div>

            <div class="rounded-2xl bg-slate-50 p-4 ring-1 ring-slate-100">
                <div>
                    <ModernDropdown TValue="ZahlungsArt?" Label="Type de paiement" Value="zahlungsArt" ValueChanged="SetZahlungsArtAsync" Options="ZahlungsArtOptions" />
                </div>
                <div class="mt-4">
                    <label class="skoulou-label">Montant (FCFA)</label>
                    <InputNumber @bind-Value="zahlungBetrag" disabled="@IstBarzahlung" class="skoulou-input" />
                    @if (IstBarzahlung)
                    {
                        <p class="mt-2 text-xs leading-5 text-slate-500">Le paiement cash correspond obligatoirement au prix fixé du cycle : <strong>@zahlungDurchlauf.NiveauPreis.ToString("N0") FCFA</strong>.</p>
                    }
                </div>
                <div class="mt-4">
                    <label class="skoulou-label">Date d'effet</label>
                    <TailwindDateTimePicker Value="zahlungWirkungsdatum" ValueChanged="SetZahlungWirkungsdatumAsync" ShowTime="false" />
                </div>
            </div>
        </div>
        <div class="mt-6 flex justify-end gap-3">
            <button type="button" class="rounded-full bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-200" @onclick="() => zahlungModalOpen = false">Annuler</button>
            <AsyncActionButton Class="rounded-full bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-700" IsBusy="@isDatabaseActionInProgress" BusyLabel="Enregistrement..." OnClick="@(_ => ZahlungBuchenAsync())">Enregistrer</AsyncActionButton>
        </div>
    }
</ModalDialog>

</div>
