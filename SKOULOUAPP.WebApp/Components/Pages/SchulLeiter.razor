                                <tr><th class="px-3 py-2">Prénom <span class="text-rose-600">*</span></th><th class="px-3 py-2">Nom <span class="text-rose-600">*</span></th><th class="px-3 py-2">Classe <span class="text-rose-600">*</span></th><th class="px-3 py-2">E-mail</th><th class="px-3 py-2">Téléphone</th></tr>
                            </thead>
                            <tbody>
                                <tr class="border-t border-slate-100"><td class="px-3 py-2">Afi</td><td class="px-3 py-2">Kodjo</td><td class="px-3 py-2">CM2A, CM2B</td><td class="px-3 py-2">afi.kodjo@ecole.tg</td><td class="px-3 py-2">+22890112233</td></tr>
                            </tbody>
