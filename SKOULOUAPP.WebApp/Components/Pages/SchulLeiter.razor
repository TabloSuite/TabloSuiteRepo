                    <div class="mt-3 grid gap-3">
                        <label class="m-0 flex cursor-pointer flex-wrap items-center justify-between gap-3 rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-3 transition hover:border-blue-300 hover:bg-blue-50/50 @(SelectedKlasseSchoolId is null || isDatabaseActionInProgress ? "pointer-events-none opacity-50" : null)">
                            <span class="flex items-center gap-3">
                                <span class="grid h-10 w-10 place-items-center rounded-xl bg-white text-blue-700 ring-1 ring-slate-200"><Icon Name="upload" Groesse="18" /></span>
                                <span>
                                    <span class="block text-sm font-bold text-slate-900">Choisir le fichier des enseignants</span>
                                    <span class="block text-xs text-slate-500">.csv ou .xlsx (première feuille) · max. 2 Mo</span>
                                </span>
                            </span>
                            <span class="sk-btn sk-btn-sm sk-btn-primary">Parcourir</span>
                            <InputFile class="sr-only" OnChange="OnTeacherImportFileSelectedAsync" accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" disabled="@(SelectedKlasseSchoolId is null || isDatabaseActionInProgress)" />
