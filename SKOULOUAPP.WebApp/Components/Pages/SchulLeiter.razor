                    </div>
                </article>

                <article class="rounded-2xl border border-slate-200 p-4 sm:p-5">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div>
                            <h3 class="mb-0 flex items-center gap-2 text-base font-bold text-slate-900"><Icon Name="graduation" Groesse="18" />Élèves</h3>
                            <p class="mb-0 mt-1 text-sm text-slate-600">Chaque élève rejoint une classe existante. E-mail et téléphone sont facultatifs.</p>
                        </div>
                        <Badge Accent="slate">CSV / Excel</Badge>
                    </div>
                    <div class="mt-3 overflow-x-auto rounded-xl border border-slate-200">
                        <table class="w-full text-left text-xs text-slate-700">
                            <thead class="bg-slate-50 font-bold text-slate-900">
                                <tr><th class="px-3 py-2">Prénom <span class="text-rose-600">*</span></th><th class="px-3 py-2">Nom <span class="text-rose-600">*</span></th><th class="px-3 py-2">Classe <span class="text-rose-600">*</span></th><th class="px-3 py-2">E-mail</th><th class="px-3 py-2">Téléphone</th><th class="px-3 py-2">E-mail parent</th><th class="px-3 py-2">Téléphone parent</th></tr>
                            </thead>
                            <tbody>
                                <tr class="border-t border-slate-100"><td class="px-3 py-2">Dela</td><td class="px-3 py-2">Mensah</td><td class="px-3 py-2">CM1A</td><td class="px-3 py-2">dela.mensah@famille.tg</td><td class="px-3 py-2">+22898001122</td><td class="px-3 py-2">parent@famille.tg</td><td class="px-3 py-2">+22897001122</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-3 grid gap-3">
                        <label class="m-0 flex cursor-pointer flex-wrap items-center justify-between gap-3 rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-3 transition hover:border-blue-300 hover:bg-blue-50/50 @(SelectedKlasseSchoolId is null || isDatabaseActionInProgress ? "pointer-events-none opacity-50" : null)">
                            <span class="flex items-center gap-3">
                                <span class="grid h-10 w-10 place-items-center rounded-xl bg-white text-blue-700 ring-1 ring-slate-200"><Icon Name="upload" Groesse="18" /></span>
                                <span>
                                    <span class="block text-sm font-bold text-slate-900">Choisir le fichier des élèves</span>
                                    <span class="block text-xs text-slate-500">.csv ou .xlsx (première feuille) · max. 2 Mo</span>
                                </span>
                            </span>
                            <span class="sk-btn sk-btn-sm sk-btn-primary">Parcourir</span>
                            <InputFile class="sr-only" OnChange="OnStudentImportFileSelectedAsync" accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" disabled="@(SelectedKlasseSchoolId is null || isDatabaseActionInProgress)" />
                        </label>
                        @if (studentImportPreview is not null)
                        {
                            <SchoolUserImportPreviewTable Preview="studentImportPreview" />
                            <AsyncActionButton Class="sk-btn sk-btn-primary justify-self-start" IsBusy="@isDatabaseActionInProgress" BusyLabel="Import..." OnClick="@(_ => CommitStudentImportAsync())" Disabled="@(!studentImportPreview.Succeeded || studentImportPreview.ValidRowCount == 0)">
                                Importer les élèves (@studentImportPreview.ValidRowCount)
                            </AsyncActionButton>
                        }
                    </div>
                </article>
            </div>
        </Abschnitt>
    }

    @if (canViewSharedTeacherContent && IsDirectorTabActive(DirectorTabShared))
    {
        <Abschnitt Titel="Contenus partagés" Untertitel="Seuls les contenus que leurs auteurs ont explicitement partagés avec la direction apparaissent ici." IconName="book-open">
            @if (FilteredSharedTeacherContent.Count == 0)
            {
                <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 px-5 py-8 text-center text-sm text-slate-500">Aucun contenu partagé pour le moment.</div>
            }
            else
            {
                <ul class="m-0 grid list-none gap-2 p-0 sm:grid-cols-2">
                    @foreach (var item in FilteredSharedTeacherContent)
                    {
                        <li class="rounded-2xl border border-slate-200 bg-white p-4">
                            <div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
                                <span class="rounded-full bg-blue-50 px-2.5 py-1 text-blue-800">@item.ContentType</span>
                                <span class="text-slate-500">@item.CourseCode</span>
                            </div>
                            <p class="mb-0 mt-2 font-bold text-slate-900">@item.Title</p>
                            <p class="mb-0 mt-0.5 text-sm text-slate-500">@item.AuthorName</p>
