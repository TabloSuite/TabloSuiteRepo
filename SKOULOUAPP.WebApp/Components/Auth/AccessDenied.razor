@page "/access-denied"

<PageTitle>Accès refusé</PageTitle>

<section class="rounded-[2rem] bg-white p-8 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-rose-700">Autorisation</p>
    <h1 class="mt-3 text-3xl font-black text-slate-900">Accès refusé</h1>
    <p class="mt-4 max-w-2xl text-sm leading-7 text-slate-600">Vous n'avez pas l'autorisation d'accéder à cette zone. Connectez-vous avec un compte approprié ou contactez l'Administrateur.</p>
    <div class="mt-6 flex flex-wrap gap-3">
        <a class="sk-btn sk-btn-primary" href="/auth/login">Aller à la connexion</a>
        <a class="sk-btn sk-btn-secondary" href="/">Retour à l'accueil</a>
    </div>
</section>
