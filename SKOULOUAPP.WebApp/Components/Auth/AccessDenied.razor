@page "/access-denied"

<PageTitle>Accès refusé</PageTitle>

<section class="rounded-[2rem] bg-white p-8 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-rose-700">Autorisation</p>
    <h1 class="mt-3 text-3xl font-black text-slate-900">Accès refusé</h1>
    <p class="mt-4 max-w-2xl text-sm leading-7 text-slate-600">Tu n'as pas l'autorisation d'accéder à cette zone. Connecte-toi avec un compte approprié ou contacte l'Administrateur.</p>
    <div class="mt-6 flex flex-wrap gap-3">
        <a class="rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white no-underline" href="/auth/login">Aller à la connexion</a>
        <a class="rounded-full bg-slate-100 px-5 py-3 text-sm font-semibold text-slate-900 no-underline" href="/">Retour à l'accueil</a>
    </div>
</section>
