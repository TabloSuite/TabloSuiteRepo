@using System.Security.Claims
@using SkoulouApp.Core.DataModels.Identity

@if (showTermsModal)
{
    <ModalDialog Open="true" Title="Conditions d'utilisation" Eyebrow="Confirmation requise" ErrorMessage="@termsErrorMessage" MaxWidthClass="max-w-5xl" CloseOnBackdrop="false">
        <div class="space-y-6">
            <div class="rounded-3xl border border-sky-100 bg-gradient-to-br from-sky-50 via-white to-indigo-50 p-5 shadow-sm">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div>
                        <p class="text-xs font-bold uppercase tracking-[0.16em] text-sky-700">Avant d'accéder à SKOULOU Campus</p>
                        <h3 class="mt-1 text-xl font-black text-slate-900">Validez les règles de votre espace</h3>
                    </div>
                    <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-slate-600 ring-1 ring-slate-200">Version @AuthService.CurrentTermsVersion</span>
                </div>
                <p class="mt-3 text-sm leading-6 text-slate-700">Votre compte a été créé par votre établissement. Lisez les conditions liées à votre rôle et confirmez pour continuer.</p>
                <div class="mt-4 grid gap-3 sm:grid-cols-2">
                    <div class="rounded-2xl bg-white p-3 ring-1 ring-slate-100">
                        <p class="text-xs uppercase tracking-wide text-slate-500">Profil détecté</p>
                        <p class="mt-1 text-sm font-bold text-slate-900">@currentRoleLabel</p>
                        <p class="mt-1 text-xs text-slate-600">@currentRoleSummary</p>
                    </div>
                    <div class="rounded-2xl bg-white p-3 ring-1 ring-slate-100">
                        <p class="text-xs uppercase tracking-wide text-slate-500">Ce que vous confirmez</p>
                        <ul class="mt-1 list-disc space-y-1 pl-4 text-xs text-slate-600">
                            <li>Utilisation conforme aux règles de l'établissement.</li>
                            <li>Protection des comptes et des données scolaires.</li>
                            <li>Respect des droits d'auteur et des consignes internes.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="max-h-[40vh] space-y-5 overflow-y-auto pr-2 text-sm leading-6 text-slate-700 sm:max-h-[50vh]">
                @if (currentRole == Rollen.Eltern)
                {
                    <section id="terms-parent" class="scroll-mt-4 rounded-2xl border border-sky-400 bg-sky-50 p-5">
                        <h3 class="text-xl font-black text-sky-900">Parents et tuteurs</h3>
                        <p class="mt-2">Votre compte a été créé par l'établissement de votre enfant. Il vous donne accès, en lecture seule, aux bulletins publiés, aux absences et retards, aux frais de scolarité et aux reçus des enfants que l'établissement a liés à votre compte.</p>
                        <p class="mt-2">Gardez vos identifiants confidentiels : ne les partagez pas avec l'enfant ni avec d'autres personnes. Pour toute question sur les notes, les absences ou les paiements, adressez-vous à l'établissement.</p>
                        <ul class="mt-3 list-disc space-y-1 pl-5 text-xs text-sky-900">
                            <li>Accès limité aux enfants liés par l'établissement.</li>
                            <li>Les données affichées sont celles enregistrées par l'établissement.</li>
                            <li>En cas d'erreur, contactez la direction de l'établissement.</li>
                        </ul>
                    </section>
                }
                <section id="terms-student" class="scroll-mt-4 rounded-2xl border p-5 @(currentRole == Rollen.Schueler ? "border-emerald-400 bg-emerald-50" : "border-emerald-100 bg-emerald-50/60")">
                    <h3 class="text-xl font-black text-emerald-900">Élèves</h3>
                    <p class="mt-2">SKOULOU ne conclut pas de contrat directement avec vous. L'accès à la plateforme est organisé par votre école, avec laquelle vous ou votre représentant légal êtes liés.</p>
                    <p class="mt-2">Pour toute question concernant votre compte, vos cours, vos paiements ou vos droits d'accès, adressez-vous d'abord à votre école, tant qu'elle administre l'application.</p>
                    <p class="mt-2">Les leçons et exercices publiés dans SKOULOU accompagnent le travail de votre classe et ne remplacent ni le programme scolaire ni l'enseignement de votre école.</p>
                    <ul class="mt-3 list-disc space-y-1 pl-5 text-xs text-emerald-900/85">
                        <li>Accès possible selon la classe attribuée et le statut du compte.</li>
                        <li>Les exports PDF élèves sont fournis sans solutions.</li>
                        <li>En cas de blocage, contactez d'abord votre direction.</li>
                    </ul>
                </section>

                <section id="terms-school" class="scroll-mt-4 rounded-2xl border p-5 @(currentRole is Rollen.SchulLeiter or Rollen.Koordinator ? "border-indigo-400 bg-indigo-50" : "border-indigo-100 bg-indigo-50/60")">
                    <h3 class="text-xl font-black text-indigo-900">Directions d'école & coordinateurs</h3>
                    <p class="mt-2">Vous administrez les écoles qui vous sont attribuées et êtes responsables de la gestion des élèves, enseignants, contenus pédagogiques et autorisations qui relèvent de ces écoles.</p>
                    <p class="mt-2">L'accès de votre école peut être suspendu ou limité lorsqu'une facture arrivée à échéance n'est pas réglée. Les abonnements et règlements restent dus selon les périodes facturées.</p>
                    <p class="mt-2">Contactez SKOULOU pour une difficulté technique d'utilisation ou pour transmettre une suggestion d'amélioration. Les demandes individuelles des élèves sont d'abord traitées par l'école.</p>
                    <ul class="mt-3 list-disc space-y-1 pl-5 text-xs text-indigo-900/85">
                        <li>Validation des inscriptions et gestion des affectations scolaires.</li>
                        <li>Suivi des abonnements, paiements et périodes de facturation.</li>
                        <li>Responsabilité de conformité locale sur les contenus publiés.</li>
                    </ul>
                </section>

                <section id="terms-teacher" class="scroll-mt-4 rounded-2xl border p-5 @(currentRole == Rollen.Lehrer ? "border-amber-400 bg-amber-50" : "border-amber-100 bg-amber-50/60")">
                    <h3 class="text-xl font-black text-amber-900">Enseignants</h3>
                    <p class="mt-2">Votre accès est accordé par votre école. Utilisez uniquement les élèves, classes et écoles qui vous sont attribués et protégez les informations qui vous sont confiées.</p>
                    <p class="mt-2">Vous êtes responsable des leçons, exercices, examens et autres contenus que vous créez ou partagez, ainsi que du respect des droits d'auteur, de la protection des données et des règles de votre établissement.</p>
                    <p class="mt-2">Les commissions éventuelles sont calculées à partir des périodes et des attributions enregistrées par la plateforme; leur versement et leur confirmation suivent les processus convenus avec l'école et SKOULOU.</p>
                    <ul class="mt-3 list-disc space-y-1 pl-5 text-xs text-amber-900/85">
                        <li>Publier des contenus clairs, exacts et adaptés à la classe.</li>
                        <li>Respecter les règles d'évaluation et de confidentialité.</li>
                        <li>Signaler rapidement tout incident pédagogique ou technique.</li>
                    </ul>
                </section>

                <section id="terms-owner" class="scroll-mt-4 rounded-2xl border p-5 @(currentRole == Rollen.ProduktOwner ? "border-fuchsia-400 bg-fuchsia-50" : "border-fuchsia-100 bg-fuchsia-50/60")">
                    <h3 class="text-xl font-black text-fuchsia-900">Responsables produit</h3>
                    <p class="mt-2">En tant que partenaire SKOULOU, vous accompagnez uniquement les écoles qui vous sont attribuées. Votre rôle porte sur le suivi financier et commercial convenu; il ne vous autorise pas à accéder aux contenus pédagogiques ou aux données des élèves au-delà de vos droits.</p>
                    <p class="mt-2">Les commissions sont calculées à partir des factures réglées et des périodes validées. Une commission affichée est un relevé transparent; la confirmation de réception documente son paiement sans modifier l'historique financier.</p>
                    <ul class="mt-3 list-disc space-y-1 pl-5 text-xs text-fuchsia-900/85">
                        <li>Accès limité aux écoles attribuées et à leur suivi commercial.</li>
                        <li>Aucun accès global aux données financières des autres écoles.</li>
                        <li>Traçabilité des validations de facturation et de réception.</li>
                    </ul>
                </section>

                <section class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
                    <h3 class="text-xl font-black text-slate-900">Règles communes</h3>
                    <p class="mt-2">Un compte ne peut être utilisé que sur un appareil à la fois. Une nouvelle connexion met fin à la session active précédente.</p>
                    <p class="mt-2">SKOULOU utilise des ressources de prestataires tiers, notamment pour l'hébergement. En cas d'indisponibilité indépendante de SKOULOU, par exemple une panne de service Microsoft, le remboursement des contributions d'abonnement n'est pas dû pour cette indisponibilité.</p>
                    <div class="mt-3 grid gap-2 sm:grid-cols-2">
                        <div class="rounded-xl bg-white p-3 ring-1 ring-slate-200">
                            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Confidentialité</p>
                            <p class="mt-1 text-xs text-slate-700">Les données sont utilisées pour la gestion pédagogique et administrative selon les autorisations.</p>
                        </div>
                        <div class="rounded-xl bg-white p-3 ring-1 ring-slate-200">
                            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Sécurité</p>
                            <p class="mt-1 text-xs text-slate-700">Ne partagez pas vos accès. Déconnectez-vous après usage sur un appareil partagé.</p>
                        </div>
                    </div>
                </section>
            </div>

            <div class="sticky bottom-0 z-10 flex flex-col-reverse gap-3 border-t border-slate-100 bg-white/95 pt-4 pb-[calc(1rem+env(safe-area-inset-bottom))] backdrop-blur sm:static sm:flex-row sm:justify-end sm:bg-transparent sm:pb-0 sm:backdrop-blur-none">
                <form action="auth/logout" method="post" data-submit-loading="true" data-loading-text="Déconnexion...">
                    <AntiforgeryToken />
                    <button type="submit" data-loading-text="Déconnexion..." class="inline-flex items-center justify-center gap-2 rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 disabled:cursor-wait disabled:opacity-70">Se déconnecter</button>
                </form>
                <AsyncActionButton Type="button" Class="rounded-full bg-gradient-to-r from-emerald-600 to-teal-700 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-emerald-200 disabled:opacity-50" IsBusy="@isAcceptingTerms" BusyLabel="Enregistrement..." OnClick="AcceptTermsAsync">J'accepte et je continue</AsyncActionButton>
            </div>
        </div>
    </ModalDialog>
}
