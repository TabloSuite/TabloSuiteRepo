<div class="brand-panel">
    <div class="brand-copy brand-copy-with-icon">
        <a class="brand-logo" href="" aria-label="SKOULOU – Accueil">
            <img src="skoulou-app-icon.svg" alt="" />
            <span>SKOULOU</span>
        </a>
        <p class="brand-subtitle">Plateforme de gestion scolaire pour écoles, classes, supports et examens</p>
    </div>
</div>

<input id="nav-toggle" type="checkbox" title="Menu de navigation" class="navbar-toggler" />

<label class="nav-overlay-backdrop" for="nav-toggle" aria-hidden="true"></label>

<div class="nav-scrollable" onclick="document.getElementById('nav-toggle').checked = false">
    <nav class="nav-menu-list">
        <div class="nav-section-label">Accueil</div>
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" data-scrollspy="top"
                     onclick="if (location.pathname === '/') { return window.SKOULOUAPPScrollToTop.scrollToId('top'); }">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span>
                <span>Accueil</span>
            </NavLink>
            <div class="nav-subitem-list">
                <NavLink class="nav-subitem-link" href="/#apropos" data-scrollspy="apropos"
                         onclick="if (location.pathname === '/') { return window.SKOULOUAPPScrollToTop.scrollToId('apropos'); }">
                    <span class="bi bi-book-nav-menu" aria-hidden="true"></span>
                    <span>À propos</span>
                </NavLink>
                <NavLink class="nav-subitem-link" href="/#inscription" data-scrollspy="inscription"
                         onclick="if (location.pathname === '/') { return window.SKOULOUAPPScrollToTop.scrollToId('inscription'); }">
                    <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span>
                    <span>Inscription</span>
                </NavLink>
            </div>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="contact">
                <span class="bi bi-envelope-nav-menu" aria-hidden="true"></span>
                <span>Contact</span>
            </NavLink>
        </div>

        <AuthorizeView Roles="SchulLeiter,Koordinator,SuperAdmin,ProduktOwner,Lehrer,Schüler" Context="espaceState">
            <Authorized>
                <div class="nav-section-label nav-section-spacing">Espace</div>

                @if (espaceState.User.IsInRole("Schüler"))
                {
                    <div class="nav-item">
                        <NavLink class="nav-link" href="student" Match="NavLinkMatch.All" data-enhance-nav="false">
                            <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span>
                            <span>Espace élève</span>
                        </NavLink>
                    </div>
                }

                @if (espaceState.User.IsInRole("SchulLeiter") || espaceState.User.IsInRole("Koordinator"))
                {
                    <div class="nav-item">
                        <NavLink class="nav-link" href="schulleiter" data-enhance-nav="false">
                            <span class="bi bi-building-nav-menu" aria-hidden="true"></span>
                            <span>@(espaceState.User.IsInRole("Koordinator") && !espaceState.User.IsInRole("SchulLeiter")
                                    ? "Espace coordinateur"
                                    : "Espace directeur")</span>
                        </NavLink>
                    </div>
                }

                @if (espaceState.User.IsInRole("SchulLeiter") || espaceState.User.IsInRole("Koordinator"))
                {
                    <div class="nav-item">
                        <NavLink class="nav-link" href="direction/enseignement" data-enhance-nav="false">
                            <span class="bi bi-journal-text-nav-menu" aria-hidden="true"></span>
                            <span>Organisation des enseignements</span>
                        </NavLink>
                    </div>
                }

                @if (espaceState.User.IsInRole("SchulLeiter") || espaceState.User.IsInRole("Koordinator") || espaceState.User.IsInRole("Lehrer") || espaceState.User.IsInRole("Schüler"))
                {
                    <div class="nav-item">
                        <NavLink class="nav-link" href="emplois-du-temps" data-enhance-nav="false">
                            <span class="bi bi-journal-text-nav-menu" aria-hidden="true"></span>
                            <span>Emplois du temps</span>
                        </NavLink>
                    </div>
                }

                @if (espaceState.User.IsInRole("SchulLeiter") || espaceState.User.IsInRole("Koordinator") || espaceState.User.IsInRole("Schüler"))
                {
                    <div class="nav-item">
                        <NavLink class="nav-link" href="bulletins" data-enhance-nav="false">
                            <span class="bi bi-journal-text-nav-menu" aria-hidden="true"></span>
                            <span>Bulletins scolaires</span>
                        </NavLink>
                    </div>
                }

                @if (espaceState.User.IsInRole("SuperAdmin") || espaceState.User.IsInRole("ProduktOwner"))
                {
                    <div class="nav-item">
                        <NavLink class="nav-link" href="admin" Match="NavLinkMatch.All" data-enhance-nav="false">
                            <span class="bi bi-shield-lock-nav-menu" aria-hidden="true"></span>
                            <span>@(espaceState.User.IsInRole("SuperAdmin") ? "Espace administrateur" : "Espace responsable produit")</span>
                        </NavLink>
                    </div>
                    @if (espaceState.User.IsInRole("SuperAdmin"))
                    {
                        <div class="nav-item">
                            <NavLink class="nav-link" href="admin/communication" data-enhance-nav="false">
                                <span class="bi bi-envelope-nav-menu" aria-hidden="true"></span>
                                <span>Communication</span>
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="admin/exception-logs" data-enhance-nav="false">
                                <span class="bi bi-exclamation-triangle-nav-menu" aria-hidden="true"></span>
                                <span>Journal des exceptions</span>
                            </NavLink>
                        </div>
                    }
                }
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="ProduktOwner">
            <Authorized>
                <div class="nav-item">
                    <NavLink class="nav-link" href="admin/courrier" data-enhance-nav="false">
                        <span class="bi bi-envelope-nav-menu" aria-hidden="true"></span>
                        <span>Messagerie</span>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="ProduktOwner">
            <Authorized>
                <div class="nav-section-label nav-section-spacing">Mes commissions</div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="provisionen" data-enhance-nav="false">
                        <span class="bi bi-pie-chart-nav-menu" aria-hidden="true"></span>
                        <span>Parts de mes écoles</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="abrechnung" data-enhance-nav="false">
                        <span class="bi bi-cash-stack-nav-menu" aria-hidden="true"></span>
                        <span>Facturations de mes écoles</span>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Lehrer,SchulLeiter,Koordinator" Context="pedagogicState">
            <Authorized>
                <div class="nav-section-label nav-section-spacing">Espace pédagogique</div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="notes" data-enhance-nav="false">
                        <span class="bi bi-checklist-nav-menu" aria-hidden="true"></span>
                        <span>Notes et évaluations</span>
                    </NavLink>
                </div>
                @if (pedagogicState.User.IsInRole("Lehrer") && !pedagogicState.User.IsInRole("SchulLeiter") && !pedagogicState.User.IsInRole("Koordinator"))
                {
                    <div class="nav-item">
                        <NavLink class="nav-link" href="teacher" Match="NavLinkMatch.All" data-enhance-nav="false">
                            <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span>
                            <span>Tableau pédagogique</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="teacher/create" data-enhance-nav="false">
                            <span class="bi bi-journal-text-nav-menu" aria-hidden="true"></span>
                            <span>Création leçon & examens</span>
                        </NavLink>
                    </div>
                }
                else
                {
                    <div class="nav-item">
                        <NavLink class="nav-link" href="teacher/lessons" data-enhance-nav="false">
                            <span class="bi bi-journal-text-nav-menu" aria-hidden="true"></span>
                            <span>Contenus pédagogiques des enseignants</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="teacher-exams" Match="NavLinkMatch.All" data-enhance-nav="false">
                            <span class="bi bi-checklist-nav-menu" aria-hidden="true"></span>
                            <span>Examens (création PDF)</span>
                        </NavLink>
                    </div>
                }
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="SchulLeiter,Koordinator,SuperAdmin,ProduktOwner">
            <Authorized Context="financeState">
                @if (!financeState.User.IsInRole("Koordinator") || financeState.User.IsInRole("SchulLeiter") || coordinatorHasFinanceAccess)
                {
                <div class="nav-section-label nav-section-spacing">Finances</div>
                @if (financeState.User.IsInRole("SuperAdmin"))
                {
                    <div class="nav-item">
                        <NavLink class="nav-link" href="superadmin/finances" data-enhance-nav="false">
                            <span class="bi bi-wallet2-nav-menu" aria-hidden="true"></span>
                            <span>Centre financier</span>
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="abrechnung" data-enhance-nav="false">
                            <span class="bi bi-cash-stack-nav-menu" aria-hidden="true"></span>
                        <span>Gestion SKOULOUAPPABOs</span>
                        </NavLink>
                    </div>
                }
                else
                {
                    <div class="nav-item">
                        <NavLink class="nav-link" href="finanzen" data-enhance-nav="false">
                            <span class="bi bi-wallet2-nav-menu" aria-hidden="true"></span>
                            <span>@(financeState.User.IsInRole("ProduktOwner") ? "Finances des écoles (lecture seule)" : "Comptabilité et paiements")</span>
                        </NavLink>
                    </div>
                }
                }
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-section-label nav-section-spacing">Aide</div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="handbuch" data-enhance-nav="false">
                        <span class="bi bi-book-nav-menu" aria-hidden="true"></span>
                        <span>Guide utilisateur</span>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <div class="nav-auth-section" onclick="event.stopPropagation()">
            <AuthorizeView>
                <Authorized Context="authState">
                    <div class="nav-auth-card">
                        <span class="nav-auth-name">@authState.User.Identity?.Name</span>
                        <form action="auth/logout" method="post" data-submit-loading="true" data-loading-text="Déconnexion..." class="nav-auth-form">
                            <AntiforgeryToken />
                            <button type="submit" data-loading-text="Déconnexion..." class="nav-auth-button">Se déconnecter</button>
                        </form>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="nav-auth-actions">
                        <a class="nav-auth-button" href="auth/login">Se connecter</a>
                        <a class="nav-auth-button nav-auth-button-accent" href="auth/register">S'inscrire</a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </nav>
</div>

