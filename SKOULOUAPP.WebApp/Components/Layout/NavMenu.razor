@* Navigation im Design „Soft Modern“ (wie eNOTE). Sichtbarkeit nach Rolle – ersetzt keine Prüfung im Service. *@
<div class="sk-brand">
    <a class="sk-brand-link" href="" aria-label="SKOULOU – Accueil">
        <img src="skoulou-app-icon.svg" alt="" class="sk-brand-logo" />
        <span class="sk-brand-text">
            <span class="sk-brand-name">SKOULOU</span>
            <span class="sk-brand-tag">Gestion scolaire</span>
        </span>
    </a>
    <label class="sk-nav-close" for="nav-toggle" aria-label="Fermer le menu"><Icon Name="x" /></label>
</div>

<input id="nav-toggle" type="checkbox" title="Menu de navigation" class="sk-nav-toggle" />
<label class="sk-nav-backdrop" for="nav-toggle" aria-hidden="true"></label>

<div class="sk-nav-scroll" onclick="if (event.target.closest('a')) document.getElementById('nav-toggle').checked = false">
    <nav class="sk-nav" aria-label="Navigation principale">
        <AuthorizeView>
            <NotAuthorized>
                <NavLink class="sk-nav-link" ActiveClass="is-active" href="" Match="NavLinkMatch.All"><Icon Name="home" /><span>Accueil</span></NavLink>
                <NavLink class="sk-nav-link sk-nav-sub" ActiveClass="is-active" href="/#apropos"><Icon Name="info" Groesse="18" /><span>À propos</span></NavLink>
                <NavLink class="sk-nav-link sk-nav-sub" ActiveClass="is-active" href="/#inscription"><Icon Name="user-plus" Groesse="18" /><span>Inscription</span></NavLink>
                <NavLink class="sk-nav-link" ActiveClass="is-active" href="contact"><Icon Name="mail" /><span>Contact</span></NavLink>
            </NotAuthorized>
            <Authorized>
                <NavLink class="sk-nav-link" ActiveClass="is-active" href="" Match="NavLinkMatch.All"><Icon Name="home" /><span>Accueil</span></NavLink>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Eltern" Context="elternState">
            <Authorized>
                <p class="sk-nav-section">Espace parents</p>
                <NavLink class="sk-nav-link" ActiveClass="is-active" href="parents" Match="NavLinkMatch.All" data-enhance-nav="false"><Icon Name="users" /><span>Mes enfants</span></NavLink>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="SchulLeiter,Koordinator,SuperAdmin,ProduktOwner,Lehrer,Schüler" Context="espaceState">
            <Authorized>
                @{
                    var user = espaceState.User;
                    var direktion = user.IsInRole("SchulLeiter") || user.IsInRole("Koordinator");
                    var nurKoordinator = user.IsInRole("Koordinator") && !user.IsInRole("SchulLeiter");
                }
                <p class="sk-nav-section">@(direktion ? "Établissement" : "Mon espace")</p>

                @if (user.IsInRole("Schüler"))
                {
                    <NavLink class="sk-nav-link" ActiveClass="is-active" href="student" Match="NavLinkMatch.All" data-enhance-nav="false"><Icon Name="graduation" /><span>Espace élève</span></NavLink>
                }
                @if (direktion)
                {
                    <NavLink class="sk-nav-link" ActiveClass="is-active" href="direction" Match="NavLinkMatch.All" data-enhance-nav="false"><Icon Name="grid" /><span>Tableau de bord</span></NavLink>
                    <NavLink class="sk-nav-link" ActiveClass="is-active" href="schulleiter" data-enhance-nav="false"><Icon Name="school" /><span>@(nurKoordinator ? "Espace coordination" : "Direction")</span></NavLink>
                    <NavLink class="sk-nav-link" ActiveClass="is-active" href="direction/enseignement" data-enhance-nav="false"><Icon Name="layers" /><span>Organisation des enseignements</span></NavLink>
                    <NavLink class="sk-nav-link" ActiveClass="is-active" href="direction/parents" data-enhance-nav="false"><Icon Name="users" /><span>Accès parents</span></NavLink>
                }
                @if (direktion || user.IsInRole("Lehrer") || user.IsInRole("Schüler"))
                {
                    <NavLink class="sk-nav-link" ActiveClass="is-active" href="emplois-du-temps" data-enhance-nav="false"><Icon Name="timetable" /><span>Emplois du temps</span></NavLink>
                }
                @if (direktion || user.IsInRole("Schüler"))
                {
                    <NavLink class="sk-nav-link" ActiveClass="is-active" href="bulletins" data-enhance-nav="false"><Icon Name="report" /><span>Bulletins scolaires</span></NavLink>
                }
                @if (user.IsInRole("SuperAdmin") || user.IsInRole("ProduktOwner"))
                {
                    <NavLink class="sk-nav-link" ActiveClass="is-active" href="admin" Match="NavLinkMatch.All" data-enhance-nav="false"><Icon Name="shield" /><span>@(user.IsInRole("SuperAdmin") ? "Administration" : "Responsable produit")</span></NavLink>
                    @if (user.IsInRole("SuperAdmin"))
                    {
                        <NavLink class="sk-nav-link" ActiveClass="is-active" href="admin/communication" data-enhance-nav="false"><Icon Name="megaphone" /><span>Communication</span></NavLink>
                        <NavLink class="sk-nav-link" ActiveClass="is-active" href="admin/exception-logs" data-enhance-nav="false"><Icon Name="alert" /><span>Journal des erreurs</span></NavLink>
                    }
                }
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="ProduktOwner">
            <Authorized>
                <NavLink class="sk-nav-link" ActiveClass="is-active" href="admin/courrier" data-enhance-nav="false"><Icon Name="message" /><span>Messagerie</span></NavLink>
                <p class="sk-nav-section">Mes établissements</p>
                <NavLink class="sk-nav-link" ActiveClass="is-active" href="provisionen" data-enhance-nav="false"><Icon Name="pie" /><span>Parts de mes écoles</span></NavLink>
                <NavLink class="sk-nav-link" ActiveClass="is-active" href="abrechnung" data-enhance-nav="false"><Icon Name="receipt" /><span>Facturations de mes écoles</span></NavLink>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Lehrer,SchulLeiter,Koordinator" Context="pedagogicState">
            <Authorized>
                <p class="sk-nav-section">Pédagogie</p>
                <NavLink class="sk-nav-link" ActiveClass="is-active" href="notes" data-enhance-nav="false"><Icon Name="clipboard-check" /><span>Notes et évaluations</span></NavLink>
                @if (pedagogicState.User.IsInRole("Lehrer") && !pedagogicState.User.IsInRole("SchulLeiter") && !pedagogicState.User.IsInRole("Koordinator"))
                {
                    <NavLink class="sk-nav-link" ActiveClass="is-active" href="teacher" Match="NavLinkMatch.All" data-enhance-nav="false"><Icon Name="grid" /><span>Tableau pédagogique</span></NavLink>
                    <NavLink class="sk-nav-link" ActiveClass="is-active" href="teacher/create" data-enhance-nav="false"><Icon Name="pen" /><span>Leçons et examens</span></NavLink>
                }
                else
                {
                    <NavLink class="sk-nav-link" ActiveClass="is-active" href="teacher/lessons" data-enhance-nav="false"><Icon Name="book-open" /><span>Contenus des enseignants</span></NavLink>
                    <NavLink class="sk-nav-link" ActiveClass="is-active" href="teacher-exams" Match="NavLinkMatch.All" data-enhance-nav="false"><Icon Name="exam" /><span>Examens (PDF)</span></NavLink>
                }
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="SchulLeiter,Koordinator,SuperAdmin,ProduktOwner">
            <Authorized Context="financeState">
                @if (!financeState.User.IsInRole("Koordinator") || financeState.User.IsInRole("SchulLeiter") || coordinatorHasFinanceAccess)
                {
                    <p class="sk-nav-section">Finances</p>
                    @if (financeState.User.IsInRole("SuperAdmin"))
                    {
                        <NavLink class="sk-nav-link" ActiveClass="is-active" href="superadmin/finances" data-enhance-nav="false"><Icon Name="wallet" /><span>Centre financier</span></NavLink>
                        <NavLink class="sk-nav-link" ActiveClass="is-active" href="abrechnung" data-enhance-nav="false"><Icon Name="receipt" /><span>Facturation SKOULOU</span></NavLink>
                    }
                    else
                    {
                        <NavLink class="sk-nav-link" ActiveClass="is-active" href="finanzen" data-enhance-nav="false"><Icon Name="wallet" /><span>@(financeState.User.IsInRole("ProduktOwner") ? "Finances des écoles" : "Comptabilité et paiements")</span></NavLink>
                    }
                }
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <p class="sk-nav-section">Aide</p>
                <NavLink class="sk-nav-link" ActiveClass="is-active" href="aide/videos" data-enhance-nav="false"><Icon Name="monitor" /><span>Vidéos d'aide</span></NavLink>
                <NavLink class="sk-nav-link" ActiveClass="is-active" href="handbuch" data-enhance-nav="false"><Icon Name="help" /><span>Guide utilisateur</span></NavLink>
                <NavLink class="sk-nav-link" ActiveClass="is-active" href="contact"><Icon Name="mail" /><span>Contact</span></NavLink>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>
