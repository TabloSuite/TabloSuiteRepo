@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject NavigationManager Navigation

<AuthorizeView Roles="Schüler">
    <Authorized>
        <div class="student-bottom-nav-shell">
            @if (isMoreMenuOpen)
            {
                <div class="student-bottom-nav-popup" role="menu" aria-label="Menu élève supplémentaire">
                    <NavLink class="student-bottom-nav-popup-item" href="student/history" data-enhance-nav="false" Match="NavLinkMatch.Prefix" @onclick="CloseMoreMenu">
                        <span class="student-bottom-nav-popup-icon" aria-hidden="true">
                            <svg viewBox="0 0 16 16" role="img" aria-hidden="true" focusable="false">
                                <path d="M8.515 1.019A7 7 0 1 0 15 8h-1.5a5.5 5.5 0 1 1-1.61-3.89L10 6h5V1l-1.965 1.964A6.97 6.97 0 0 0 8.515 1.02" />
                                <path d="M8 4.5a.5.5 0 0 1 .5.5v3.293l2 2a.5.5 0 0 1-.707.707l-2.147-2.146A.5.5 0 0 1 7.5 8.5V5a.5.5 0 0 1 .5-.5" />
                            </svg>
                        </span>
                        <span>Historique</span>
                    </NavLink>

                    <NavLink class="student-bottom-nav-popup-item" href="@ProfileLink" Match="NavLinkMatch.All" @onclick="CloseMoreMenu">
                        <span class="student-bottom-nav-popup-icon" aria-hidden="true">
                            <svg viewBox="0 0 16 16" role="img" aria-hidden="true" focusable="false">
                                <path d="M6.5 2a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1zM11 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0" />
                                <path d="M4.5 0A2.5 2.5 0 0 0 2 2.5V14a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2.5A2.5 2.5 0 0 0 11.5 0zm0 1h7A1.5 1.5 0 0 1 13 2.5v10.795a4.2 4.2 0 0 0-.776-.492C11.392 12.387 10.063 12 8 12s-3.392.387-4.224.803a4.2 4.2 0 0 0-.776.492V2.5A1.5 1.5 0 0 1 4.5 1" />
                            </svg>
                        </span>
                        <span>Profil</span>
                    </NavLink>

                    <form action="auth/logout" method="post" data-submit-loading="true" data-loading-text="Déconnexion..." class="student-bottom-nav-popup-logout-form">
                        <AntiforgeryToken />
                        <button type="submit" data-loading-text="Déconnexion..." class="student-bottom-nav-popup-item student-bottom-nav-popup-item--button">
                            <span class="student-bottom-nav-popup-icon" aria-hidden="true">
                                <svg viewBox="0 0 16 16" role="img" aria-hidden="true" focusable="false">
                                    <path d="M6 2a2 2 0 0 0-2 2v2h1.5V4a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 .5.5v8a.5.5 0 0 1-.5.5H6a.5.5 0 0 1-.5-.5V10H4v2a2 2 0 0 0 2 2h5a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2z" />
                                    <path d="M7.854 8.354a.5.5 0 0 0 0-.708L6.207 6H10.5a.5.5 0 0 0 0-1H6.207l1.647-1.646a.5.5 0 1 0-.708-.708l-2.5 2.5a.5.5 0 0 0 0 .708l2.5 2.5a.5.5 0 0 0 .708 0" />
                                </svg>
                            </span>
                            <span>Se déconnecter</span>
                        </button>
                    </form>
                </div>
            }

            <nav class="student-bottom-nav" aria-label="Navigation élève">
                <NavLink class="student-bottom-nav-item" href="student" data-enhance-nav="false" Match="NavLinkMatch.All">
                    <span class="student-bottom-nav-icon" aria-hidden="true">
                        <svg viewBox="0 0 16 16" role="img" aria-hidden="true" focusable="false">
                            <path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 2 8h1v5.5a.5.5 0 0 0 .5.5h3.5a.5.5 0 0 0 .5-.5V10h1v3.5a.5.5 0 0 0 .5.5H12.5a.5.5 0 0 0 .5-.5V8h1a.5.5 0 0 0 .354-.854z" />
                        </svg>
                    </span>
                    <span class="student-bottom-nav-label">Espace élève</span>
                </NavLink>

                <NavLink class="student-bottom-nav-item" href="student/lessons" data-enhance-nav="false">
                    <span class="student-bottom-nav-icon" aria-hidden="true">
                        <svg viewBox="0 0 16 16" role="img" aria-hidden="true" focusable="false">
                            <path d="M1 2.828c.885-.37 2.154-.769 3.5-.769 1.465 0 2.827.436 3.5 1.087.673-.651 2.035-1.087 3.5-1.087 1.346 0 2.615.4 3.5.769V14.5c-.885-.37-2.154-.769-3.5-.769-1.465 0-2.827.436-3.5 1.087-.673-.651-2.035-1.087-3.5-1.087-1.346 0-2.615.4-3.5.769z" />
                        </svg>
                    </span>
                    <span class="student-bottom-nav-label">Leçons</span>
                </NavLink>

                <NavLink class="student-bottom-nav-item" href="student/exams" data-enhance-nav="false">
                    <span class="student-bottom-nav-icon" aria-hidden="true">
                        <svg viewBox="0 0 16 16" role="img" aria-hidden="true" focusable="false">
                            <path d="M5 8V6.5h8V8zM5 10.5V9h8v1.5zM5 13v-1.5h8V13z" />
                            <path d="M2 2a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2zM1 4a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1z" />
                        </svg>
                    </span>
                    <span class="student-bottom-nav-label">Examens</span>
                </NavLink>

                <button type="button"
                        class="student-bottom-nav-item @(IsMoreSectionActive ? "active" : "")"
                        @onclick="ToggleMoreMenu"
                        aria-expanded="@isMoreMenuOpen"
                        aria-label="Ouvrir le menu supplémentaire">
                    <span class="student-bottom-nav-icon" aria-hidden="true">
                        <svg viewBox="0 0 16 16" role="img" aria-hidden="true" focusable="false">
                            <path d="M8 3.25a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5m0 3.75A1.25 1.25 0 1 1 8 9.5 1.25 1.25 0 0 1 8 7m0 3.75a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5" />
                        </svg>
                    </span>
                    <span class="student-bottom-nav-label">Plus</span>
                </button>
            </nav>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private bool isMoreMenuOpen;
    private string ProfileLink
    {
        get
        {
            var source = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).TrimStart('/');
            return source.Split('?', '#')[0].Equals("/profil", StringComparison.OrdinalIgnoreCase)
                ? "profil"
                : $"profil?returnUrl={Uri.EscapeDataString(source)}";
        }
    }

    private bool IsMoreSectionActive
    {
        get
        {
            var route = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
            return route.Equals("/student/history", StringComparison.OrdinalIgnoreCase)
                   || route.StartsWith("/student/history/", StringComparison.OrdinalIgnoreCase)
                   || route.Equals("/profil", StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private void ToggleMoreMenu()
    {
        isMoreMenuOpen = !isMoreMenuOpen;
    }

    private void CloseMoreMenu()
    {
        isMoreMenuOpen = false;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        isMoreMenuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}

<style>
    .student-bottom-nav-shell {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 2000;
        pointer-events: none;
        overflow: visible;
    }

    .student-bottom-nav-popup,
    .student-bottom-nav {
        pointer-events: auto;
    }

    .student-bottom-nav-popup {
        position: absolute;
        left: 0.8rem;
        right: 0.8rem;
        bottom: calc(100% + 0.4rem + env(safe-area-inset-bottom, 0px));
        padding: 0.45rem;
        display: grid;
        gap: 0.35rem;
        border-radius: 1rem;
        background: #ffffff;
        border: 1px solid var(--sk-border);
        box-shadow: 0 14px 32px rgba(16, 26, 51, 0.16);
        z-index: 3;
    }

    .student-bottom-nav-popup-item {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        border-radius: 0.8rem;
        padding: 0.55rem 0.75rem;
        color: var(--sk-text);
        text-decoration: none;
        font-size: 0.86rem;
        font-weight: 600;
    }

    .student-bottom-nav-popup-logout-form {
        margin: 0;
    }

    .student-bottom-nav-popup-item--button {
        width: 100%;
        border: 0;
        text-align: left;
        background: transparent;
        cursor: pointer;
        font: inherit;
    }

    .student-bottom-nav-popup-item:hover {
        background: var(--sk-surface-2);
    }

    .student-bottom-nav-popup-item.active {
        color: rgb(var(--sk-p-800));
        background: rgb(var(--sk-p-50));
    }

    .student-bottom-nav-popup-icon {
        width: 1.25rem;
        height: 1.25rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .student-bottom-nav-popup-icon svg {
        width: 1rem;
        height: 1rem;
        fill: currentColor;
    }

    .student-bottom-nav {
        position: relative;
        z-index: 2;
        display: flex !important;
        justify-content: center !important;
        align-items: stretch !important;
        gap: 0.35rem !important;
        padding: 0.5rem 0.6rem calc(0.5rem + env(safe-area-inset-bottom, 0px)) !important;
        background: rgba(255, 255, 255, 0.96) !important;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-top: 1px solid var(--sk-border) !important;
        box-shadow: 0 -6px 20px rgba(16, 26, 51, 0.08) !important;
        transform: translateZ(0);
        -webkit-transform: translateZ(0);
    }

    .student-bottom-nav-item {
        flex: 1 1 0;
        max-width: 6.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.2rem;
        padding: 0.4rem 0.3rem;
        border-radius: 1.1rem;
        color: var(--sk-text-muted);
        text-decoration: none;
        font-size: 0.66rem;
        font-weight: 600;
        letter-spacing: 0.01em;
        border: 0;
        background: transparent;
        cursor: pointer;
    }

    .student-bottom-nav-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border-radius: 999px;
        color: currentColor;
    }

    .student-bottom-nav-icon svg {
        width: 1.15rem;
        height: 1.15rem;
        fill: currentColor;
    }

    .student-bottom-nav-item:hover {
        color: rgb(var(--sk-p-700));
    }

    .student-bottom-nav-item.active {
        color: rgb(var(--sk-p-800));
    }

    .student-bottom-nav-item.active .student-bottom-nav-icon {
        background: rgb(var(--sk-p-700));
        color: #ffffff;
        box-shadow: 0 6px 14px rgb(var(--sk-p-700) / 0.3);
        transform: translateY(-0.15rem);
    }

    .student-bottom-nav-item.active .student-bottom-nav-label {
        opacity: 1;
        font-weight: 800;
    }

    @@media (min-width: 640px) {
        .student-bottom-nav-popup {
            left: 50%;
            right: auto;
            width: min(24rem, calc(100vw - 3rem));
            transform: translateX(-50%);
        }

        .student-bottom-nav-item {
            max-width: 8rem;
            font-size: 0.72rem;
        }

        .student-bottom-nav-icon {
            width: 2.35rem;
            height: 2.35rem;
        }

        .student-bottom-nav-icon svg {
            width: 1.3rem;
            height: 1.3rem;
        }
    }
</style>
