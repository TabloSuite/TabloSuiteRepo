@using Microsoft.AspNetCore.Components.Authorization
@using SkoulouApp.WebApp.Components.Layout
@inherits LayoutComponentBase

@* App-Hülle „Soft Modern“ (wie eNOTE): Seitenleiste links, schlanke Kopfzeile, ruhige Fläche. Schüler: ohne Seitenleiste, Navigation unten. *@
<div class="app-shell @(isStudentChromeHidden ? "app-shell--student" : "")">
    @if (!isStudentChromeHidden)
    {
        <aside class="app-sidebar">
            <NavMenu />
        </aside>
    }

    <main class="app-main @(isStudentChromeHidden ? "app-main--student" : "")">
        @if (!isStudentChromeHidden)
        {
            <header class="app-header">
                <label class="app-header-menu" for="nav-toggle" aria-label="Ouvrir le menu"><Icon Name="menu" /></label>
                <a class="app-header-brand" href="" aria-label="SKOULOU – Accueil">
                    <img src="skoulou-app-icon.svg" alt="" />
                    <span>SKOULOU</span>
                </a>
                <div class="app-header-actions">
                    <UserMenu @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
                </div>
            </header>
        }

        <article class="app-content @(isStudentChromeHidden ? "app-content--student" : "")">
            <AnkuendigungAnzeige @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
            @Body
        </article>

        @if (!isStudentChromeHidden)
        {
            <footer class="app-footer" aria-label="Informations de contact SKOULOU">
                <div class="app-footer-brand">
                    <img src="skoulou-app-icon.svg" alt="" class="app-footer-logo" />
                    <span><strong>SKOULOU</strong> · Apprendre. Progresser. Réussir.</span>
                </div>
                <div class="app-footer-contact">
                    <a href="@SkoulouMarke.Website" target="_blank" rel="noopener noreferrer"><Icon Name="globe" Groesse="16" />@SkoulouMarke.Domain</a>
                    <a href="mailto:@SkoulouMarke.KontaktEmail"><Icon Name="mail" Groesse="16" />@SkoulouMarke.KontaktEmail</a>
                    <span><Icon Name="home" Groesse="16" />Lomé, Togo</span>
                </div>
                <span class="app-footer-copy">© @DateTime.UtcNow.Year SKOULOU, une application <a href="@SkoulouMarke.FirmenSeite" target="_blank" rel="noopener noreferrer">TabloSuite</a>. Tous droits réservés.</span>
            </footer>
        }
    </main>
</div>

<StudentBottomNav @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />

<ScrollToTopButton />

<TermsAcceptanceGuard @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />

<div id="blazor-error-ui" data-nosnippet>
    Une erreur inattendue s'est produite.
    <a href="." class="reload">Recharger</a>
    <span class="dismiss" aria-label="Fermer">×</span>
</div>
