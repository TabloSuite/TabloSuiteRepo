<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <ProtokollierendeFehlergrenze @key="routeData.PageType">
            <ChildContent>
                <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                    <NotAuthorized>
                        <RedirectToLogin />
                    </NotAuthorized>
                </AuthorizeRouteView>
            </ChildContent>
            <ErrorContent>
                <section class="mx-auto max-w-3xl rounded-2xl bg-white p-6 text-slate-800 shadow ring-1 ring-rose-100" role="alert">
                    <h1 class="text-xl font-bold">Une erreur inattendue s'est produite.</h1>
                    <p class="mt-2 text-sm">Rechargez la page pour réessayer.</p>
                    <a class="mt-4 inline-block text-sm font-semibold text-indigo-700 underline" href="/">Retour à l'accueil</a>
                </section>
            </ErrorContent>
        </ProtokollierendeFehlergrenze>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <Navigating>
        <div class="app-route-loading" role="status" aria-live="polite" aria-label="Chargement de la page">
            <ProgressRing Size="1rem" Label="Chargement de la page" />
            <span>Chargement&#8230;</span>
        </div>
    </Navigating>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <section class="rounded-[2rem] bg-white p-8 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100">
                <h1 class="text-3xl font-black text-slate-900">Page introuvable</h1>
                <p class="mt-4 text-sm leading-7 text-slate-600">La page demandée n'existe pas ou a été déplacée.</p>
            </section>
        </LayoutView>
    </NotFound>
</Router>
