@implements IAsyncDisposable
@inject HalloApp.Core.Services.AnkuendigungService AnkuendigungService

@if (ankuendigungen.Count > 0)
{
    <section class="mx-auto mb-4 grid w-full max-w-7xl gap-3" aria-label="Annonces">
        @foreach (var ankuendigung in ankuendigungen)
        {
            <article class="min-w-0 rounded-2xl border border-cyan-200 bg-cyan-50 px-4 py-4 shadow-sm sm:px-6" @key="ankuendigung.Id">
                <p class="text-xs font-black uppercase tracking-widest text-cyan-700">Annonce</p>
                <h2 class="mt-1 break-words text-lg font-black text-slate-900">@ankuendigung.Titel</h2>
                <div class="prose mt-2 max-w-none break-words text-sm text-slate-800">@((MarkupString)ankuendigung.InhaltHtml)</div>
                <p class="mt-2 text-xs text-cyan-800">Visible jusqu'au @ankuendigung.AblaufAmUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
            </article>
        }
    </section>
}

@code {
    private List<HalloApp.Core.DataModels.Schools.Ankuendigung> ankuendigungen = [];
    private readonly CancellationTokenSource cancellation = new();
    private Task? refreshTask;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        refreshTask = RefreshPeriodicallyAsync();
    }

    private async Task RefreshAsync()
    {
        ankuendigungen = await AnkuendigungService.GetAktiveAsync(DateTime.UtcNow, cancellation.Token);
    }

    private async Task RefreshPeriodicallyAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellation.Token))
            {
                await InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });
            }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
    }

    public async ValueTask DisposeAsync()
    {
        await cancellation.CancelAsync();
        if (refreshTask is not null) await refreshTask;
        cancellation.Dispose();
    }
}
