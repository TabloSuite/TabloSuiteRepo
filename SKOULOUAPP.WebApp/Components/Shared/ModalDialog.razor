@if (Open)
{
    <div class="fixed inset-0 @ZIndexClass flex items-center justify-center overflow-hidden bg-slate-950/45 p-4 backdrop-blur-sm sm:p-8"
         @onclick="OnBackdropClickAsync">
        <div role="dialog" aria-modal="true" aria-label="@Title" class="skoulou-modal-surface my-auto max-h-[calc(100dvh-4rem)] w-full @MaxWidthClass rounded-2xl bg-white shadow-2xl shadow-slate-900/20 ring-1 ring-slate-200 sm:max-h-[calc(100dvh-6rem)]"
             @onclick:stopPropagation="true">
            <div class="flex items-start justify-between gap-4 border-b border-slate-100 px-5 py-4 sm:px-6">
                <div class="min-w-0">
                    @if (!string.IsNullOrWhiteSpace(Eyebrow))
                    {
                        <p class="mb-0 text-xs font-semibold text-slate-500">@Eyebrow</p>
                    }
                    <h2 class="mb-0 mt-0.5 text-lg font-bold text-slate-900">@Title</h2>
                </div>
                <button type="button"
                        class="grid h-9 w-9 shrink-0 place-items-center rounded-xl text-slate-500 transition hover:bg-slate-100 hover:text-slate-900"
                        aria-label="Fermer"
                        @onclick="CloseAsync">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="mx-5 mt-4 flex items-start gap-3 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium leading-6 text-rose-800 sm:mx-6"
                     role="alert"
                     aria-live="assertive">
                    <svg class="mt-0.5 h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.3 3.9 2.6 17.2A2 2 0 0 0 4.3 20h15.4a2 2 0 0 0 1.7-2.8L13.7 3.9a2 2 0 0 0-3.4 0Z" />
                    </svg>
                    <span>@ErrorMessage</span>
                </div>
            }
            <div class="@(ScrollBody ? "skoulou-modal-scroll" : "overflow-visible") px-5 py-5 sm:px-6">
                @ChildContent
            </div>
        </div>
    </div>
}
