@using Microsoft.AspNetCore.Components
@using SkoulouApp.Core.Models.Handbuch

<section class="rounded-[2rem] bg-white p-6 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 sm:p-8">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
        <div>
            <p class="text-sm font-semibold uppercase tracking-[0.16em] @AccentTextClass">@EffectiveEyebrow</p>
            <h2 class="mt-2 text-2xl font-black text-slate-900">@EffectiveTitle</h2>
        </div>
        <a href="@EffectiveLink" class="rounded-full px-4 py-2 text-center text-sm font-bold no-underline @ButtonClass">@EffectiveLinkLabel</a>
    </div>
    <div class="guide-panel-content mt-6 space-y-4 text-sm leading-7 text-slate-700">
        @if (Panel is not null)
        {
            <p>@Panel.Summary</p>
            <div class="grid gap-5 lg:grid-cols-[1fr_1fr]">
                <div class="rounded-2xl bg-slate-50 p-4 ring-1 ring-slate-100">
                    <h3 class="font-black text-slate-900">Parcours conseillé</h3>
                    <ol class="mt-3 space-y-2">
                        @foreach (var step in Panel.Steps.Select((value, index) => new { value, index }))
                        {
                            <li class="flex gap-3"><span class="grid h-6 w-6 shrink-0 place-items-center rounded-full @PillClass text-xs font-black text-white">@(step.index + 1)</span><span>@step.value</span></li>
                        }
                    </ol>
                </div>
                <div class="rounded-2xl bg-slate-950 p-4 text-slate-100 shadow-xl">
                    <div class="flex items-center justify-between border-b border-white/10 pb-3 text-xs font-bold text-slate-300"><span>Interface · @Panel.Title</span><span class="rounded-full bg-white/10 px-2 py-1">Aperçu</span></div>
                    <div class="mt-4 grid gap-3">
                        @foreach (var slice in Panel.UiSlices)
                        {
                            <article class="rounded-xl bg-white/8 p-3 ring-1 ring-white/10">
                                <p class="font-bold text-white">@slice.Title</p>
                                <p class="mt-1 text-xs leading-5 text-slate-300">@slice.Description</p>
                                <div class="mt-2 flex flex-wrap gap-1.5">
                                    @foreach (var highlight in slice.Highlights)
                                    {
                                        <span class="rounded-full bg-white/10 px-2 py-1 text-[0.7rem] font-semibold text-cyan-100">@highlight</span>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </div>
            </div>
            @if (Panel.Notes.Count > 0)
            {
                <div class="rounded-2xl bg-amber-50 p-4 text-amber-950 ring-1 ring-amber-100">
                    <h3 class="font-black">Points importants</h3>
                    <ul class="mt-2 list-disc space-y-1 pl-5">
                        @foreach (var note in Panel.Notes)
                        {
                            <li>@note</li>
                        }
                    </ul>
                </div>
            }
        }
        else
        {
            @ChildContent
        }
    </div>
    <div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 p-4">
        <div class="flex items-center justify-between border-b border-slate-200 pb-3 text-xs font-bold text-slate-600"><span>SKOULOUAPP · @EffectiveTitle</span><span class="rounded-full bg-white px-2 py-1">Vue guidée</span></div>
        <div class="mt-4 grid gap-3 sm:grid-cols-3"><div class="h-16 rounded-xl bg-white shadow-sm"></div><div class="h-16 rounded-xl bg-white shadow-sm"></div><div class="h-16 rounded-xl bg-white shadow-sm"></div></div>
    </div>
</section>

@code {
    [Parameter] public HandbuchPanel? Panel { get; set; }
    [Parameter] public string Eyebrow { get; set; } = string.Empty;
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Accent { get; set; } = string.Empty;
    [Parameter] public string Link { get; set; } = string.Empty;
    [Parameter] public string LinkLabel { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string EffectiveEyebrow => Panel?.Eyebrow ?? Eyebrow;
    private string EffectiveTitle => Panel?.Title ?? Title;
    private string EffectiveAccent => Panel?.Accent ?? Accent;
    private string EffectiveLink => Panel?.Link ?? Link;
    private string EffectiveLinkLabel => Panel?.LinkLabel ?? LinkLabel;

    private string AccentTextClass => EffectiveAccent switch
    {
        "emerald" => "text-emerald-700",
        "amber" => "text-amber-700",
        "indigo" => "text-indigo-700",
        "violet" => "text-violet-700",
        "rose" => "text-rose-700",
        _ => "text-slate-700"
    };

    private string ButtonClass => EffectiveAccent switch
    {
        "emerald" => "bg-emerald-600 text-white",
        "amber" => "bg-amber-500 text-white",
        "indigo" => "bg-indigo-600 text-white",
        "violet" => "bg-violet-600 text-white",
        "rose" => "bg-rose-600 text-white",
        _ => "bg-slate-800 text-white"
    };

    private string PillClass => EffectiveAccent switch
    {
        "emerald" => "bg-emerald-600",
        "amber" => "bg-amber-500",
        "indigo" => "bg-indigo-600",
        "violet" => "bg-violet-600",
        "rose" => "bg-rose-600",
        _ => "bg-slate-800"
    };
}
