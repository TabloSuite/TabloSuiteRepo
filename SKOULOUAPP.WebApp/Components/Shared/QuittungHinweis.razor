@* Nach dem Erfassen einer Schulgeldzahlung: Reçu direkt öffnen/drucken. *@
@if (ZahlungID is Guid id)
{
    <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900" role="status">
        <span class="inline-flex items-center gap-2 font-semibold"><Icon Name="check" Groesse="18" />Paiement enregistré. Le reçu est prêt.</span>
        <span class="flex items-center gap-2">
            <a href="/finanzen/recu/@id" target="_blank" rel="noopener" class="inline-flex min-h-[2.5rem] items-center gap-2 rounded-xl bg-emerald-700 px-4 font-semibold text-white no-underline hover:bg-emerald-800"><Icon Name="printer" Groesse="16" />Imprimer le reçu</a>
            <button type="button" class="rounded-lg px-2 py-1 text-emerald-800 hover:bg-emerald-100" aria-label="Fermer" @onclick="SchliessenAsync"><Icon Name="x" Groesse="16" /></button>
        </span>
    </div>
}

@code {
    [Parameter] public Guid? ZahlungID { get; set; }
    [Parameter] public EventCallback<Guid?> ZahlungIDChanged { get; set; }

    private Task SchliessenAsync() => ZahlungIDChanged.InvokeAsync(null);
}
