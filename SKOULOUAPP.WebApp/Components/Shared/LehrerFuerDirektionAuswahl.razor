@namespace SkoulouApp.WebApp.Components.Shared
@using SkoulouApp.Core.Models.TeacherLessons

@* Direktion: « Saisir pour l'enseignant : … » – Lektionen, Übungen und Prüfungen im Namen
   eines Lehrers ohne Gerät erfassen. Ohne Auswahl bleibt die gewohnte Direktionsansicht.
   Die Seite prüft jede Auswahl und die Dienste jede Schreibaktion serverseitig erneut. *@
<section class="rounded-2xl border border-violet-200 bg-violet-50/70 p-4" aria-label="Saisie pour un enseignant">
    <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
        <ModernDropdown TValue="Guid?"
                        Label="Saisir pour l'enseignant :"
                        Value="Value"
                        ValueChanged="ValueChanged"
                        Options="Optionen"
                        Placeholder="@KeineAuswahlText"
                        EmptyText="Aucun enseignant actif dans votre école."
                        Searchable="@(Lehrer.Count > 6)"
                        SearchPlaceholder="Rechercher un enseignant..." />
        @if (Value.HasValue)
        {
            <button type="button" class="sk-btn sk-btn-secondary" @onclick="() => ValueChanged.InvokeAsync(null)">
                <Icon Name="x" Groesse="14" />Revenir à la vue direction
            </button>
        }
    </div>

    @if (Value.HasValue)
    {
        <p class="mb-0 mt-3 text-sm leading-6 text-violet-900">
            Vous travaillez pour <strong>@AusgewaehlterName</strong> : ses classes et ses matières sont utilisées.
            Les contenus enregistrés lui sont attribués et marqués <Badge Accent="violet">@DirektionsErfassungService.Kennzeichnung</Badge>.
            Aucune confirmation de l'enseignant n'est nécessaire.
        </p>
        @if (ChildContent is not null)
        {
            <div class="mt-3 flex flex-wrap gap-2">@ChildContent</div>
        }
    }
    else
    {
        <p class="mb-0 mt-2 text-xs leading-5 text-violet-800">
            Pour un enseignant sans appareil : choisissez-le pour créer, modifier, publier ou supprimer ses leçons, exercices et examens à sa place.
        </p>
    }
</section>

@code {
    private const string KeineAuswahlText = "— Aucun (vue direction) —";

    /// <summary>Lehrkräfte, für die die Direktion erfassen darf.</summary>
    [Parameter] public IReadOnlyList<LehrerAuswahlItem> Lehrer { get; set; } = [];

    [Parameter] public Guid? Value { get; set; }

    [Parameter] public EventCallback<Guid?> ValueChanged { get; set; }

    /// <summary>Optionale Aktionen (z. B. Links zu den anderen Erfassungsseiten), nur bei Auswahl sichtbar.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string AusgewaehlterName => Lehrer.FirstOrDefault(lehrer => lehrer.Id == Value)?.Name ?? "l'enseignant";

    private IReadOnlyList<ModernDropdownOption<Guid?>> Optionen =>
    [
        new(null, KeineAuswahlText),
        .. Lehrer.Select(lehrer => new ModernDropdownOption<Guid?>(lehrer.Id, lehrer.Name))
    ];
}
