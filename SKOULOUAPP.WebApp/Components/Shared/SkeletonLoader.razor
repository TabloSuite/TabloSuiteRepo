@* Wiederverwendbarer Skeleton-Loader für Ladezustände auf Schüler-Seiten.
   Zeigt einen animierten Platzhalter-Hero-Bereich plus Karten-Raster,
   damit Ladezeiten weniger abrupt wirken als ein reiner Text-Hinweis. *@
<div class="grid gap-6" aria-busy="true" aria-live="polite">
    <div class="rounded-[2rem] bg-white p-6 shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 sm:p-8">
        <div class="skeleton-block h-4 w-40"></div>
        <div class="skeleton-block mt-4 h-8 w-72"></div>
        <div class="skeleton-block mt-3 h-4 w-full max-w-md"></div>
        @if (ShowStatRow)
        {
            <div class="mt-6 grid gap-3 sm:grid-cols-3">
                <div class="skeleton-block h-16 w-full"></div>
                <div class="skeleton-block h-16 w-full"></div>
                <div class="skeleton-block h-16 w-full"></div>
            </div>
        }
    </div>

    @if (CardCount > 0)
    {
        <div class="grid gap-4 xl:grid-cols-2">
            @for (var i = 0; i < CardCount; i++)
            {
                <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-lg shadow-slate-200/70">
                    <div class="skeleton-block h-3 w-24"></div>
                    <div class="skeleton-block mt-2 h-5 w-3/4"></div>
                    <div class="skeleton-block mt-3 h-3 w-full"></div>
                    <div class="skeleton-block mt-1 h-3 w-5/6"></div>
                    <div class="skeleton-block mt-4 h-2 w-full"></div>
                    <div class="skeleton-block mt-4 h-9 w-32"></div>
                </div>
            }
        </div>
    }
</div>

@code {
    /// <summary>Anzahl der Platzhalter-Karten unterhalb des Hero-Bereichs (0 = keine).</summary>
    [Parameter] public int CardCount { get; set; } = 4;

    /// <summary>Zeigt eine Reihe von Statistik-Platzhaltern im Hero-Bereich.</summary>
    [Parameter] public bool ShowStatRow { get; set; } = true;
}
