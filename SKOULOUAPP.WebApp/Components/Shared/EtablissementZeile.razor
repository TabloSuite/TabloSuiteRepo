@* Zeigt das (einzige) Établissement eines Formulars fest an – ein Konto gehört zu genau einer Schule. *@
<div class="sm:col-span-2">
    <span class="skoulou-label">Établissement</span>
    @if (Schulen.Count > 0)
    {
        <p class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-800">
            @Schulen[0].SchoolName
            @if (!string.IsNullOrWhiteSpace(Schulen[0].City))
            {
                <span class="font-normal text-slate-500"> · @Schulen[0].City</span>
            }
        </p>
        <p class="mt-1 text-xs text-slate-500">Le compte est créé dans votre établissement.</p>
    }
    else
    {
        <p class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-800">Aucun établissement n'est associé à votre compte.</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TeacherSchoolOverview> Schulen { get; set; } = [];
}
