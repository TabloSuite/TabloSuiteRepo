@using SkoulouApp.Core.DataModels.Unterricht
@inherits SkoulouApp.WebApp.Components.CancelableComponentBase

@* Conseil de classe: Distinctions, Sanctions, Appréciation und Décision je Schüler einer Klasse und Periode. *@
<div class="grid gap-4">
    <div class="grid gap-3 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] md:items-end">
        <ModernDropdown TValue="Guid" Value="periodeID" ValueChanged="PeriodeAsync" Options="PeriodenOptionen" Label="Période" Disabled="laedt" />
        <ModernDropdown TValue="Guid" Value="klasseID" ValueChanged="KlasseAsync" Options="KlassenOptionen" Label="Classe" Searchable="true" Disabled="laedt" />
        <button type="button" class="min-h-[2.75rem] rounded-xl border border-slate-300 bg-white px-4 font-semibold text-slate-800 disabled:opacity-50" disabled="@(laedt || periodeID == Guid.Empty || klasseID == Guid.Empty)" @onclick="LadenAsync">Afficher la classe</button>
    </div>

    @if (!string.IsNullOrEmpty(meldung))
    {
        <p class="mb-0 rounded-xl px-4 py-3 text-sm @(fehler ? "border border-rose-200 bg-rose-50 text-rose-800" : "border border-emerald-200 bg-emerald-50 text-emerald-800")" role="status">@meldung</p>
    }

    @if (zeilen.Count > 0)
    {
        <p class="mb-0 text-sm text-slate-500">Sans choix, la distinction est proposée selon la moyenne : 12 tableau d'honneur, 14 encouragements, 16 félicitations. Les bulletins déjà publiés ne changent pas.</p>
        <div class="grid gap-3">
            @foreach (var zeile in zeilen)
            {
                <article class="grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm lg:grid-cols-[minmax(0,12rem)_minmax(0,14rem)_minmax(0,1fr)]">
                    <div>
                        <p class="mb-0 font-bold text-slate-900">@zeile.Schueler</p>
                        <p class="mb-0 mt-1 text-sm text-slate-500">Moyenne <strong class="tabular-nums text-slate-800">@BulletinTexte.Note(zeile.Moyenne)</strong> · Rang <strong>@BulletinTexte.Rang(zeile.Rang)</strong></p>
                    </div>
                    <div class="grid gap-2">
                        <ModernDropdown TValue="string" Value="zeile.Distinktion" ValueChanged="v => zeile.Distinktion = v ?? Auto" Options="DistinktionOptionen(zeile.Vorschlag)" Label="Distinction" ButtonClass="py-2" />
                        <ModernDropdown TValue="Jahresentscheidung" @bind-Value="zeile.Entscheidung" Options="EntscheidungOptionen" Label="Décision de fin d'année" ButtonClass="py-2" />
                    </div>
                    <div class="grid gap-2">
                        <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
                            @foreach (var (wert, text) in BulletinTexte.Sanktionen)
                            {
                                <label class="inline-flex items-center gap-2"><input type="checkbox" checked="@zeile.Sanktionen.HasFlag(wert)" @onchange="e => zeile.Sanktion(wert, e.Value is true)" />@text</label>
                            }
                        </div>
                        <label class="text-sm font-semibold text-slate-700">Appréciation du conseil
                            <input class="skoulou-input mt-1" maxlength="300" @bind="zeile.Bemerkung" placeholder="ex. Bon trimestre, continuez ainsi." />
                        </label>
                    </div>
                </article>
            }
        </div>
        <div>
            <button type="button" class="rounded-xl bg-blue-700 px-5 py-2.5 font-semibold text-white disabled:opacity-60" disabled="@laedt" @onclick="SpeichernAsync">Enregistrer les décisions du conseil</button>
        </div>
    }
    else if (geladen)
    {
        <p class="mb-0 text-sm text-slate-500">Aucun élève dans cette classe pour l'année scolaire choisie.</p>
    }
</div>
