@using HalloApp.Core.Models.Import

@if (Preview is not null)
{
    <div class="@(Preview.Succeeded ? "rounded-2xl bg-emerald-50 p-3 text-sm text-emerald-900 ring-1 ring-emerald-100" : "rounded-2xl bg-rose-50 p-3 text-sm text-rose-900 ring-1 ring-rose-100")">
        <p class="font-bold">@Preview.ValidRowCount ligne(s) valide(s), @Preview.ErrorRowCount ligne(s) avec erreur(s)</p>

        @if (Preview.Errors.Count > 0)
        {
            <ul class="mt-2 list-disc pl-5 text-xs">
                @foreach (var error in Preview.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        }

        <div class="mt-3 max-h-72 overflow-auto rounded-xl bg-white ring-1 ring-slate-100">
            <table class="min-w-full text-left text-xs">
                <thead class="sticky top-0 z-10 border-b border-slate-100 bg-slate-50/95 text-slate-500 backdrop-blur">
                    <tr>
                        <th class="px-3 py-2 font-semibold uppercase tracking-wide">Ligne</th>
                        <th class="px-3 py-2 font-semibold uppercase tracking-wide">Nom</th>
                        <th class="px-3 py-2 font-semibold uppercase tracking-wide">Classe</th>
                        <th class="px-3 py-2 font-semibold uppercase tracking-wide">Email</th>
                        <th class="px-3 py-2 font-semibold uppercase tracking-wide">Statut</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    @foreach (var row in Preview.Rows.Take(20))
                    {
                        <tr class="transition-colors duration-150 odd:bg-white even:bg-slate-50/40 hover:bg-cyan-50/60">
                            <td class="px-3 py-2 font-semibold">@row.LineNumber</td>
                            <td class="px-3 py-2">@($"{row.Vorname} {row.Nachname}".Trim())</td>
                            <td class="px-3 py-2">@row.Klasse</td>
                            <td class="px-3 py-2">@(row.EmailGenerated ? $"{row.Email} (auto)" : row.Email)</td>
                            <td class="@(row.IsValid ? "px-3 py-2 font-semibold text-emerald-700" : "px-3 py-2 font-semibold text-rose-700")">
                                @(row.IsValid ? "OK" : string.Join(" ", row.Errors))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Preview.Rows.Count > 20)
        {
            <p class="mt-2 text-xs font-semibold text-slate-500">Aperçu limité aux 20 premières lignes sur @Preview.Rows.Count.</p>
        }
    </div>
}

@code {
    [Parameter]
    public SchoolUserImportPreviewResult? Preview { get; set; }
}
