@typeparam TItem

<div class="grid gap-4">
    <div class="grid gap-3">
    @HeaderContent
    <div class="flex flex-wrap items-center gap-3">
        <label class="relative m-0 min-w-[14rem] flex-1">
            <span class="sr-only">@SearchPlaceholder</span>
            <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"><Icon Name="search" Groesse="18" /></span>
            <input type="search"
                   value="@searchText"
                   @oninput="OnSearchChanged"
                   placeholder="@SearchPlaceholder"
                   class="skoulou-input"
                   style="padding-left: 2.6rem" />
        </label>
        @if (SortOptions is { Count: > 0 } && !ServerPaging)
        {
            <div class="flex items-center gap-2">
                <span class="text-xs font-semibold text-slate-500">Trier par</span>
                <ModernDropdown TValue="string"
                                ContainerClass="w-60 max-w-full"
                                Options="sortDropdownOptions"
                                Value="@(activeSortKey ?? SortOptions[0].Key)"
                                ValueChanged="OnSortValueChanged" />
            </div>
        }
        <span class="rounded-full bg-slate-100 px-3 py-1.5 text-sm font-semibold tabular-nums text-slate-700">
            @AnzeigeAnzahl @(DisplayCount == 1 ? ResultLabelSingular : ResultLabelPlural)
        </span>
    </div>

    @if (Chips is { Count: > 0 })
    {
        <div class="flex flex-wrap gap-2">
            @foreach (var chip in Chips)
            {
                var isActive = activeChipKey == chip.Key;
                <button type="button"
                        class="@ChipClass(isActive, chip.Accent)"
                        @onclick="() => SelectChip(chip.Key)">
                    @chip.Label
                    @if (chip.Count is int c)
                    {
                        <span class="@ChipCountClass(isActive)">@c</span>
                    }
                </button>
            }
        </div>
    }

    </div>

    @if (FilteredCount == 0)
    {
        <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 px-4 py-8 text-center text-sm text-slate-500">
            @EmptyText
        </div>
    }
    else
    {
        @if (Scroll)
        {
            <div class="sk-liste-scroll p-1">
                @ChildContent(PageItems)
            </div>
        }
        else
        {
            @ChildContent(PageItems)
        }

        @if (ServerPaging)
        {
            @if (HasMore)
            {
                <div class="sk-liste-mehr">
                    <AsyncActionButton Class="sk-btn sk-btn-sm sk-btn-secondary" IsBusy="mehrLaedt" BusyLabel="Chargement..." OnClick="LoadMoreAsync">Afficher plus</AsyncActionButton>
                </div>
            }
        }
        else if (PageCount > 1)
        {
            <div class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4">
                <div class="text-sm text-slate-500">
                    Page @(CurrentPage + 1) / @PageCount
                </div>
                <div class="flex items-center gap-2">
                    <button type="button"
                            class="sk-btn sk-btn-sm sk-btn-secondary"
                            disabled="@(CurrentPage == 0)"
                            @onclick="PreviousPage">
                        Précédent
                    </button>
                    <button type="button"
                            class="sk-btn sk-btn-sm sk-btn-secondary"
                            disabled="@(CurrentPage >= PageCount - 1)"
                            @onclick="NextPage">
                        Suivant
                    </button>
                </div>
            </div>
        }
    }
</div>
