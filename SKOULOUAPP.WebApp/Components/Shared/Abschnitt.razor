@* Inhaltskarte im neuen Design (wie Tableau de bord): Kopf mit Icon, Titel, Untertitel und Aktionen rechts, darunter der Inhalt. *@
<section class="rounded-2xl border border-slate-200 bg-white shadow-sm @Class" aria-label="@Titel">
    @if (!string.IsNullOrWhiteSpace(Titel) || Aktionen is not null)
    {
        <header class="flex flex-wrap items-start justify-between gap-3 border-b border-slate-100 px-5 py-4 sm:px-6">
            <div class="flex min-w-0 items-start gap-3">
                @if (!string.IsNullOrWhiteSpace(IconName))
                {
                    <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-blue-50 text-blue-700"><Icon Name="@IconName" Groesse="18" /></span>
                }
                <div class="min-w-0">
                    <h2 class="mb-0 text-base font-bold text-slate-900 sm:text-lg">@Titel</h2>
                    @if (!string.IsNullOrWhiteSpace(Untertitel))
                    {
                        <p class="mb-0 mt-0.5 text-sm text-slate-500">@Untertitel</p>
                    }
                </div>
            </div>
            @if (Aktionen is not null)
            {
                <div class="flex flex-wrap items-center gap-2">@Aktionen</div>
            }
        </header>
    }
    <div class="px-5 py-5 sm:px-6">
        @ChildContent
    </div>
</section>

@code {
    [Parameter] public string? Titel { get; set; }
    [Parameter] public string? Untertitel { get; set; }
    [Parameter] public string? IconName { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? Aktionen { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
