@namespace HalloApp.WebApp.Components.Shared

<div class="halloapp-richtext @(Paged ? "halloapp-richtext--paged" : null)" style="@ContainerStyle">
    @if (EnableLargeEditor && !ReadOnly)
    {
        <div class="mb-2 flex justify-end">
            <button type="button"
                    class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-200"
                    @onclick="OpenLargeEditorAsync">
                ⛶ Agrandir l’éditeur
            </button>
        </div>
    }
    <div @ref="editorElement"></div>
</div>

@if (modalGeoeffnet)
{
    <div class="fixed inset-0 z-[2200] flex items-center justify-center bg-slate-950/60 p-6 sm:p-8" role="dialog" aria-modal="true" aria-label="Éditeur agrandi">
        <div class="hallo-modal-surface halloapp-large-editor-modal flex h-[96dvh] w-full max-w-6xl flex-col rounded-3xl bg-white p-4 shadow-2xl sm:p-6">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-4">
                <div>
                    <h2 class="text-lg font-black text-slate-900">Éditeur agrandi</h2>
                    <p class="mt-1 text-xs text-slate-500">Les modifications sont appliquées seulement après «&nbsp;Reprendre le texte&nbsp;».</p>
                </div>
                <button type="button" class="rounded-full bg-slate-100 px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-200" @onclick="CancelLargeEditor">Fermer</button>
            </div>
            <div class="halloapp-large-editor-body min-h-0 flex-1 py-4">
                <RichTextEditor @ref="modalEditor"
                                Value="@modalEntwurf"
                                ValueChanged="@(value => modalEntwurf = value)"
                                Placeholder="@Placeholder"
                                EnableImages="@EnableImages"
                                 RequestImageLibrary="@RequestImageLibrary"
                                 ImageLibraryTargetRequested="@ImageLibraryTargetRequested"
                                Paged="@Paged"
                                EnableLargeEditor="false"
                                DefaultFont="@DefaultFont"
                                DefaultSize="@DefaultSize" />
            </div>
            <div class="flex flex-wrap justify-end gap-3 border-t border-slate-100 pt-4">
                <button type="button" class="rounded-full bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-200" @onclick="CancelLargeEditor">Annuler</button>
                <button type="button" class="rounded-full bg-violet-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-violet-200 hover:bg-violet-700" @onclick="ApplyLargeEditorAsync">Reprendre le texte</button>
            </div>
        </div>
    </div>
}
