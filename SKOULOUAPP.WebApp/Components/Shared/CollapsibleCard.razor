@using Microsoft.AspNetCore.Components

<div class="group/card overflow-hidden rounded-[2rem] bg-white shadow-lg shadow-slate-200/70 ring-1 ring-slate-100 transition-shadow duration-300 hover:shadow-xl hover:shadow-slate-200/80">
    <div class="flex w-full flex-wrap items-center justify-between gap-3 px-4 py-4 transition duration-200 hover:bg-slate-50/80 sm:flex-nowrap sm:gap-4 sm:px-6 sm:py-5">
        <button type="button"
                class="flex min-w-0 flex-1 items-center gap-3 text-left sm:gap-4"
                @onclick="ToggleAsync"
                aria-expanded="@IsExpanded">
            @if (!string.IsNullOrWhiteSpace(Icon))
            {
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl shadow-sm transition-transform duration-300 group-hover/card:scale-105 @IconWrapperClass sm:h-11 sm:w-11">
                    <span class="text-lg font-black">@Icon</span>
                </div>
            }
            <div class="min-w-0 flex-1">
                @if (!string.IsNullOrWhiteSpace(Eyebrow))
                {
                    <p class="text-xs font-semibold uppercase tracking-[0.1em] @EyebrowClass sm:tracking-[0.18em]">@Eyebrow</p>
                }
                <h2 class="mt-1 truncate text-lg font-bold text-slate-900 sm:text-xl">@Title</h2>
                @if (!string.IsNullOrWhiteSpace(Subtitle))
                {
                    <p class="mt-0.5 truncate text-sm text-slate-500">@Subtitle</p>
                }
            </div>
        </button>
        <div class="flex min-w-0 flex-wrap items-center justify-end gap-2 sm:flex-nowrap sm:gap-3">
            @if (HeaderRight is not null)
            {
                @HeaderRight
            }
            <button type="button"
                    class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-500 transition-all duration-300 hover:bg-slate-200 hover:text-slate-700 @(IsExpanded ? "rotate-180" : "")"
                    @onclick="ToggleAsync"
                    aria-expanded="@IsExpanded"
                    aria-label="@(IsExpanded ? "Réduire" : "Développer")">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                </svg>
            </button>
        </div>
    </div>

    <div class="grid transition-all duration-300 ease-in-out @(IsExpanded ? "grid-rows-[1fr] opacity-100" : "grid-rows-[0fr] opacity-0")">
        <div class="overflow-hidden">
            <div class="border-t border-slate-100 bg-gradient-to-b from-slate-50/40 to-transparent px-6 pb-6 pt-5">
                @ChildContent
            </div>
        </div>
    </div>
</div>
