@namespace SkoulouApp.WebApp.Components.Shared
@typeparam TValue
@inherits ModernDropdownBase<TValue>

<div class="relative min-w-0 @ContainerClass">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="mb-2 block text-sm font-semibold text-slate-700">@Label</label>
    }

    <button type="button"
            class="flex w-full min-w-0 items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-3 text-left text-sm text-slate-700 shadow-sm shadow-slate-200/40 outline-none transition duration-200 hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md focus:border-indigo-400 focus:ring-4 focus:ring-indigo-100 disabled:cursor-not-allowed disabled:bg-slate-50 disabled:text-slate-400 @ButtonClass"
            disabled="@Disabled"
            @onclick="ToggleAsync">
        <span class="min-w-0">
            <span class="block truncate @(SelectedOption is null ? "text-slate-400" : "font-semibold text-slate-900")">@(SelectedOption?.Label ?? Placeholder)</span>
            @if (!string.IsNullOrWhiteSpace(SelectedOption?.Description))
            {
                <span class="mt-0.5 block truncate text-xs text-slate-500">@SelectedOption.Description</span>
            }
        </span>
        <span class="inline-flex items-center gap-2">
            @if (!string.IsNullOrWhiteSpace(SelectedOption?.Badge))
            {
                <span class="rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-bold text-indigo-700">@SelectedOption.Badge</span>
            }
            <svg class="h-4 w-4 shrink-0 text-slate-400 transition @(isOpen ? "rotate-180" : string.Empty)" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
        </span>
    </button>

    @if (isOpen)
    {
        <div class="fixed inset-0 z-[3990]" @onclick="CloseAsync"></div>
        <div class="absolute left-0 right-0 z-[4000] max-h-72 overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-2xl shadow-slate-900/15 @(OpenUpward ? "bottom-full mb-2" : "mt-2")">
            @if (Options.Count == 0)
            {
                <div class="px-4 py-3 text-sm text-slate-500">@EmptyText</div>
            }
            else
            {
                @if (Searchable)
                {
                    <div class="border-b border-slate-100 p-2">
                        <input type="search"
                               @bind="searchTerm"
                               @bind:event="oninput"
                               placeholder="@SearchPlaceholder"
                               aria-label="@SearchPlaceholder"
                               class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-800 outline-none transition focus:border-indigo-400 focus:bg-white focus:ring-2 focus:ring-indigo-100" />
                    </div>
                }
                <div class="max-h-72 overflow-y-auto p-1.5">
                    @if (!FilteredOptions.Any())
                    {
                        <div class="px-3 py-2.5 text-sm text-slate-500">Aucun résultat.</div>
                    }
                    @foreach (var option in FilteredOptions)
                    {
                        var isSelected = EqualityComparer<TValue?>.Default.Equals(option.Value, Value);
                        <button type="button"
                                class="flex w-full items-start justify-between gap-3 rounded-xl px-3 py-2.5 text-left text-sm transition @(isSelected ? "bg-indigo-50 text-indigo-900" : "text-slate-700 hover:bg-slate-50")"
                                @onclick="() => SelectAsync(option)">
                            <span class="min-w-0">
                                <span class="block truncate font-semibold">@option.Label</span>
                                @if (!string.IsNullOrWhiteSpace(option.Description))
                                {
                                    <span class="mt-0.5 block truncate text-xs @(isSelected ? "text-indigo-600" : "text-slate-500")">@option.Description</span>
                                }
                            </span>
                            <span class="inline-flex shrink-0 items-center gap-2">
                                @if (!string.IsNullOrWhiteSpace(option.Badge))
                                {
                                    <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-bold text-slate-600">@option.Badge</span>
                                }
                                @if (isSelected)
                                {
                                    <svg class="h-4 w-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="2.3" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                                    </svg>
                                }
                            </span>
                        </button>
                    }
                </div>
            }
        </div>
    }
</div>
