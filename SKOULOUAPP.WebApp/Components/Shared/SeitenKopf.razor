@* Einheitlicher Seitenkopf (Verlauf wie eNOTE): Rubrik, Titel, Untertitel, optionale Aktionen rechts. *@
<header class="skoulou-hero relative overflow-hidden rounded-[1.25rem] px-5 py-4 text-white sm:px-6 sm:py-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex min-w-0 items-center gap-3">
            @if (!string.IsNullOrWhiteSpace(IconName))
            {
                <span class="hidden h-11 w-11 shrink-0 place-items-center rounded-xl bg-white/15 sm:grid"><Icon Name="@IconName" /></span>
            }
            <div class="min-w-0">
                @if (!string.IsNullOrWhiteSpace(Rubrik))
                {
                    <p class="mb-0 text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-white/70">@Rubrik</p>
                }
                <h1 class="mb-0 mt-0.5 text-xl font-bold leading-tight sm:text-2xl">@Titel</h1>
                @if (!string.IsNullOrWhiteSpace(Untertitel))
                {
                    <p class="mb-0 mt-1 max-w-3xl text-sm text-white/80">@Untertitel</p>
                }
            </div>
        </div>
        @if (ChildContent is not null)
        {
            <div class="flex flex-wrap items-center gap-2">@ChildContent</div>
        }
    </div>
</header>

@code {
    [Parameter, EditorRequired] public string Titel { get; set; } = string.Empty;
    [Parameter] public string? Rubrik { get; set; }
    [Parameter] public string? Untertitel { get; set; }
    [Parameter] public string? IconName { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
