@* Reiterleiste im neuen Design: weiße Leiste, aktiver Reiter in der Primärfarbe, optional Anzahl und Hinweiszahl (z. B. « en attente »). *@
<div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white p-1.5 shadow-sm">
    <nav class="flex min-w-max gap-1" role="tablist" aria-label="@AriaLabel">
        @foreach (var eintrag in Eintraege)
        {
            var aktiv = eintrag.Schluessel == Aktiv;
            <button type="button" role="tab" aria-selected="@(aktiv ? "true" : "false")" data-reiter="@eintrag.Schluessel"
                    class="inline-flex min-h-[2.5rem] items-center gap-2 whitespace-nowrap rounded-xl px-3.5 text-sm font-semibold transition @(aktiv ? "bg-blue-50 text-blue-800 ring-1 ring-inset ring-blue-200" : "text-slate-600 hover:bg-slate-50 hover:text-slate-900")"
                    @onclick="() => AktivChanged.InvokeAsync(eintrag.Schluessel)">
                @if (!string.IsNullOrWhiteSpace(eintrag.Icon))
                {
                    <Icon Name="@eintrag.Icon" Groesse="16" />
                }
                <span>@eintrag.Text</span>
                @if (eintrag.Anzahl is int anzahl)
                {
                    <span class="rounded-full px-2 py-0.5 text-xs font-bold tabular-nums @(aktiv ? "bg-white text-blue-800" : "bg-slate-100 text-slate-600")">@anzahl</span>
                }
                @if (eintrag.Hinweis is int hinweis && hinweis > 0)
                {
                    <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-bold tabular-nums text-amber-800" title="@eintrag.HinweisTitel">@hinweis</span>
                }
            </button>
        }
    </nav>
</div>

@code {
    /// <summary>Ein Reiter: Schlüssel, Beschriftung, Icon, optionale Anzahl und Hinweiszahl (amber, nur wenn &gt; 0).</summary>
    public sealed record Eintrag(string Schluessel, string Text, string? Icon = null, int? Anzahl = null, int? Hinweis = null, string? HinweisTitel = null);

    [Parameter, EditorRequired] public IReadOnlyList<Eintrag> Eintraege { get; set; } = [];
    [Parameter] public string? Aktiv { get; set; }
    [Parameter] public EventCallback<string> AktivChanged { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Navigation";
}
