@using System.Security.Claims
@using HalloApp.Core.DataModels.Identity
@using HalloApp.Core.Interfaces
@using HalloApp.Core.Models.Media
@using HalloApp.Core.Services.Storage
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@inject IBlobMediaLibraryService MediaLibrary
@inject IHalloAppDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider

@if (Open)
{
    <div class="fixed inset-0 z-[2200] flex items-center justify-center bg-slate-950/60 p-6 sm:p-8" role="dialog" aria-modal="true" aria-label="Bibliothèque d’images">
        <div class="hallo-modal-surface flex max-h-[92dvh] w-full max-w-6xl flex-col rounded-3xl bg-white p-4 shadow-2xl sm:p-6">
            <div class="flex items-start justify-between gap-4 border-b border-slate-100 pb-4">
                <div>
                    <p class="text-xs font-bold uppercase tracking-wider text-cyan-700">Médiathèque sécurisée</p>
                    <h2 class="text-xl font-black text-slate-900">Bibliothèque d’images</h2>
                    <p class="mt-1 text-xs text-slate-500">Images privées déjà enregistrées pour les leçons. L’insertion directe par fichier dans l’éditeur est désactivée.</p>
                </div>
                <button type="button" class="rounded-full bg-slate-100 px-4 py-2 text-xs font-semibold text-slate-700" @onclick="CloseAsync">Fermer</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <p class="mt-4 rounded-2xl bg-rose-50 px-4 py-3 text-sm text-rose-800">@errorMessage</p>
            }

            <div class="mt-4 grid gap-4 rounded-2xl bg-slate-50 p-4 lg:grid-cols-4">
                <label>
                    <span class="text-xs font-semibold text-slate-600">École</span>
                    <select class="mt-1 hallo-input text-sm" @bind="selectedSchoolId" @bind:after="OnSchoolChangedAsync">
                        @foreach (var school in schools)
                        {
                            <option value="@school.Id">@school.Name</option>
                        }
                    </select>
                </label>
                <label>
                    <span class="text-xs font-semibold text-slate-600">Classe / niveau</span>
                    <select class="mt-1 hallo-input text-sm" @bind="selectedKlasseId">
                        <option value="">Sans classe</option>
                        @foreach (var klasse in klasseOptions)
                        {
                            <option value="@klasse.Id">@klasse.Code</option>
                        }
                    </select>
                </label>
                <label>
                    <span class="text-xs font-semibold text-slate-600">Nom de l’image</span>
                    <input class="mt-1 hallo-input text-sm" @bind="displayName" placeholder="Ex. triangle rectangle" />
                </label>
                <label>
                    <span class="text-xs font-semibold text-slate-600">Texte alternatif</span>
                    <input class="mt-1 hallo-input text-sm" @bind="altText" placeholder="Description de l’image" />
                </label>
                <div class="lg:col-span-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-dashed border-cyan-200 bg-white/80 p-3">
                    <label class="flex min-w-0 flex-1 cursor-pointer items-center gap-3 rounded-2xl bg-slate-50 px-4 py-3 ring-1 ring-slate-100 transition hover:bg-cyan-50 hover:ring-cyan-200">
                        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-cyan-100 text-lg text-cyan-700">🖼️</span>
                        <span class="min-w-0">
                            <span class="block text-sm font-bold text-slate-800">@(selectedFile is null ? "Choisir une image" : selectedFile.Name)</span>
                            <span class="block text-xs text-slate-500">PNG, JPG, GIF ou WebP · 5 Mo maximum</span>
                        </span>
                        <InputFile OnChange="SelectFile" accept="image/png,image/jpeg,image/gif,image/webp" class="sr-only" />
                    </label>
                    <AsyncActionButton Class="rounded-full bg-gradient-to-r from-cyan-600 to-emerald-500 px-5 py-3 text-sm font-black text-white shadow-lg shadow-cyan-500/20 transition hover:-translate-y-0.5 hover:shadow-xl disabled:translate-y-0 disabled:opacity-50 disabled:shadow-none" Disabled="@(selectedFile is null)" IsBusy="@isUploading" BusyLabel="Enregistrement..." OnClick="@(_ => UploadAsync())">Enregistrer et insérer</AsyncActionButton>
                </div>
            </div>

            <div class="mt-4 grid gap-3 rounded-2xl border border-slate-100 p-4 md:grid-cols-3">
                <label>
                    <span class="text-xs font-semibold text-slate-600">Filtrer par nom</span>
                    <input class="mt-1 hallo-input text-sm" @bind="nameFilter" @bind:event="oninput" placeholder="Nom, fichier, texte alt..." />
                </label>
                <label>
                    <span class="text-xs font-semibold text-slate-600">Filtrer par classe</span>
                    <select class="mt-1 hallo-input text-sm" @bind="klasseFilter">
                        <option value="">Toutes</option>
                        @foreach (var klasse in AllKlasseFilters)
                        {
                            <option value="@klasse">@klasse</option>
                        }
                    </select>
                </label>
                <p class="self-end text-xs font-semibold text-slate-500">@FilteredImages.Count image(s) affichée(s)</p>
            </div>

            <div class="hallo-modal-scroll mt-4 min-h-0 flex-1">
                @if (images is null)
                {
                    <p class="p-6 text-sm text-slate-500">Chargement de la bibliothèque...</p>
                }
                else if (FilteredImages.Count == 0)
                {
                    <p class="p-6 text-sm text-slate-500">Aucune image ne correspond au filtre.</p>
                }
                else
                {
                    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
                        @foreach (var image in FilteredImages)
                        {
                            <button type="button" class="group overflow-hidden rounded-2xl border border-slate-200 bg-white text-left transition hover:-translate-y-0.5 hover:border-cyan-500 hover:shadow-lg hover:shadow-cyan-500/10" title="Insérer @image.DisplayName" @onclick="() => ChooseAsync(image)">
                                <img class="aspect-square w-full object-cover" src="@image.ImageUrl" alt="@image.AltText" />
                                <span class="block truncate px-3 pt-2 text-xs font-semibold text-slate-700">@(string.IsNullOrWhiteSpace(image.DisplayName) ? image.OriginalFileName : image.DisplayName)</span>
                                <span class="block truncate px-3 text-[11px] text-slate-400">@image.KlasseCode</span>
                                <span class="block truncate px-3 text-[11px] text-slate-400">@image.SchoolName · @image.OwnerName</span>
                                <span class="mx-3 mb-3 mt-2 inline-flex rounded-full bg-cyan-50 px-3 py-1 text-[11px] font-bold text-cyan-700 transition group-hover:bg-cyan-600 group-hover:text-white">Insérer</span>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public EventCallback<BlobMediaAssetItem> ImageSelected { get; set; }

    private readonly List<(Guid Id, string Name)> schools = [];
    private readonly List<(Guid Id, string Code)> klasseOptions = [];
    private IReadOnlyList<BlobMediaAssetItem>? images;
    private Guid selectedSchoolId;
    private Guid? selectedKlasseId;
    private IBrowserFile? selectedFile;
    private string displayName = string.Empty;
    private string altText = string.Empty;
    private string nameFilter = string.Empty;
    private string klasseFilter = string.Empty;
    private string? errorMessage;
    private bool isUploading;
    private Guid userId;
    private string[] roles = [];

    private IReadOnlyList<BlobMediaAssetItem> FilteredImages => (images ?? [])
        .Where(image => string.IsNullOrWhiteSpace(nameFilter)
            || Contains(image.DisplayName, nameFilter)
            || Contains(image.OriginalFileName, nameFilter)
            || Contains(image.AltText, nameFilter))
        .Where(image => string.IsNullOrWhiteSpace(klasseFilter) || string.Equals(image.KlasseCode, klasseFilter, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private IReadOnlyList<string> AllKlasseFilters => (images ?? [])
        .Select(image => image.KlasseCode)
        .Where(code => !string.IsNullOrWhiteSpace(code))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(code => code)
        .ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (!Open || userId != Guid.Empty)
        {
            return;
        }

        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        Guid.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier), out userId);
        roles = state.User.FindAll(ClaimTypes.Role).Select(claim => claim.Value).ToArray();
        var schoolQuery = DbContext.Schools.AsNoTracking().AsQueryable();
        if (!roles.Contains(Rollen.SuperAdmin) && !roles.Contains(Rollen.ProduktOwner))
        {
            var schoolIds = await DbContext.UserSchools.Where(link => link.AppUserId == userId).Select(link => link.SchoolId).ToListAsync();
            schoolQuery = schoolQuery.Where(school => schoolIds.Contains(school.Id));
        }

        schools.AddRange(await schoolQuery.OrderBy(school => school.Name).Select(school => new ValueTuple<Guid, string>(school.Id, school.Name)).ToListAsync());
        selectedSchoolId = schools.FirstOrDefault().Id;
        await LoadKlasseOptionsAsync();
        await LoadImagesAsync();
    }

    private async Task OnSchoolChangedAsync()
    {
        selectedKlasseId = null;
        await LoadKlasseOptionsAsync();
    }

    private async Task LoadKlasseOptionsAsync()
    {
        klasseOptions.Clear();
        if (selectedSchoolId == Guid.Empty)
        {
            return;
        }

        klasseOptions.AddRange(await DbContext.Klassen
            .AsNoTracking()
            .Where(klasse => klasse.SchoolId == selectedSchoolId)
            .OrderBy(klasse => klasse.Code)
            .Select(klasse => new ValueTuple<Guid, string>(klasse.Id, klasse.Code))
            .ToListAsync());
    }

    private async Task LoadImagesAsync() => images = await MediaLibrary.GetVisibleImagesAsync(userId, roles);
    private void SelectFile(InputFileChangeEventArgs args) => selectedFile = args.File;

    private async Task UploadAsync()
    {
        if (selectedFile is null || selectedSchoolId == Guid.Empty)
        {
            return;
        }

        try
        {
            errorMessage = null;
            isUploading = true;
            await using var stream = selectedFile.OpenReadStream(5 * 1024 * 1024);
            var asset = await MediaLibrary.UploadImageAsync(userId, roles, selectedSchoolId, selectedKlasseId, stream, selectedFile.Name, displayName, selectedFile.ContentType, altText);
            selectedFile = null;
            displayName = string.Empty;
            altText = string.Empty;
            await LoadImagesAsync();
            await ChooseAsync(asset);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task ChooseAsync(BlobMediaAssetItem image)
    {
        await ImageSelected.InvokeAsync(image);
        await CloseAsync();
    }

    private Task CloseAsync() => OpenChanged.InvokeAsync(false);

    private static bool Contains(string? value, string term)
        => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);
}
