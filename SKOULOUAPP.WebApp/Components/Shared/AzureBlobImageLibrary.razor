@using System.Security.Claims
@using SkoulouApp.Core.DataModels.Identity
@using SkoulouApp.Core.DataModels.Lessons
@using SkoulouApp.Core.Interfaces
@using SkoulouApp.Core.Models.Media
@using SkoulouApp.Core.Services.Storage
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Logging
@inject IBlobMediaLibraryService MediaLibrary
@inject IDbContextFactory<SkoulouApp.WebApp.Data.ApplicationDbContext> DbContextFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@inject ILogger<AzureBlobImageLibrary> Logger

@if (Open)
{
    <div class="fixed inset-0 z-[2200] flex items-start justify-center overflow-hidden bg-slate-950/60 p-6 sm:p-8" role="dialog" aria-modal="true" aria-label="Bibliothèque d’images">
        <div class="skoulou-modal-surface flex max-h-[92dvh] w-full max-w-6xl flex-col rounded-3xl bg-white p-3 shadow-2xl sm:p-4">
            <div class="flex items-start justify-between gap-3 border-b border-slate-100 pb-3">
                <div>
                    <p class="text-xs font-bold uppercase tracking-wider text-cyan-700">Médiathèque sécurisée</p>
                    <h2 class="text-xl font-black text-slate-900">Médiathèque des cours</h2>
                    <p class="mt-1 text-xs text-slate-500">@(VideoMode ? "Choisissez une vidéo existante ou téléversez-en une nouvelle (1 heure maximum)." : "Choisissez une image existante ou téléversez-en une nouvelle pour la leçon.")</p>
                </div>
                <button type="button" class="rounded-full bg-slate-100 px-4 py-2 text-xs font-semibold text-slate-700" @onclick="CloseAsync">Fermer</button>
            </div>

            <Toast Message="@statusMessage" MessageChanged="v => statusMessage = v" Kind="Toast.ToastKind.Success" />
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="mt-3 flex items-start justify-between gap-3 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-800" role="alert">
                    <span>@errorMessage</span>
                    <button type="button" class="rounded-full px-2 text-rose-700 hover:bg-rose-100" aria-label="Fermer" @onclick="() => errorMessage = null">✕</button>
                </div>
            }

            <div class="mt-3 shrink-0 grid gap-3 rounded-2xl bg-slate-50 p-3 @(ProfileImageMode ? string.Empty : "lg:grid-cols-4")">
                @if (!ProfileImageMode)
                {
                    <ModernDropdown TValue="Guid" Label="École" Value="selectedSchoolId" ValueChanged="OnSchoolSelectedAsync" Options="SchoolOptions" EinzigeOptionFest="true" ButtonClass="py-2" />
                    <ModernDropdown TValue="Guid?" Label="Classe / niveau" @bind-Value="selectedKlasseId" Options="KlasseSelectOptions" ButtonClass="py-2" />
                    <label>
                        <span class="text-xs font-semibold text-slate-600">@(VideoMode ? "Nom de la vidéo" : "Nom de l’image")</span>
                        <input class="mt-1 skoulou-input text-sm" @bind="displayName" @bind:event="oninput" maxlength="200" placeholder="Ex. triangle rectangle" />
                    </label>
                    @if (!VideoMode)
                    {
                    <label>
                        <span class="text-xs font-semibold text-slate-600">Texte alternatif (obligatoire)</span>
                        <input class="mt-1 skoulou-input text-sm" @bind="altText" @bind:event="oninput" maxlength="250" required aria-required="true" placeholder="Décrivez brièvement l’image" />
                    </label>
                    }
                }
                <div class="@(ProfileImageMode ? string.Empty : "lg:col-span-4") flex flex-wrap items-center justify-between gap-2 rounded-2xl border border-dashed border-cyan-200 bg-white/80 p-2.5">
                    <label class="flex min-w-0 flex-1 cursor-pointer items-center gap-3 rounded-2xl bg-slate-50 px-4 py-3 ring-1 ring-slate-100 transition hover:bg-cyan-50 hover:ring-cyan-200">
                        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-cyan-100 text-lg text-cyan-700"><Icon Name="@(VideoMode ? "video" : "image")" Groesse="18" /></span>
                        <span class="min-w-0">
                            <span class="block text-sm font-bold text-slate-800">@(selectedFile is null ? VideoMode ? "Choisir une vidéo" : "Choisir une image" : selectedFile.Name)</span>
                            <span class="block text-xs text-slate-500">@(VideoMode ? "MP4 ou MOV · 8 Go maximum · 1 heure maximum" : "PNG, JPG, GIF ou WebP · 25 Mo maximum")</span>
                        </span>
                        <InputFile id="course-library-video-file" OnChange="SelectFile" accept="@(VideoMode ? "video/mp4,video/quicktime,.mp4,.m4v,.mov" : "image/png,image/jpeg,image/gif,image/webp")" class="sr-only" />
                    </label>
                    <AsyncActionButton Class="rounded-full bg-gradient-to-r from-cyan-600 to-emerald-500 px-5 py-3 text-sm font-black text-white shadow-lg shadow-cyan-500/20 transition hover:-translate-y-0.5 hover:shadow-xl disabled:translate-y-0 disabled:opacity-50 disabled:shadow-none" Disabled="@(selectedFile is null)" IsBusy="@isUploading" BusyLabel="Enregistrement..." OnClick="@(_ => UploadAsync())">Enregistrer et choisir</AsyncActionButton>
                    @if (isUploading && uploadBytesTotal > 0)
                    {
                        <div class="w-full rounded-2xl bg-white p-3 ring-1 ring-cyan-100">
                            <div class="flex items-center justify-between gap-3 text-xs font-semibold text-cyan-900">
                                <span>Enregistrement en cours</span>
                                <span>@UploadProgressLabel</span>
                            </div>
                            <div class="mt-2 h-3 overflow-hidden rounded-full bg-cyan-100" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@uploadPercent">
                                <div class="h-full rounded-full bg-cyan-700 transition-all duration-300" style="@($"width:{uploadPercent}%")"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="mt-3 shrink-0 grid gap-2 rounded-2xl border border-slate-100 p-3 md:grid-cols-5">
                <label>
                    <span class="mb-2 block text-sm font-semibold text-slate-700">Filtrer par fichier</span>
                    <input class="mt-1 skoulou-input text-sm" @bind="fileNameFilter" @bind:event="oninput" placeholder="Nom affiché ou nom de fichier..." />
                </label>
                <ModernDropdown TValue="string" Label="Filtrer par école" @bind-Value="schoolFilter" Options="SchoolFilterOptions" EinzigeOptionFest="true" ButtonClass="py-2" />
                <ModernDropdown TValue="string" Label="Filtrer par classe" @bind-Value="klasseFilter" Options="KlasseFilterOptions" ButtonClass="py-2" />
                @if (!ProfileImageMode)
                {
                    <ModernDropdown TValue="string" Label="Filtrer par type" @bind-Value="typeFilter" Options="TypeFilterOptions" ButtonClass="py-2" />
                }
                <p class="self-end text-xs font-semibold text-slate-500">@FilteredImages.Count @(VideoMode ? "vidéo(s)" : "image(s)") affichée(s)</p>
            </div>

            <div class="skoulou-modal-scroll mt-3 min-h-[12rem] flex-1 rounded-2xl border border-slate-100 bg-white p-3">
                @if (images is null)
                {
                    <p class="p-6 text-sm text-slate-500">Chargement de la bibliothèque...</p>
                }
                else if (FilteredImages.Count == 0)
                {
                    <p class="p-6 text-sm text-slate-500">Aucun média ne correspond au filtre.</p>
                }
                else
                {
                    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
                        @foreach (var image in FilteredImages)
                        {
                            <div class="group overflow-hidden rounded-2xl border border-slate-200 bg-white text-left transition hover:-translate-y-0.5 hover:border-cyan-500 hover:shadow-lg hover:shadow-cyan-500/10">
                                @if (image.MediaType == BlobMediaType.Video)
                                {
                                    <div class="flex aspect-square items-center justify-center bg-cyan-50 text-5xl"><Icon Name="video" Groesse="16" /> </div>
                                }
                                else
                                {
                                    <img class="aspect-square w-full object-cover" src="@image.ImageUrl" alt="@image.AltText" />
                                }
                                <span class="block truncate px-3 pt-2 text-xs font-semibold text-slate-700">@(string.IsNullOrWhiteSpace(image.DisplayName) ? image.OriginalFileName : image.DisplayName)</span>
                                <span class="block truncate px-3 text-[11px] text-slate-400">@image.KlasseCode</span>
                                <span class="block truncate px-3 text-[11px] text-slate-400">@image.SchoolName · @image.OwnerName</span>
                                <div class="mx-3 mb-3 mt-2 flex items-center gap-2">
                                    <button type="button" class="inline-flex rounded-full bg-cyan-50 px-3 py-1 text-[11px] font-bold text-cyan-700 transition group-hover:bg-cyan-600 group-hover:text-white" title="Insérer @image.DisplayName" @onclick="() => ChooseAsync(image)">Insérer</button>
                                    @if (image.MediaType != BlobMediaType.Video)
                                    {
                                        <button type="button" class="inline-flex rounded-full bg-rose-50 px-3 py-1 text-[11px] font-bold text-rose-700 transition hover:bg-rose-600 hover:text-white" title="Supprimer @image.DisplayName" @onclick="() => DeleteImageAsync(image)">Supprimer</button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public EventCallback<BlobMediaAssetItem> ImageSelected { get; set; }
    [Parameter] public bool VideoMode { get; set; }
    [Parameter] public bool ProfileImageMode { get; set; }

    private readonly List<(Guid Id, string Name)> schools = [];
    private readonly List<(Guid Id, string Code)> klasseOptions = [];
    private IReadOnlyList<BlobMediaAssetItem>? images;
    private Guid selectedSchoolId;
    private Guid? selectedKlasseId;
    private IBrowserFile? selectedFile;
    private string displayName = string.Empty;
    private string altText = string.Empty;
    private string fileNameFilter = string.Empty;
    private string klasseFilter = string.Empty;
    private string schoolFilter = string.Empty;
    private string typeFilter = string.Empty;

    private IReadOnlyList<ModernDropdownOption<Guid>> SchoolOptions => schools.Select(s => new ModernDropdownOption<Guid>(s.Id, s.Name)).ToList();

    private IReadOnlyList<ModernDropdownOption<Guid?>> KlasseSelectOptions => new[] { new ModernDropdownOption<Guid?>(null, "Sans classe") }
        .Concat(klasseOptions.Select(k => new ModernDropdownOption<Guid?>(k.Id, k.Code))).ToList();

    private IReadOnlyList<ModernDropdownOption<string>> SchoolFilterOptions => new[] { new ModernDropdownOption<string>(string.Empty, "Toutes") }
        .Concat(AllSchoolFilters.Select(s => new ModernDropdownOption<string>(s.Id.ToString(), s.Name))).ToList();

    private IReadOnlyList<ModernDropdownOption<string>> KlasseFilterOptions => new[] { new ModernDropdownOption<string>(string.Empty, "Toutes") }
        .Concat(AllKlasseFilters.Select(k => new ModernDropdownOption<string>(k, k))).ToList();

    private readonly List<ModernDropdownOption<string>> TypeFilterOptions = new()
    {
        new ModernDropdownOption<string>(string.Empty, "Tous"),
        new ModernDropdownOption<string>("video", "Vidéos"),
        new ModernDropdownOption<string>("image", "Images")
    };

    private async Task OnSchoolSelectedAsync(Guid id)
    {
        selectedSchoolId = id;
        await OnSchoolChangedAsync();
    }
    private string? errorMessage;
    private string? statusMessage;
    private bool isUploading;
    private bool isDeleting;
    private Guid userId;
    private string[] roles = [];
    private string currentUserDisplayName = "utilisateur";

    private IReadOnlyList<BlobMediaAssetItem> FilteredImages => (images ?? [])
        .Where(image => string.IsNullOrWhiteSpace(fileNameFilter)
            || Contains(image.DisplayName, fileNameFilter)
            || Contains(image.OriginalFileName, fileNameFilter))
        .Where(image => string.IsNullOrWhiteSpace(schoolFilter) || string.Equals(image.SchoolId.ToString(), schoolFilter, StringComparison.OrdinalIgnoreCase))
        .Where(image => string.IsNullOrEmpty(typeFilter) || (typeFilter == "video") == (image.MediaType == BlobMediaType.Video))
        .Where(image => string.IsNullOrWhiteSpace(klasseFilter) || string.Equals(image.KlasseCode, klasseFilter, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private IReadOnlyList<(Guid Id, string Name)> AllSchoolFilters => (images ?? [])
        .Where(image => image.SchoolId.HasValue)
        .Select(image => new ValueTuple<Guid, string>(image.SchoolId!.Value, image.SchoolName))
        .Distinct()
        .OrderBy(item => item.Item2)
        .ToList();

    private IReadOnlyList<string> AllKlasseFilters => (images ?? [])
        .Select(image => image.KlasseCode)
        .Where(code => !string.IsNullOrWhiteSpace(code))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(code => code)
        .ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (!Open || userId != Guid.Empty)
        {
            return;
        }

        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        Guid.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier), out userId);
        roles = state.User.FindAll(ClaimTypes.Role).Select(claim => claim.Value).ToArray();
        currentUserDisplayName = state.User.Identity?.Name?.Trim() ?? "utilisateur";
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        var schoolQuery = dbContext.Schools.AsNoTracking().AsQueryable();
        if (!roles.Contains(Rollen.SuperAdmin) && !roles.Contains(Rollen.ProduktOwner))
        {
            var schoolIds = await dbContext.UserSchools.Where(link => link.AppUserId == userId).Select(link => link.SchoolId).ToListAsync();
            schoolQuery = schoolQuery.Where(school => schoolIds.Contains(school.Id));
        }

        schools.AddRange(await schoolQuery.OrderBy(school => school.Name).Select(school => new ValueTuple<Guid, string>(school.Id, school.Name)).ToListAsync());
        selectedSchoolId = schools.FirstOrDefault().Id;
        await LoadKlasseOptionsAsync();
        await LoadImagesAsync();
    }

    private async Task OnSchoolChangedAsync()
    {
        selectedKlasseId = null;
        await LoadKlasseOptionsAsync();
    }

    private async Task LoadKlasseOptionsAsync()
    {
        klasseOptions.Clear();
        if (selectedSchoolId == Guid.Empty)
        {
            return;
        }

        await using var dbContext = await DbContextFactory.CreateDbContextAsync();
        klasseOptions.AddRange(await dbContext.Klassen
            .AsNoTracking()
            .Where(klasse => klasse.SchoolId == selectedSchoolId)
            .OrderBy(klasse => klasse.Code)
            .Select(klasse => new ValueTuple<Guid, string>(klasse.Id, klasse.Code))
            .ToListAsync());
    }

    private async Task LoadImagesAsync()
    {
        if (ProfileImageMode)
        {
            images = await MediaLibrary.GetVisibleImagesAsync(userId, roles);
            return;
        }

        if (string.IsNullOrEmpty(typeFilter))
        {
            typeFilter = VideoMode ? "video" : "image";
        }

        var videos = await MediaLibrary.GetVisibleVideosAsync(userId, roles);
        var pictures = await MediaLibrary.GetVisibleImagesAsync(userId, roles);
        images = videos.Concat(pictures).ToList();
    }
    private double? selectedVideoSeconds;

    private async Task SelectFile(InputFileChangeEventArgs args)
    {
        selectedFile = args.File;
        selectedVideoSeconds = null;
        if (VideoMode)
        {
            if (args.File.Size > 8L * 1024 * 1024 * 1024)
            {
                errorMessage = "La vidéo ne doit pas dépasser 8 Go.";
                selectedFile = null;
                return;
            }
            try
            {
                var seconds = await JSRuntime.InvokeAsync<double?>("SKOULOUAPPVideoMetadata.getDurationInSeconds", "course-library-video-file");
                if (seconds is null or <= 0 or > 3600)
                {
                    errorMessage = "La durée réelle de la vidéo doit être comprise entre 1 seconde et 1 heure.";
                    selectedFile = null;
                    return;
                }
                selectedVideoSeconds = seconds;
            }
            catch (JSException)
            {
                errorMessage = "La durée réelle de la vidéo ne peut pas être lue.";
                selectedFile = null;
                return;
            }
        }
        if (ProfileImageMode)
        {
            return;
        }

        var fileName = Path.GetFileNameWithoutExtension(args.File.Name);
        displayName = NormalizeDisplayName(fileName);
        if (!VideoMode)
        {
            altText = displayName;
        }
        errorMessage = null;
    }

    internal static string NormalizeDisplayName(string? value)
    {
        var name = (value ?? string.Empty).Trim();
        var cleaned = new string(name.Select(character => char.IsLetterOrDigit(character) || char.IsWhiteSpace(character) || character is '-' or '_' or '.' or '(' or ')' ? character : ' ').ToArray());
        return string.Join(' ', cleaned.Split(' ', StringSplitOptions.RemoveEmptyEntries));
    }
    private bool IsAltTextInvalid() => !VideoMode && !ProfileImageMode && (string.IsNullOrWhiteSpace(altText) || altText.Length > 250);

    private async Task UploadAsync()
    {
        if (selectedFile is null || selectedSchoolId == Guid.Empty)
        {
            return;
        }

        errorMessage = null;
        if (!ProfileImageMode)
        {
            displayName = NormalizeDisplayName(displayName);
            if (string.IsNullOrWhiteSpace(displayName) || displayName.Length > 200)
            {
                errorMessage = "Saisissez un nom d’image valide (200 caractères maximum).";
                return;
            }
        }
        if (IsAltTextInvalid())
        {
            errorMessage = "Décrivez brièvement l’image dans le champ « Texte alternatif » (250 caractères maximum).";
            return;
        }

        try
        {
            statusMessage = null;
            isUploading = true;
            uploadBytesTotal = selectedFile.Size;
            uploadBytesDone = 0;
            uploadPercent = 0;
            await using var stream = new ProgressReadStream(selectedFile.OpenReadStream(VideoMode ? 8L * 1024 * 1024 * 1024 : 25L * 1024 * 1024), ReportUploadProgress);
            var displayNameForUpload = displayName;
            var altTextForUpload = altText;
            if (ProfileImageMode)
            {
                displayNameForUpload = string.IsNullOrWhiteSpace(displayName)
                    ? System.IO.Path.GetFileNameWithoutExtension(selectedFile.Name)
                    : displayName;
                altTextForUpload = string.IsNullOrWhiteSpace(altText)
                    ? $"Photo de profil de {currentUserDisplayName}"
                    : altText;
            }

            BlobMediaAssetItem asset;
            if (VideoMode)
            {
                var seconds = selectedVideoSeconds;
                if (seconds is null or <= 0 or > 3600)
                {
                    throw new InvalidOperationException("La durée réelle de la vidéo doit être comprise entre 1 seconde et 1 heure.");
                }
                asset = await MediaLibrary.UploadVideoAsync(userId, roles, selectedSchoolId, selectedKlasseId, stream, selectedFile.Name, displayNameForUpload, selectedFile.ContentType, TimeSpan.FromSeconds(seconds.Value));
            }
            else
            {
                asset = await MediaLibrary.UploadImageAsync(userId, roles, selectedSchoolId, selectedKlasseId, stream, selectedFile.Name, displayNameForUpload, selectedFile.ContentType, altTextForUpload);
            }
            selectedFile = null;
            displayName = string.Empty;
            altText = string.Empty;
            await LoadImagesAsync();
            statusMessage = VideoMode ? "Vidéo enregistrée avec succès." : "Image enregistrée avec succès.";
            if (CanChoose(asset))
            {
                await ChooseAsync(asset);
            }
            else
            {
                errorMessage = "Le média doit correspondre à l'école et à la classe du contenu.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Échec du téléversement du média pour l'école {SchoolId} par l'utilisateur {UserId}.", selectedSchoolId, userId);
            errorMessage = ex.Message;
        }
        finally
        {
            isUploading = false;
            uploadBytesTotal = 0;
        }
    }

    private long uploadBytesTotal;
    private long uploadBytesDone;
    private int uploadPercent;

    private string UploadProgressLabel => $"{FormatFileSize(uploadBytesDone)} / {FormatFileSize(uploadBytesTotal)} ({uploadPercent} %)";

    private void ReportUploadProgress(int bytesRead)
    {
        if (bytesRead <= 0 || uploadBytesTotal <= 0)
        {
            return;
        }

        uploadBytesDone = Math.Min(uploadBytesTotal, uploadBytesDone + bytesRead);
        var newPercent = Math.Clamp((int)Math.Round(uploadBytesDone * 100d / uploadBytesTotal), 0, 100);
        if (newPercent == uploadPercent && uploadBytesDone < uploadBytesTotal)
        {
            return;
        }

        uploadPercent = newPercent;
        _ = InvokeAsync(StateHasChanged);
    }

    private static string FormatFileSize(long bytes)
    {
        const decimal megabyte = 1024m * 1024m;
        const decimal gigabyte = megabyte * 1024m;
        return bytes >= (long)gigabyte ? $"{bytes / gigabyte:N1} Go" : $"{bytes / megabyte:N1} Mo";
    }

    private sealed class ProgressReadStream(Stream innerStream, Action<int> reportProgress) : Stream
    {
        public override bool CanRead => innerStream.CanRead;
        public override bool CanSeek => innerStream.CanSeek;
        public override bool CanWrite => false;
        public override long Length => innerStream.Length;
        public override long Position { get => innerStream.Position; set => innerStream.Position = value; }
        public override void Flush() => innerStream.Flush();
        public override int Read(byte[] buffer, int offset, int count) => throw new NotSupportedException();

        public override async Task<int> ReadAsync(byte[] buffer, int offset, int count, CancellationToken cancellationToken)
        {
            var read = await innerStream.ReadAsync(buffer.AsMemory(offset, count), cancellationToken);
            reportProgress(read);
            return read;
        }

        public override async ValueTask<int> ReadAsync(Memory<byte> buffer, CancellationToken cancellationToken = default)
        {
            var read = await innerStream.ReadAsync(buffer, cancellationToken);
            reportProgress(read);
            return read;
        }

        public override long Seek(long offset, SeekOrigin origin) => innerStream.Seek(offset, origin);
        public override void SetLength(long value) => innerStream.SetLength(value);
        public override void Write(byte[] buffer, int offset, int count) => throw new NotSupportedException();

        protected override void Dispose(bool disposing)
        {
            if (disposing)
            {
                innerStream.Dispose();
            }

            base.Dispose(disposing);
        }

        public override async ValueTask DisposeAsync()
        {
            await innerStream.DisposeAsync();
            await base.DisposeAsync();
        }
    }

    private async Task DeleteImageAsync(BlobMediaAssetItem image)
    {
        if (isDeleting)
        {
            return;
        }

        try
        {
            isDeleting = true;
            errorMessage = null;
            statusMessage = null;
            await MediaLibrary.DeleteImageAsync(image.Id, userId, roles);
            statusMessage = "Image supprimée avec succès.";
            await LoadImagesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Échec de la suppression du média {AssetId} par l'utilisateur {UserId}.", image.Id, userId);
            errorMessage = ex.Message;
        }
        finally
        {
            isDeleting = false;
        }
    }

    private async Task ChooseAsync(BlobMediaAssetItem image)
    {
        if (!CanChoose(image))
        {
            errorMessage = "Le média doit correspondre à l'école et à la classe du contenu.";
            return;
        }
        await ImageSelected.InvokeAsync(image);
        await CloseAsync();
    }

    [Parameter] public Guid? RequiredSchoolId { get; set; }
    [Parameter] public Guid? RequiredKlasseId { get; set; }

    private bool CanChoose(BlobMediaAssetItem image)
        => (!RequiredSchoolId.HasValue || image.SchoolId == RequiredSchoolId)
            && (!RequiredKlasseId.HasValue || image.KlasseId == RequiredKlasseId);

    private Task CloseAsync() => OpenChanged.InvokeAsync(false);

    private static bool Contains(string? value, string term)
        => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);
}
