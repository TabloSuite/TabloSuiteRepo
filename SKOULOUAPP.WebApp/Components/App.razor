    <script>
        window.SKOULOUAPPFormulas = {
            render: () => document.querySelectorAll('.ql-formula[data-value]').forEach(element => {
                if (element.dataset.formulaRendered === 'true' || typeof katex === 'undefined') return;
                try {
                    katex.render(element.dataset.value || '', element, { throwOnError: false });
                    element.dataset.formulaRendered = 'true';
                } catch { }
            }),
            observe: () => new MutationObserver(() => window.SKOULOUAPPFormulas.render())
                .observe(document.body, { childList: true, subtree: true })
        };
        window.SKOULOUAPPFormulas.observe();

        window.SKOULOUAPP = window.SKOULOUAPP || {};
        window.SKOULOUAPP.scrollIntoView = (elementId) => {
            window.setTimeout(() => document.getElementById(elementId)?.scrollIntoView({ block: 'start', behavior: 'smooth' }), 0);
        };

        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => navigator.serviceWorker.register('/service-worker.js'));
        }

    </script>
