    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#2563eb" />
    <script>
        (function () {
            try {
                var key = "skoulouapp-theme";
                var cookiePrefix = key + "=";
                var cookieTheme = null;
                var cookieParts = document.cookie.split(";");
                for (var i = 0; i < cookieParts.length; i++) {
                    var part = cookieParts[i].trim();
                    if (part.indexOf(cookiePrefix) === 0) {
                        cookieTheme = decodeURIComponent(part.substring(cookiePrefix.length));
                        break;
                    }
                }
                var storageTheme = localStorage.getItem(key);
                var theme = storageTheme || cookieTheme || "navy";
                if (["ocean", "coral", "slate", "sage", "navy"].indexOf(theme) < 0) {
                    theme = "navy";
                }
                localStorage.setItem(key, theme);
                document.cookie = key + "=" + encodeURIComponent(theme) + ";path=/;max-age=31536000;samesite=lax";
                document.documentElement.setAttribute("data-theme", theme);
            } catch { }
        })();
    </script>
    <meta name="description" content="SKOULOU, la plateforme de gestion scolaire et d’apprentissage pour les établissements, les classes, les enseignants et les élèves." />
