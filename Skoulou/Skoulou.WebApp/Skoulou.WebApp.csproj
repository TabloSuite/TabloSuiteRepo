<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Skoulou.WebApp</RootNamespace>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Gleiche Secrets wie die Alt-App (Seed, Postmark), damit lokale Einstellungen weiter gelten. -->
    <UserSecretsId>43aa6e7c-6ec6-4dc0-8010-6b3660d72e6a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lernvideos außerhalb von wwwroot: Auslieferung über /medien/videos mit Range-Unterstützung. -->
    <None Update="Medien\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Skoulou.Core\Skoulou.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="HtmlSanitizer" />
    <!-- Hebt die transitive, verwundbare Version (Azure.Identity) an. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <!-- Organisation (E3): PDFs (Zugangsliste, Karten, Stundenplan), QR, XLSX-Import. -->
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="ClosedXML" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Skoulou.Tests" />
  </ItemGroup>

</Project>
