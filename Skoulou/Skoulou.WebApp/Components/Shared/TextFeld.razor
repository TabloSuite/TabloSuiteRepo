@* Textfeld mit Beschriftung, Hinweis und Fehler (auch E-Mail/Telefon/Suche über « Typ », mehrzeilig über « Zeilen »).
   Immer @bind:get/@bind:set (nie value + @oninput): nur so gleicht Blazor den Wert mit dem Browser ab – bei langsamer
   Verbindung gingen sonst getippte Zeichen verloren. *@
<Feld Label="@Label" Id="@id" Hinweis="@Hinweis" Fehler="@Fehler" Pflicht="@Pflicht" CssClass="@CssClass">
    @if (Zeilen > 1 && Sofort)
    {
        <textarea id="@id" class="sk-eingabe" name="@Name" rows="@Zeilen" placeholder="@Platzhalter" maxlength="@MaxLaenge"
                  required="@Pflicht" disabled="@Deaktiviert" aria-invalid="@(Fehler is not null ? "true" : null)"
                  @bind:get="Wert" @bind:set="SetzeAsync" @bind:event="oninput" @attributes="WeitereAttribute"></textarea>
    }
    else if (Zeilen > 1)
    {
        <textarea id="@id" class="sk-eingabe" name="@Name" rows="@Zeilen" placeholder="@Platzhalter" maxlength="@MaxLaenge"
                  required="@Pflicht" disabled="@Deaktiviert" aria-invalid="@(Fehler is not null ? "true" : null)"
                  @bind:get="Wert" @bind:set="SetzeAsync" @attributes="WeitereAttribute"></textarea>
    }
    else if (Sofort)
    {
        <input id="@id" class="sk-eingabe" type="@Typ" name="@Name" placeholder="@Platzhalter" maxlength="@MaxLaenge"
               autocomplete="@Autocomplete" required="@Pflicht" disabled="@Deaktiviert" aria-invalid="@(Fehler is not null ? "true" : null)"
               @bind:get="Wert" @bind:set="SetzeAsync" @bind:event="oninput" @attributes="WeitereAttribute" />
    }
    else
    {
        <input id="@id" class="sk-eingabe" type="@Typ" name="@Name" placeholder="@Platzhalter" maxlength="@MaxLaenge"
               autocomplete="@Autocomplete" required="@Pflicht" disabled="@Deaktiviert" aria-invalid="@(Fehler is not null ? "true" : null)"
               @bind:get="Wert" @bind:set="SetzeAsync" @attributes="WeitereAttribute" />
    }
</Feld>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Wert { get; set; }
    [Parameter] public EventCallback<string?> WertChanged { get; set; }
    [Parameter] public string Typ { get; set; } = "text";
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Platzhalter { get; set; }
    [Parameter] public string? Hinweis { get; set; }
    [Parameter] public string? Fehler { get; set; }
    [Parameter] public bool Pflicht { get; set; }
    [Parameter] public bool Deaktiviert { get; set; }
    [Parameter] public int? MaxLaenge { get; set; }
    [Parameter] public string? Autocomplete { get; set; }
    [Parameter] public int Zeilen { get; set; } = 1;

    /// <summary>Wert schon beim Tippen übernehmen (Standard: beim Verlassen des Feldes).</summary>
    [Parameter] public bool Sofort { get; set; }

    [Parameter] public string? CssClass { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? WeitereAttribute { get; set; }

    private readonly string id = Feld.NeueId("txt");

    private Task SetzeAsync(string? wert)
    {
        Wert = wert;
        return WertChanged.InvokeAsync(wert);
    }
}
