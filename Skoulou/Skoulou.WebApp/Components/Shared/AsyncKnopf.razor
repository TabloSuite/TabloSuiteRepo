@* Knopf für Server-Aktionen: Doppelklickschutz, Spinner und Sperre während der Ausführung. *@
<button type="@Type"
        class="@Klassen"
        disabled="@(beschaeftigt || Disabled)"
        aria-busy="@(beschaeftigt ? "true" : null)"
        @attributes="WeitereAttribute"
        @onclick="KlickAsync">
    @if (beschaeftigt)
    {
        <span class="sk-spinner" aria-hidden="true"></span>
        <span>@(BusyText ?? Text)</span>
    }
    else if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @if (Icon is not null)
        {
            <Icon Name="@Icon" Groesse="18" />
        }
        <span>@Text</span>
    }
</button>

@code {
    [Parameter] public string Text { get; set; } = "Enregistrer";
    [Parameter] public string? BusyText { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? WeitereAttribute { get; set; }

    private bool beschaeftigt;

    private string Klassen => string.Join(' ', new[] { "sk-btn", CssClass, beschaeftigt ? "sk-laedt" : null }.Where(k => !string.IsNullOrWhiteSpace(k)));

    private async Task KlickAsync()
    {
        if (beschaeftigt || !OnClick.HasDelegate) return;
        beschaeftigt = true;
        try
        {
            await OnClick.InvokeAsync();
        }
        finally
        {
            beschaeftigt = false;
        }
    }
}
