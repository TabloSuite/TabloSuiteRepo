@* Zustimmung zu den Nutzungsbedingungen: Text der eigenen Rollengruppe + gemeinsame Regeln. *@
@inject KontoService Konten

<ModalDialog Open="true" Title="Conditions d'utilisation" Oberzeile="Avant de commencer" Schliessbar="false" Breite="sk-modal-lg" ErrorMessage="@fehler">
    <ChildContent>
        <div class="sk-agb-kopf">
            <div>
                <strong>Validez les règles de votre espace</strong>
                <p>Lisez les conditions liées à votre rôle (@Rollen.Bezeichnung(Rolle)) et confirmez pour continuer.</p>
            </div>
            <span class="sk-badge sk-badge-neutral">Version @Version</span>
        </div>
        <div class="sk-agb-text">
            <AgbAbschnittAnzeige Abschnitt="@AgbTexte.Fuer(Rolle)" Hervorgehoben="true" />
            <AgbAbschnittAnzeige Abschnitt="@AgbTexte.Gemeinsam" />
            <p class="sk-leise">Texte complet pour tous les rôles : <a href="/conditions" target="_blank" rel="noopener">conditions d'utilisation</a>.</p>
        </div>
    </ChildContent>
    <Footer>
        <form method="post" action="/auth/deconnexion">
            <AntiforgeryToken />
            <button type="submit" class="sk-btn sk-btn-ghost">Se déconnecter</button>
        </form>
        <AsyncKnopf Text="J'accepte et je continue" BusyText="Enregistrement…" Icon="check" CssClass="sk-btn-primaer" OnClick="AkzeptierenAsync" />
    </Footer>
</ModalDialog>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthZustand { get; set; }
    [Parameter] public string Rolle { get; set; } = string.Empty;
    [Parameter] public string Version { get; set; } = string.Empty;
    [Parameter] public EventCallback OnAkzeptiert { get; set; }

    private string? fehler;

    private async Task AkzeptierenAsync()
    {
        if (AuthZustand is null || (await AuthZustand).User.KontoId() is not { } id) return;
        try
        {
            await Konten.AgbAkzeptierenAsync(id);
            await OnAkzeptiert.InvokeAsync();
        }
        catch (Skoulou.Core.Fehler.KeinZugriffFehler ex)
        {
            fehler = ex.Message;
        }
    }
}
