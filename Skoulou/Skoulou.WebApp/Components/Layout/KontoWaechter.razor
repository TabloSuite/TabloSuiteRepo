@* Pflichtschritt nach der Anmeldung: Startpasswort ändern. Die Nutzungsbedingungen werden wie bei eNOTE bei der
   Registrierung akzeptiert; von der Schule angelegte Konten sehen keinen Dialog. *@
@inject KontoService Konten

@if (stand is { MussPasswortAendern: true })
{
    <PasswortPflicht />
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthZustand { get; set; }

    private KontoStand? stand;

    protected override async Task OnInitializedAsync()
    {
        if (AuthZustand is not null && (await AuthZustand).User.KontoId() is { } id)
            stand = await Konten.KontoStandAsync(id);
    }
}
