@page "/finances/frais"
@page "/finances/frais/{Ansicht}"
@attribute [Authorize(Policy = Richtlinien.Finanzen)]
@inherits JahrSeite

<PageTitle>Frais de scolarité · SKOULOU</PageTitle>

<SeitenKopf Titel="Frais de scolarité" Icon="tag"
            Untertitel="@($"Frais par niveau ou par classe, tranches avec échéances et réductions{(Jahr is null ? "" : $" · année {Jahr.Bezeichnung}")}.")" />

<Reiter Beschriftung="Frais de scolarité" Eintraege="reiter" />

@if (!DarfFinanzen)
{
    @* Klicktest 20.11.2026: Koordinator ohne Finanzrecht sah per Adresse « Aucun frais » – als gäbe es keine Frais. *@
    <Leerzustand Icon="lock" Titel="Accès réservé"
                 Text="Les finances de l'établissement sont réservées à la direction et aux coordinateurs qui ont un droit sur les finances. Demandez ce droit au directeur." />
}
else if (JahrId is not { } jahr)
{
    <Leerzustand Icon="calendar" Titel="Aucune année scolaire" Text="Créez d'abord une année scolaire dans « Année scolaire »." />
}
else if (Comptes)
{
    <KontenListe @key="jahr" JahrId="jahr" DarfGebuehren="Kontext.HatRecht(KoordinatorRechte.ZahlungenErfassen)" DarfKassieren="Kontext.HatRecht(KoordinatorRechte.ZahlungenErfassen)" />
}
else
{
    @if (Jahr?.Status == SchuljahrStatus.Abgeschlossen)
    {
        <Hinweis Art="info">L'année @Jahr.Bezeichnung est clôturée : ses frais ne peuvent plus être modifiés.</Hinweis>
    }
    <PostenListe @key="jahr" JahrId="jahr" JahrText="@($"Année {Jahr?.Bezeichnung}")"
                 DarfSchreiben="@(Kontext.HatRecht(KoordinatorRechte.ZahlungenErfassen) && Jahr?.Status != SchuljahrStatus.Abgeschlossen)" />
}

@code {
    /// <summary>Direktor immer; Koordinator mit irgendeinem Finanzrecht (wie das Menü « Finances »).</summary>
    private bool DarfFinanzen => Kontext.HatRecht(KoordinatorRechte.FinanzenEinsehen) || Kontext.HatRecht(KoordinatorRechte.ZahlungenErfassen)
                                 || Kontext.HatRecht(KoordinatorRechte.BuchhaltungErfassen) || Kontext.HatRecht(KoordinatorRechte.RechnungSkoulou);

    private static readonly IReadOnlyList<Reiter.Eintrag> reiter =
    [
        new("/finances/frais", "Frais et tranches", "tag"),
        new("/finances/frais/comptes", "Comptes des élèves", "users"),
    ];

    /// <summary>Zweiter Reiter (« comptes »). Als Routenparameter, damit Blazor beim Reiterwechsel neu zeichnet –
    /// beide Reiter sind dieselbe Seite, aus der Adresse allein würde der Inhalt stehen bleiben (16.11.).</summary>
    [Parameter] public string? Ansicht { get; set; }

    private bool Comptes => string.Equals(Ansicht, "comptes", StringComparison.Ordinal);

    protected override Task JahrLadenAsync() => Task.CompletedTask;
}
