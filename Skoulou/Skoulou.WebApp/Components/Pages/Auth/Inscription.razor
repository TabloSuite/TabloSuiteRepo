@page "/auth/inscription"
@layout AuthLayout
@attribute [AllowAnonymous]

<PageTitle>Inscription · SKOULOU</PageTitle>

<div class="sk-auth-karte">
    <span class="sk-badge sk-badge-info"><Icon Name="clock" Groesse="13" Strich="2.5" /> Cette page arrive bientôt</span>
    <h1>Inscription</h1>
    <p class="sk-auth-unter">L'inscription en ligne d'un établissement (direction) ou d'un élève arrive avec la prochaine étape (E2 – Plateforme).</p>
    <ul class="sk-bald-punkte">
        <li><Icon Name="check" Groesse="16" /> <span>Direction : créer l'établissement et le compte de direction, validation par SKOULOU.</span></li>
        <li><Icon Name="check" Groesse="16" /> <span>Élève : choisir son établissement, validation par la direction.</span></li>
    </ul>
    <p class="sk-auth-unter">En attendant, écrivez-nous pour ouvrir votre établissement.</p>
    <div class="sk-knopfzeile">
        <a class="sk-btn sk-btn-primaer" href="/contact"><Icon Name="mail" Groesse="18" /> Nous contacter</a>
        <a class="sk-btn sk-btn-ghost" href="/auth/connexion">Se connecter</a>
    </div>
</div>
