@* Nutzungsbedingungen aus dem Registrierungsformular (Link am Kästchen, wie eNOTE): Abschnitt der gewählten Rolle +
   gemeinsame Regeln; « J'accepte » setzt das Kästchen. *@

<ModalDialog Open="Open" Title="Conditions d'utilisation" Oberzeile="SKOULOU" Breite="sk-modal-lg" OnClose="OnSchliessen">
    <ChildContent>
        <div class="sk-agb-kopf">
            <div>
                <strong>Les règles de votre espace</strong>
                <p>Lisez les conditions liées à votre rôle (@Rollen.Bezeichnung(Rolle)). En cochant la case du formulaire, vous les acceptez pour votre compte@(Rolle == Rollen.Direktor ? " et pour les comptes que votre établissement créera" : "").</p>
            </div>
        </div>
        <div class="sk-agb-text">
            <AgbAbschnittAnzeige Abschnitt="@AgbTexte.Fuer(Rolle)" Hervorgehoben="true" />
            <AgbAbschnittAnzeige Abschnitt="@AgbTexte.Gemeinsam" />
            <p class="sk-leise">Texte complet pour tous les rôles : <a href="/conditions" target="_blank" rel="noopener">conditions d'utilisation</a>.</p>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="sk-btn sk-btn-ghost" @onclick="OnSchliessen">Fermer</button>
        <button type="button" class="sk-btn sk-btn-primaer" @onclick="OnAkzeptiert"><Icon Name="check" Groesse="18" /> <span>J'accepte</span></button>
    </Footer>
</ModalDialog>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public string Rolle { get; set; } = Rollen.Direktor;
    [Parameter] public EventCallback OnAkzeptiert { get; set; }
    [Parameter] public EventCallback OnSchliessen { get; set; }
}
