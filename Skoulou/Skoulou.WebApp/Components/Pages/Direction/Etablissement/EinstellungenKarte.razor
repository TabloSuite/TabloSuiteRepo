@* Matrikel-Präfix und Schuleinstellungen (Absenz = 0, Eltern sehen Noten live). *@
@inherits SkoulouSeite
@inject SchulService Schule
@inject TimeProvider Uhr

<Karte Titel="Réglages" Icon="settings">
    <div class="sk-formular">
        <TextFeld Label="Préfixe des matricules" @bind-Wert="praefix" MaxLaenge="6" Sofort="true" Fehler="@(feld == "praefix" ? Fehlermeldung : null)"
                  Hinweis="@($"1 à 6 lettres ou chiffres. Prochain matricule automatique : {Beispiel}")" />
        <Schalter @bind-Wert="absenzNull" Label="Une absence non justifiée à une évaluation compte 0"
                  Hinweis="Sinon, l'évaluation manquée ne compte pas dans la moyenne de l'élève." />
        <Schalter @bind-Wert="elternLive" Label="Les parents voient les notes dès leur saisie"
                  Hinweis="Sinon, ils ne voient que les bulletins publiés." />
        <div class="sk-formular-fuss">
            <AsyncKnopf Text="Enregistrer les réglages" Icon="check" CssClass="sk-btn-primaer" OnClick="SpeichernAsync" />
        </div>
    </div>
</Karte>

@code {
    [Parameter, EditorRequired] public SchulDaten Daten { get; set; } = default!;
    [Parameter] public EventCallback OnGespeichert { get; set; }

    private string? praefix;
    private bool absenzNull, elternLive;
    private string? feld;

    protected override void OnInitialized() => (praefix, absenzNull, elternLive) = (Daten.MatrikelPraefix, Daten.AbsenzOhneEntschuldigungZaehltNull, Daten.ElternSehenNotenLive);

    private string Beispiel
    {
        get
        {
            var p = string.IsNullOrWhiteSpace(praefix) ? NummernFormat.PraefixAusName(Daten.Name) : praefix.Trim().ToUpperInvariant();
            return NummernFormat.Formatiere(NummernArt.Matrikel, new SchulZeit(Uhr).Heute.Year, 1, p);
        }
    }

    private async Task SpeichernAsync()
    {
        feld = null;
        try
        {
            await Schule.EinstellungenSpeichernAsync(Ich.KontoId, new SchulEinstellungEingabe(praefix, absenzNull, elternLive));
            Toast.ZeigeErfolg("Les réglages sont enregistrés.");
            await OnGespeichert.InvokeAsync();
        }
        catch (Skoulou.Core.Fehler.FachFehler f)
        {
            feld = f.Feld;
            Fehlermeldung = f.Message;
            Toast.ZeigeFehler(f.Message);
        }
    }
}
