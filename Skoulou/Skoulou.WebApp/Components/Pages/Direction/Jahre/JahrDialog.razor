@* Schuljahr anlegen, ändern (Name/Daten) oder Periodenstruktur neu erzeugen. *@
@inherits SkoulouSeite
@inject SchuljahrService Schuljahre

<ModalDialog Open="Open" Title="@Titel" Oberzeile="Année scolaire" SchliessenMitEscape="false" ErrorMessage="@Fehlermeldung" OnClose="OnClose">
    <ChildContent>
    <div class="sk-formular">
        @if (Modus != JahrDialogModus.Struktur)
        {
            <TextFeld Label="Nom de l'année" @bind-Wert="bezeichnung" MaxLaenge="80" Pflicht="true" Sofort="true" Platzhalter="2026-2027" Fehler="@FeldFehler("bezeichnung")" />
            <div class="sk-raster-2">
                <DatumFeld Label="Début" @bind-Wert="beginn" Pflicht="true" Fehler="@FeldFehler("beginn")" />
                <DatumFeld Label="Fin" @bind-Wert="ende" Pflicht="true" Min="beginn" Fehler="@FeldFehler("ende")" />
            </div>
        }
        @if (Modus != JahrDialogModus.Aendern)
        {
            <RadioGruppe T="Aufteilung" Label="Combien de périodes / trimestres ?" Wert="aufteilung" WertChanged="AufteilungGewaehlt" Optionen="AufteilungOptionen"
                         Hinweis="1 période = un bulletin à la fin de l'année ; 3 trimestres = trois bulletins et une moyenne annuelle." />
            @if (aufteilung is Aufteilung.Sessions or Aufteilung.Andere)
            {
                <ZahlFeld Label="@(aufteilung == Aufteilung.Sessions ? "Nombre de sessions" : "Nombre de périodes")" Wert="anzahl" WertChanged="v => anzahl = v ?? MinAnzahl"
                          Min="MinAnzahl" Max="PeriodenPlan.MaxPerioden" Stellen="0" />
            }
            <p class="sk-leise">
                Les périodes sont créées à intervalles égaux ; vous ajusterez ensuite leurs dates (vacances) et pourrez ajouter des examens blancs.
                @if (Modus == JahrDialogModus.Struktur)
                {
                    <strong>Les périodes actuelles seront remplacées.</strong>
                }
            </p>
        }
        @if (Preis is { } preis)
        {
            @* 19.11.2026: Preis je Schüler und Monat, live aus Beginn/Ende des Jahres; abgerechnet wird am Ende jeder Periode. *@
            <Hinweis Art="info">
                Prix SKOULOU : @SkoulouKultur.Fcfa(preis) par élève et par mois de cours (adaptable selon l'établissement).
                @if (JahresMonate is { } monate)
                {
                    <span>Pour cette année (≈ @monate mois) : environ @monate × @SkoulouKultur.Fcfa(preis) = <strong>@SkoulouKultur.Fcfa(monate * preis)</strong> par élève, facturés à la fin de chaque période.</span>
                }
            </Hinweis>
        }
    </div>
    </ChildContent>
    <Footer>
        <button type="button" class="sk-btn sk-btn-ghost" @onclick="OnClose">Annuler</button>
        <AsyncKnopf Text="@(Modus == JahrDialogModus.Neu ? "Créer l'année" : "Enregistrer")" Icon="check" CssClass="sk-btn-primaer"
                    Disabled="@(!Vollstaendig)" OnClick="SpeichernAsync" />
    </Footer>
</ModalDialog>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public JahrDialogModus Modus { get; set; }
    [Parameter] public SchuljahrZeile? Jahr { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<Guid> OnGespeichert { get; set; }
    /// <summary>Für die Schule gültiger Preis je Schüler und Monat (Seite « Année scolaire »); null = Hinweis ausblenden.</summary>
    [Parameter] public long? Monatspreis { get; set; }

    // Auswahl im Dialog (19.11.2026): « 1 période » = Libre mit Anzahl 1, « Autre nombre » = Libre mit frei gewählter Anzahl (≥ 2).
    private enum Aufteilung { EinePeriode, Semestres, Trimestres, Sessions, Andere }

    private static readonly IReadOnlyList<AuswahlOption<Aufteilung>> AufteilungOptionen =
    [
        new(Aufteilung.EinePeriode, "1 période (un seul bulletin à la fin)"), new(Aufteilung.Semestres, "2 semestres"),
        new(Aufteilung.Trimestres, "3 trimestres"), new(Aufteilung.Sessions, "Sessions"), new(Aufteilung.Andere, "Autre nombre de périodes"),
    ];

    private string? bezeichnung;
    private DateOnly? beginn, ende;
    private Aufteilung aufteilung = Aufteilung.Trimestres;
    private decimal anzahl = 3;
    private string? feld;
    private bool warOffen;

    private decimal MinAnzahl => aufteilung == Aufteilung.Andere ? 2 : 1;

    private PeriodenArt Art => aufteilung switch
    {
        Aufteilung.Trimestres => PeriodenArt.Trimestre,
        Aufteilung.Semestres => PeriodenArt.Semestre,
        Aufteilung.Sessions => PeriodenArt.Session,
        _ => PeriodenArt.Libre
    };

    private int Anzahl => aufteilung switch
    {
        Aufteilung.EinePeriode => 1,
        Aufteilung.Sessions or Aufteilung.Andere => (int)anzahl,
        _ => PeriodenPlan.StandardAnzahl(Art)
    };

    private static Aufteilung AusArt(PeriodenArt art, int anzahl) => art switch
    {
        PeriodenArt.Trimestre => Aufteilung.Trimestres,
        PeriodenArt.Semestre => Aufteilung.Semestres,
        PeriodenArt.Session => Aufteilung.Sessions,
        _ => PeriodenPlan.IstEinePeriode(art, anzahl) ? Aufteilung.EinePeriode : Aufteilung.Andere
    };

    /// <summary>Bei einem gestarteten Jahr der eingefrorene Preis, sonst der gültige Preis der Schule.</summary>
    private long? Preis => (Modus == JahrDialogModus.Neu ? null : Jahr?.PlattformMonatspreis) ?? Monatspreis;

    /// <summary>Monate des Jahres (gleiche Regel wie die Abrechnung) oder null ohne gültige Daten.</summary>
    private int? JahresMonate => beginn is { } b && ende is { } e && e > b ? Skoulou.Core.Finanzen.PlattformAnteil.Monate(b, e) : null;

    private void AufteilungGewaehlt(Aufteilung wahl)
    {
        aufteilung = wahl;
        if (anzahl < MinAnzahl) anzahl = MinAnzahl;
    }

    private string Titel => Modus switch
    {
        JahrDialogModus.Neu => "Nouvelle année scolaire",
        JahrDialogModus.Struktur => $"Découpage de l'année {Jahr?.Bezeichnung}",
        _ => $"Modifier l'année {Jahr?.Bezeichnung}"
    };

    private string? FeldFehler(string f) => feld == f ? Fehlermeldung : null;

    // Pflichtangaben (Stern) vollständig; der Neuzuschnitt der Perioden hat keine.
    private bool Vollstaendig => Modus == JahrDialogModus.Struktur || (Feld.Ausgefuellt(bezeichnung) && beginn is not null && ende is not null);

    protected override async Task OnParametersSetAsync()
    {
        if (Open && !warOffen)
        {
            warOffen = true;
            Fehlermeldung = null;
            feld = null;
            if (Modus == JahrDialogModus.Neu)
            {
                var v = await Schuljahre.VorschlagAsync(Ich.KontoId);
                (bezeichnung, beginn, ende, anzahl) = (v.Bezeichnung, v.Beginn, v.Ende, v.AnzahlPerioden);
                aufteilung = AusArt(v.PeriodenArt, v.AnzahlPerioden);
            }
            else if (Jahr is { } j)
            {
                (bezeichnung, beginn, ende) = (j.Bezeichnung, j.Beginn, j.Ende);
                anzahl = Math.Max(1, j.Perioden.Count(p => p.ZaehltFuerJahr));
                aufteilung = AusArt(j.PeriodenArt, (int)anzahl);
            }
        }
        else if (!Open)
        {
            warOffen = false;
        }
    }

    private async Task SpeichernAsync()
    {
        feld = null;
        try
        {
            Guid id;
            switch (Modus)
            {
                case JahrDialogModus.Neu:
                    id = await Schuljahre.JahrAnlegenAsync(Ich.KontoId, new SchuljahrEingabe(bezeichnung, beginn, ende, Art, Anzahl));
                    Toast.ZeigeErfolg($"L'année {bezeichnung} est créée avec ses périodes.");
                    break;
                case JahrDialogModus.Struktur:
                    id = Jahr!.Id;
                    await Schuljahre.StrukturNeuAsync(Ich.KontoId, id, Art, Anzahl);
                    Toast.ZeigeErfolg("Les périodes ont été recréées.");
                    break;
                default:
                    id = Jahr!.Id;
                    await Schuljahre.JahrAendernAsync(Ich.KontoId, id, bezeichnung, beginn, ende);
                    Toast.ZeigeErfolg("L'année est enregistrée.");
                    break;
            }
            await OnGespeichert.InvokeAsync(id);
        }
        catch (Skoulou.Core.Fehler.FachFehler f)
        {
            feld = f.Feld;
            Fehlermeldung = f.Message;
        }
    }
}
