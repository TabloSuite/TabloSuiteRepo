@* Ein Schuljahr mit Status, Perioden und allen Aktionen (Start, Abschluss, Wiedereröffnung, Perioden). *@
@inherits SkoulouSeite
@inject SchuljahrService Schuljahre

<Karte CssClass="@($"org-jahr org-jahr-{Jahr.Status.ToString().ToLowerInvariant()}")">
    <div class="org-jahr-kopf">
        <div>
            <h2>@Jahr.Bezeichnung <StatusBadge Text="@StatusText" Art="@StatusArt" /></h2>
            <p class="sk-leise">
                Du @SkoulouKultur.Datum(Jahr.Beginn) au @SkoulouKultur.Datum(Jahr.Ende) · @PeriodenPlan.Bezeichnung(Jahr.PeriodenArt, Jahr.Perioden.Count(p => p.ZaehltFuerJahr))
                · @Jahr.AnzahlKlassen classe@(Jahr.AnzahlKlassen > 1 ? "s" : "") · @Jahr.AnzahlEinschreibungen élève@(Jahr.AnzahlEinschreibungen > 1 ? "s" : "") inscrit@(Jahr.AnzahlEinschreibungen > 1 ? "s" : "")
            </p>
            @if (Jahr.PlattformMonatspreis is { } preis)
            {
                @* 19.11.2026: Preis je Schüler und Monat; die Orientierung zählt die Monate der Perioden, die abgerechnet werden. *@
                var monate = Jahr.Perioden.Where(p => p.ZaehltFuerJahr).Sum(p => Skoulou.Core.Finanzen.PlattformAnteil.Monate(p.Beginn, p.Ende));
                <p class="sk-leise">@(Jahr.Status == SchuljahrStatus.Vorbereitung ? "Prix SKOULOU déjà figé par la première facture de l'année" : "Prix SKOULOU figé au démarrage") : <strong>@SkoulouKultur.Fcfa(preis)</strong> par élève et par mois de cours, facturé à la fin de chaque période (cette année ≈ @monate mois : environ @SkoulouKultur.Fcfa(preis * monate) par élève). Ce prix peut être adapté de façon juste à chaque établissement (par exemple selon sa taille) ; une fois l'année démarrée, il ne change plus.</p>
            }
            @if (Jahr.WiedereroeffnetGrund is { } grund)
            {
                <p class="sk-leise">Rouverte : « @grund »</p>
            }
        </div>
        <div class="sk-knopfzeile">
            @switch (Jahr.Status)
            {
                case SchuljahrStatus.Vorbereitung:
                    <button type="button" class="sk-btn sk-btn-primaer" @onclick="() => frage = Frage.Starten"><Icon Name="play" Groesse="18" /> <span>Démarrer l'année</span></button>
                    <button type="button" class="sk-btn sk-btn-ghost" @onclick="() => OnBearbeiten.InvokeAsync(JahrDialogModus.Aendern)"><Icon Name="edit" Groesse="18" /> <span>Modifier</span></button>
                    <button type="button" class="sk-btn sk-btn-ghost" @onclick="() => OnBearbeiten.InvokeAsync(JahrDialogModus.Struktur)"><Icon Name="layers" Groesse="18" /> <span>Découpage</span></button>
                    <button type="button" class="sk-icon-knopf" title="Supprimer l'année" aria-label="Supprimer l'année" @onclick="() => frage = Frage.Loeschen"><Icon Name="trash" Groesse="18" /></button>
                    break;
                case SchuljahrStatus.Laufend:
                    <a class="sk-btn sk-btn-ghost" href="/direction/annee/passage"><Icon Name="arrow-right" Groesse="18" /> <span>Passage d'année</span></a>
                    <button type="button" class="sk-btn sk-btn-ghost" @onclick="() => OnBearbeiten.InvokeAsync(JahrDialogModus.Aendern)"><Icon Name="edit" Groesse="18" /> <span>Modifier</span></button>
                    <button type="button" class="sk-btn sk-btn-ghost" @onclick="() => frage = Frage.Abschliessen"><Icon Name="lock" Groesse="18" /> <span>Clôturer</span></button>
                    break;
                default:
                    if (IstDirektor)
                    {
                        <button type="button" class="sk-btn sk-btn-ghost" @onclick="() => { frage = Frage.Wiedereroeffnen; grund = null; }"><Icon Name="refresh" Groesse="18" /> <span>Rouvrir</span></button>
                    }
                    break;
            }
        </div>
    </div>

    <div class="sk-tabelle-rahmen">
        <table class="sk-tabelle org-perioden">
            <thead><tr><th>Période</th><th>Dates</th><th>Poids</th><th>État</th><th><span class="sk-leise">Actions</span></th></tr></thead>
            <tbody>
                @foreach (var p in Jahr.Perioden)
                {
                    <tr>
                        <td><strong>@p.Titel</strong>@if (!p.ZaehltFuerJahr) {<StatusBadge Text="Examen blanc" Art="info" />}</td>
                        <td>@SkoulouKultur.Datum(p.Beginn) – @SkoulouKultur.Datum(p.Ende)</td>
                        <td>@(p.ZaehltFuerJahr ? SkoulouKultur.Zahl(p.Jahresgewicht) : "–")</td>
                        <td>@if (p.Status == PeriodenStatus.Offen) {<StatusBadge Text="Ouverte" Art="erfolg" />} else {<StatusBadge Text="Fermée" Art="neutral" Icon="lock" />}</td>
                        <td class="org-aktionen">
                            @if (Offen)
                            {
                                <AsyncKnopf Text="@(p.Status == PeriodenStatus.Offen ? "Fermer" : "Rouvrir")" CssClass="sk-btn-ghost sk-btn-klein"
                                            OnClick="() => StatusAsync(p)" />
                                <button type="button" class="sk-icon-knopf" title="Modifier" aria-label="Modifier @p.Titel" @onclick="() => OnPeriode.InvokeAsync(p)"><Icon Name="edit" Groesse="16" /></button>
                                @if (!p.Benutzt)
                                {
                                    <button type="button" class="sk-icon-knopf" title="Supprimer" aria-label="Supprimer @p.Titel" @onclick="() => { periode = p; frage = Frage.PeriodeLoeschen; }"><Icon Name="trash" Groesse="16" /></button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Offen)
    {
        <button type="button" class="sk-link-knopf org-oben" @onclick="() => OnPeriode.InvokeAsync(null)"><Icon Name="plus" Groesse="16" /> Ajouter une période (ou un examen blanc)</button>
    }
</Karte>

<BestaetigungsDialog Open="frage is Frage.Starten or Frage.Abschliessen or Frage.Loeschen or Frage.PeriodeLoeschen" Titel="@FrageTitel" Text="@FrageText"
                     BestaetigenText="@FrageKnopf" Gefahr="@(frage is not Frage.Starten)" Fehler="@Fehlermeldung"
                     OnBestaetigen="BestaetigenAsync" OnAbbrechen="Abbrechen" />

<ModalDialog Open="frage == Frage.Wiedereroeffnen" Title="@($"Rouvrir l'année {Jahr.Bezeichnung}")" SchliessenMitEscape="false" ErrorMessage="@Fehlermeldung" OnClose="Abbrechen">
    <ChildContent>
    <p class="sk-leise">La réouverture est journalisée. Elle n'est possible que si aucune autre année n'est en cours.</p>
    <TextFeld Label="Motif de la réouverture" @bind-Wert="grund" Zeilen="3" MaxLaenge="500" Pflicht="true" Sofort="true" />
    </ChildContent>
    <Footer>
        <button type="button" class="sk-btn sk-btn-ghost" @onclick="Abbrechen">Annuler</button>
        <AsyncKnopf Text="Rouvrir l'année" Icon="refresh" CssClass="sk-btn-primaer" Disabled="@(!Feld.Ausgefuellt(grund))" OnClick="WiedereroeffnenAsync" />
    </Footer>
</ModalDialog>

@code {
    [Parameter, EditorRequired] public SchuljahrZeile Jahr { get; set; } = default!;
    [Parameter] public bool IstDirektor { get; set; }

    /// <summary>Preis je Schüler und Monat, der beim Start eingefroren würde (Schulpreis, sonst Plattformpreis) – für die Rückfrage.</summary>
    [Parameter] public long? AktuellerMonatspreis { get; set; }
    [Parameter] public EventCallback<JahrDialogModus> OnBearbeiten { get; set; }
    /// <summary>Periode bearbeiten (null = neue Periode).</summary>
    [Parameter] public EventCallback<PeriodeZeile?> OnPeriode { get; set; }
    [Parameter] public EventCallback OnGeaendert { get; set; }

    private enum Frage { Keine, Starten, Abschliessen, Loeschen, PeriodeLoeschen, Wiedereroeffnen }

    private Frage frage;
    private PeriodeZeile? periode;
    private string? grund;

    private bool Offen => Jahr.Status != SchuljahrStatus.Abgeschlossen;

    private string StatusText => Jahr.Status switch
    {
        SchuljahrStatus.Laufend => "En cours",
        SchuljahrStatus.Abgeschlossen => "Clôturée",
        _ => "En préparation"
    };

    private string StatusArt => Jahr.Status switch { SchuljahrStatus.Laufend => "erfolg", SchuljahrStatus.Abgeschlossen => "neutral", _ => "info" };

    private string FrageTitel => frage switch
    {
        Frage.Starten => $"Démarrer l'année {Jahr.Bezeichnung} ?",
        Frage.Abschliessen => $"Clôturer l'année {Jahr.Bezeichnung} ?",
        Frage.Loeschen => $"Supprimer l'année {Jahr.Bezeichnung} ?",
        _ => $"Supprimer la période « {periode?.Titel} » ?"
    };

    private string FrageText => frage switch
    {
        Frage.Starten => SchuljahrService.StartFrage(Jahr.PlattformMonatspreis, AktuellerMonatspreis),
        Frage.Abschliessen => "Toutes les périodes seront fermées et plus rien ne pourra être modifié (classes, inscriptions, présences). Seul le directeur peut rouvrir l'année, avec un motif. Pour passer à l'année suivante, utilisez de préférence le passage d'année.",
        Frage.Loeschen => "L'année et ses périodes sont supprimées. Possible seulement tant qu'elle ne contient ni classe ni inscription.",
        _ => "La période est supprimée définitivement."
    };

    private string FrageKnopf => frage switch { Frage.Starten => "Démarrer", Frage.Abschliessen => "Clôturer", _ => "Supprimer" };

    private void Abbrechen()
    {
        frage = Frage.Keine;
        Fehlermeldung = null;
    }

    private async Task BestaetigenAsync()
    {
        var aktion = frage;
        var ok = await AusfuehrenAsync(() => aktion switch
        {
            Frage.Starten => Schuljahre.JahrStartenAsync(Ich.KontoId, Jahr.Id),
            Frage.Abschliessen => Schuljahre.JahrAbschliessenAsync(Ich.KontoId, Jahr.Id),
            Frage.Loeschen => Schuljahre.JahrLoeschenAsync(Ich.KontoId, Jahr.Id),
            _ => Schuljahre.PeriodeLoeschenAsync(Ich.KontoId, periode!.Id)
        }, aktion switch
        {
            Frage.Starten => $"L'année {Jahr.Bezeichnung} est en cours.",
            Frage.Abschliessen => $"L'année {Jahr.Bezeichnung} est clôturée.",
            Frage.Loeschen => "L'année est supprimée.",
            _ => "La période est supprimée."
        });
        if (!ok) return;
        frage = Frage.Keine;
        await OnGeaendert.InvokeAsync();
    }

    private async Task StatusAsync(PeriodeZeile p)
    {
        if (await AusfuehrenAsync(() => Schuljahre.PeriodeStatusAsync(Ich.KontoId, p.Id, p.Status == PeriodenStatus.Offen),
                p.Status == PeriodenStatus.Offen ? $"« {p.Titel} » est fermée." : $"« {p.Titel} » est rouverte."))
            await OnGeaendert.InvokeAsync();
    }

    private async Task WiedereroeffnenAsync()
    {
        if (!await AusfuehrenAsync(() => Schuljahre.JahrWiedereroeffnenAsync(Ich.KontoId, Jahr.Id, grund), $"L'année {Jahr.Bezeichnung} est rouverte.")) return;
        frage = Frage.Keine;
        await OnGeaendert.InvokeAsync();
    }
}
