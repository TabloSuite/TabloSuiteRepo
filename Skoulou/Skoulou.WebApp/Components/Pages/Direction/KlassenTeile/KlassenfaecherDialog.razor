@* Fächer, Koeffizienten und Lehraufträge einer Klasse; Koeffizienten kopieren bzw. auf das Niveau übertragen.
   Mit Wahlfächern zweiter Reiter « Matières facultatives »: Häkchen je Schüler (Entwurf bleibt beim Reiterwechsel erhalten). *@
@inherits SkoulouSeite
@inject UnterrichtService Unterricht
@inject FaecherService Faecher

<ModalDialog Open="Klasse is not null" Title="@($"Matières et enseignants · {Klasse?.Name}")" Oberzeile="@Klasse?.StufeName" Breite="sk-modal-lg"
             SchliessenMitEscape="false" ErrorMessage="@Fehlermeldung" OnClose="SchliessenAsync">
    <ChildContent>
        @if (faecher is not null && faecher.Any(f => f.IstWahlfach))
        {
            <div class="sk-reiter org-kf-reiter" role="tablist" aria-label="Sections">
                <button type="button" role="tab" class="sk-reiter-link @(wahlReiter ? null : "aktiv")" aria-selected="@(wahlReiter ? "false" : "true")" @onclick="() => ReiterAsync(false)">
                    <Icon Name="book" Groesse="16" /> <span>Matières</span>
                </button>
                <button type="button" role="tab" class="sk-reiter-link @(wahlReiter ? "aktiv" : null)" aria-selected="@(wahlReiter ? "true" : "false")" @onclick="() => ReiterAsync(true)">
                    <Icon Name="check-square" Groesse="16" /> <span>Matières facultatives</span>
                    @if (AnzahlAenderungen > 0)
                    {
                        <span class="sk-reiter-zahl" title="Modifications non enregistrées">@AnzahlAenderungen</span>
                    }
                </button>
            </div>
        }
        @if (faecher is null || (wahlReiter && wahl is null))
        {
            <div class="sk-skelett"><div></div><div></div></div>
        }
        else if (wahlReiter && wahl is not null)
        {
            @if (schliessenWarnung)
            {
                <Hinweis Art="warn" Titel="Choix non enregistrés">Enregistrez-les, ou cliquez encore une fois sur « Terminé » pour les abandonner.</Hinweis>
            }
            <FachwahlenAnsicht Uebersicht="wahl" Entwurf="entwurf" Offen="@(Offen && wahl.Offen)" OnGeaendert="() => schliessenWarnung = false" />
        }
        else
        {
            @if (Offen)
            {
                <div class="org-kf-werkzeuge">
                    <AuswahlFeld T="Guid?" Label="Ajouter une matière" @bind-Wert="neuesFach" Optionen="FachOptionen" Platzhalter="Choisir…" Pflicht="true" />
                    <ZahlFeld Label="Coefficient" @bind-Wert="neuerKoeff" Min="0.01m" Max="100" Stellen="2" />
                    <div class="sk-knopfzeile">
                        <AsyncKnopf Text="Ajouter" Icon="plus" CssClass="sk-btn-primaer" Disabled="@(neuesFach is null)" OnClick="FachHinzufuegenAsync" />
                        @if (FachOptionen.Count > 1)
                        {
                            <AsyncKnopf Text="Toutes les matières" CssClass="sk-btn-ghost" OnClick="AlleHinzufuegenAsync" />
                        }
                    </div>
                </div>
            }
            @if (faecher.Count == 0)
            {
                <Leerzustand Icon="book" Titel="Aucune matière dans cette classe" Text="Ajoutez les matières une à une, toutes d'un coup, ou copiez-les d'une autre classe." />
            }
            else
            {
                <div class="org-kf-liste">
                    @foreach (var f in faecher)
                    {
                        <KlassenfachEintrag @key="f.Id" Fach="f" Lehrkraefte="Lehrkraefte" Offen="Offen" OnGeaendert="GeaendertAsync" OnEntfernen="FachEntfernenAsync" />
                    }
                </div>
                @* 19.11.2026: Koeffizienten wie die Zeile « TOTAUX » des Bulletins – ohne Wahlfächer (zählen je Schüler und Regel). *@
                <p class="sk-leise">Total : @faecher.Count matière@(faecher.Count > 1 ? "s" : ""), coefficients @SkoulouKultur.Zahl(faecher.Where(f => !f.IstWahlfach).Sum(f => f.Koeffizient))@(faecher.Any(f => f.IstWahlfach) ? " (sans les matières facultatives)" : ""), @SkoulouKultur.Zahl(faecher.Sum(f => f.Lehrer.Sum(l => l.Wochenstunden)), 1) h par semaine.</p>
            }
            @if (Offen)
            {
                <div class="org-kf-kopie">
                    <AuswahlFeld T="Guid?" Label="Copier matières et coefficients depuis" @bind-Wert="quelle" Optionen="QuellOptionen" Platzhalter="Autre classe…" Pflicht="true" />
                    <AsyncKnopf Text="Copier" Icon="layers" CssClass="sk-btn-ghost" Disabled="@(quelle is null)" OnClick="KopierenAsync" />
                    @if (Klasse?.StufeId is not null && faecher.Count > 0)
                    {
                        <AsyncKnopf Text="@($"Appliquer à toutes les classes de {Klasse.StufeName}")" CssClass="sk-btn-ghost" OnClick="AufStufeAsync" />
                    }
                </div>
            }
        }
    </ChildContent>
    <Footer>
        @if (wahlReiter && wahl is not null && Offen && wahl.Offen)
        {
            @if (AnzahlAenderungen > 0)
            {
                <button type="button" class="sk-btn sk-btn-ghost" @onclick="Verwerfen">Annuler les modifications</button>
            }
            <AsyncKnopf Text="@(AnzahlAenderungen > 0 ? $"Enregistrer ({AnzahlAenderungen})" : "Enregistrer")" Icon="check" CssClass="sk-btn-primaer"
                        Disabled="@(AnzahlAenderungen == 0)" OnClick="WahlenSpeichernAsync" />
            <button type="button" class="sk-btn sk-btn-ghost" @onclick="SchliessenAsync">Terminé</button>
        }
        else
        {
            <button type="button" class="sk-btn sk-btn-primaer" @onclick="SchliessenAsync">Terminé</button>
        }
    </Footer>
</ModalDialog>

@code {
    [Parameter] public KlasseZeile? Klasse { get; set; }
    [Parameter] public IReadOnlyList<KlasseZeile> AlleKlassen { get; set; } = [];
    [Parameter] public IReadOnlyList<AuswahlEintrag> Lehrkraefte { get; set; } = [];
    [Parameter] public bool Offen { get; set; } = true;
    /// <summary>Gleich mit dem Reiter « Matières facultatives » öffnen (Knopf auf der Klassenkarte).</summary>
    [Parameter] public bool StartFacultatives { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Etwas wurde geändert (Klassenliste beim Schließen neu laden).</summary>
    [Parameter] public EventCallback OnGeaendert { get; set; }

    private List<KlassenfachZeile>? faecher;
    private List<FachZeile> alleFaecher = [];
    private Guid? neuesFach, quelle, geladenFuer;
    private decimal? neuerKoeff = 1;
    private bool geaendert;

    // Reiter « Matières facultatives »: gespeicherter Stand und Entwurf der Häkchen
    private bool wahlReiter, schliessenWarnung;
    private FachwahlUebersicht? wahl;
    private HashSet<(Guid KlassenfachId, Guid SchuelerId)> entwurf = [];

    private HashSet<(Guid, Guid)> Gespeichert => wahl is null ? []
        : wahl.Schueler.SelectMany(s => s.Gewaehlt.Select(k => (k, s.SchuelerId))).ToHashSet();

    private int AnzahlAenderungen => wahl is null ? 0 : entwurf.Except(Gespeichert).Count() + Gespeichert.Except(entwurf).Count();

    private IReadOnlyList<AuswahlOption<Guid?>> FachOptionen =>
        alleFaecher.Where(f => f.Aktiv && (faecher ?? []).All(k => k.FachId != f.Id))
            .Select(f => new AuswahlOption<Guid?>(f.Id, f.Name, FaecherService.GruppenText(f.Gruppe))).ToList();

    private IReadOnlyList<AuswahlOption<Guid?>> QuellOptionen =>
        AlleKlassen.Where(k => k.Id != Klasse?.Id && k.AnzahlFaecher > 0)
            .Select(k => new AuswahlOption<Guid?>(k.Id, k.Name, $"{k.AnzahlFaecher} matière{(k.AnzahlFaecher > 1 ? "s" : "")}")).ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (Klasse is { } k && geladenFuer != k.Id)
        {
            geladenFuer = k.Id;
            (faecher, quelle, neuesFach, neuerKoeff, geaendert) = (null, null, null, 1, false);
            (wahlReiter, schliessenWarnung, wahl, entwurf) = (false, false, null, []);
            await AusfuehrenAsync(async () =>
            {
                alleFaecher = (await Faecher.FaecherAsync(Ich.KontoId, mitInaktiven: false)).ToList();
                await LadenAsync();
            });
            if (StartFacultatives && faecher?.Any(f => f.IstWahlfach) == true) await ReiterAsync(true);
        }
        else if (Klasse is null)
        {
            geladenFuer = null;
        }
    }

    private async Task LadenAsync()
    {
        if (Klasse is null) return;
        faecher = (await Unterricht.KlassenfaecherAsync(Ich.KontoId, Klasse.Id)).ToList();
    }

    /// <summary>Nach einer Änderung: neu laden und beim Schließen die Klassenliste aktualisieren.</summary>
    private async Task GeaendertAsync()
    {
        geaendert = true;
        await AusfuehrenAsync(LadenAsync);
        if (faecher?.Any(f => f.IstWahlfach) != true)
        {
            (wahlReiter, wahl, entwurf) = (false, null, []);
        }
        else if (wahl is not null && Klasse is { } k)
        {
            // Wahlfach ein/aus oder Regel geändert: Stand neu laden, offene Häkchen der weiterhin facultativen Fächer behalten.
            var neu = entwurf.Except(Gespeichert).ToList();
            var weg = Gespeichert.Except(entwurf).ToList();
            await AusfuehrenAsync(async () =>
            {
                wahl = await Unterricht.FachwahlenAsync(Ich.KontoId, k.Id);
                var gueltig = wahl.Faecher.Select(f => f.KlassenfachId).ToHashSet();
                entwurf = Gespeichert.Union(neu.Where(x => gueltig.Contains(x.Item1))).Except(weg).ToHashSet();
            });
        }
    }

    /// <summary>Reiter wechseln; « Matières facultatives » lädt beim ersten Öffnen den gespeicherten Stand.</summary>
    private async Task ReiterAsync(bool facultatives)
    {
        wahlReiter = facultatives;
        if (facultatives && wahl is null && Klasse is { } k)
        {
            await AusfuehrenAsync(async () =>
            {
                wahl = await Unterricht.FachwahlenAsync(Ich.KontoId, k.Id);
                entwurf = Gespeichert;
            });
            if (wahl is null) wahlReiter = false;
        }
    }

    private void Verwerfen() => (entwurf, schliessenWarnung) = (Gespeichert, false);

    private async Task WahlenSpeichernAsync()
    {
        if (Klasse is not { } k || wahl is null) return;
        var anzahl = 0;
        var stand = entwurf.ToList();
        if (!await AusfuehrenAsync(async () => anzahl = await Unterricht.FachwahlenSpeichernAsync(Ich.KontoId, k.Id, stand))) return;
        Toast.ZeigeErfolg(anzahl == 0 ? "Rien à enregistrer." : $"Matières facultatives enregistrées ({anzahl} changement{(anzahl > 1 ? "s" : "")}).");
        schliessenWarnung = false;
        geaendert = true;
        await AusfuehrenAsync(async () =>
        {
            wahl = await Unterricht.FachwahlenAsync(Ich.KontoId, k.Id);
            entwurf = Gespeichert;
            await LadenAsync();
        });
    }

    private async Task FachHinzufuegenAsync()
    {
        if (neuesFach is not { } id || Klasse is null) return;
        if (await AusfuehrenAsync(() => Unterricht.FaecherHinzufuegenAsync(Ich.KontoId, Klasse.Id, [id], neuerKoeff ?? 1), "La matière est ajoutée."))
        {
            neuesFach = null;
            await GeaendertAsync();
        }
    }

    private async Task AlleHinzufuegenAsync()
    {
        if (Klasse is null) return;
        var ids = FachOptionen.Select(o => o.Wert!.Value).ToList();
        if (await AusfuehrenAsync(() => Unterricht.FaecherHinzufuegenAsync(Ich.KontoId, Klasse.Id, ids, neuerKoeff ?? 1), $"{ids.Count} matières ajoutées."))
            await GeaendertAsync();
    }

    private async Task FachEntfernenAsync(KlassenfachZeile f)
    {
        if (await AusfuehrenAsync(() => Unterricht.KlassenfachEntfernenAsync(Ich.KontoId, f.Id), $"{f.Fach} est retirée de la classe."))
            await GeaendertAsync();
    }

    private async Task KopierenAsync()
    {
        if (quelle is not { } q || Klasse is null) return;
        var name = AlleKlassen.FirstOrDefault(k => k.Id == q)?.Name;
        if (await AusfuehrenAsync(() => Unterricht.KoeffizientenKopierenAsync(Ich.KontoId, q, Klasse.Id), $"Matières et coefficients copiés depuis {name}."))
        {
            quelle = null;
            await GeaendertAsync();
        }
    }

    private async Task AufStufeAsync()
    {
        if (Klasse is null) return;
        var anzahl = 0;
        if (await AusfuehrenAsync(async () => anzahl = await Unterricht.KoeffizientenAufStufeAsync(Ich.KontoId, Klasse.Id)))
        {
            Toast.ZeigeErfolg(anzahl == 0 ? "Aucune autre classe active dans ce niveau." : $"Coefficients appliqués à {anzahl} autre{(anzahl > 1 ? "s" : "")} classe{(anzahl > 1 ? "s" : "")}.");
            geaendert = true;
        }
    }

    private async Task SchliessenAsync()
    {
        // Ungespeicherte Häkchen: erst warnen (Reiter zeigen), beim zweiten Mal verwerfen.
        if (AnzahlAenderungen > 0 && !schliessenWarnung)
        {
            (wahlReiter, schliessenWarnung) = (true, true);
            return;
        }
        if (geaendert) await OnGeaendert.InvokeAsync();
        await OnClose.InvokeAsync();
    }
}
