@* Ein Fach einer Klasse: Koeffizient (speichert beim Verlassen), Lehrkräfte mit Wochenstunden, Entfernen,
   « Matière facultative » mit Regel für die Moyenne (Entwurf + « Enregistrer », Bauplan §5 Regel 2a). *@
@inherits SkoulouSeite
@inject UnterrichtService Unterricht
@using Skoulou.Core.Noten

<div class="org-kf">
    <div class="org-kf-fach">
        <strong>@Fach.Fach</strong>
        <small class="sk-leise">@(Fach.Kuerzel ?? "") @FaecherService.GruppenText(Fach.Gruppe)</small>
        @if (Fach.IstWahlfach)
        {
            <StatusBadge Text="Facultative" Art="info" />
        }
    </div>
    <div class="org-kf-koeff">
        <ZahlFeld Label="Coef." Wert="Fach.Koeffizient" WertChanged="KoeffizientAsync" Min="0.01m" Max="100" Stellen="2" Deaktiviert="@(!Offen)" />
    </div>
    <div class="org-kf-lehrer">
        @foreach (var l in Fach.Lehrer)
        {
            <span class="sk-chip org-lehrer-chip">
                @l.Lehrer · @SkoulouKultur.Zahl(l.Wochenstunden, 1) h
                @if (Offen)
                {
                    <button type="button" class="org-chip-x" aria-label="Retirer @l.Lehrer" title="Retirer l'affectation" @onclick="() => EntfernenAsync(l)"><Icon Name="x" Groesse="14" /></button>
                }
            </span>
        }
        @if (Offen)
        {
            @if (neu)
            {
                <div class="org-kf-neu">
                    <AuswahlFeld T="Guid?" @bind-Wert="lehrerId" Optionen="LehrerOptionen" Platzhalter="Enseignant…" Kompakt="true" />
                    <ZahlFeld @bind-Wert="stunden" Min="0.5m" Max="40" Stellen="1" Einheit="h/sem." />
                    <AsyncKnopf Text="Affecter" CssClass="sk-btn-primaer sk-btn-klein" Disabled="@(lehrerId is null)" OnClick="ZuweisenAsync" />
                    <button type="button" class="sk-link-knopf" @onclick="() => neu = false">Annuler</button>
                </div>
            }
            else
            {
                <button type="button" class="sk-link-knopf" @onclick="() => neu = true"><Icon Name="user-plus" Groesse="16" /> @(Fach.Lehrer.Count == 0 ? "Affecter un enseignant" : "Ajouter")</button>
            }
        }
    </div>
    @if (Offen)
    {
        <button type="button" class="sk-icon-knopf" title="Retirer la matière de la classe" aria-label="Retirer @Fach.Fach" @onclick="() => OnEntfernen.InvokeAsync(Fach)"><Icon Name="trash" Groesse="16" /></button>
    }
    @if (Offen || Fach.IstWahlfach)
    {
        <div class="org-kf-wahl">
            <Schalter Wert="wahlAn" WertChanged="v => wahlAn = v" Label="Matière facultative" Deaktiviert="@(!Aenderbar)"
                      Hinweis="@(Fach.IstWahlfach ? $"Choisie par {Fach.AnzahlGewaehlt} élève{(Fach.AnzahlGewaehlt > 1 ? "s" : "")}" : "Notée seulement pour les élèves qui la choisissent")" />
            @if (wahlAn)
            {
                <AuswahlFeld T="WahlfachRegel?" Label="Compte dans la moyenne" @bind-Wert="regel" Optionen="RegelOptionen" Pflicht="true" Deaktiviert="@(!Aenderbar)"
                             Hinweis="@RegelHinweis" />
                @if (Fach.NotenOhneWahl > 0)
                {
                    @* Nutzer 19.11.2026: vorhandene Noten bleiben, zählen aber nur für Wählende – sichtbar sagen, nicht still ausblenden. *@
                    <Hinweis Art="info">@NotenHinweis</Hinweis>
                }
            }
            @if (Offen && Fach.WahlfachGesperrt)
            {
                <small class="sk-leise org-kf-sperre"><Icon Name="lock" Groesse="14" /> @UnterrichtService.MeldungWahlfachGesperrt</small>
            }
            @if (Aenderbar && Geaendert)
            {
                <AsyncKnopf Text="Enregistrer" Icon="check" CssClass="sk-btn-primaer sk-btn-klein" Disabled="@(wahlAn && regel is null)" OnClick="WahlfachAsync" />
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public KlassenfachZeile Fach { get; set; } = default!;
    [Parameter] public IReadOnlyList<AuswahlEintrag> Lehrkraefte { get; set; } = [];
    [Parameter] public bool Offen { get; set; } = true;
    [Parameter] public EventCallback OnGeaendert { get; set; }
    [Parameter] public EventCallback<KlassenfachZeile> OnEntfernen { get; set; }

    private bool neu;
    private Guid? lehrerId;
    private decimal? stunden;

    // Entwurf der Wahlfach-Einstellung (gespeichert erst mit « Enregistrer »)
    private bool wahlAn;
    private WahlfachRegel? regel;
    private (bool, WahlfachRegel)? geladen;

    private static readonly IReadOnlyList<AuswahlOption<WahlfachRegel?>> RegelOptionen =
    [
        new(WahlfachRegel.PunkteUeber10, NotenTexte.WahlfachText(WahlfachRegel.PunkteUeber10), "Standard"),
        new(WahlfachRegel.WieNormal, NotenTexte.WahlfachText(WahlfachRegel.WieNormal)),
        new(WahlfachRegel.NurInformation, NotenTexte.WahlfachText(WahlfachRegel.NurInformation)),
    ];

    private string? RegelHinweis => regel switch
    {
        WahlfachRegel.PunkteUeber10 => "Ex. : 16/20 en coef. 2 ajoute (16 − 10) × 2 = 12 points ; sous 10, rien n'est retiré.",
        WahlfachRegel.WieNormal => "Avec son coefficient, comme les autres matières.",
        WahlfachRegel.NurInformation => "Figure sur le bulletin, sans effet sur la moyenne.",
        _ => null
    };

    private bool Geaendert => wahlAn != Fach.IstWahlfach || (wahlAn && regel != Fach.WahlfachRegel);

    /// <summary>Schalter und Regel änderbar: Jahr offen und noch keine Bulletins der Klasse veröffentlicht.</summary>
    private bool Aenderbar => Offen && !Fach.WahlfachGesperrt;

    private string NotenHinweis => Fach.NotenOhneWahl == 1
        ? "1 note est déjà saisie pour un élève qui n'a pas choisi cette matière : elle reste enregistrée, mais ne compte que s'il la choisit (onglet « Matières facultatives »)."
        : $"{Fach.NotenOhneWahl} notes sont déjà saisies pour des élèves qui n'ont pas choisi cette matière : elles restent enregistrées, mais ne comptent que pour les élèves qui la choisissent (onglet « Matières facultatives »).";

    protected override void OnParametersSet()
    {
        if (geladen != (Fach.IstWahlfach, Fach.WahlfachRegel))
        {
            geladen = (Fach.IstWahlfach, Fach.WahlfachRegel);
            (wahlAn, regel) = (Fach.IstWahlfach, Fach.WahlfachRegel);
        }
    }

    private async Task WahlfachAsync()
    {
        var r = regel ?? WahlfachRegel.PunkteUeber10;
        var meldung = wahlAn ? $"{Fach.Fach} est facultative : {NotenTexte.WahlfachText(r).ToLower(SkoulouKultur.Kultur)}." : $"{Fach.Fach} redevient obligatoire.";
        if (await AusfuehrenAsync(() => Unterricht.WahlfachSetzenAsync(Ich.KontoId, Fach.Id, wahlAn, r), meldung))
            await OnGeaendert.InvokeAsync();
    }

    private IReadOnlyList<AuswahlOption<Guid?>> LehrerOptionen =>
        Lehrkraefte.Where(l => Fach.Lehrer.All(x => x.LehrerId != l.Id)).Select(l => new AuswahlOption<Guid?>(l.Id, l.Name, l.Zusatz)).ToList();

    private async Task KoeffizientAsync(decimal? wert)
    {
        if (wert is not { } k || k == Fach.Koeffizient) return;
        if (await AusfuehrenAsync(() => Unterricht.KoeffizientSetzenAsync(Ich.KontoId, Fach.Id, k), $"Coefficient de {Fach.Fach} : {SkoulouKultur.Zahl(k)}."))
            await OnGeaendert.InvokeAsync();
    }

    private async Task ZuweisenAsync()
    {
        if (lehrerId is not { } id) return;
        if (!await AusfuehrenAsync(() => Unterricht.LehrauftragSetzenAsync(Ich.KontoId, Fach.Id, id, stunden ?? 1), "L'enseignant est affecté.")) return;
        (neu, lehrerId, stunden) = (false, null, null);
        await OnGeaendert.InvokeAsync();
    }

    private async Task EntfernenAsync(LehrauftragKurz l)
    {
        if (await AusfuehrenAsync(() => Unterricht.LehrauftragEntfernenAsync(Ich.KontoId, l.Id), $"{l.Lehrer} n'enseigne plus {Fach.Fach} dans cette classe."))
            await OnGeaendert.InvokeAsync();
    }
}
