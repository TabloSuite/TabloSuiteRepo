@* Einem bestehenden Elternkonto ein Kind zuordnen (Beziehung wählbar). *@
@inherits SkoulouSeite
@inject ElternService Eltern

<ModalDialog Open="ElternTeil is not null" Title="Lier un enfant" Oberzeile="@ElternTeil?.Name" SchliessenMitEscape="false" ErrorMessage="@Fehlermeldung" OnClose="OnClose">
    <ChildContent>
        <div class="sk-formular">
            <SchuelerSuche AkteurId="Ich.KontoId" Label="Élève" Pflicht="true" @bind-Gewaehlt="kind" />
            <RadioGruppe T="string" Label="Lien de parenté" @bind-Wert="beziehung" Optionen="ElternDialog.BeziehungsOptionen" />
            <p class="sk-leise">Un compte parent peut suivre jusqu'à @ElternService.MaxKinder enfants de l'établissement.</p>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="sk-btn sk-btn-ghost" @onclick="OnClose">Annuler</button>
        <AsyncKnopf Text="Lier l'enfant" Icon="check" CssClass="sk-btn-primaer" Disabled="@(kind is null)" OnClick="SpeichernAsync" />
    </Footer>
</ModalDialog>

@code {
    [Parameter] public ElternZeile? ElternTeil { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnErledigt { get; set; }

    private AuswahlEintrag? kind;
    private string beziehung = "Mère";
    private Guid? geladenFuer;

    protected override void OnParametersSet()
    {
        if (ElternTeil is { } e && geladenFuer != e.KontoId)
        {
            geladenFuer = e.KontoId;
            (kind, beziehung, Fehlermeldung) = (null, "Mère", null);
        }
        else if (ElternTeil is null)
        {
            geladenFuer = null;
        }
    }

    private async Task SpeichernAsync()
    {
        if (ElternTeil is not { } e || kind is not { } k) return;
        if (await AusfuehrenAsync(() => Eltern.VerknuepfenAsync(Ich.KontoId, e.KontoId, k.Id, beziehung), $"{k.Name} est lié(e) à {e.Name}."))
            await OnErledigt.InvokeAsync();
    }
}
