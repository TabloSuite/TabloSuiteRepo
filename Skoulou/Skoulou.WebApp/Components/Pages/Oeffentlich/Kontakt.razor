@page "/contact"
@attribute [AllowAnonymous]
@inherits SkoulouSeite
@inject KontaktService Kontakte
@inject KontoService Konten
@inject IJSRuntime JS

<PageTitle>Contact · SKOULOU</PageTitle>

<div class="sk-seite-schmal">
    <SeitenKopf Titel="Contact" Icon="mail" Untertitel="Une question, un problème, une suggestion ? Écrivez à l'équipe SKOULOU." />

    @if (responsable is not null)
    {
        <Karte Titel="Votre responsable SKOULOU" Icon="briefcase" Untertitel="Il accompagne votre établissement au quotidien.">
            <div class="sk-kontakt-person">
                <NamensKreis Name="@responsable.Name" Groesse="44" />
                <strong>@responsable.Name</strong>
                <div class="sk-knopfzeile">
                    @if (responsable.Telefon is not null)
                    {
                        <a class="sk-btn sk-btn-ghost sk-btn-klein" href="tel:@(new string(responsable.Telefon.Where(c => char.IsDigit(c) || c == '+').ToArray()))"><Icon Name="phone" Groesse="16" /> Appeler</a>
                    }
                    @if (responsable.WhatsApp is not null)
                    {
                        <a class="sk-btn sk-btn-ghost sk-btn-klein" href="@responsable.WhatsApp" target="_blank" rel="noopener"><Icon Name="message" Groesse="16" /> WhatsApp</a>
                    }
                    @if (responsable.Email is not null)
                    {
                        <a class="sk-btn sk-btn-ghost sk-btn-klein" href="mailto:@responsable.Email"><Icon Name="mail" Groesse="16" /> E-mail</a>
                    }
                </div>
            </div>
        </Karte>
    }

    @if (gesendet)
    {
        <Karte>
            <Leerzustand Icon="check-circle" Titel="Merci ! Votre message a bien été envoyé." Text="Nous vous répondrons par e-mail dans les meilleurs délais.">
                <a class="sk-btn sk-btn-ghost" href="/">Retour à l'accueil</a>
            </Leerzustand>
        </Karte>
    }
    else
    {
        <Karte Titel="Écrire à SKOULOU" Icon="send">
            <Hinweis Art="info">Ce message est envoyé à l'équipe de support de SKOULOU, et non à votre établissement. Pour vos notes, absences ou frais, adressez-vous à la direction de votre école.</Hinweis>
            @if (Fehlermeldung is not null)
            {
                <Hinweis Art="fehler">@Fehlermeldung</Hinweis>
            }
            <form id="@formId" method="post" action="/contact/envoyer" class="sk-formular" @onsubmit="SendenAsync" @onsubmit:preventDefault>
                <AntiforgeryToken />
                <div class="sk-raster-2">
                    <TextFeld Label="Votre nom" Name="nom" @bind-Wert="name" Autocomplete="name" MaxLaenge="100" Pflicht="true" />
                    <TextFeld Label="Votre e-mail" Name="email" Typ="email" @bind-Wert="email" Autocomplete="email" MaxLaenge="256" Pflicht="true" />
                </div>
                <TextFeld Label="Sujet" Name="sujet" @bind-Wert="sujet" MaxLaenge="150" Pflicht="true" />
                <TextFeld Label="Message" Name="message" Zeilen="6" @bind-Wert="nachricht" MaxLaenge="5000" Pflicht="true"
                          Hinweis="Au moins 10 caractères." />
                <label class="sk-honigtopf" aria-hidden="true">Site web <input type="text" name="site" tabindex="-1" autocomplete="off" /></label>
                <div class="sk-formular-fuss">
                    <AsyncKnopf Text="Envoyer le message" BusyText="Envoi…" Icon="send" CssClass="sk-btn-primaer" OnClick="SendenAsync" />
                </div>
            </form>
        </Karte>
    }
</div>

@code {
    private readonly string formId = Feld.NeueId("contact");
    private string? name, email, sujet, nachricht;
    private bool gesendet;
    private ResponsableKontakt? responsable;

    protected override async Task InitialisierenAsync()
    {
        var abfrage = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        gesendet = abfrage.ContainsKey("envoye");
        Fehlermeldung = abfrage.TryGetValue("erreur", out var code) ? code.ToString() switch
        {
            "limite" => "Trop de messages en peu de temps. Réessayez dans quelques minutes.",
            "session" => "La page a expiré. Veuillez réessayer.",
            _ => "Le message n'a pas pu être envoyé. Vérifiez vos saisies."
        } : null;

        if (Ich.Angemeldet)
        {
            var profil = await Konten.LadeProfilAsync(Ich.KontoId);
            name = $"{profil.Vorname} {profil.Nachname}".Trim();
            email = profil.Email;
            responsable = await Kontakte.ResponsableFuerAsync(Ich.KontoId);
        }
    }

    private async Task SendenAsync()
    {
        Fehlermeldung = KontaktService.Pruefe(new KontaktEingabe(name, email, sujet, nachricht));
        if (Fehlermeldung is null) await JS.InvokeVoidAsync("skFormularSenden", formId);
    }
}
