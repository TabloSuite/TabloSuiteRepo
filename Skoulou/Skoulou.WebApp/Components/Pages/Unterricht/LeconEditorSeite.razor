@page "/enseignant/lecons/nouvelle"
@page "/enseignant/lecons/{Id:guid}/modifier"
@attribute [Authorize(Policy = Richtlinien.Unterricht)]
@inherits SkoulouSeite
@using Skoulou.Core.Paedagogik
@using Skoulou.WebApp.Services.Paedagogik
@using Skoulou.WebApp.Components.Pages.Paedagogik

<InhaltEditor Art="InhaltsArt.Lecon" Id="Id" Pour="Pour" />

@code {
    [Parameter] public Guid? Id { get; set; }
    [SupplyParameterFromQuery(Name = "pour")] public string? PourText { get; set; }
    // Kaputte Adresse (?pour=…) brach die Seite mit « Une erreur inattendue » bzw. HTTP 500 ab (Klicktest 21.11.2026) – selbst lesen.
    private Guid? Pour => Guid.TryParse(PourText, out var wert) ? wert : null;
}
