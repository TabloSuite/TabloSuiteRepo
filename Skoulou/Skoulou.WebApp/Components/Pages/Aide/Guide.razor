@page "/aide/guide"
@attribute [Authorize]
@inherits SkoulouSeite
@inject Skoulou.WebApp.Services.KiHilfe.KiHilfeDienst KiHilfe

<PageTitle>Guide utilisateur · SKOULOU</PageTitle>

<SeitenKopf Titel="Guide utilisateur" Icon="book" Oberzeile="@Rollen.Bezeichnung(Ich.Rolle)"
            Untertitel="L'essentiel pour votre rôle, étape par étape. Chaque point mène directement à la bonne page." />

<nav class="pl-guide-sprung" aria-label="Chapitres">
    @foreach (var k in kapitel)
    {
        <a class="sk-chip" href="/aide/guide#@k.Id"><Icon Name="@k.Icon" Groesse="14" /> @k.Titel</a>
    }
    <a class="sk-chip" href="/aide/videos"><Icon Name="video" Groesse="14" /> Vidéos d'aide</a>
    @if (KiHilfe.IstVerfuegbar)
    {
        <a class="sk-chip" href="@NavKarte.KiFrageHref"><Icon Name="sparkles" Groesse="14" /> Poser une question</a>
    }
</nav>

@foreach (var k in kapitel)
{
    <section id="@k.Id">
        <Karte Titel="@k.Titel" Icon="@k.Icon">
            <ol class="pl-guide-schritte">
                @foreach (var s in k.Schritte)
                {
                    <li>
                        <div>
                            <strong>@s.Titel</strong>
                            <p>@s.Text</p>
                        </div>
                        @if (s.Href is not null)
                        {
                            <a class="sk-btn sk-btn-ghost sk-btn-klein" href="@s.Href">Ouvrir <Icon Name="arrow-right" Groesse="14" /></a>
                        }
                    </li>
                }
            </ol>
        </Karte>
    </section>
}

<Hinweis Art="info" Titel="Une question reste sans réponse ?">
    @if (KiHilfe.IstVerfuegbar)
    {
        <span>Posez-la à l'assistant sur la page <a href="@NavKarte.KiFrageHref">Poser une question</a>, ou écrivez-nous depuis la page <a href="/contact">Contact</a> : l'équipe SKOULOU vous répond par e-mail.</span>
    }
    else
    {
        <span>Écrivez-nous depuis la page <a href="/contact">Contact</a> : l'équipe SKOULOU vous répond par e-mail.</span>
    }
</Hinweis>

@code {
    private IReadOnlyList<GuideKapitel> kapitel = [];

    protected override Task InitialisierenAsync()
    {
        kapitel = GuideTexte.Fuer(Ich.Rolle, Kontext.HatRecht, Kontext.IstHauptAdmin);
        return Task.CompletedTask;
    }
}
