@page "/aide/videos"
@attribute [Authorize]
@inject IWebHostEnvironment Umgebung
@inject IJSRuntime JS

<PageTitle>Vidéos d'aide · SKOULOU</PageTitle>

<SeitenKopf Titel="Vidéos d'aide" Icon="video" Untertitel="@Untertitel" />

@if (gruppen.Count == 0)
{
    <Leerzustand Icon="video" Titel="Aucune vidéo pour votre rôle pour le moment." />
}
@foreach (var gruppe in gruppen)
{
    var bereich = Bereich(gruppe.Fuer);
    @* Jeder Nutzerbereich ist ein eigenes, farbig markiertes Feld – man sieht sofort, wo ein Bereich endet. *@
    <section class="sk-video-gruppe sk-video-rolle-@bereich.Klasse">
        <div class="sk-video-gruppe-kopf">
            <span class="sk-video-gruppe-symbol" aria-hidden="true"><Icon Name="@bereich.Icon" Groesse="22" /></span>
            <div class="sk-video-gruppe-titel">
                <h2>
                    @gruppe.Titel
                    @if (gruppe.Fuer == eigene)
                    {
                        <span class="sk-video-eigene">Votre rôle</span>
                    }
                </h2>
                <p>@gruppe.Untertitel</p>
            </div>
            <span class="sk-video-gruppe-zahl">@(gruppe.Videos.Count == 1 ? "1 vidéo" : $"{gruppe.Videos.Count} vidéos") · @Minuten(gruppe.Videos) min</span>
        </div>
        <div class="sk-video-raster">
            @foreach (var video in gruppe.Videos)
            {
                <button type="button" class="sk-video-karte" @onclick="() => OeffnenAsync(video)">
                    <span class="sk-video-bild">
                        <img src="@Poster(video)" alt="" loading="lazy" />
                        <span class="sk-video-play"><Icon Name="play" Groesse="34" Strich="1.6" /></span>
                        <span class="sk-video-dauer">@video.Dauer</span>
                    </span>
                    <span class="sk-video-text">
                        <strong>@video.Titel</strong>
                        <small>@video.Beschreibung</small>
                    </span>
                </button>
            }
        </div>
    </section>
}

<ModalDialog Open="aktuell is not null" Title="@(aktuell?.Titel ?? string.Empty)" Breite="sk-modal-lg" OnClose="SchliessenAsync">
    @if (aktuell is not null)
    {
        <video class="sk-video-spieler" src="@Quelle(aktuell)" poster="@Poster(aktuell)" controls autoplay playsinline preload="metadata"></video>
        <p class="sk-leise">@aktuell.Beschreibung</p>
    }
</ModalDialog>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthZustand { get; set; }

    private IReadOnlyList<VideoKatalog.Gruppe> gruppen = [];
    private VideoKatalog.LernVideo? aktuell;
    private string eigene = string.Empty;

    /// <summary>Farbe (CSS-Klasse) und Symbol je Nutzerbereich.</summary>
    private static (string Klasse, string Icon) Bereich(string fuer) => fuer switch
    {
        VideoKatalog.PourTous => ("tous", "video"),
        VideoKatalog.Direction => ("direction", "school"),
        VideoKatalog.Enseignant => ("enseignant", "book-open"),
        VideoKatalog.Eleve => ("eleve", "graduation"),
        _ => ("parent", "famille")
    };

    private static int Minuten(IEnumerable<VideoKatalog.LernVideo> videos)
        => Math.Max(1, (int)Math.Round(videos.Sum(v => v.Dauer.Split(':') is [var m, var s] ? int.Parse(m) * 60 + int.Parse(s) : 0) / 60.0));

    private string Untertitel
    {
        get
        {
            var videos = gruppen.SelectMany(g => g.Videos).ToList();
            var sekunden = videos.Sum(v => v.Dauer.Split(':') is [var m, var s] ? int.Parse(m) * 60 + int.Parse(s) : 0);
            return $"{videos.Count} vidéos · {sekunden / 60} min au total. Commencez par « Premiers pas ».";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthZustand is null) return;
        var nutzer = (await AuthZustand).User;
        gruppen = VideoKatalog.FuerNutzer(nutzer);
        eigene = VideoKatalog.EigeneGruppe(nutzer);
    }

    /// <summary>
    /// Vor dem Öffnen die Position der Seite merken, nach dem Schließen wiederherstellen: am Handy dreht das Vollbild ins
    /// Querformat, die Seite ordnet sich um und stünde sonst ganz oben statt beim angesehenen Video.
    /// </summary>
    private async Task OeffnenAsync(VideoKatalog.LernVideo video)
    {
        try { await JS.InvokeVoidAsync("skVideoPosition.merken"); } catch (JSException) { }
        aktuell = video;
    }

    private async Task SchliessenAsync()
    {
        aktuell = null;
        StateHasChanged();
        try { await JS.InvokeVoidAsync("skVideoPosition.zurueck"); } catch (JSException) { }
    }

    private string Quelle(VideoKatalog.LernVideo v)
        => VideoKatalog.MitVersion(v.Url, Path.Combine(Umgebung.ContentRootPath, "Medien", "videos", v.Datei));

    private string Poster(VideoKatalog.LernVideo v)
        => VideoKatalog.MitVersion("/" + v.Poster, Umgebung.WebRootFileProvider.GetFileInfo(v.Poster).PhysicalPath);
}
