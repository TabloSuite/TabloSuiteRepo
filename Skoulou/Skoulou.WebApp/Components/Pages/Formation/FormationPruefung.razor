@page "/formation/evaluation"
@attribute [Authorize(Roles = "SuperAdmin,Responsable")]
@inherits SkoulouSeite
@inject FormationService Formation
@inject IJSRuntime JS

<PageTitle>Évaluation · Formation · SKOULOU</PageTitle>

<div class="fo-seite fo-pruefung-seite">
    <a class="fo-zurueck" href="/formation"><Icon Name="chevron-left" Groesse="18" /> Formation</a>

    @if (KeinZugriff)
    {
        <Hinweis Art="fehler">@Fehlermeldung</Hinweis>
    }
    else if (ergebnis is not null)
    {
        <h1 class="fo-titel">Votre résultat</h1>
        <FormationErgebnisAnsicht Ergebnis="ergebnis">
            <Aktionen>
                @if (!ergebnis.RundeAbgeschlossen && ergebnis.VersucheUebrig > 0)
                {
                    <AsyncKnopf CssClass="sk-btn-primaer sk-btn-gross" OnClick="NeuerVersuchAsync"
                                Text="@(ergebnis.IstFrei ? "Nouvel entraînement" : $"Nouvel essai ({ergebnis.Nummer + 1}/{FormationRunde.MaxVersuche})")" />
                }
                @if (!ergebnis.IstFrei && !ergebnis.RundeAbgeschlossen)
                {
                    <button type="button" class="sk-btn sk-btn-ghost" @onclick="() => behaltenOffen = true">Garder ce résultat</button>
                }
                <a class="sk-btn sk-btn-ghost" href="/formation">Retour à la formation</a>
            </Aktionen>
        </FormationErgebnisAnsicht>
    }
    else if (fehler is not null)
    {
        <Karte CssClass="fo-leer"><Icon Name="info" Groesse="24" /><p>@fehler</p><a class="sk-btn sk-btn-primaer" href="/formation">Retour à la formation</a></Karte>
    }
    else if (versuch is null)
    {
        <p class="sk-leise" role="status">Préparation de vos questions…</p>
    }
    else
    {
        var f = versuch.Fragen[pos];
        <header class="fo-pruefung-leiste">
            <div class="fo-pruefung-leiste-text">
                <strong>@(versuch.IstFrei ? (versuch.AdminPfad ? "Entraînement · administrateur" : "Entraînement · responsable") : $"Essai {versuch.Nummer}/{FormationRunde.MaxVersuche}")</strong>
                <span>Question @(pos + 1) / @versuch.Fragen.Count · @Beantwortet répondue@(Beantwortet > 1 ? "s" : "")</span>
            </div>
            <div class="fo-fortschritt" role="progressbar" aria-valuemin="0" aria-valuemax="@versuch.Fragen.Count" aria-valuenow="@Beantwortet">
                <span style="width:@(Beantwortet * 100 / versuch.Fragen.Count)%"></span>
            </div>
        </header>

        <section class="fo-frage-karte fo-pruefungsfrage" aria-live="polite">
            <p class="fo-frage-text"><span class="fo-frage-nr">@(pos + 1)</span> @f.Text</p>
            @if (f.Mehrfach) { <small class="fo-mehrfach">Plusieurs réponses possibles – touchez toutes les bonnes</small> }
            <div class="fo-antworten" role="@(f.Mehrfach ? "group" : "radiogroup")">
                @foreach (var a in f.Antworten)
                {
                    var gewaehlt = Auswahl(f).Contains(a.Index);
                    <button type="button" class="fo-antwort @(gewaehlt ? "gewaehlt" : "") @(f.Mehrfach ? "mehrfach" : "")"
                            role="@(f.Mehrfach ? "checkbox" : "radio")" aria-checked="@(gewaehlt ? "true" : "false")"
                            data-ohne-ladekreis @onclick="() => WaehleAsync(f, a.Index)">
                        <span class="fo-antwort-marke" aria-hidden="true"></span>
                        <span>@a.Text</span>
                    </button>
                }
            </div>
            @if (speicherFehler is not null)
            {
                <p class="fo-speicherfehler" role="alert"><Icon Name="alert" Groesse="16" /> @speicherFehler</p>
            }
        </section>

        <nav class="fo-pruefung-nav" aria-label="Questions">
            <button type="button" class="sk-btn sk-btn-ghost" disabled="@(pos == 0)" @onclick="() => Gehe(pos - 1)"><Icon Name="chevron-left" Groesse="16" /> Précédente</button>
            @if (pos + 1 < versuch.Fragen.Count)
            {
                <button type="button" class="sk-btn sk-btn-primaer" @onclick="() => Gehe(pos + 1)">Suivante <Icon Name="chevron-right" Groesse="16" /></button>
            }
            else
            {
                <button type="button" class="sk-btn sk-btn-primaer" @onclick="() => abgebenOffen = true">Terminer</button>
            }
        </nav>

        <details class="fo-uebersicht" open="@uebersichtOffen">
            <summary @onclick="() => uebersichtOffen = !uebersichtOffen">Toutes les questions</summary>
            <div class="fo-punkte">
                @for (var i = 0; i < versuch.Fragen.Count; i++)
                {
                    var n = i;
                    <button type="button" class="fo-punkt @(Auswahl(versuch.Fragen[n]).Count > 0 ? "beantwortet" : "") @(n == pos ? "aktuell" : "")"
                            aria-label="Question @(n + 1)" @onclick="() => Gehe(n)">@(n + 1)</button>
                }
            </div>
            <button type="button" class="sk-btn sk-btn-ghost sk-btn-klein" @onclick="() => abgebenOffen = true">Enregistrer et voir ma note</button>
        </details>
    }
</div>

<ModalDialog Open="abgebenOffen" Title="Enregistrer et voir ma note ?" OnClose="() => abgebenOffen = false" Breite="sk-modal-sm">
    <ChildContent>
        @if (versuch is not null && Beantwortet < versuch.Fragen.Count)
        {
            <p class="fo-warnung"><Icon Name="alert" Groesse="16" /> Il reste <strong>@(versuch.Fragen.Count - Beantwortet) question@(versuch.Fragen.Count - Beantwortet > 1 ? "s" : "") sans réponse</strong> : elles compteront comme fausses.</p>
        }
        <p>Après l'enregistrement, vous voyez votre note et vos erreurs. @(versuch?.IstFrei == true ? "" : "Seul le dernier essai compte pour votre session.")</p>
    </ChildContent>
    <Footer>
        <button type="button" class="sk-btn sk-btn-ghost" @onclick="() => abgebenOffen = false">Continuer</button>
        <AsyncKnopf Text="Enregistrer" BusyText="Calcul de la note…" CssClass="sk-btn-primaer" OnClick="AbgebenAsync" />
    </Footer>
</ModalDialog>

<ModalDialog Open="behaltenOffen" Title="Garder ce résultat ?" OnClose="() => behaltenOffen = false" Breite="sk-modal-sm">
    <ChildContent>
        <p>Cet essai (<strong>@ergebnis?.Prozent %</strong>) devient votre note finale et la session se termine.</p>
    </ChildContent>
    <Footer>
        <button type="button" class="sk-btn sk-btn-ghost" @onclick="() => behaltenOffen = false">Annuler</button>
        <AsyncKnopf Text="Garder ce résultat" CssClass="sk-btn-primaer" OnClick="BehaltenAsync" />
    </Footer>
</ModalDialog>

@code {
    /// <summary>« admin » = freies Training im Pfad der Administrateure (nur SuperAdmin).</summary>
    [SupplyParameterFromQuery(Name = "parcours")] public string? Parcours { get; set; }

    private FormationService.VersuchAnsicht? versuch;
    private FormationService.Ergebnis? ergebnis;
    private string? fehler, speicherFehler;
    private int pos;
    private bool abgebenOffen, behaltenOffen, uebersichtOffen;
    private readonly Dictionary<string, List<int>> auswahl = [];

    private int Beantwortet => versuch?.Fragen.Count(f => Auswahl(f).Count > 0) ?? 0;

    protected override async Task InitialisierenAsync() => await StarteAsync();

    private async Task StarteAsync()
    {
        (versuch, fehler) = await Formation.StarteVersuchAsync(Ich.KontoId, adminPfad: Parcours == "admin");
        ergebnis = null;
        auswahl.Clear();
        if (versuch is null) return;
        foreach (var f in versuch.Fragen) auswahl[f.Id] = f.Auswahl.ToList();
        pos = Math.Max(0, versuch.Fragen.ToList().FindIndex(f => auswahl[f.Id].Count == 0));
    }

    private List<int> Auswahl(FormationService.FrageAnzeige f) => auswahl.TryGetValue(f.Id, out var a) ? a : auswahl[f.Id] = [];

    /// <summary>Jede Antwort wird sofort gespeichert – bei schwachem Netz geht nichts verloren.</summary>
    private async Task WaehleAsync(FormationService.FrageAnzeige f, int index)
    {
        var a = Auswahl(f);
        if (f.Mehrfach) { if (!a.Remove(index)) a.Add(index); }
        else { a.Clear(); a.Add(index); }
        speicherFehler = await Formation.SpeichereAntwortAsync(Ich.KontoId, versuch!.Id, f.Id, a.ToArray());
        if (speicherFehler is not null && speicherFehler.Contains("délai")) { fehler = speicherFehler; versuch = null; }
    }

    private async Task Gehe(int neu)
    {
        if (versuch is null || neu < 0 || neu >= versuch.Fragen.Count) return;
        pos = neu;
        speicherFehler = null;
        try { await JS.InvokeVoidAsync("scrollTo", 0, 0); } catch (JSException) { }
    }

    private async Task AbgebenAsync()
    {
        if (versuch is null) return;
        var (e, f) = await Formation.GibAbAsync(Ich.KontoId, versuch.Id);
        abgebenOffen = false;
        if (e is null) { Toast.ZeigeFehler(f ?? "Veuillez réessayer."); return; }
        ergebnis = e;
        versuch = null;
        try { await JS.InvokeVoidAsync("scrollTo", 0, 0); } catch (JSException) { }
    }

    private async Task NeuerVersuchAsync()
    {
        await AusfuehrenAsync(StarteAsync);
        try { await JS.InvokeVoidAsync("scrollTo", 0, 0); } catch (JSException) { }
    }

    private async Task BehaltenAsync()
    {
        var f = await Formation.BehalteErgebnisAsync(Ich.KontoId);
        behaltenOffen = false;
        if (f is not null) { Toast.ZeigeFehler(f); return; }
        Toast.ZeigeErfolg("Votre note finale est enregistrée.");
        Navigation.NavigateTo("/formation");
    }
}
