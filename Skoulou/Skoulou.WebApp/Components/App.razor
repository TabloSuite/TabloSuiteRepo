<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <script>
        // Thema (clair / sombre / auto) vor dem ersten Zeichnen setzen – kein weißes Aufblitzen.
        (function () {
            var schluessel = 'skoulou-theme';
            function modus() { try { return localStorage.getItem(schluessel) || 'auto'; } catch (e) { return 'auto'; } }
            function anwenden() {
                var m = modus();
                var dunkel = m === 'dark' || (m === 'auto' && window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches);
                var html = document.documentElement;
                if (html.getAttribute('data-theme') !== (dunkel ? 'dark' : 'light')) html.setAttribute('data-theme', dunkel ? 'dark' : 'light');
                var meta = document.querySelector('meta[name="theme-color"]');
                if (meta) meta.setAttribute('content', dunkel ? '#0b1220' : '#ffffff');
            }
            window.skLeseTheme = modus;
            window.skSetzeTheme = function (m) { try { localStorage.setItem(schluessel, m); } catch (e) { } anwenden(); };
            anwenden();
            if (window.matchMedia) matchMedia('(prefers-color-scheme: dark)').addEventListener('change', anwenden);
            // Blazor gleicht <html>-Attribute nach Navigation ab – Thema dann wiederherstellen.
            new MutationObserver(anwenden).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
            document.addEventListener('DOMContentLoaded', anwenden);
        })();
        // Startseite: Einblenden beim Scrollen wie bei eNOTE (23.11.2026 alle Abschnitte, vorher nur das Bild im Einstieg).
        // .lp-reveal-Elemente bekommen « sichtbar », sobald sie ins Bild kommen (CSS-Übergang, --lp-verz staffelt). Das Bild im
        // Einstieg (.lp-hero-bild, eigene CSS-Animationen lp-ein) spielt erst, wenn es sichtbar ist (lp-los; am Handy weiter unten).
        // Hier im Kopf statt in skoulou.js: läuft schon beim Aufbau der vorgerenderten Seite – bei langsamem Netz ist der Einstieg
        // sofort da (eNOTE 21.11.2026). Blazor ersetzt beim Verbinden das vorgerenderte HTML: schon gezeigte Elemente (gleiche
        // Nummer auf derselben Seite) setzen ihr Einblenden an derselben Stelle fort (negative Verzögerung --lp-verz bzw. --lp-schon)
        // oder stehen sofort da – kein zweites Einblenden. Ohne JavaScript, ohne IntersectionObserver oder bei « Bewegung
        // reduzieren »: kein lp-js, alles sofort sichtbar (der Inhalt steht immer im HTML).
        (function () {
            if (!('IntersectionObserver' in window) || (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches)) return;
            var html = document.documentElement, gezeigt = {}, bildStart = null, bild = null;
            function bildLos(el) {
                if (bildStart === null) bildStart = performance.now();
                el.style.setProperty('--lp-schon', Math.round(performance.now() - bildStart) + 'ms');
                el.classList.add('lp-los');
            }
            var io = new IntersectionObserver(function (eintraege) {
                eintraege.forEach(function (e) {
                    if (!e.isIntersecting) return;
                    io.unobserve(e.target);
                    if (e.target.classList.contains('lp-hero-bild')) { bildLos(e.target); return; }
                    e.target.classList.add('sichtbar');
                    gezeigt[e.target.lpSchluessel] = performance.now();
                });
            }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
            function erfasse() {
                var neuesBild = document.querySelector('.lp-hero-bild');
                if (neuesBild && neuesBild !== bild) { bild = neuesBild; if (bildStart !== null) bildLos(bild); else io.observe(bild); }
                var liste = document.querySelectorAll('.lp-reveal');
                for (var i = 0; i < liste.length; i++) {
                    var el = liste[i];
                    if (el.lpSchluessel) continue;
                    el.lpSchluessel = location.pathname + '#' + i;
                    var seit = gezeigt[el.lpSchluessel];
                    if (seit === undefined) { if (!el.classList.contains('sichtbar')) io.observe(el); continue; }
                    var vergangen = performance.now() - seit;
                    if (vergangen < 1800) {
                        var verz = parseFloat(getComputedStyle(el).getPropertyValue('--lp-verz')) || 0;   // Stil jetzt berechnen (unsichtbar)
                        el.style.setProperty('--lp-verz', Math.round(verz - vergangen) + 'ms');
                    }
                    el.classList.add('sichtbar');
                }
            }
            new MutationObserver(erfasse).observe(html, { childList: true, subtree: true });
            function markiere() { if (!html.classList.contains('lp-js')) html.classList.add('lp-js'); }
            markiere();
            // Blazor gleicht <html>-Attribute nach Navigation ab – Markierung dann wieder setzen.
            new MutationObserver(markiere).observe(html, { attributes: true, attributeFilter: ['class'] });
        })();
    </script>
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["css/plattform.css"]" />
    <link rel="stylesheet" href="@Assets["css/organisation.css"]" />
    <link rel="stylesheet" href="@Assets["css/paedagogik.css"]" />
    <link rel="stylesheet" href="@Assets["css/noten.css"]" />
    <link rel="stylesheet" href="@Assets["css/finanzen.css"]" />
    <link rel="stylesheet" href="@Assets["css/formation.css"]" />
    <link rel="manifest" href="manifest.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content="SKOULOU, la gestion scolaire simple pour écoles, collèges, lycées et centres de formation : élèves, notes, bulletins PDF, frais de scolarité et parents en ligne." />
    <link rel="icon" href="@Assets["favicon.svg"]" type="image/svg+xml" />
    <link rel="icon" href="@Assets["favicon-192.png"]" type="image/png" sizes="192x192" />
    <link rel="icon" href="@Assets["favicon.png"]" type="image/png" />
    <link rel="apple-touch-icon" href="@Assets["favicon.png"]" />
    <HeadOutlet @rendermode="SeitenModus" />
</head>

<body>
    <Routes @rendermode="SeitenModus" />
    <VerbindungsFenster />
    <script src="_framework/blazor.web.js"></script>
    <script src="@Assets["js/skoulou.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    /// <summary>
    /// Reine Formular-Seiten mit [ExcludeFromInteractiveRouting] (Connexion, Mot de passe oublié) bleiben statisches HTML: sonst baut
    /// Blazor die vorgerenderte Seite nach dem Verbindungsaufbau neu auf – bei schwachem Netz waren Eingaben und Ladekreis weg
    /// (Nutzer 17.11.2026, eNOTE). Alle anderen Seiten bleiben interaktiv.
    /// </summary>
    private IComponentRenderMode? SeitenModus => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
